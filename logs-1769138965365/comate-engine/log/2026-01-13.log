k(headMap.get(\"remark\"));\n        responseHeader.setReserve(headMap.get(\"reserve\"));\n        responseHeader.setReserve2(headMap.get(\"reserve2\"));\n        responseHeader.setSgntr(headMap.get(\"sgntr\"));\n\n        return responseHeader;\n    }\n\n}\n","completed":false,"isEnd":false,"failed":false}
