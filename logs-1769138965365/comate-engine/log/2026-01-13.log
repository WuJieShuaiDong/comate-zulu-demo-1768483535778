[1715] [2026-01-13 19:06:22] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"f9b986c9-ac4e-444c-b24f-75a3c8c77fde","existed":true,"content":"package com.baidu.pmc.bankcommon.core.model.bcm;\n\nimport lombok.Data;\n\nimport java.io.Serializable;\n\n/**\n * 银行交易记录数据模型\n * 对应银行流水查询返回的交易明细记录\n *\n * @author baidu.pmc\n * @since 2025-01-09\n */\n@Data\npublic class BankBcmTransaction implements Serializable {\n    private static final long serialVersionUID = 1L;\n\n    /**\n     * 状态\n     */\n    private String status;\n\n    /**\n     * 交易日期 (格式: YYYYMMDD)\n     */\n    private String transactionDate;\n\n    /**\n     * 交易时间 (格式: HHmmss)\n     */\n    private String transactionTime;\n\n    /**\n     * 业务类型\n     */\n    private String businessType;\n\n    /**\n     * 流水号\n     */\n    private String serialNumber;\n\n    /**\n     * 流水序号\n     */\n    private String sequenceNumber;\n\n    /**\n     * 账号\n     */\n    private String accountNumber;\n\n    /**\n     * 户名\n     */\n    private String accountName;\n\n    /**\n     * 收支标志 (D:支出, C:收入)\n     */\n    private String incomeExpenseFlag;\n\n    /**\n     * 币种 (如: CNY)\n     */\n    private String currency;\n\n    /**\n     * 交易金额\n     */\n    private String transactionAmount;\n\n    /**\n     * 余额\n     */\n    private String balance;\n\n    /**\n     * 可用余额\n     */\n    private String availableBalance;\n\n    /**\n     * 对方账号\n     */\n    private String counterpartyAccount;\n\n    /**\n     * 对方户名\n     */\n    private String counterpartyName;\n\n    /**\n     * 对方地址\n     */\n    private String counterpartyAddress;\n\n    /**\n     * 对方开户行行号\n     */\n    private String counterpartyBankCode;\n\n    /**\n     * 对方开户行行名\n     */\n    private String counterpartyBankName;\n\n    /**\n     * 票据种类\n     */\n    private String billType;\n\n    /**\n     * 票据号码\n     */\n    private String billNumber;\n\n    /**\n     * 票据名称\n     */\n    private String billName;\n\n    /**\n     * 票据签发日期\n     */\n    private String billIssueDate;\n\n    /**\n     * 附言\n     */\n    private String remarkMemo;\n\n    /**\n     * 备注\n     */\n    private String additionalRemark;\n\n    /**\n     * 交易码\n     */\n    private String transactionCode;\n\n    /**\n     * 备用字段\n     */\n    private String backupField;\n}\n","completed":false,"isEnd":false,"failed":false}
