[1715] [2026-01-13 19:06:57] [INFO] [ENGINE]  <--------- ENGINE SEND: VIRTUAL_EDITOR_EVENT {"action":"openVirtualDiffDocument","payload":{"absolutePath":"/Users/xiaoliu/baidu/bpit-proc-apps/pmc/alter_pmc_bcm_pay_instruct_his.sql","content":"","modified":"-- 修改pmc_bcm_pay_instruct_his表elec_cheque_no字段长度为32位的SQL语句\n-- 适用于MySQL 5.6/5.7等低版本\n\n-- 首先检查字段是否存在及其当前定义\nSELECT \n    COLUMN_NAME,\n    COLUMN_TYPE,\n    CHARACTER_MAXIMUM_LENGTH,\n    IS_NULLABLE,\n    COLUMN_DEFAULT,\n    COLUMN_COMMENT\nFROM information_schema.COLUMNS \nWHERE TABLE_SCHEMA = 'your_database_name'  -- 请替换为实际的数据库名\n  AND TABLE_NAME = 'pmc_bcm_pay_instruct_his'\n  AND COLUMN_NAME = 'elec_cheque_no';\n\n-- 修改字段长度为32位\nALTER TABLE pmc_bcm_pay_instruct_his \nMODIFY COLUMN elec_cheque_no VARCHAR(32) \nCHARACTER SET utf8mb4 \nCOLLATE utf8mb4_unicode_ci \nCOMMENT '电子支票号码';\n\n-- 对于MySQL 5.6，如果表是MyISAM引擎且需要保留注释，可能需要单独修改注释：\n-- ALTER TABLE pmc_bcm_pay_instruct_his \n-- MODIFY COLUMN elec_cheque_no VARCHAR(32) \n-- CHARACTER SET utf8mb4 \n-- COLLATE utf8mb4_unicode_ci;\n\n-- 如果以上语句因为字符集问题报错，尝试使用更兼容的语句：\n-- ALTER TABLE pmc_bcm_pay_instruct_his \n-- MODIFY COLUMN elec_cheque_no VARCHAR(32);\n\n-- 验证修改结果\nSELECT \n    COLUMN_NAME,\n    COLUMN_TYPE,\n    CHARACTER_MAXIMUM_LENGTH,\n    IS_NULLABLE,\n    COLUMN_DEFAULT,\n    COLUMN_COMMENT\nFROM information_schema.COLUMNS \nWHERE TABLE_SCHEMA = 'your_database_name'  -- 请替换为实际的数据库名\n  AND TABLE_NAME = 'pmc_bcm_pay_instruct_his'\n  AND COLUMN_NAME = 'elec_cheque_no';\n\n-- 注意事项：\n-- 1. 请务必备份数据后再执行修改操作\n-- 2. 替换your_database_name为实际数据库名\n-- 3. 如果字段当前允许NULL，修改后会保持NULL属性\n-- 4. 如果修改前数据长度超过32位，需要先处理超长数据\n-- 5. 推荐在业务低峰期执行此操作，避免锁表影响业务\n\n-- 处理可能存在的超长数据（如果字段当前长度大于32位）\n-- 找到超长数据的记录\n-- SELECT COUNT(*) FROM pmc_bcm_pay_instruct_his \n-- WHERE CHAR_LENGTH(elec_cheque_no) > 32;\n\n-- 截断超长数据（如果需要）\n-- UPDATE pmc_bcm_pay_instruct_his \n-- SET elec_cheque_no = SUBSTRING(elec_cheque_no, 1, 32)\n-- WHERE CHAR_LENGTH(elec_cheque_no) > 32;","stream":true,"source":"E2EBotConversation","acceptable":true,"action":"edit","openFileDiff":true,"conversationId":"39d097db-e39e-40aa-97b4-6b2cff0a7711","elementId":"ed1114ea-aec2-48a3-9132-868835f10c99","inlineView":true,"uuid":"4fbb9130-529c-41df-901a-0cdaceb059bd"}}
