[1715] [2026-01-13 16:51:41] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"c496c356-09b3-4c85-82f3-96843dcc1f6d","existed":true,"content":"package com.baidu.pmc.bankcommon.core.dto;\n\nimport lombok.Data;\nimport lombok.NoArgsConstructor;\n\nimport java.io.Serializable;\n\n/**\n * 银行响应xml内层电子回单DTO\n *\n * @author liuyanzhong\n */\n@NoArgsConstructor\n@Data\npublic class BankcommonReceiptDTO implements Serializable {\n\n    private static final long serialVersionUID = -5541008317727913209L;\n\n    /**\n     * 流水号\n     */\n    private String serialNumber;\n\n    /**\n     * 回单编号\n     */\n    private String brseqNo;\n\n    /**\n     * 银行\n     */\n    private String bank;\n\n    /**\n     * 回单类型  varchar(6)，\n     */\n    private String billType;\n\n    /**\n     * 交易日期\n     */\n    private String tranDate;\n\n    /**\n     * 交易时间\n     */\n    private String tranTime;\n\n    /**\n     * 交易金额\n     */\n    private String tranAmt;\n\n    /**\n     * 付款人账号\n     */\n    private String payerAccNo;\n\n    /**\n     * 收款人账号\n     */\n    private String payeeAccNo;\n\n    /**\n     * 账户\n     */\n    private String account;\n\n    /**\n     * 文件名称\n     */\n    private String fileName;\n\n    /**\n     * 文件流\n     */\n    private String fileContent;\n\n\n}\n","completed":false,"isEnd":false,"failed":false}
