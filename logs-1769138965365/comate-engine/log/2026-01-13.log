[4021] [2026-01-13 15:58:21] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"637f61f7-541d-4fe9-b561-1f583733b8b3","existed":true,"content":"import java.util.regex.Pattern;\n\npublic class test_date_format_validation {\n\n    private static boolean isValidDateFormat(String pattern) {\n        if (pattern == null || pattern.trim().isEmpty()) {\n            return false;\n        }\n        try {\n            // 简单的日期格式验证：检查是否包含常见的日期格式字符\n            return pattern.matches(\"^[yYMmdDHhmsS\\\\-/:\\\\s]+$\") && pattern.length() > 0;\n        } catch (Exception e) {\n            return false;\n        }\n    }\n\n    public static void main(String[] args) {\n        // 测试有效的日期格式\n        String[] validFormats = {\n            \"yyyy-MM-dd\",\n            \"yyyyMMdd\",\n            \"HHmmss\",\n            \"yyyy-MM-dd HH:mm:ss\",\n            \"MM/dd/yyyy\",\n            \"yyyy/MM/dd\"\n        };\n\n        // 测试无效的日期格式\n        String[] invalidFormats = {\n            \"\",           // 空字符串\n            \"  \",         // 空白字符串\n            \"invalid!@#\", // 非法字符\n            \"abc123\",     // 仅部分合法字符\n            null          // null值\n        };\n\n        System.out.println(\"=== 测试有效的日期格式 ===\");\n        for (String format : validFormats) {\n            boolean valid = isValidDateFormat(format);\n            System.out.println(\"格式: '\" + format + \"' -> \" + (valid ? \"有效\" : \"无效\"));\n        }\n\n        System.out.println(\"\\n=== 测试无效的日期格式 ===\");\n        for (String format : invalidFormats) {\n            boolean valid = isValidDateFormat(format);\n            System.out.println(\"格式: '\" + format + \"' -> \" + (valid ? \"有效\" : \"无效\"));\n        }\n    }\n}\n","completed":false,"isEnd":false,"failed":false}
