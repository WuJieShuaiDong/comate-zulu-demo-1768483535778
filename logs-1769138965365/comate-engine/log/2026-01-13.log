[1715] [2026-01-15 20:35:58] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"592f6859-a8aa-443c-9c93-4b5a91220d92","existed":true,"content":"package com.baidu.pmc.pojo.model;\n\nimport static org.junit.Assert.*;\n\nimport org.junit.Assert;\nimport org.junit.Before;\nimport org.junit.Test;\n\nimport java.math.BigDecimal;\n\npublic class PmcFinanceSupplierApplyTest{\n\n\n    private PmcFinanceSupplierApply apply;\n    private PmcFinanceSupplierApply pmcFinanceSupplierApply;\n\n    @Before\n    public void setUp() {\n        pmcFinanceSupplierApply = new PmcFinanceSupplierApply();\n    }\n\n    // testGetFinanceAccountWhenFinanceAccountIsNull 用于测试 getFinanceAccount\n    // generated by Comate\n    @Test\n    public void testGetFinanceAccountWhenFinanceAccountIsNull() {\n        // Given\n        pmcFinanceSupplierApply.setFinanceAccount(null);\n        \n        // When\n        String result = pmcFinanceSupplierApply.getFinanceAccount();\n        \n        // Then\n        assertNull(result);\n    }\n\n    // testSetPayOriginGroupWithNormalValue 用于测试 setPayOriginGroup\n    // generated by Comate\n    @Test\n    public void testSetPayOriginGroupWithNormalValue() {\n        String expectedPayOriginGroup = \"TestGroup\";\n        pmcFinanceSupplierApply.setPayOriginGroup(expectedPayOriginGroup);\n        assertEquals(\"PayOriginGroup should be set correctly\", \n                     expectedPayOriginGroup, pmcFinanceSupplierApply.getPayOriginGroup());\n    }\n\n    // testGetPayOriginStatusWhenValueIsNull 用于测试 getPayOriginStatus\n    // generated by Comate\n    @Test\n    public void testGetPayOriginStatusWhenValueIsNull() {\n        pmcFinanceSupplierApply.setPayOriginStatus(null);\n        String result = pmcFinanceSupplierApply.getPayOriginStatus();\n        Assert.assertNull(result);\n    }\n\n    // testSetPayOriginStatusDoesNotAffectOtherFields 用于测试 setPayOriginStatus\n    // generated by Comate\n    @Test\n    public void testSetPayOriginStatusDoesNotAffectOtherFields() {\n        apply = new PmcFinanceSupplierApply();\n    \n        // Set initial values for other fields\n        apply.setApplyId(1001L);\n        apply.setApplyNumber(\"APP001\");\n        apply.setStatus(\"ACTIVE\");\n        apply.setPayAmount(new BigDecimal(\"1000.00\"));\n    \n        // Set pay origin status\n        String expectedStatus = \"PENDING\";\n        apply.setPayOriginStatus(expectedStatus);\n    \n        // Verify pay origin status was set correctly\n        assertEquals(expectedStatus, apply.getPayOriginStatus());\n    \n        // Verify other fields remain unchanged\n        assertEquals(Long.valueOf(1001L), apply.getApplyId());\n        assertEquals(\"APP001\", apply.getApplyNumber());\n        assertEquals(\"ACTIVE\", apply.getStatus());\n        assertEquals(new BigDecimal(\"1000.00\"), apply.getPayAmount());\n    }\n\n    // testGetBankApplyNumberWhenBankApplyNumberIsNull 用于测试 getBankApplyNumber\n    // generated by Comate\n    @Test\n    public void testGetBankApplyNumberWhenBankApplyNumberIsNull() {\n        // Given\n        pmcFinanceSupplierApply.setBankApplyNumber(null);\n        \n        // When\n        String result = pmcFinanceSupplierApply.getBankApplyNumber();\n        \n        // Then\n        assertNull(result);\n    }\n\n    // testGetMessageWhenMessageIsNull 用于测试 getMessage\n    // generated by Comate\n    @Test\n    public void testGetMessageWhenMessageIsNull() {\n        // Given\n        pmcFinanceSupplierApply.setMessage(null);\n        \n        // When\n        String result = pmcFinanceSupplierApply.getMessage();\n        \n        // Then\n        assertNull(result);\n    }\n\n    // testGetSendSeqWhenSendSeqIsNull 用于测试 getSendSeq\n    // generated by Comate\n    @Test\n    public void testGetSendSeqWhenSendSeqIsNull() {\n        // Given\n        pmcFinanceSupplierApply.setSendSeq(null);\n        \n        // When\n        Integer result = pmcFinanceSupplierApply.getSendSeq();\n        \n        // Then\n        assertNull(result);\n    }\n\n    // testSetPayeeAccountWithValidString 用于测试 setPayeeAccount\n    // generated by Comate\n    @Test\n    public void testSetPayeeAccountWithValidString() {\n        // Given\n        String expectedPayeeAccount = \"12345678901234567890\";\n        \n        // When\n        pmcFinanceSupplierApply.setPayeeAccount(expectedPayeeAccount);\n        \n        // Then\n        assertEquals(expectedPayeeAccount, pmcFinanceSupplierApply.getPayeeAccount());\n    }\n\n    // testGetPayeeBranchWhenPayeeBranchIsNull 用于测试 getPayeeBranch\n    // generated by Comate\n    @Test\n    public void testGetPayeeBranchWhenPayeeBranchIsNull() {\n        // Given\n        pmcFinanceSupplierApply.setPayeeBranch(null);\n        \n        // When\n        String result = pmcFinanceSupplierApply.getPayeeBranch();\n        \n        // Then\n        assertNull(result);\n    }\n\n}","completed":false,"isEnd":false,"failed":false}
