[4021] [2026-01-13 15:23:44] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"0307792d-a34d-498d-9918-81a14b366da1","existed":true,"content":"package com.baidu.pmc.common.encrypt;\n\nimport com.baidu.cmcc.crypto.core.AesCrypto;\nimport com.baidu.pmc.common.encrypt.annotation.EncryptField;\nimport lombok.extern.slf4j.Slf4j;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\n\nimport java.lang.reflect.Field;\nimport java.util.Arrays;\nimport java.util.Collection;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Objects;\n\n/**\n * 加密服务类\n *\n * @author wanghengbin\n * @date 2025-11-05\n */\n@Slf4j\n@Service\npublic class EncryptService {\n\n    /**\n     * 加密解密字段\n     */\n    public static final List<String> ENCRYPT_FIELD_LIST = Arrays.asList(\"payee_account\", \"payeeAccount\");\n\n    @Autowired\n    private AesCrypto aesCrypto;\n\n    public void encryptDto(Map<String, Object> dto) {\n        if (dto == null || dto.isEmpty()){\n            return;\n        }\n        for (Map.Entry<String, Object> entry : dto.entrySet()) {\n            try {\n                if (ENCRYPT_FIELD_LIST.contains(entry.getKey())) {\n                    Object value = dto.get(entry.getKey());\n                    if (Objects.isNull(value)) {\n                        continue;\n                    }\n                    if (value instanceof String) {\n                        dto.put(entry.getKey(), aesCrypto.encrypt((String) value));\n                    }\n                }\n            } catch (Exception e) {\n                log.error(\"encrypt field :{},error:{} : \", entry.getKey(), e.getMessage());\n            }\n        }\n    }\n\n    public void decryptDto(Map<String, Object> dto) {\n        if (dto == null || dto.isEmpty()){\n            return;\n        }\n        for (Map.Entry<String, Object> entry : dto.entrySet()) {\n            try {\n                if (ENCRYPT_FIELD_LIST.contains(entry.getKey())) {\n                    Object value = dto.get(entry.getKey());\n                    if (Objects.isNull(value)) {\n                        continue;\n                    }\n                    if (value instanceof String) {\n                        dto.put(entry.getKey(), aesCrypto.decrypt((String) value));\n                    }\n                }\n            } catch (Exception e) {\n                log.error(\"decrypt field :{},error:{} : \", entry.getKey(), e.getMessage());\n            }\n        }\n    }\n\n    public void encrypt(Object parameterObject) {\n        if (parameterObject instanceof Collection) {\n            // 处理List/Set等集合\n            ((Collection<?>) parameterObject).stream().filter(Objects::nonNull).forEach(this::encrypt);\n        } else if (parameterObject instanceof Map) {\n            // 处理Map参数（含@Param注解多参数）\n            Map<?, ?> paramMap = (Map<?, ?>) parameterObject;\n            paramMap.values().stream().filter(Objects::nonNull).forEach(this::encrypt);\n        } else if (parameterObject.getClass().isArray()) {\n            // 处理数组参数\n            Arrays.stream((Object[]) parameterObject).filter(Objects::nonNull).forEach(this::encrypt);\n        } else {\n            // 处理普通JavaBean\n            this.encryptJavaBean(parameterObject);\n        }\n    }\n\n    public void encryptJavaBean(Object bean) {\n        Class<?> beanClass = bean.getClass();\n        // 排除JDK自带类和基本类型\n        if (beanClass.getName().startsWith(\"java.\") || beanClass.isPrimitive()) {\n            return;\n        }\n        // 递归处理所有字段\n        Field[] fields = beanClass.getDeclaredFields();\n        for (Field field : fields) {\n            try {\n                if (field.isAnnotationPresent(EncryptField.class)) {\n                    field.setAccessible(true);\n                    Object value = field.get(bean);\n                    if (Objects.isNull(value)) {\n                        continue;\n                    }\n                    if (value instanceof String) {\n                        field.set(bean, aesCrypto.encrypt((String) value));\n                    }\n                    log.info(\"encrypt field success:{}\", field.getName());\n                } else {\n                    // 递归处理嵌套对象\n                    field.setAccessible(true);\n                    Object nestedObject = field.get(bean);\n                    if (nestedObject != null) {\n                        encrypt(nestedObject);\n                    }\n                }\n            } catch (Exception e) {\n                log.error(\"encrypt field error:{} : \", field.getName(), e);\n            }\n        }\n    }\n\n\n    public void decrypt(Object result, boolean afterUpdate) {\n        // 遍历结果对象字段，对@EncryptField注解字段解密\n        // 实现逻辑：反射获取字段，解密后替换原值\n        if (result instanceof Collection) {\n            // 处理List/Set等集合\n            ((Collection<?>) result).stream().filter(Objects::nonNull).forEach(item -> decrypt(item, afterUpdate));\n        } else if (result instanceof Map) {\n            // 处理Map参数（含@Param注解多参数）\n            Map<?, ?> paramMap = (Map<?, ?>) result;\n            paramMap.values().stream().filter(Objects::nonNull).forEach(item -> decrypt(item, afterUpdate));\n        } else if (result.getClass().isArray()) {\n            // 处理数组参数\n            Arrays.stream((Object[]) result).filter(Objects::nonNull).forEach(item -> decrypt(item, afterUpdate));\n        } else {\n            // 处理普通JavaBean\n            this.decryptJavaBean(result, afterUpdate);\n        }\n    }\n\n    public void decryptJavaBean(Object bean, boolean afterUpdate) {\n        Class<?> beanClass = bean.getClass();\n        // 排除JDK自带类和基本类型\n        if (beanClass.getName().startsWith(\"java.\") || beanClass.isPrimitive()) {\n            return;\n        }\n        // 递归处理所有字段\n        Field[] fields = beanClass.getDeclaredFields();\n        for (Field field : fields) {\n            try {\n                if (field.isAnnotationPresent(EncryptField.class)) {\n                    EncryptField annotation = field.getAnnotation(EncryptField.class);\n                    // 如果更新后触发解密, 同时注解中指定不更新后解密, 则跳过解密, 不影响查询后解密\n                    if (afterUpdate && !annotation.decryptAfterUpdate()) {\n                        continue;\n                    }\n                    field.setAccessible(true);\n                    Object value = field.get(bean);\n                    if (Objects.isNull(value)) {\n                        continue;\n                    }\n                    if (value instanceof String) {\n                        field.set(bean, aesCrypto.decrypt((String) value));\n                    }\n                    log.info(\"decrypt field success:{}\", field.getName());\n                } else {\n                    // 递归处理嵌套对象\n                    field.setAccessible(true);\n                    Object nestedObject = field.get(bean);\n                    if (nestedObject != null) {\n                        decrypt(nestedObject, afterUpdate);\n                    }\n                }\n            } catch (Exception e) {\n                log.error(\"decrypt field error:{} :{} \", field.getName(), e.getMessage());\n            }\n        }\n    }\n}\n","completed":false,"isEnd":false,"failed":false}
