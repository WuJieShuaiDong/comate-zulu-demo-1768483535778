[2502] [2026-01-15 14:09:22] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"fa8bafcc-bf4e-4389-b149-14321b9f9eec","existed":true,"content":"package com.baidu.tms.loan.dao;\n\nimport com.baidu.p2p.core.j2ee.persistence.annotation.MyBatisDao;\nimport com.baidu.tms.loan.dto.ApproveFundVoucherDTO;\nimport com.baidu.tms.loan.dto.ApproveFundVoucherQueryDTO;\nimport com.baidu.tms.persistent.loan.domain.TmsLoanAccount;\nimport com.baidu.tms.persistent.loan.domain.TmsLoanAccountHeader;\n\nimport java.util.List;\nimport java.util.Map;\n\n/**\n * 记账凭证审批相关\n */\n@MyBatisDao\npublic interface LoanAccountHeaderDao {\n\n    List<ApproveFundVoucherDTO> selectVoucherByCondition(ApproveFundVoucherQueryDTO queryDTO);\n\n    List<TmsLoanAccount> selectExportVoucherList(ApproveFundVoucherQueryDTO queryDTO);\n\n    /**\n     * 批量查询凭证头和分录信息\n     * @param headerIds 凭证头ID列表\n     * @return 包含凭证头和分录信息的Map\n     */\n    Map<String, Object> selectVoucherWithHeaderByIds(List<String> headerIds);\n\n    /**\n     * 批量更新分录状态\n     * @param accountIds 分录ID列表\n     * @param status 状态\n     * @param username 操作用户名\n     * @return 更新行数\n     */\n    int batchUpdateAccountStatus(List<Long> accountIds, String status, String username);\n\n    /**\n     * 批量更新凭证头状态\n     * @param headerIds 凭证头ID列表\n     * @param status 状态\n     * @return 更新行数\n     */\n    int batchUpdateHeaderStatus(List<Long> headerIds, String status);\n}\n","completed":false,"isEnd":false,"failed":false}
