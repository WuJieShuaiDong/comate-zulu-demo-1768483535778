[4021] [2026-01-13 15:58:40] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"89e2faa0-cf74-4d15-b121-3cb27c487b77","existed":true,"content":"//\n// Source code recreated from a .class file by IntelliJ IDEA\n// (powered by FernFlower decompiler)\n//\n\npublic class test_date_format_validation {\n    private static boolean isValidDateFormat(String var0) {\n        if (var0 != null && !var0.trim().isEmpty()) {\n            try {\n                return var0.matches(\"^[yYMmdDHhmsS\\\\-/:\\\\s]+$\") && var0.length() > 0;\n            } catch (Exception var2) {\n                return false;\n            }\n        } else {\n            return false;\n        }\n    }\n\n    public static void main(String[] var0) {\n        String[] var1 = new String[]{\"yyyy-MM-dd\", \"yyyyMMdd\", \"HHmmss\", \"yyyy-MM-dd HH:mm:ss\", \"MM/dd/yyyy\", \"yyyy/MM/dd\"};\n        String[] var2 = new String[]{\"\", \"  \", \"invalid!@#\", \"abc123\", null};\n        System.out.println(\"=== 测试有效的日期格式 ===\");\n\n        for(String var6 : var1) {\n            boolean var7 = isValidDateFormat(var6);\n            System.out.println(\"格式: '\" + var6 + \"' -> \" + (var7 ? \"有效\" : \"无效\"));\n        }\n\n        System.out.println(\"\\n=== 测试无效的日期格式 ===\");\n\n        for(String var11 : var2) {\n            boolean var12 = isValidDateFormat(var11);\n            System.out.println(\"格式: '\" + var11 + \"' -> \" + (var12 ? \"有效\" : \"无效\"));\n        }\n\n    }\n}\n","completed":false,"isEnd":false,"failed":false}
