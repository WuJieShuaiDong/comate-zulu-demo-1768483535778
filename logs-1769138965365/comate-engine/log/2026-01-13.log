[2502] [2026-01-15 14:09:28] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"28004a38-95fb-4bc5-a4e9-71482f31d75c","existed":true,"content":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE mapper PUBLIC \"-//mybatis.org//DTD Mapper 3.0//EN\" \"http://mybatis.org/dtd/mybatis-3-mapper.dtd\">\n<mapper namespace=\"com.baidu.tms.loan.dao.LoanAccountHeaderDao\">\n    <sql id=\"Base_Column_List\">\n        heade.account_header_id, heade.trx_category, heade.trx_type, heade.account_type, heade.event_type,\n        heade.event_id, heade.sel_id, heade.source_id, heade.accrual_id, heade.request_number,heade.event_number, heade.segment1,\n        heade.trx_currency_code, heade.bg_code, heade.accounted, heade.account_period, heade.approve_batch_id, heade.approve_status,\n        heade.je_batch_name, heade.je_header_name, heade.account_created_by, heade.gl_transfer_date,\n        heade.creation_date, heade.created_by, heade.last_updated_by, heade.last_update_date, heade.attribute1,\n        heade.attribute2, heade.attribute3, heade.attribute4, heade.attribute5, heade.attribute6\n    </sql>\n    <select id=\"selectVoucherByCondition\" parameterType=\"com.baidu.tms.loan.dto.ApproveFundVoucherQueryDTO\"\n            resultType=\"com.baidu.tms.loan.dto.ApproveFundVoucherDTO\">\n        select\n        <include refid=\"Base_Column_List\"/>\n        from tms_loan_account_header heade\n        <where>\n            EXISTS (select 1 from (SELECT\n            DISTINCT l.line_value company_code\n            FROM\n            tms_loan_role_header h,\n            tms_loan_role_line l\n            WHERE h.role_header_id = l.role_header_id\n            AND h.role_user = #{userName}\n            AND h.end_date IS NULL\n            AND l.line_type='LINE_COMPANY') companys\n            where companys.company_code = heade.segment1)\n            and EXISTS (select 1 from (SELECT\n            DISTINCT l.line_value currency\n            FROM\n            tms_loan_role_header h,\n            tms_loan_role_line l\n            WHERE h.role_header_id = l.role_header_id\n            AND h.role_user = #{userName}\n            AND h.end_date IS NULL\n            AND l.line_type='LINE_CURRENCY') currencys\n            where currencys.currency = heade.trx_currency_code)\n            and EXISTS (select 1 from (SELECT\n            DISTINCT l.line_value transaction_type\n            FROM\n            tms_loan_role_header h,\n            tms_loan_role_line l\n            WHERE h.role_header_id = l.role_header_id\n            AND h.role_user = #{userName}\n            AND h.end_date IS NULL\n            AND l.line_type='LINE_TRANSACTION_TYPE') transactionTypes\n            where transactionTypes.transaction_type = heade.trx_type)\n            AND  (EXISTS (select 1 from (SELECT\n            DISTINCT l.line_value bg\n            FROM\n            tms_loan_role_header h,\n            tms_loan_role_line l\n            WHERE h.role_header_id = l.role_header_id\n            AND h.role_user = #{userName}\n            AND h.end_date IS NULL\n            AND l.line_type='LINE_BG')bgs\n            where bgs.bg = heade.bg_code) or heade.bg_code is null)\n            <if test=\"trxCategory != null and trxCategory != ''\">\n                and heade.trx_category = #{trxCategory,jdbcType=VARCHAR}\n            </if>\n            <if test=\"accountType != null and accountType != ''\">\n                and heade.account_type = #{accountType,jdbcType=VARCHAR}\n            </if>\n            <if test=\"trxType != null and trxType != ''\">\n                and heade.trx_type = #{trxType,jdbcType=VARCHAR}\n            </if>\n            <if test=\"eventType != null and eventType != ''\">\n                and heade.event_type = #{eventType,jdbcType=VARCHAR}\n            </if>\n            <if test=\"segment1 != null and segment1 != ''\">\n                and heade.segment1 = #{segment1,jdbcType=VARCHAR}\n            </if>\n            <if test=\"requestNumber != null and requestNumber != ''\">\n                and heade.request_number = #{requestNumber,jdbcType=VARCHAR}\n            </if>\n            <if test=\"approveStatus != null and approveStatus != ''\">\n                and heade.approve_status = #{approveStatus,jdbcType=VARCHAR}\n            </if>\n            <if test=\"trxCurrencyCode != null and trxCurrencyCode != ''\">\n                and heade.trx_currency_code = #{trxCurrencyCode,jdbcType=VARCHAR}\n            </if>\n            <if test=\"accountPeriod != null and accountPeriod != ''\">\n                and heade.account_period = #{accountPeriod,jdbcType=VARCHAR}\n            </if>\n            <if test=\"createdBy != null and createdBy != ''\">\n                and heade.created_by = #{createdBy,jdbcType=VARCHAR}\n            </if>\n            <if test=\"bgCode != null and bgCode != ''\">\n                and heade.bg_code = #{bgCode,jdbcType=VARCHAR}\n            </if>\n        </where>\n        order by heade.account_header_id desc\n    </select>\n\n    <select id=\"selectExportVoucherList\" parameterType=\"com.baidu.tms.loan.dto.ApproveFundVoucherQueryDTO\"\n            resultType=\"com.baidu.tms.persistent.loan.domain.TmsLoanAccount\">\n        select\n        acc.trx_type,\n\t\tacc.segment1,\n\t\tacc.request_number,\n\t\tacc.event_number,\n\t\tacc.event_type,\n\t\tacc.trx_currency_code,\n\t\tacc.gl_transfer_date,\n\t\tacc.segment2,\n        acc.segment3,\n\t\tacc.segment4,\n\t\tacc.segment5,\n\t\tacc.segment6,\n\t\tacc.segment7,\n\t\tacc.segment8,\n\t\tacc.accounted,\n        acc.entered,\n\t\tacc.exchange_rate,\n\t\tacc.account_period,\n\t\tacc.naryur,\n\t\tacc.approve_status,\n\t\tacc.je_batch_name,\n\t\tacc.je_header_name,\n\t\tacc.direction\n        from tms_loan_account acc,\n        tms_loan_account_header heade\n        where\n        acc.attribute3 = heade.account_header_id\n\t\tand EXISTS (select 1 from (SELECT\n            DISTINCT l.line_value company_code\n            FROM\n            tms_loan_role_header h,\n            tms_loan_role_line l\n            WHERE h.role_header_id = l.role_header_id\n            AND h.role_user = #{userName}\n            AND h.end_date IS NULL\n            AND l.line_type='LINE_COMPANY') companys\n            where companys.company_code = heade.segment1)\n            and EXISTS (select 1 from (SELECT\n            DISTINCT l.line_value currency\n            FROM\n            tms_loan_role_header h,\n            tms_loan_role_line l\n            WHERE h.role_header_id = l.role_header_id\n            AND h.role_user = #{userName}\n            AND h.end_date IS NULL\n            AND l.line_type='LINE_CURRENCY') currencys\n            where currencys.currency = heade.trx_currency_code)\n            and EXISTS (select 1 from (SELECT\n            DISTINCT l.line_value transaction_type\n            FROM\n            tms_loan_role_header h,\n            tms_loan_role_line l\n            WHERE h.role_header_id = l.role_header_id\n            AND h.role_user = #{userName}\n            AND h.end_date IS NULL\n            AND l.line_type='LINE_TRANSACTION_TYPE') transactionTypes\n        where transactionTypes.transaction_type = heade.trx_type)\n        AND (EXISTS (select 1 from (SELECT\n        DISTINCT l.line_value bg\n        FROM\n        tms_loan_role_header h,\n        tms_loan_role_line l\n        WHERE h.role_header_id = l.role_header_id\n        AND h.role_user = #{userName}\n        AND h.end_date IS NULL\n        AND l.line_type='LINE_BG')bgs\n        where bgs.bg = heade.bg_code) or heade.bg_code is null)\n        <if test=\"trxCategory != null and trxCategory != ''\">\n            and heade.trx_category = #{trxCategory,jdbcType=VARCHAR}\n        </if>\n        <if test=\"accountType != null and accountType != ''\">\n            and heade.account_type = #{accountType,jdbcType=VARCHAR}\n        </if>\n        <if test=\"trxType != null and trxType != ''\">\n            and heade.trx_type = #{trxType,jdbcType=VARCHAR}\n        </if>\n        <if test=\"eventType != null and eventType != ''\">\n            and heade.event_type = #{eventType,jdbcType=VARCHAR}\n        </if>\n        <if test=\"segment1 != null and segment1 != ''\">\n            and heade.segment1 = #{segment1,jdbcType=VARCHAR}\n        </if>\n        <if test=\"requestNumber != null and requestNumber != ''\">\n            and heade.request_number = #{requestNumber,jdbcType=VARCHAR}\n        </if>\n        <if test=\"approveStatus != null and approveStatus != ''\">\n            and heade.approve_status = #{approveStatus,jdbcType=VARCHAR}\n        </if>\n        <if test=\"trxCurrencyCode != null and trxCurrencyCode != ''\">\n            and heade.trx_currency_code = #{trxCurrencyCode,jdbcType=VARCHAR}\n        </if>\n        <if test=\"accountPeriod != null and accountPeriod != ''\">\n            and heade.account_period = #{accountPeriod,jdbcType=VARCHAR}\n        </if>\n        <if test=\"createdBy != null and createdBy != ''\">\n            and heade.created_by = #{createdBy,jdbcType=VARCHAR}\n        </if>\n\t\torder by heade.account_header_id desc\n    </select>\n\n</mapper>","completed":false,"isEnd":false,"failed":false}
