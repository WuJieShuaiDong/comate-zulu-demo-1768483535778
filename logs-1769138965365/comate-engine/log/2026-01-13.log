ferenceNumber;\n\n    /**\n     * 用途\n     */\n    private String remark;\n\n    /**\n     * ֧摘要\n     */\n    private String naryur;\n\n    /**\n     * 收款方(户名)\n     */\n    private String payee;\n\n    /**\n     * 收款账号\n     */\n    @Column(name = \"payee_account\")\n    private String payeeAccount;\n\n    /**\n     * 收款方省\n     */\n    @Column(name = \"payee_prov\")\n    private String payeeProv;\n\n    /**\n     * 收款方市\n     */\n    @Column(name = \"payee_city\")\n    private String payeeCity;\n\n    /**\n     * 接口函数名\n     */\n    @Column(name = \"trans_code\")\n    private String transCode;\n\n    /**\n     * 付款状态\n     */\n    private String status;\n\n    /**\n     * 请求返回代码\n     */\n    @Column(name = \"rel_code\")\n    private String relCode;\n\n    /**\n     * 请求返回信息\n     */\n    @Column(name = \"rel_message\")\n    private String relMessage;\n\n    /**\n     * ֧银行代码\n     */\n    @Column(name = \"bank_divide\")\n    private String bankDivide;\n\n    /**\n     * 交易码\n     */\n    @Column(name = \"request_sn\")\n    private String requestSn;\n\n    /**\n     * 收款方银行\n     */\n    @Column(name = \"payee_bank\")\n    private String payeeBank;\n\n    /**\n     * 收款方支行\n     */\n    @Column(name = \"payee_banch\")\n    private String payeeBanch;\n\n    /**\n     * 收款方银行行号\n     */\n    @Column(name = \"payee_banch_number\")\n    private String payeeBanchNumber;\n\n    /**\n     * 请求明细返回代码\n     */\n    @Column(name = \"process_code\")\n    private String processCode;\n\n    /**\n     * 请求明细返回信息\n     */\n    @Column(name = \"process_message\")\n    private String processMessage;\n\n    /**\n     * 收付款行相同\n     */\n    @Column(name = \"inter_bank_flag\")\n    private String interBankFlag;\n\n    /**\n     * ֧实例流水号\n     */\n    @Column(name = \"serial_number\")\n    private String serialNumber;\n\n    /**\n     * 网银交易流水号\n     */\n    @Column(name = \"process_instance_number\")\n    private String processInstanceNumber;\n\n    /**\n     * ֧主业务响应码字段\n     */\n    @Column(name = \"business_request_code\")\n    private String businessRequestCode;\n\n    /**\n     * ֧业务响应码字段\n     */\n    @Column(name = \"business_result_code\")\n    private String businessResultCode;\n\n    /**\n     * 协议号\n     */\n    @Column(name = \"protocol_number\")\n    private String protocolNumber;\n\n    /**\n     * 银行受理时间\n     */\n    @Column(name = \"handle_date\")\n    private Date handleDate;\n\n    /**\n     * 收款银行code\n     */\n    private String attribute1;\n\n    /**\n     * 扩展字段\n     */\n    private String attribute2;\n\n    /**\n     * 扩展字段\n     */\n    private String attribute3;\n\n    /**\n     * 扩展字段\n     */\n    private String attribute4;\n\n    /**\n     * 扩展字段\n     */\n    private String attribute5;\n\n    /**\n     * 创建人\n     */\n    @Column(name = \"create_by\")\n    private String createBy;\n\n    /**\n     * 创建时间\n     */\n    @Column(name = \"create_date\")\n    private Date createDate;\n\n    /**\n     * 更新人\n     */\n    @Column(name = \"last_update_by\")\n    private String lastUpdateBy;\n\n    /**\n     * 更新时间\n     */\n    @Column(name = \"last_update_date\")\n    private Date lastUpdateDate;\n\n}","completed":false,"isEnd":false,"failed":false}
