列表\n     * @param status 状态\n     * @return 更新行数\n     */\n    int batchUpdateHeaderStatus(List<Long> headerIds, String status);\n}\n","stream":true,"source":"E2EBotConversation","acceptable":true,"action":"edit","openFileDiff":false,"conversationId":"977ec667-0cb2-40af-8a72-830f099162d2","elementId":"212c1136-c0e7-49d7-a817-d651594b2653","inlineView":true,"uuid":"ba68a17e-8bab-4767-bebd-681dbbf3ad80"}}
