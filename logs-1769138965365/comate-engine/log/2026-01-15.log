ata['positions'] == 1]\n            sell_signals = plot_data[plot_data['positions'] == -1]\n            \n            fig_candle.add_trace(go.Scatter(\n                x=buy_signals.index, y=buy_signals['low']*0.98,\n                mode='markers', marker=dict(symbol='triangle-up', size=10, color='red'),\n                name='买入信号'\n            ), row=1, col=1)\n            \n            fig_candle.add_trace(go.Scatter(\n                x=sell_signals.index, y=sell_signals['high']*1.02,\n                mode='markers', marker=dict(symbol='triangle-down', size=10, color='green'),\n                name='卖出信号'\n            ), row=1, col=1)\n            \n            # 成交量\n            fig_candle.add_trace(go.Bar(x=plot_data.index, y=plot_data['volume'], name='成交量', marker_color='gray'), row=2, col=1)\n            \n            fig_candle.update_layout(xaxis_rangeslider_visible=False, height=600, hovermode=\"x unified\")\n            st.plotly_chart(fig_candle, use_container_width=True)\n            \n            # --- 4. 数据详情 ---\n            with st.expander(\"查看详细回测数据\"):\n                st.dataframe(result[['open', 'close', 'short_mavg', 'long_mavg', 'signal', 'strategy_cum_returns']].style.format(\"{:.2f}\"))\n                \n        elif df is None:\n            st.warning(\"未获取到数据，请检查股票代码是否正确 (如 600519)。\")\n        else:\n            st.warning(f\"数据量不足，无法计算 {long_window} 日均线，请拉长回测时间范围。\")\n\nelse:\n    st.info(\"👈 请在左侧设置参数并点击【开始回测】\")\n    st.markdown(\"\"\"\n    ### 快速入门指南\n    1. **股票代码**: 输入6位数字代码，如 `000001` (平安银行), `601318` (中国平安), `300750` (宁德时代)。\n    2. **策略原理 (双均线)**:\n       - **买入**: 当短期均线从下向上穿过长期均线 (金叉)。\n       - **卖出**: 当短期均线从上向下穿过长期均线 (死叉)。\n       - *注*: 这是一个趋势跟踪策略，在震荡市中可能会频繁磨损本金。\n    3. **数据来源**: 实时从 AkShare (东方财富源) 获取，完全免费。\n    \"\"\")","selections":[{"start":{"line":0,"column":0},"end":{"line":0,"column":0}}]}
