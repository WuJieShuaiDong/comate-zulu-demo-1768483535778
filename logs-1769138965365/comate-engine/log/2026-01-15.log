[82415] [2026-01-16 10:07:39] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"existed":true,"uuid":"144e18b0-57fe-470c-922f-ab775b67d971","content":"import pandas as pd\n# 模拟 app.py 中的 generate_sql 函数逻辑 (为了测试方便，我先复制有问题的逻辑部分进行测试，确认报错)\n# 之后我会引入修复后的逻辑\n\nDB_CONFIG = {\n    \"MySQL\": {\"quote\": \"`\", \"features\": []},\n    \"PostgreSQL\": {\"quote\": \"\\\"\", \"features\": []}\n}\n\ndef generate_sql_simulated(action_type, db_type, table_name, df):\n    config = DB_CONFIG.get(db_type)\n    q = config[\"quote\"]\n    \n    # --- BUG LOCATION ---\n    # 原代码逻辑：硬编码了 \"字段名\"\n    # valid_rows = df[df[\"字段名\"].str.strip() != \"\"] \n    \n    # --- 修复后的逻辑 ---\n    # 根据 action_type 决定主要列名\n    if action_type in [\"新建表\", \"添加字段\", \"修改字段\", \"删除字段\"]:\n        key_col = \"字段名\"\n    elif action_type in [\"添加索引\", \"删除索引\"]:\n        key_col = \"索引名\"\n    else:\n        key_col = None\n\n    if key_col and key_col in df.columns:\n        valid_rows = df[df[key_col].str.strip() != \"\"]\n    else:\n        valid_rows = df\n\n    if valid_rows.empty and action_type not in [\"删除表\", \"清空表\"]:\n        return \"-- Empty\"\n        \n    sqls = []\n    # 模拟简单的生成逻辑\n    if action_type == \"删除索引\":\n        for _, row in valid_rows.iterrows():\n            sqls.append(f\"DROP INDEX {row['索引名']};\")\n            \n    return \"\\n\".join(sqls)\n\ndef run_tests():\n    print(\"Running tests...\")\n    \n    # Test 1: 删除索引 (复现 KeyError)\n    df_drop_idx = pd.DataFrame([{\"索引名\": \"idx_1\"}, {\"索引名\": \"\"}]) # 模拟包含空行\n    try:\n        sql = generate_sql_simulated(\"删除索引\", \"MySQL\", \"users\", df_drop_idx)\n        print(f\"[PASS] 删除索引 SQL: {sql}\")\n    except KeyError as e:\n        print(f\"[FAIL] 删除索引报错: {e}\")\n    except Exception as e:\n        print(f\"[FAIL] 删除索引未知错误: {e}\")\n\n    # Test 2: 新建表 (常规)\n    df_create = pd.DataFrame([{\"字段名\": \"id\", \"类型\": \"INT\"}])\n    try:\n        sql = generate_sql_simulated(\"新建表\", \"MySQL\", \"users\", df_create)\n        print(f\"[PASS] 新建表逻辑检查通过\")\n    except Exception as e:\n        print(f\"[FAIL] 新建表报错: {e}\")\n\nif __name__ == \"__main__\":\n    run_tests()","isDirty":false}
