[97683] [2026-01-10 12:00:18] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"9241705c-3f1c-4f62-82af-ae3e13978b0e","existed":true,"content":"import java.util.Arrays;\nimport java.util.regex.Pattern;\n\npublic class test_line_separator {\n    // 正则表达式匹配多种行分隔符：Windows(\\r\\n)、Unix(\\n)、Mac(\\r)\n    private static final Pattern LINE_SEPARATOR_PATTERN = Pattern.compile(\"\\\\r?\\\\n|\\\\r\");\n\n    public static void main(String[] args) {\n        String testData = \"字段1|字段2|字段3\";\n        String unixData = testData + \"\\n\" + \"值1|值2|值3\";\n        String windowsData = testData + \"\\r\\n\" + \"值1|值2|值3\";\n        String macData = testData + \"\\r\" + \"值1|值2|值3\";\n        String singleLine = \"值1|值2|值3\";\n\n        System.out.println(\"=== 测试行分隔符兼容性 ===\");\n\n        // 测试Unix换行符\n        String[] unixLines = LINE_SEPARATOR_PATTERN.split(unixData);\n        System.out.println(\"Unix换行符: \" + Arrays.toString(unixLines));\n        System.out.println(\"Unix行数: \" + unixLines.length);\n\n        // 测试Windows换行符\n        String[] windowsLines = LINE_SEPARATOR_PATTERN.split(windowsData);\n        System.out.println(\"Windows换行符: \" + Arrays.toString(windowsLines));\n        System.out.println(\"Windows行数: \" + windowsLines.length);\n\n        // 测试Mac换行符\n        String[] macLines = LINE_SEPARATOR_PATTERN.split(macData);\n        System.out.println(\"Mac换行符: \" + Arrays.toString(macLines));\n        System.out.println(\"Mac行数: \" + macLines.length);\n\n        // 测试单行数据\n        String[] singleLines = LINE_SEPARATOR_PATTERN.split(singleLine);\n        System.out.println(\"单行数据: \" + Arrays.toString(singleLines));\n        System.out.println(\"单行数据行数: \" + singleLines.length);\n\n        System.out.println(\"=== 测试完成 ===\");\n    }\n}","completed":false,"isEnd":false,"failed":false}
