[97683] [2026-01-10 12:06:29] [INFO] [ENGINE]  <--------- ENGINE SEND: VIRTUAL_EDITOR_EVENT {"action":"openVirtualDiffDocument","payload":{"absolutePath":"/Users/xiaoliu/baidu/bpit-proc-apps/pmc/pmc-basic-bankcommon/test_multiple_records.java","content":"","modified":"import java.util.ArrayList;\nimport java.util.List;\nimport java.util.regex.Pattern;\n\npublic class test_multiple_records {\n    // 银行交易数据通常以状态字段开头（如\"0\"表示正常）\n    private static final String[] dataStartPatterns = {\"0\", \"1\", \"正常\", \"成功\", \"N\", \"Y\"};\n    \n    public static void main(String[] args) {\n        // 您提供的示例：一行中包含表头和2条数据记录\n        String combinedLine = \"状态|交易日期|交易时间|业务类型|流水号|流水序号|账号|户名|收支标志|币种|交易金额|余额|可用余额|对方账号|对方户名|对方地址|对方开户行行号|对方开户行行名|票据种类|票据号码|票据名称|票据签发日期|附言|备注|交易码|备用|0|20251105|093003|2|EBB0001P70190041|1|310069079018800073806|怒访址撵鉴遮斌粤惨佣|D|CNY|100.00|11991096.17|0|81100614850188002002204|僧铃抬鲸届系括冉翘损御缎缠||01110146999|交通银行北京广渠路支行||||||q2yuyh5004#测试1|101700||0|20251105|093022|2|EBB0001P70080041|2|310069079018800073806|怒访址撵鉴遮斌粤惨佣|D|CNY|100.00|11990996.17|0|81100614850188002002205|僧铃抬鲸届系括冉翘损御缎缠||01110146999|交通银行北京广渠路支行||||||q2yuyh50054#测试1|101700||\";\n        \n        System.out.println(\"=== 测试多记录合并行 ===\");\n        \n        // 分割字段\n        String[] fields = combinedLine.split(\"\\\\|\", -1);\n        System.out.println(\"字段总数: \" + fields.length);\n        \n        // 查找数据记录的起始位置\n        List<Integer> dataStartPositions = findDataStartPositions(fields);\n        System.out.println(\"检测到的数据记录起始位置: \" + dataStartPositions);\n        System.out.println(\"检测到的数据记录数量: \" + dataStartPositions.size());\n        \n        // 提取并显示每条数据记录\n        for (int recordIndex = 0; recordIndex < dataStartPositions.size(); recordIndex++) {\n            int dataStartPos = dataStartPositions.get(recordIndex);\n            int dataEndPos = (recordIndex == dataStartPositions.size() - 1) \n                ? fields.length \n                : dataStartPositions.get(recordIndex + 1);\n            \n            // 构建单条数据行\n            StringBuilder dataBuilder = new StringBuilder();\n            for (int i = dataStartPos; i < dataEndPos; i++) {\n                if (i > dataStartPos) dataBuilder.append(\"|\");\n                dataBuilder.append(fields[i]);\n            }\n            \n            System.out.println(\"第\" + (recordIndex + 1) + \"条数据记录: \" + dataBuilder.toString());\n            System.out.println(\"字段数: \" + (dataEndPos - dataStartPos));\n            System.out.println(\"---\");\n        }\n    }\n    \n    /**\n     * 查找所有数据记录的起始位置\n     */\n    private static List<Integer> findDataStartPositions(String[] fields) {\n        List<Integer> positions = new ArrayList<>();\n        \n        for (int i = 0; i < fields.length; i++) {\n            String field = fields[i].trim();\n            \n            // 检查是否匹配数据记录的起始模式\n            if (isDataRecordStart(field)) {\n                positions.add(i);\n            }\n        }\n        \n        return positions;\n    }\n    \n    /**\n     * 判断字段是否标识数据记录的起始\n     */\n    private static boolean isDataRecordStart(String field) {\n        // 检查是否匹配给定的起始模式\n        for (String pattern : dataStartPatterns) {\n            if (pattern.equals(field)) {\n                return true;\n            }\n        }\n        \n        // 检查是否是8位日期格式（YYYYMMDD）\n        if (field.matches(\"\\\\d{8}\")) {\n            boolean isDate = true;\n            try {\n                // 简单验证\n                int year = Integer.parseInt(field.substring(0, 4));\n                int month = Integer.parseInt(field.substring(4, 6));\n                int day = Integer.parseInt(field.substring(6, 8));\n                if (year >= 2000 && year <= 2100 && month >= 1 && month <= 12 && day >= 1 && day <= 31) {\n                    return true;\n                }\n            } catch (Exception e) {\n                // 忽略异常\n            }\n        }\n        \n        return false;\n    }\n}","stream":true,"source":"E2EBotConversation","acceptable":true,"action":"edit","openFileDiff":false,"conversationId":"7246351f-424c-45d8-aaf9-4c3a98cf2211","elementId":"6961d02f68af052df00204f5","inlineView":true,"uuid":"9593cfb0-3029-470d-8bf5-a5f400172df6"}}
