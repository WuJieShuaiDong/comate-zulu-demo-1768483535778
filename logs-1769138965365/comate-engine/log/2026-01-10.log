[97683] [2026-01-10 12:15:29] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"34b2ea28-e351-4a4c-a541-56c29e90b9ab","existed":true,"content":"import java.lang.reflect.Method;\n\npublic class test_field_count_parameter {\n    public static void main(String[] args) {\n        try {\n            Class<?> parserClass = Class.forName(\"com.baidu.pmc.bankcommon.core.utils.bcm.BankTransactionParser\");\n\n            // 检查方法重载\n            Method[] methods = parserClass.getDeclaredMethods();\n\n            System.out.println(\"=== 检查 BankTransactionParser 类的方法重载 ===\");\n            for (Method method : methods) {\n                if (method.getName().contains(\"parseBankTransactions\")) {\n                    System.out.print(\"方法: \" + method.getName());\n                    Class<?>[] params = method.getParameterTypes();\n                    System.out.print(\"(参数: \");\n                    for (int i = 0; i < params.length; i++) {\n                        if (i > 0) System.out.print(\", \");\n                        System.out.print(params[i].getSimpleName());\n                    }\n                    System.out.println(\")\");\n                }\n\n                if (method.getName().contains(\"parseDataLine\")) {\n                    System.out.print(\"方法: \" + method.getName());\n                    Class<?>[] params = method.getParameterTypes();\n                    System.out.print(\"(参数: \");\n                    for (int i = 0; i < params.length; i++) {\n                        if (i > 0) System.out.print(\", \");\n                        System.out.print(params[i].getSimpleName());\n                    }\n                    System.out.println(\")\");\n                }\n            }\n\n            System.out.println(\"=== 测试完成 ===\");\n\n        } catch (Exception e) {\n            e.printStackTrace();\n        }\n    }\n}","completed":false,"isEnd":false,"failed":false}
