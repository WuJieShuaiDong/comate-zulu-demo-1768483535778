[97683] [2026-01-10 12:03:34] [INFO] [ENGINE]  <--------- ENGINE SEND: VIRTUAL_EDITOR_EVENT {"action":"openVirtualDiffDocument","payload":{"absolutePath":"/Users/xiaoliu/baidu/bpit-proc-apps/pmc/pmc-basic-bankcommon/test_combined_line.java","content":"","modified":"import java.util.Arrays;\nimport java.util.regex.Pattern;\n\npublic class test_combined_line {\n    // 正则表达式匹配多种行分隔符：Windows(\\r\\n)、Unix(\\n)、Mac(\\r)\n    private static final Pattern LINE_SEPARATOR_PATTERN = Pattern.compile(\"\\\\r?\\\\n|\\\\r\");\n    \n    public static void main(String[] args) {\n        // 您提供的示例：表头和数据在一行，没有换行符\n        String combinedLine = \"状态|交易日期|交易时间|业务类型|流水号|流水序号|账号|户名|收支标志|币种|交易金额|余额|可用余额|对方账号|对方户名|对方地址|对方开户行行号|对方开户行行名|票据种类|票据号码|票据名称|票据签发日期|附言|备注|交易码|备用|0|20251105|093003|2|EBB0001P70190041|1|310069079018800073806|怒访址撵鉴遮斌粤惨佣|D|CNY|100.00|11991096.17|0|81100614850188002002204|僧铃抬鲸届系括冉翘损御缎缠||01110146999|交通银行北京广渠路支行||||||q2yuyh5004#测试1|101700||\";\n        \n        System.out.println(\"=== 测试表头数据合并行 ===\");\n        \n        // 使用分隔符分割\n        String[] lines = LINE_SEPARATOR_PATTERN.split(combinedLine);\n        System.out.println(\"分割后行数: \" + lines.length);\n        System.out.println(\"第1行: \" + lines[0]);\n        \n        // 测试表头关键词检测\n        System.out.println(\"包含表头关键词: \" + containsHeaderKeywords(combinedLine));\n        \n        // 测试数据字段识别\n        String[] fields = combinedLine.split(\"\\\\|\", -1);\n        System.out.println(\"字段数量: \" + fields.length);\n        \n        // 查找数据开始位置\n        int dataStartPos = findDataStartPosition(fields);\n        System.out.println(\"数据开始位置: \" + dataStartPos);\n        \n        if (dataStartPos >= 0) {\n            // 构建数据部分\n            StringBuilder dataBuilder = new StringBuilder();\n            for (int i = dataStartPos; i < fields.length; i++) {\n                if (i > dataStartPos) dataBuilder.append(\"|\");\n                dataBuilder.append(fields[i]);\n            }\n            System.out.println(\"提取的数据部分: \" + dataBuilder.toString());\n        }\n    }\n    \n    private static boolean containsHeaderKeywords(String dataString) {\n        String[] headerKeywords = {\"状态\", \"交易日期\", \"交易时间\", \"业务类型\", \"流水号\", \"账号\", \"户名\", \"收支标志\", \n                                \"币种\", \"交易金额\", \"余额\", \"可用余额\", \"对方账号\", \"对方户名\", \"对方地址\"};\n        \n        for (String keyword : headerKeywords) {\n            if (dataString.contains(keyword)) {\n                return true;\n            }\n        }\n        return false;\n    }\n    \n    private static int findDataStartPosition(String[] fields) {\n        for (int i = 0; i < fields.length; i++) {\n            String field = fields[i].trim();\n            if (looksLikeDataField(field)) {\n                return i;\n            }\n        }\n        return -1;\n    }\n    \n    private static boolean looksLikeDataField(String field) {\n        if (field == null || field.isEmpty()) return false;\n        \n        // 包含数字\n        if (field.matches(\".*\\\\d.*\")) return true;\n        // 8位日期格式\n        if (field.matches(\"\\\\d{8}\")) return true;\n        // 6位时间格式\n        if (field.matches(\"\\\\d{6}\")) return true;\n        // 金额格式\n        if (field.matches(\"\\\\d+\\\\.\\\\d{2}\")) return true;\n        \n        return false;\n    }\n}","stream":true,"source":"E2EBotConversation","acceptable":true,"action":"edit","openFileDiff":false,"conversationId":"7246351f-424c-45d8-aaf9-4c3a98cf2211","elementId":"6961cf7cba2ae4344dc5ca14","inlineView":true,"uuid":"85198128-77d9-46a0-ac53-b59207048dfb"}}
