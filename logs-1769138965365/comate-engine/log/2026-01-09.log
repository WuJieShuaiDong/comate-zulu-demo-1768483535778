[55864] [2026-01-09 20:03:52] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"de0bc53f-64e4-4d51-a361-4a85790860c6","existed":true,"absolutePath":"/Users/xiaoliu/baidu/bpit-proc-apps/pmc/pmc-basic-bankcommon/src/test/java/com/baidu/pmc/bankcommon/core/utils/BankTransactionParserTest.java","content":"package com.baidu.pmc.bankcommon.core.utils;\n\nimport com.baidu.pmc.bankcommon.core.model.BankTransaction;\nimport lombok.extern.slf4j.Slf4j;\nimport org.junit.Test;\nimport org.junit.runner.RunWith;\nimport org.springframework.boot.test.context.SpringBootTest;\nimport org.springframework.test.context.junit4.SpringRunner;\n\nimport java.util.List;\n\nimport static org.junit.Assert.*;\n\n/**\n * 银行交易记录解析工具测试类\n *\n * @author baidu.pmc\n * @since 2025-01-09\n */\n@Slf4j\n@RunWith(SpringRunner.class)\n@SpringBootTest\npublic class BankTransactionParserTest {\n\n    /**\n     * 测试正常银行流水数据解析\n     */\n    @Test\n    public void testParseNormalBankTransactions() {\n        // 测试数据 - 银行流水文本格式\n        String bankData = \"状态|交易日期|交易时间|业务类型|流水号|流水序号|账号|户名|收支标志|币种|交易金额|余额|可用余额|对方账号|对方户名|对方地址|对方开户行行号|对方开户行行名|票据种类|票据号码|票据名称|票据签发日期|附言|备注|交易码|备用\\n\" +\n                \"0|20251105|093003|2|EBB0001P70190041|1|310069079018800073806|怒访址撵鉴遮斌粤惨佣|D|CNY|100.00|11991096.17|0|81100614850188002002204|僧铃抬鲸届系括冉翘损御缎缠||01110146999|交通银行北京广渠路支行||||||q2yuyh5004#测试1|101700||\\n\" +\n                \"0|20251105|093022|2|EBB0001P70080041|2|310069079018800073806|怒访址撵鉴遮斌粤惨佣|D|CNY|100.00|11990996.17|0|81100614850188002002205|僧铃抬鲸届系括冉翘损御缎缠||01110146999|交通银行北京广渠路支行||||||q2yuyh50054#测试1|101700||\";\n\n        // 执行解析\n        List<BankTransaction> transactions = BankTransactionParser.parseBankTransactions(bankData);\n\n        // 断言验证\n        assertNotNull(\"交易记录列表不应为空\", transactions);\n        assertEquals(\"应解析出2条交易记录\", 2, transactions.size());\n\n        // 验证第一条记录\n        BankTransaction firstTransaction = transactions.get(0);\n        assertNotNull(\"第一条交易记录不应为空\", firstTransaction);\n        assertEquals(\"状态不正确\", \"0\", firstTransaction.getStatus());\n        assertEquals(\"交易日期不正确\", \"20251105\", firstTransaction.getTransactionDate());\n        assertEquals(\"交易时间不正确\", \"093003\", firstTransaction.getTransactionTime());\n        assertEquals(\"业务类型不正确\", \"2\", firstTransaction.getBusinessType());\n        assertEquals(\"流水号不正确\", \"EBB0001P70190041\", firstTransaction.getSerialNumber());\n        assertEquals(\"流水序号不正确\", \"1\", firstTransaction.getSequenceNumber());\n        assertEquals(\"账号不正确\", \"310069079018800073806\", firstTransaction.getAccountNumber());\n        assertEquals(\"户名不正确\", \"怒访址撵鉴遮斌粤惨佣\", firstTransaction.getAccountName());\n        assertEquals(\"收支标志不正确\", \"D\", firstTransaction.getIncomeExpenseFlag());\n        assertEquals(\"币种不正确\", \"CNY\", firstTransaction.getCurrency());\n        assertEquals(\"交易金额不正确\", \"100.00\", firstTransaction.getTransactionAmount());\n        assertEquals(\"余额不正确\", \"11991096.17\", firstTransaction.getBalance());\n        assertEquals(\"可用余额不正确\", \"0\", firstTransaction.getAvailableBalance());\n        assertEquals(\"附言不正确\", \"q2yuyh5004#测试1\", firstTransaction.getRemarkMemo());\n        assertEquals(\"交易码不正确\", \"101700\", firstTransaction.getTransactionCode());\n\n        // 验证第二条记录\n        BankTransaction secondTransaction = transactions.get(1);\n        assertEquals(\"第二条记录的流水号不正确\", \"EBB0001P70080041\", secondTransaction.getSerialNumber());\n        assertEquals(\"第二条记录的流水序号不正确\", \"2\", secondTransaction.getSequenceNumber());\n        assertEquals(\"第二条记录的余额不正确\", \"11990996.17\", secondTransaction.getBalance());\n\n        log.info(\"✅ 测试通过：成功解析 {} 条银行交易记录\", transactions.size());\n        BankTransactionParser.printParsingResult(transactions);\n    }\n\n    /**\n     * 测试空数据解析\n     */\n    @Test\n    public void testParseEmptyData() {\n        String emptyData = \"\";\n        List<BankTransaction> transactions = BankTransactionParser.parseBankTransactions(emptyData);\n        assertNotNull(\"空数据应返回空列表\", transactions);\n        assertTrue(\"空数据应返回空列表\", transactions.isEmpty());\n\n        log.info(\"✅ 空数据解析测试通过\");\n    }\n\n    /**\n     * 测试格式异常数据\n     */\n    @Test\n    public void testParseMalformedData() {\n        // 测试字段数量不正确的数据行\n        String malformedData = \"状态|交易日期|交易时间|业务类型\\n\" +\n                \"0|20251105|093003|2|多余的字段|多余的字段\";\n\n        List<BankTransaction> transactions = BankTransactionParser.parseBankTransactions(malformedData);\n        assertNotNull(\"异常数据应返回空列表\", transactions);\n        assertTrue(\"异常数据应返回空列表\", transactions.isEmpty());\n\n        log.info(\"✅ 格式异常数据解析测试通过\");\n    }\n\n    /**\n     * 测试用户提供的完整数据\n     */\n    @Test\n    public void testParseUserProvidedData() {\n        // 使用用户提供的完整数据进行测试（截取前几条）\n        String userData = \"状态|交易日期|交易时间|业务类型|流水号|流水序号|账号|户名|收支标志|币种|交易金额|余额|可用余额|对方账号|对方户名|对方地址|对方开户行行号|对方开户行行名|票据种类|票据号码|票据名称|票据签发日期|附言|备注|交易码|备用\\n\" +\n                \"0|20251105|093003|2|EBB0001P70190041|1|310069079018800073806|怒访址撵鉴遮斌粤惨佣|D|CNY|100.00|11991096.17|0|81100614850188002002204|僧铃抬鲸届系括冉翘损御缎缠||01110146999|交通银行北京广渠路支行||||||q2yuyh5004#测试1|101700||\\n\" +\n                \"0|20251105|093022|2|EBB0001P70080041|2|310069079018800073806|怒访址撵鉴遮斌粤惨佣|D|CNY|100.00|11990996.17|0|81100614850188002002205|僧铃抬鲸届系括冉翘损御缎缠||01110146999|交通银行北京广渠路支行||||||q2yuyh50054#测试1|101700||\\n\" +\n                \"0|20251105|093041|2|EBB0001P70160051|3|310069079018800073806|怒访址撵鉴遮斌粤惨佣|D|CNY|100.00|11990896.17|0|81100614850188002002206|僧铃抬鲸届系括冉翘损御缎缠||01110146999|交通银行北京广渠路支行||||||q2yuy454#测试1|101700||\\n\" +\n                \"0|20251105|093058|2|EBB0001P70160052|4|310069079018800073806|怒访址撵鉴遮斌粤惨佣|D|CNY|100.00|11990796.17|0|81100614850188002002207|僧铃抬鲸届系括冉翘损御缎缠||01110146999|交通银行北京广渠路支行||||||q2yuy4554#测试1|101700||\";\n\n        List<BankTransaction> transactions = BankTransactionParser.parseBankTransactions(userData);\n\n        assertEquals(\"应解析出完整的4条交易记录\", 4, transactions.size());\n\n        // 验证解析的数据完整性\n        for (int i = 0; i < transactions.size(); i++) {\n            BankTransaction transaction = transactions.get(i);\n            assertNotNull(\"交易记录不应为空\", transaction);\n            assertEquals(\"账号应一致\", \"310069079018800073806\", transaction.getAccountNumber());\n            assertEquals(\"户名应一致\", \"怒访址撵鉴遮斌粤惨佣\", transaction.getAccountName());\n            assertEquals(\"币种应一致\", \"CNY\", transaction.getCurrency());\n            assertEquals(\"收支标志应一致\", \"D\", transaction.getIncomeExpenseFlag());\n        }\n\n        log.info(\"✅ 用户数据测试通过：成功解析 {} 条完整交易记录\", transactions.size());\n    }\n\n    /**\n     * 测试账号脱敏功能\n     */\n    @Test\n    public void testAccountNumberMasking() {\n        String testData = \"状态|交易日期|交易时间|业务类型|流水号|流水序号|账号|户名|收支标志|币种|交易金额|余额|可用余额|对方账号|对方户名|对方地址|对方开户行行号|对方开户行行名|票据种类|票据号码|票据名称|票据签发日期|附言|备注|交易码|备用\\n\" +\n                \"0|20251105|093003|2|EBB0001P70190041|1|310069079018800073806|测试户名|D|CNY|100.00|11991096.17|0|81100614850188002002204|对方户名||01110146999|开户行名称||||||测试附言|101700||\";\n\n        List<BankTransaction> transactions = BankTransactionParser.parseBankTransactions(testData);\n        Transaction transaction = transactions.get(0);\n\n        // 验证账号不应为空\n        assertNotNull(\"账号不应为空\", transaction.getAccountNumber());\n        assertNotNull(\"对方账号不应为空\", transaction.getCounterpartyAccount());\n\n        log.info(\"✅ 账号脱敏测试通过\");\n    }\n}","scheme":"file","completed":false,"isEnd":false,"failed":false}
