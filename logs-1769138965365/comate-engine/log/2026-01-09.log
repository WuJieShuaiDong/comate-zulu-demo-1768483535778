    private OperateByJDBC operateByJDBC;\n\n    private static final Integer REDIS_EXPIRE = 3600;\n\n    @Override\n    public List<String> getBankCommonInstructDynamic(String bankCode) {\n        if (StringUtils.isBlank(bankCode)) {\n            throw new ServiceException(\"银行编码不能为空\");\n        }\n        String key = Constants.RedisKey.BANK_COMMON_COL_SET + bankCode;\n        List<String> result = new ArrayList<>();\n        result = JedisUtil.getList(key, String.class);\n        // if (CollectionUtils.isNotEmpty(result)) {\n        //     return result;\n        // }\n\n        Example examplePageNo = new Example(PmcPayCommonBankColSet.class);\n        examplePageNo.createCriteria().\n                andEqualTo(\"bankCode\", bankCode)\n                .andEqualTo(\"tableFlag\", Constants.ENABLED_Y)\n                .andEqualTo(\"enableFlag\", Constants.ENABLED_Y);\n        List<PmcPayCommonBankColSet> pmcPayCommonBankColSets = pmcPayCommonBankColSetMapper.selectByExample(examplePageNo);\n\n        if (CollectionUtils.isEmpty(pmcPayCommonBankColSets)) {\n            throw new ServiceException(\"银行配置不存在！\");\n        }\n        result = pmcPayCommonBankColSets.stream().map(PmcPayCommonBankColSet::getColumnCode)\n                .collect(Collectors.toList());\n        JedisUtil.setex(key, REDIS_EXPIRE, result);\n        return result;\n    }\n\n    @Override\n    public List<PmcPayCommonBankColSet> getBankColSet(String bankCode) {\n        if (org.apache.commons.lang3.StringUtils.isBlank(bankCode)) {\n            return Collections.emptyList();\n        }\n        String redisKey = Constants.RedisKey.INSTRUCT_TABLE_COL_PREFIX + bankCode;\n        List<PmcPayCommonBankColSet> list = null;\n        try {\n            list = JedisUtil.getList(redisKey, PmcPayCommonBankColSet.class);\n        } catch (Exception e) {\n            log.error(\"get bank {} col set from redis error\", bankCode, e);\n        }\n        // if (org.apache.commons.collections4.CollectionUtils.isNotEmpty(list)) {\n        //     return list;\n        // }\n        PmcPayCommonBankColSet query = new PmcPayCommonBankColSet();\n        query.setBankCode(bankCode);\n        query.setTableFlag(Constants.ENABLED_Y);\n        query.setEnableFlag(Constants.ENABLED_Y);\n        list = pmcPayCommonBankColSetMapper.select(query);\n        list = ListUtils.emptyIfNull(list).stream()\n                .filter(col -> org.apache.commons.lang3.StringUtils.isNotBlank(col.getColumnCode())).collect(Collectors.toList());\n        if (org.apache.commons.collections4.CollectionUtils.isEmpty(list)) {\n            log.error(\"bank {} do not have any config\", bankCode);\n            return Collections.emptyList();\n        }\n        try {\n            JedisUtil.setex(redisKey, REDIS_EXPIRE, list);\n        } catch (Exception e) {\n            log.error(\"set bank {} col set to redis error\", bankCode, e);\n        }\n        return list;\n    }\n\n    @Override\n    public String getBankSuffix(String bankCode) {\n        if (StringUtils.isBlank(bankCode)) {\n            throw new ServiceException(\"银行编码不能为空\");\n        }\n        String result = null;\n        String key = Constants.RedisKey.BANK_COMMON_CODE_SUFFIX + bankCode;\n        result = (String) JedisUtil.get(key);\n         if (StringUtils.isNotBlank(result)) {\n             return result;\n         }\n        Example examplePageNo = new Example(PmcPayCommonBankSet.class);\n        examplePageNo.createCriteria().\n                andEqualTo(\"bankCode\", bankCode);\n        List<PmcPayCommonBankSet> pmcPayCommonBankSets = pmcPayCommonBankSetMapper.selectByExample(examplePageNo);\n        if (CollectionUtils.isEmpty(pmcPayCommonBankSets)) {\n            log.error(\"bankCode={},银行配置不存在！\", bankCode);\n            throw new ServiceException(\"银行配置不存在！\");\n        }\n        result = pmcPayCommonBankSets.get(0).getBankSuffix();\n        JedisUtil.setex(key, REDIS_EXPIRE, result);\n        return result;\n    }\n\n    @Override\n    public Object getBankCommonFlexValue(PmcPayCommonBankColSet colSet) {\n        if (Objects.isNull(colSet) || org.apache.commons.lang3.StringUtils.isBlank(colSet.getTransDetail())) {\n            return null;\n        }\n        PmcPayCommonTransFlexSet query = new PmcPayCommonTransFlexSet();\n        query.setTransCode(colSet.getTransDetail());\n        List<PmcPayCommonTransFlexSet> flexSets = transFlexSetMapper.select(query);\n        if (org.apache.commons.collections4.CollectionUtils.isEmpty(flexSets)) {\n            log.error(\"flexSet {} do not existed\", query.getTransCode());\n            return null;\n        }\n        PmcPayCommonTransFlexSet flexSet = flexSets.get(0);\n        if (org.apache.commons.lang3.StringUtils.isAnyBlank(flexSet.getFlexValue(), flexSet.getResultCol())) {\n            log.error(\"flexSet {} do not contain flex value or result col\", flexSet.getTransCode());\n            return null;\n        }\n        List<String> values = Arrays.asList(flexSet.getFlexValue().split(\",\"));\n        List<FndFlexValue> fndFlexValues = operateByJDBC.selectBySetAndValue(flexSet.getFlexSetName(), values);\n        if (org.apache.commons.collections4.CollectionUtils.isEmpty(fndFlexValues)) {\n            log.error(\"frame flex set {} do not contain flex value {}\", flexSet.getFlexSetName(), values);\n            return null;\n        }\n        Object result = null;\n        FndFlexValue fndFlexValue = fndFlexValues.get(0);\n        try {\n            result = ReflectUtils.invokeGetMethod(fndFlexValue, flexSet.getResultCol());\n        } catch (Exception e) {\n            log.error(\"get flex value from set {} value {} col {} error\", flexSet.getFlexSetName(),\n                    flexSet.getFlexValue(), flexSet.getResultCol(), e);\n        }\n        return result;\n    }\n\n    @Override\n    public List<String> getTransferBankCodeList() {\n        Example examplePageNo = new Example(PmcPayCommonBankSet.class);\n        examplePageNo.createCriteria().\n                andEqualTo(\"transferFlag\", Constants.ENABLED_Y);\n        List<PmcPayCommonBankSet> pmcPayCommonBankSets = pmcPayCommonBankSetMapper.selectByExample(examplePageNo);\n        if (CollectionUtils.isEmpty(pmcPayCommonBankSets)) {\n            throw new ServiceException(\"银行配置不存在！\");\n        }\n        List<String> result = pmcPayCommonBankSets\n                .stream().map(PmcPayCommonBankSet::getBankCode).collect(Collectors.toList());\n        return result;\n    }\n}\n","completed":false,"isEnd":false,"failed":false}
