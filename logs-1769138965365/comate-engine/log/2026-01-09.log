\n    /**\n     * 票据名称\n     */\n    private String billName;\n\n    /**\n     * 票据签发日期\n     */\n    private String billIssueDate;\n\n    /**\n     * 附言\n     */\n    private String remarkMemo;\n\n    /**\n     * 备注\n     */\n    private String additionalRemark;\n\n    /**\n     * 交易码\n     */\n    private String transactionCode;\n\n    /**\n     * 备用字段\n     */\n    private String backupField;\n}","stream":true,"source":"E2EBotConversation","acceptable":true,"action":"edit","openFileDiff":false,"conversationId":"20fec48e-734a-4cda-b6a7-4b56823ff21d","elementId":"6960eb3e52ad0b146922c53c","inlineView":true,"uuid":"8af1ba23-5265-44fe-ad01-a65c14d0d5d1"}}
