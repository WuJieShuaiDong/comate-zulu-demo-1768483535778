[72327] [2026-01-08 21:16:59] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"a1e098aa-7c85-42fd-94c5-0fccddee7846","existed":true,"absolutePath":"/Users/xiaoliu/baidu/bpit-proc-apps/pmc/pmc-basic-bankcommon/src/main/java/com/baidu/pmc/bankcommon/core/service/impl/JobExecuteServiceImpl.java","content":"package com.baidu.pmc.bankcommon.core.service.impl;\n\nimport com.baidu.microschedule.client.annotation.MicroScheduleExecutor;\nimport com.baidu.microschedule.client.context.MicroScheduleContext;\nimport com.baidu.microschedule.client.logger.Logger;\nimport com.baidu.pmc.bankcommon.core.service.BankStrategyClient;\nimport com.baidu.pmc.bankcommon.core.service.JobExecuteService;\nimport com.baidu.pmc.bankcommon.core.service.PmcPayCommonBankColSetService;\nimport com.baidu.pmc.pojo.model.cmb.PayQO;\nimport com.baidu.pmc.pojo.model.fnd.FndFlexValue;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections.CollectionUtils;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\n\nimport java.util.ArrayList;\nimport java.util.List;\nimport java.util.stream.Collectors;\n\n@Slf4j\n@Service\npublic class JobExecuteServiceImpl implements JobExecuteService {\n    private static final String BANK_COMMON_PILOT_LIST_FLEX = \"BANK_COMMON_PILOT_BANK\";\n    @Autowired\n    private OperateByJDBC operateByJDBC;\n\n    @Autowired\n    private BankStrategyClient bankStrategyClient;\n\n    @Autowired\n    private PmcPayCommonBankColSetService pmcPayCommonBankColSetService;\n\n    /**\n     * 执行生成未紧急支付的指令\n     */\n    @Override\n    @MicroScheduleExecutor(code = \"genBankcommonUnUrgentPayTask\")\n    public void genBankcommonUnUrgentPayTask() {\n        Logger logger = MicroScheduleContext.currentTaskContext().getLogger();\n        logger.info(\"*****银行指令生成任务开始*******\");\n        List<String> bankList = pmcPayCommonBankColSetService.getTransferBankCodeList();\n        List<String> transferPilotBankCodeList = getTransferPilotBankCodeList();\n        bankList = bankList.stream()\n                .filter(bank -> !transferPilotBankCodeList.contains(bank))\n                .collect(Collectors.toList());\n        bankList.forEach(bankCode -> {\n            logger.info(\"开始生成银行：\" + bankCode + \" 的指令数据\");\n            int urgentPay = bankStrategyClient.genBankUnUrgentPay(bankCode);\n            logger.info(\"指令生成成功：\" + urgentPay + \" 条指令数据\");\n        });\n\n        logger.info(\"*****银行指令生成任务结束*******\");\n    }\n\n    /**\n     * 对公付款后台任务JOB\n     */\n    @Override\n    @MicroScheduleExecutor(code = \"bankcommonUnUrgentPayTask\")\n    public void bankcommonUnUrgentPayTask() {\n        Logger logger = MicroScheduleContext.currentTaskContext().getLogger();\n        logger.info(\"*****银行对公付款任务开始*******\");\n        List<String> bankList = pmcPayCommonBankColSetService.getTransferBankCodeList();\n        List<String> transferPilotBankCodeList = getTransferPilotBankCodeList();\n        bankList = bankList.stream()\n                .filter(bank -> !transferPilotBankCodeList.contains(bank))\n                .collect(Collectors.toList());\n        bankList.forEach(bankCode -> {\n            logger.info(\"开始对银行：\" + bankCode + \" 进行对公付款\");\n            int urgentPay = bankStrategyClient.bankDirectBankPay(bankCode);\n            logger.info(\"对公支付成功：\" + urgentPay + \" 条指令数据\");\n        });\n        logger.info(\"*****银行对公付款任务结束*******\");\n    }\n\n    /**\n     * 调用银行接口，进行对支付结果的查询\n     */\n    @Override\n    @MicroScheduleExecutor(code = \"bankcommonQueryPayResultTask\")\n    public void bankcommonQueryPayResultTask() {\n        Logger logger = MicroScheduleContext.currentTaskContext().getLogger();\n        logger.info(\"*****银行对支付结果查询任务开始*******\");\n        List<String> bankList = pmcPayCommonBankColSetService.getTransferBankCodeList();\n        List<String> transferPilotBankCodeList = getTransferPilotBankCodeList();\n        bankList = bankList.stream()\n                .filter(bank -> !transferPilotBankCodeList.contains(bank))\n                .collect(Collectors.toList());\n        bankList.forEach(bankCode -> {\n            logger.info(\"开始对银行：\" + bankCode + \" 进行支付结果查询\");\n            String result = bankStrategyClient.bankQueryPayResultJob(bankCode);\n            logger.info(\"查询付款结果：\" + result);\n        });\n        logger.info(\"*****银行支付结果查询任务结束*******\");\n    }\n\n    /**\n     * 执行电子回单查询任务\n     */\n    @Override\n    @MicroScheduleExecutor(code = \"selectBankcommonElectReceiptTask\")\n    public void selectBankcommonElectReceiptTask() {\n        Logger logger = MicroScheduleContext.currentTaskContext().getLogger();\n        logger.info(\"***** 电子回单任务开始 *******\");\n        List<String> bankList = pmcPayCommonBankColSetService.getTransferBankCodeList();\n        List<String> transferPilotBankCodeList = getTransferPilotBankCodeList();\n        bankList = bankList.stream()\n                .filter(bank -> !transferPilotBankCodeList.contains(bank))\n                .collect(Collectors.toList());\n        bankList.forEach(bankCode -> {\n            logger.info(\"开始对银行：\" + bankCode + \" 电子回单查询\");\n            PayQO payQO = new PayQO();\n            payQO.setBank(bankCode);\n            String message = bankStrategyClient.selectElectReceipt(payQO);\n            logger.info(\"电子回单任务结果：\" + message);\n        });\n        logger.info(\"*****电子回单任务结束*******\");\n    }\n\n    /**\n     * 执行退票查询任务\n     */\n    @Override\n    @MicroScheduleExecutor(code = \"selectBankcommonRefundTask\")\n    public void selectBankcommonRefundTask() {\n        Logger logger = MicroScheduleContext.currentTaskContext().getLogger();\n        logger.info(\"***** 退票任务开始 *******\");\n        List<String> bankList = pmcPayCommonBankColSetService.getTransferBankCodeList();\n        List<String> transferPilotBankCodeList = getTransferPilotBankCodeList();\n        bankList = bankList.stream()\n                .filter(bank -> !transferPilotBankCodeList.contains(bank))\n                .collect(Collectors.toList());\n        bankList.forEach(bankCode -> {\n            logger.info(\"开始对银行：\" + bankCode + \" 退票查询\");\n            PayQO payQO = new PayQO();\n            payQO.setBank(bankCode);\n            String message = bankStrategyClient.selectBankcommonRefund(payQO);\n            logger.info(\"退票任务结果：\" + message);\n        });\n        logger.info(\"*****退票任务结束*******\");\n    }\n\n    private List<String> getTransferPilotBankCodeList() {\n        List<String> result = new ArrayList<>();\n        List<FndFlexValue> fndFlexValues = operateByJDBC.selectByConNoRedis(BANK_COMMON_PILOT_LIST_FLEX);\n        if (CollectionUtils.isEmpty(fndFlexValues)) {\n            log.error(\"getTransferPilotBankCodeList is null\");\n            return result;\n        }\n        result = fndFlexValues\n                .stream().map(FndFlexValue::getFlexValue).collect(Collectors.toList());\n        return result;\n    }\n\n}\n","scheme":"file","completed":false,"isEnd":false,"failed":false}
