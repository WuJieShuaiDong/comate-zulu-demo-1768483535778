[14217] [2026-01-21 12:03:35] [INFO] [ENGINE]  <--------- ENGINE SEND: VIRTUAL_EDITOR_EVENT {"action":"openVirtualDiffDocument","payload":{"absolutePath":"/Users/xiaoliu/baidu/bpit-proc-apps/pmc/FindCorrectEncoding.java","content":"","modified":"import java.io.UnsupportedEncodingException;\nimport java.nio.charset.StandardCharsets;\n\npublic class FindCorrectEncoding {\n    \n    public static void main(String[] args) {\n        try {\n            String originalFilename = \"付款明细_20260121115443\";\n            \n            System.out.println(\"=== 寻找正确的文件名编码方案 ===\");\n            System.out.println(\"原始文件名: \" + originalFilename);\n            System.out.println();\n            \n            // 测试各种编码组合\n            String[][] encodingTests = {\n                {\"UTF-8 -> ISO-8859-1\", \"UTF-8\", StandardCharsets.ISO_8859_1},\n                {\"默认编码 -> ISO-8859-1\", \"\", StandardCharsets.ISO_8859_1},\n                {\"GBK -> ISO-8859-1\", \"GBK\", StandardCharsets.ISO_8859_1},\n                {\"GB2312 -> ISO-8859-1\", \"GB2312\", StandardCharsets.ISO_8859_1},\n                {\"直接系统编码\", \"\", null},\n            };\n            \n            for (String[] test : encodingTests) {\n                String description = test[0];\n                String sourceCharset = test[1];\n                \n                String encoded;\n                if (test[2] == null) {\n                    // 不使用编码转换\n                    encoded = originalFilename;\n                } else if (sourceCharset.isEmpty()) {\n                    // 使用默认编码\n                    encoded = new String(originalFilename.getBytes(), test[2]);\n                } else {\n                    // 指定源编码\n                    encoded = new String(originalFilename.getBytes(sourceCharset), test[2]);\n                }\n                \n                System.out.println(description + \":\");\n                System.out.println(\"  编码结果: \" + encoded);\n                \n                // 检查是否包含乱码字符\n                boolean hasGarbled = encoded.contains(\"ä\") || encoded.contains(\"¸\") || encoded.contains(\"¶\");\n                System.out.println(\"  乱码检测: \" + (hasGarbled ? \"❌ 有乱码\" : \"✓ 无乱码\"));\n                \n                // 模拟浏览器解码\n                String browserDecoded;\n                try {\n                    if (test[2] != null) {\n                        browserDecoded = new String(encoded.getBytes(test[2]), sourceCharset.isEmpty() ? \"UTF-8\" : sourceCharset);\n                    } else {\n                        browserDecoded = encoded;\n                    }\n                    System.out.println(\"  浏览器显示: \" + browserDecoded);\n                } catch (Exception e) {\n                    System.out.println(\"  浏览器显示: 解码失败\");\n                }\n                System.out.println();\n            }\n            \n            // 特别注意含有引号的方案（参考ReceiptServiceImpl）\n            System.out.println(\"=== 带引号的方案验证 ===\");\n            String filenameWithQuotes = new String(\"付款明细\".getBytes(\"UTF-8\"), StandardCharsets.ISO_8859_1) + \n                                        \"_20260121115443.csv\";\n            System.out.println(\"带引号的编码: \" + filenameWithQuotes);\n            \n            String dispositionWithQuotes = \"attachment; filename=\\\"\" + filenameWithQuotes + \"\\\"\";\n            System.out.println(\"完整的Content-Disposition: \" + dispositionWithQuotes);\n            \n        } catch (Exception e) {\n            e.printStackTrace();\n        }\n    }\n}","stream":true,"source":"E2EBotConversation","acceptable":true,"action":"edit","openFileDiff":true,"conversationId":"097eafbf-0204-4fad-9d33-e179d760b89b","elementId":"780161ea-439f-47ee-9bcb-ed96e918b25c","inlineView":true,"uuid":"5dba7b19-7bee-4dd3-8104-9a5d553cf2b1"}}
