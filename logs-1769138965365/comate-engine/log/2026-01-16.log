 // 组合4: UTF-8 -> UTF-8（应该正确）\n            String combo4 = new String(original.getBytes(\"UTF-8\"), \"UTF-8\");\n            System.out.println(\"UTF-8 -> UTF-8: \" + combo4);\n\n            // 尝试URL编码方式\n            System.out.println(\"\\n=== URL编码方式 ===\");\n            String urlEncoded = java.net.URLEncoder.encode(original, \"UTF-8\");\n            System.out.println(\"URL编码: \" + urlEncoded);\n\n        } catch (Exception e) {\n            e.printStackTrace();\n        }\n    }\n}","completed":false,"isEnd":false,"failed":false}
