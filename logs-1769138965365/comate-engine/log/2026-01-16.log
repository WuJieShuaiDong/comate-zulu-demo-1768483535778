[14217] [2026-01-20 10:51:10] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"8bc9a709-78b8-4903-b91c-711f97caff1c","existed":true,"absolutePath":"/Users/xiaoliu/baidu/bpit-proc-apps/pmc/pmc-basic-service/src/main/java/com/baidu/pmc/core/service/p2p/P2pService.java","content":"package com.baidu.pmc.core.service.p2p;\n\nimport com.baidu.pmc.pojo.dto.p2p.P2pFetchRequest;\nimport com.baidu.pmc.pojo.dto.p2p.PayCheckSupplierQo;\nimport com.github.pagehelper.PageInfo;\n\npublic interface P2pService {\n\n    /**\n     * 同步p2p供应商数据\n     *\n     * @param request\n     */\n    void syncP2pSupplierData(P2pFetchRequest request);\n\n    /**\n     * 拉取付款到上共享传过来的供应商编号\n     *\n     * @param qo\n     * @return\n     */\n    PageInfo<String> getPayCheckSupplierCodes(PayCheckSupplierQo qo);\n\n    /**\n     * 查询 pmc_finance_supplier_quota_set 里的供应商code\n     *\n     * @param qo\n     * @return\n     */\n    PageInfo<String> getFinanceQuotaSupplierCode(PayCheckSupplierQo qo);\n}\n","scheme":"file","completed":false,"isEnd":false,"failed":false,"selections":[{"start":{"column":17,"line":6},"end":{"column":27,"line":6}}]}
