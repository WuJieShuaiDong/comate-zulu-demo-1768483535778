[14217] [2026-01-20 10:50:35] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"f4f7a4e9-5a17-4cfb-8446-cad536876aaf","existed":true,"content":"package com.baidu.pmc.pojo.dto.p2p;\n\nimport lombok.AllArgsConstructor;\nimport lombok.Data;\nimport lombok.NoArgsConstructor;\n\nimport java.util.Set;\n\n@Data\n@NoArgsConstructor\n@AllArgsConstructor\npublic class P2pFetchRequest {\n    private Set<String> supName;    // 供应商名称\n    private Set<String> supId;      // 供应商编码\n}\n","completed":false,"isEnd":false,"failed":false}
