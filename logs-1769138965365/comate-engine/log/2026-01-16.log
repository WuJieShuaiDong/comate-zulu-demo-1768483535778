 {\n        return ResponseMessage.success(client.failedBalanceList(qo));\n    }\n\n    /**\n     * 余额不足再次发送银行\n     *\n     * @param ids\n     *\n     * @return\n     */\n    @PostMapping(\"/send_again\")\n    @ResponseBody\n    public ResponseMessage sendBankAgain(@RequestBody @Validated PayCheckIdsDTO ids, BindingResult result) {\n        if (result.hasErrors()) {\n            return ResponseMessage.fail(result.getAllErrors().toString());\n        }\n        return client.sendBankAgain(ids);\n    }\n\n    /**\n     * 余额不足付款失败列表中下拉列表初始化\n     *\n     * @return\n     */\n    @PostMapping(\"/select_init\")\n    @ResponseBody\n    public ResponseMessage failedBalanceSelectInit() {\n        return ResponseMessage.success(client.failedBalanceSelectInit());\n    }\n}\n","modified":"/*\n * Copyright (C) 2018 Baidu, Inc. All Rights Reserved.\n */\npackage com.baidu.pmc.web.controller;\n\nimport java.util.ArrayList;\nimport java.util.List;\n\nimport javax.servlet.http.HttpServletRequest;\nimport javax.servlet.http.HttpServletResponse;\n\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Controller;\nimport org.springframework.validation.BindingResult;\nimport org.springframework.validation.annotation.Validated;\nimport org.springframework.web.bind.annotation.PostMapping;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.ResponseBody;\n\nimport com.baidu.pmc.common.ResponseMessage;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.pojo.dto.PayCheckIdsDTO;\nimport com.baidu.pmc.pojo.dto.PayChecksDTO;\nimport com.baidu.pmc.pojo.qo.PayChecksQO;\nimport com.baidu.pmc.web.clients.PayFailedBalanceClient;\nimport com.baidu.pmc.web.configuration.export.ExportRepeatCheckLock;\nimport com.baidu.pmc.web.service.ExportExcelUtil;\nimport com.baidu.pmc.web.service.ResponseStream;\n\nimport lombok.extern.slf4j.Slf4j;\n\n/**\n * 余额不足导致付款失败的控制器\n */\n@Slf4j\n@RequestMapping(\"/pay_failed_balance\")\n@Controller\npublic class PayFailedBalanceController {\n\n    @Autowired\n    private PayFailedBalanceClient client;\n\n    @Autowired\n    private ExportExcelUtil exportExcelUtil;\n\n    /**\n     * 余额不足付款失败列表\n     *\n     * @param qo\n     *\n     * @return\n     */\n    @PostMapping(\"/list\")\n    @ResponseBody\n    public ResponseMessage failedBalanceList(@RequestBody PayChecksQO qo) {\n        return ResponseMessage.success(client.failedBalanceList(qo));\n    }\n\n    /**\n     * 余额不足再次发送银行\n     *\n     * @param ids\n     *\n     * @return\n     */\n    @PostMapping(\"/send_again\")\n    @ResponseBody\n    public ResponseMessage sendBankAgain(@RequestBody @Validated PayCheckIdsDTO ids, BindingResult result) {\n        if (result.hasErrors()) {\n            return ResponseMessage.fail(result.getAllErrors().toString());\n        }\n        return client.sendBankAgain(ids);\n    }\n\n    /**\n     * 余额不足付款失败列表中下拉列表初始化\n     *\n     * @return\n     */\n    @PostMapping(\"/select_init\")\n    @ResponseBody\n    public ResponseMessage failedBalanceSelectInit() {\n        return ResponseMessage.success(client.failedBalanceSelectInit());\n    }\n\n    /**\n     * 余额不足付款失败列表导出Excel\n     *\n     * @param qo 查询条件\n     * @param request HttpServletRequest\n     * @param response HttpServletResponse\n     * @return ResponseMessage\n     */\n    @PostMapping(\"/exportExcel\")\n    @ResponseBody\n    @ExportRepeatCheckLock\n    public ResponseMessage exportExcel(@RequestBody PayChecksQO qo, HttpServletRequest request,\n                                       HttpServletResponse response) {\n        try {\n            // 调用后端接口获取数据\n            List<PayChecksDTO> details = client.exportExcel(qo);\n            \n            // 检查数据量，超过20000条时返回提示信息\n            if (details != null && details.size() > 20000) {\n                return ResponseMessage.success(\"导出数据量超过20000条，已限制导出前20000条，请分批导出\");\n            }\n            \n            if (details == null || details.isEmpty()) {\n                return ResponseMessage.success(\"没有符合条件的数据\");\n            }\n\n            // 准备Excel数据\n            List<List<List<List<String>>>> detailsList = new ArrayList<>();\n            List<List<List<String>>> detailsNew = new ArrayList<>();\n            List<List<String>> resultIn = new ArrayList<>();\n            int index = 1;\n            for (PayChecksDTO data : details) {\n                List<String> values = new ArrayList<>();\n                // 序号\n                values.add(String.valueOf(index++));\n                // 付款银行\n                values.add(data.getBankCodeName());\n                // 付款主体\n                values.add(data.getCompanyCodeName());\n                // 账户币种\n                values.add(data.getCurrencyName());\n                // 付款账号\n                values.add(data.getAccount());\n                // 计划付款日期\n                values.add(DateUtils.formatDate(data.getPayPlanDate()));\n                // 付款单编号\n                values.add(data.getPayCheckNum());\n                // 申请付款币种\n                values.add(data.getAmountCurrencyName());\n                // 金额\n                values.add(data.getAmount() == null ? \"\" : data.getAmount().toString());\n                // 收款人\n                values.add(data.getAttribute1() != null ? data.getAttribute1() : \"\");\n                // 收款银行\n                values.add(data.getAttribute2() != null ? data.getAttribute2() : \"\");\n                // 收款人银行账户\n                values.add(data.getAttribute3() != null ? data.getAttribute3() : \"\");\n                // 用途\n                values.add(data.getRemark());\n                // 摘要\n                values.add(data.getNaryur());\n                // 业务参考号\n                values.add(data.getReferenceNumber() != null ? data.getReferenceNumber() : \"\");\n                // 单据状态\n                values.add(data.getStatusName());\n                // 银行反馈信息\n                values.add(data.getFailureReasons() != null ? data.getFailureReasons() : \"\");\n                \n                resultIn.add(values);\n            }\n            detailsNew.add(resultIn);\n            detailsList.add(detailsNew);\n            \n            String[] sheetName = {\"余额不足付款列表\"};\n            String[] headerIn = {\"序号\", \"付款银行\", \"付款主体\", \"账户币种\", \"付款账号\", \"计划付款日期\", \"付款单编号\", \n                                \"申请付款币种\", \"金额\", \"收款人\", \"收款银行\", \"收款人银行账户\", \"用途\", \"摘要\", \n                                \"业务参考号\", \"单据状态\", \"银行反馈信息\"};\n            List<String[]> headers = new ArrayList<>();\n            headers.add(headerIn);\n            \n            // 设置响应头并导出Excel\n            ResponseStream.setHeader(\"余额不足付款列表\".concat(DateUtils.getDate(\"yyyyMMddHHmmss\")).concat(\".xlsx\"),\n                    ResponseStream.ContentType.EXCEL, request, response);\n            exportExcelUtil.exportMoreDifferentSheetExcel(sheetName, headers, detailsList, response);\n            \n            return ResponseMessage.success(\"导出成功\");\n            \n        } catch (Exception e) {\n            log.error(\"余额不足付款列表导出异常\", e);\n            return ResponseMessage.fail(\"导出异常：\" + e.getMessage());\n        }\n    }\n}\n","stream":true,"source":"E2EBotConversation","acceptable":true,"action":"edit","openFileDiff":true,"conversationId":"097eafbf-0204-4fad-9d33-e179d760b89b","elementId":"3401bda4-4145-43f5-b96c-0c81d8890bdb","inlineView":true,"uuid":"c969bb89-9482-452f-ba6a-5709c0191e25"}}
