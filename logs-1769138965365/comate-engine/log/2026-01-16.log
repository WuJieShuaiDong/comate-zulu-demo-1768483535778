[54646] [2026-01-16 17:31:50] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"9807b582-248e-403f-a362-54dc37fa89e4","existed":true,"scheme":"file","isDirty":false,"absolutePath":"/Users/xiaoliu/ComateProjects/comate-zulu-demo-1768483535778/quant_trading/app.py","content":"import streamlit as st\nimport pandas as pd\nimport akshare as ak\nimport plotly.graph_objects as go\nfrom plotly.subplots import make_subplots\nimport datetime\n\n# --- 页面配置 ---\nst.set_page_config(page_title=\"沪深A股量化回测系统\", layout=\"wide\", page_icon=\"📈\")\n\nst.title(\"📈 沪深A股量化回测系统 (双均线策略 Demo)\")\n\n# --- 侧边栏配置 ---\nst.sidebar.header(\"⚙️ 策略参数设置\")\n\n# 默认参数\ndefault_start_date = datetime.date(2023, 1, 1)\ndefault_end_date = datetime.date.today()\n\nsymbol = st.sidebar.text_input(\"股票代码 (6位数字)\", value=\"600519\", help=\"例如：600519 (贵州茅台), 000001 (平安银行)\")\nstart_date = st.sidebar.date_input(\"开始日期\", value=default_start_date)\nend_date = st.sidebar.date_input(\"结束日期\", value=default_end_date)\n\nst.sidebar.subheader(\"均线参数\")\nshort_window = st.sidebar.number_input(\"短期均线 (Short Window)\", min_value=1, value=5)\nlong_window = st.sidebar.number_input(\"长期均线 (Long Window)\", min_value=2, value=20)\n\nst.sidebar.subheader(\"交易设置\")\ninitial_capital = st.sidebar.number_input(\"初始资金 (元)\", value=100000.0)\ncommission_rate = st.sidebar.number_input(\"交易费率 (双边)\", value=0.0003, format=\"%.4f\")\n\n# --- 数据获取函数 ---\n@st.cache_data(ttl=3600)  # 缓存数据1小时\ndef get_stock_data(symbol, start_date, end_date):\n    \"\"\"\n    使用 AkShare 获取 A 股历史行情数据 (前复权)\n    \"\"\"\n    start_str = start_date.strftime(\"%Y%m%d\")\n    end_str = end_date.strftime(\"%Y%m%d\")\n    \n    try:\n        # 获取日线数据，前复权\n        df = ak.stock_zh_a_hist(symbol=symbol, period=\"daily\", start_date=start_str, end_date=end_str, adjust=\"qfq\")\n        if df.empty:\n            return None\n        \n        # 重命名列以方便处理\n        df.rename(columns={\n            \"日期\": \"date\", \"开盘\": \"open\", \"收盘\": \"close\", \n            \"最高\": \"high\", \"最低\": \"low\", \"成交量\": \"volume\"\n        }, inplace=True)\n        \n        df['date'] = pd.to_datetime(df['date'])\n        df.set_index('date', inplace=True)\n        return df\n    except Exception as e:\n        st.error(f\"数据获取失败: {e}\")\n        return None\n\n# --- 回测逻辑 ---\ndef backtest(df, short_window, long_window, initial_capital, commission_rate):\n    data = df.copy()\n    \n    # 1. 计算均线\n    data['short_mavg'] = data['close'].rolling(window=short_window).mean()\n    data['long_mavg'] = data['close'].rolling(window=long_window).mean()\n    \n    # 2. 生成信号\n    # 信号: 1 (买入), 0 (持有/空仓), -1 (卖出)\n    # 逻辑: 短线上穿长线 -> 买入 (信号从0变1)\n    data['signal'] = 0.0\n    # 仅在两个均线都有值之后开始计算\n    data.iloc[long_window:, data.columns.get_loc('signal')] = \\\n        (data['short_mavg'][long_window:] > data['long_mavg'][long_window:]).astype(float)\n    \n    # 交易指令: diff为1表示金叉买入，-1表示死叉卖出\n    data['positions'] = data['signal'].diff()\n    \n    # 3. 模拟账户资金变动\n    # 简化假设：全仓买入，全仓卖出\n    # 实际持仓 (Holdings): 股票市值\n    # 现金 (Cash): 手头现金\n    # 总资产 (Total): 现金 + 持仓\n    \n    cash = initial_capital\n    holdings = 0\n    position_status = 0 # 0: 空仓, 1: 持仓\n    \n    portfolio = pd.DataFrame(index=data.index)\n    portfolio['holdings'] = 0.0\n    portfolio['cash'] = initial_capital\n    portfolio['total'] = initial_capital\n    portfolio['returns'] = 0.0\n    \n    buy_signals = []\n    sell_signals = []\n    \n    for i in range(len(data)):\n        date = data.index[i]\n        price = data['close'].iloc[i]\n        signal = data['positions'].iloc[i]\n        \n        # 继承上一个时刻的状态\n        if i > 0:\n            cash = portfolio['cash'].iloc[i-1]\n            holdings = portfolio['holdings'].iloc[i-1]\n            \n        # 执行交易\n        if signal == 1.0 and position_status == 0: # 买入信号\n            # 全仓买入 (扣除预估手续费)\n            shares = int(cash / (price * (1 + commission_rate))) \n            if shares > 0:\n                cost = shares * price * (1 + commission_rate)\n                cash -= cost\n                holdings += shares * price # 市值\n                position_status = 1\n                buy_signals.append((date, price))\n                \n        elif signal == -1.0 and position_status == 1: # 卖出信号\n            # 全仓卖出\n            shares = int(holdings / price) # 近似估算份额，实际上holdings存的是市值，这里需要修正逻辑\n            # 为了简化，我们追踪份额会更准确，但这里简单模拟：\n            # 实际上我们应该在portfolio里记录 share_count，这里做个简化的市值法\n            # 让我们用更严谨的方式：记录 cash 和 share_count\n            pass \n    \n    # --- 重新向量化计算 (为了速度和准确性) ---\n    # 简单的向量化回测：计算日收益率\n    data['market_returns'] = data['close'].pct_change()\n    data['strategy_returns'] = data['market_returns'] * data['signal'].shift(1) # 今天的收益由昨天的持仓决定\n    \n    # 扣除手续费 (在交易发生的当天扣除)\n    # 交易发生点：data['positions'] != 0\n    # 估算手续费损失：每次交易扣除 资金 * rate\n    # 这里为了演示方便，使用累积收益率曲线\n    \n    # 归一化净值曲线 (从1开始)\n    data['strategy_cum_returns'] = (1 + data['strategy_returns']).cumprod()\n    data['benchmark_cum_returns'] = (1 + data['market_returns']).cumprod()\n    \n    return data\n\n# --- 主程序逻辑 ---\nif st.sidebar.button(\"开始回测\"):\n    with st.spinner(\"正在获取数据并进行计算...\"):\n        df = get_stock_data(symbol, start_date, end_date)\n        \n        if df is not None and len(df) > long_window:\n            # 执行回测\n            result = backtest(df, short_window, long_window, initial_capital, commission_rate)\n            \n            # --- 1. 核心指标展示 ---\n            col1, col2, col3, col4 = st.columns(4)\n            \n            total_return = (result['strategy_cum_returns'].iloc[-1] - 1) * 100\n            benchmark_return = (result['benchmark_cum_returns'].iloc[-1] - 1) * 100\n            annual_return = ((result['strategy_cum_returns'].iloc[-1]) ** (252 / len(result)) - 1) * 100\n            \n            # 最大回撤\n            cum_returns = result['strategy_cum_returns']\n            running_max = cum_returns.cummax()\n            drawdown = (cum_returns - running_max) / running_max\n            max_drawdown = drawdown.min() * 100\n            \n            col1.metric(\"策略总收益\", f\"{total_return:.2f}%\")\n            col2.metric(\"基准收益 (买入持有)\", f\"{benchmark_return:.2f}%\")\n            col3.metric(\"策略年化收益\", f\"{annual_return:.2f}%\")\n            col4.metric(\"最大回撤\", f\"{max_drawdown:.2f}%\")\n            \n            # --- 2. 资金曲线可视化 ---\n            st.subheader(\"💰 策略表现 vs 基准\")\n            fig_perf = go.Figure()\n            fig_perf.add_trace(go.Scatter(x=result.index, y=result['strategy_cum_returns'], mode='lines', name='策略净值'))\n            fig_perf.add_trace(go.Scatter(x=result.index, y=result['benchmark_cum_returns'], mode='lines', name='基准净值 (Benchmark)', line=dict(dash='dash')))\n            fig_perf.update_layout(xaxis_title=\"日期\", yaxis_title=\"净值 (初始=1)\", hovermode=\"x unified\")\n            st.plotly_chart(fig_perf, use_container_width=True)\n            \n            # --- 3. K线图与交易信号 ---\n            st.subheader(\"🕯️ K线与交易信号\")\n            \n            # 筛选最近的数据展示，避免图表过于密集，如果数据量大\n            plot_data = result # .tail(200) 可以选择只看最近一年\n            \n            fig_candle = make_subplots(rows=2, cols=1, shared_xaxes=True, vertical_spacing=0.03, row_heights=[0.7, 0.3])\n            \n            # K线\n            fig_candle.add_trace(go.Candlestick(\n                x=plot_data.index,\n                open=plot_data['open'], high=plot_data['high'],\n                low=plot_data['low'], close=plot_data['close'],\n                name='K线'\n            ), row=1, col=1)\n            \n            # 均线\n            fig_candle.add_trace(go.Scatter(x=plot_data.index, y=plot_data['short_mavg'], line=dict(color='orange', width=1), name=f'{short_window}日均线'), row=1, col=1)\n            fig_candle.add_trace(go.Scatter(x=plot_data.index, y=plot_data['long_mavg'], line=dict(color='blue', width=1), name=f'{long_window}日均线'), row=1, col=1)\n            \n            # 买卖信号标注\n            buy_signals = plot_data[plot_data['positions'] == 1]\n            sell_signals = plot_data[plot_data['positions'] == -1]\n            \n            fig_candle.add_trace(go.Scatter(\n                x=buy_signals.index, y=buy_signals['low']*0.98,\n                mode='markers', marker=dict(symbol='triangle-up', size=10, color='red'),\n                name='买入信号'\n            ), row=1, col=1)\n            \n            fig_candle.add_trace(go.Scatter(\n                x=sell_signals.index, y=sell_signals['high']*1.02,\n                mode='markers', marker=dict(symbol='triangle-down', size=10, color='green'),\n                name='卖出信号'\n            ), row=1, col=1)\n            \n            # 成交量\n            fig_candle.add_trace(go.Bar(x=plot_data.index, y=plot_data['volume'], name='成交量', marker_color='gray'), row=2, col=1)\n            \n            fig_candle.update_layout(xaxis_rangeslider_visible=False, height=600, hovermode=\"x unified\")\n            st.plotly_chart(fig_candle, use_container_width=True)\n            \n            # --- 4. 数据详情 ---\n            with st.expander(\"查看详细回测数据\"):\n                st.dataframe(result[['open', 'close', 'short_mavg', 'long_mavg', 'signal', 'strategy_cum_returns']].style.format(\"{:.2f}\"))\n                \n        elif df is None:\n            st.warning(\"未获取到数据，请检查股票代码是否正确 (如 600519)。\")\n        else:\n            st.warning(f\"数据量不足，无法计算 {long_window} 日均线，请拉长回测时间范围。\")\n\nelse:\n    st.info(\"👈 请在左侧设置参数并点击【开始回测】\")\n    st.markdown(\"\"\"\n    ### 快速入门指南\n    1. **股票代码**: 输入6位数字代码，如 `000001` (平安银行), `601318` (中国平安), `300750` (宁德时代)。\n    2. **策略原理 (双均线)**:\n       - **买入**: 当短期均线从下向上穿过长期均线 (金叉)。\n       - **卖出**: 当短期均线从上向下穿过长期均线 (死叉)。\n       - *注*: 这是一个趋势跟踪策略，在震荡市中可能会频繁磨损本金。\n    3. **数据来源**: 实时从 AkShare (东方财富源) 获取，完全免费。\n    \"\"\")","selections":[{"start":{"line":0,"column":0},"end":{"line":0,"column":0}}]}
