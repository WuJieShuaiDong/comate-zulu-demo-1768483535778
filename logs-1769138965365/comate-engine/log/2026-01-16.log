   /**\n    * 融资申请修改或者保存\n    * */\n    PmcFinanceBankBaseQO saveOrUpdateFinancingApply(PmcFinanceSupplierApplyDTO pmcFinanceSupplierApplyDto);\n\n    /**\n     * 查询融资申请历史记录\n     * @param query 查询条件\n     * @return 分页历史记录列表\n     */\n    PageInfo<PmcFinanceSupplierApplyHisDTO> queryFinancingApplyHis(PmcFinanceSupplierApplyQO query);\n\n    /**\n    * 查询付款单信息\n    * */\n    PmcPayChecksSupplierCodeDTO selectPmcPayCheckByPayCheckNum(PayChecksQO payChecksQO, PmcFinanceSupplierApply apply);\n\n    /**\n    * 公司主体额度查询\n    * */\n    PageInfo<PmcFinanceCompQuotaSetDTO> selectQuotaSet(PmcFinanceCompQuotaSetQO query);\n\n    /**\n    * 导出公司主体额度\n    * */\n    List<PmcFinanceCompQuotaSetDTO> exportQuotaSet(PmcFinanceCompQuotaSetQO query);\n\n    /**\n    * 保存或者更新公司额度\n    * */\n    Long saveOrUpdateCompQuotaSet(PmcFinanceCompQuotaSetDTO dto);\n\n    /**\n    *查询供应商额度\n    * */\n    PageInfo<PmcFinanceSupplierQuotaSetDTO> selectSupplierQuotaSet(PmcFinanceSupplierQuotaSetQO query);\n\n    /**\n     * 查询供应链融资额度使用情况\n     * @param qo 查询参数\n     * @return 额度使用情况列表\n     */\n    PageInfo<SupplierFinancingUsageDTO> queryFinancingUsage(SupplierFinancingUsageQO qo);\n\n    /**\n    * 导出供应商额度\n    * */\n    List<PmcFinanceSupplierQuotaSetDTO> exportSupplierQuotaSet(PmcFinanceSupplierQuotaSetQO query);\n\n    /**\n    * 保存供应商额度\n    * */\n    Long saveOrUpdateSupplierQuotaSet(PmcFinanceSupplierQuotaSetDTO dto);\n\n    /**\n    * 导出申请融资单\n    * */\n    List<PmcFinanceSupplierApplyDTO> export(PmcFinanceSupplierApplyQO pmcFinanceSupplierApplyQO);\n\n    /**\n     * 导出申请融资单\n     * */\n    List<PmcFinanceSupplierApplyDTO> admExport(PmcFinanceSupplierApplyQO pmcFinanceSupplierApplyQO);\n\n    /**\n    * 初始化\n    * */\n    Map<String, Object> getSelectInit();\n\n\n    /**\n     * 初始化\n     * */\n    Map<String, Object> getSelectPortalInit();\n\n    /*\n    * 供应商suggest\n    * */\n    List<PmcDataP2pSupplier> selectSuggest(PmcPortalSuggestQO parameter);\n\n    /**\n     * 计算供应商可用额度（取供应商额度和主体额度的较小值，减去已提交融资的占用额度）\n     * @return 可用额度\n     */\n    BigDecimal calculateAvailableQuota(PmcPortalRemainQuotaQO qo);\n\n    /**\n     * 通用数据校验方法\n     * @param query 查询参数\n     * @param methodName 方法名\n     * @return 校验结果\n     */\n    String commonCheckData(PmcFinanceBankBaseQO query, String methodName);\n\n    /**\n     * 生成融资申请单号\n     * @return 融资申请单号，格式：FA+日期时间+4位流水，例如：FA202506111200000001\n     */\n    PmcFinanceApplyNumberDTO generateFinancingApplicationNo();\n\n    /**\n     * 查询融资指标数据\n     * @return 融资指标DTO\n     */\n    FinanceIndicatorDTO queryFinanceIndicators();\n\n    /**\n     * 回滚融资申请状态\n     * @param request 包含申请单号和银行申请号的请求对象\n     * @return 操作结果\n     */\n    boolean updateApplyStatusOrSendMeg(PmcFinanceBankBaseQO request);\n\n    /**\n     * 管理员拒绝发送中的融资\n     * @param query 融资申请信息\n     * @return 操作结果\n     */\n    boolean admRejectSendBank(PmcFinanceSupplierApplyDTO query);\n\n    /**\n    * 管理员补推银行\n    * */\n    PmcFinanceBankBaseQO adminSubmitFinancingApply(PmcFinanceBankBaseQO query);\n\n\n    /**\n     *查询供应商权限\n     * */\n    boolean selectFinanceRole();\n\n    /**\n     * 同步P2P供应商数据\n     * @param request 供应商同步请求\n     * @throws Exception 同步异常\n     */\n    void syncP2pSupplierData(SyncP2pSupplierRequest request);\n}","completed":false,"isEnd":false,"failed":false}
