[14217] [2026-01-19 17:02:38] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"44574842-ab1a-4132-9f56-7d535a4c440e","existed":true,"absolutePath":"/Users/xiaoliu/baidu/bpit-proc-apps/pmc/pmc-basic-service/src/main/java/com/baidu/pmc/core/service/p2p/impl/P2pSupplierSyncJobImpl.java","content":"package com.baidu.pmc.core.service.p2p.impl;\n\nimport com.baidu.microschedule.client.annotation.MicroScheduleExecutor;\nimport com.baidu.microschedule.client.context.MicroScheduleContext;\nimport com.baidu.microschedule.client.logger.Logger;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.common.utils.UtilType;\nimport com.baidu.pmc.core.service.p2p.P2pService;\nimport com.baidu.pmc.core.service.p2p.P2pSupplierSyncJob;\nimport com.baidu.pmc.core.utils.YesOrNo;\nimport com.baidu.pmc.pojo.dto.p2p.P2pFetchRequest;\nimport com.baidu.pmc.pojo.dto.p2p.PayCheckSupplierQo;\nimport com.github.pagehelper.PageInfo;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.beans.factory.annotation.Value;\nimport org.springframework.stereotype.Component;\nimport org.springframework.transaction.annotation.Transactional;\n\nimport java.util.Date;\nimport java.util.HashSet;\nimport java.util.List;\nimport java.util.Objects;\n\n@Component\npublic class P2pSupplierSyncJobImpl implements P2pSupplierSyncJob {\n\n    @Value(\"${p2p.batch.size:1000}\")\n    private Integer batchSize;\n\n    @Value(\"${p2p.sync.period:60}\")\n    private Integer syncPeriod;\n\n    @Autowired\n    private P2pService p2pService;\n\n    /**\n     * 增量同步默认是在共享导入付款单的时候，这里只是做个备用\n     */\n\n    @Override\n    @Transactional(rollbackFor = Exception.class)\n    @MicroScheduleExecutor(code = \"syncNewP2pSupplierInfo\")\n    public void syncNewSupplier() {\n        Logger logger = MicroScheduleContext.currentTaskContext().getLogger();\n        logger.info(\"---sync new p2p supplier info start---\");\n        boolean hasNext = true;\n        int pageNum = 1;\n        long total = 0L;\n        long processedSize = 0L;\n        Date startDate = DateUtils.addDays(new Date(), -syncPeriod);\n        do {\n            // 增量时每次查询数据会变化，因此每次都只查第一页，一直到没有数据为止\n            // 同时记录第一次的总数，避免出现其他异常导致死循环\n            PayCheckSupplierQo qo = new PayCheckSupplierQo();\n            qo.setPageNum(pageNum);\n            qo.setPageSize(batchSize);\n            qo.setCreateDateStart(startDate);\n            qo.setNewSupplierCodeFlag(YesOrNo.yes());\n            PageInfo<String> supCodesRes = p2pService.getPayCheckSupplierCodes(qo);\n            hasNext = supCodesRes.isHasNextPage();\n            total = Math.max(supCodesRes.getTotal(), total);\n            logger.info(\"sync new p2p {} remain to be sync, has next page {}\", supCodesRes.getTotal(), hasNext);\n            List<String> supCodes = supCodesRes.getList();\n            P2pFetchRequest fetchRequest = new P2pFetchRequest();\n            fetchRequest.setSupId(new HashSet<>(supCodes));\n            processedSize += supCodes.size();\n            p2pService.syncP2pSupplierData(fetchRequest);\n        } while (hasNext && processedSize < total);\n        logger.info(\"---sync new p2p supplier info end---\");\n    }\n\n    @Override\n    @Transactional(rollbackFor = Exception.class)\n    @MicroScheduleExecutor(code = \"syncAllP2pSupplierInfo\")\n    public void syncAllSupplier() {\n        Logger logger = MicroScheduleContext.currentTaskContext().getLogger();\n        logger.info(\"---sync all p2p supplier info start---\");\n\n        PayCheckSupplierQo qo = new PayCheckSupplierQo();\n\n        if (Objects.isNull(qo.getCreateDateStart())) {\n            // 默认同步60天之内的\n            qo.setCreateDateStart(DateUtils.addDays(DateUtils.getNow(), -syncPeriod));\n        }\n        if (StringUtils.isBlank(qo.getNewSupplierCodeFlag())) {\n            qo.setNewSupplierCodeFlag(YesOrNo.no());    // 默认同步全量的\n        }\n        logger.info(\"sync all p2p supplier info request {}\", UtilType.bean2Json(qo));\n        boolean hasNext = true;\n        int pageNum = 1;\n        do {\n            qo.setPageNum(pageNum);\n            qo.setPageSize(batchSize);\n            PageInfo<String> supCodesRes = p2pService.getPayCheckSupplierCodes(qo);\n            hasNext = supCodesRes.isHasNextPage();\n            logger.info(\"sync all p2p {} remain to be sync, has next page {} current page {}\",\n                    supCodesRes.getTotal(), hasNext, pageNum);\n            List<String> supCodes = supCodesRes.getList();\n            P2pFetchRequest fetchRequest = new P2pFetchRequest();\n            fetchRequest.setSupId(new HashSet<>(supCodes));\n            p2pService.syncP2pSupplierData(fetchRequest);\n            pageNum++;\n        } while (hasNext);\n        logger.info(\"---sync all p2p supplier info end---\");\n    }\n\n    @Override\n    @Transactional(rollbackFor = Exception.class)\n    @MicroScheduleExecutor(code = \"syncQuotaSetSuppliers\")\n    public void syncQuotaSetSuppliers() {\n        Logger logger = MicroScheduleContext.currentTaskContext().getLogger();\n        logger.info(\"---sync quota set all p2p supplier info start---\");\n        PayCheckSupplierQo qo = new PayCheckSupplierQo();\n        if (Objects.isNull(qo.getCreateDateStart())) {\n            // 默认同步60天之内的\n            qo.setCreateDateStart(DateUtils.addDays(DateUtils.getNow(), -syncPeriod));\n        }\n        if (StringUtils.isBlank(qo.getNewSupplierCodeFlag())) {\n            qo.setNewSupplierCodeFlag(YesOrNo.no());    // 默认同步全量的\n        }\n        logger.info(\"sync quota set all p2p supplier info request {}\", UtilType.bean2Json(qo));\n        boolean hasNext = true;\n        int pageNum = 1;\n        do {\n            qo.setPageNum(pageNum);\n            qo.setPageSize(batchSize);\n            PageInfo<String> supCodesRes = p2pService.getFinanceQuotaSupplierCode(qo);\n            hasNext = supCodesRes.isHasNextPage();\n            logger.info(\"sync quota set all p2p {} remain to be sync, has next page {} current page {}\",\n                    supCodesRes.getTotal(), hasNext, pageNum);\n            List<String> supCodes = supCodesRes.getList();\n            P2pFetchRequest fetchRequest = new P2pFetchRequest();\n            fetchRequest.setSupId(new HashSet<>(supCodes));\n            p2pService.syncP2pSupplierData(fetchRequest);\n            pageNum++;\n        } while (hasNext);\n        logger.info(\"---sync quota set all p2p supplier info end---\");\n    }\n}\n","scheme":"file","completed":false,"isEnd":false,"failed":false,"selections":[{"start":{"column":12,"line":98},"end":{"column":22,"line":102}}]}
