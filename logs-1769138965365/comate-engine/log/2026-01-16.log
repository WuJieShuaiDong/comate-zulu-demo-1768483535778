[14217] [2026-01-20 10:52:26] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"92f21b3a-1291-49cd-82b0-4b43d04cd3e5","existed":true,"absolutePath":"/Users/xiaoliu/baidu/bpit-proc-apps/pmc/pmc-basic-web/src/main/java/com/baidu/pmc/web/clients/PmcSupplierAdmClient.java","content":"package com.baidu.pmc.web.clients;\n\nimport com.baidu.pmc.common.ResponseMessage;\nimport com.baidu.pmc.pojo.dto.PmcAccountDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceCompQuotaSetDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierQuotaSetDTO;\nimport com.baidu.pmc.pojo.dto.SupplierFinancingUsageDTO;\nimport com.baidu.pmc.pojo.model.PmcDataP2pSupplier;\nimport com.baidu.pmc.pojo.qo.PmcPortalRemainQuotaQO;\nimport com.baidu.pmc.pojo.dto.p2p.SyncP2pSupplierRequest;\nimport com.baidu.pmc.pojo.qo.PmcPortalSuggestQO;\nimport com.baidu.pmc.pojo.qo.PmcAccountSearchQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceCompQuotaSetQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceSupplierApplyQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceSupplierQuotaSetQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceBankBaseQO;\nimport com.baidu.pmc.pojo.qo.SupplierFinancingUsageQO;\n\nimport com.baidu.pmc.pojo.vo.PageInfo;\nimport org.springframework.cloud.netflix.feign.FeignClient;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.RequestMethod;\nimport org.springframework.web.bind.annotation.RequestParam;\n\n\nimport java.math.BigDecimal;\nimport java.util.List;\nimport java.util.Map;\n\n@FeignClient(name = \"pmc-basic-service\")\npublic interface PmcSupplierAdmClient {\n\n    @RequestMapping(value = \"/pmcSupplierAdm/selectList\", method = RequestMethod.POST)\n    public PageInfo<PmcFinanceSupplierApplyDTO> selectList(PmcFinanceSupplierApplyQO condition);\n\n    @RequestMapping(value = \"/pmcSupplierAdm/export\", method = RequestMethod.POST)\n    List<PmcFinanceSupplierApplyDTO> export(PmcFinanceSupplierApplyQO condition);\n\n    @RequestMapping(value = \"/pmcSupplierAdm/getQuotaSet\", method = RequestMethod.POST)\n    public PageInfo<PmcFinanceCompQuotaSetDTO> selectQuotaSet(PmcFinanceCompQuotaSetQO condition);\n\n    @RequestMapping(value = \"/pmcSupplierAdm/exportQuotaSet\", method = RequestMethod.POST)\n    public List<PmcFinanceCompQuotaSetDTO> exportQuotaSet(PmcFinanceCompQuotaSetQO condition);\n\n    @RequestMapping(value = \"/pmcSupplierAdm/saveOrUpdate\", method = RequestMethod.POST)\n    ResponseMessage saveOrUpdate(PmcFinanceCompQuotaSetDTO dto);\n\n    @RequestMapping(value = \"/pmcSupplierAdm/getSupplierQuota\", method = RequestMethod.POST)\n    PageInfo<PmcFinanceSupplierQuotaSetDTO> selectSupplierQuotaSet(PmcFinanceSupplierQuotaSetQO condition);\n\n    @RequestMapping(value = \"/pmcSupplierAdm/getSupplierQuotaUse\", method = RequestMethod.POST)\n    PageInfo<SupplierFinancingUsageDTO> selectSupplierQuotaUse(SupplierFinancingUsageQO condition);\n\n    @RequestMapping(value = \"/pmcSupplierAdm/exportSupplierQuota\", method = RequestMethod.POST)\n    List<PmcFinanceSupplierQuotaSetDTO> exportSupplierQuotaSet(PmcFinanceSupplierQuotaSetQO condition);\n\n    @RequestMapping(value = \"/pmcSupplierAdm/saveOrUpdateSupplierQuota\", method = RequestMethod.POST)\n    ResponseMessage saveOrUpdateSupplierQuotaSet(PmcFinanceSupplierQuotaSetDTO dto);\n\n    @RequestMapping(value = \"/pmcSupplierAdm/selectInit\", method = RequestMethod.POST)\n    public Map<String, Object> selectInit();\n\n    @RequestMapping(value = \"/pmcSupplierAdm/selectSuggest\", method = RequestMethod.POST)\n    public List<PmcDataP2pSupplier> selectSuggest(@RequestBody PmcPortalSuggestQO parameter);\n\n    @RequestMapping(value = \"/pmcSupplierAdm/selectSuggestAccount\", method = RequestMethod.POST)\n    public PageInfo<PmcAccountDTO> getAccountViewPage(@RequestBody PmcAccountSearchQO pmcAccountSearchQO);\n    @RequestMapping(value = \"/pmcSupplierAdm/commonCheckData\", method = RequestMethod.POST)\n    ResponseMessage commonCheckData(@RequestBody PmcFinanceBankBaseQO query, @RequestParam(\"methodName\") String methodName);\n\n    /**\n     * 管理员拒绝发送中的融资\n     */\n    @RequestMapping(value = \"/pmcSupplierAdm/admRejectSendBank\", method = RequestMethod.POST)\n    ResponseMessage admRejectSendBank(@RequestBody PmcFinanceSupplierApplyDTO query);\n\n\n    @RequestMapping(value = \"/pmcSupplierAdm/calculateAvailableQuota\", method = RequestMethod.POST)\n    public BigDecimal calculateAvailableQuota(@RequestBody PmcPortalRemainQuotaQO qo);\n\n    @RequestMapping(value = \"/pmcSupplierAdm/updateApply\", method = RequestMethod.POST)\n    ResponseMessage updateApplyStatusOrSendMeg(@RequestBody PmcFinanceBankBaseQO request);\n\n\n    @RequestMapping(value = \"/pmcSupplierAdm/admSubmitApply\", method = RequestMethod.POST)\n    ResponseMessage admSubmitApply(PmcFinanceBankBaseQO qo);\n\n    /**\n     * 同步P2P供应商数据\n     * @param request 供应商同步请求\n     * @return 同步结果\n     */\n    @RequestMapping(value = \"/pmcSupplierAdm/syncP2pSupplierData\", method = RequestMethod.POST)\n    ResponseMessage syncP2pSupplierData(@RequestBody SyncP2pSupplierRequest request);\n}","scheme":"file","completed":false,"isEnd":false,"failed":false}
