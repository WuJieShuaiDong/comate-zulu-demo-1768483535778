[14217] [2026-01-21 09:55:56] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"d886f721-d800-40b5-bebd-8954d296b939","existed":true,"absolutePath":"/Users/xiaoliu/baidu/bpit-proc-apps/pmc/pmc-basic-persistence/src/main/java/com/baidu/pmc/persistence/mapper/pmc/PmcPayChecksMapper.java","content":"package com.baidu.pmc.persistence.mapper.pmc;\n\nimport com.baidu.pmc.persistence.MyMapper;\nimport com.baidu.pmc.pojo.dto.CashPositionPredictDto;\nimport com.baidu.pmc.pojo.dto.PayChecksDTO;\nimport com.baidu.pmc.pojo.dto.PayChecksSummaryItemDTO;\nimport com.baidu.pmc.pojo.dto.PayStatisticData;\nimport com.baidu.pmc.pojo.dto.PmcCmbPayInstructDTO;\nimport com.baidu.pmc.pojo.dto.PmcPayChecksSupplierCodeDTO;\nimport com.baidu.pmc.pojo.dto.TmsFeedbackDataDTO;\nimport com.baidu.pmc.pojo.dto.cmb.BalanceInfo;\nimport com.baidu.pmc.pojo.dto.cmb.ElectronicReceiptDTO;\nimport com.baidu.pmc.pojo.dto.cmb.PayCheckFinancingApplyDTO;\nimport com.baidu.pmc.pojo.dto.third.PayAmountQueryDTO;\nimport com.baidu.pmc.pojo.dto.third.PaycheckRequestDTO;\nimport com.baidu.pmc.pojo.model.PmcPayChecks;\nimport com.baidu.pmc.pojo.qo.CashPositionPredictQO;\nimport com.baidu.pmc.pojo.qo.PayChecksQO;\nimport org.apache.ibatis.annotations.Param;\n\nimport java.util.Date;\nimport java.util.List;\nimport java.util.Map;\n\npublic interface PmcPayChecksMapper extends MyMapper<PmcPayChecks> {\n    List<PmcPayChecks> selectReleasedStatus(PayChecksQO payChecksQO);\n\n    List<PayChecksDTO> selectFailAndRefundQuery(PayChecksQO payChecksQO);\n\n    List<PayChecksDTO> selectBankToPay(PayChecksQO payChecksQO);\n\n    List<PayChecksDTO> selectTransferCheck(PayChecksQO payChecksQO);\n\n    List<PayChecksDTO> selectAllPayChecks(PayChecksQO payChecksQO);\n\n    /**\n     * 针对导出场景优化的精简查询 - 大幅提升性能\n     * 仅查询导出必需的字段，避免返回大量不必要的属性字段\n     */\n    List<PayChecksDTO> selectExportChecks(PayChecksQO payChecksQO);\n\n    List<PmcCmbPayInstructDTO> selectPayListOne(PayChecksQO payChecksQO);\n\n    List<PmcCmbPayInstructDTO> selectCmcPayListOne(PayChecksQO payChecksQO);\n\n    List<PmcCmbPayInstructDTO> selectCitiPayListOne(PayChecksQO payChecksQO);\n\n    List<PmcCmbPayInstructDTO> selectCmbcPayListOne(PayChecksQO payChecksQO);\n\n    List<PmcCmbPayInstructDTO> selectCibPayListOne(PayChecksQO payChecksQO);\n\n    /**\n     * 农行付款详情\n     *\n     * @param payChecksQO\n     * @return\n     */\n    List<PmcCmbPayInstructDTO> selectAbcPayListOne(PayChecksQO payChecksQO);\n\n    /**\n     * 光大付款详情\n     *\n     * @param payChecksQO\n     * @return\n     */\n    List<PmcCmbPayInstructDTO> selectCebPayListOne(PayChecksQO payChecksQO);\n\n    /**\n     * 中信付款详情\n     *\n     * @param payChecksQO\n     * @return\n     */\n    List<PmcCmbPayInstructDTO> selectCiticPayListOne(PayChecksQO payChecksQO);\n\n    /**\n     * 工商银行付款详情\n     * @param payChecksQO\n     * @return\n     */\n    List<PmcCmbPayInstructDTO> selectIcbcPayListOne(PayChecksQO payChecksQO);\n\n    /**\n     * 港交行银行付款详情\n     * @param payChecksQO\n     * @return\n     */\n    List<PmcCmbPayInstructDTO> selectBocomhkPayListOne(PayChecksQO payChecksQO);\n\n    /**\n     * 银企通用付款详情\n     * @param payChecksQO\n     * @return\n     */\n    List<PmcCmbPayInstructDTO> selectBankCommonPayListOne(@Param(\"payCheckQO\") PayChecksQO payChecksQO,\n                                                          @Param(\"bankSuffix\") String bankSuffix);\n\n    int updateStatusBatch(@Param(\"checkIds\") List<Long> checkIds, @Param(\"status\") String status,\n                          @Param(\"lastUpdateBy\") String lastUpdateBy);\n\n    int selectCountPayChecksWithPermission(PayChecksQO payChecksQO);\n\n    List<PayChecksDTO> selectPayChecksWithPermission(PayChecksQO payChecksQO);\n\n    PayChecksDTO selectOneById(@Param(\"checkId\") Long checkId, @Param(\"tenantId\") Long tenantId);\n\n    List<PmcPayChecks> selectPayChecks(PayChecksQO payChecksQO);\n\n    /**\n     * TMS查询单据状态和付款日期\n     *\n     * @param requestDTO\n     * @return\n     */\n    List<TmsFeedbackDataDTO> selectStatusByCondition(PaycheckRequestDTO requestDTO);\n\n    PmcPayChecks selectMaxPayChecks(PayChecksQO payChecksQO);\n\n    List<PmcPayChecks> findPayChecksByCondition(PayChecksQO payChecksQO);\n\n    List<PayChecksSummaryItemDTO> selectPayChecksSummary(PayChecksQO payChecksQO);\n\n    List<String> findDistinctTrxTypes();\n\n    List<PayStatisticData> findStatisticData(PayChecksQO condition);\n\n    List<PayChecksDTO> selectBankPayChecks(PayChecksQO payChecksQO);\n\n    List<PmcPayChecks> selectByAutotenantId();\n\n    int updateNullDate(PmcPayChecks actualPayCheck);\n\n    int updateBeneficiaryTypeFlag(PmcPayChecks actualPayCheck);\n\n\n    List<PayChecksDTO> selectPayApproveStatusCollect(@Param(\"date\") String date);\n\n    List<PayChecksDTO> findCreatedAndApprovingCollect(@Param(\"date\") String date);\n\n    List<PmcCmbPayInstructDTO> selectBocPayListOne(PayChecksQO payChecksQO);\n\n    /**\n     * 获取建行付款单付款明细\n     */\n    List<PmcCmbPayInstructDTO> selectCcbPayListOne(PayChecksQO payChecksQO);\n\n    /**\n     * 超级更正查询\n     */\n    List<PayChecksDTO> selectSuperCorrectionList(PayChecksQO payChecksQO);\n\n    /**\n     * 头寸付款查询\n     *\n     * @param cashQO\n     * @return\n     */\n    List<CashPositionPredictDto> selectCashPosition(CashPositionPredictQO cashQO);\n\n    /**\n     * 已付款头寸查询\n     *\n     * @param cashQO\n     * @return\n     */\n    List<CashPositionPredictDto> selectPayedCashPosition(CashPositionPredictQO cashQO);\n\n    /**\n     * 根据日期统计头寸付款\n     *\n     * @param cashQO\n     * @return\n     */\n    List<Map<String, Object>> selectActualCashPositionByDate(CashPositionPredictQO cashQO);\n\n    /**\n     * 根据日期统计头寸付款\n     *\n     * @param cashQO\n     * @return\n     */\n    List<Map<String, Object>> selectFutureCashPositionByDate(CashPositionPredictQO cashQO);\n\n    /**\n     * 依据交易流水号获取回单打印实例号\n     *\n     * @param payCheckNums\n     * @return\n     */\n    List<ElectronicReceiptDTO> getReceiptByPayCheckNum(@Param(\"payCheckNums\") List<String> payCheckNums);\n\n    /**\n     * 工资单审批页面查询\n     *\n     * @param payChecksQO\n     * @return\n     */\n    List<PayChecksDTO> selectPayRollPayChecks(PayChecksQO payChecksQO);\n\n    /**\n     * 按账户查询透支金额（付款单据为付款余额不足的）\n     *\n     * @param queryDTO\n     * @return\n     */\n    List<BalanceInfo> getOverdraftAmount(PayAmountQueryDTO queryDTO);\n\n    /**\n     * 按账户查询待付款金额\n     *\n     * @param queryDTO\n     * @return\n     */\n    List<BalanceInfo> getPreparePaymentAmount(PayAmountQueryDTO queryDTO);\n\n    /**\n     * 根据供应商编码查询付款单\n     *\n     * @param supplierCode         供应商编码\n     * @param currentDatePlus7Days 当前日期加7天\n     * @param statusList           状态列表\n     * @return 付款单列表\n     */\n    List<PmcPayChecksSupplierCodeDTO> selectBySupplierCode(\n            @Param(\"supplierCode\") String supplierCode,\n            @Param(\"currentDatePlus7Days\") Date currentDatePlus7Days,\n            @Param(\"statusList\") List<String> statusList,\n            @Param(\"targetStatuses\") List<String> targetStatuses);\n\n    /**\n     * 计算供应商当月可融资金额\n     *\n     * @param supplierCode         供应商编码\n     * @param statusList           状态列表\n     * @param currentDatePlus7Days 当前日期加7天\n     * @return 包含当月可融资金额的Map，key为\"monthAmount\"\n     */\n    Map<String, Object> sumAmountBySupplierAndMonth(\n            @Param(\"supplierCode\") String supplierCode,\n            @Param(\"statusList\") List<String> statusList,\n            @Param(\"currentDatePlus7Days\") Date currentDatePlus7Days);\n\n    /**\n     * 计算供应商全年可融资金额\n     *\n     * @param supplierCode         供应商编码\n     * @param statusList           状态列表\n     * @param currentDatePlus7Days 当前日期加7天\n     * @return 包含全年可融资金额的Map，key为\"yearAmount\"\n     */\n    Map<String, Object> sumAmountBySupplierAndYear(\n            @Param(\"supplierCode\") String supplierCode,\n            @Param(\"statusList\") List<String> statusList,\n            @Param(\"currentDatePlus7Days\") Date currentDatePlus7Days);\n\n    /**\n     * 获取未抓取到发票列表\n     */\n    List<PmcPayChecks> selectNotInvoiceList();\n\n    /**\n     * 按付款单号查询融资申请状态\n     *\n     * @param request\n     * @return\n     */\n    List<PayCheckFinancingApplyDTO> getPayCheckFinancingApplyStatus(PaycheckRequestDTO request);\n}","scheme":"file","completed":false,"isEnd":false,"failed":false}
