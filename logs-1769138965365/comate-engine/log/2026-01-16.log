[14217] [2026-01-19 17:08:57] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"88bd3393-1c1f-4ef6-b936-14f73e141665","existed":true,"content":"/*\n * Copyright (C) 2018 Baidu, Inc. All Rights Reserved.\n */\npackage com.baidu.pmc.web.clients;\n\nimport com.baidu.pmc.common.ResponseMessage;\nimport com.baidu.pmc.pojo.dto.PayCheckHangupDTO;\nimport com.baidu.pmc.pojo.dto.PayCheckIdDTO;\nimport com.baidu.pmc.pojo.dto.PayCheckIdsDTO;\nimport com.baidu.pmc.pojo.dto.PayCheckSplitDTO;\nimport com.baidu.pmc.pojo.dto.PayChecksDTO;\nimport com.baidu.pmc.pojo.dto.PayChecksInfoModifyDTO;\nimport com.baidu.pmc.pojo.qo.PayChecksQO;\nimport com.baidu.pmc.pojo.vo.PageInfo;\nimport org.springframework.cloud.netflix.feign.FeignClient;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.RequestMethod;\n\nimport java.util.List;\nimport java.util.Map;\n\n@FeignClient(value = \"pmc-basic-service\")\npublic interface PayReviewClient {\n\n    @RequestMapping(value = \"/pay_review/list\", method = RequestMethod.POST)\n    PageInfo<PayChecksDTO> list(PayChecksQO qo);\n\n    @RequestMapping(value = \"/pay_review/edit\", method = RequestMethod.POST)\n    ResponseMessage edit(PayCheckIdDTO checkId);\n\n    @RequestMapping(value = \"/pay_review/edit/load\", method = RequestMethod.POST)\n    ResponseMessage load(PayCheckIdDTO checkId);\n\n    @RequestMapping(value = \"/pay_review/save\", method = RequestMethod.POST)\n    ResponseMessage save(PayChecksInfoModifyDTO dto);\n\n    @RequestMapping(value = \"/pay_review/hangup\", method = RequestMethod.POST)\n    ResponseMessage hangup(PayCheckHangupDTO payCheckId);\n\n    @RequestMapping(value = \"/pay_review/cancel_hangup\", method = RequestMethod.POST)\n    ResponseMessage cancelHangup(PayCheckHangupDTO payCheckId);\n\n    @RequestMapping(value = \"/pay_review/cancel\", method = RequestMethod.POST)\n    ResponseMessage cancel(PayCheckIdDTO payCheckId);\n\n    @RequestMapping(value = \"/pay_review/review_check\", method = RequestMethod.POST)\n    ResponseMessage reviewCheckByIds(PayCheckIdsDTO payCheckIds);\n\n    @RequestMapping(value = \"/pay_review/review_query_check\", method = RequestMethod.POST)\n    ResponseMessage reviewCheckByQuery(PayChecksQO qo);\n\n    @RequestMapping(value = \"/pay_review/review\", method = RequestMethod.POST)\n    ResponseMessage reviewById(PayCheckIdDTO payCheckId);\n\n    @RequestMapping(value = \"/pay_review/cancel_review\", method = RequestMethod.POST)\n    ResponseMessage cancelReview(PayCheckIdsDTO payCheckIds);\n\n    @RequestMapping(value = \"/pay_review/batch_review\", method = RequestMethod.POST)\n    ResponseMessage batchReview(PayCheckIdsDTO payCheckIds);\n\n    @RequestMapping(value = \"/pay_review/review_query\", method = RequestMethod.POST)\n    ResponseMessage reviewByQuery(PayChecksQO qo);\n\n    @RequestMapping(value = \"/pay_review/init_select\", method = RequestMethod.POST)\n    Map<String, Object> initSelect();\n\n    @RequestMapping(value = \"/pay_review/pay_split\", method = RequestMethod.POST)\n    ResponseMessage paySplit(PayCheckSplitDTO checkId);\n\n    @RequestMapping(value = \"/pay_review/checkRelPayNum\", method = RequestMethod.POST)\n    ResponseMessage checkRelPayNum(PayCheckIdDTO checkId);\n\n    @RequestMapping(value = \"/pay_review/cancelList\", method = RequestMethod.POST)\n    ResponseMessage cancelList(PayCheckIdsDTO checkId);\n\n    @RequestMapping(value = \"/pay_review/paySplitUnPayCheckMail\", method = RequestMethod.POST)\n    ResponseMessage paySplitUnPayCheckMail();\n\n    /**\n     * Excel导出接口\n     *\n     * @param qo 查询条件\n     * @return\n     */\n    @RequestMapping(value = \"/pay_review/exportExcel\", method = RequestMethod.POST)\n    List<PayChecksDTO> exportExcel(PayChecksQO qo);\n}\n","completed":false,"isEnd":false,"failed":false}
