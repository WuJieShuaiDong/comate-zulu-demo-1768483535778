[14217] [2026-01-21 11:25:20] [INFO] [ENGINE]  <--------- ENGINE SEND: VIRTUAL_EDITOR_EVENT {"action":"getDocument","payload":{"absolutePath":"/Users/xiaoliu/baidu/bpit-proc-apps/pmc/FinalEncodingTest.java","uuid":"32a4dc5e-9a9f-46d7-bef2-1b02e833e43c"}}
[14217] [2026-01-21 11:25:20] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"32a4dc5e-9a9f-46d7-bef2-1b02e833e43c","existed":true,"content":"import java.io.UnsupportedEncodingException;\nimport java.nio.charset.StandardCharsets;\n\npublic class FinalEncodingTest {\n\n    public static void main(String[] args) {\n        try {\n            String original = \"付款明细_20260121110807\";\n            System.out.println(\"=== 最终编码方案验证 ===\");\n            System.out.println(\"原始文件名: \" + original);\n\n            // 修复前的错误编码（导致乱码）\n            String wrongOldEncoding = new String(original.getBytes(), StandardCharsets.ISO_8859_1);\n            System.out.println(\"错误的旧编码: \" + wrongOldEncoding);\n\n            // 修复后的正确编码方案（UTF-8 → ISO-8859-1）\n            String correctEncoding = new String(original.getBytes(\"UTF-8\"), StandardCharsets.ISO_8859_1);\n            System.out.println(\"修复后的正确编码: \" + correctEncoding);\n\n            // 查看字节对比\n            System.out.println(\"\\n=== 字节对比 ===\");\n            byte[] wrongBytes = original.getBytes();\n            byte[] correctBytes = original.getBytes(\"UTF-8\");\n\n            System.out.print(\"错误的默认编码字节: \");\n            for (byte b : wrongBytes) {\n                System.out.print(String.format(\"%02X \", b));\n            }\n\n            System.out.print(\"\\n正确的UTF-8编码字节: \");\n            for (byte b : correctBytes) {\n                System.out.print(String.format(\"%02X \", b));\n            }\n\n            // 验证修复效果\n            System.out.println(\"\\n\\n=== 修复效果验证 ===\");\n            System.out.println(\"修复前文件名在浏览器显示: ä»_æ¬¾æ__ç»_\" +\n                (wrongOldEncoding.contains(\"ä»\") ? \" (乱码)\" : \" (正确)\"));\n\n            System.out.println(\"修复后文件名在浏览器显示: 付款明细_\" +\n                (correctEncoding.contains(\"付款\") ? \" (乱码)\" : \" (正确)\"));\n\n            // 模拟浏览器解码过程\n            System.out.println(\"\\n=== 浏览器解码模拟 ===\");\n            String browserDecoded = new String(correctEncoding.getBytes(StandardCharsets.ISO_8859_1), \"UTF-8\");\n            System.out.println(\"浏览器解码后显示: \" + browserDecoded);\n\n        } catch (Exception e) {\n            e.printStackTrace();\n        }\n    }\n}","completed":false,"isEnd":false,"failed":false}
