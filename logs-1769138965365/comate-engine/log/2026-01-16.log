[14217] [2026-01-20 20:33:43] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"76df781e-a6ff-4b75-bc33-8a0e909e2848","existed":true,"content":"package com.baidu.pmc.web.clients;\n\nimport java.util.List;\nimport java.util.Map;\n\nimport com.baidu.pmc.common.ResponseMessage;\nimport org.springframework.cloud.netflix.feign.FeignClient;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.RequestMethod;\n\nimport com.baidu.pmc.pojo.dto.PayChecksDTO;\nimport com.baidu.pmc.pojo.dto.PmcCmbPayInstructDTO;\nimport com.baidu.pmc.pojo.qo.CashPositionPredictQO;\nimport com.baidu.pmc.pojo.qo.PayChecksQO;\nimport com.baidu.pmc.pojo.vo.PageInfo;\n\n@FeignClient(value = \"pmc-basic-service\")\npublic interface PaySelectClient {\n\n    @RequestMapping(value = \"/pay_query/list\", method = RequestMethod.POST)\n    public PageInfo<PayChecksDTO> getPayApplyList(PayChecksQO payChecksQO);\n\n    @RequestMapping(value = \"/pay_query/status_list\", method = RequestMethod.POST)\n    public PageInfo<PayChecksDTO> getListByStatus(PayChecksQO payChecksQO);\n\n    @RequestMapping(value = \"/pay_query/pay_list\", method = RequestMethod.POST)\n    public List<PmcCmbPayInstructDTO> payListOne(PayChecksQO payChecksQO);\n\n    @RequestMapping(value = \"/pay_query/export\", method = RequestMethod.POST)\n    public List<PayChecksDTO> getPayApplyListExport(PayChecksQO payChecksQO);\n\n    @RequestMapping(value = \"/pay_query/init_select\", method = RequestMethod.POST)\n    public Map<String, Object> selectInit();\n\n    @RequestMapping(value = \"/pay_query/write_back\", method = RequestMethod.POST)\n    public ResponseMessage writeBack(@RequestBody List<Long> payChecksIds);\n\n    @RequestMapping(value = \"/pay_query/write_back_sap\", method = RequestMethod.POST)\n    public ResponseMessage writeBackSap(@RequestBody List<Long> payChecksIds);\n\n    @RequestMapping(value = \"/pay_query/toTmsChecks\", method = RequestMethod.POST)\n    public ResponseMessage selectCashPosition(CashPositionPredictQO cashQo);\n\n}\n","completed":false,"isEnd":false,"failed":false}
