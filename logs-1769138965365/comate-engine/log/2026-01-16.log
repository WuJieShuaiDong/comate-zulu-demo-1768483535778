[14217] [2026-01-21 11:23:25] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"3d4b3e70-9f0b-4d93-9357-e6650c6dd71c","existed":true,"content":"package com.baidu.pmc.web.service.receipt.impl;\n\nimport java.io.File;\nimport java.io.FileInputStream;\nimport java.io.FileOutputStream;\nimport java.io.InputStream;\nimport java.io.OutputStream;\nimport java.util.Date;\nimport java.util.List;\n\nimport javax.servlet.http.HttpServletRequest;\nimport javax.servlet.http.HttpServletResponse;\n\nimport org.apache.commons.compress.archivers.zip.ZipArchiveEntry;\nimport org.apache.commons.compress.archivers.zip.ZipArchiveOutputStream;\nimport org.apache.commons.compress.utils.IOUtils;\nimport org.apache.commons.lang3.exception.ExceptionUtils;\nimport org.springframework.beans.factory.annotation.Value;\nimport org.springframework.stereotype.Service;\nimport org.springframework.util.FileCopyUtils;\n\nimport com.baidu.pmc.common.exception.WebException;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.web.service.receipt.ReceiptService;\nimport com.baidubce.Protocol;\nimport com.baidubce.auth.DefaultBceCredentials;\nimport com.baidubce.services.bos.BosClient;\nimport com.baidubce.services.bos.BosClientConfiguration;\nimport com.baidubce.services.bos.model.ObjectMetadata;\nimport com.baidubce.services.bos.model.BosObject;\n\nimport lombok.extern.slf4j.Slf4j;\n\n/**\n * 电子回单操作(同cmb 服务ElectronicReceiptController)\n * @author: sunxiaoning\n * @date: 2023/5/16\n */\n@Service\n@Slf4j\npublic class ReceiptServiceImpl implements ReceiptService {\n\n    /**\n     * 用户的Access Key ID\n     */\n    @Value(\"${BOS.ACCESS_KEY_ID}\")\n    private String accessKeyId;\n\n    /**\n     * 用户的Secret Access Key\n     */\n    @Value(\"${BOS.SECRET_ACCESS_KEY}\")\n    private String secretAccessKey ;\n\n    /**\n     * 指定的域名\n     */\n    @Value(\"${BOS.ENDPOINT}\")\n    private String endpoint;\n\n    /**\n     * 指bucketname\n     */\n    @Value(\"${BOS.BUCKET_NAME}\")\n    private String bucketName;\n\n    @Override\n    public void getReceiptImage(String printInstanceNumber, HttpServletRequest request, HttpServletResponse response) {\n        // 初始化一个BosClient\n        BosClient client = initClient();\n        InputStream objectContent = null;\n        // 处理Object\n        OutputStream out = null;\n        try {\n            // 获取Object，返回结果为BosObject对象\n            BosObject object = client.getObject(bucketName, printInstanceNumber);\n            // 获取ObjectMeta\n            ObjectMetadata meta = object.getObjectMetadata();\n            // 获取Object的输入流\n            objectContent = object.getObjectContent();\n            if (objectContent == null) {\n                log.info(\"没有找到图片数据:{}\", printInstanceNumber);\n                return;\n            }\n            int index;\n            byte[] bytes = new byte[1024];\n            while ((index = objectContent.read(bytes)) != -1) {\n                // multipart/form-data  image/png\n                response.setContentType(\"image/png\");\n                out = response.getOutputStream();\n                out.write(bytes, 0, index);\n            }\n        } catch (Exception e) {\n            log.error(\"BOS读取图片数据异常:{}\", ExceptionUtils.getStackTrace(e));\n            throw new WebException(\"暂未获取到文件，请稍候重试\");\n        } finally {\n            // 关闭流\n            try {\n                if (objectContent != null) {\n                    objectContent.close();\n                }\n                if (out != null) {\n                    out.flush();\n                    out.close();\n                }\n            } catch (Exception e) {\n                log.error(\"流关闭异常\", e);\n            }\n        }\n    }\n\n    @Override\n    public void batchDownloadImage(List<String> printInstanceNumberList, HttpServletRequest request,\n                                   HttpServletResponse response) {\n        // 初始化一个BosClient\n        BosClient client = initClient();\n        InputStream objectContent = null;\n        File zip = null;\n        try {\n            zip = File.createTempFile(\"receipt\", \".zip\");\n            ZipArchiveOutputStream zos = new ZipArchiveOutputStream(new FileOutputStream(zip));\n            ZipArchiveEntry ze;\n\n            for (String num : printInstanceNumberList) {\n                BosObject object = client.getObject(bucketName, num);\n                objectContent = object.getObjectContent();\n                if (objectContent != null) {\n                    ze = new ZipArchiveEntry(num + \".jpg\");\n                    zos.putArchiveEntry(ze);\n                    IOUtils.copy(objectContent, zos);\n                    zos.closeArchiveEntry();\n                }\n                object.close();\n            }\n            // 需要在此处关闭压缩流，否则一些压缩软件无法打开下载的压缩包，比如winrar软件无法打开， 而一些国产压缩软件可以打开\n            IOUtils.closeQuietly(zos);\n            String filename = new String(\"电子回单\".getBytes(\"UTF-8\"), \"ISO-8859-1\") + DateUtils\n                    .formatDate(new Date(), \"yyyyMMdd\") + \".zip\";\n            // 设置下载下载头\n            response.setHeader(\"Content-Disposition\", \"attachment; fileName=\\\"\" + filename + \"\\\"\");\n            response.setContentType(\"application/octet-stream\");\n            // 下载文件\n            FileCopyUtils.copy(new FileInputStream(zip), response.getOutputStream());\n        } catch (Exception e) {\n            log.error(\"批量下载图片数据异常！\", e);\n            throw new WebException(\"批量下载失败，请稍候重试\");\n        } finally {\n            if (zip != null && zip.exists()) {\n                // 将临时文件删掉\n                zip.delete();\n            }\n        }\n    }\n\n    /**\n     * 初始化bos client\n     * @return\n     */\n    private BosClient initClient() {\n        BosClientConfiguration config = new BosClientConfiguration();\n        config.setCredentials(new DefaultBceCredentials(accessKeyId, secretAccessKey));\n        config.setEndpoint(endpoint);\n        // 如果不指明, 则使用http\n        config.setProtocol(Protocol.HTTPS);\n        return new BosClient(config);\n    }\n}\n","completed":false,"isEnd":false,"failed":false}
