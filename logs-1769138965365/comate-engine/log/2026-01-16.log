[14217] [2026-01-19 17:15:53] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"084698dd-dfed-4479-b01b-b629f19f5cea","existed":true,"absolutePath":"/Users/xiaoliu/baidu/bpit-proc-apps/pmc/pmc-basic-web/src/main/java/com/baidu/pmc/web/clients/PayFailedBalanceClient.java","content":"/*\n * Copyright (C) 2018 Baidu, Inc. All Rights Reserved.\n */\npackage com.baidu.pmc.web.clients;\n\nimport java.util.List;\nimport java.util.Map;\n\nimport org.springframework.cloud.netflix.feign.FeignClient;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.RequestMethod;\n\nimport com.baidu.pmc.common.ResponseMessage;\nimport com.baidu.pmc.pojo.dto.PayCheckIdsDTO;\nimport com.baidu.pmc.pojo.dto.PayChecksDTO;\nimport com.baidu.pmc.pojo.dto.SelectDTO;\nimport com.baidu.pmc.pojo.qo.PayChecksQO;\nimport com.baidu.pmc.pojo.vo.PageInfo;\n\n@FeignClient(value = \"pmc-basic-service\")\npublic interface PayFailedBalanceClient {\n\n    @RequestMapping(value = \"/pay_failed_balance/list\", method = RequestMethod.POST)\n    PageInfo<PayChecksDTO> failedBalanceList(PayChecksQO qo);\n\n    @RequestMapping(value = \"/pay_failed_balance/send_again\", method = RequestMethod.POST)\n    ResponseMessage sendBankAgain(PayCheckIdsDTO ids);\n\n    @RequestMapping(value = \"/pay_failed_balance/select_init\", method = RequestMethod.POST)\n    Map<String, List<SelectDTO>> failedBalanceSelectInit();\n\n    /**\n     * 余额不足付款失败列表导出Excel\n     *\n     * @param qo 查询条件\n     * @return\n     */\n    @RequestMapping(value = \"/pay_failed_balance/exportExcel\", method = RequestMethod.POST)\n    List<PayChecksDTO> exportExcel(PayChecksQO qo);\n}\n","scheme":"file","completed":false,"isEnd":false,"failed":false}
