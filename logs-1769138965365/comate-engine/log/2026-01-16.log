[14217] [2026-01-21 11:21:22] [INFO] [ENGINE]  <--------- ENGINE SEND: VIRTUAL_EDITOR_EVENT {"action":"getDocument","payload":{"absolutePath":"/Users/xiaoliu/baidu/bpit-proc-apps/pmc/TestCsvFileName.java","uuid":"41d3ac48-bc99-4738-8c51-d7fc523d68a7"}}
[14217] [2026-01-21 11:21:22] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"41d3ac48-bc99-4738-8c51-d7fc523d68a7","existed":true,"content":"import java.io.UnsupportedEncodingException;\nimport java.nio.charset.StandardCharsets;\n\npublic class TestCsvFileName {\n\n    /**\n     * 模拟修复前的文件名处理方法（有问题的）\n     */\n    public static String oldFileNameEncoding(String fileName) throws UnsupportedEncodingException {\n        // 原问题代码：fileName = new String(fileName.getBytes(), StandardCharsets.ISO_8859_1);\n        return new String(fileName.getBytes(), StandardCharsets.ISO_8859_1);\n    }\n\n    /**\n     * 模拟修复后的文件名处理方法\n     */\n    public static String newFileNameEncoding(String fileName) throws UnsupportedEncodingException {\n        // 修复后代码：String encodedFileName = new String(fileName.getBytes(\"GB2312\"), StandardCharsets.ISO_8859_1);\n        return new String(fileName.getBytes(\"GB2312\"), StandardCharsets.ISO_8859_1);\n    }\n\n    /**\n     * 修复后的智能后缀处理方法\n     */\n    public static String processFileName(String fileName) {\n        // 确保文件名以.csv结尾，避免重复添加后缀\n        if (!fileName.toLowerCase().endsWith(\".csv\")) {\n            fileName = fileName + \".csv\";\n        }\n        return fileName;\n    }\n\n    public static void main(String[] args) {\n        try {\n            System.out.println(\"=== CSV导出文件名编码测试结果 ===\\n\");\n\n            // 测试数据\n            String[] testNames = {\n                \"付款明细_20260121110807\",\n                \"付款信息_20250101\",\n                \"test_payment\"\n            };\n\n            for (String originalName : testNames) {\n                System.out.println(\"原始文件名: \" + originalName);\n\n                // 测试旧方法（有问题的）\n                String oldEncoded = oldFileNameEncoding(originalName);\n                System.out.println(\"旧方法编码结果: \" + oldEncoded);\n                System.out.println(\"旧方法编码正确性: \" +\n                    (oldEncoded.contains(\"ä»\") ? \"❌ 乱码\" : \"✓ 正常\"));\n\n                // 测试新方法（修复后的）\n                String newEncoded = newFileNameEncoding(originalName);\n                System.out.println(\"新方法编码结果: \" + newEncoded);\n                System.out.println(\"新方法编码正确性: \" +\n                    (newEncoded.contains(\"ä»\") ? \"❌ 乱码\" : \"✓ 正常\"));\n\n                // 测试智能后缀处理\n                String processedName = processFileName(originalName);\n                System.out.println(\"智能后缀处理后: \" + processedName);\n\n                // 测试完整流程\n                String finalName = processFileName(originalName);\n                String finalEncoded = newFileNameEncoding(finalName);\n                System.out.println(\"最终文件名编码: \" + finalEncoded);\n\n                System.out.println();\n            }\n\n            // 特别测试重复后缀的情况\n            System.out.println(\"=== 重复后缀处理测试 ===\");\n            String[] suffixTestNames = {\n                \"付款明细_20260121110807\",\n                \"付款明细_20260121110807.csv\",\n                \"付款明细_20260121110807.CSV\"\n            };\n\n            for (String testName : suffixTestNames) {\n                String result = processFileName(testName);\n                System.out.println(\"输入: \" + testName + \" -> 输出: \" + result);\n            }\n\n            System.out.println(\"\\n=== 浏览器Content-Disposition头生成 ===\");\n            String fileName = \"付款明细_20260121110807\";\n            String processed = processFileName(fileName);\n            String encoded = newFileNameEncoding(processed);\n            String contentDisposition = \"attachment;filename=\" + encoded;\n            System.out.println(\"Content-Disposition: \" + contentDisposition);\n\n        } catch (Exception e) {\n            e.printStackTrace();\n        }\n    }\n}","completed":false,"isEnd":false,"failed":false}
