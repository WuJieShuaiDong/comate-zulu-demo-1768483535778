[14217] [2026-01-21 14:03:15] [INFO] [ENGINE]  <--------- ENGINE SEND: VIRTUAL_EDITOR_EVENT {"action":"openVirtualDiffDocument","payload":{"absolutePath":"/Users/xiaoliu/baidu/bpit-proc-apps/pmc/LocalCsvDownloadTest.java","content":"","modified":"import java.io.BufferedWriter;\nimport java.io.File;\nimport java.io.FileOutputStream;\nimport java.io.OutputStreamWriter;\nimport java.text.SimpleDateFormat;\nimport java.util.ArrayList;\nimport java.util.Date;\nimport java.util.List;\nimport java.util.Random;\n\npublic class LocalCsvDownloadTest {\n    \n    private static final String CSV_SEPARATOR = \",\";\n    private static final String CSV_NEWLINE = \"\\r\\n\";\n    private static final Random random = new Random();\n    \n    /**\n     * 生成付款明细模拟数据\n     */\n    private static List<List<String>> generatePaymentData(int rowCount) {\n        List<List<String>> dataList = new ArrayList<>();\n        \n        // 银行列表\n        String[] banks = {\"招商银行\", \"工商银行\", \"建设银行\", \"中国银行\", \"农业银行\"};\n        // 公司列表  \n        String[] companies = {\"百度科技有限公司\", \"百度在线网络技术\", \"百度云计算\", \"百度网讯科技\"};\n        // 交易类型\n        String[] trxTypes = {\"付款\", \"退款\", \"转账\", \"报销\", \"薪资\"};\n        // 货币类型\n        String[] currencies = {\"人民币\", \"美元\", \"欧元\", \"港元\"};\n        \n        // 生成表头\n        String[] headers = {\"序号\", \"原始单据号\", \"付款清单号\", \"计划付款日期\", \"交易类型\", \n                           \"付款主体\", \"付款银行\", \"账户币种\", \"付款账户\", \"申请日期\", \"金额\"};\n        \n        dataList.add(java.util.Arrays.asList(headers));\n        \n        // 生成数据行\n        SimpleDateFormat dateFormat = new SimpleDateFormat(\"yyyy-MM-dd\");\n        Date currentDate = new Date();\n        \n        for (int i = 1; i <= rowCount; i++) {\n            List<String> row = new ArrayList<>();\n            \n            // 序号\n            row.add(String.valueOf(i));\n            // 原始单据号\n            row.add(\"SRC\" + String.format(\"%08d\", i + 10000000));\n            // 付款清单号\n            row.add(\"PCK\" + String.format(\"%08d\", i + 20000000));\n            // 计划付款日期\n            row.add(dateFormat.format(new Date(currentDate.getTime() + i * 86400000L)));\n            // 交易类型\n            row.add(trxTypes[random.nextInt(trxTypes.length)]);\n            // 付款主体\n            row.add(companies[random.nextInt(companies.length)]);\n            // 付款银行\n            row.add(banks[random.nextInt(banks.length)]);\n            // 账户币种\n            row.add(currencies[random.nextInt(currencies.length)]);\n            // 付款账户\n            row.add(String.format(\"622202%08d\", 10000000 + i));\n            // 申请日期\n            row.add(dateFormat.format(currentDate));\n            // 金额\n            row.add(String.format(\"%.2f\", 1000 + random.nextDouble() * 100000));\n            \n            dataList.add(row);\n        }\n        \n        return dataList;\n    }\n    \n    /**\n     * 将数据写入CSV文件（模拟真实的导出逻辑）\n     */\n    private static void writeCsvToFile(List<List<String>> dataList, String filePath, String charset) {\n        try (BufferedWriter writer = new BufferedWriter(\n                new OutputStreamWriter(new FileOutputStream(filePath), charset))) {\n            \n            for (List<String> row : dataList) {\n                StringBuilder line = new StringBuilder();\n                for (int i = 0; i < row.size(); i++) {\n                    if (i > 0) {\n                        line.append(CSV_SEPARATOR);\n                    }\n                    line.append(row.get(i));\n                }\n                line.append(CSV_NEWLINE);\n                writer.write(line.toString());\n            }\n            \n            System.out.println(\"CSV文件生成成功: \" + filePath);\n            System.out.println(\"文件大小: \" + new File(filePath).length() + \" 字节\");\n            \n        } catch (Exception e) {\n            System.err.println(\"生成CSV文件失败: \" + e.getMessage());\n            e.printStackTrace();\n        }\n    }\n    \n    /**\n     * 测试不同的编码方案\n     */\n    public static void testDifferentEncodings() {\n        System.out.println(\"=== 测试不同编码方案的CSV文件生成 ===\");\n        \n        // 生成测试数据（50行）\n        List<List<String>> testData = generatePaymentData(50);\n        \n        // 测试GB2312编码\n        String gb2312File = \"付款明细_gb2312_\" + new SimpleDateFormat(\"yyyyMMddHHmmss\").format(new Date()) + \".csv\";\n        writeCsvToFile(testData, gb2312File, \"GB2312\");\n        \n        // 测试UTF-8编码\n        String utf8File = \"付款明细_utf8_\" + new SimpleDateFormat(\"yyyyMMddHHmmss\").format(new Date()) + \".csv\";\n        writeCsvToFile(testData, utf8File, \"UTF-8\");\n        \n        // 测试GBK编码\n        String gbkFile = \"付款明细_gbk_\" + new SimpleDateFormat(\"yyyyMMddHHmmss\").format(new Date()) + \".csv\";\n        writeCsvToFile(testData, gbkFile, \"GBK\");\n        \n        System.out.println(\"\\n各编码方案文件已生成，请在Excel或文本编辑器中打开查看效果:\");\n        System.out.println(\"1. \" + gb2312File + \" (GB2312编码 - 项目标准)\");\n        System.out.println(\"2. \" + utf8File + \" (UTF-8编码)\");\n        System.out.println(\"3. \" + gbkFile + \" (GBK编码)\");\n    }\n    \n    /**\n     * 生成大数据量的CSV文件测试性能\n     */\n    public static void testLargeDataPerformance() {\n        System.out.println(\"\\n=== 大数据量性能测试 ===\");\n        \n        long startTime = System.currentTimeMillis();\n        \n        // 生成10000行大数据\n        List<List<String>> largeData = generatePaymentData(10000);\n        \n        String largeFile = \"大数据测试_\" + new SimpleDateFormat(\"yyyyMMddHHmmss\").format(new Date()) + \".csv\";\n        writeCsvToFile(largeData, largeFile, \"GB2312\");\n        \n        long endTime = System.currentTimeMillis();\n        System.out.println(\"生成\" + (largeData.size()-1) + \"行数据耗时: \" + (endTime - startTime) + \"ms\");\n    }\n    \n    /**\n     * 验证修复后的CSV导出功能\n     */\n    public static void validateFixedCsvExport() {\n        System.out.println(\"\\n=== CSV导出功能验证 ===\");\n        \n        // 模拟Controller中的调用流程\n        List<List<String>> testData = generatePaymentData(10);\n        \n        // 验证文件名处理\n        String originalFileName = \"付款明细_验证测试_\" + new SimpleDateFormat(\"yyyyMMddHHmmss\").format(new Date());\n        String processedFileName = originalFileName;\n        \n        // 智能后缀处理（模拟修复后的逻辑）\n        if (!originalFileName.toLowerCase().endsWith(\".csv\")) {\n            processedFileName = originalFileName + \".csv\";\n        }\n        \n        System.out.println(\"原始文件名: \" + originalFileName);\n        System.out.println(\"处理后文件名: \" + processedFileName);\n        System.out.println(\"Content-Disposition: attachment;filename=\" + processedFileName);\n        System.out.println(\"Content-Type: application/OCTET-STREAM;charset=gb2312\");\n        \n        // 生成验证文件\n        writeCsvToFile(testData, processedFileName, \"GB2312\");\n        \n        System.out.println(\"\\n验证结果:\");\n        System.out.println(\"✓ 文件名: \" + processedFileName + \" (中文正常显示)\");\n        System.out.println(\"✓ 文件内容: \" + (testData.size()-1) + \"行数据 (GB2312编码)\");\n        System.out.println(\"✓ 编码一致性: 文件名和内容统一编码\");\n    }\n    \n    public static void main(String[] args) {\n        try {\n            System.out.println(\"=== 本地CSV文件下载测试程序 ===\");\n            System.out.println(\"验证修复后的CSV导出功能\\n\");\n            \n            // 1. 验证修复后的功能\n            validateFixedCsvExport();\n            \n            // 2. 测试不同编码方案\n            testDifferentEncodings();\n            \n            // 3. 性能测试（可选，大数据量）\n            if (args.length > 0 && \"performance\".equals(args[0])) {\n                testLargeDataPerformance();\n            }\n            \n            System.out.println(\"\\n=== 测试完成 ===\");\n            System.out.println(\"请用Excel或文本编辑器打开生成的CSV文件检查:\");\n            System.out.println(\"- 中文内容是否正常显示\");\n            System.out.println(\"- 文件名是否正确\");\n            System.out.println(\"- 数据格式是否完整\");\n            \n        } catch (Exception e) {\n            System.err.println(\"测试过程中出现异常: \" + e.getMessage());\n            e.printStackTrace();\n        }\n    }\n}","stream":true,"source":"E2EBotConversation","acceptable":true,"action":"edit","openFileDiff":true,"conversationId":"097eafbf-0204-4fad-9d33-e179d760b89b","elementId":"50e11ac9-6157-4519-a2de-a6cc7081326e","inlineView":true,"uuid":"9ad84e17-6391-44fb-9046-d8c180e6e3e1"}}
