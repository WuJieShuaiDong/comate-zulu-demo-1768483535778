[14217] [2026-01-21 11:25:14] [INFO] [ENGINE]  <--------- ENGINE SEND: VIRTUAL_EDITOR_EVENT {"action":"getDocument","payload":{"absolutePath":"/Users/xiaoliu/baidu/bpit-proc-apps/pmc/BrowserEncodingTest.java","uuid":"4ea29228-e347-40a1-be42-8233f3af907a"}}
[14217] [2026-01-21 11:25:14] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"4ea29228-e347-40a1-be42-8233f3af907a","existed":true,"content":"import java.io.UnsupportedEncodingException;\nimport java.nio.charset.StandardCharsets;\n\npublic class BrowserEncodingTest {\n\n    public static void main(String[] args) {\n        try {\n            String original = \"付款明细_20260121110807\";\n            System.out.println(\"=== 浏览器下载文件名编码测试 ===\");\n            System.out.println(\"原始中文文件名: \" + original);\n            System.out.println();\n\n            // 测试不同的编码组合\n            String[][] testCases = {\n                {\"UTF-8 -> ISO-8859-1\", \"UTF-8\", \"ISO-8859-1\"},\n                {\"GBK -> ISO-8859-1\", \"GBK\", \"ISO-8859-1\"},\n                {\"GB2312 -> ISO-8859-1\", \"GB2312\", \"ISO-8859-1\"},\n                {\"系统默认 -> ISO-8859-1\", \"\", \"ISO-8859-1\"},\n                {\"直接URL编码\", \"UTF-8\", \"URL\"}\n            };\n\n            for (String[] testCase : testCases) {\n                String description = testCase[0];\n                String sourceCharset = testCase[1];\n                String targetCharset = testCase[2];\n\n                String result;\n                if (\"URL\".equals(targetCharset)) {\n                    result = java.net.URLEncoder.encode(original, sourceCharset);\n                } else if (sourceCharset.isEmpty()) {\n                    result = new String(original.getBytes(), StandardCharsets.ISO_8859_1);\n                } else {\n                    result = new String(original.getBytes(sourceCharset), StandardCharsets.ISO_8859_1);\n                }\n\n                System.out.println(description + \":\");\n                System.out.println(\"  编码结果: \" + result);\n\n                // 模拟浏览器解码过程\n                String browserDisplay;\n                try {\n                    if (\"URL\".equals(targetCharset)) {\n                        browserDisplay = java.net.URLDecoder.decode(result, \"UTF-8\");\n                    } else {\n                        browserDisplay = new String(result.getBytes(StandardCharsets.ISO_8859_1), \"UTF-8\");\n                    }\n                    System.out.println(\"  浏览器显示: \" + browserDisplay);\n                } catch (Exception e) {\n                    System.out.println(\"  浏览器显示: [解码失败]\");\n                }\n                System.out.println();\n            }\n\n            // 特别测试用户遇到的具体问题\n            System.out.println(\"=== 用户问题重现 ===\");\n            String userProblem = \"付款明细_20260121110807.csv\";\n            String wrongEncoding = new String(userProblem.getBytes(), StandardCharsets.ISO_8859_1);\n            System.out.println(\"问题文件名编码: \" + wrongEncoding);\n            System.out.println(\"包含乱码字符: \" + wrongEncoding.contains(\"ä»\"));\n\n            // 修复方案测试\n            String fixedEncoding = new String(userProblem.getBytes(\"UTF-8\"), StandardCharsets.ISO_8859_1);\n            System.out.println(\"修复后编码: \" + fixedEncoding);\n            System.out.println(\"修复后效果: \" + (fixedEncoding.contains(\"ä»\") ? \"仍有乱码\" : \"无乱码\"));\n\n        } catch (Exception e) {\n            e.printStackTrace();\n        }\n    }\n}","completed":false,"isEnd":false,"failed":false}
