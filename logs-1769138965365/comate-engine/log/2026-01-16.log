[14217] [2026-01-21 11:22:53] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"01f78663-7eb1-43b1-8b63-e2e8146b7132","existed":true,"content":"import java.io.UnsupportedEncodingException;\nimport java.nio.charset.StandardCharsets;\n\npublic class DebugEncoding {\n\n    public static void main(String[] args) {\n        try {\n            String original = \"付款明细_20260121110807\";\n            System.out.println(\"=== 编码转换调试 ===\");\n            System.out.println(\"原始文件名: \" + original);\n\n            // 打印字符的原始字节\n            System.out.println(\"\\n原始字节 (UTF-8): \");\n            byte[] utf8Bytes = original.getBytes(\"UTF-8\");\n            for (byte b : utf8Bytes) {\n                System.out.print(String.format(\"%02X \", b));\n            }\n\n            System.out.println(\"\\n\\n原始字节 (GB2312): \");\n            byte[] gb2312Bytes = original.getBytes(\"GB2312\");\n            for (byte b : gb2312Bytes) {\n                System.out.print(String.format(\"%02X \", b));\n            }\n\n            System.out.println(\"\\n\\n原始字节 (系统默认): \");\n            byte[] defaultBytes = original.getBytes();\n            for (byte b : defaultBytes) {\n                System.out.print(String.format(\"%02X \", b));\n            }\n\n            // 测试不同的编码组合\n            System.out.println(\"\\n\\n=== 不同编码组合测试 ===\");\n\n            // 组合1: GB2312 -> ISO-8859-1\n            String combo1 = new String(original.getBytes(\"GB2312\"), StandardCharsets.ISO_8859_1);\n            System.out.println(\"GB2312 -> ISO-8859-1: \" + combo1);\n\n            // 组合2: UTF-8 -> ISO-8859-1\n            String combo2 = new String(original.getBytes(\"UTF-8\"), StandardCharsets.ISO_8859_1);\n            System.out.println(\"UTF-8 -> ISO-8859-1: \" + combo2);\n\n            // 组合3: GBK -> ISO-8859-1\n            String combo3 = new String(original.getBytes(\"GBK\"), StandardCharsets.ISO_8859_1);\n            System.out.println(\"GBK -> ISO-8859-1: \" + combo3);\n\n            // 组合4: UTF-8 -> UTF-8（应该正确）\n            String combo4 = new String(original.getBytes(\"UTF-8\"), \"UTF-8\");\n            System.out.println(\"UTF-8 -> UTF-8: \" + combo4);\n\n            // 尝试URL编码方式\n            System.out.println(\"\\n=== URL编码方式 ===\");\n            String urlEncoded = java.net.URLEncoder.encode(original, \"UTF-8\");\n            System.out.println(\"URL编码: \" + urlEncoded);\n\n        } catch (Exception e) {\n            e.printStackTrace();\n        }\n    }\n}","completed":false,"isEnd":false,"failed":false}
