[14217] [2026-01-21 11:17:35] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"3943e38e-76a9-42d8-85e0-d3d8847a320e","existed":true,"content":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"\nCSV导出文件名乱码问题验证脚本\n用于验证修复后的编码处理是否正确\n\"\"\"\n\ndef test_filename_encoding():\n    \"\"\"测试文件名编码处理逻辑\"\"\"\n    # 模拟Java中的原始问题代码\n    def old_method(file_name):\n        # 原问题代码：filename = new String(fileName.getBytes(), StandardCharsets.ISO_8859_1);\n        # 这个转换会导致乱码\n        import sys\n        if sys.version_info >= (3, 0):\n            return file_name.encode().decode('iso-8859-1')\n        else:\n            return file_name.decode(sys.getfilesystemencoding()).encode('iso-8859-1')\n\n    # 模拟修复后的代码\n    def new_method(file_name):\n        # 修复后代码：fileName.getBytes(\"GB2312\"), StandardCharsets.ISO_8859_1\n        import sys\n        if sys.version_info >= (3, 0):\n            return file_name.encode('gb2312').decode('iso-8859-1')\n        else:\n            return file_name.decode('gb2312').encode('iso-8859-1')\n\n    test_filename = \"付款明细_20260121110807\"\n\n    print(\"=== CSV导出文件名编码测试 ===\")\n    print(f\"原始文件名: {test_filename}\")\n\n    # 测试旧方法（有问题的）\n    try:\n        old_encoded = old_method(test_filename)\n        print(f\"旧方法编码结果: {old_encoded}\")\n        print(f\"旧方法编码正确性: {'❌ 乱码' if 'ä»' in old_encoded else '✓ 正常'}\")\n    except Exception as e:\n        print(f\"旧方法出错: {e}\")\n\n    # 测试新方法（修复后的）\n    try:\n        new_encoded = new_method(test_filename)\n        print(f\"新方法编码结果: {new_encoded}\")\n        print(f\"新方法编码正确性: {'❌ 乱码' if 'ä»' in new_encoded else '✓ 正常'}\")\n    except Exception as e:\n        print(f\"新方法出错: {e}\")\n\n    # 验证文件名后缀处理\n    test_cases = [\n        \"付款明细_20260121110807\",\n        \"付款明细_20260121110807.csv\",\n        \"付款明细_20260121110807.CSV\"\n    ]\n\n    print(\"\\n=== 文件名后缀处理测试 ===\")\n    for filename in test_cases:\n        if filename.lower().endswith('.csv'):\n            final_name = filename\n        else:\n            final_name = filename + \".csv\"\n        print(f\"输入: {filename} -> 输出: {final_name}\")\n\nif __name__ == \"__main__\":\n    test_filename_encoding()","completed":false,"isEnd":false,"failed":false}
