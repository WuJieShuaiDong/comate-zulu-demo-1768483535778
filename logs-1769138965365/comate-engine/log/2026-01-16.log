blic PageInfo<PmcFinanceCompQuotaSetDTO> selectQuotaSet(PmcFinanceCompQuotaSetQO condition);\n\n    @RequestMapping(value = \"/pmcSupplierAdm/exportQuotaSet\", method = RequestMethod.POST)\n    public List<PmcFinanceCompQuotaSetDTO> exportQuotaSet(PmcFinanceCompQuotaSetQO condition);\n\n    @RequestMapping(value = \"/pmcSupplierAdm/saveOrUpdate\", method = RequestMethod.POST)\n    ResponseMessage saveOrUpdate(PmcFinanceCompQuotaSetDTO dto);\n\n    @RequestMapping(value = \"/pmcSupplierAdm/getSupplierQuota\", method = RequestMethod.POST)\n    PageInfo<PmcFinanceSupplierQuotaSetDTO> selectSupplierQuotaSet(PmcFinanceSupplierQuotaSetQO condition);\n\n    @RequestMapping(value = \"/pmcSupplierAdm/getSupplierQuotaUse\", method = RequestMethod.POST)\n    PageInfo<SupplierFinancingUsageDTO> selectSupplierQuotaUse(SupplierFinancingUsageQO condition);\n\n    @RequestMapping(value = \"/pmcSupplierAdm/exportSupplierQuota\", method = RequestMethod.POST)\n    List<PmcFinanceSupplierQuotaSetDTO> exportSupplierQuotaSet(PmcFinanceSupplierQuotaSetQO condition);\n\n    @RequestMapping(value = \"/pmcSupplierAdm/saveOrUpdateSupplierQuota\", method = RequestMethod.POST)\n    ResponseMessage saveOrUpdateSupplierQuotaSet(PmcFinanceSupplierQuotaSetDTO dto);\n\n    @RequestMapping(value = \"/pmcSupplierAdm/selectInit\", method = RequestMethod.POST)\n    public Map<String, Object> selectInit();\n\n    @RequestMapping(value = \"/pmcSupplierAdm/selectSuggest\", method = RequestMethod.POST)\n    public List<PmcDataP2pSupplier> selectSuggest(@RequestBody PmcPortalSuggestQO parameter);\n\n    @RequestMapping(value = \"/pmcSupplierAdm/selectSuggestAccount\", method = RequestMethod.POST)\n    public PageInfo<PmcAccountDTO> getAccountViewPage(@RequestBody PmcAccountSearchQO pmcAccountSearchQO);\n    @RequestMapping(value = \"/pmcSupplierAdm/commonCheckData\", method = RequestMethod.POST)\n    ResponseMessage commonCheckData(@RequestBody PmcFinanceBankBaseQO query, @RequestParam(\"methodName\") String