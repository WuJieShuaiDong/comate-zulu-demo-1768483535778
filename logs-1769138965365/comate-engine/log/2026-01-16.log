[14297] [2026-01-17 11:30:22] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"eccaa2d3-de51-437f-bb03-bdc87331a65a","existed":true,"content":"package com.baidu.p2p.core.utils;\n\nimport java.util.concurrent.ArrayBlockingQueue;\nimport java.util.concurrent.BlockingQueue;\nimport java.util.concurrent.ExecutorService;\nimport java.util.concurrent.ThreadPoolExecutor;\n\nimport static java.util.concurrent.ThreadPoolExecutor.CallerRunsPolicy;\nimport static java.util.concurrent.TimeUnit.MINUTES;\n\n/**\n * 公用的线程池\n *\n * Created by anhuan on 16-8-23.\n */\npublic class ThreadPoolExecutorUtil {\n\n    private static ThreadPoolExecutor executor = null;\n    private static int poolSize = 20;\n    private static int queueSize = 20;\n\n    static {\n        BlockingQueue<Runnable> queue = new ArrayBlockingQueue<Runnable>(1000); // 任务队列别太大\n        executor = new ThreadPoolExecutor(poolSize, poolSize, 1, MINUTES, queue, new CallerRunsPolicy());\n        Runtime.getRuntime().addShutdownHook(new Thread() {\n\n            public void run() {\n                destroyInstance();\n            }\n        });\n    }\n\n    public static ExecutorService getExecutorService() {\n        return executor;\n    }\n\n    private static void destroyInstance() {\n        if (executor != null) {\n            executor.shutdownNow();\n        }\n    }\n\n    public static ThreadPoolExecutor createExecutorService() {\n        return createExecutorService(queueSize);\n    }\n\n    public static ThreadPoolExecutor createExecutorService(int queueSize) {\n        return createExecutorService(poolSize, queueSize);\n    }\n\n    public static ThreadPoolExecutor createExecutorService(int poolSize, int queueSize) {\n        BlockingQueue<Runnable> queue = new ArrayBlockingQueue<>(queueSize);\n        final ThreadPoolExecutor executor = new ThreadPoolExecutor(poolSize, poolSize, 1, MINUTES, queue,\n                new CallerRunsPolicy());\n        Runtime.getRuntime().addShutdownHook(new Thread() {\n            public void run() {\n                executor.shutdownNow();\n            }\n        });\n        return executor;\n    }\n}\n","completed":false,"isEnd":false,"failed":false}
