[14217] [2026-01-21 11:58:01] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"75ce9c82-b184-4764-99e0-cfac5c3884d3","existed":true,"content":"import java.io.UnsupportedEncodingException;\nimport java.nio.charset.StandardCharsets;\n\npublic class FinalCSVTest {\n\n    public static void main(String[] args) {\n        try {\n            System.out.println(\"=== CSV导出编码修复最终验证 ===\");\n\n            String originalFileName = \"付款明细_20260121110807\";\n            System.out.println(\"原始文件名: \" + originalFileName);\n\n            // 修复后的正确编码流程\n            String processedFileName = originalFileName;\n            if (!originalFileName.toLowerCase().endsWith(\".csv\")) {\n                processedFileName = originalFileName + \".csv\";\n            }\n            System.out.println(\"处理后文件名: \" + processedFileName);\n\n            // 文件名编码（GB2312 -> ISO-8859-1）\n            String encodedFileName = new String(processedFileName.getBytes(\"GB2312\"), StandardCharsets.ISO_8859_1);\n            System.out.println(\"文件名编码结果: \" + encodedFileName);\n\n            // 响应头设置\n            System.out.println(\"Content-Type: application/OCTET-STREAM;charset=gb2312\");\n            System.out.println(\"Content-Disposition: attachment;filename=\" + encodedFileName);\n            System.out.println(\"Character-Encoding: GB2312\");\n\n            // 文件内容编码（使用GB2312写入）\n            System.out.println(\"文件内容写入编码: GB2312\");\n\n            // 验证内容编码一致性\n            String testContent = \"序号,原始单据号,付款清单号\";\n            byte[] contentBytes = testContent.getBytes(\"GB2312\");\n            System.out.print(\"内容GB2312字节: \");\n            for (byte b : contentBytes) {\n                System.out.print(String.format(\"%02X \", b));\n            }\n            System.out.println();\n\n            // 浏览器解码模拟\n            System.out.println(\"\\n=== 浏览器显示验证 ===\");\n            String browserFileName = new String(encodedFileName.getBytes(StandardCharsets.ISO_8859_1), \"GB2312\");\n            System.out.println(\"浏览器显示文件名: \" + browserFileName);\n\n            // 验证文件名是否包含乱码\n            System.out.println(\"文件名乱码检测: \" +\n                (encodedFileName.contains(\"ä»\") ? \"❌ 乱码\" : \"✓ 正确\"));\n\n            System.out.println(\"\\n=== 修复总结 ===\");\n            System.out.println(\"✓ 文件名编码: GB2312 → ISO-8859-1\");\n            System.out.println(\"✓ 文件内容编码: 统一使用GB2312\");\n            System.out.println(\"✓ 响应头编码: charset=gb2312\");\n            System.out.println(\"✓ 编码一致性: 文件名和内容统一编码\");\n\n        } catch (Exception e) {\n            e.printStackTrace();\n        }\n    }\n}","completed":false,"isEnd":false,"failed":false}
