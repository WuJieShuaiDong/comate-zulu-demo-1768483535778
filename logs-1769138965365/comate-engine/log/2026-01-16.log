[14217] [2026-01-20 17:28:12] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"e0aab5c0-bb1b-46e7-9f5f-4067430a9bc0","existed":true,"content":"package com.baidu.pmc.web.utils;\n\nimport org.apache.commons.lang.StringUtils;\nimport org.apache.poi.ss.usermodel.*;\nimport org.apache.poi.xssf.streaming.SXSSFWorkbook;\nimport org.apache.poi.xssf.streaming.SXSSFSheet;\nimport org.apache.poi.xssf.streaming.SXSSFRow;\nimport org.apache.poi.xssf.streaming.SXSSFCell;\nimport org.springframework.stereotype.Component;\n\nimport javax.servlet.http.HttpServletResponse;\nimport java.io.IOException;\nimport java.io.OutputStream;\nimport java.io.UnsupportedEncodingException;\nimport java.text.SimpleDateFormat;\nimport java.util.Date;\nimport java.util.List;\nimport java.util.concurrent.atomic.AtomicInteger;\n\n/**\n * 高性能Excel导出工具类\n * 针对20000条以上大数据量导出场景优化\n *\n * 优化点：\n * 1. 使用SXSSFWorkbook（流式写入）替代XSSFWorkbook（内存模式）\n * 2. 设置合理的rowAccessWindowSize避免内存溢出\n * 3. 简化样式设置，减少对象创建\n * 4. 批量处理数据，避免频繁的样式创建\n * 5. 优化内存使用和GC性能\n *\n * @author Zulu-AI\n */\n@Component\npublic class HighPerformanceExcelUtil {\n\n    // 默认行缓存窗口大小，平衡内存和性能\n    private static final int DEFAULT_ROW_ACCESS_WINDOW_SIZE = 200;\n\n    // 简单日期格式，线程安全\n    private static final ThreadLocal<SimpleDateFormat> DATE_FORMAT =\n        ThreadLocal.withInitial(() -> new SimpleDateFormat(\"yyyy/MM/dd\"));\n\n    /**\n     * 高性能导出方法 - 支持大批量数据（2万条+）\n     *\n     * @param response HTTP响应对象\n     * @param fileName 文件名\n     * @param headers 表头数组\n     * @param dataList 数据列表，每个List<String>代表一行数据\n     */\n    public void exportLargeData(HttpServletResponse response, String fileName,\n                               String[] headers, List<List<String>> dataList) {\n        // 创建工作簿，设置窗口大小\n        SXSSFWorkbook workbook = new SXSSFWorkbook(DEFAULT_ROW_ACCESS_WINDOW_SIZE);\n\n        try {\n            // 设置响应头\n            setupResponseHeader(response, fileName);\n\n            // 创建表格\n            SXSSFSheet sheet = workbook.createSheet(\"数据导出\");\n\n            // 创建预定义样式（减少重复创建）\n            CellStyle headerStyle = createHeaderStyle(workbook);\n            CellStyle dataStyle = createDataStyle(workbook);\n\n            // 创建表头\n            createHeaderRow(sheet, headers, headerStyle);\n\n            // 批量填充数据\n            fillDataRows(sheet, dataList, dataStyle);\n\n            // 自动调整列宽（可选，大数据量时可注释掉以提高性能）\n            // autoSizeColumns(sheet, headers.length);\n\n            // 写入输出流\n            writeToStream(workbook, response.getOutputStream());\n\n        } catch (Exception e) {\n            throw new RuntimeException(\"导出Excel失败\", e);\n        } finally {\n            // 清理临时文件\n            if (workbook != null) {\n                workbook.dispose();\n            }\n        }\n    }\n\n    /**\n     * 性能更优的导出方法 - 支持自定义列宽和样式优化\n     *\n     * @param response HTTP响应对象\n     * @param fileName 文件名\n     * @param headers 表头数组\n     * @param dataList 数据列表\n     * @param columnWidths 列宽数组，可指定每列宽度\n     */\n    public void exportLargeDataWithCustomWidth(HttpServletResponse response, String fileName,\n                                             String[] headers, List<List<String>> dataList,\n                                             int[] columnWidths) {\n        SXSSFWorkbook workbook = new SXSSFWorkbook(DEFAULT_ROW_ACCESS_WINDOW_SIZE);\n\n        try {\n            setupResponseHeader(response, fileName);\n            SXSSFSheet sheet = workbook.createSheet(\"数据导出\");\n\n            CellStyle headerStyle = createHeaderStyle(workbook);\n            CellStyle dataStyle = createDataStyle(workbook);\n\n            // 设置列宽\n            if (columnWidths != null && columnWidths.length == headers.length) {\n                for (int i = 0; i < columnWidths.length; i++) {\n                    sheet.setColumnWidth(i, columnWidths[i] * 256); // POI的单位是1/256字符\n                }\n            }\n\n            createHeaderRow(sheet, headers, headerStyle);\n            fillDataRows(sheet, dataList, dataStyle);\n            writeToStream(workbook, response.getOutputStream());\n\n        } catch (Exception e) {\n            throw new RuntimeException(\"导出Excel失败\", e);\n        } finally {\n            if (workbook != null) {\n                workbook.dispose();\n            }\n        }\n    }\n\n    /**\n     * 设置HTTP响应头\n     */\n    private void setupResponseHeader(HttpServletResponse response, String fileName)\n            throws UnsupportedEncodingException {\n        // 文件名编码处理\n        String encodedFileName = new String(fileName.getBytes(), \"ISO8859-1\");\n\n        response.setContentType(\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\");\n        response.setHeader(\"Content-Disposition\", \"attachment;filename=\" + encodedFileName);\n        response.setCharacterEncoding(\"UTF-8\");\n    }\n\n    /**\n     * 创建表头样式（只创建一次，避免重复创建）\n     */\n    private CellStyle createHeaderStyle(SXSSFWorkbook workbook) {\n        CellStyle style = workbook.createCellStyle();\n        Font font = workbook.createFont();\n\n        // 设置字体\n        font.setBold(true);\n        font.setFontHeightInPoints((short) 12);\n\n        // 设置边框\n        style.setBorderTop(BorderStyle.THIN);\n        style.setBorderBottom(BorderStyle.THIN);\n        style.setBorderLeft(BorderStyle.THIN);\n        style.setBorderRight(BorderStyle.THIN);\n\n        // 设置对齐方式\n        style.setAlignment(HorizontalAlignment.CENTER);\n        style.setVerticalAlignment(VerticalAlignment.CENTER);\n        style.setFont(font);\n\n        // 设置背景色\n        style.setFillForegroundColor(IndexedColors.GREY_25_PERCENT.getIndex());\n        style.setFillPattern(FillPatternType.SOLID_FOREGROUND);\n\n        return style;\n    }\n\n    /**\n     * 创建数据样式（简化样式，提高性能）\n     */\n    private CellStyle createDataStyle(SXSSFWorkbook workbook) {\n        CellStyle style = workbook.createCellStyle();\n\n        // 简化样式设置，只设置必要的边框\n        style.setBorderTop(BorderStyle.THIN);\n        style.setBorderBottom(BorderStyle.THIN);\n        style.setBorderLeft(BorderStyle.THIN);\n        style.setBorderRight(BorderStyle.THIN);\n\n        // 垂直居中\n        style.setVerticalAlignment(VerticalAlignment.CENTER);\n\n        return style;\n    }\n\n    /**\n     * 创建表头行\n     */\n    private void createHeaderRow(SXSSFSheet sheet, String[] headers, CellStyle headerStyle) {\n        SXSSFRow headerRow = sheet.createRow(0);\n\n        for (int i = 0; i < headers.length; i++) {\n            SXSSFCell cell = headerRow.createCell(i);\n            cell.setCellValue(headers[i]);\n            cell.setCellStyle(headerStyle);\n        }\n    }\n\n    /**\n     * 批量填充数据行（优化内存使用）\n     */\n    private void fillDataRows(SXSSFSheet sheet, List<List<String>> dataList, CellStyle dataStyle) {\n        AtomicInteger rowIndex = new AtomicInteger(1); // 从第2行开始（跳过表头）\n\n        // 批量处理数据，避免频繁的样式操作\n        dataList.forEach(rowData -> {\n            SXSSFRow row = sheet.createRow(rowIndex.getAndIncrement());\n\n            for (int colIndex = 0; colIndex < rowData.size(); colIndex++) {\n                String value = rowData.get(colIndex);\n                SXSSFCell cell = row.createCell(colIndex);\n\n                if (StringUtils.isNotBlank(value)) {\n                    // 智能处理数据类型\n                    setCellValueSmart(cell, value);\n                }\n\n                // 应用样式\n                cell.setCellStyle(dataStyle);\n            }\n        });\n    }\n\n    /**\n     * 智能设置单元格值（根据数据类型优化）\n     */\n    private void setCellValueSmart(SXSSFCell cell, String value) {\n        // 尝试解析为数字\n        if (isNumeric(value)) {\n            try {\n                cell.setCellValue(Double.parseDouble(value));\n                return;\n            } catch (NumberFormatException e) {\n                // 如果解析失败，当做字符串处理\n            }\n        }\n\n        // 尝试解析为日期\n        if (isDate(value)) {\n            try {\n                Date date = DATE_FORMAT.get().parse(value);\n                cell.setCellValue(date);\n                return;\n            } catch (Exception e) {\n                // 如果解析失败，当做字符串处理\n            }\n        }\n\n        // 默认作为字符串处理\n        cell.setCellValue(value);\n    }\n\n    /**\n     * 判断是否为数字\n     */\n    private boolean isNumeric(String str) {\n        if (str == null || str.length() == 0) {\n            return false;\n        }\n        return str.matches(\"^-?\\\\d+(\\\\.\\\\d+)?$\");\n    }\n\n    /**\n     * 判断是否为日期（简化判断）\n     */\n    private boolean isDate(String str) {\n        if (str == null || str.length() != 10) {\n            return false;\n        }\n        return str.matches(\"\\\\d{4}/\\\\d{2}/\\\\d{2}\");\n    }\n\n    /**\n     * 自动调整列宽（大数据量时慎用）\n     */\n    private void autoSizeColumns(SXSSFSheet sheet, int columnCount) {\n        for (int i = 0; i < columnCount; i++) {\n            sheet.trackColumnForAutoSizing(i);\n            sheet.autoSizeColumn(i);\n        }\n    }\n\n    /**\n     * 写入输出流\n     */\n    private void writeToStream(SXSSFWorkbook workbook, OutputStream outputStream)\n            throws IOException {\n        try {\n            workbook.write(outputStream);\n            outputStream.flush();\n        } finally {\n            if (outputStream != null) {\n                try {\n                    outputStream.close();\n                } catch (IOException e) {\n                    // 忽略关闭异常\n                }\n            }\n        }\n    }\n\n    /**\n     * 获取性能统计信息（用于性能监控）\n     */\n    public String getPerformanceInfo(List<List<String>> dataList) {\n        int rowCount = dataList != null ? dataList.size() : 0;\n        int cellCount = 0;\n\n        if (dataList != null && !dataList.isEmpty()) {\n            cellCount = dataList.get(0).size();\n        }\n\n        return String.format(\"导出数据统计: %d行 × %d列 = %d个单元格\",\n                           rowCount, cellCount, rowCount * cellCount);\n    }\n}","completed":false,"isEnd":false,"failed":false}
