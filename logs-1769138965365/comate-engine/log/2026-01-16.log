[14217] [2026-01-19 17:13:12] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"cbd87120-10b2-4588-8002-c9b406488e37","existed":true,"content":"/*\n * Copyright (C) 2018 Baidu, Inc. All Rights Reserved.\n */\npackage com.baidu.pmc.core.controller;\n\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.http.HttpStatus;\nimport org.springframework.http.ResponseEntity;\nimport org.springframework.validation.BindingResult;\nimport org.springframework.validation.annotation.Validated;\nimport org.springframework.web.bind.annotation.PostMapping;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.RestController;\n\nimport com.baidu.pmc.common.ResponseMessage;\nimport com.baidu.pmc.common.exception.ServiceException;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.core.service.PayChecksService;\nimport com.baidu.pmc.core.service.PaySelectInitComponent;\nimport com.baidu.pmc.core.service.PayStatusManager;\nimport com.baidu.pmc.pojo.constants.PayNode;\nimport com.baidu.pmc.pojo.constants.PayOperation;\nimport com.baidu.pmc.pojo.dto.PayCheckIdsDTO;\nimport com.baidu.pmc.pojo.dto.PayChecksDTO;\nimport com.baidu.pmc.pojo.dto.SelectDTO;\nimport com.baidu.pmc.pojo.qo.PayChecksQO;\nimport com.github.pagehelper.PageInfo;\n\nimport lombok.extern.slf4j.Slf4j;\n\n/**\n * 余额不足导致付款失败控制器\n */\n@RestController\n@Slf4j\n@RequestMapping(\"/pay_failed_balance\")\npublic class PayFailedBalanceController {\n\n    @Autowired\n    private PayChecksService payChecksService;\n    @Autowired\n    private PaySelectInitComponent paySelectInitComponent;\n    @Autowired\n    private PayStatusManager payStatusManager;\n\n    /**\n     * 余额不足付款失败列表\n     *\n     * @param qo\n     *\n     * @return\n     */\n    @PostMapping(\"/list\")\n    public ResponseEntity<PageInfo<PayChecksDTO>> failedBalanceList(@RequestBody PayChecksQO qo) {\n        qo.setStatus(payStatusManager.getDefaultSingleStatus(PayOperation.SENDING_BANK_AGAIN));\n        PageInfo<PayChecksDTO> pageInfo = payChecksService.selectPayChecksWithPermission(qo);\n        return new ResponseEntity<PageInfo<PayChecksDTO>>(pageInfo, HttpStatus.OK);\n    }\n\n    /**\n     * 余额不足再次发送银行\n     *\n     * @param ids\n     *\n     * @return\n     */\n    @PostMapping(\"/send_again\")\n    public ResponseEntity<ResponseMessage> sendBankAgain(@RequestBody @Validated PayCheckIdsDTO ids,\n                                                         BindingResult result) {\n        if (result.hasErrors()) {\n            return new ResponseEntity<ResponseMessage>(ResponseMessage.fail(result.getAllErrors().toString()),\n                    HttpStatus.OK);\n        }\n        try {\n            String sendResult = payChecksService\n                    .statusToPendingSent(ids, PayNode.PAY_OVERDRAFT_FAIL, PayOperation.SENDING_BANK_AGAIN);\n            if (StringUtils.isBlank(sendResult)) {\n                return new ResponseEntity<ResponseMessage>(ResponseMessage.success(\"操作成功！\"), HttpStatus.OK);\n            } else {\n                return new ResponseEntity<ResponseMessage>(ResponseMessage.fail(sendResult), HttpStatus.OK);\n            }\n        } catch (ServiceException e) {\n            return new ResponseEntity<ResponseMessage>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 余额不足付款失败列表中下拉列表初始化\n     *\n     * @return\n     */\n    @PostMapping(\"/select_init\")\n    public ResponseEntity<Map<String, List<SelectDTO>>> failedBalanceSelectInit() {\n        Map<String, List<SelectDTO>> map = new HashMap<String, List<SelectDTO>>();\n        map.put(\"accountPool\", paySelectInitComponent.getAccountPool());\n        // transactionType\n        map.put(\"transactionType\", paySelectInitComponent.getTransactionType());\n        return new ResponseEntity<Map<String, List<SelectDTO>>>(map, HttpStatus.OK);\n    }\n}\n","completed":false,"isEnd":false,"failed":false}
