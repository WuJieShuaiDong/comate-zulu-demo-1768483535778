[97017] [2026-01-12 16:41:52] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"7daec46b-10a7-48a1-a742-29fd7f813448","existed":true,"absolutePath":"/Users/xiaoliu/baidu/bpit-proc-apps/pmc/pmc-basic-bankcommon/src/main/java/com/baidu/pmc/bankcommon/core/service/bcm/BankBcmReceiptService.java","content":"package com.baidu.pmc.bankcommon.core.service.bcm;\n\nimport com.baidu.pmc.pojo.model.cmb.PayQO;\n\nimport java.util.Map;\n\n/**\n * 电子回单相关服务\n *\n * @author liuyanzhong\n */\npublic interface BankBcmReceiptService {\n\n\n    /**\n     * 回单任务\n     *\n     * @param payQO\n     * @param extentionParams 扩展参数\n     * @return\n     */\n    String selectElectReceipt(PayQO payQO, Map<String, String> extentionParams);\n\n\n}","scheme":"file","completed":false,"isEnd":false,"failed":false}
