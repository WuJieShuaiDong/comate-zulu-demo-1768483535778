[97017] [2026-01-12 16:40:09] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"49132526-0b90-4bde-8b81-c077be08a990","existed":true,"content":"package com.baidu.pmc.bankcommon.core.service.spdb;\n\nimport com.baidu.pmc.pojo.model.cmb.PayQO;\n\nimport java.util.Map;\n\n/**\n * 电子回单相关服务\n *\n * @author liuyanzhong\n */\npublic interface BankSpdbReceiptService {\n\n\n    /**\n     * 回单任务\n     *\n     * @param payQO\n     * @return\n     */\n    String selectElectReceipt(PayQO payQO, Map<String, String> extentionParams);\n\n\n}\n","completed":false,"isEnd":false,"failed":false}
