[62338] [2026-01-21 16:23:07] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"bce995c1-5baa-4699-9e06-2d4027ac46d5","existed":true,"content":"import java.io.*;\nimport java.text.SimpleDateFormat;\nimport java.util.*;\n\npublic class GBKEncodingTest {\n\n    public static void main(String[] args) {\n        try {\n            System.out.println(\"=== GBK编码方案验证测试 ===\");\n            System.out.println(\"针对实际部署出现的乱码问题测试\\n\");\n\n            // 模拟您提到的乱码情况\n            String testText = \"招商银行\";\n            System.out.println(\"原始中文: \" + testText);\n\n            // 验证GBK vs UTF-8的区别\n            byte[] gbkBytes = testText.getBytes(\"GBK\");\n            byte[] utf8Bytes = testText.getBytes(\"UTF-8\");\n\n            System.out.println(\"GBK编码字节: \" + Arrays.toString(gbkBytes));\n            System.out.println(\"UTF-8编码字节: \" + Arrays.toString(utf8Bytes));\n\n            // 模拟乱码：UTF-8字节被误认为是GBK\n            String wrongDecoding = new String(gbkBytes, \"UTF-8\");\n            System.out.println(\"GBK字节被误认为UTF-8: \" + wrongDecoding);\n\n            // 正确的GBK解码\n            String correctDecoding = new String(gbkBytes, \"GBK\");\n            System.out.println(\"GBK字节正确解码: \" + correctDecoding);\n\n            // 生成测试CSV文件（使用GBK编码）\n            String fileName = \"付款明细_\" + new SimpleDateFormat(\"yyyyMMddHHmmss\").format(new Date()) + \".csv\";\n            String encodedFileName = new String(fileName.getBytes(\"UTF-8\"), \"ISO-8859-1\");\n\n            System.out.println(\"\\n=== 响应头设置 ===\");\n            System.out.println(\"文件名: \" + fileName);\n            System.out.println(\"编码后文件名: \" + encodedFileName);\n            System.out.println(\"Content-Type: application/OCTET-STREAM;charset=gbk\");\n            System.out.println(\"Content-Disposition: attachment;filename=\" + encodedFileName);\n            System.out.println(\"Character-Encoding: GBK\");\n\n            // 生成测试文件\n            String csvFilePath = generateGBKCSV(fileName);\n\n            System.out.println(\"\\n=== 生成的文件验证 ===\");\n            File file = new File(csvFilePath);\n            System.out.println(\"文件大小: \" + file.length() + \" 字节\");\n\n            // 使用UTF-8读取（模拟乱码情况）\n            System.out.println(\"用UTF-8读取GBK文件（模拟乱码）:\");\n            readFileWithEncoding(csvFilePath, \"UTF-8\");\n\n            // 使用GBK读取（正确解码）\n            System.out.println(\"用GBK读取GBK文件（正确显示）: \");\n            readFileWithEncoding(csvFilePath, \"GBK\");\n\n            // 验证编码\n            Process process = Runtime.getRuntime().exec(new String[]{\"file\", \"-I\", csvFilePath});\n            BufferedReader br = new BufferedReader(new InputStreamReader(process.getInputStream()));\n            String encodingInfo;\n            while ((encodingInfo = br.readLine()) != null) {\n                System.out.println(\"文件编码信息: \" + encodingInfo);\n            }\n\n        } catch (Exception e) {\n            e.printStackTrace();\n        }\n    }\n\n    private static String generateGBKCSV(String fileName) throws IOException {\n        String[] headers = {\"序号\", \"付款银行\", \"付款主体\", \"金额\"};\n        List<List<String>> dataList = new ArrayList<>();\n\n        String[] banks = {\"招商银行\", \"工商银行\", \"建设银行\", \"中国银行\"};\n        String[] companies = {\"百度科技有限公司\", \"百度在线网络技术\", \"百度云计算\"};\n\n        Random random = new Random();\n        for (int i = 1; i <= 5; i++) {\n            List<String> row = new ArrayList<>();\n            row.add(String.valueOf(i));\n            row.add(banks[random.nextInt(banks.length)]);\n            row.add(companies[random.nextInt(companies.length)]);\n            row.add(String.format(\"%.2f\", 1000 + random.nextDouble() * 100000));\n            dataList.add(row);\n        }\n\n        // 使用GBK编码写入\n        try (BufferedWriter writer = new BufferedWriter(\n                new OutputStreamWriter(new FileOutputStream(fileName), \"GBK\"))) {\n\n            // 写入表头\n            writer.write(String.join(\",\", headers));\n            writer.write(\"\\r\\n\");\n\n            // 写入数据\n            for (List<String> row : dataList) {\n                writer.write(String.join(\",\", row));\n                writer.write(\"\\r\\n\");\n            }\n        }\n\n        return fileName;\n    }\n\n    private static void readFileWithEncoding(String filePath, String encoding) {\n        try (BufferedReader reader = new BufferedReader(\n                new InputStreamReader(new FileInputStream(filePath), encoding))) {\n            String line;\n            int count = 0;\n            while ((line = reader.readLine()) != null && count < 3) {\n                System.out.println(\"  \" + line);\n                count++;\n            }\n        } catch (Exception e) {\n            System.out.println(\"  \" + encoding + \"读取异常: \" + e.getMessage());\n        }\n    }\n}","completed":false,"isEnd":false,"failed":false}
