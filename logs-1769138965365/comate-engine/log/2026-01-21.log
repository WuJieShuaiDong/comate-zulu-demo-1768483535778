[62338] [2026-01-21 15:17:41] [INFO] [ENGINE]  ---------> ENGINE REC: VIRTUAL_EDITOR_EVENT {"uuid":"eb53a792-ef60-4b76-b132-efbdfe881af0","existed":true,"content":"import java.io.UnsupportedEncodingException;\nimport java.nio.charset.StandardCharsets;\n\npublic class TestFileNameEncoding {\n\n    public static void main(String[] args) {\n        try {\n            System.out.println(\"=== 文件名编码修复验证 ===\");\n\n            String originalFileName = \"付款明细_20260121151348\";\n            System.out.println(\"原始文件名: \" + originalFileName);\n\n            // 修复前的错误方式（导致下划线）\n            System.out.println(\"1. 直接使用中文文件名（修复前尝试）:\");\n            System.out.println(\"   Content-Disposition: attachment;filename=\" + originalFileName + \".csv\");\n            System.out.println(\"   问题: 某些环境会显示为 _____20260121151348.csv\");\n\n            // 修复后的正确方式\n            System.out.println(\"\\n2. 使用UTF-8 → ISO-8859-1编码（修复后）:\");\n            String encodedFileName = new String(originalFileName.getBytes(\"UTF-8\"), StandardCharsets.ISO_8859_1);\n            System.out.println(\"   编码后文件名: \" + encodedFileName);\n            System.out.println(\"   Content-Disposition: attachment;filename=\" + encodedFileName);\n\n            // 浏览器解码验证\n            String browserDecoded = new String(encodedFileName.getBytes(StandardCharsets.ISO_8859_1), \"UTF-8\");\n            System.out.println(\"   浏览器解码显示: \" + browserDecoded);\n\n            // 测试完整流程\n            System.out.println(\"\\n3. 完整文件名处理流程:\");\n            String processedFileName = originalFileName;\n            if (!processedFileName.toLowerCase().endsWith(\".csv\")) {\n                processedFileName = processedFileName + \".csv\";\n            }\n            String finalEncoded = new String(processedFileName.getBytes(\"UTF-8\"), StandardCharsets.ISO_8859_1);\n\n            System.out.println(\"   处理后文件名: \" + processedFileName);\n            System.out.println(\"   最终编码文件名: \" + finalEncoded);\n            System.out.println(\"   完整响应头:\");\n            System.out.println(\"   Content-Type: application/OCTET-STREAM;charset=utf-8\");\n            System.out.println(\"   Content-Disposition: attachment;filename=\" + finalEncoded);\n            System.out.println(\"   Character-Encoding: UTF-8\");\n\n            // 验证修复效果\n            System.out.println(\"\\n4. 修复效果验证:\");\n            boolean containsUnderscores = browserDecoded.contains(\"_____\");\n            boolean containsChinese = browserDecoded.contains(\"付款明细\");\n\n            System.out.println(\"   包含下划线问题: \" + (containsUnderscores ? \"❌ 未修复\" : \"✓ 已修复\"));\n            System.out.println(\"   中文显示正常: \" + (containsChinese ? \"✓ 正常\" : \"❌ 不正常\"));\n\n            System.out.println(\"\\n5. 最终效果:\");\n            System.out.println(\"   下载文件名应该显示为: 付款明细_20260121151348.csv\");\n            System.out.println(\"   不会再出现: _____20260121151348.csv\");\n\n        } catch (Exception e) {\n            e.printStackTrace();\n        }\n    }\n}","completed":false,"isEnd":false,"failed":false}
