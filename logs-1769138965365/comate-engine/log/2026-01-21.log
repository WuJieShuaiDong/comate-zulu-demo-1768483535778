ath());\n\n                // 显示文件内容预览\n                System.out.println(\"\\n=== 生成的文件内容预览（前5行）===\");\n                try (BufferedReader reader = new BufferedReader(\n                        new InputStreamReader(new FileInputStream(fileName), \"UTF-8\"))) {\n                    String line;\n                    int count = 0;\n                    while ((line = reader.readLine()) != null && count < 5) {\n                        System.out.println(line);\n                        count++;\n                    }\n                }\n\n                // 检查文件编码\n                System.out.println(\"\\n=== 文件编码验证 ===\");\n                Process process = Runtime.getRuntime().exec(new String[]{\"file\", \"-I\", fileName});\n                BufferedReader br = new BufferedReader(new InputStreamReader(process.getInputStream()));\n                String encodingInfo;\n                while ((encodingInfo = br.readLine()) != null) {\n                    System.out.println(\"文件编码信息: \" + encodingInfo);\n                }\n\n            } catch (Exception e) {\n                System.err.println(\"生成文件失败: \" + e.getMessage());\n                e.printStackTrace();\n            }\n        }\n\n        private static void writeCsvLine(BufferedWriter writer, String[] values) throws IOException {\n            if (values == null || values.length == 0) {\n                writer.write(\"\\r\\n\");\n                return;\n            }\n\n            StringBuilder line = new StringBuilder();\n            for (int i = 0; i < values.length; i++) {\n                if (i > 0) {\n                    line.append(\",\");\n                }\n                line.append(values[i]);\n            }\n            line.append(\"\\r\\n\");\n            writer.write(line.toString());\n        }\n    }\n\n    /**\n     * 生成测试数据\n     */\n    private static List<List<String>> generateTestData() {\n        List<List<String>> dataList = new ArrayList<>();\n        Random random = new Random();\n\n        String[] companies = {\"百度科技有限公司\", \"百度在线网络技术\", \"百度云计算\", \"百度网讯科技\"};\n        String[] banks = {\"招商银行\", \"工商银行\", \"建设银行\", \"中国银行\"};\n\n        for (int i = 1; i <= 10; i++) {\n            List<String> row = new ArrayList<>();\n            row.add(String.valueOf(i));  // 序号\n            row.add(\"SRC\" + (10000 + i));  // 原始单据号\n            row.add(companies[random.nextInt(companies.length)]);  // 付款主体（中文）\n            row.add(banks[random.nextInt(banks.length)]);  // 付款银行（中文）\n            row.add(String.format(\"%.2f\", 1000 + random.nextDouble() * 10000));  // 金额\n            dataList.add(row);\n        }\n\n        return dataList;\n    }\n\n    public static void main(String[] args) {\n        try {\n            System.out.println(\"=== 实际CSV文件生成测试 ===\");\n            System.out.println(\"模拟CsvExportUtil修复后的实际效果\\n\");\n\n            // 准备测试数据\n            String[] headers = {\"序号\", \"原始单据号\", \"付款主体\", \"付款银行\", \"金额\"};\n            List<List<String>> testData = generateTestData();\n\n            // 测试文件名（包含中文）\n            String fileName = \"付款明细_实际测试_\" + new SimpleDateFormat(\"yyyyMMddHHmmss\").format(new Date());\n\n            System.out.println(\"原始文件名: \" + fileName);\n            System.out.println(\"数据行数: \" + testData.size());\n            System.out.println();\n\n            // 实际生成文件\n            CsvGenerator.generateCsvFile(fileName, headers, testData);\n\n            System.out.println(\"\\n=== 验证结果 ===\");\n            System.out.println(\"请检查生成的文件:\");\n            System.out.println(\"1. 文件名是否包含中文且正常显示\");\n            System.out.println(\"2. 文件内容中文字符是否正常\");\n            System.out.println(\"3. 编码是否为UTF-8\");\n\n        } catch (Exception e) {\n            System.err.println(\"测试异常: \" + e.getMessage());\n            e.printStackTrace();\n        }\n    }\n}","completed":false,"isEnd":false,"failed":false}
