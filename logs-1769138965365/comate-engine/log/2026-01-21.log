import akshare as ak
import sys

# 测试1: 买卖五档
print("=== 测试1: stock_bid_ask_em ===")
try:
    df = ak.stock_bid_ask_em(symbol="688115")
    print(f"返回类型: {type(df)}")
    print(f"列名: {list(df.columns) if not df.empty else '空DataFrame'}")
    print(df.head(3))
except Exception as e:
    print(f"失败: {e}")

print("\n=== 测试2: stock_zh_a_hist (今日) ===")
try:
    import datetime
    today = datetime.date.today().strftime("%Y%m%d")
    df = ak.stock_zh_a_hist(symbol="688115", period="daily", start_date=today, end_date=today, adjust="")
    print(f"数据行数: {len(df)}")
    if not df.empty:
        print(df[['日期', '收盘']].tail(1))
except Exception as e:
    print(f"失败: {e}")

print("\n=== 测试3: HTTP 直连东财 ===")
try:
    import requests
    url = "http://push2.eastmoney.com/api/qt/ulist/get"
    params = {"fltt": "2", "secids": "1.688115,0.603633", "fields": "f12,f14,f2", "pn": "1", "pz": "10"}
    resp = requests.get(url, params=params, timeout=5)
    print(f"状态码: {resp.status_code}")
    print(resp.json())
except Exception as e:
    print(f"失败: {e}")
