llectionUtils.isEmpty(pmcAccounts)) {\n                log.info(\"没有启用中的银行账户\");\n                return \"没有启用中的银行账户\";\n            }\n            log.info(\"待查询的银行账户数量 size={}\", pmcAccounts.size());\n\n            // 日期设置\n            List<String> dateList = new ArrayList<>();\n            if (payQO.getStartDate() != null && payQO.getEndDate() != null) {\n                dateList.addAll(DateUtils.dateBetweenDay(payQO.getStartDate(), payQO.getEndDate(),\n                        DateTool.DAY_PARTTEN_YYYYMMDD));\n            } else {\n                // 默认查询最近两天数据\n                dateList.add(DateUtils.formatDate(DateUtils.addDays(new Date(), -2),\n                        DateTool.DAY_PARTTEN_YYYYMMDD));\n                dateList.add(DateUtils.formatDate(DateUtils.yesterday(), DateTool.DAY_PARTTEN_YYYYMMDD));\n            }\n\n            if (CollectionUtils.isEmpty(dateList)) {\n                log.info(\"没有符合的退票拉取时间段\");\n                return \"没有符合的退票拉取时间段\";\n            }\n            // 退票按照日期查询，查询所有账户的退票记录\n            for (PmcAccount account : pmcAccounts) {\n                for (String date : dateList) {\n                    try {\n                        Map<String, Object> dto = new HashMap<>();\n                        dto.put(\"bankCode\", bankCode);\n                        dto.put(\"account\", account.getAccountNo());\n                        dto.put(\"beginDate\", date);\n                        dto.put(\"endDate\", date);\n                        log.info(\"selectBankcommonRefund 查询退票任务, date={}, accountNo={}\", date, account.getAccountNo());\n                        List<RefundInfo> refundInfoList = homeReufndDeal(dto, extentionParams);\n                        if (CollectionUtils.isNotEmpty(refundInfoList)){\n                            for (RefundInfo refundInfo : refundInfoList) {\n                                refundInfo.setAccount(account.getAccountNo());\n                                dealRefundInfo(refundInfo, bankCode);\n           