onPayInstructService;\n    //  @Autowired\n    //    private BankcommonPayInstructMapper bankcommonPayInstructMapper;\n    @Autowired\n    private BankCommonPayInstructInterService bankCommonPayInstructInterService;\n    @Autowired\n    private PayChecksWriteBackService payChecksWriteBackService;\n    @Autowired\n    private PayChecksService payChecksService;\n    @Autowired\n    private PayChecksHisService payChecksHisService;\n    @Autowired\n    private OperateByJDBC operateByJDBC;\n\n    @Autowired\n    private MessageBuilder messageBuilder;\n\n    @Autowired\n    private ResponseXmlParser responseXmlParser;\n\n    @Autowired\n    private PmcPayCommonBankColSetMapper pmcPayCommonBankColSetMapper;\n\n    @Autowired\n    private PmcPayCommonBankColSetService pmcPayCommonBankColSetService;\n\n    @Autowired\n    private PmcPayCommonBankSetMapper pmcPayCommonBankSetMapper;\n\n    /**\n     * 流水接口分页循环最大次数，防止while死循环\n     */\n    private static final int TRANS_REQUEST_NUM = 999;\n\n    /**\n     * 支付接口\n     */\n    @Override\n    public int bankcommonDirectBankPay(String bankCode, Map<String, String> extentionParams) {\n\n        RedisLock redisLock = null;\n        int count = 0;\n        try {\n            redisLock = new RedisLock(\"bankcommonDirectBankPay\");\n            if (!redisLock.lock(REDIS_LOCK_TIMEOUT, REDIS_LOCK_EXPIRE)) {\n                log.info(\"===========银行支付任务执行中，请稍后再试===========\");\n                throw new ServiceException(\"银行支付任务执行中，请稍后再试\");\n            }\n            List<String> status = new ArrayList<>();\n            status.add(PayStatus.PAY_ORDER_GEN.name());\n            status.add(PayStatus.ORDER_FAILED.name());\n            BankcommonPayInstructQO bankcommonPayInstructQO = new BankcommonPayInstructQO();\n            bankcommonPayInstructQO.setStatusList(status);\n            List<Map<String, Object>> payInstructs = bankCommonPayInstructInterService.selectMapByCondition(bankcommonPayInstructQO, bankCode);\n\n            if (CollectionUtils.isEmpty(payInstructs)) {\n                log.info(\"没有待支付的付款指令 bankcommonDirectBankPay resultSize={}\", 0);\n                return 0;\n            }\n            // 指令信息改为发送中\n            payInstructs.forEach(detail -> detail.put(\"status\", PayStatus.ORDER_SEND.name()));\n            // 批量更新指令 并插入历史记录表\n            this.batchUpdateBankcommonInstructAndHis(payInstructs);\n\n            // 支付\n            List<Map<String, Object>> dtoList = this.batchPay(payInstructs, extentionParams);\n            count = dtoList.size();\n        } finally {\n            if (null != redisLock) {\n                redisLock.unlock();\n            }\n        }\n        return count;\n    }\n\n    /**\n     * 查询支付结果\n     *\n     * @param instructs: 需要查询的指令集合\n     * @return 返回对应的Map<String, Object>对象集合\n     */\n    @Override\n    public List<Map<String, Object>> queryPayResult(List<Map<String, Object>> instructs, String bankCode, Map<String, String> extentionParams) {\n        List<Map<String, Object>> dtoList = new ArrayList<>();\n\n        for (Map<String, Object> payInstruct : instructs) {\n            Map<String, Object> dto = new HashMap<String, Object>(payInstruct);\n            dto.put(\"bankCode\", bankCode);\n            // 组装支付结果查询报文\n            String request = messageBuilder.queryPayStatusMessage(dto, extentionParams);\n\n            // 发送银行前置机\n            String response = this.postMACHINE(request, StringUtils.toString(dto.get(\"account\")), WkContextHolder.getTenantId(), null, bankCode);\n            if (Constants.NO_ENABLED_MACHINE.equals(response) || Constants.BANK_POST_EXCEPTION.equals(response)) {\n                log.error(\"付款结果查询时 无可用前置机异常 或网络错误\");\n                continue;\n            }\n            dto.put(\"funName\", Constants.BankcommonTranscodeEnum.PAY_STATUS);\n            ResponseHeaderDTO resDto = responseXmlParser.parseResponseXml(response, dto);\n            if (resDto == null || resDto.getHeader() == null) {\n                log.error(\"付款结果查询时 银行反馈结果为空\");\n            } else if (!Constants.RESPONSE_SUCCESS.equals(resDto.getHeader().getStatus())) {\n                log.error(\"付款结果查询时 银行反馈结果 relCode={}, resMeg={}\",\n                        resDto.getHeader().getStatus(), resDto.getHeader().getStatusText());\n            } else if (resDto.getBody() == null) {\n                log.error(\"付款结果查询时 银行反馈成功，子节点为空\");\n            } else {\n                this.dealBackStatus(dto, resDto);\n            }\n            dtoList.add(dto);\n        }\n        return dtoList;\n    }\n\n    /**\n     * 处理状态反馈的数据结果\n     */\n    private void dealBackStatus(Map<String, Object> dto, ResponseHeaderDTO resDto) {\n        List<Map<String, Object>> successBackDto = new ArrayList<>();\n        log.info(\"dealBackStatus dto={}\", JSON.toJSONString(dto));\n        String status = null;\n        ResponseHeaderDTO.SystemHeadBean header = resDto.getHeader();\n        if (!Constants.RESPONSE_SUCCESS.equals(header.getStatus())) {\n            log.error(\"付款结果查询时 银行反馈结果 relCode={}, resMeg={}\",\n                    resDto.getHeader().getStatus(), resDto.getHeader().getStatusText());\n            return;\n        }\n        ResponseBodyDTO bodyDTO = resDto.getBody();\n        switch (bodyDTO.getStatus()) {\n            case Constants.PAY_SUCCESS:\n                status = PayStatus.PAYED.name();\n                break;\n            case Constants.PAY_FAILED:\n                status = PayStatus.FAILED.name();\n                if (StringUtils.isNotBlank(bodyDTO.getStatusText()) &&\n                        bodyDTO.getStatusText().contains(\"余额不足\")) {\n                    status = PayStatus.FAILED_BALANCE.name();\n                }\n                dto.put(\"relCode\", header.getStatus());\n                dto.put(\"relMessage\", header.getStatusText());\n                dto.put(\"processCode\", bodyDTO.getStatus());\n                dto.put(\"processMessage\", bodyDTO.getStatusText());\n                break;\n            case Constants.PAY_PROCESSING:\n                status = PayStatus.BANK_PROCESSING.name();\n                break;\n            default:\n                // 将银行返回信息记录给前端\n                status = PayStatus.ORDER_UNKNOW.name();\n                dto.put(\"relCode\", header.getStatus());\n                dto.put(\"relMessage\", header.getStatusText());\n                dto.put(\"processCode\", bodyDTO.getStatus());\n                dto.put(\"processMessage\", bodyDTO.getStatusText());\n                break;\n        }\n        log.info(\"dealBackStatus final status is status={}\", status);\n        if (StringUtils.isNotBlank(status)) {\n            this.updateInstructAndHis(dto, status,\n                    header.getStatus(), header.getStatusText(),\n                    bodyDTO.getStatus(), bodyDTO.getStatusText(), null);\n            successBackDto.add(dto);\n        }\n        this.batchPayChecksDeal(successBackDto);\n    }\n\n    @Override\n    public List<TransInfo> selectBankcommonTrans(PayQO payQO, Map<String, String> extentionParams) {\n        List<TransInfo> result = new ArrayList<>();\n        PmcAccount account = accountService.queryBankcommonAccountByAccountNo(payQO);\n        if (account == null || payQO.getStartDate() == null || payQO.getEndDate() == null) {\n            return result;\n        }\n\n        Map<String, Object> dto = new HashMap<String, Object>();\n        dto.put(\"tenantId\", account.getTenantId());\n        dto.put(\"account\", account.getAccountNo());\n        dto.put(\"bankCode\", account.getBank());\n\n        dto.put(\"beginDate\", DateUtils.formatDate(payQO.getStartDate(), DateTool.DAY_PARTTEN_YYYYMMDD));\n        dto.put(\"endDate\", DateUtils.formatDate(payQO.getEndDate(), DateTool.DAY_PARTTEN_YYYYMMDD));\n        this.homeTransactionsDeal(dto, extentionParams);\n\n        if (CollectionUtils.isNotEmpty((List<TransInfo>) dto.get(\"transInfoList\"))) {\n            String company = operateByJDBC.translate(BD_COMPANY, account.getCompanyCode());\n            for (TransInfo trans : (List<TransInfo>) dto.get(\"transInfoList\")) {\n                trans.setBankAccount(account.getAccountNo());\n                trans.setCompanyName(company);\n                trans.setCurrencyName(operateByJDBC.translate(CURRENCY, trans.getCurrency()));\n                result.add(trans);\n            }\n        }\n\n        return result;\n    }\n\n    /**\n     * 调起银行流水接口\n     */\n    private void homeTransactionsDeal(Map<String, Object> dto, Map<String, String> extentionParams) {\n        try {\n            Integer pageSize = 20;\n            Example examplePageSize = new Example(PmcPayCommonBankColSet.class);\n            examplePageSize.createCriteria().\n                    andEqualTo(\"bankCode\", dto.get(\"bankCode\"))\n                    .andEqualTo(\"interfaceType\", dto.get(\"interfaceType\"))\n                    .andEqualTo(\"interfaceDirection\", Constants.BankcommonInterfaceDirectionEnum.REQUEST)\n                    .andEqualTo(\"columnCode\", Constants.BankcommonColumnCodeEnum.DEFAULT_PAGE_SIZE)\n                    .andEqualTo(\"enableFlag\", Constants.ENABLED_Y);\n            List<PmcPayCommonBankColSet> pmcPayCommonBankColSetsPageSize = pmcPayCommonBankColSetMapper.selectByExample(examplePageSize);\n            if (CollectionUtils.isNotEmpty(pmcPayCommonBankColSetsPageSize)) {\n                pageSize = Integer.parseInt(pmcPayCommonBankColSetsPageSize.get(0).getMappingBankCol());\n            }\n            dto.put(\"pageSize\", pageSize);\n            Integer startPageNo = 0;\n            Example examplePageNo = new Example(PmcPayCommonBankColSet.class);\n            examplePageNo.createCriteria().\n                    andEqualTo(\"bankCode\", dto.get(\"bankCode\"))\n                    .andEqualTo(\"interfaceType\", dto.get(\"interfaceType\"))\n                    .andEqualTo(\"interfaceDirection\", Constants.BankcommonInterfaceDirectionEnum.REQUEST)\n                    .andEqualTo(\"columnCode\", Constants.BankcommonColumnCodeEnum.FIRST_PAGE_NO)\n                    .andEqualTo(\"enableFlag\", Constants.ENABLED_Y);\n            List<PmcPayCommonBankColSet> pmcPayCommonBankColSetsexamplePageNo = pmcPayCommonBankColSetMapper.selectByExample(examplePageNo);\n            if (CollectionUtils.isNotEmpty(pmcPayCommonBankColSetsexamplePageNo)) {\n                startPageNo = Integer.parseInt(pmcPayCommonBankColSetsexamplePageNo.get(0).getMappingBankCol());\n            }\n            List<TransInfo> res = new ArrayList<>();\n            for (int i = startPageNo; i < TRANS_REQUEST_NUM; i++) {\n                dto.put(\"pageNo\", i);\n                dto.put(\"funName\", Constants.BankcommonTranscodeEnum.TRANSACTIONS);\n                String request = messageBuilder.queryTransactionsMessage(dto, extentionParams);\n\n                // 发送银行前置机\n                String[] ipArr = new String[1];\n                String response = this.postMACHINE(request, StringUtils.toString(dto.get(\"account\")),\n                        WkContextHolder.getTenantId(), ipArr, StringUtils.toString(dto.get(\"bankCode\")));\n                if (Constants.NO_ENABLED_MACHINE.equals(response)) {\n                    log.error(\"流水查询时 无可用前置机异常, accountNo={}\", StringUtils.toString(dto.get(\"account\")));\n                    break;\n                } else if (Constants.BANK_POST_EXCEPTION.equals(response)) {\n                    log.error(\"流水查询请求异常, accountNo={}\", StringUtils.toString(dto.get(\"account\")));\n                    break;\n                }\n                ResponseHeaderDTO responseHeaderDto =\n                        responseXmlParser.parseResponseXml(response, dto);\n                log.info(\"homeTransactionsDeal 处理银行请求结果 resDto={}\", JSON.toJSONString(responseHeaderDto));\n                if (responseHeaderDto == null) {\n                    break;\n                }\n                ResponseHeaderDTO.SystemHeadBean header = responseHeaderDto.getHeader();\n                ResponseBodyDTO bodyDto = responseHeaderDto.getBody();\n                if (header == null || !Constants.RESPONSE_SUCCESS.equals(header.getStatus()) || bodyDto == null\n                        || CollectionUtils.isEmpty(bodyDto.getTransInfoList())) {\n                    log.error(\"homeTransactionsDeal 银行报文解析发生错误\");\n                    break;\n                }\n                // 处理成功\n                res.addAll(bodyDto.getTransInfoList());\n                // 已经到最后一页，退出循环\n                if (Constants.ENABLED_Y.equals(bodyDto.getLastPageFlag())) {\n                    break;\n                }\n                // 流水列表总数大于等于接口总数，退出循环\n                if (StringUtils.isNotBlank(bodyDto.getTotalNum())) {\n                    int transCount = Integer.parseInt(bodyDto.getTotalNum());\n                    if (res.size() >= transCount) {\n                        break;\n                    }\n                }\n            }\n            dto.put(\"transInfoList\", res);\n        } catch (Exception e) {\n            log.error(\"homeTransactionsDeal 账户流水处理失败\", e);\n        }\n    }\n\n    /**\n     * 批量查询账户余额\n     *\n     * @param payQO\n     * @return\n     */\n    @Override\n    public List<BalanceInfo> selectBankcommonBalance(PayQO payQO, Map<String, String> extentionParams) {\n        log.info(\"查询当日余额 selectBankcommonBalance accountNo={}\", payQO.getBankAccount());\n        Map<String, Object> dto = new HashMap<>();\n        // 余额处理\n        dto.put(\"funName\", Constants.BankcommonTranscodeEnum.BALANCE_NOW);\n        dto.put(\"bankCode\", payQO.getBank());\n        List<BalanceInfo> result = new ArrayList<>();\n        List<PmcAccount> pmcAccounts = accountService.queryBankcommonAccount(payQO);\n        if (CollectionUtils.isEmpty(pmcAccounts)) {\n            log.info(\"没有启用中的账户\");\n            return null;\n        }\n        Map<String, PmcAccount> map = pmcAccounts.stream()\n                .collect(Collectors.toMap(PmcAccount::getAccountNo, Function.identity(), (k1, k2) -> k1));\n        log.info(\"待查询的账户数量 size={}\", pmcAccounts.size());\n\n        if (CollectionUtils.isNotEmpty(pmcAccounts)) {\n            for (PmcAccount pmcAccount : pmcAccounts) {\n                dto.put(\"account\", pmcAccount.getAccountNo());\n                // 生成请求报文\n                String request = messageBuilder.queryBalanceNowMessage(dto, extentionParams);\n                // 发送银行前置机\n                String response = this.postMACHINE(request, pmcAccount.getAccountNo(),\n                        WkContextHolder.getTenantId(), null, payQO.getBank());\n                // 处理银行余额响应结果\n                this.bankcommonBalanceDeal(response, map, result, dto);\n            }\n        }\n        return result;\n    }\n\n    @Override\n    public List<TmsAccountBalanceCmb> selectBankcommonBalanceOld(BankcommonBalanceOldQO bankcommonBalanceOldQO, Map<String, String> extentionParams) {\n        List<TmsAccount> accountList = bankcommonBalanceOldQO.getAccountList();\n        Date balanceDate = bankcommonBalanceOldQO.getBalanceDate();\n        if (CollectionUtils.isEmpty(accountList)) {\n            log.info(\"没有启用中的银行账户\");\n            return null;\n        }\n        List<TmsAccountBalanceCmb> result = new ArrayList<>();\n        for (TmsAccount account : accountList) {\n            try {\n                Document document;\n                Map<String, Object> dto = new HashMap<>();\n                dto.put(\"bankCode\", account.getBank());\n                dto.put(\"accountNo\", account.getAccountNo());\n                dto.put(\"beginDate\", DateUtils.formatDate(balanceDate, DateTool.DAY_PARTTEN_YYYYMMDD));\n                dto.put(\"endDate\", DateUtils.formatDate(balanceDate, DateTool.DAY_PARTTEN_YYYYMMDD));\n                dto.put(\"funName\", Constants.BankcommonTranscodeEnum.BALANCE_OLD);\n                String request = messageBuilder.queryBalanceOldMessage(dto, extentionParams);\n                // 发送银行前置机\n                String response = this.postMACHINE(request, StringUtils.toString(dto.get(\"account\")),\n                        WkContextHolder.getTenantId(), null, StringUtils.toString(dto.get(\"bankCode\")));\n                // 处理银行余额响应结果\n                ResponseHeaderDTO responseHeaderDto = responseXmlParser.parseResponseXml(response, dto);\n                log.info(\"postForBalanceOld 处理银行余额请求结果 resDto={}\", JSON.toJSONString(responseHeaderDto));\n\n                if (responseHeaderDto != null) {\n                    ResponseBodyDTO bodyDto = responseHeaderDto.getBody();\n                    ResponseHeaderDTO.SystemHeadBean header = responseHeaderDto.getHeader();\n                    if (header != null && Constants.RESPONSE_SUCCESS.equals(header.getStatus()) && bodyDto != null) {\n                        // 处理历史余额数据\n                        TmsAccountBalanceCmb balance = new TmsAccountBalanceCmb();\n                        balance.setBalanceDate(balanceDate);\n                        balance.setCurrency(account.getCurrency());\n                        balance.setAcAccountId(account.getAcAccountId());\n                        balance.setAccountNo(account.getAccountNo());\n                        if (StringUtils.isNotBlank(bodyDto.getBalance())) {\n                            balance.setOnlineBalance(new BigDecimal(bodyDto.getBalance()));\n                        }\n                        result.add(balance);\n\n                    } else {\n                        log.error(\"postForBalanceOld 银行历史余额报文解析返回体为空\");\n                    }\n                }\n            } catch (Exception e) {\n                log.error(\"银行余额拉取发生异常\", e);\n            }\n        }\n\n        return result;\n    }\n\n    /**\n     * 处理银行余额响应结果\n     */\n    private void bankcommonBalanceDeal(String response, Map<String, PmcAccount> map, List<BalanceInfo> result, Map<String, Object> dto) {\n        log.info(\"bankcommonBalanceDeal 处理银行响应结果开始\");\n        if (Constants.NO_ENABLED_MACHINE.equals(response) || Constants.BANK_POST_EXCEPTION.equals(response)) {\n            log.error(\"余额查询时 无可用前置机异常 或网络错误\");\n            return;\n        }\n        ResponseHeaderDTO responseHeaderDto =\n                responseXmlParser.parseResponseXml(response, dto);\n        log.info(\"queryBankcommonBalance 处理银行余额请求结果 resDto={}\", JSON.toJSONString(responseHeaderDto));\n        // 处理成功\n        if (responseHeaderDto != null) {\n            ResponseBodyDTO bodyDto = responseHeaderDto.getBody();\n            ResponseHeaderDTO.SystemHeadBean header = responseHeaderDto.getHeader();\n            if (bodyDto != null && header != null && Constants.RESPONSE_SUCCESS.equals(header.getStatus())) {\n\n                log.info(\"queryBankcommonBalance 开始处理银行返回的余额数据\");\n                BalanceInfo balanceInfo = bodyDto.getBalanceInfo();\n                if (null == balanceInfo) {\n                    return;\n                }\n\n                balanceInfo.setCurrencyName(operateByJDBC.translate(CURRENCY, Constants.CNY));\n                balanceInfo.setBankName(operateByJDBC.translate(BANK, StringUtils.toString(dto.get(\"bankCode\"))));\n                PmcAccount account;\n                if (map != null && (account = map.get(balanceInfo.getAccount())) != null) {\n                    balanceInfo.setBranchBank(account.getBranchName());\n                    balanceInfo.setBranchBankName(account.getBranchName());\n                }\n                // 银行返回的账户余额才做记录\n                if (StringUtils.isNotBlank(balanceInfo.getAvailableBalance())) {\n                    result.add(balanceInfo);\n                }\n            } else {\n                log.error(\"queryBankcommonBalance 银行余额报文解析发生错误\");\n            }\n        }\n    }\n\n    /**\n     * 批量更新指令数据并插入历史记录\n     */\n    public void batchUpdateBankcommonInstructAndHis(List<Map<String, Object>> payInstructs) {\n        if (CollectionUtils.isNotEmpty(payInstructs)) {\n            payInstructs.forEach(\n                    instruct -> this.updateInstructAndHis(instruct, StringUtils.toString(instruct.get(\"status\")), null, null, null, null,\n                            null));\n        }\n    }\n\n    /**\n     * 更新指令状态\n     */\n    private void updateInstructAndHis(Map<String, Object> payInstruct, String status, String relCode, String relMsg,\n                                      String detailCode, String detailMsg, String processInstanceNumber) {\n        payInstruct.put(\"status\", status);\n        payInstruct.put(\"relCode\", relCode);\n        payInstruct.put(\"relMessage\", relMsg);\n        payInstruct.put(\"processCode\", detailCode);\n        payInstruct.put(\"processMessage\", detailMsg);\n        payInstruct.put(\"processInstanceNumber\", processInstanceNumber);\n        log.info(\"updateInstructAndHis payInstruct={}\", JSON.toJSONString(payInstruct));\n        bankcommonPayInstructService.updateOneInstructAndHis(payInstruct, (String) payInstruct.get(\"bank_code\"));\n    }\n\n\n    /**\n     * 发起支付\n     */\n    private List<Map<String, Object>> batchPay(List<Map<String, Object>> payInstructs, Map<String, String> extentionParams) {\n        log.info(\"batchPay 发起支付 size={}\", payInstructs.size());\n        List<Map<String, Object>> result = new ArrayList<>(payInstructs.size());\n        List<Map<String, Object>> errorInstructList = new ArrayList<>();\n        for (Map<String, Object> item : payInstructs) {\n            List<Map<String, Object>> dtoList = new ArrayList<>();\n            Map<String, Object> dto = new HashMap<>(item);\n            dtoList.add(dto);\n            // 保证每个批次数据正常处理不影响\n            try {\n                // 组装发送报文\n                String request = messageBuilder.queryBankPayMessage(dto, extentionParams);\n                if (StringUtils.isNotBlank(StringUtils.toString(dto.get(\"errorMessage\")))) {\n                    log.error(\"报文组装失败 payCheckNum={}\", StringUtils.toString(dto.get(\"payCheckNum\")));\n                    // 报文组装失败\n                    errorInstructList.add(dto);\n                    continue;\n                }\n\n                // 发送银行前置机\n                String response = null;\n                response = this.postMACHINE(request, StringUtils.toString(dto.get(\"account\")),\n                        WkContextHolder.getTenantId(), null, StringUtils.toString(dto.get(\"bank_code\")));\n                if (Constants.NO_ENABLED_MACHINE.equals(response)) {\n                    log.error(\"付款时 无可用前置机异常, payCheckNum={}\", StringUtils.toString(dto.get(\"payCheckNum\")));\n                    this.batchUpdateInstructAndHis(dtoList, PayStatus.ORDER_FAILED.name(),\n                            Constants.NO_ENABLED_MACHINE_MSG, Constants.NO_ENABLED_MACHINE_MSG);\n                    continue;\n                } else if (Constants.BANK_POST_EXCEPTION.equals(response)) {\n                    log.error(\"发起支付请求异常, payCheckNum={}\", StringUtils.toString(dto.get(\"payCheckNum\")));\n                    this.batchUpdateInstructAndHis(dtoList, PayStatus.ORDER_UNKNOW.name(),\n                            Constants.REQUEST_ERROR, Constants.REQUEST_ERROR);\n                    // 预警邮件\n                    mailService.sendOrderUnknownMail(dtoList.stream()\n                            .map(itemTemp -> StringUtils.toString(itemTemp.get(\"payCheckNum\"))).collect(Collectors.toList()));\n                    continue;\n                }\n                // 处理银行请求结果\n                this.dealPayResponseResult(response, dtoList);\n                this.batchPayChecksDeal(dtoList);\n                result.add(dto);\n            } catch (Exception e) {\n                log.error(\"batchPay 支付结果处理过程中发生异常\", e);\n                // 暂时发送邮件人工干预处理\n                mailService.sendBankResultDealErrorMail(payInstructs.stream()\n                        .map(itemTemp -> StringUtils.toString(itemTemp.get(\"payCheckNum\"))).collect(Collectors.toList()));\n            }\n        }\n        // 处理报文组装失败的指令\n        this.batchDocumentFailDeal(errorInstructList);\n        return result;\n    }\n\n    /**\n     * 处理银行支付请求结果\n     */\n    private void dealPayResponseResult(String response, List<Map<String, Object>> successInstruct) {\n        Map<String, Object> instructDto = successInstruct.get(0);\n        instructDto.put(\"funName\", Constants.BankcommonTranscodeEnum.BANK_PAY);\n        ResponseHeaderDTO responseHeaderDto =\n                responseXmlParser.parseResponseXml(response, instructDto);\n        log.info(\"dealResponseResult 处理银行请求结果 resDto={}\", JSON.toJSONString(responseHeaderDto));\n        // 处理成功\n        if (responseHeaderDto != null && responseHeaderDto.getHeader() != null\n                && Constants.RESPONSE_SUCCESS.equals(responseHeaderDto.getHeader().getStatus())\n                && responseHeaderDto.getBody() != null) {\n\n            for (Map<String, Object> dto : successInstruct) {\n                String status;\n                String code = responseHeaderDto.getBody().getStatus();\n                String msg = responseHeaderDto.getBody().getStatusText();\n                if (Constants.RESPONSE_SUCCESS.equals(code) || Constants.RESPONSE_PROCESSING.equals(code)) {\n                    status = PayStatus.BANK_PROCESSING.name();\n                } else if (StringUtils.isNotBlank(msg) && msg.contains(\"余额不足\")) {\n                    // 在状态查询时候\n                    status = PayStatus.FAILED_BALANCE.name();\n                } else {\n                    status = PayStatus.ORDER_UNKNOW.name();\n                }\n                this.updateInstructAndHis(dto, status, code, msg, code, msg, null);\n            }\n        } else {\n            // 可疑指令\n            this.batchUpdateInstructAndHis(successInstruct, PayStatus.ORDER_UNKNOW.name(), null, null);\n        }\n    }\n\n    /**\n     * 处理报文组装失败指令\n     */\n    private void batchDocumentFailDeal(List<Map<String, Object>> errorInstruct) {\n        if (CollectionUtils.isEmpty(errorInstruct)) {\n            return;\n        }\n        try {\n            log.info(\"batchDocumentFailDeal 存在报文组装失败的指令\");\n            // 更新指令状态并插入记录\n            this.batchUpdateInstructAndHis(errorInstruct, PayStatus.FAILED.name(),\n                    \"组装报文异常\", \"组装报文异常如异常字符\");\n            // 更新付款单并插入记录\n            for (Map<String, Object> instruct : errorInstruct) {\n                PmcPayChecks payChecks = new PmcPayChecks();\n                payChecks.setPayCheckNum(StringUtils.toString(instruct.get(\"payCheckNum\")));\n                payChecks.setStatus(PayStatus.FAILED.name());\n                payChecks.setFailureReasons(\"组装报文异常如异常字符\");\n                this.updatePayChecksAndInsertHis(payChecks);\n                try {\n                    // 反馈业务线\n                    payChecksWriteBackService.writeBack(Long.valueOf(StringUtils.toString(instruct.get(\"checkId\"))));\n                } catch (Exception e) {\n                    log.error(\"batchDocumentFailDeal 反馈业务线异常\", e);\n                }\n            }\n            // 发送异常邮件\n            mailService.paymentMessageFailed(errorInstruct.stream()\n                    .map(itemTemp -> StringUtils.toString(itemTemp.get(\"payCheckNum\"))).collect(Collectors.toList()));\n        } catch (Exception e) {\n            log.error(\"batchDocumentFailDeal error\", e);\n        }\n    }\n\n    /**\n     * 响应到银行结果，对付款单进行状态变更，并发送指令邮件\n     */\n    private void batchPayChecksDeal(List<Map<String, Object>> resultInstructs) {\n        if (CollectionUtils.isEmpty(resultInstructs)) {\n            return;\n        }\n        log.info(\"batchPayChecksDeal result={}\", JSON.toJSONString(resultInstructs));\n        // 指令不明的需要发送邮件\n        List<Map<String, Object>> orderUnknown = resultInstructs.stream()\n                .filter(t -> PayStatus.ORDER_UNKNOW.name().equals(StringUtils.toString(t.get(\"status\")))).collect(Collectors.toList());\n        if (!CollectionUtils.isEmpty(orderUnknown)) {\n            // 预警邮件\n            mailService.sendOrderUnknownMail(orderUnknown.stream()\n                    .map(itemTemp -> StringUtils.toString(itemTemp.get(\"payCheckNum\"))).collect(Collectors.toList()));\n        }\n\n        // 银行处理中数据\n        List<Map<String, Object>> processing = resultInstructs.stream()\n                .filter(t -> PayStatus.BANK_PROCESSING.name().equals(StringUtils.toString(t.get(\"status\")))).collect(Collectors.toList());\n        if (!CollectionUtils.isEmpty(processing)) {\n            processing.forEach(instruct -> {\n                PmcPayChecks payChecks = new PmcPayChecks();\n                payChecks.setPayCheckNum(StringUtils.toString(instruct.get(\"payCheckNum\")));\n                payChecks.setStatus(PayStatus.BANK_PROCESSING.name());\n                this.updatePayChecksAndInsertHis(payChecks);\n            });\n        }\n\n        // 余额不足数据\n        List<Map<String, Object>> failedBalance = resultInstructs.stream()\n                .filter(t -> PayStatus.FAILED_BALANCE.name().equals(StringUtils.toString(t.get(\"status\")))).collect(Collectors.toList());\n        if (!CollectionUtils.isEmpty(failedBalance)) {\n            failedBalance.forEach(instruct -> {\n                PmcPayChecks payChecks = new PmcPayChecks();\n                payChecks.setPayCheckNum(StringUtils.toString(instruct.get(\"payCheckNum\")));\n                payChecks.setStatus(PayStatus.FAILED_BALANCE.name());\n                this.updatePayChecksAndInsertHis(payChecks);\n                // 余额不足邮件\n                mailService.sendBalanceNotEnoughMail(StringUtils.toString(instruct.get(\"payCheckNum\")), \"余额不足\");\n            });\n        }\n\n        // 银行处理失败数据\n        List<Map<String, Object>> failed = resultInstructs.stream()\n                .filter(t -> PayStatus.FAILED.name().equals(StringUtils.toString(t.get(\"status\")))).collect(Collectors.toList());\n        if (!CollectionUtils.isEmpty(failed)) {\n            failed.forEach(instruct -> {\n                PmcPayChecks payChecks = new PmcPayChecks();\n                payChecks.setPayCheckNum(StringUtils.toString(instruct.get(\"payCheckNum\")));\n                payChecks.setStatus(PayStatus.FAILED.name());\n                this.updatePayChecksAndInsertHis(payChecks);\n                // 反馈业务线\n                payChecksWriteBackService.writeBack(Long.valueOf(StringUtils.toString(instruct.get(\"checkId\"))));\n                // 邮件提醒\n                mailService.sendFailedMail(StringUtils.toString(instruct.get(\"payCheckNum\")), payChecks.getFailureReasons());\n            });\n        }\n\n        // 付款成功数据\n        List<Map<String, Object>> payed = resultInstructs.stream()\n                .filter(t -> PayStatus.PAYED.name().equals(StringUtils.toString(t.get(\"status\")))).collect(Collectors.toList());\n        if (!CollectionUtils.isEmpty(payed)) {\n            payed.forEach(instruct -> {\n                PmcPayChecks payChecks = new PmcPayChecks();\n                payChecks.setPayCheckNum(StringUtils.toString(instruct.get(\"payCheckNum\")));\n                payChecks.setStatus(PayStatus.PAYED.name());\n                payChecks.setActualPayDate(new Date());\n                this.updatePayChecksAndInsertHis(payChecks);\n                // 反馈业务线\n                payChecksWriteBackService.writeBack(Long.valueOf(StringUtils.toString(instruct.get(\"checkId\"))));\n            });\n        }\n    }\n\n\n    /**\n     * 更新付款单并插入历史记录\n     *\n     * @param payChecks 付款单\n     */\n    private void updatePayChecksAndInsertHis(PmcPayChecks payChecks) {\n        log.info(\"updatePayChecksAndInsertHis 更新付款单并插入历史记录 checkId={}\", payChecks.getCheckId());\n        payChecksService.updateByCheckNum(payChecks);\n        PmcPayChecks pmcPayChecks = payChecksService.selectPayChecksByPayCheckNum(payChecks.getPayCheckNum());\n        // 付款单更新记录\n        PmcPayChecksAuditHis pmcPayChecksAuditHis = new PmcPayChecksAuditHis();\n        BeanUtils.copyProperties(pmcPayChecks, pmcPayChecksAuditHis);\n        pmcPayChecksAuditHis.setPayNode(PayNode.PAY_BANK_INTERFACES.name());\n        pmcPayChecksAuditHis.setLastUpdateBy(Constants.SYSTEM_USER);\n        pmcPayChecksAuditHis.setOperationNote(pmcPayChecks.getFailureReasons());\n        if (StringUtils.equals(PayStatus.PAYED.name(), pmcPayChecks.getStatus())) {\n            pmcPayChecksAuditHis.setPayOperation(PayOperation.EPAYMENT_UPDATE_PAI.name());\n        }\n        if (StringUtils.equals(PayStatus.FAILED.name(), pmcPayChecks.getStatus())) {\n            pmcPayChecksAuditHis.setPayOperation(PayOperation.EPAYMENT_UPDATE_FAILED.name());\n        }\n        if (StringUtils.equals(PayStatus.FAILED_BALANCE.name(), pmcPayChecks.getStatus())) {\n            pmcPayChecksAuditHis.setPayNode(PayNode.PAY_OVERDRAFT_FAIL.name());\n            pmcPayChecksAuditHis.setPayOperation(PayOperation.EPAYMENT_UPDATE_OVERDRAFT_FAILED.name());\n        }\n        if (StringUtils.equals(PayStatus.BANK_PROCESSING.name(), pmcPayChecks.getStatus())) {\n            pmcPayChecksAuditHis.setPayOperation(PayOperation.BANK_PROCESSING.name());\n        }\n        if (StringUtils.equals(PayStatus.REFUND.name(), pmcPayChecks.getStatus())) {\n            pmcPayChecksAuditHis.setPayOperation(PayOperation.EPAYMENT_UPDATE_REFUND.name());\n        }\n        payChecksHisService.savePayChecksHis(pmcPayChecksAuditHis);\n    }\n\n    /**\n     * 析疑\n     */\n    @Override\n    public String bankcommonAnalysisSuspect(PayInstructQO payInstructQO, Map<String, String> extentionParams) {\n        Map<String, Object> payInstruct =\n                bankCommonPayInstructInterService\n                        .findByPayCheckNumber(payInstructQO.getReferenceNumber(), null, payInstructQO.getBank());\n        if (payInstruct == null) {\n            return \"根据付款单号未获取到付款指令\";\n        }\n        payInstruct.put(\"attribute1\", Constants.ENABLED_Y);\n        // 析疑完成先入库\n        bankCommonPayInstructInterService.updateByPrimaryKeySelective(payInstruct, (String) payInstruct.get(\"bankCode\"));\n        List<Map<String, Object>> list = new ArrayList<>();\n        list.add(payInstruct);\n        List<Map<String, Object>> dtoList = this.queryPayResult(list, payInstructQO.getBank(), extentionParams);\n        Map<String, Object> dto;\n        if (CollectionUtils.isNotEmpty(dtoList) && (dto = dtoList.get(0)) != null\n                && StringUtils.isNotBlank(StringUtils.toString(dto.get(\"processCode\")))) {\n            String result = \"查询支付结果返回代码:\" + StringUtils.toString(dto.get(\"processCode\")) + \" 返回信息:\";\n            if (org.apache.commons.lang.StringUtils.isNotBlank(StringUtils.toString(dto.get(\"processMessage\")))) {\n                result += StringUtils.toString(dto.get(\"processMessage\"));\n            }\n            return result;\n        }\n        log.error(\"该笔单据未在银行查询到付款状态，请联系银行确认！\");\n        return \"该笔单据未在银行查询到付款状态，请联系银行确认！\";\n    }\n\n    /**\n     * 批量更新指令状态\n     */\n    private void batchUpdateInstructAndHis(List<Map<String, Object>> payList,\n                                           String status, String relCode, String relMsg) {\n        payList.forEach(detail ->\n                this.updateInstructAndHis(detail, status, relCode, relMsg, null, null, null));\n    }\n\n    /**\n     * 查询银行支付结果\n     */\n    @Override\n    public String bankcommonQueryPayResultJob(String bankCode, Map<String, String> extentionParams) {\n        RedisLock redisLock = new RedisLock(\"bankcommonQueryPayResultJob\");\n        try {\n            if (!redisLock.lock(REDIS_LOCK_TIMEOUT, REDIS_LOCK_EXPIRE)) {\n                log.info(\"===========银行支付结果查询任务执行中，请稍后再试===========\");\n                throw new ServiceException(\"银行支付结果查询任务执行中，请稍后再试\");\n            }\n            List<String> status = new ArrayList<>();\n            // 银行处理中\n            status.add(PayStatus.BANK_PROCESSING.name());\n            // 可疑指令\n            status.add(PayStatus.ORDER_UNKNOW.name());\n            BankcommonPayInstructQO bankcommonPayInstructQO = new BankcommonPayInstructQO();\n            bankcommonPayInstructQO.setStatusList(status);\n            List<Map<String, Object>> payInstructs =\n                    bankCommonPayInstructInterService.selectMapByCondition(bankcommonPayInstructQO, bankCode);\n\n            if (CollectionUtils.isEmpty(payInstructs)) {\n                log.info(\"没有待查询的付款指令 bankcommonQueryPayResultJob resultSize={}\", 0);\n                return \"没有待查询的付款指令\";\n            }\n            this.queryPayResult(payInstructs, bankCode, extentionParams);\n        } finally {\n            redisLock.unlock();\n        }\n        return \"结果查询完成\";\n    }\n\n    /**\n     * 请求前置机\n     *\n     * @param request\n     * @param hashValue\n     * @param tenantId\n     * @return\n     */\n    @Override\n    public String postMACHINE(String request, String hashValue, Long tenantId, String[] ipArr, String bankCode) {\n        PmcCmbMachineDTO cmbMachineDTO = new PmcCmbMachineDTO();\n        cmbMachineDTO.setTenantId(tenantId);\n        cmbMachineDTO.setStatus(Constants.UP);\n        cmbMachineDTO.setMachineBank(bankCode);\n        List<PmcCmbMachine> pmcCmbMachines = machineService.selectMachine(cmbMachineDTO);\n        if (CollectionUtils.isEmpty(pmcCmbMachines)) {\n            log.error(\"无可用前置机 postMACHINE\");\n            // 无可用前置机\n            mailService.sendMachineFailedMail(\"无可用前置机\", new ArrayList<>(), \"\");\n            return Constants.NO_ENABLED_MACHINE;\n        }\n        pmcCmbMachines.forEach(detail -> log.info(\"可用前置机：\" + detail.getName() + \" \" + detail.getIp()));\n        log.info(\"租户：\" + tenantId);\n        // 一致性哈希算法 获取分配机器\n        Map<String, PmcCmbMachine> map = pmcCmbMachines.stream()\n                .collect(Collectors.toMap(PmcCmbMachine::getIp, Function.identity(), (k1, k2) -> k1));\n        String[] currentServers = map.keySet().toArray(new String[0]);\n        String server = new NodeDistributeUtil().getServer(hashValue, currentServers);\n        log.info(\"request server : \" + server);\n        PmcCmbMachine machine = map.get(server);\n        log.info(\"请求前置机ip地址: {}\", machine.getIp());\n        String[] ipPort;\n        if (server.split(\"//\").length != 2\n                || (ipPort = server.split(\"//\")[1].split(\":\")).length != 2) {\n            log.error(\"ip = {}, 格式不正确\", server);\n            return Constants.NO_ENABLED_MACHINE;\n        }\n        if (null != ipArr) {\n            ipArr[0] = ipPort[0];\n        }\n        try {\n            // 请求报文\n            log.info(\"请求报文 request={}\", request);\n            Example example = new Example(PmcPayCommonBankSet.class);\n            example.createCriteria().\n                    andEqualTo(\"bankCode\", bankCode)\n                    .andEqualTo(\"transferFlag\", Constants.ENABLED_Y);\n            List<PmcPayCommonBankSet> pmcPayCommonBankSets = pmcPayCommonBankSetMapper.selectByExample(example);\n            String requestType = Constants.RequestTypeEnum.XML;\n            if (CollectionUtils.isNotEmpty(pmcPayCommonBankSets)) {\n                requestType = pmcPayCommonBankSets.get(0).getRequestType();\n            }\n            String response = null;\n            if (Constants.RequestTypeEnum.XML.equals(requestType)) {\n                response = OkHttpUtils.sendHttpRequest(machine.getIp(), request);\n            } else {\n                response = OkHttpUtils.sendHttpRequestJson(machine.getIp(), request);\n            }\n            log.info(\"response :\" + response);\n            return response;\n        } catch (Exception e) {\n            log.error(\"网络出错，请检查网络！\", e);\n        }\n        return Constants.BANK_POST_EXCEPTION;\n    }\n\n    @Override\n    public List<BalanceInfo> queryBankcommonBalanceForCheck(List<PayQO> payQOS, Map<String, String> extentionParams) {\n        if (CollectionUtils.isEmpty(payQOS)) {\n            return new ArrayList<>();\n        }\n        log.info(\"银行账户余额校验开始\");\n        Map<String, Object> dto = new HashMap<String, Object>();\n        dto.put(\"funName\", Constants.BankcommonTranscodeEnum.BALANCE_NOW);\n        dto.put(\"bankCode\", payQOS.get(0).getBank());\n        List<BalanceInfo> result = new ArrayList<>();\n        List<String> accountNos = payQOS.stream().map(PayQO::getAccount).collect(Collectors.toList());\n\n        if (CollectionUtils.isNotEmpty(accountNos)) {\n            for (String account : accountNos) {\n                dto.put(\"account\", account);\n                // 生成请求报文\n                String request = messageBuilder.queryBalanceNowMessage(dto, extentionParams);\n                // 发送银行前置机\n                String response = this.postMACHINE(request, account, WkContextHolder.getTenantId(), null, StringUtils.toString(dto.get(\"bankCode\")));\n                // 处理银行余额响应结果\n                this.bankcommonBalanceDeal(response, null, result, dto);\n            }\n        }\n        // 处理未获取到余额的账户\n        if (CollectionUtils.isNotEmpty(result)) {\n            Map<String, BalanceInfo> map = result.stream()\n                    .collect(Collectors.toMap(BalanceInfo::getAccount, Function.identity(), (k1, k2) -> k1));\n            for (String account : accountNos) {\n                if (map.get(account) == null) {\n                    BalanceInfo balance = new BalanceInfo();\n                    balance.setAccount(account);\n                    balance.setCurrentDate(new Date());\n                    balance.setErrorText(\"未获取到余额\");\n                    result.add(balance);\n                }\n            }\n        }\n        return result;\n    }\n\n    /**\n     * 通用退票查询，适用于以下场合\n     * 1.退票基于付款指令唯一trn_uid标识定位单据\n     * @param payQO\n     * @param extentionParams\n     * @return\n     */\n    @Override\n    public String selectBankcommonRefund(PayQO payQO, Map<String, String> extentionParams) {\n        RedisLock redisLock = null;\n        try {\n            redisLock = new RedisLock(\"selectBankcommonRefund\");\n            if (!redisLock.lock(REDIS_LOCK_TIMEOUT, REDIS_LOCK_EXPIRE)) {\n               