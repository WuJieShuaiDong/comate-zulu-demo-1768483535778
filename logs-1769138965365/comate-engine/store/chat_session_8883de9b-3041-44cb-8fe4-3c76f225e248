sNotBlank(qo.getSupplierName())) {\n            quotaCriteria.andEqualTo(\"supplierName\", qo.getSupplierName());\n        }\n\n        // 4. 分页查询供应商额度\n        Page<PmcFinanceSupplierQuotaSet> quotaPage = (Page<PmcFinanceSupplierQuotaSet>)\n                pmcFinanceSupplierQuotaSetMapper.selectByExample(quotaExample);\n\n        // 5. 处理查询结果\n        if (CollectionUtils.isEmpty(quotaPage.getResult())) {\n            return new PageInfo<>(Collections.emptyList());\n        }\n\n        List<SupplierFinancingUsageDTO> dtoList = quotaPage.getResult().stream().map(quota -> {\n            SupplierFinancingUsageDTO dto = new SupplierFinancingUsageDTO();\n            BeanUtils.copyProperties(quota, dto, \"id\"); // 排除id字段\n\n            // 查询融资业务数据\n            Example financingExample = new Example(PmcFinanceSupplierApply.class);\n            Example.Criteria financingCriteria = financingExample.createCriteria();\n            financingCriteria.andEqualTo(\"supplierCode\", quota.getSupplierCode());\n\n            if (qo.getFinancingStartDate() != null) {\n                financingCriteria.andGreaterThanOrEqualTo(\"createDate\", qo.getFinancingStartDate());\n            }\n            if (qo.getFinancingEndDate() != null) {\n                financingCriteria.andLessThanOrEqualTo(\"createDate\", qo.getFinancingEndDate());\n            }\n\n            List<PmcFinanceSupplierApply> financingList = pmcFinanceSupplierApplyMapper.selectByExample(financingExample);\n\n            // 计算统计数据\n            dto.setTotalCount(financingList.size());\n            dto.setTotalAmount(financingList.stream()\n                    .map(PmcFinanceSupplierApply::getFinanceAmount)\n                    .reduce(BigDecimal.ZERO, BigDecimal::add));\n            return dto;\n        }).collect(Collectors.toList());\n\n        // 6. 构建分页结果\n        PageInfo<SupplierFinancingUsageDTO> pageInfo = new PageInfo<>();\n        BeanUtils.copyProperties(quotaPage.toPageInfo(), pageInfo);\n        pageInfo.setList(dtoList);\n        return pageInfo;\n    }\n\n    @Override\n    public List<PmcFinanceSupplierQuotaSetDTO> exportSupplierQuotaSet(PmcFinanceSupplierQuotaSetQO query) {\n        return getSupplierQuotaSetList(query);\n    }\n\n\n    @Override\n    public Long saveOrUpdateSupplierQuotaSet(PmcFinanceSupplierQuotaSetDTO dto) {\n        PmcFinanceSupplierQuotaSet pmcFinanceSupplierQuotaSet = new PmcFinanceSupplierQuotaSet();\n        BeanUtils.copyProperties(dto, pmcFinanceSupplierQuotaSet);\n        Example example = new Example(PmcFinanceSupplierQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n        criteria.andEqualTo(\"supplierCode\", pmcFinanceSupplierQuotaSet.getSupplierCode());\n        // 插入数据\n        if (pmcFinanceSupplierQuotaSetMapper.selectCountByExample(example) > 0) {\n            if (\"Y\".equals(dto.getAddFlag())) {\n                throw new IllegalArgumentException(\"该供应商额度已存在，不能新增!\");\n            }\n            pmcFinanceSupplierQuotaSet.setLastUpdateDate(new Date());\n            pmcFinanceSupplierQuotaSetMapper.updateByExampleSelective(pmcFinanceSupplierQuotaSet, example);\n            return pmcFinanceSupplierQuotaSet.getId();\n        } else {\n            pmcFinanceSupplierQuotaSet.setCreateDate(new Date());\n            pmcFinanceSupplierQuotaSetMapper.insert(pmcFinanceSupplierQuotaSet);\n            log.info(\"新增供应商额度成功，供应商编码: {}\", pmcFinanceSupplierQuotaSet.getSupplierCode());\n            return pmcFinanceSupplierQuotaSet.getId();\n        }\n    }\n\n\n    private List<PmcFinanceSupplierQuotaSetDTO> getSupplierQuotaSetList(PmcFinanceSupplierQuotaSetQO query) {\n        Example example = new Example(PmcFinanceSupplierQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n        if (StringUtils.isNotBlank(query.getSupplierName())) {\n            criteria.andEqualTo(\"supplierName\", query.getSupplierName());\n        }\n        if (StringUtils.isNotBlank(query.getSupplierCode())) {\n            criteria.andEqualTo(\"supplierCode\", query.getSupplierCode());\n        }\n\n        if (StringUtils.isNotBlank(query.getRegistrationCode())) {\n            criteria.andEqualTo(\"registrationCode\", query.getRegistrationCode());\n        }\n        if (StringUtils.isNotBlank(query.getFinanceFlag())) {\n            criteria.andEqualTo(\"financeFlag\", query.getFinanceFlag());\n        }\n        List<PmcFinanceSupplierQuotaSet> list = pmcFinanceSupplierQuotaSetMapper.selectByExample(example);\n        List<PmcFinanceSupplierQuotaSetDTO> dtoList = list.stream().map(his -> {\n            PmcFinanceSupplierQuotaSetDTO dto = new PmcFinanceSupplierQuotaSetDTO();\n            BeanUtils.copyProperties(his, dto);\n            dto.setFinanceFlagName((\"Y\".equals(dto.getFinanceFlag()) ? \"是\" : \"否\"));\n            return dto;\n        }).collect(Collectors.toList());\n        return dtoList;\n    }\n\n\n    private List<PmcFinanceCompQuotaSetDTO> getQuotaSetList(PmcFinanceCompQuotaSetQO query) {\n        Example example = new Example(PmcFinanceCompQuotaSet.class);\n\n        Example.Criteria criteria = example.createCriteria();\n        if (StringUtils.isNotBlank(query.getBankCode())) {\n            criteria.andEqualTo(\"bankCode\", query.getBankCode());\n        }\n        if (StringUtils.isNotBlank(query.getCreditCompCode())) {\n            criteria.andEqualTo(\"creditCompCode\", query.getCreditCompCode());\n        }\n        if (StringUtils.isNotBlank(query.getEnableFlag())) {\n            criteria.andEqualTo(\"enableFlag\", query.getEnableFlag());\n        }\n        if (StringUtils.isNotBlank(query.getPayAccount())) {\n            criteria.andEqualTo(\"payAccount\", query.getPayAccount());\n        }\n        if (StringUtils.isNotBlank(query.getCompanyCode())) {\n            criteria.andEqualTo(\"companyCode\", query.getCompanyCode());\n        }\n        List<PmcFinanceCompQuotaSet> list = pmcFinanceCompQuotaSetMapper.selectByExample(example);\n\n\n        List<PmcFinanceCompQuotaSetDTO> dtoList = list.stream().map(his -> {\n            PmcFinanceCompQuotaSetDTO dto = new PmcFinanceCompQuotaSetDTO();\n            BeanUtils.copyProperties(his, dto);\n            dto.setEnableFlagName((\"1\".equals(dto.getEnableFlag()) ? \"是\" : \"否\"));\n            return dto;\n        }).collect(Collectors.toList());\n\n        fndFlexValueApi.translate(dtoList,  \"companyCode\", BD_COMPANY, \"creditCompCode\", BD_COMPANY, \"bankCode\",\n                Constants.PmcLookupInfoCode.BANK);\n\n        setPayAccountNames(dtoList);\n        return dtoList;\n    }\n\n\n    private void setPayAccountNames(List<PmcFinanceCompQuotaSetDTO> list) {\n        if (CollectionUtils.isEmpty(list)) {\n            return;\n        }\n        // 收集所有accountNo\n        List<String> accountNos = list.stream()\n                .map(PmcFinanceCompQuotaSet::getPayAccount)\n                .filter(StringUtils::isNotBlank)\n                .distinct()\n                .collect(Collectors.toList());\n\n        if (CollectionUtils.isEmpty(accountNos)) {\n            return;\n        }\n        // 批量查询accountName\n        Map<String, String> accountNameMap = accountMapper.batchSelectAccountNames(accountNos);\n\n        // 为每条记录设置PayAccountName\n        list.forEach(dto -> {\n            if (StringUtils.isNotBlank(dto.getPayAccount())) {\n                dto.setPayAccountName(accountNameMap.get(dto.getPayAccount()));\n                String currencyName = (operateByJDBC.translate(CURRENCY, \"CNY\"));\n                dto.setPayAccountInfo(dto.getPayAccount() + \"-\" + currencyName + \"-\"\n                        + dto.getBankCodeName() + \"-\" + dto.getPayAccountName());\n            }\n        });\n    }\n\n    @Override\n    public Map<String, Object> getSelectInit() {\n        Map<String, Object> result = new HashMap<>();\n        // 获取所有融资状态及描述\n        List<CodeDesc> statusList = SupplierFinancingApplyStatus.getAllStatuses();\n\n        // 获取融资机构列表\n        List<CodeDesc> bankList = operateByJDBC.selectByCon(BANK_FINANCING_RATES)\n                .stream()\n                .map(info -> new CodeDesc(info.getFlexValue(), info.getDescription()))\n                .collect(Collectors.toList());\n\n        List<FndFlexValueDTO> enbleFlagList = fndFlexValueApi.selectByType(Constants.PmcLookupInfoCode.YES_NO);\n\n\n        // 获取公司列表\n        List<CodeDesc> cnmpanyList = operateByJDBC.selectByCon(BD_COMPANY)\n                .stream()\n                .map(info -> new CodeDesc(info.getFlexValue(), info.getDescription()))\n                .collect(Collectors.toList());\n\n        // 处理步骤列表\n        List<CodeDesc> dealList = FinancingStatus.getAllStatuses();\n\n        // 网银地址列表\n        List<CodeDesc> bankUrlList = operateByJDBC.selectByCon(BANK_FINANCING_URL)\n                .stream()\n                .map(info -> new CodeDesc(info.getFlexValue(), info.getDescription()))\n                .collect(Collectors.toList());\n\n        // 配置银行额度的接口\n        List<CodeDesc> bankQuotaList = operateByJDBC.selectByCon(PMC_FINANCE_QYOTA_BANK)\n                .stream()\n                .map(info -> new CodeDesc(info.getFlexValue(), info.getMeaning()))\n                .collect(Collectors.toList());\n\n        result.put(\"yesNo\", fndFlexValueApi.convertToCodedLabelDTO(enbleFlagList));\n        result.put(\"statusList\", statusList);\n        result.put(\"bankList\", bankList);\n        result.put(\"companyList\", cnmpanyList);\n        result.put(\"dealList\", dealList);\n        result.put(\"bankUrlList\", bankUrlList);\n        result.put(\"bankQuotaList\", bankQuotaList);\n\n        return result;\n    }\n\n    @Override\n    public BigDecimal calculateAvailableQuota(PmcPortalRemainQuotaQO qo) {\n        BigDecimal availableQuota;\n        // 1. 获取供应商额度\n        Example example = new Example(PmcFinanceSupplierQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n        criteria.andEqualTo(\"supplierCode\", qo.getSupplierCode());\n        criteria.andEqualTo(\"financeFlag\", \"Y\");\n        criteria.andGreaterThanOrEqualTo(\"effectiveEndDate\", new Date());\n        criteria.andLessThanOrEqualTo(\"effectiveStartDate\", new Date());\n        List<PmcFinanceSupplierQuotaSet> pmcFinanceSupplierQuotaSet\n                = pmcFinanceSupplierQuotaSetMapper.selectByExample(example);\n        if (CollectionUtils.isEmpty(pmcFinanceSupplierQuotaSet)) {\n            log.info(\"供应商{}额度计算，无额度配置\", qo.getSupplierCode());\n            return BigDecimal.ZERO;\n        }\n        availableQuota = pmcFinanceSupplierQuotaSet.get(0).getCreditQuota();\n\n        // 2. 获取已占用金额\n        BigDecimal usedQuota = getUseFinancingAmt(qo.getSupplierCode(), \"\");\n\n        // 3. 获取主体剩余额度\n        if (StringUtils.isNotBlank(qo.getCompanyCode()) && StringUtils.isNotBlank(qo.getBankCode())) {\n            List<PmcFinanceCompQuotaSet> compQuotaSet = queryValidCompQuotaSet(qo.getBankCode(), qo.getCompanyCode());\n            if (CollectionUtils.isNotEmpty(compQuotaSet)) {\n                log.info(\"供应商:{},供应商额度:{},主体额度:{},已用额度:{}\", qo.getSupplierCode(),\n                        availableQuota, compQuotaSet.get(0).getAvailableFinancingQuota(), usedQuota);\n                if (availableQuota.subtract(usedQuota).compareTo(compQuotaSet.get(0).getAvailableFinancingQuota()) > 0) {\n                    return compQuotaSet.get(0).getAvailableFinancingQuota();\n                }\n            } else {\n                log.info(\"主体{},银行{}额度计算，无额度配置\", qo.getCompanyCode(), qo.getBankCode());\n                return BigDecimal.ZERO;\n            }\n        }\n        return availableQuota.subtract(usedQuota);\n    }\n\n    /**\n     * 根据银行代码、公司代码查询有效的公司额度设置\n     * @param bankCode 银行代码\n     * @param companyCode 公司代码\n     * @return 符合条件的公司额度设置列表\n     */\n    private List<PmcFinanceCompQuotaSet> queryValidCompQuotaSet(String bankCode, String companyCode) {\n        Example exampleComp = new Example(PmcFinanceCompQuotaSet.class);\n        Example.Criteria criteriaComp = exampleComp.createCriteria();\n        criteriaComp.andEqualTo(\"bankCode\", bankCode);\n        criteriaComp.andEqualTo(\"companyCode\", companyCode);\n        criteriaComp.andEqualTo(\"enableFlag\", \"Y\");\n        return pmcFinanceCompQuotaSetMapper.selectByExample(exampleComp);\n    }\n\n    /**\n     * 供应商模糊查询建议\n     *\n     * @param parameter 查询参数对象，至少需要包含以下一个字段：\n     *                  - supplierCode 供应商编码(模糊匹配)\n     *                  - supplierName 供应商名称(模糊匹配)\n     *                  - registrationCode 注册号(模糊匹配)\n     * @return List<PmcDataP2pSupplier> 匹配的供应商列表\n     * @throws IllegalArgumentException 当所有查询参数都为空时抛出\n     */\n    @Override\n    public List<PmcDataP2pSupplier> selectSuggest(PmcPortalSuggestQO parameter) {\n        if (parameter == null || (StringUtils.isBlank(parameter.getSupplierCode())\n                && StringUtils.isBlank(parameter.getSupplierName()) && StringUtils.isBlank(parameter.getRegistrationCode()))) {\n            throw new IllegalArgumentException(\"查询关键字不能为空\");\n        }\n\n        Example example = new Example(PmcDataP2pSupplier.class);\n        Example.Criteria criteria = example.createCriteria();\n\n        String keyWord = \"\";\n        if (StringUtils.isNotBlank(parameter.getSupplierCode())) {\n            keyWord = \"%\" + parameter.getSupplierCode() + \"%\";\n            criteria.orLike(\"supplierCode\", keyWord);\n        } else if (StringUtils.isNotBlank(parameter.getSupplierName())) {\n            keyWord = \"%\" + parameter.getSupplierName() + \"%\";\n            criteria.orLike(\"supplierName\", keyWord);\n        } else if (StringUtils.isNotBlank(parameter.getRegistrationCode())) {\n            keyWord = \"%\" + parameter.getRegistrationCode() + \"%\";\n            criteria.orLike(\"registrationCode\", keyWord);\n        }\n\n        // 执行查询\n        List<PmcDataP2pSupplier> suppliers = pmcDataP2pSupplierMapper.selectByExample(example);\n\n        // 转换为CodeDesc列表\n        return suppliers;\n    }\n\n    /**\n     * 生成融资申请单号\n     *\n     * @return PmcFinanceApplyNumberDTO 包含生成的申请单号\n     * 格式：FIN + 年月日 + 6位随机数(如FIN20231012000001)\n     */\n    @Override\n    public PmcFinanceApplyNumberDTO generateFinancingApplicationNo() {\n        PmcFinanceApplyNumberDTO dto = new PmcFinanceApplyNumberDTO();\n        dto.setApplicationNo(FinancingApplicationNoUtil.generate());\n        return dto;\n    }\n\n    /**\n     * 计算已使用的融资金额\n     *\n     * @param supplierCode 供应商编码\n     * @param payCheckNum  付款单号(可选)\n     * @return BigDecimal 已使用的融资金额\n     * 计算规则：指定供应商/付款单下所有非终态融资申请的总金额\n     */\n    private BigDecimal getUseFinancingAmt(String supplierCode, String payCheckNum) {\n        BigDecimal usedQuota = new BigDecimal(0);\n        List<String> targetStatuses = Arrays.asList(\n                SupplierFinancingApplyStatus.SUBMITTED.name(),\n                SupplierFinancingApplyStatus.BANK_PROCESSING.name(),\n                SupplierFinancingApplyStatus.PENDING_DISBURSEMEN.name(),\n                SupplierFinancingApplyStatus.DISBURSED.name());\n        Map<String, Object> resultMap = pmcFinanceSupplierApplyMapper.selectSummaryByStatus(targetStatuses,\n                supplierCode, payCheckNum);\n        usedQuota = (BigDecimal) resultMap.get(\"totalAmount\");\n        return usedQuota;\n    }\n\n    /**\n     * 通用数据校验方法\n     *\n     * @param query      校验参数对象\n     * @param methodName 方法名称，决定校验逻辑：\n     *                   - \"calculateFinancing\": 融资测算校验\n     *                   - \"submitFinancingApply\": 融资申请提交校验\n     *                   - \"queryFinancingResult\": 融资结果查询校验\n     *                   - \"queryFinancingQuota\": 融资额度查询校验\n     *                   - \"uploadFinancingAttachment\": 附件上传校验\n     *                   - \"supplementFinancingAttachment\": 附件补充校验\n     * @return String 校验结果，\"ok\"表示校验通过，否则返回错误信息\n     */\n    @Override\n    public String commonCheckData(PmcFinanceBankBaseQO query, String methodName) {\n        try {\n            log.info(\"执行通用数据校验，方法名：{}，参数类型：{}\", methodName,\n                    query != null ? query.getClass().getSimpleName() : \"null\");\n            switch (methodName) {\n                case \"calculateFinancing\":\n                    return validateCalculateFinancing(query);\n                case \"submitFinancingApply\":\n                    return validateSubmitFinancingApply(query);\n                case \"queryFinancingResult\":\n                    return validateQueryFinancingResult(query);\n                case \"queryFinancingQuota\":\n                    return validateQueryFinancingQuota(query);\n                case \"uploadFinancingAttachment\":\n                case \"supplementFinancingAttachment\":\n                    return validateFileOperation(query);\n                default:\n                    log.warn(\"未知的方法名：{}，执行默认校验\", methodName);\n                    return validateDefault(query);\n            }\n\n        } catch (Exception e) {\n            log.error(\"通用数据校验异常，方法名：{}\", methodName, e);\n            return \"数据校验异常：\" + e.getMessage();\n        }\n    }\n\n    /**\n     * 融资测算校验\n     */\n    private String validateCalculateFinancing(PmcFinanceBankBaseQO query) {\n        return \"ok\";\n    }\n\n    /**\n     * 融资申请提交校验\n     */\n    private String validateSubmitFinancingApply(PmcFinanceBankBaseQO query) {\n        if (StringUtils.isBlank(query.getPayCheckNum())) {\n            return \"付款单号不能为空\";\n        }\n        if (StringUtils.isBlank(query.getApplyNumber())) {\n            return \"融资单号不能为空\";\n        }\n        // 查询申请明细\n        PmcFinanceSupplierApply apply = pmcFinanceSupplierApplyMapper.selectByApplyNumber(query.getApplyNumber());\n        if (apply == null) {\n            return \"未找到对应的融资申请单\";\n        }\n        if (!apply.getStatus().equals(SupplierFinancingApplyStatus.SUBMITTED.name())) {\n            return \"pmc系统融资申请单状态不为已提交\";\n        }\n        return \"ok\";\n    }\n\n    /**\n     * 融资结果查询校验\n     */\n    private String validateQueryFinancingResult(Object query) {\n        return \"ok\";\n    }\n\n    /**\n     * 融资额度查询校验\n     */\n    private String validateQueryFinancingQuota(Object query) {\n        return \"ok\";\n    }\n\n    /**\n     * 文件操作校验\n     */\n    private String validateFileOperation(Object query) {\n        return \"ok\";\n    }\n\n    /**\n     * 默认校验\n     */\n    private String validateDefault(Object query) {\n        return \"ok\";\n    }\n\n    /**\n     * 更新申请状态\n     *\n     * @param request 请求参数对象，必须包含：\n     *                - applyNumber 申请单号\n     *                可选：\n     * @return boolean 更新是否成功\n     * @throws Exception 当参数错误或数据库操作异常时抛出\n     */\n    @Override\n    public boolean updateApplyStatusOrSendMeg(PmcFinanceBankBaseQO request) {\n        try {\n            if (request == null || StringUtils.isBlank(request.getApplyNumber())) {\n                log.error(\"更新申请状态失败：参数错误，申请单号不能为空\");\n                return false;\n            }\n            if (request.isBankDealStatus()) {\n                // 更新状态为已提交\n                int updated = pmcFinanceSupplierApplyMapper.updateStatusByApplyNumber(\n                        request.getApplyNumber(), SupplierFinancingApplyStatus.SUBMITTED.name());\n                return updated > 0;\n            } else {\n                // todo 发送预警消息待实现\n                log.info(\"融资申请-银行融资处理失败,发送如流消息\");\n                FndFlexValueDTO fndFlexValueDTO =\n                        fndFlexValueApi.selectByType(BizConstants.FndFlexSet.PMC_ALTER_MAIL, \"RULIU_FINANCE_ADMIN\");\n                Map<String, String> msgProperties = new HashMap<>();\n                msgProperties.put(\"applyNumber\", request.getApplyNumber());\n                msgProperties.put(\"failReason\", \"融资申请银行处理失败\");\n                msgProperties.put(\"payCheckNum\", request.getPayCheckNum());\n                msgProperties.put(\"supplierName\", request.getSupplierName());\n                msgProperties.put(\"supplierCode\", request.getSupplierCode());\n                msgProperties.put(\"bankCode\", request.getBankCode());\n                /*sendRuliuMsgService.sendMessage(msgProperties, templateId,\n                        (StringUtils.isEmpty(fndFlexValueDTO.getDescription())\n                                ? \"\" : fndFlexValueDTO.getDescription()));*/\n            }\n            return true;\n        } catch (Exception e) {\n            log.error(\"更新申请状态异常，申请单号：{}\",\n                    request != null ? request.getApplyNumber() : \"未知\", e);\n            return false;\n        }\n    }\n\n    @Override\n    public FinanceIndicatorDTO queryFinanceIndicators() {\n        PmcDataP2pSupplier pmcDataP2pSupplier = pmcDataP2pSupplierMapper.selectBySupplierCode(PmcPortalLogin.getSupId());\n        if (pmcDataP2pSupplier == null) {\n            throw new SecurityException(\"供应商信息不存在!\");\n        }\n        FinanceIndicatorDTO dto = new FinanceIndicatorDTO();\n\n        // 1. 当月可融资金额\n        Map<String, Object> monthAvailableMap = calculateCurrentMonthAvailableAmount(pmcDataP2pSupplier.getSupplierCode());\n        dto.setCurrentMonthAvailableAmount(new BigDecimal(monthAvailableMap.get(\"monthAmount\").toString()));\n\n        // 2. 当月融资金额\n        Map<String, Object> monthFinancedMap = calculateCurrentMonthFinancedAmount(pmcDataP2pSupplier.getSupplierCode());\n        dto.setCurrentMonthFinancedAmount(new BigDecimal(monthFinancedMap.get(\"monthAmount\").toString()));\n\n        // 3. 全年可融资金额\n        Map<String, Object> yearAvailableMap = calculateYearlyAvailableAmount(pmcDataP2pSupplier.getSupplierCode());\n        dto.setYearlyAvailableAmount(new BigDecimal(yearAvailableMap.get(\"yearAmount\").toString()));\n\n        // 4. 全年融资情况\n        Map<String, Object> yearFinancedMap = calculateYearlyFinancedAmount(pmcDataP2pSupplier.getSupplierCode());\n        dto.setYearlyFinancedAmount(new BigDecimal(yearFinancedMap.get(\"yearAmount\").toString()));\n\n        // 5. 当前可用额度\n        PmcPortalRemainQuotaQO qo = new PmcPortalRemainQuotaQO();\n        qo.setSupplierCode(pmcDataP2pSupplier.getSupplierCode());\n        dto.setCurrentAvailableQuota(calculateAvailableQuota(qo));\n\n        return dto;\n    }\n\n    private Map<String, Object> calculateCurrentMonthAvailableAmount(String supplierCode) {\n        // 取供应商当月审批完成，并且计划付款日期大于当前日期7天\n        // 单据状态=已审批&头寸审批通过的付款金额\n        List<String> statusList = Arrays.asList(PayStatus.APPROVED.name(), PayStatus.RELEASED.name());\n        Date currentDatePlus7Days = DateUtils.addDays(new Date(), 7);\n        Map<String, Object> result = pmcPayChecksMapper.sumAmountBySupplierAndMonth(\n                supplierCode,\n                statusList,\n                currentDatePlus7Days\n        );\n        return result;\n    }\n\n    private Map<String, Object> calculateCurrentMonthFinancedAmount(String supplierCode) {\n        // 取供应商融资申请日期在当月且融资申请状态不等于已保存，已拒绝，已驳回的融资申请金额\n        List<String> excludeStatuses = Arrays.asList(\n                SupplierFinancingApplyStatus.SAVED.name(),\n                SupplierFinancingApplyStatus.REJECTED.name(),\n                SupplierFinancingApplyStatus.REJECT.name()\n        );\n        Map<String, Object> result = pmcFinanceSupplierApplyMapper.sumAmountBySupplierAndMonth(\n                supplierCode,\n                excludeStatuses\n        );\n        return result;\n    }\n\n    private Map<String, Object> calculateYearlyAvailableAmount(String supplierCode) {\n        // 取供应商当年审批完成，并且计划付款日期大于当前日期7天\n        // 单据状态=已审批&头寸审批通过的付款金额\n        List<String> statusList = Arrays.asList(PayStatus.APPROVED.name(), PayStatus.RELEASED.name());\n        Date currentDatePlus7Days = DateUtils.addDays(new Date(), 7);\n        Map<String, Object> result = pmcPayChecksMapper.sumAmountBySupplierAndYear(\n                supplierCode,\n                statusList,\n                currentDatePlus7Days\n        );\n        return result;\n    }\n\n    private Map<String, Object> calculateYearlyFinancedAmount(String supplierCode) {\n        // 取供应商融资申请日期在当年且融资申请状态不等于已保存，已拒绝，已驳回的融资申请金额\n        List<String> excludeStatuses = Arrays.asList(\n                SupplierFinancingApplyStatus.SAVED.name(),\n                SupplierFinancingApplyStatus.REJECTED.name(),\n                SupplierFinancingApplyStatus.REJECT.name()\n        );\n        Map<String, Object> result = pmcFinanceSupplierApplyMapper.sumAmountBySupplierAndYear(\n                supplierCode,\n                excludeStatuses\n        );\n        return result;\n    }\n\n    private void checkData(PmcFinanceSupplierApplyDTO pmcFinanceSupplierApply) {\n        log.info(\"融资申请交检查数据：{}\", JSONObject.toJSONString(pmcFinanceSupplierApply));\n        // 1、付款单是否为已审批&头寸审批通过的，且计划付款日期是否在融资申请日期之后\n        PayChecksQO payChecksQO = new PayChecksQO();\n        payChecksQO.setPayCheckNum(pmcFinanceSupplierApply.getPayCheckNum());\n        List<PmcPayChecks> pmcPayCheck = pmcPayChecksMapper.selectPayChecks(payChecksQO);\n        if (pmcPayCheck.isEmpty()) {\n            throw new ServiceException(\"付款单不存在，付款单号: \" + pmcFinanceSupplierApply.getPayCheckNum());\n        }\n        PmcPayChecks payChecks = pmcPayCheck.get(0);\n        if (!PayStatus.APPROVED.name().equals(payChecks.getStatus()) && !PayStatus.RELEASED.name().equals(payChecks.getStatus())) {\n            log.error(\"付款单状态异常，付款单号: {}, 付款单状态: {}\", pmcFinanceSupplierApply.getPayCheckNum(), payChecks.getStatus());\n            throw new ServiceException(\"付款单状态异常\");\n        }\n\n        // 2、校验是否存在已保存的融资申请单\n        if (SupplierFinancingApplyStatus.SUBMITTED.name().equals(pmcFinanceSupplierApply.getStatus())) {\n            // 校验通过接着向下执行\n            Example example = new Example(PmcFinanceSupplierApply.class);\n            Example.Criteria criteria = example.createCriteria();\n            criteria.andEqualTo(\"payCheckNum\", pmcFinanceSupplierApply.getPayCheckNum());\n            criteria.andEqualTo(\"status\", SupplierFinancingApplyStatus.SAVED.name());\n            criteria.andNotEqualTo(\"applyNumber\", pmcFinanceSupplierApply.getApplyNumber());\n            // 判断是否存在该申请单\n            if (pmcFinanceSupplierApplyMapper.selectCountByExample(example) > 0) {\n                log.error(\"已存在保存状态的融资申请单，付款单号: {}, 供应商编码: {}\",\n                        pmcFinanceSupplierApply.getPayCheckNum(), pmcFinanceSupplierApply.getSupplierCode());\n                throw new ServiceException(\"已存在保存状态的融资申请单，请勿重复提交!\");\n            }\n        }\n\n        // 3、有效额度是否满足\n        PmcPortalRemainQuotaQO qo = new PmcPortalRemainQuotaQO();\n        qo.setSupplierCode(pmcFinanceSupplierApply.getSupplierCode());\n        qo.setCompanyCode(payChecks.getCompanyCode());\n        qo.setBankCode(pmcFinanceSupplierApply.getBankCode());\n        BigDecimal currentAvailableQuota = calculateAvailableQuota(qo);\n\n        if (currentAvailableQuota.compareTo(pmcFinanceSupplierApply.getAvailableAmount()) > 0) {\n            currentAvailableQuota = pmcFinanceSupplierApply.getAvailableAmount();\n        }\n\n        if (currentAvailableQuota.compareTo(pmcFinanceSupplierApply.getFinanceAmount()) <= 0) {\n            log.error(\"当前可用额度不足，供应商编码: {}, 可用额度: {}, 融资金额: {}\",\n                    qo.getSupplierCode(), currentAvailableQuota, pmcFinanceSupplierApply.getFinanceAmount());\n            throw new ServiceException(\"当前可用额度不足!\");\n        }\n\n        // 4、金额\n        boolean invoiceValid = payValidatorApi.validateInvoiceAmount(payChecks, null);\n        if (!invoiceValid) {\n            log.error(\"发票金额校验超付，付款单号: {}, 发票金额: {}\", pmcFinanceSupplierApply.getPayCheckNum(), payChecks.getAmount());\n            throw new ServiceException(\"发票金额校验超付不允许申请!\");\n        }\n    }\n\n\n    private PmcFinanceBankBaseQO assembleFinancingRequest(Map<String, Object> detail) {\n        // 融资申请单DTO - 安全类型转换\n        Object applyDTOObj = detail.get(\"applyDetail\");\n        PmcFinanceSupplierApplyDTO applyDTO = new PmcFinanceSupplierApplyDTO();\n        UtilType.copyProperties(applyDTO, applyDTOObj, true);\n        log.info(\"applyDTO:{}\", applyDTO);\n\n        // 付款单DTO - 安全类型转换\n        Object payChecksDTOObj = detail.get(\"payChecksSupplierCodeDTO\");\n        PmcPayChecksSupplierCodeDTO payChecksDTO = new PmcPayChecksSupplierCodeDTO();\n        UtilType.copyProperties(payChecksDTO, payChecksDTOObj, true);\n\n\n        // 供应商信息 - 安全类型转换\n        Object supplierObj = detail.get(\"supplier\");\n        PmcDataP2pSupplier supplier = new PmcDataP2pSupplier();\n        UtilType.copyProperties(supplier, supplierObj, true);\n\n\n        PmcFinanceBankBaseQO request = new PmcFinanceBankBaseQO();\n        // 基础信息 - 添加空值检查\n        request.setApplyNumber(applyDTO.getApplyNumber());\n        request.setPayCheckNum(applyDTO.getPayCheckNum());\n        request.setSupplierCode(applyDTO.getSupplierCode());\n        request.setSupplierName(applyDTO.getSupplierName());\n        request.setBankCode(applyDTO.getBankCode());\n        request.setCompanyCode(payChecksDTO.getCompanyCode());\n\n        request.setRegistrationCode(supplier.getRegistrationCode());\n        request.setPayPlanDate(applyDTO.getPatyPlanDate());\n\n\n        request.setFinanceAmount(applyDTO.getFinanceAmount());\n        request.setSupplierAccount(payChecksDTO.getAccount());\n        // todo 供应商开户银行和开户地址\n        request.setSupplierBank(StringUtils.isBlank(payChecksDTO.getBankCodeName()) ? applyDTO.getBankCodeName() : payChecksDTO.getBankCodeName());\n        request.setSupplierAddress(StringUtils.isBlank(payChecksDTO.getAttribute4()) ? payChecksDTO.getAttribute6() : payChecksDTO.getAttribute4());\n\n        request.setPayableAmount(request.getFinanceAmount());\n        request.setCurrency(applyDTO.getCurrency());\n        request.setFinanceNumber(applyDTO.getPayCheckNum());\n\n        // 发票信息\n        // request.setInvoiceType(payChecksDTO.getInvoiceType());\n        request.setInvoiceNumber(payChecksDTO.getInvoiceNumber());\n        request.setInvoiceCode(payChecksDTO.getInvoiceCode());\n        request.setInvoiceDate(payChecksDTO.getInvoiceDate());\n        request.setTaxExcludedAmount(payChecksDTO.getInvoiceAmount());\n        request.setDocumentAmount(payChecksDTO.getTotalAmount());\n\n        // 合同信息\n        request.setContractId(payChecksDTO.getPayChecksAttribute16());\n        request.setContractName(\"/\");\n        // 还款账户\n        request.setBuyerAccount(applyDTO.getPayAccount());\n\n        // 融资开始日期和融资结束日期\n        request.setFinanceStartDate(new Date());\n        request.setFinanceEndDate(applyDTO.getPatyPlanDate());\n\n        return request;\n    }\n\n    /**\n     * 校验银行融资基础请求参数\n     * @param request 融资请求参数\n     * @throws IllegalArgumentException 包含具体字段的错误提示\n     */\n    private void validateFinancingRequest(PmcFinanceBankBaseQO request) {\n        // 1. 基础信息校验\n        Validate.notBlank(request.getApplyNumber(), \"融资申请单号(applyNumber)不能为空\");\n        Validate.notBlank(request.getPayCheckNum(), \"付款单号(payCheckNum)不能为空\");\n        Validate.notBlank(request.getSupplierCode(), \"供应商编码(supplierCode)不能为空\");\n        Validate.notBlank(request.getSupplierName(), \"供应商名称(supplierName)不能为空\");\n        Validate.notBlank(request.getBankCode(), \"银行编码(bankCode)不能为空\");\n        Validate.notBlank(request.getCompanyCode(), \"公司编码(companyCode)不能为空\");\n\n        // 2. 金额校验\n        Validate.notNull(request.getFinanceAmount(), \"融资金额(financeAmount)不能为空\");\n        Validate.isTrue(request.getFinanceAmount().compareTo(BigDecimal.ZERO) > 0,\n                \"融资金额必须大于0\");\n\n        // 3. 账户信息校验\n        Validate.notBlank(request.getSupplierAccount(), \"供应商账户(supplierAccount)不能为空\");\n        Validate.notBlank(request.getSupplierBank(), \"供应商开户行(supplierBank)不能为空\");\n        Validate.notBlank(request.getSupplierAddress(), \"供应商开户地址(supplierAddress)不能为空\");\n\n        // 4. 时间校验\n        Validate.notNull(request.getPayPlanDate(), \"付款计划日期(payPlanDate)不能为空\");\n\n\n        // 5. 发票信息校验\n        Validate.notBlank(request.getInvoiceNumber(), \"发票号码(invoiceNumber)不能为空\");\n        Validate.notBlank(request.getInvoiceCode(), \"发票代码(invoiceCode)不能为空\");\n        Validate.notNull(request.getInvoiceDate(), \"发票日期(invoiceDate)不能为空\");\n\n\n        Validate.notNull(request.getTaxExcludedAmount(), \"不含税金额(taxExcludedAmount)不能为空\");\n        Validate.notNull(request.getDocumentAmount(), \"单据金额(documentAmount)不能为空\");\n\n        Validate.notBlank(request.getContractId(), \"合同ID(contractId)不能为空\");\n        Validate.notBlank(request.getContractName(), \"合同名称(contractName)不能为空\");\n        Validate.notBlank(request.getBuyerAccount(), \"还款账户(buyerAccount)不能为空\");\n\n    }\n}",
                "afterChangeFileContent": "package com.baidu.pmc.core.service.impl;\n\nimport com.alibaba.fastjson.JSONObject;\nimport com.baidu.pmc.common.component.PmcPortalLogin;\nimport com.baidu.pmc.common.component.SendRuliuMsgService;\nimport com.baidu.pmc.common.exception.ServiceException;\nimport com.baidu.pmc.common.utils.BeanUtils;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.common.utils.UtilType;\nimport com.baidu.pmc.core.api.PayValidatorApi;\nimport com.baidu.pmc.core.fnd.common.BizConstants;\nimport com.baidu.pmc.core.fnd.service.FndFlexValueApi;\nimport com.baidu.pmc.core.service.OperateByJDBC;\nimport com.baidu.pmc.core.service.PayChecksService;\nimport com.baidu.pmc.core.service.PmcPortalFinancingService;\nimport com.baidu.pmc.core.utils.FinancingApplicationNoUtil;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcAccountMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcDataP2pSupplierMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcFinanceCompQuotaSetMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcFinanceSupplierApplyHisMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcFinanceSupplierApplyMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcFinanceSupplierQuotaSetMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcPayChecksMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcPayIcInvoicesDataMapper;\nimport com.baidu.pmc.persistence.model.pmc.PmcPayIcInvoicesData;\nimport com.baidu.pmc.pojo.constants.Constants;\nimport com.baidu.pmc.pojo.constants.FinancingStatus;\nimport com.baidu.pmc.pojo.constants.PayStatus;\nimport com.baidu.pmc.pojo.constants.SupplierFinancingApplyStatus;\nimport com.baidu.pmc.pojo.dto.FinanceIndicatorDTO;\nimport com.baidu.pmc.pojo.dto.PayChecksDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceApplyNumberDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceCompQuotaSetDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyHisDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierQuotaSetDTO;\nimport com.baidu.pmc.pojo.dto.PmcPayChecksSupplierCodeDTO;\nimport com.baidu.pmc.pojo.dto.SupplierFinancingUsageDTO;\nimport com.baidu.pmc.pojo.dto.fnd.CodeDesc;\nimport com.baidu.pmc.pojo.dto.fnd.FndFlexValueDTO;\nimport com.baidu.pmc.pojo.model.PmcDataP2pSupplier;\nimport com.baidu.pmc.pojo.model.PmcFinanceCompQuotaSet;\nimport com.baidu.pmc.pojo.model.PmcFinanceSupplierApply;\nimport com.baidu.pmc.pojo.model.PmcFinanceSupplierApplyHis;\nimport com.baidu.pmc.pojo.model.PmcFinanceSupplierQuotaSet;\nimport com.baidu.pmc.pojo.model.PmcPayChecks;\nimport com.baidu.pmc.pojo.qo.PayChecksQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceBankBaseQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceCompQuotaSetQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceSupplierApplyQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceSupplierQuotaSetQO;\nimport com.baidu.pmc.pojo.qo.PmcPortalRemainQuotaQO;\nimport com.baidu.pmc.pojo.qo.PmcPortalSuggestQO;\nimport com.baidu.pmc.pojo.qo.SupplierFinancingUsageQO;\nimport com.github.pagehelper.Page;\nimport com.github.pagehelper.PageHelper;\nimport com.github.pagehelper.PageInfo;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections.CollectionUtils;\nimport org.apache.commons.lang3.Validate;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.beans.factory.annotation.Value;\nimport org.springframework.stereotype.Service;\nimport tk.mybatis.mapper.entity.Example;\n\nimport java.math.BigDecimal;\nimport java.util.Arrays;\nimport java.util.Collections;\nimport java.util.Date;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.stream.Collectors;\n\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.BANK_FINANCING_RATES;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.BANK_FINANCING_URL;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.BD_COMPANY;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.CURRENCY;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.PMC_FINANCE_QYOTA_BANK;\n\n\n@Slf4j\n@Service\npublic class PmcPortalFinancingServiceImpl implements PmcPortalFinancingService {\n\n    @Autowired\n    private PmcFinanceSupplierApplyMapper pmcFinanceSupplierApplyMapper;\n\n    @Autowired\n    private PmcDataP2pSupplierMapper pmcDataP2pSupplierMapper;\n\n    @Autowired\n    private PmcPayChecksMapper pmcPayChecksMapper;\n\n    @Autowired\n    private PmcFinanceSupplierApplyHisMapper pmcFinanceSupplierApplyHisMapper;\n\n    @Autowired\n    private PmcFinanceSupplierQuotaSetMapper pmcFinanceSupplierQuotaSetMapper;\n\n    @Autowired\n    private PmcFinanceCompQuotaSetMapper pmcFinanceCompQuotaSetMapper;\n\n    @Autowired\n    private OperateByJDBC operateByJDBC;\n\n    @Autowired\n    private PmcAccountMapper accountMapper;\n\n    @Autowired\n    private PmcPayIcInvoicesDataMapper pmcPayIcInvoicesDataMapper;\n\n    @Autowired\n    FndFlexValueApi fndFlexValueApi;\n\n    @Autowired\n    private PayValidatorApi payValidatorApi;\n\n    @Autowired\n    private SendRuliuMsgService sendRuliuMsgService;\n\n    @Value(\"${portal.failed.msgcenter.templateId}\")\n    private String templateId;\n\n    @Autowired\n    private PayChecksService payChecksService;\n    /**\n     * 根据供应商编码分页查询融资申请列表\n     *\n     * @param pmcFinanceSupplierApplyQO 查询条件对象，包含：\n     *                                  - pageNum 页码\n     *                                  - pageSize 每页条数\n     *                                  - supplierCode 供应商编码(自动从登录信息获取)\n     *                                  - status 申请状态(可选)\n     * @return PageInfo<PmcFinanceSupplierApplyDTO> 分页结果，包含：\n     * - 申请单基本信息\n     * - 银行名称(自动翻译)\n     * - 状态描述\n     * - 币种名称(自动翻译)\n     * - 银行URL(自动翻译)\n     * @throws SecurityException 当供应商信息不存在时抛出\n     */\n    @Override\n    public PageInfo<PmcFinanceSupplierApplyDTO> findByConditionSupplierCode(PmcFinanceSupplierApplyQO pmcFinanceSupplierApplyQO) {\n\n        PmcDataP2pSupplier pmcDataP2pSupplier = pmcDataP2pSupplierMapper.selectBySupplierCode(PmcPortalLogin.getSupId());\n        if (pmcDataP2pSupplier == null) {\n            log.error(\"供应商:{}信息不存在!\", PmcPortalLogin.getSupId());\n            throw new SecurityException(\"供应商信息不存在,您无权限使用该功能，请联系管理员!\");\n        }\n        pmcFinanceSupplierApplyQO.setSupplierCode(pmcDataP2pSupplier.getSupplierCode());\n\n        // 判断是否分页\n        if (pmcFinanceSupplierApplyQO.getPageNum() > 0\n                && pmcFinanceSupplierApplyQO.getPageSize() > 0) {\n            PageHelper.startPage(\n                    pmcFinanceSupplierApplyQO.getPageNum(),\n                    pmcFinanceSupplierApplyQO.getPageSize()\n            );\n        }\n        Page<PmcFinanceSupplierApplyDTO> page = (Page<PmcFinanceSupplierApplyDTO>) pmcFinanceSupplierApplyMapper.selectApplyListBySupplierCode(pmcFinanceSupplierApplyQO);\n        List<PmcFinanceSupplierApplyDTO> dtoList = page.getResult().stream()\n                .map(his -> {\n                    PmcFinanceSupplierApplyDTO dto = new PmcFinanceSupplierApplyDTO();\n                    BeanUtils.copyProperties(his, dto);\n                    dto.setStatusDesc(SupplierFinancingApplyStatus.getDescription(dto.getStatus()));\n                    dto.setBankUrl(operateByJDBC.translate(BANK_FINANCING_URL, dto.getBankCode()));\n                    return dto;\n                }).collect(Collectors.toList());\n\n        fndFlexValueApi.translate(dtoList, \"currency\", Constants.PmcLookupInfoCode.CURRENCY,\n                \"bankCode\", Constants.PmcLookupInfoCode.BANK);\n\n        PageInfo<PmcFinanceSupplierApplyDTO> pageInfo = new PageInfo<>();\n        BeanUtils.copyProperties(page.toPageInfo(), pageInfo);\n        pageInfo.setList(dtoList);\n        return pageInfo;\n    }\n\n    /**\n     * 导出供应商融资申请数据(供供应商使用)\n     *\n     * @param pmcFinanceSupplierApplyQO 查询条件对象，包含：\n     *                                  - supplierCode 供应商编码(自动从登录信息获取)\n     *                                  - status 申请状态(可选)\n     * @return List<PmcFinanceSupplierApplyDTO> 导出数据列表，包含：\n     * - 申请单基本信息\n     * - 银行名称(自动翻译)\n     * - 状态描述\n     * - 币种名称(自动翻译)\n     * - 银行URL(自动翻译)\n     * @throws SecurityException 当供应商信息不存在时抛出\n     */\n    @Override\n    public List<PmcFinanceSupplierApplyDTO> export(PmcFinanceSupplierApplyQO pmcFinanceSupplierApplyQO) {\n        PmcDataP2pSupplier pmcDataP2pSupplier = pmcDataP2pSupplierMapper.selectBySupplierCode(PmcPortalLogin.getSupId());\n        if (pmcDataP2pSupplier == null) {\n            throw new SecurityException(\"供应商信息不存在!\");\n        }\n        pmcFinanceSupplierApplyQO.setSupplierCode(pmcDataP2pSupplier.getSupplierCode());\n        return getListBySupplierCode(pmcFinanceSupplierApplyQO);\n    }\n\n    /**\n     * 导出所有融资申请数据(供管理员使用)\n     *\n     * @param pmcFinanceSupplierApplyQO 查询条件对象，包含：\n     *                                  - supplierCode 供应商编码(可选)\n     *                                  - status 申请状态(可选)\n     *                                  - applyNumber 申请单号(可选)\n     * @return List<PmcFinanceSupplierApplyDTO> 导出数据列表，包含：\n     * - 申请单基本信息\n     * - 银行名称(自动翻译)\n     * - 状态描述\n     * - 币种名称(自动翻译)\n     * - 操作节点描述(自动补充)\n     */\n    @Override\n    public List<PmcFinanceSupplierApplyDTO> admExport(PmcFinanceSupplierApplyQO pmcFinanceSupplierApplyQO) {\n        List<PmcFinanceSupplierApplyDTO> list =\n                pmcFinanceSupplierApplyMapper.selectApplyListByAll(pmcFinanceSupplierApplyQO);\n        List<PmcFinanceSupplierApplyDTO> dtoList = list.stream()\n                .map(his -> {\n                    PmcFinanceSupplierApplyDTO dto = new PmcFinanceSupplierApplyDTO();\n                    BeanUtils.copyProperties(his, dto);\n                    // 设置额外字段\n                    dto.setStatusDesc(SupplierFinancingApplyStatus.getDescription(dto.getStatus()));\n                    dto.setNextOperationNode(SupplierFinancingApplyStatus.getNextOperationNode(dto.getSupplierCode()));\n                    return dto;\n                }).collect(Collectors.toList());\n        fndFlexValueApi.translate(dtoList, \"currency\", Constants.PmcLookupInfoCode.CURRENCY,\n                \"bankCode\", Constants.PmcLookupInfoCode.BANK);\n\n        return dtoList;\n    }\n\n\n    private List<PmcFinanceSupplierApplyDTO> getListBySupplierCode(PmcFinanceSupplierApplyQO qo) {\n        List<PmcFinanceSupplierApplyDTO> list = pmcFinanceSupplierApplyMapper.selectApplyListBySupplierCode(qo);\n        List<PmcFinanceSupplierApplyDTO> dtoList = list.stream()\n                .map(his -> {\n                    PmcFinanceSupplierApplyDTO dto = new PmcFinanceSupplierApplyDTO();\n                    BeanUtils.copyProperties(his, dto);\n                    // 设置额外字段\n                    dto.setStatusDesc(SupplierFinancingApplyStatus.getDescription(dto.getStatus()));\n                    dto.setBankUrl(operateByJDBC.translate(BANK_FINANCING_URL, dto.getBankCode()));\n                    return dto;\n                }).collect(Collectors.toList());\n        fndFlexValueApi.translate(dtoList, \"currency\", Constants.PmcLookupInfoCode.CURRENCY,\n                \"bankCode\", Constants.PmcLookupInfoCode.BANK);\n        return dtoList;\n    }\n\n\n    /**\n     * 查询融资申请操作历史记录\n     *\n     * @param query 查询条件对象，必须包含：\n     *              - applyNumber 申请单号(必填)\n     *              可选：\n     *              - pageNum 页码\n     *              - pageSize 每页条数\n     * @return PageInfo<PmcFinanceSupplierApplyHisDTO> 分页历史记录，包含：\n     * - 操作时间\n     * - 操作节点\n     * - 操作描述\n     * - 操作节点描述(自动翻译)\n     * @throws IllegalArgumentException 当申请单号为空时抛出\n     */\n    @Override\n    public PageInfo<PmcFinanceSupplierApplyHisDTO> queryFinancingApplyHis(PmcFinanceSupplierApplyQO query) {\n        if (query.getApplyNumber() == null) {\n            throw new IllegalArgumentException(\"申请单号不能为空\");\n        }\n        // 判断是否分页\n        if (query.getPageNum() > 0 && query.getPageSize() > 0) {\n            PageHelper.startPage(query.getPageNum(), query.getPageSize());\n        }\n\n        Page<PmcFinanceSupplierApplyHis> hisList = (Page<PmcFinanceSupplierApplyHis>) pmcFinanceSupplierApplyHisMapper.selectByApplyNumber(query.getApplyNumber());\n\n        List<PmcFinanceSupplierApplyHisDTO> dtoList = hisList.stream().map(his -> {\n            PmcFinanceSupplierApplyHisDTO dto = new PmcFinanceSupplierApplyHisDTO();\n            BeanUtils.copyProperties(his, dto);\n            dto.setOperationNodeDesc(SupplierFinancingApplyStatus.getDescription(dto.getStatus()));\n            dto.setAttribute1(FinancingStatus.getDescriptionByValue(SupplierFinancingApplyStatus.getOperationNode(dto.getStatus())));\n            return dto;\n        }).collect(Collectors.toList());\n        PageInfo<PmcFinanceSupplierApplyHisDTO> pageInfo = new PageInfo<>();\n        BeanUtils.copyProperties(hisList.toPageInfo(), pageInfo);\n        pageInfo.setList(dtoList);\n        return pageInfo;\n    }\n\n    /**\n     * 查询所有融资申请(供管理员使用)\n     *\n     * @param pmcFinanceSupplierApplyQO 查询条件对象，包含：\n     *                                  - pageNum 页码\n     *                                  - pageSize 每页条数\n     *                                  - supplierCode 供应商编码(可选)\n     *                                  - status 申请状态(可选)\n     *                                  - applyNumber 申请单号(可选)\n     * @return PageInfo<PmcFinanceSupplierApplyDTO> 分页结果，包含：\n     * - 申请单基本信息\n     * - 银行名称(自动翻译)\n     * - 状态描述\n     * - 币种名称(自动翻译)\n     * - 操作节点描述(自动补充)\n     */\n    @Override\n    public PageInfo<PmcFinanceSupplierApplyDTO> findByConditionAll(PmcFinanceSupplierApplyQO pmcFinanceSupplierApplyQO) {\n        // 判断是否分页\n        if (pmcFinanceSupplierApplyQO.getPageNum() > 0\n                && pmcFinanceSupplierApplyQO.getPageSize() > 0) {\n            PageHelper.startPage(\n                    pmcFinanceSupplierApplyQO.getPageNum(),\n                    pmcFinanceSupplierApplyQO.getPageSize()\n            );\n        }\n        Page<PmcFinanceSupplierApplyDTO> list =\n                (Page<PmcFinanceSupplierApplyDTO>) pmcFinanceSupplierApplyMapper.selectApplyListByAll(pmcFinanceSupplierApplyQO);\n        List<PmcFinanceSupplierApplyDTO> dtoList = list.stream()\n                .map(his -> {\n                    PmcFinanceSupplierApplyDTO dto = new PmcFinanceSupplierApplyDTO();\n                    BeanUtils.copyProperties(his, dto);\n                    // 设置额外字段\n                    dto.setStatusDesc(SupplierFinancingApplyStatus.getDescription(dto.getStatus()));\n                    dto.setNextOperationNode(FinancingStatus.getDescriptionByValue(\n                            SupplierFinancingApplyStatus.getNextOperationNode(dto.getStatus())));\n                    return dto;\n                }).collect(Collectors.toList());\n        fndFlexValueApi.translate(dtoList,  \"currency\", Constants.PmcLookupInfoCode.CURRENCY, \"bankCode\",\n                Constants.PmcLookupInfoCode.BANK);\n        PageInfo<PmcFinanceSupplierApplyDTO> pageInfo = new PageInfo<>();\n        BeanUtils.copyProperties(list.toPageInfo(), pageInfo);\n        pageInfo.setList(dtoList);\n        return pageInfo;\n    }\n\n    /**\n     * 获取供应商可融资的付款单列表\n     *\n     * @param qo 查询条件对象，包含：\n     *           - pageNum 页码\n     *           - pageSize 每页条数\n     * @return PageInfo<PmcPayChecksSupplierCodeDTO> 分页结果，包含：\n     * - 付款单基本信息\n     * - 供应商信息\n     * - 融资天数计算\n     * - 币种名称(自动翻译)\n     * - 状态描述(自动翻译)\n     * - 可用金额(总金额-已融资金额)\n     * @throws SecurityException 当供应商信息不存在时抛出\n     */\n    @Override\n    public PageInfo<PmcPayChecksSupplierCodeDTO> getPayCheckList(PmcFinanceSupplierApplyQO qo) {\n\n        PmcDataP2pSupplier pmcDataP2pSupplier = pmcDataP2pSupplierMapper.selectBySupplierCode(PmcPortalLogin.getSupId());\n        if (pmcDataP2pSupplier == null) {\n            throw new SecurityException(\"供应商信息不存在!\");\n        }\n\n        // 准备查询参数\n        List<String> statusList = Arrays.asList(PayStatus.APPROVED.name(), PayStatus.RELEASED.name());\n\n        Date currentDatePlus3Days = DateUtils.addDays(new Date(), 7);\n\n        List<String> targetStatuses = Arrays.asList(\n                SupplierFinancingApplyStatus.SUBMITTED.name(),\n                SupplierFinancingApplyStatus.BANK_PROCESSING.name(),\n                SupplierFinancingApplyStatus.PENDING_DISBURSEMEN.name(),\n                SupplierFinancingApplyStatus.DISBURSED.name());\n        // 设置默认分页参数\n        int pageNum = qo.getPageNum() > 0 ? qo.getPageNum() : 1;\n        int pageSize = qo.getPageSize() > 0 ? qo.getPageSize() : 10;\n\n        // 启动分页\n        PageHelper.startPage(pageNum, pageSize);\n\n        // todo 这里暂时用供应商编码查询关联pmc_pay_checks.attribute15，后续方案调整再同步修改\n        Page<PmcPayChecksSupplierCodeDTO> page = (Page<PmcPayChecksSupplierCodeDTO>) pmcPayChecksMapper.\n                selectBySupplierCode(pmcDataP2pSupplier.getSupplierCode(), currentDatePlus3Days, statusList, targetStatuses);\n        List<PmcPayChecksSupplierCodeDTO> dtoList = page.getResult().stream()\n                .map(dto -> {\n                    // 创建新的DTO对象\n                    PmcPayChecksSupplierCodeDTO newDto = new PmcPayChecksSupplierCodeDTO();\n                    // 复制原DTO的属性\n                    BeanUtils.copyProperties(dto, newDto);\n\n                    // 设置属性\n                    newDto.setSupplierCode(pmcDataP2pSupplier.getSupplierCode());\n                    newDto.setSupplierName(pmcDataP2pSupplier.getSupplierName());\n                    newDto.setRegistrationCode(pmcDataP2pSupplier.getRegistrationCode());\n\n                    if (PayStatus.RELEASED.name().equals(newDto.getStatus()) ||\n                            PayStatus.APPROVED.name().equals(newDto.getStatus())) {\n                        newDto.setStatusName(\"待付款\");\n                    } else if (PayStatus.APPLY_FIN.name().equals(newDto.getStatus())) {\n                        newDto.setStatusName(\"融资申请中\");\n                    } else if (PayStatus.FINANCED.name().equals(newDto.getStatus())) {\n                        newDto.setStatusName(\"已融资\");\n                    }\n\n                    // 计算融资天数\n                    newDto.setFinanceDays(DateUtils.daysBetween(DateUtils.getCurrentDate(), dto.getPayPlanDate()));\n                    // 减去已使用的融资金额\n                    newDto.setUseAmount(newDto.getAmount().subtract(getUseFinancingAmt(newDto.getSupplierCode(), dto.getPayCheckNum())));\n                    return newDto;\n                })\n                .collect(Collectors.toList());\n        fndFlexValueApi.translate(dtoList, \"currency\", Constants.PmcLookupInfoCode.CURRENCY);\n\n        // 构建分页结果\n        PageInfo<PmcPayChecksSupplierCodeDTO> pageInfo = new PageInfo<>();\n        BeanUtils.copyProperties(page.toPageInfo(), pageInfo);\n        pageInfo.setList(dtoList);\n        return pageInfo;\n    }\n\n\n    /**\n     * 获取融资申请详情\n     *\n     * @param query 查询条件对象，必须包含：\n     *              - applyNumber 申请单号\n     * @return Map<String, Object> 包含：\n     * - applyDetail 申请单详情\n     * - historyList 操作历史记录\n     * - payChecksSupplierCodeDTO 付款单信息\n     * - supplier 供应商信息\n     * @throws IllegalArgumentException 当申请单号为空或未找到对应申请单时抛出\n     */\n    @Override\n    public Map<String, Object> getFinancingApplyDetail(PmcFinanceSupplierApplyQO query) {\n        // 参数校验\n        if (query == null || StringUtils.isBlank(query.getApplyNumber())) {\n            throw new IllegalArgumentException(\"申请单号不能为空\");\n        }\n\n        // 查询申请明细\n        PmcFinanceSupplierApply apply = pmcFinanceSupplierApplyMapper.selectByApplyNumber(query.getApplyNumber());\n        if (apply == null) {\n            throw new IllegalArgumentException(\"未找到对应的融资申请单\");\n        }\n        PmcFinanceSupplierApplyDTO applyDTO = new PmcFinanceSupplierApplyDTO();\n        BeanUtils.copyProperties(apply, applyDTO);\n        applyDTO.setStatusDesc(SupplierFinancingApplyStatus.getDescription(applyDTO.getStatus()));\n        applyDTO.setBankUrl(operateByJDBC.translate(BANK_FINANCING_URL, applyDTO.getBankCode()));\n\n        fndFlexValueApi.translate(applyDTO,  \"currency\", Constants.PmcLookupInfoCode.CURRENCY, \"bankCode\",\n                Constants.PmcLookupInfoCode.BANK);\n\n\n        // 查询单据状态历史记录\n        List<PmcFinanceSupplierApplyHis> hisList = pmcFinanceSupplierApplyHisMapper.selectByApplyNumber(query.getApplyNumber());\n        List<PmcFinanceSupplierApplyHisDTO> hisDtoList = hisList.stream().map(his -> {\n            PmcFinanceSupplierApplyHisDTO dto = new PmcFinanceSupplierApplyHisDTO();\n            BeanUtils.copyProperties(his, dto);\n            dto.setOperationNodeDesc(FinancingStatus.getDescriptionByValue(dto.getOperationNode()));\n            dto.setAttribute1(FinancingStatus.getDescriptionByValue(SupplierFinancingApplyStatus.getOperationNode(dto.getStatus())));\n            return dto;\n        }).collect(Collectors.toList());\n\n        // 查询付款单信息\n        PayChecksQO payChecksQO = new PayChecksQO();\n        payChecksQO.setPayCheckNum(applyDTO.getPayCheckNum());\n        PmcPayChecksSupplierCodeDTO payChecksSupplierCodeDTO = selectPmcPayCheckByPayCheckNum(payChecksQO);\n\n        // 查询供应商信息\n        PmcDataP2pSupplier supplier = pmcDataP2pSupplierMapper.selectBySupplierCode(applyDTO.getSupplierCode());\n\n        // 查询主体额度账户信息\n        PmcPortalRemainQuotaQO qo =  new PmcPortalRemainQuotaQO();\n        qo.setBankCode(applyDTO.getBankCode());\n        qo.setSupplierCode(payChecksSupplierCodeDTO.getCompanyCode());\n        List<PmcFinanceCompQuotaSet> compQuotaSet = queryValidCompQuotaSet(qo.getBankCode(), qo.getCompanyCode());\n        String buyAccount = compQuotaSet.get(0).getPayAccount();\n        applyDTO.setPayAccount(buyAccount);\n\n        // 查询发票信息\n        Example example = new Example(PmcPayIcInvoicesData.class);\n        Example.Criteria criteria = example.createCriteria();\n        criteria.andEqualTo(\"payCheckNum\", applyDTO.getPayCheckNum());\n        criteria.andEqualTo(\"checkId\", payChecksSupplierCodeDTO.getCheckId());\n        List<PmcPayIcInvoicesData> pmcPayIcInvoicesData = pmcPayIcInvoicesDataMapper.selectByExample(example);\n        if (CollectionUtils.isNotEmpty(pmcPayIcInvoicesData)) {\n            PmcPayIcInvoicesData payIcInvoicesData = pmcPayIcInvoicesData.get(0);\n            payChecksSupplierCodeDTO.setInvoiceAmount(payIcInvoicesData.getInvoiceAmount());\n            payChecksSupplierCodeDTO.setInvoiceDate(payIcInvoicesData.getInvoiceDate());\n            payChecksSupplierCodeDTO.setInvoiceNumber(payIcInvoicesData.getInvoiceNumber());\n            payChecksSupplierCodeDTO.setInvoiceType(payIcInvoicesData.getInvoiceType());\n            payChecksSupplierCodeDTO.setTotalAmount(payIcInvoicesData.getTotalAmount());\n            payChecksSupplierCodeDTO.setInvoiceCode(payIcInvoicesData.getInvoiceCode());\n        }\n\n        // 构建返回结果\n        Map<String, Object> resultMap = new HashMap<>();\n        resultMap.put(\"applyDetail\", applyDTO);\n        resultMap.put(\"historyList\", hisDtoList);\n        resultMap.put(\"payChecksSupplierCodeDTO\", payChecksSupplierCodeDTO);\n        resultMap.put(\"supplier\", supplier);\n        return resultMap;\n    }\n\n    /**\n     * 保存或更新融资申请\n     *\n     * @param pmcFinanceSupplierApplyDto 融资申请DTO对象，必须包含：\n     *                                   - applyNumber 申请单号\n     *                                   - sourceNum 原始单据号\n     *                                   - payCheckNum 付款单号\n     * @return boolean 操作是否成功\n     * @throws ServiceException 当必填参数为空或校验失败时抛出\n     */\n    @Override\n    public PmcFinanceBankBaseQO saveOrUpdateFinancingApply(PmcFinanceSupplierApplyDTO pmcFinanceSupplierApplyDto) {\n        PmcFinanceBankBaseQO pmcFinanceBankBaseQO = new PmcFinanceBankBaseQO();\n        PmcFinanceSupplierApply pmcFinanceSupplierApply = new PmcFinanceSupplierApply();\n        BeanUtils.copyProperties(pmcFinanceSupplierApplyDto, pmcFinanceSupplierApply);\n        // 创建融资申请单\n        if (pmcFinanceSupplierApply == null) {\n            log.error(\"融资申请单参数为空\");\n            throw new IllegalArgumentException(\"融资申请单不能为空\");\n        }\n        if (pmcFinanceSupplierApply.getSupplierCode() == null) {\n            PmcDataP2pSupplier pmcDataP2pSupplier = pmcDataP2pSupplierMapper.selectBySupplierCode(PmcPortalLogin.getSupId());\n            if (pmcDataP2pSupplier == null) {\n                throw new ServiceException(\"供应商信息不存在!\");\n            }\n            pmcFinanceSupplierApply.setSupplierCode(pmcDataP2pSupplier.getSupplierCode());\n        }\n\n        if (StringUtils.isBlank(pmcFinanceSupplierApply.getApplyNumber())) {\n            throw new ServiceException(\"融资申请单号不能为空!\");\n        }\n        if (StringUtils.isBlank(pmcFinanceSupplierApply.getSourceNum())) {\n            throw new ServiceException(\"原始单据号不能为空!\");\n        }\n        if (StringUtils.isBlank(pmcFinanceSupplierApply.getPayCheckNum())) {\n            throw new ServiceException(\"付款单号不能为空!\");\n        }\n        if (pmcFinanceSupplierApply.getFinanceAmount().compareTo(BigDecimal.ZERO) <= 0) {\n            throw new ServiceException(\"融资金额需大于0!\");\n        }\n\n        // 业务校验\n        checkData(pmcFinanceSupplierApplyDto);\n\n        // 校验通过接着向下执行\n        Example example = new Example(PmcFinanceSupplierApply.class);\n        Example.Criteria criteria = example.createCriteria();\n        criteria.andEqualTo(\"applyNumber\", pmcFinanceSupplierApply.getApplyNumber());\n        // 判断是否存在该申请单\n        if (pmcFinanceSupplierApplyMapper.selectCountByExample(example) > 0) {\n            if (pmcFinanceSupplierApply.getLastUpdateDate() == null) {\n                pmcFinanceSupplierApply.setLastUpdateDate(new Date());\n            }\n            if (SupplierFinancingApplyStatus.SUBMITTED.name().equals(pmcFinanceSupplierApply.getStatus())) {\n                // 提交逻辑\n                pmcFinanceSupplierApply.setStatus(SupplierFinancingApplyStatus.SEND_BANK.name());\n                payChecksService.updateFinanceApplyPay(pmcFinanceSupplierApply.getPayCheckNum());\n\n            }\n            int count = pmcFinanceSupplierApplyMapper.updateByExampleSelective(pmcFinanceSupplierApply, example);\n            if (count > 0) {\n                log.info(\"成功更新申请单，申请单号: {},付款单号:{}\", pmcFinanceSupplierApply.getApplyNumber(),\n                        pmcFinanceSupplierApply.getPayCheckNum());\n            }\n        } else {\n            // 设置操作人和时间\n            if (StringUtils.isBlank(pmcFinanceSupplierApply.getCreateBy())) {\n                pmcFinanceSupplierApply.setCreateBy(PmcPortalLogin.getLoginAccount());\n            }\n            pmcFinanceSupplierApply.setCreateDate(new Date());\n            pmcFinanceSupplierApply.setLastUpdateBy(pmcFinanceSupplierApply.getCreateBy());\n            pmcFinanceSupplierApply.setLastUpdateDate(new Date());\n            if (StringUtils.isBlank(pmcFinanceSupplierApply.getApplySubmit())) {\n                pmcFinanceSupplierApply.setApplySubmit(pmcFinanceSupplierApply.getCreateBy());\n            }\n\n            if (SupplierFinancingApplyStatus.SUBMITTED.name().equals(pmcFinanceSupplierApply.getStatus())) {\n                // 提交逻辑\n                pmcFinanceSupplierApply.setStatus(SupplierFinancingApplyStatus.SEND_BANK.name());\n                payChecksService.updateFinanceApplyPay(pmcFinanceSupplierApply.getPayCheckNum());\n\n            }\n            pmcFinanceSupplierApplyMapper.insert(pmcFinanceSupplierApply);\n            log.info(\"成功创建融资申请单，申请单号: {},付款单号:{}\", pmcFinanceSupplierApply.getApplyNumber(), pmcFinanceSupplierApply.getPayCheckNum());\n        }\n\n        PmcFinanceSupplierApplyHis his = new PmcFinanceSupplierApplyHis();\n        // 保存不增加操作步骤的记录，从提交开始增加\n        if (SupplierFinancingApplyStatus.SAVED.name().equals(pmcFinanceSupplierApplyDto.getStatus())) {\n            return pmcFinanceBankBaseQO;\n        }\n        BeanUtils.copyProperties(pmcFinanceSupplierApplyDto, his);\n        his.setApplyId(null);\n        // 操作人 供应商或者银行\n        his.setCreateDate(new Date());\n        his.setLastUpdateDate(new Date());\n        // SUBMITTED:提交申请\n        // BANK_CONFIRMED:网银确认\n        // BANK_REVIEWING:银行审核\n        // BANK_FUNDED:银行放款\n        his.setOperationNode(SupplierFinancingApplyStatus.getOperationNode(SupplierFinancingApplyStatus.SUBMITTED.name()));\n        pmcFinanceSupplierApplyHisMapper.insert(his);\n        log.info(\"成功创建融资申请历史记录，申请单号: {} ,付款单号:{}\", his.getApplyNumber(), his.getPayCheckNum());\n\n        // 更新剩余主体融资额度\n        updateRemainQuota(pmcFinanceSupplierApplyDto, \"1\");\n\n        // 组装报文返回\n        PmcFinanceSupplierApplyQO query = new PmcFinanceSupplierApplyQO();\n        query.setApplyNumber(his.getApplyNumber());\n        pmcFinanceBankBaseQO = assembleFinancingRequest(this.getFinancingApplyDetail(query));\n\n        try {\n            validateFinancingRequest(pmcFinanceBankBaseQO);\n        } catch (RuntimeException e) {\n            log.error(\"组装银行融资申请报文信息缺失，request: {}\", pmcFinanceBankBaseQO);\n            log.error(\"组装银行融资申请报文信息缺失，错误消息: {}\", e.getMessage());\n\n            // todo 发送预警消息待实现\n            // 阻断后续发送银行流程\n            // 发送如流消息\n            FndFlexValueDTO fndFlexValueDTO =\n                    fndFlexValueApi.selectByType(BizConstants.FndFlexSet.PMC_ALTER_MAIL, \"RULIU_FINANCE_ADMIN\");\n            Map<String, String> msgProperties = getStringMap(\"组装银行融资申请报文信息缺失, \" + e.getMessage(), pmcFinanceSupplierApplyDto);\n            log.info(\"融资申请-组装参数失败,发送如流消息\");\n            /*sendRuliuMsgService.sendMessage(msgProperties, templateId,\n                    (StringUtils.isEmpty(fndFlexValueDTO.getDescription())\n                            ? \"\" : fndFlexValueDTO.getDescription()));*/\n            throw new ServiceException(\"融资申请单已提交，但缺失部分信息，请耐心等待管理员处理或联系管理员邮箱！\");\n        }\n        return pmcFinanceBankBaseQO;\n    }\n\n    private Map<String, String> getStringMap(String failReason, PmcFinanceSupplierApplyDTO pmcFinanceSupplierApplyDto) {\n        Map<String, String> msgProperties = new HashMap<>();\n        msgProperties.put(\"bankCode\", pmcFinanceSupplierApplyDto.getBankCode() == null ? \"\" : pmcFinanceSupplierApplyDto.getBankCode());\n        msgProperties.put(\"supplierName\", pmcFinanceSupplierApplyDto.getSupplierName() == null ? \"\"\n                : pmcFinanceSupplierApplyDto.getSupplierName());\n        msgProperties.put(\"payCheckNum\", pmcFinanceSupplierApplyDto.getPayCheckNum() == null ? \"\"\n                : pmcFinanceSupplierApplyDto.getPayCheckNum());\n        msgProperties.put(\"failureReasons\", failReason == null ? \"\" : failReason);\n        msgProperties.put(\"date\", DateUtils.getDateTime());\n        return msgProperties;\n    }\n\n    private void updateRemainQuota(PmcFinanceSupplierApplyDTO pmcFinanceSupplierApplyDto, String flag) {\n        BigDecimal remainQuota = pmcFinanceSupplierApplyDto.getFinanceAmount();\n        Example example = new Example(PmcFinanceCompQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n        criteria.andEqualTo(\"bankCode\", pmcFinanceSupplierApplyDto.getBankCode());\n        criteria.andEqualTo(\"creditCompCode\", pmcFinanceSupplierApplyDto.getCompanyCode());\n        criteria.andEqualTo(\"enableFlag\", \"Y\");\n        criteria.andEqualTo(\"companyCode\", pmcFinanceSupplierApplyDto.getCompanyCode());\n        List<PmcFinanceCompQuotaSet> list = pmcFinanceCompQuotaSetMapper.selectByExample(example);\n        PmcFinanceCompQuotaSet quotaSet = list.get(0);\n        // 占用可使用额度\n        if (\"1\".equals(flag)) {\n            quotaSet.setAvailableFinancingQuota(quotaSet.getAvailableFinancingQuota().subtract(remainQuota));\n        } else {\n            // 回滚释放占用额度\n            quotaSet.setAvailableFinancingQuota(quotaSet.getAvailableFinancingQuota().add(remainQuota));\n        }\n        pmcFinanceCompQuotaSetMapper.updateByExampleSelective(quotaSet, example);\n    }\n\n\n    /**\n     * 根据付款单号查询付款数据\n     *\n     * @param payChecksQO 查询条件对象，必须包含：\n     *                    - payCheckNum 付款单号\n     * @return PmcPayChecksSupplierCodeDTO 付款单信息，包含：\n     * - 付款单基本信息\n     * - 供应商信息(自动补充)\n     * - 融资天数计算\n     * - 可用金额(总金额-已融资金额)\n     * - 币种名称(自动翻译)\n     * @throws IllegalArgumentException 当付款单号为空时抛出\n     */\n    @Override\n    public PmcPayChecksSupplierCodeDTO selectPmcPayCheckByPayCheckNum(PayChecksQO payChecksQO) {\n        // 1. 参数校验\n        if (payChecksQO == null || StringUtils.isBlank(payChecksQO.getPayCheckNum())) {\n            throw new IllegalArgumentException(\"付款单号不能为空\");\n        }\n\n        // 2. 查询付款记录\n        List<PayChecksDTO> pmcPayCheck = pmcPayChecksMapper.selectAllPayChecks(payChecksQO);\n\n        PmcPayChecksSupplierCodeDTO dto = new PmcPayChecksSupplierCodeDTO();\n        if (pmcPayCheck == null) {\n            return dto;\n        }\n\n        // 3. 属性拷贝\n        BeanUtils.copyProperties(pmcPayCheck.get(0), dto);\n\n        // 4. 计算日期差\n        if (dto.getPayPlanDate() != null) {\n            dto.setFinanceDays(DateUtils.daysBetween(DateUtils.getCurrentDate(), dto.getPayPlanDate()));\n        }\n\n        // 5. 补全供应商信息\n        if (StringUtils.isBlank(dto.getSupplierCode())) {\n            String supId = PmcPortalLogin.getSupId();\n            PmcDataP2pSupplier supplier = pmcDataP2pSupplierMapper.selectBySupplierCode(supId);\n            if (supplier == null) {\n                throw new ServiceException(\"供应商信息不存在: supId=\" + supId);\n            }\n            dto.setSupplierCode(supplier.getSupplierCode());\n            dto.setSupplierName(supplier.getSupplierName());\n            dto.setRegistrationCode(supplier.getRegistrationCode());\n        }\n        // 6. 减去已使用的融资金额\n        dto.setUseAmount(dto.getAmount().subtract(getUseFinancingAmt(dto.getSupplierCode(), dto.getPayCheckNum())));\n\n        // 7. 针对付款状态，头寸审核通过，已审批进行映射成代付款，\n        // 状态映射Map\n        Map<String, String> statusMap = Map.of(\n            PayStatus.RELEASED.name(), \"待付款\",\n            PayStatus.APPROVED.name(), \"待付款\",\n            PayStatus.APPLY_FIN.name(), \"融资申请中\",\n            PayStatus.FINANCED.name(), \"已融资\"\n        );\n        \n        dto.setStatusName(statusMap.getOrDefault(dto.getStatus(), dto.getStatusName()));\n\n        fndFlexValueApi.translate(dto, \"currency\", Constants.PmcLookupInfoCode.CURRENCY);\n        return dto;\n    }\n\n    /**\n     * 查询主体额度设置\n     *\n     * @param query 查询条件对象，可选：\n     *              - pageNum 页码\n     *              - pageSize 每页条数\n     *              - bankCode 银行编码\n     *              - creditCompCode 授信主体编码\n     *              - enableFlag 启用标志\n     *              - payAccount 付款账号\n     * @return PageInfo<PmcFinanceCompQuotaSetDTO> 分页结果，包含：\n     * - 主体额度基本信息\n     * - 公司名称(自动翻译)\n     * - 授信主体名称(自动翻译)\n     * - 银行名称(自动翻译)\n     * - 启用标志描述\n     * - 付款账号信息(自动补充)\n     */\n    @Override\n    public PageInfo<PmcFinanceCompQuotaSetDTO> selectQuotaSet(PmcFinanceCompQuotaSetQO query) {\n        // 判断是否分页\n        if (query.getPageNum() > 0\n                && query.getPageSize() > 0) {\n            PageHelper.startPage(\n                    query.getPageNum(),\n                    query.getPageSize()\n            );\n        }\n        Example example = new Example(PmcFinanceCompQuotaSet.class);\n\n        Example.Criteria criteria = example.createCriteria();\n        if (StringUtils.isNotBlank(query.getBankCode())) {\n            criteria.andEqualTo(\"bankCode\", query.getBankCode());\n        }\n        if (StringUtils.isNotBlank(query.getCreditCompCode())) {\n            criteria.andEqualTo(\"creditCompCode\", query.getCreditCompCode());\n        }\n        if (StringUtils.isNotBlank(query.getEnableFlag())) {\n            criteria.andEqualTo(\"enableFlag\", query.getEnableFlag());\n        }\n        if (StringUtils.isNotBlank(query.getPayAccount())) {\n            criteria.andEqualTo(\"payAccount\", query.getPayAccount());\n        }\n        if (StringUtils.isNotBlank(query.getCompanyCode())) {\n            criteria.andEqualTo(\"companyCode\", query.getCompanyCode());\n        }\n        Page<PmcFinanceCompQuotaSet> list = (Page<PmcFinanceCompQuotaSet>) pmcFinanceCompQuotaSetMapper.selectByExample(example);\n\n        List<PmcFinanceCompQuotaSetDTO> dtoList = list.stream().map(his -> {\n            PmcFinanceCompQuotaSetDTO dto = new PmcFinanceCompQuotaSetDTO();\n            BeanUtils.copyProperties(his, dto);\n            dto.setEnableFlagName((\"Y\".equals(dto.getEnableFlag()) ? \"是\" : \"否\"));\n            return dto;\n        }).collect(Collectors.toList());\n\n        fndFlexValueApi.translate(dtoList,  \"companyCode\", BD_COMPANY, \"creditCompCode\", BD_COMPANY, \"bankCode\",\n                Constants.PmcLookupInfoCode.BANK);\n\n        setPayAccountNames(dtoList);\n\n        PageInfo<PmcFinanceCompQuotaSetDTO> pageInfo = new PageInfo<>();\n        BeanUtils.copyProperties(list.toPageInfo(), pageInfo);\n        pageInfo.setList(dtoList);\n        return pageInfo;\n    }\n\n    @Override\n    public List<PmcFinanceCompQuotaSetDTO> exportQuotaSet(PmcFinanceCompQuotaSetQO query) {\n        return getQuotaSetList(query);\n    }\n\n    @Override\n    public Long saveOrUpdateCompQuotaSet(PmcFinanceCompQuotaSetDTO dto) {\n        PmcFinanceCompQuotaSet pmcFinanceCompQuotaSet = new PmcFinanceCompQuotaSet();\n        if (pmcFinanceCompQuotaSet == null) {\n            log.error(\"主体额度参数为空\");\n            throw new IllegalArgumentException(\"主体额度参数不能为空\");\n        }\n        BeanUtils.copyProperties(dto, pmcFinanceCompQuotaSet);\n        Example example = new Example(PmcFinanceCompQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n        criteria.andEqualTo(\"bankCode\", pmcFinanceCompQuotaSet.getBankCode());\n        criteria.andEqualTo(\"companyCode\", pmcFinanceCompQuotaSet.getCompanyCode());\n        criteria.andEqualTo(\"creditCompCode\", pmcFinanceCompQuotaSet.getCreditCompCode());\n        criteria.andEqualTo(\"enableFlag\", pmcFinanceCompQuotaSet.getEnableFlag());\n\n\n        if (pmcFinanceCompQuotaSetMapper.selectCountByExample(example) > 0) {\n            if (\"Y\".equals(dto.getAddFlag())) {\n                throw new IllegalArgumentException(\"该主体额度已存在，不能新增!\");\n            }\n            pmcFinanceCompQuotaSet.setLastUpdateDate(new Date());\n            int count = pmcFinanceCompQuotaSetMapper.updateByExampleSelective(pmcFinanceCompQuotaSet, example);\n            if (count > 0) {\n                log.info(\"更新主体额度成功，银行编码: {},公司编码:{}\", pmcFinanceCompQuotaSet.getBankCode(), pmcFinanceCompQuotaSet.getCompanyCode());\n            }\n            return pmcFinanceCompQuotaSet.getId();\n        } else {\n            // todo 用公司授信额度\n            if (\"N\".equals(dto.getAddFlag())) {\n                throw new IllegalArgumentException(\"该主体额度不允许修改主体，请新增对应公司、银行主体额度\");\n            }\n            pmcFinanceCompQuotaSet.setAvailableFinancingQuota(pmcFinanceCompQuotaSet.getCompanyCreditQuota());\n            pmcFinanceCompQuotaSet.setCreateDate(new Date());\n            pmcFinanceCompQuotaSetMapper.insert(pmcFinanceCompQuotaSet);\n            log.info(\"新增主体额度成功，银行编码: {},公司编码:{}\", pmcFinanceCompQuotaSet.getBankCode(), pmcFinanceCompQuotaSet.getCompanyCode());\n            return pmcFinanceCompQuotaSet.getId();\n        }\n    }\n\n    @Override\n    public PageInfo<PmcFinanceSupplierQuotaSetDTO> selectSupplierQuotaSet(PmcFinanceSupplierQuotaSetQO query) {\n        // 判断是否分页\n        if (query.getPageNum() > 0 && query.getPageSize() > 0) {\n            PageHelper.startPage(query.getPageNum(), query.getPageSize());\n        }\n\n        Example example = new Example(PmcFinanceSupplierQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n\n        if (StringUtils.isNotBlank(query.getSupplierName())) {\n            criteria.andEqualTo(\"supplierName\", query.getSupplierName());\n        }\n        if (StringUtils.isNotBlank(query.getSupplierCode())) {\n            criteria.andEqualTo(\"supplierCode\", query.getSupplierCode());\n        }\n        if (StringUtils.isNotBlank(query.getRegistrationCode())) {\n            criteria.andEqualTo(\"registrationCode\", query.getRegistrationCode());\n        }\n        if (StringUtils.isNotBlank(query.getFinanceFlag())) {\n            criteria.andEqualTo(\"financeFlag\", query.getFinanceFlag());\n        }\n        Page<PmcFinanceSupplierQuotaSet> list = (Page<PmcFinanceSupplierQuotaSet>) pmcFinanceSupplierQuotaSetMapper.selectByExample(example);\n        List<PmcFinanceSupplierQuotaSetDTO> dtoList = list.stream().map(his -> {\n            PmcFinanceSupplierQuotaSetDTO dto = new PmcFinanceSupplierQuotaSetDTO();\n            BeanUtils.copyProperties(his, dto);\n            dto.setFinanceFlagName((\"Y\".equals(dto.getFinanceFlag()) ? \"是\" : \"否\"));\n            return dto;\n        }).collect(Collectors.toList());\n        PageInfo<PmcFinanceSupplierQuotaSetDTO> pageInfo = new PageInfo<>();\n        BeanUtils.copyProperties(list.toPageInfo(), pageInfo);\n        pageInfo.setList(dtoList);\n        return pageInfo;\n    }\n\n    @Override\n    public PageInfo<SupplierFinancingUsageDTO> queryFinancingUsage(SupplierFinancingUsageQO qo) {\n        // 1. 参数校验和默认值设置\n        if (qo.getPageNum() > 0 && qo.getPageSize() > 0) {\n            PageHelper.startPage(qo.getPageNum(), qo.getPageSize());\n        }\n\n        // 3. 构建供应商额度查询条件\n        Example quotaExample = new Example(PmcFinanceSupplierQuotaSet.class);\n        quotaExample.orderBy(\"supplierName\").asc();\n        Example.Criteria quotaCriteria = quotaExample.createCriteria();\n        quotaCriteria.andEqualTo(\"financeFlag\", \"Y\");\n\n        if (StringUtils.isNotBlank(qo.getSupplierName())) {\n            quotaCriteria.andEqualTo(\"supplierName\", qo.getSupplierName());\n        }\n\n        // 4. 分页查询供应商额度\n        Page<PmcFinanceSupplierQuotaSet> quotaPage = (Page<PmcFinanceSupplierQuotaSet>)\n                pmcFinanceSupplierQuotaSetMapper.selectByExample(quotaExample);\n\n        // 5. 处理查询结果\n        if (CollectionUtils.isEmpty(quotaPage.getResult())) {\n            return new PageInfo<>(Collections.emptyList());\n        }\n\n        List<SupplierFinancingUsageDTO> dtoList = quotaPage.getResult().stream().map(quota -> {\n            SupplierFinancingUsageDTO dto = new SupplierFinancingUsageDTO();\n            BeanUtils.copyProperties(quota, dto, \"id\"); // 排除id字段\n\n            // 查询融资业务数据\n            Example financingExample = new Example(PmcFinanceSupplierApply.class);\n            Example.Criteria financingCriteria = financingExample.createCriteria();\n            financingCriteria.andEqualTo(\"supplierCode\", quota.getSupplierCode());\n\n            if (qo.getFinancingStartDate() != null) {\n                financingCriteria.andGreaterThanOrEqualTo(\"createDate\", qo.getFinancingStartDate());\n            }\n            if (qo.getFinancingEndDate() != null) {\n                financingCriteria.andLessThanOrEqualTo(\"createDate\", qo.getFinancingEndDate());\n            }\n\n            List<PmcFinanceSupplierApply> financingList = pmcFinanceSupplierApplyMapper.selectByExample(financingExample);\n\n            // 计算统计数据\n            dto.setTotalCount(financingList.size());\n            dto.setTotalAmount(financingList.stream()\n                    .map(PmcFinanceSupplierApply::getFinanceAmount)\n                    .reduce(BigDecimal.ZERO, BigDecimal::add));\n            return dto;\n        }).collect(Collectors.toList());\n\n        // 6. 构建分页结果\n        PageInfo<SupplierFinancingUsageDTO> pageInfo = new PageInfo<>();\n        BeanUtils.copyProperties(quotaPage.toPageInfo(), pageInfo);\n        pageInfo.setList(dtoList);\n        return pageInfo;\n    }\n\n    @Override\n    public List<PmcFinanceSupplierQuotaSetDTO> exportSupplierQuotaSet(PmcFinanceSupplierQuotaSetQO query) {\n        return getSupplierQuotaSetList(query);\n    }\n\n\n    @Override\n    public Long saveOrUpdateSupplierQuotaSet(PmcFinanceSupplierQuotaSetDTO dto) {\n        PmcFinanceSupplierQuotaSet pmcFinanceSupplierQuotaSet = new PmcFinanceSupplierQuotaSet();\n        BeanUtils.copyProperties(dto, pmcFinanceSupplierQuotaSet);\n        Example example = new Example(PmcFinanceSupplierQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n        criteria.andEqualTo(\"supplierCode\", pmcFinanceSupplierQuotaSet.getSupplierCode());\n        // 插入数据\n        if (pmcFinanceSupplierQuotaSetMapper.selectCountByExample(example) > 0) {\n            if (\"Y\".equals(dto.getAddFlag())) {\n                throw new IllegalArgumentException(\"该供应商额度已存在，不能新增!\");\n            }\n            pmcFinanceSupplierQuotaSet.setLastUpdateDate(new Date());\n            pmcFinanceSupplierQuotaSetMapper.updateByExampleSelective(pmcFinanceSupplierQuotaSet, example);\n            return pmcFinanceSupplierQuotaSet.getId();\n        } else {\n            pmcFinanceSupplierQuotaSet.setCreateDate(new Date());\n            pmcFinanceSupplierQuotaSetMapper.insert(pmcFinanceSupplierQuotaSet);\n            log.info(\"新增供应商额度成功，供应商编码: {}\", pmcFinanceSupplierQuotaSet.getSupplierCode());\n            return pmcFinanceSupplierQuotaSet.getId();\n        }\n    }\n\n\n    private List<PmcFinanceSupplierQuotaSetDTO> getSupplierQuotaSetList(PmcFinanceSupplierQuotaSetQO query) {\n        Example example = new Example(PmcFinanceSupplierQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n        if (StringUtils.isNotBlank(query.getSupplierName())) {\n            criteria.andEqualTo(\"supplierName\", query.getSupplierName());\n        }\n        if (StringUtils.isNotBlank(query.getSupplierCode())) {\n            criteria.andEqualTo(\"supplierCode\", query.getSupplierCode());\n        }\n\n        if (StringUtils.isNotBlank(query.getRegistrationCode())) {\n            criteria.andEqualTo(\"registrationCode\", query.getRegistrationCode());\n        }\n        if (StringUtils.isNotBlank(query.getFinanceFlag())) {\n            criteria.andEqualTo(\"financeFlag\", query.getFinanceFlag());\n        }\n        List<PmcFinanceSupplierQuotaSet> list = pmcFinanceSupplierQuotaSetMapper.selectByExample(example);\n        List<PmcFinanceSupplierQuotaSetDTO> dtoList = list.stream().map(his -> {\n            PmcFinanceSupplierQuotaSetDTO dto = new PmcFinanceSupplierQuotaSetDTO();\n            BeanUtils.copyProperties(his, dto);\n            dto.setFinanceFlagName((\"Y\".equals(dto.getFinanceFlag()) ? \"是\" : \"否\"));\n            return dto;\n        }).collect(Collectors.toList());\n        return dtoList;\n    }\n\n\n    private List<PmcFinanceCompQuotaSetDTO> getQuotaSetList(PmcFinanceCompQuotaSetQO query) {\n        Example example = new Example(PmcFinanceCompQuotaSet.class);\n\n        Example.Criteria criteria = example.createCriteria();\n        if (StringUtils.isNotBlank(query.getBankCode())) {\n            criteria.andEqualTo(\"bankCode\", query.getBankCode());\n        }\n        if (StringUtils.isNotBlank(query.getCreditCompCode())) {\n            criteria.andEqualTo(\"creditCompCode\", query.getCreditCompCode());\n        }\n        if (StringUtils.isNotBlank(query.getEnableFlag())) {\n            criteria.andEqualTo(\"enableFlag\", query.getEnableFlag());\n        }\n        if (StringUtils.isNotBlank(query.getPayAccount())) {\n            criteria.andEqualTo(\"payAccount\", query.getPayAccount());\n        }\n        if (StringUtils.isNotBlank(query.getCompanyCode())) {\n            criteria.andEqualTo(\"companyCode\", query.getCompanyCode());\n        }\n        List<PmcFinanceCompQuotaSet> list = pmcFinanceCompQuotaSetMapper.selectByExample(example);\n\n\n        List<PmcFinanceCompQuotaSetDTO> dtoList = list.stream().map(his -> {\n            PmcFinanceCompQuotaSetDTO dto = new PmcFinanceCompQuotaSetDTO();\n            BeanUtils.copyProperties(his, dto);\n            dto.setEnableFlagName((\"1\".equals(dto.getEnableFlag()) ? \"是\" : \"否\"));\n            return dto;\n        }).collect(Collectors.toList());\n\n        fndFlexValueApi.translate(dtoList,  \"companyCode\", BD_COMPANY, \"creditCompCode\", BD_COMPANY, \"bankCode\",\n                Constants.PmcLookupInfoCode.BANK);\n\n        setPayAccountNames(dtoList);\n        return dtoList;\n    }\n\n\n    private void setPayAccountNames(List<PmcFinanceCompQuotaSetDTO> list) {\n        if (CollectionUtils.isEmpty(list)) {\n            return;\n        }\n        // 收集所有accountNo\n        List<String> accountNos = list.stream()\n                .map(PmcFinanceCompQuotaSet::getPayAccount)\n                .filter(StringUtils::isNotBlank)\n                .distinct()\n                .collect(Collectors.toList());\n\n        if (CollectionUtils.isEmpty(accountNos)) {\n            return;\n        }\n        // 批量查询accountName\n        Map<String, String> accountNameMap = accountMapper.batchSelectAccountNames(accountNos);\n\n        // 为每条记录设置PayAccountName\n        list.forEach(dto -> {\n            if (StringUtils.isNotBlank(dto.getPayAccount())) {\n                dto.setPayAccountName(accountNameMap.get(dto.getPayAccount()));\n                String currencyName = (operateByJDBC.translate(CURRENCY, \"CNY\"));\n                dto.setPayAccountInfo(dto.getPayAccount() + \"-\" + currencyName + \"-\"\n                        + dto.getBankCodeName() + \"-\" + dto.getPayAccountName());\n            }\n        });\n    }\n\n    @Override\n    public Map<String, Object> getSelectInit() {\n        Map<String, Object> result = new HashMap<>();\n        // 获取所有融资状态及描述\n        List<CodeDesc> statusList = SupplierFinancingApplyStatus.getAllStatuses();\n\n        // 获取融资机构列表\n        List<CodeDesc> bankList = operateByJDBC.selectByCon(BANK_FINANCING_RATES)\n                .stream()\n                .map(info -> new CodeDesc(info.getFlexValue(), info.getDescription()))\n                .collect(Collectors.toList());\n\n        List<FndFlexValueDTO> enbleFlagList = fndFlexValueApi.selectByType(Constants.PmcLookupInfoCode.YES_NO);\n\n\n        // 获取公司列表\n        List<CodeDesc> cnmpanyList = operateByJDBC.selectByCon(BD_COMPANY)\n                .stream()\n                .map(info -> new CodeDesc(info.getFlexValue(), info.getDescription()))\n                .collect(Collectors.toList());\n\n        // 处理步骤列表\n        List<CodeDesc> dealList = FinancingStatus.getAllStatuses();\n\n        // 网银地址列表\n        List<CodeDesc> bankUrlList = operateByJDBC.selectByCon(BANK_FINANCING_URL)\n                .stream()\n                .map(info -> new CodeDesc(info.getFlexValue(), info.getDescription()))\n                .collect(Collectors.toList());\n\n        // 配置银行额度的接口\n        List<CodeDesc> bankQuotaList = operateByJDBC.selectByCon(PMC_FINANCE_QYOTA_BANK)\n                .stream()\n                .map(info -> new CodeDesc(info.getFlexValue(), info.getMeaning()))\n                .collect(Collectors.toList());\n\n        result.put(\"yesNo\", fndFlexValueApi.convertToCodedLabelDTO(enbleFlagList));\n        result.put(\"statusList\", statusList);\n        result.put(\"bankList\", bankList);\n        result.put(\"companyList\", cnmpanyList);\n        result.put(\"dealList\", dealList);\n        result.put(\"bankUrlList\", bankUrlList);\n        result.put(\"bankQuotaList\", bankQuotaList);\n\n        return result;\n    }\n\n    @Override\n    public BigDecimal calculateAvailableQuota(PmcPortalRemainQuotaQO qo) {\n        BigDecimal availableQuota;\n        // 1. 获取供应商额度\n        Example example = new Example(PmcFinanceSupplierQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n        criteria.andEqualTo(\"supplierCode\", qo.getSupplierCode());\n        criteria.andEqualTo(\"financeFlag\", \"Y\");\n        criteria.andGreaterThanOrEqualTo(\"effectiveEndDate\", new Date());\n        criteria.andLessThanOrEqualTo(\"effectiveStartDate\", new Date());\n        List<PmcFinanceSupplierQuotaSet> pmcFinanceSupplierQuotaSet\n                = pmcFinanceSupplierQuotaSetMapper.selectByExample(example);\n        if (CollectionUtils.isEmpty(pmcFinanceSupplierQuotaSet)) {\n            log.info(\"供应商{}额度计算，无额度配置\", qo.getSupplierCode());\n            return BigDecimal.ZERO;\n        }\n        availableQuota = pmcFinanceSupplierQuotaSet.get(0).getCreditQuota();\n\n        // 2. 获取已占用金额\n        BigDecimal usedQuota = getUseFinancingAmt(qo.getSupplierCode(), \"\");\n\n        // 3. 获取主体剩余额度\n        if (StringUtils.isNotBlank(qo.getCompanyCode()) && StringUtils.isNotBlank(qo.getBankCode())) {\n            List<PmcFinanceCompQuotaSet> compQuotaSet = queryValidCompQuotaSet(qo.getBankCode(), qo.getCompanyCode());\n            if (CollectionUtils.isNotEmpty(compQuotaSet)) {\n                log.info(\"供应商:{},供应商额度:{},主体额度:{},已用额度:{}\", qo.getSupplierCode(),\n                        availableQuota, compQuotaSet.get(0).getAvailableFinancingQuota(), usedQuota);\n                if (availableQuota.subtract(usedQuota).compareTo(compQuotaSet.get(0).getAvailableFinancingQuota()) > 0) {\n                    return compQuotaSet.get(0).getAvailableFinancingQuota();\n                }\n            } else {\n                log.info(\"主体{},银行{}额度计算，无额度配置\", qo.getCompanyCode(), qo.getBankCode());\n                return BigDecimal.ZERO;\n            }\n        }\n        return availableQuota.subtract(usedQuota);\n    }\n\n    /**\n     * 根据银行代码、公司代码查询有效的公司额度设置\n     * @param bankCode 银行代码\n     * @param companyCode 公司代码\n     * @return 符合条件的公司额度设置列表\n     */\n    private List<PmcFinanceCompQuotaSet> queryValidCompQuotaSet(String bankCode, String companyCode) {\n        Example exampleComp = new Example(PmcFinanceCompQuotaSet.class);\n        Example.Criteria criteriaComp = exampleComp.createCriteria();\n        criteriaComp.andEqualTo(\"bankCode\", bankCode);\n        criteriaComp.andEqualTo(\"companyCode\", companyCode);\n        criteriaComp.andEqualTo(\"enableFlag\", \"Y\");\n        return pmcFinanceCompQuotaSetMapper.selectByExample(exampleComp);\n    }\n\n    /**\n     * 供应商模糊查询建议\n     *\n     * @param parameter 查询参数对象，至少需要包含以下一个字段：\n     *                  - supplierCode 供应商编码(模糊匹配)\n     *                  - supplierName 供应商名称(模糊匹配)\n     *                  - registrationCode 注册号(模糊匹配)\n     * @return List<PmcDataP2pSupplier> 匹配的供应商列表\n     * @throws IllegalArgumentException 当所有查询参数都为空时抛出\n     */\n    @Override\n    public List<PmcDataP2pSupplier> selectSuggest(PmcPortalSuggestQO parameter) {\n        if (parameter == null || (StringUtils.isBlank(parameter.getSupplierCode())\n                && StringUtils.isBlank(parameter.getSupplierName()) && StringUtils.isBlank(parameter.getRegistrationCode()))) {\n            throw new IllegalArgumentException(\"查询关键字不能为空\");\n        }\n\n        Example example = new Example(PmcDataP2pSupplier.class);\n        Example.Criteria criteria = example.createCriteria();\n\n        String keyWord = \"\";\n        if (StringUtils.isNotBlank(parameter.getSupplierCode())) {\n            keyWord = \"%\" + parameter.getSupplierCode() + \"%\";\n            criteria.orLike(\"supplierCode\", keyWord);\n        } else if (StringUtils.isNotBlank(parameter.getSupplierName())) {\n            keyWord = \"%\" + parameter.getSupplierName() + \"%\";\n            criteria.orLike(\"supplierName\", keyWord);\n        } else if (StringUtils.isNotBlank(parameter.getRegistrationCode())) {\n            keyWord = \"%\" + parameter.getRegistrationCode() + \"%\";\n            criteria.orLike(\"registrationCode\", keyWord);\n        }\n\n        // 执行查询\n        List<PmcDataP2pSupplier> suppliers = pmcDataP2pSupplierMapper.selectByExample(example);\n\n        // 转换为CodeDesc列表\n        return suppliers;\n    }\n\n    /**\n     * 生成融资申请单号\n     *\n     * @return PmcFinanceApplyNumberDTO 包含生成的申请单号\n     * 格式：FIN + 年月日 + 6位随机数(如FIN20231012000001)\n     */\n    @Override\n    public PmcFinanceApplyNumberDTO generateFinancingApplicationNo() {\n        PmcFinanceApplyNumberDTO dto = new PmcFinanceApplyNumberDTO();\n        dto.setApplicationNo(FinancingApplicationNoUtil.generate());\n        return dto;\n    }\n\n    /**\n     * 计算已使用的融资金额\n     *\n     * @param supplierCode 供应商编码\n     * @param payCheckNum  付款单号(可选)\n     * @return BigDecimal 已使用的融资金额\n     * 计算规则：指定供应商/付款单下所有非终态融资申请的总金额\n     */\n    private BigDecimal getUseFinancingAmt(String supplierCode, String payCheckNum) {\n        BigDecimal usedQuota = new BigDecimal(0);\n        List<String> targetStatuses = Arrays.asList(\n                SupplierFinancingApplyStatus.SUBMITTED.name(),\n                SupplierFinancingApplyStatus.BANK_PROCESSING.name(),\n                SupplierFinancingApplyStatus.PENDING_DISBURSEMEN.name(),\n                SupplierFinancingApplyStatus.DISBURSED.name());\n        Map<String, Object> resultMap = pmcFinanceSupplierApplyMapper.selectSummaryByStatus(targetStatuses,\n                supplierCode, payCheckNum);\n        usedQuota = (BigDecimal) resultMap.get(\"totalAmount\");\n        return usedQuota;\n    }\n\n    /**\n     * 通用数据校验方法\n     *\n     * @param query      校验参数对象\n     * @param methodName 方法名称，决定校验逻辑：\n     *                   - \"calculateFinancing\": 融资测算校验\n     *                   - \"submitFinancingApply\": 融资申请提交校验\n     *                   - \"queryFinancingResult\": 融资结果查询校验\n     *                   - \"queryFinancingQuota\": 融资额度查询校验\n     *                   - \"uploadFinancingAttachment\": 附件上传校验\n     *                   - \"supplementFinancingAttachment\": 附件补充校验\n     * @return String 校验结果，\"ok\"表示校验通过，否则返回错误信息\n     */\n    @Override\n    public String commonCheckData(PmcFinanceBankBaseQO query, String methodName) {\n        try {\n            log.info(\"执行通用数据校验，方法名：{}，参数类型：{}\", methodName,\n                    query != null ? query.getClass().getSimpleName() : \"null\");\n            switch (methodName) {\n                case \"calculateFinancing\":\n                    return validateCalculateFinancing(query);\n                case \"submitFinancingApply\":\n                    return validateSubmitFinancingApply(query);\n                case \"queryFinancingResult\":\n                    return validateQueryFinancingResult(query);\n                case \"queryFinancingQuota\":\n                    return validateQueryFinancingQuota(query);\n                case \"uploadFinancingAttachment\":\n                case \"supplementFinancingAttachment\":\n                    return validateFileOperation(query);\n                default:\n                    log.warn(\"未知的方法名：{}，执行默认校验\", methodName);\n                    return validateDefault(query);\n            }\n\n        } catch (Exception e) {\n            log.error(\"通用数据校验异常，方法名：{}\", methodName, e);\n            return \"数据校验异常：\" + e.getMessage();\n        }\n    }\n\n    /**\n     * 融资测算校验\n     */\n    private String validateCalculateFinancing(PmcFinanceBankBaseQO query) {\n        return \"ok\";\n    }\n\n    /**\n     * 融资申请提交校验\n     */\n    private String validateSubmitFinancingApply(PmcFinanceBankBaseQO query) {\n        if (StringUtils.isBlank(query.getPayCheckNum())) {\n            return \"付款单号不能为空\";\n        }\n        if (StringUtils.isBlank(query.getApplyNumber())) {\n            return \"融资单号不能为空\";\n        }\n        // 查询申请明细\n        PmcFinanceSupplierApply apply = pmcFinanceSupplierApplyMapper.selectByApplyNumber(query.getApplyNumber());\n        if (apply == null) {\n            return \"未找到对应的融资申请单\";\n        }\n        if (!apply.getStatus().equals(SupplierFinancingApplyStatus.SUBMITTED.name())) {\n            return \"pmc系统融资申请单状态不为已提交\";\n        }\n        return \"ok\";\n    }\n\n    /**\n     * 融资结果查询校验\n     */\n    private String validateQueryFinancingResult(Object query) {\n        return \"ok\";\n    }\n\n    /**\n     * 融资额度查询校验\n     */\n    private String validateQueryFinancingQuota(Object query) {\n        return \"ok\";\n    }\n\n    /**\n     * 文件操作校验\n     */\n    private String validateFileOperation(Object query) {\n        return \"ok\";\n    }\n\n    /**\n     * 默认校验\n     */\n    private String validateDefault(Object query) {\n        return \"ok\";\n    }\n\n    /**\n     * 更新申请状态\n     *\n     * @param request 请求参数对象，必须包含：\n     *                - applyNumber 申请单号\n     *                可选：\n     * @return boolean 更新是否成功\n     * @throws Exception 当参数错误或数据库操作异常时抛出\n     */\n    @Override\n    public boolean updateApplyStatusOrSendMeg(PmcFinanceBankBaseQO request) {\n        try {\n            if (request == null || StringUtils.isBlank(request.getApplyNumber())) {\n                log.error(\"更新申请状态失败：参数错误，申请单号不能为空\");\n                return false;\n            }\n            if (request.isBankDealStatus()) {\n                // 更新状态为已提交\n                int updated = pmcFinanceSupplierApplyMapper.updateStatusByApplyNumber(\n                        request.getApplyNumber(), SupplierFinancingApplyStatus.SUBMITTED.name());\n                return updated > 0;\n            } else {\n                // todo 发送预警消息待实现\n                log.info(\"融资申请-银行融资处理失败,发送如流消息\");\n                FndFlexValueDTO fndFlexValueDTO =\n                        fndFlexValueApi.selectByType(BizConstants.FndFlexSet.PMC_ALTER_MAIL, \"RULIU_FINANCE_ADMIN\");\n                Map<String, String> msgProperties = new HashMap<>();\n                msgProperties.put(\"applyNumber\", request.getApplyNumber());\n                msgProperties.put(\"failReason\", \"融资申请银行处理失败\");\n                msgProperties.put(\"payCheckNum\", request.getPayCheckNum());\n                msgProperties.put(\"supplierName\", request.getSupplierName());\n                msgProperties.put(\"supplierCode\", request.getSupplierCode());\n                msgProperties.put(\"bankCode\", request.getBankCode());\n                /*sendRuliuMsgService.sendMessage(msgProperties, templateId,\n                        (StringUtils.isEmpty(fndFlexValueDTO.getDescription())\n                                ? \"\" : fndFlexValueDTO.getDescription()));*/\n            }\n            return true;\n        } catch (Exception e) {\n            log.error(\"更新申请状态异常，申请单号：{}\",\n                    request != null ? request.getApplyNumber() : \"未知\", e);\n            return false;\n        }\n    }\n\n    @Override\n    public FinanceIndicatorDTO queryFinanceIndicators() {\n        PmcDataP2pSupplier pmcDataP2pSupplier = pmcDataP2pSupplierMapper.selectBySupplierCode(PmcPortalLogin.getSupId());\n        if (pmcDataP2pSupplier == null) {\n            throw new SecurityException(\"供应商信息不存在!\");\n        }\n        FinanceIndicatorDTO dto = new FinanceIndicatorDTO();\n\n        // 1. 当月可融资金额\n        Map<String, Object> monthAvailableMap = calculateCurrentMonthAvailableAmount(pmcDataP2pSupplier.getSupplierCode());\n        dto.setCurrentMonthAvailableAmount(new BigDecimal(monthAvailableMap.get(\"monthAmount\").toString()));\n\n        // 2. 当月融资金额\n        Map<String, Object> monthFinancedMap = calculateCurrentMonthFinancedAmount(pmcDataP2pSupplier.getSupplierCode());\n        dto.setCurrentMonthFinancedAmount(new BigDecimal(monthFinancedMap.get(\"monthAmount\").toString()));\n\n        // 3. 全年可融资金额\n        Map<String, Object> yearAvailableMap = calculateYearlyAvailableAmount(pmcDataP2pSupplier.getSupplierCode());\n        dto.setYearlyAvailableAmount(new BigDecimal(yearAvailableMap.get(\"yearAmount\").toString()));\n\n        // 4. 全年融资情况\n        Map<String, Object> yearFinancedMap = calculateYearlyFinancedAmount(pmcDataP2pSupplier.getSupplierCode());\n        dto.setYearlyFinancedAmount(new BigDecimal(yearFinancedMap.get(\"yearAmount\").toString()));\n\n        // 5. 当前可用额度\n        PmcPortalRemainQuotaQO qo = new PmcPortalRemainQuotaQO();\n        qo.setSupplierCode(pmcDataP2pSupplier.getSupplierCode());\n        dto.setCurrentAvailableQuota(calculateAvailableQuota(qo));\n\n        return dto;\n    }\n\n    private Map<String, Object> calculateCurrentMonthAvailableAmount(String supplierCode) {\n        // 取供应商当月审批完成，并且计划付款日期大于当前日期7天\n        // 单据状态=已审批&头寸审批通过的付款金额\n        List<String> statusList = Arrays.asList(PayStatus.APPROVED.name(), PayStatus.RELEASED.name());\n        Date currentDatePlus7Days = DateUtils.addDays(new Date(), 7);\n        Map<String, Object> result = pmcPayChecksMapper.sumAmountBySupplierAndMonth(\n                supplierCode,\n                statusList,\n                currentDatePlus7Days\n        );\n        return result;\n    }\n\n    private Map<String, Object> calculateCurrentMonthFinancedAmount(String supplierCode) {\n        // 取供应商融资申请日期在当月且融资申请状态不等于已保存，已拒绝，已驳回的融资申请金额\n        List<String> excludeStatuses = Arrays.asList(\n                SupplierFinancingApplyStatus.SAVED.name(),\n                SupplierFinancingApplyStatus.REJECTED.name(),\n                SupplierFinancingApplyStatus.REJECT.name()\n        );\n        Map<String, Object> result = pmcFinanceSupplierApplyMapper.sumAmountBySupplierAndMonth(\n                supplierCode,\n                excludeStatuses\n        );\n        return result;\n    }\n\n    private Map<String, Object> calculateYearlyAvailableAmount(String supplierCode) {\n        // 取供应商当年审批完成，并且计划付款日期大于当前日期7天\n        // 单据状态=已审批&头寸审批通过的付款金额\n        List<String> statusList = Arrays.asList(PayStatus.APPROVED.name(), PayStatus.RELEASED.name());\n        Date currentDatePlus7Days = DateUtils.addDays(new Date(), 7);\n        Map<String, Object> result = pmcPayChecksMapper.sumAmountBySupplierAndYear(\n                supplierCode,\n                statusList,\n                currentDatePlus7Days\n        );\n        return result;\n    }\n\n    private Map<String, Object> calculateYearlyFinancedAmount(String supplierCode) {\n        // 取供应商融资申请日期在当年且融资申请状态不等于已保存，已拒绝，已驳回的融资申请金额\n        List<String> excludeStatuses = Arrays.asList(\n                SupplierFinancingApplyStatus.SAVED.name(),\n                SupplierFinancingApplyStatus.REJECTED.name(),\n                SupplierFinancingApplyStatus.REJECT.name()\n        );\n        Map<String, Object> result = pmcFinanceSupplierApplyMapper.sumAmountBySupplierAndYear(\n                supplierCode,\n                excludeStatuses\n        );\n        return result;\n    }\n\n    private void checkData(PmcFinanceSupplierApplyDTO pmcFinanceSupplierApply) {\n        log.info(\"融资申请交检查数据：{}\", JSONObject.toJSONString(pmcFinanceSupplierApply));\n        // 1、付款单是否为已审批&头寸审批通过的，且计划付款日期是否在融资申请日期之后\n        PayChecksQO payChecksQO = new PayChecksQO();\n        payChecksQO.setPayCheckNum(pmcFinanceSupplierApply.getPayCheckNum());\n        List<PmcPayChecks> pmcPayCheck = pmcPayChecksMapper.selectPayChecks(payChecksQO);\n        if (pmcPayCheck.isEmpty()) {\n            throw new ServiceException(\"付款单不存在，付款单号: \" + pmcFinanceSupplierApply.getPayCheckNum());\n        }\n        PmcPayChecks payChecks = pmcPayCheck.get(0);\n        if (!PayStatus.APPROVED.name().equals(payChecks.getStatus()) && !PayStatus.RELEASED.name().equals(payChecks.getStatus())) {\n            log.error(\"付款单状态异常，付款单号: {}, 付款单状态: {}\", pmcFinanceSupplierApply.getPayCheckNum(), payChecks.getStatus());\n            throw new ServiceException(\"付款单状态异常\");\n        }\n\n        // 2、校验是否存在已保存的融资申请单\n        if (SupplierFinancingApplyStatus.SUBMITTED.name().equals(pmcFinanceSupplierApply.getStatus())) {\n            // 校验通过接着向下执行\n            Example example = new Example(PmcFinanceSupplierApply.class);\n            Example.Criteria criteria = example.createCriteria();\n            criteria.andEqualTo(\"payCheckNum\", pmcFinanceSupplierApply.getPayCheckNum());\n            criteria.andEqualTo(\"status\", SupplierFinancingApplyStatus.SAVED.name());\n            criteria.andNotEqualTo(\"applyNumber\", pmcFinanceSupplierApply.getApplyNumber());\n            // 判断是否存在该申请单\n            if (pmcFinanceSupplierApplyMapper.selectCountByExample(example) > 0) {\n                log.error(\"已存在保存状态的融资申请单，付款单号: {}, 供应商编码: {}\",\n                        pmcFinanceSupplierApply.getPayCheckNum(), pmcFinanceSupplierApply.getSupplierCode());\n                throw new ServiceException(\"已存在保存状态的融资申请单，请勿重复提交!\");\n            }\n        }\n\n        // 3、有效额度是否满足\n        PmcPortalRemainQuotaQO qo = new PmcPortalRemainQuotaQO();\n        qo.setSupplierCode(pmcFinanceSupplierApply.getSupplierCode());\n        qo.setCompanyCode(payChecks.getCompanyCode());\n        qo.setBankCode(pmcFinanceSupplierApply.getBankCode());\n        BigDecimal currentAvailableQuota = calculateAvailableQuota(qo);\n\n        if (currentAvailableQuota.compareTo(pmcFinanceSupplierApply.getAvailableAmount()) > 0) {\n            currentAvailableQuota = pmcFinanceSupplierApply.getAvailableAmount();\n        }\n\n        if (currentAvailableQuota.compareTo(pmcFinanceSupplierApply.getFinanceAmount()) <= 0) {\n            log.error(\"当前可用额度不足，供应商编码: {}, 可用额度: {}, 融资金额: {}\",\n                    qo.getSupplierCode(), currentAvailableQuota, pmcFinanceSupplierApply.getFinanceAmount());\n            throw new ServiceException(\"当前可用额度不足!\");\n        }\n\n        // 4、金额\n        boolean invoiceValid = payValidatorApi.validateInvoiceAmount(payChecks, null);\n        if (!invoiceValid) {\n            log.error(\"发票金额校验超付，付款单号: {}, 发票金额: {}\", pmcFinanceSupplierApply.getPayCheckNum(), payChecks.getAmount());\n            throw new ServiceException(\"发票金额校验超付不允许申请!\");\n        }\n    }\n\n\n    private PmcFinanceBankBaseQO assembleFinancingRequest(Map<String, Object> detail) {\n        // 融资申请单DTO - 安全类型转换\n        Object applyDTOObj = detail.get(\"applyDetail\");\n        PmcFinanceSupplierApplyDTO applyDTO = new PmcFinanceSupplierApplyDTO();\n        UtilType.copyProperties(applyDTO, applyDTOObj, true);\n        log.info(\"applyDTO:{}\", applyDTO);\n\n        // 付款单DTO - 安全类型转换\n        Object payChecksDTOObj = detail.get(\"payChecksSupplierCodeDTO\");\n        PmcPayChecksSupplierCodeDTO payChecksDTO = new PmcPayChecksSupplierCodeDTO();\n        UtilType.copyProperties(payChecksDTO, payChecksDTOObj, true);\n\n\n        // 供应商信息 - 安全类型转换\n        Object supplierObj = detail.get(\"supplier\");\n        PmcDataP2pSupplier supplier = new PmcDataP2pSupplier();\n        UtilType.copyProperties(supplier, supplierObj, true);\n\n\n        PmcFinanceBankBaseQO request = new PmcFinanceBankBaseQO();\n        // 基础信息 - 添加空值检查\n        request.setApplyNumber(applyDTO.getApplyNumber());\n        request.setPayCheckNum(applyDTO.getPayCheckNum());\n        request.setSupplierCode(applyDTO.getSupplierCode());\n        request.setSupplierName(applyDTO.getSupplierName());\n        request.setBankCode(applyDTO.getBankCode());\n        request.setCompanyCode(payChecksDTO.getCompanyCode());\n\n        request.setRegistrationCode(supplier.getRegistrationCode());\n        request.setPayPlanDate(applyDTO.getPatyPlanDate());\n\n\n        request.setFinanceAmount(applyDTO.getFinanceAmount());\n        request.setSupplierAccount(payChecksDTO.getAccount());\n        // todo 供应商开户银行和开户地址\n        request.setSupplierBank(StringUtils.isBlank(payChecksDTO.getBankCodeName()) ? applyDTO.getBankCodeName() : payChecksDTO.getBankCodeName());\n        request.setSupplierAddress(StringUtils.isBlank(payChecksDTO.getAttribute4()) ? payChecksDTO.getAttribute6() : payChecksDTO.getAttribute4());\n\n        request.setPayableAmount(request.getFinanceAmount());\n        request.setCurrency(applyDTO.getCurrency());\n        request.setFinanceNumber(applyDTO.getPayCheckNum());\n\n        // 发票信息\n        // request.setInvoiceType(payChecksDTO.getInvoiceType());\n        request.setInvoiceNumber(payChecksDTO.getInvoiceNumber());\n        request.setInvoiceCode(payChecksDTO.getInvoiceCode());\n        request.setInvoiceDate(payChecksDTO.getInvoiceDate());\n        request.setTaxExcludedAmount(payChecksDTO.getInvoiceAmount());\n        request.setDocumentAmount(payChecksDTO.getTotalAmount());\n\n        // 合同信息\n        request.setContractId(payChecksDTO.getPayChecksAttribute16());\n        request.setContractName(\"/\");\n        // 还款账户\n        request.setBuyerAccount(applyDTO.getPayAccount());\n\n        // 融资开始日期和融资结束日期\n        request.setFinanceStartDate(new Date());\n        request.setFinanceEndDate(applyDTO.getPatyPlanDate());\n\n        return request;\n    }\n\n    /**\n     * 校验银行融资基础请求参数\n     * @param request 融资请求参数\n     * @throws IllegalArgumentException 包含具体字段的错误提示\n     */\n    private void validateFinancingRequest(PmcFinanceBankBaseQO request) {\n        // 1. 基础信息校验\n        Validate.notBlank(request.getApplyNumber(), \"融资申请单号(applyNumber)不能为空\");\n        Validate.notBlank(request.getPayCheckNum(), \"付款单号(payCheckNum)不能为空\");\n        Validate.notBlank(request.getSupplierCode(), \"供应商编码(supplierCode)不能为空\");\n        Validate.notBlank(request.getSupplierName(), \"供应商名称(supplierName)不能为空\");\n        Validate.notBlank(request.getBankCode(), \"银行编码(bankCode)不能为空\");\n        Validate.notBlank(request.getCompanyCode(), \"公司编码(companyCode)不能为空\");\n\n        // 2. 金额校验\n        Validate.notNull(request.getFinanceAmount(), \"融资金额(financeAmount)不能为空\");\n        Validate.isTrue(request.getFinanceAmount().compareTo(BigDecimal.ZERO) > 0,\n                \"融资金额必须大于0\");\n\n        // 3. 账户信息校验\n        Validate.notBlank(request.getSupplierAccount(), \"供应商账户(supplierAccount)不能为空\");\n        Validate.notBlank(request.getSupplierBank(), \"供应商开户行(supplierBank)不能为空\");\n        Validate.notBlank(request.getSupplierAddress(), \"供应商开户地址(supplierAddress)不能为空\");\n\n        // 4. 时间校验\n        Validate.notNull(request.getPayPlanDate(), \"付款计划日期(payPlanDate)不能为空\");\n\n\n        // 5. 发票信息校验\n        Validate.notBlank(request.getInvoiceNumber(), \"发票号码(invoiceNumber)不能为空\");\n        Validate.notBlank(request.getInvoiceCode(), \"发票代码(invoiceCode)不能为空\");\n        Validate.notNull(request.getInvoiceDate(), \"发票日期(invoiceDate)不能为空\");\n\n\n        Validate.notNull(request.getTaxExcludedAmount(), \"不含税金额(taxExcludedAmount)不能为空\");\n        Validate.notNull(request.getDocumentAmount(), \"单据金额(documentAmount)不能为空\");\n\n        Validate.notBlank(request.getContractId(), \"合同ID(contractId)不能为空\");\n        Validate.notBlank(request.getContractName(), \"合同名称(contractName)不能为空\");\n        Validate.notBlank(request.getBuyerAccount(), \"还款账户(buyerAccount)不能为空\");\n\n    }\n}"
