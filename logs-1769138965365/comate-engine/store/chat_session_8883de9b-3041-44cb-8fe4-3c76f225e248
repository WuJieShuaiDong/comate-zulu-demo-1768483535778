n            }\n        } catch (Exception e) {\n            log.error(\"homeReufndDeal 账户退票查询失败\", e);\n        }\n        return res;\n    }\n\n    /**\n     * 处理退票\n     * @return\n     */\n    private String dealRefundInfo(RefundInfo refundInfo, String bankCode) {\n        log.info(\"退票处理 refundInfo={}\", JSON.toJSONString(refundInfo));\n        // 查询退票对应的支付指令\n        String trnUid = refundInfo.getTrnUid();\n        String account = refundInfo.getAccount();\n        String bankSuffix = pmcPayCommonBankColSetService.getBankSuffix(bankCode);\n        List<String> instructCol = pmcPayCommonBankColSetService.getBankCommonInstructDynamic(bankCode);\n        DynamicTableDto dynamicTableDto = new DynamicTableDto();\n        dynamicTableDto.setTableName(Constants.BANK_COMMON_INSTRUCT_TABLE.replaceAll(\"\\\\$\\\\{bankSuffix}\", bankSuffix));\n        dynamicTableDto.setSelectColumns(instructCol);\n        Map<String, String> whereEqualColumns = new HashMap<>();\n        whereEqualColumns.put(\"bank_code\", bankCode);\n        whereEqualColumns.put(\"account\", account);\n        whereEqualColumns.put(\"trn_uid\", trnUid);\n        dynamicTableDto.setWhereEqColumns(whereEqualColumns);\n        List<Map<String, Object>> payInstructDTOs = bankCommonPayInstructInterService.dynamicSelect(dynamicTableDto);\n        if (CollectionUtils.isNotEmpty(payInstructDTOs)) {\n            Map<String, Object> instruct = payInstructDTOs.get(0);\n            String status = StringUtils.toString(instruct.get(\"status\"));\n            if (PayStatus.REFUND.name().equals(status)) {\n                log.info(\"当前单据已退票，不做重复处理 refundInfo={}\", JSON.toJSONString(refundInfo));\n                return \"当前单据已退票，不做重复处理\";\n            }\n            String reason = refundInfo.getReason();\n            // 更新支付指令状态为退票\n            this.updateInstructAndHis(instruct, PayStatus.REFUND.name(),\n                    null, reason,\n                    null, reason, null);\n            String payCheckNum = S