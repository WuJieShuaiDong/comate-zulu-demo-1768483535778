nkcommonInterfaceDirectionEnum.REQUEST)\n                    .andEqualTo(\"columnCode\", Constants.BankcommonColumnCodeEnum.FIRST_PAGE_NO)\n                    .andEqualTo(\"enableFlag\", Constants.ENABLED_Y);\n            List<PmcPayCommonBankColSet> pmcPayCommonBankColSetsexamplePageNo = pmcPayCommonBankColSetMapper.selectByExample(examplePageNo);\n            if (CollectionUtils.isNotEmpty(pmcPayCommonBankColSetsexamplePageNo)) {\n                startPageNo = Integer.parseInt(pmcPayCommonBankColSetsexamplePageNo.get(0).getMappingBankCol());\n            }\n            for (int i = startPageNo; i < TRANS_REQUEST_NUM; i++) {\n                dto.put(\"pageNo\", i);\n                dto.put(\"funName\", Constants.BankcommonTranscodeEnum.REFUND);\n                String request = messageBuilder.queryRefundMessage(dto, extentionParams);\n\n                // 发送银行前置机\n                String[] ipArr = new String[1];\n                String response = this.postMACHINE(request, StringUtils.toString(dto.get(\"account\")),\n                        WkContextHolder.getTenantId(), ipArr, StringUtils.toString(dto.get(\"bankCode\")));\n                if (Constants.NO_ENABLED_MACHINE.equals(response)) {\n                    log.error(\"退票查询时 无可用前置机异常, accountNo={}\", StringUtils.toString(dto.get(\"account\")));\n                    break;\n                } else if (Constants.BANK_POST_EXCEPTION.equals(response)) {\n                    log.error(\"退票查询请求异常, accountNo={}\", StringUtils.toString(dto.get(\"account\")));\n                    break;\n                }\n                ResponseHeaderDTO responseHeaderDto =\n                        responseXmlParser.parseResponseXml(response, dto);\n                log.info(\"homeReufndDeal 处理银行请求结果 resDto={}\", JSON.toJSONString(responseHeaderDto));\n                if (responseHeaderDto == null) {\n                    break;\n                }\n                ResponseHeaderDTO.SystemHeadBean header = responseHeaderDto.getHeader();\n                ResponseBodyDTO bodyDto = responseHeaderDto.getBody();\n                if (header == null || !Constants.RESPONSE_SUCCESS.equals(header.getStatus()) || bodyDto == null\n                        || CollectionUtils.isEmpty(bodyDto.getRefundInfoList())) {\n                    log.error(\"homeReufndDeal 银行报文解析发生错误\");\n                    break;\n                }\n                // 处理成功\n                res.addAll(bodyDto.getRefundInfoList());\n                // 已经到最后一页，退出循环\n                if (Constants.ENABLED_Y.equals(bodyDto.getLastPageFlag())) {\n                    break;\n                }\n                // 退票列表总数大于等于接口总数，退出循环\n                if (StringUtils.isNotBlank(bodyDto.getTotalNum())) {\n                    int transCount = Integer.parseInt(bodyDto.getTotalNum());\n                    if (res.size() >= transCount) {\n                        break;\n                    }\n                }\n            }\n        } catch (Exception e) {\n            log.error(\"homeReufndDeal 账户退票查询失败\", e);\n        }\n        return res;\n    }\n\n    /**\n     * 处理退票\n     * @return\n     */\n    private String dealRefundInfo(RefundInfo refundInfo, String bankCode) {\n        log.info(\"退票处理 refundInfo={}\", JSON.toJSONString(refundInfo));\n        // 查询退票对应的支付指令\n        String trnUid = refundInfo.getTrnUid();\n        String account = refundInfo.getAccount();\n        String bankSuffix = pmcPayCommonBankColSetService.getBankSuffix(bankCode);\n        List<String> instructCol = pmcPayCommonBankColSetService.getBankCommonInstructDynamic(bankCode);\n        DynamicTableDto dynamicTableDto = new DynamicTableDto();\n        dynamicTableDto.setTableName(Constants.BANK_COMMON_INSTRUCT_TABLE.replaceAll(\"\\\\$\\\\{bankSuffix}\", bankSuffix));\n        dynamicTableDto.setSelectColumns(instructCol);\n        Map<String, String> whereEqualColumns = new HashMap<>();\n        whereEqualColumns.put(\"bank_code\", bankCode);\n        whereEqualColumns.put(\"account\", account);\n        whereEqualColumns.put(\"trn_uid\", trnUid);\n        dynamicTableDto.setWhereEqColumns(whereEqualColumns);\n        List<Map<String, Object>> payInstructDTOs = bankCommonPayInstructInterService.dynamicSelect(dynamicTableDto);\n        if (CollectionUtils.isNotEmpty(payInstructDTOs)) {\n            Map<String, Object> instruct = payInstructDTOs.get(0);\n            String status = StringUtils.toString(instruct.get(\"status\"));\n            if (PayStatus.REFUND.name().equals(status)) {\n                log.info(\"当前单据已退票，不做重复处理 refundInfo={}\", JSON.toJSONString(refundInfo));\n                return \"当前单据已退票，不做重复处理\";\n            }\n            String reason = refundInfo.getReason();\n            // 更新支付指令状态为退票\n            this.updateInstructAndHis(instruct, PayStatus.REFUND.name(),\n                    null, reason,\n                    null, reason, null);\n            String payCheckNum = StringUtils.toString(instruct.get(\"payCheckNum\"));\n            PmcPayChecks payChecks = new PmcPayChecks();\n            payChecks.setPayCheckNum(payCheckNum);\n            payChecks.setStatus(PayStatus.REFUND.name());\n            payChecks.setActualPayDate(new Date());\n            // 更新付款单并插入历史记录\n            this.updatePayChecksAndInsertHis(payChecks);\n            // 反馈业务线\n            payChecksWriteBackService.writeBack(Long.valueOf(StringUtils.toString(instruct.get(\"checkId\"))));\n            mailService.sendRefundMail(payCheckNum, reason);\n        }\n\n        return \"\";\n    }\n}\n",
