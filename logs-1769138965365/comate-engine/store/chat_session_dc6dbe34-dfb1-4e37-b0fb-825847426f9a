                "content": "package com.baidu.pmc.abc.core.controller;\n\nimport com.baidu.pmc.abc.core.service.AbcReceiptService;\nimport com.baidu.pmc.abc.core.service.AbcService;\nimport com.baidu.pmc.common.ResponseMessage;\nimport com.baidu.pmc.pojo.dto.cmb.BalanceInfo;\nimport com.baidu.pmc.pojo.dto.cmb.TransInfo;\nimport com.baidu.pmc.pojo.model.cmb.PayQO;\nimport com.github.pagehelper.PageInfo;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections.CollectionUtils;\nimport org.apache.commons.lang3.exception.ExceptionUtils;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.http.HttpStatus;\nimport org.springframework.http.ResponseEntity;\nimport org.springframework.web.bind.annotation.PostMapping;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.RestController;\n\nimport java.util.Comparator;\nimport java.util.List;\nimport java.util.stream.Collectors;\n\n/**\n * 农行接口服务\n * @author liuyanzhong\n */\n@Slf4j\n@RestController\n@RequestMapping(\"/abc\")\npublic class AbcController {\n\n    @Autowired\n    private AbcService abcService;\n\n    @Autowired\n    private AbcReceiptService abcReceiptService;\n\n    /**\n     * 农行余额实时查询\n     */\n    @PostMapping(value = \"/selectAbcBalance\")\n    public ResponseEntity<Object> selectAbcBalance(@RequestBody PayQO payQO) {\n        try {\n            List<BalanceInfo> balanceInfos = abcService.selectAbcBalance(payQO);\n            if (CollectionUtils.isNotEmpty(balanceInfos)) {\n                balanceInfos = balanceInfos.stream().sorted(Comparator.comparing(BalanceInfo::getAvailableBalance)\n                        .reversed()).collect(Collectors.toList());\n            }\n            return new ResponseEntity<>(ResponseMessage.success(new PageInfo<>(balanceInfos)), HttpStatus.OK);\n        } catch (Exception e) {\n            log.error(\"selectAbcBalanceNow error\", e);\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 导农业银行余额\n     */\n    @PostMapping(\"/exportAbcBalance\")\n    public ResponseEntity<Object> exportAbcBalance(@RequestBody PayQO payQO) {\n        try {\n            List<BalanceInfo> balanceInfos = abcService.selectAbcBalance(payQO);\n            if (CollectionUtils.isNotEmpty(balanceInfos)) {\n                balanceInfos = balanceInfos.stream()\n                        .sorted(Comparator.comparing(BalanceInfo::getAvailableBalance)\n                                .reversed()).collect(Collectors.toList());\n            }\n            return new ResponseEntity<>(ResponseMessage.success(balanceInfos), HttpStatus.OK);\n        } catch (Exception e) {\n            log.error(\"exportAbcBalance error\", e);\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 农业银行流水查询\n     */\n    @PostMapping(value = \"/selectAbcTrans\")\n    public ResponseEntity<Object> selectAbcTrans(@RequestBody PayQO payQO) {\n        try {\n            List<TransInfo> list = abcService.selectAbcTrans(payQO);\n            return new ResponseEntity<>(ResponseMessage.success(new PageInfo<>(list)), HttpStatus.OK);\n        } catch (Exception e) {\n            log.error(\"selectAbcTrans error \", e);\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 导出农业银行交易明细\n     */\n    @PostMapping(\"/exportDetail\")\n    public ResponseEntity<Object> exportDetail(@RequestBody PayQO payQO) {\n        try {\n            List<TransInfo> list = abcService.selectAbcTrans(payQO);\n            return new ResponseEntity<>(list, HttpStatus.OK);\n        } catch (Exception e) {\n            log.error(\"exportDetail error \", e);\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 手动查询回单\n     */\n    @PostMapping(\"/selectElectReceipt\")\n    public ResponseEntity<Object> selectElectReceipt(@RequestBody PayQO payQO) {\n        try {\n            log.info(\"手动拉取农业银行关联电子回单开始\");\n            new Thread(() -> {\n                String result = abcReceiptService.selectElectReceipt(payQO);\n                log.info(\"手动拉取关联电子回单完成 result={}\", result);\n            }).start();\n            log.info(\"手动拉取农业银行关联电子回单结束\");\n            return new ResponseEntity<>(ResponseMessage.success(\"success\"), HttpStatus.OK);\n        } catch (Exception e) {\n            log.error(\"selectElectReceipt error: {}\", ExceptionUtils.getStackTrace(e));\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n}\n",
