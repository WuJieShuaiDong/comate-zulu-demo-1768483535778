农业银行启用银企直联账户\n        payQO.setCurrency(Constants.CNY);\n        List<PmcAccount> pmcAccounts = accountService.queryAbcAccount(payQO);\n        if (CollectionUtils.isEmpty(pmcAccounts)) {\n            log.info(\"没有启用中的农业银行账户\");\n            return \"没有启用中的农业银行账户\";\n        }\n        log.info(\"待查询的农业银行账户数量 size={}\", pmcAccounts.size());\n\n        // 日期设置\n        List<String> dateList = new ArrayList<>();\n        if (payQO.getStartDate() != null && payQO.getEndDate() != null) {\n            dateList.addAll(DateUtils.dateBetweenDay(payQO.getStartDate(), payQO.getEndDate(),\n                    DateTool.DAY_PARTTEN_YYYYMMDD));\n        } else {\n            dateList.add(DateUtils.formatDate(DateUtils.addDays(new Date(), -2),\n                    DateTool.DAY_PARTTEN_YYYYMMDD));\n            dateList.add(DateUtils.formatDate(DateUtils.yesterday(), DateTool.DAY_PARTTEN_YYYYMMDD));\n        }\n\n        if (CollectionUtils.isEmpty(dateList)) {\n            log.info(\"没有符合的回单拉取时间段\");\n            return \"时间段不符合要求\";\n        }\n        // 农行回单按照日期查询，返回所有账户的回单\n        for (String date : dateList) {\n            try {\n                AbcPayInstructDTO dto = new AbcPayInstructDTO();\n                dto.setReceiptType(Constants.RECEIPT_TYPE_1);\n                dto.setReceiptDate(date);\n                log.info(\"selectElectReceipt 查询回单任务, date={}\", date);\n                Document document = MessageBuilder.queryElectReceiptQueryMessage(dto);\n                String[] ipArr = new String[1];\n                String response = abcService.postABC(document, \"electReceipt\", WkContextHolder.getTenantId(),\n                        ipArr);\n                if (StringUtils.isNotBlank(response)\n                        && !Constants.NO_ENABLED_MACHINE.equals(response)\n                        && !Constants.BANK_POST_EXCEPTION.equals(response)) {\n                    ResponseHeaderDTO responseDto =\n                            ResponseXmlParser.parseResponseXml(response, Constants.AbcTranscodeEnum.ELECT_RECEIPT);\n                    ResponseBodyDTO bodyDto;\n                    if (responseDto != null && Constants.RESPONSE_0.equals(responseDto.getRespSource())\n                            && (bodyDto = responseDto.getBodyDto()) != null) {\n                        dto.setFileName(bodyDto.getBatchFileName());\n                        if (StringUtils.isNotBlank(dto.getFileName())) {\n                            this.downloadReceiptByFile(bodyDto.getBatchFileName(), ipArr[0]);\n                        }\n                    }\n                }\n            } catch (Exception e) {\n                log.error(\"selectElectReceiptError\", e);\n            }\n        }\n        log.info(\"回单拉取任务执行完成\");\n        return \"执行成功\";\n    }\n}\n",
