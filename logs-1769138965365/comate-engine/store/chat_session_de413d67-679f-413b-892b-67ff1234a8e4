 }\n        // 2 通用业务校验\n        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(qo, \"supplementFinancingAttachment\");\n        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n            return checkResult;\n        }\n        // 3. 文件补充处理\n        if (PayBankConstants.CMB_BANK_CODE.equals(qo.getBankCode())) {\n            return cmbClient.supplementFinancingAttachment(file, qo);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(qo.getBankCode())) {\n            return cmbcClient.supplementFinancingAttachment(file, qo);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n\n\n    /**\n     * 组装银行融资申请参数\n     * @param detail 包含applyDTO和payChecksSupplierCodeDTO的Map\n     * @return 组装好的PmcFinanceBankBaseQO请求对象\n     *\n     */\n    private PmcFinanceBankBaseQO assembleFinancingRequest(Map<String, Object> detail) {\n        // 融资申请单DTO\n        PmcFinanceSupplierApplyDTO applyDTO = (PmcFinanceSupplierApplyDTO) detail.get(\"applyDTO\");\n        // 付款单DTO\n        PmcPayChecksSupplierCodeDTO payChecksDTO = (PmcPayChecksSupplierCodeDTO) detail.get(\"payChecksSupplierCodeDTO\");\n        // 供应商信息\n        PmcDataP2pSupplier supplier = (PmcDataP2pSupplier) detail.get(\"supplier\");\n\n        PmcFinanceBankBaseQO request = new PmcFinanceBankBaseQO();\n        // 基础信息\n        request.setApplyNumber(applyDTO.getApplyNumber());\n        request.setPayCheckNum(applyDTO.getPayCheckNum());\n        request.setSupplierCode(applyDTO.getSupplierCode());\n        request.setSupplierName(applyDTO.getSupplierName());\n        request.setBankCode(applyDTO.getBankCode());\n\n        request.setRegistrationCode(supplier.getRegistrationCode());\n        request.setPayPlanDate(applyDTO.getPatyPlanDate());\n\n\n        request.setFinanceAmount(applyDTO.getFinanceAmount());\n        request.setSupplierAccount(payChecksDTO.getAccount());\n        request.setSupplierBank(payChecksDTO.getBankCodeName());\n        request.setSupplierAddress(payChecksDTO.getPayChecksAttribute4());\n\n        request.setInvoiceNumber(payChecksDTO.getSourceNum());\n        request.setDocumentAmount(payChecksDTO.getAmount());\n        request.setPayableAmount(request.getFinanceAmount());\n        request.setCurrency(applyDTO.getCurrency());\n        request.setBuyerAccount(payChecksDTO.getAccount());\n        request.setFinanceNumber(applyDTO.getPayCheckNum());\n\n        // 发票信息\n        request.setInvoiceType(payChecksDTO.getInvoiceType());\n        request.setInvoiceNumber(payChecksDTO.getInvoiceNumber());\n        request.setInvoiceCode(payChecksDTO.getInvoiceCode());\n        request.setInvoiceDate(payChecksDTO.getInvoiceDate());\n        request.setTaxExcludedAmount(payChecksDTO.getInvoiceAmount());\n        request.setDocumentAmount(payChecksDTO.getTotalAmount());\n\n        return request;\n    }\n\n    private ResponseMessage getUseQuota(PmcFinanceBankBaseQO query) {\n        // 1、查询本地维护的额度信息\n        PmcPortalRemainQuotaQO pmcPortalRemainQuotaQO = new PmcPortalRemainQuotaQO();\n        pmcPortalRemainQuotaQO.setSupplierCode(query.getSupplierCode());\n        pmcPortalRemainQuotaQO.setBankCode(query.getBankCode());\n        pmcPortalRemainQuotaQO.setCompanyCode(query.getCompanyCode());\n        BigDecimal localQuotaResult = pmcPortalClient.calculateAvailableQuota(pmcPortalRemainQuotaQO);\n\n        // 2、查询银行额度信息\n        Map<String, Object> selectMap = pmcPortalClient.selectInit();\n        if (selectMap == null || selectMap.isEmpty()) {\n            return ResponseMessage.fail(\"系统初始化失败，请联系管理员\");\n        }\n        List<Map<String, Object>> bankQuotaMapList = (List<Map<String, Object>>) selectMap.get(\"bankQuotaList\");\n        FinanceQuotaDTO quotaDTO = new FinanceQuotaDTO();\n        quotaDTO.setExoAvailableAmount(localQuotaResult);\n        if (CollectionUtils.isEmpty(bankQuotaMapList)) {\n            return ResponseMessage.success(\"ok\", localQuotaResult);\n        }\n        boolean hasBankQuota = bankQuotaMapList.stream()\n                .anyMatch(map -> query.getBankCode().equals(map.get(\"code\")));\n        // 3、返回额度信息\n        if (hasBankQuota) {\n            if (PayBankConstants.CMB_BANK_CODE.equals(query.getBankCode())) {\n                Object quotaData = cmbClient.queryFinancingQuota(query).getData();\n                if (quotaData instanceof Map) {\n                    Map<String, Object> quotaMap = (Map<String, Object>) quotaData;\n                    quotaDTO = new FinanceQuotaDTO();\n                    quotaDTO.setExoAvailableAmount(new BigDecimal(quotaMap.get(\"exoAvailableAmount\").toString()));\n                } else if (quotaData instanceof FinanceQuotaDTO) {\n                    quotaDTO = (FinanceQuotaDTO) quotaData;\n                }\n                if (quotaDTO != null && localQuotaResult.compareTo(quotaDTO.getExoAvailableAmount()) < 0) {\n                    quotaDTO.setExoAvailableAmount(localQuotaResult);\n                }\n                return ResponseMessage.success(\"ok\", quotaDTO);\n            }  else {\n                return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n            }\n        } else {\n            return ResponseMessage.success(\"ok\", localQuotaResult);\n        }\n    }\n}",
                "content": "package com.baidu.pmc.web.service.financing.impl;\n\nimport com.baidu.pmc.common.ResponseMessage;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyDTO;\nimport com.baidu.pmc.pojo.dto.PmcPayChecksSupplierCodeDTO;\nimport com.baidu.pmc.pojo.dto.cmb.FinanceQuotaDTO;\nimport com.baidu.pmc.pojo.dto.fnd.CodeDesc;\nimport com.baidu.pmc.pojo.model.PmcDataP2pSupplier;\nimport com.baidu.pmc.pojo.qo.PmcFinanceBankBaseQO;\nimport com.baidu.pmc.pojo.qo.PmcPortalRemainQuotaQO;\nimport com.baidu.pmc.web.clients.PmcPortalClient;\nimport com.baidu.pmc.web.clients.PmcSupplierAdmClient;\nimport com.baidu.pmc.web.clients.cmb.CmbFinancingClient;\nimport com.baidu.pmc.web.clients.cmbc.CmbcFinancingClient;\nimport com.baidu.pmc.web.service.financing.PmcFinancingBankService;\nimport com.baidu.pmc.web.service.payebankfile.PayBankConstants;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections.CollectionUtils;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\nimport org.springframework.web.multipart.MultipartFile;\n\nimport java.math.BigDecimal;\nimport java.util.List;\nimport java.util.Map;\n\n@Slf4j\n@Service\npublic class PmcFinancingBankServiceImpl implements PmcFinancingBankService {\n\n    @Autowired\n    private CmbFinancingClient cmbClient;\n\n    @Autowired\n    private CmbcFinancingClient cmbcClient;\n\n    @Autowired\n    private PmcSupplierAdmClient pmcSupplierAdmClient;\n\n    @Autowired\n    private PmcPortalClient pmcPortalClient;\n\n\n\n    /**\n     * 融资测算接口\n     * @param query 包含银行编码等融资测算参数\n     * @return 融资测算结果\n     */\n    @Override\n    public ResponseMessage calculateFinancing(PmcFinanceBankBaseQO query) {\n        // 1. 参数校验\n        if (query == null || query.getBankCode() == null) {\n            return ResponseMessage.fail(\"参数错误：银行编码不能为空\");\n        }\n\n        // 2 通用业务校验\n        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(query, \"calculateFinancing\");\n        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n            return checkResult;\n        }\n        // 3. 调用银行接口进行测算\n        if (PayBankConstants.CMB_BANK_CODE.equals(query.getBankCode())) {\n            return cmbClient.financingCalculate(query);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(query.getBankCode())) {\n            return cmbcClient.financingCalculate(query);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n\n    /**\n     * 提交融资申请\n     * @param applyDTO 包含银行编码等融资申请信息\n     * @return 申请提交结果\n     */\n    @Override\n    public ResponseMessage submitFinancingApply(PmcFinanceBankBaseQO applyDTO) {\n        // 1. 参数校验\n        if (applyDTO == null || applyDTO.getBankCode() == null) {\n            return ResponseMessage.fail(\"参数错误：申请信息不完整\");\n        }\n        // 3. 提交申请\n        if (PayBankConstants.CMB_BANK_CODE.equals(applyDTO.getBankCode())) {\n            return cmbClient.submitFinancingApply(applyDTO);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(applyDTO.getBankCode())) {\n            return cmbcClient.submitFinancingApply(applyDTO);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n\n        // 4. 返回申请结果\n    }\n\n    /**\n     * 通过详情信息提交融资申请\n     * @param detail 包含申请单、付款单和供应商信息的Map\n     * @return 申请提交结果\n     */\n    @Override\n    public ResponseMessage submitFinancingApplyByDetail(Map<String, Object> detail) {\n        final String methodName = \"submitFinancingApplyByDetail\";\n        PmcFinanceBankBaseQO assembledRequest = null;\n        // 1. 参数组装\n        assembledRequest = assembleFinancingRequest(detail);\n\n        // 2. 参数校验\n        if (StringUtils.isBlank(assembledRequest.getBankCode())) {\n            throw new IllegalArgumentException(\"银行编码不能为空\");\n        }\n        ResponseMessage responseMessage = submitFinancingApply(assembledRequest);\n        // 3. 处理银行响应\n        if (ResponseMessage.FAIL.equals(responseMessage.getStatus())) {\n            log.warn(\"[{}] 银行接口调用失败，开始回滚本地状态，申请单号：{}，错误原因：{}\",\n                    methodName, assembledRequest.getApplyNumber(), responseMessage.getMessage());\n            updateApplyStatusOrBankApplyNumber(assembledRequest);\n            return ResponseMessage.fail(\"银行处理失败：\" + responseMessage.getMessage());\n        }\n        return responseMessage;\n    }\n\n    /**\n     * 执行本地状态回滚操作\n     */\n    private void updateApplyStatusOrBankApplyNumber(PmcFinanceBankBaseQO request) {\n        try {\n            ResponseMessage rollback = pmcSupplierAdmClient.updateApplyStatusOrBankApplyNumber(request);\n            if (ResponseMessage.FAIL.equals(rollback.getStatus())) {\n                log.error(\"更新本地记录失败，申请单号：{}，错误信息：{}\",\n                    request.getApplyNumber(), rollback.getMessage());\n            }\n        } catch (Exception e) {\n            log.error(\"更新本地记录时发生异常，申请单号：{}\", request.getApplyNumber(), e);\n        }\n    }\n\n    /**\n     * 查询融资结果\n     * @param query 包含银行编码等查询条件\n     * @return 融资结果信息\n     */\n    @Override\n    public ResponseMessage queryFinancingResult(PmcFinanceBankBaseQO query) {\n        // 1. 参数校验\n        if (query == null || query.getBankCode() == null) {\n            return ResponseMessage.fail(\"参数错误：银行编码不能为空\");\n        }\n\n        // 2 通用业务校验\n        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(query, \"queryFinancingResult\");\n        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n            return checkResult;\n        }\n        // 3. 查询融资结果\n        if (PayBankConstants.CMB_BANK_CODE.equals(query.getBankCode())) {\n            return cmbClient.queryFinancingResult(query);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(query.getBankCode())) {\n            return cmbcClient.queryFinancingResult(query);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n\n    /**\n     * 查询融资额度\n     * @param query 包含银行编码和供应商编码、公司编码的查询条件\n     * @return 融资额度信息\n     */\n    @Override\n    public ResponseMessage queryFinancingQuota(PmcFinanceBankBaseQO query) {\n        // 1. 参数校验\n        if (query == null || query.getSupplierCode() == null || query.getBankCode() == null) {\n            return ResponseMessage.fail(\"参数错误：银行编码或者供应商编码不能为空\");\n        }\n       return getUseQuota(query);\n    }\n\n    /**\n     * 上传融资附件\n     * @param file 上传的文件\n     * @param qo 包含银行编码等附件信息\n     * @return 上传结果\n     */\n    @Override\n    public ResponseMessage uploadFinancingAttachment(MultipartFile file, PmcFinanceBankBaseQO qo) {\n        // 1. 参数校验\n        if (file == null || file.isEmpty() || qo == null || StringUtils.isBlank(qo.getBankCode())) {\n            return ResponseMessage.fail(\"参数错误：文件或银行编码不能为空\");\n        }\n\n        // 2 通用业务校验\n        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(qo, \"uploadFinancingAttachment\");\n        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n            return checkResult;\n        }\n\n        // 3. 文件上传处理\n        if (PayBankConstants.CMB_BANK_CODE.equals(qo.getBankCode())) {\n            return cmbClient.uploadAttachment(file, qo);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(qo.getBankCode())) {\n            return cmbcClient.uploadAttachment(file, qo);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n\n    /**\n     * 补充融资附件\n     * @param file 补充上传的文件\n     * @param qo 包含银行编码等附件信息\n     * @return 补充上传结果\n     */\n    @Override\n    public ResponseMessage supplementFinancingAttachment(MultipartFile file, PmcFinanceBankBaseQO qo) {\n        // 1. 参数校验\n        if (file == null || file.isEmpty() || qo == null || StringUtils.isBlank(qo.getBankCode())) {\n            return ResponseMessage.fail(\"参数错误：文件或银行编码不能为空\");\n        }\n    