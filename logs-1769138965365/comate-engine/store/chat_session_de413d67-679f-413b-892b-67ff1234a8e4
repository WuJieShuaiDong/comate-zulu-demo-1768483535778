 }\n        // 2 通用业务校验\n        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(qo, \"supplementFinancingAttachment\");\n        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n            return checkResult;\n        }\n        // 3. 文件补充处理\n        if (PayBankConstants.CMB_BANK_CODE.equals(qo.getBankCode())) {\n            return cmbClient.supplementFinancingAttachment(file, qo);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(qo.getBankCode())) {\n            return cmbcClient.supplementFinancingAttachment(file, qo);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n\n\n    /**\n     * 组装银行融资申请参数\n     * @param detail 包含applyDTO和payChecksSupplierCodeDTO的Map\n     * @return 组装好的PmcFinanceBankBaseQO请求对象\n     *\n     */\n    private PmcFinanceBankBaseQO assembleFinancingRequest(Map<String, Object> detail) {\n        // 融资申请单DTO\n        PmcFinanceSupplierApplyDTO applyDTO = (PmcFinanceSupplierApplyDTO) detail.get(\"applyDTO\");\n        // 付款单DTO\n        PmcPayChecksSupplierCodeDTO payChecksDTO = (PmcPayChecksSupplierCodeDTO) detail.get(\"payChecksSupplierCodeDTO\");\n        // 供应商信息\n        PmcDataP2pSupplier supplier = (PmcDataP2pSupplier) detail.get(\"supplier\");\n\n        PmcFinanceBankBaseQO request = new PmcFinanceBankBaseQO();\n        // 基础信息\n        request.setApplyNumber(applyDTO.getApplyNumber());\n        request.setPayCheckNum(applyDTO.getPayCheckNum());\n        request.setSupplierCode(applyDTO.getSupplierCode());\n        request.setSupplierName(applyDTO.getSupplierName());\n        request.setBankCode(applyDTO.getBankCode());\n\n        request.setRegistrationCode(supplier.getRegistrationCode());\n        request.setPayPlanDate(applyDTO.getPatyPlanDate());\n\n\n        request.setFinanceAmount(applyDTO.getFinanceAmount());\n        request.setSupplierAccount(payChecksDTO.getAccount());\n        request.setSupplierBank(payChecksDTO.getBankCodeName());\n        request.setSupplierAddress(payChecksDTO.getPayChecksAttribute4());\n\n        request.setInvoiceNumber(payChecksDTO.getSourceNum());\n        request.setDocumentAmount(payChecksDTO.getAmount());\n        request.setPayableAmount(request.getFinanceAmount());\n        request.setCurrency(applyDTO.getCurrency());\n        request.setBuyerAccount(payChecksDTO.getAccount());\n        request.setFinanceNumber(applyDTO.getPayCheckNum());\n\n        // 发票信息\n        request.setInvoiceType(payChecksDTO.getInvoiceType());\n        request.setInvoiceNumber(payChecksDTO.getInvoiceNumber());\n        request.setInvoiceCode(payChecksDTO.getInvoiceCode());\n        request.setInvoiceDate(payChecksDTO.getInvoiceDate());\n        request.setTaxExcludedAmount(payChecksDTO.getInvoiceAmount());\n        request.setDocumentAmount(payChecksDTO.getTotalAmount());\n\n        return request;\n    }\n\n    private ResponseMessage getUseQuota(PmcFinanceBankBaseQO query) {\n        // 1、查询本地维护的额度信息\n        PmcPortalRemainQuotaQO pmcPortalRemainQuotaQO = new PmcPortalRemainQuotaQO();\n        pmcPortalRemainQuotaQO.setSupplierCode(query.getSupplierCode());\n        pmcPortalRemainQuotaQO.setBankCode(query.getBankCode());\n        pmcPortalRemainQuotaQO.setCompanyCode(query.getCompanyCode());\n        BigDecimal localQuotaResult = pmcPortalClient.calculateAvailableQuota(pmcPortalRemainQuotaQO);\n\n        // 2、查询银行额度信息\n        Map<String, Object> selectMap = pmcPortalClient.selectInit();\n        if (selectMap == null || selectMap.isEmpty()) {\n            return ResponseMessage.fail(\"系统初始化失败，请联系管理员\");\n        }\n        List<CodeDesc> bankQuotaList = (List<CodeDesc>) selectMap.get(\"bankQuotaList\");\n        FinanceQuotaDTO quotaDTO = new FinanceQuotaDTO();\n        quotaDTO.setExoAvailableAmount(localQuotaResult);\n        if (CollectionUtils.isEmpty(bankQuotaList)) {\n            return ResponseMessage.success(\"ok\", localQuotaResult);\n        }\n        boolean hasBankQuota =