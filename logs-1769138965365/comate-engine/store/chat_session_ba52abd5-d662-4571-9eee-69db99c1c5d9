                "afterChangeFileContent": "package com.baidu.p2p.core.utils;\n\nimport org.slf4j.Logger;\nimport org.slf4j.LoggerFactory;\n\nimport java.util.concurrent.ArrayBlockingQueue;\nimport java.util.concurrent.BlockingQueue;\nimport java.util.concurrent.Callable;\nimport java.util.concurrent.ExecutorService;\nimport java.util.concurrent.Future;\nimport java.util.concurrent.RejectedExecutionHandler;\nimport java.util.concurrent.ThreadFactory;\nimport java.util.concurrent.ThreadPoolExecutor;\nimport java.util.concurrent.TimeUnit;\nimport java.util.concurrent.atomic.AtomicInteger;\nimport java.util.concurrent.atomic.AtomicBoolean;\n\nimport static java.util.concurrent.ThreadPoolExecutor.CallerRunsPolicy;\n\n/**\n * 公用的线程池工具类\n * 功能：\n * 1. 解决线程丢失问题（全链路异常捕获）\n * 2. 完善线程关闭机制（优雅关闭+超时控制）\n * 3. 支持线程池状态监控\n * 4. 核心与非核心线程分离\n * 5. 可配置的拒绝策略与线程参数\n *\n * Created by anhuan on 16-8-23.\n * Optimized by [your name] on [date]\n */\npublic class NewThreadPoolExecutorUtil {\n    private static final Logger logger = LoggerFactory.getLogger(NewThreadPoolExecutorUtil.class);\n\n    // 默认线程池参数\n    private static final int DEFAULT_CORE_POOL_SIZE = 10;\n    private static final int DEFAULT_MAX_POOL_SIZE = 20;\n    private static final int DEFAULT_QUEUE_SIZE = 1000;\n    private static final long KEEP_ALIVE_TIME = 5;\n    private static final TimeUnit KEEP_ALIVE_TIME_UNIT = TimeUnit.MINUTES;\n    // 默认拒绝策略：带日志的CallerRunsPolicy\n    private static final RejectedExecutionHandler DEFAULT_REJECTED_HANDLER = new LoggingCallerRunsPolicy();\n\n    // 单例线程池实例\n    private static ThreadPoolExecutor executor;\n\n    static {\n        initDefaultExecutor();\n\n        // 仅为默认线程池添加关闭钩子\n        Runtime.getRuntime().addShutdownHook(new Thread(() -> {\n            logger.info(\"JVM is shutting down, shutting down default thread pool gracefully...\");\n            shutdownAndAwaitTermination(executor, 30, TimeUnit.SECONDS);\n        }));\n    }\n\n    /**\n     * 初始化默认线程池\n     */\n    private static synchronized void initDefaultExecutor() {\n        // 关闭旧实例，避免资源泄漏\n        if (executor != null && !executor.isTerminated()) {\n            shutdownAndAwaitTermination(executor, 5, TimeUnit.SECONDS);\n        }\n\n        BlockingQueue<Runnable> queue = new ArrayBlockingQueue<>(DEFAULT_QUEUE_SIZE);\n        ThreadFactory threadFactory = new NamedThreadFactory(\"default-pool-\", Thread.NORM_PRIORITY);\n\n        executor = new ThreadPoolExecutor(\n                DEFAULT_CORE_POOL_SIZE,\n                DEFAULT_MAX_POOL_SIZE,\n                KEEP_ALIVE_TIME,\n                KEEP_ALIVE_TIME_UNIT,\n                queue,\n                threadFactory,\n                DEFAULT_REJECTED_HANDLER\n        );\n\n        executor.allowCoreThreadTimeOut(false);\n\n        logger.info(\"Default thread pool initialized. Core: {}, Max: {}, Queue: {}\",\n                DEFAULT_CORE_POOL_SIZE, DEFAULT_MAX_POOL_SIZE, DEFAULT_QUEUE_SIZE);\n    }\n\n    /**\n     * 获取默认线程池实例（确保通过工具类方法提交任务）\n     */\n    public static synchronized ExecutorService getExecutorService() {\n        if (executor == null || executor.isShutdown() || executor.isTerminated()) {\n            logger.warn(\"Default thread pool is unavailable, recreating...\");\n            initDefaultExecutor();\n        }\n        // 返回包装后的ExecutorService，强制使用工具类的提交方法\n        return new WrappedExecutorService(executor);\n    }\n\n    /**\n     * 创建自定义线程池（支持配置队列、拒绝策略、线程优先级）\n     */\n    public static ThreadPoolExecutor createExecutorService(\n            int corePoolSize, int maxPoolSize, BlockingQueue<Runnable> queue,\n            int threadPriority, RejectedExecutionHandler rejectedHandler,\n            String threadNamePrefix) {\n\n        // 参数校验\n        if (corePoolSize < 0 || maxPoolSize <= 0 || maxPoolSize < corePoolSize || queue == null) {\n            throw new IllegalArgumentException(\"Invalid thread pool parameters: \" +\n                    \"core=\" + corePoolSize + \", max=\" + maxPoolSize + \", queue=\" + queue);\n        }\n\n        ThreadFactory threadFactory = new NamedThreadFactory(threadNamePrefix, threadPriority);\n        // 拒绝策略默认使用带日志的CallerRunsPolicy\n        RejectedExecutionHandler handler = rejectedHandler != null ? rejectedHandler : DEFAULT_REJECTED_HANDLER;\n\n        ThreadPoolExecutor executor = new ThreadPoolExecutor(\n                corePoolSize,\n                maxPoolSize,\n                KEEP_ALIVE_TIME,\n                KEEP_ALIVE_TIME_UNIT,\n                queue,\n                threadFactory,\n                handler\n        );\n\n        logger.info(\"Custom thread pool created. Core: {}, Max: {}, Queue: {}, Prefix: {}\",\n                corePoolSize, maxPoolSize, queue.getClass().getSimpleName(), threadNamePrefix);\n\n        return executor;\n    }\n\n    /**\n     * 简化版自定义线程池创建（默认队列和拒绝策略）\n     */\n    public static ThreadPoolExecutor createExecutorService(\n            int corePoolSize, int maxPoolSize, int queueSize, String threadNamePrefix) {\n        BlockingQueue<Runnable> queue = new ArrayBlockingQueue<>(queueSize);\n        return createExecutorService(corePoolSize, maxPoolSize, queue,\n                Thread.NORM_PRIORITY, DEFAULT_REJECTED_HANDLER, threadNamePrefix);\n    }\n\n    /**\n     * 优雅关闭线程池\n     */\n    public static void shutdownExecutor(ExecutorService executor, long timeout, TimeUnit unit) {\n        if (executor == null || executor.isTerminated()) {\n            return;\n        }\n        // 若为包装类，获取原始线程池\n        ExecutorService targetExecutor = (executor instanceof WrappedExecutorService)\n                ? ((WrappedExecutorService) executor).getTarget() : executor;\n        shutdownAndAwaitTermination(targetExecutor, timeout, unit);\n    }\n\n    /**\n     * 优雅关闭线程池并等待终止\n     */\n    private static void shutdownAndAwaitTermination(ExecutorService executor, long timeout, TimeUnit unit) {\n        if (executor == null) {\n            return;\n        }\n\n        try {\n            executor.shutdown