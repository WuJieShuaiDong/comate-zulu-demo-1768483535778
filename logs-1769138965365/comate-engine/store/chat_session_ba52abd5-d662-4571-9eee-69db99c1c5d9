n            this(prefix, priority, false);\n        }\n\n        public NamedThreadFactory(String prefix, int priority, boolean daemon) {\n            this.prefix = prefix;\n            this.threadPriority = priority;\n            this.daemon = new AtomicBoolean(daemon);\n            // 校验优先级范围\n            if (priority < Thread.MIN_PRIORITY || priority > Thread.MAX_PRIORITY) {\n                throw new IllegalArgumentException(\"Invalid thread priority: \" + priority);\n            }\n        }\n\n        @Override\n        public Thread newThread(Runnable r) {\n            Thread t = new Thread(r, prefix + threadNumber.getAndIncrement());\n            t.setDaemon(daemon.get());\n            t.setPriority(threadPriority); // 使用配置的优先级\n            return t;\n        }\n    }\n\n    /**\n     * 带日志的拒绝策略（增加任务标识）\n     */\n    private static class LoggingCallerRunsPolicy extends CallerRunsPolicy {\n        @Override\n        public void rejectedExecution(Runnable r, ThreadPoolExecutor e) {\n            // 尝试获取任务名称（如果是工具类包装的任务）\n            String taskName = \"unknown\";\n            if (r instanceof WrappedRunnable) {\n                taskName = ((WrappedRunnable) r).getTaskName();\n            }\n\n            logger.warn(\"Task [{}] rejected. Thread pool saturated. \" +\n                            \"Active: {}, Queue: {}, Pool: {}\",\n                    taskName, e.getActiveCount(), e.getQueue().size(), e.getPoolSize());\n            super.rejectedExecution(r, e);\n        }\n    }\n\n    /**\n     * 包装ExecutorService，强制使用工具类的提交方法\n     */\n    private static class WrappedExecutorService implements ExecutorService {\n        private final ExecutorService target;\n\n        public WrappedExecutorService(ExecutorService target) {\n            this.target = target;\n        }\n\n        public ExecutorService getTarget() {\n            return target;\n        }\n\n        // 重写submit/execute，强制要求使用带任务名称的方法\n        @Override\n        public void execute(Runnable command) {\n            throw new UnsupportedOperationException(\"Please use NewThreadPoolExecutorUtil.execute() with task name\");\n        }\n\n        @Override\n        public <T> Future<T> submit(Callable<T> task) {\n            throw new UnsupportedOperationException(\"Please use NewThreadPoolExecutorUtil.submit() with task name\");\n        }\n\n        @Override\n        public <T> Future<T> submit(Runnable task, T result) {\n            throw new UnsupportedOperationException(\"Please use NewThreadPoolExecutorUtil.submit() with task name\");\n        }\n\n        @Override\n        public Future<?> submit(Runnable task) {\n            throw new UnsupportedOperationException(\"Please use NewThreadPoolExecutorUtil.submit() with task name\");\n        }\n\n        // 其他方法直接委托给目标线程池\n        @Override public void shutdown() { target.shutdown(); }\n        @Override public boolean isShutdown() { return target.isShutdown(); }\n        @Override public boolean isTerminated() { return target.isTerminated(); }\n        @Override public boolean awaitTermination(long timeout, TimeUnit unit) throws InterruptedException {\n            return target.awaitTermination(timeout, unit);\n        }\n        @Override public java.util.List<Runnable> shutdownNow() { return target.shutdownNow(); }\n        @Override public <T> java.util.List<Future<T>> invokeAll(java.util.Collection<? extends Callable<T>> tasks) throws InterruptedException {\n            return target.invokeAll(tasks);\n        }\n        @Override public <T> java.util.List<Future<T>> invokeAll(java.util.Collection<? extends Callable<T>> tasks, long timeout, TimeUnit unit) throws InterruptedException {\n            return target.invokeAll(tasks, timeout, unit);\n        }\n        @Override public <T> T invokeAny(java.util.Collection<? extends Callable<T>> tasks) throws InterruptedException, java.util.concurrent.ExecutionException {\n            return target.invokeAny(tasks);\n        }\n        @Override public <T