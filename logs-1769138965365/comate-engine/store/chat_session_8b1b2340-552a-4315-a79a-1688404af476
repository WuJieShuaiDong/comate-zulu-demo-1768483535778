                "originalContent": "package com.baidu.tms.loan.service.impl;\n\nimport com.baidu.p2p.commons.constants.BizConstants;\nimport com.baidu.p2p.commons.constants.CommonEnums;\nimport com.baidu.p2p.core.j2ee.exception.ServiceException;\nimport com.baidu.p2p.core.jdbc.pk.NumberGenerater;\nimport com.baidu.p2p.core.jdbc.pk.SequenceGenerator;\nimport com.baidu.p2p.core.utils.DESUtil;\nimport com.baidu.p2p.core.utils.DateUtils;\nimport com.baidu.p2p.core.utils.UtilType;\nimport com.baidu.p2p.fnd.api.FndDescFlexColumnApi;\nimport com.baidu.p2p.fnd.api.FndFlexValueApi;\nimport com.baidu.p2p.fnd.api.FndLookupApi;\nimport com.baidu.p2p.fnd.domain.FndDescFlexColumnsCom;\nimport com.baidu.p2p.system.dto.PageParams;\nimport com.baidu.p2p.system.service.SysCrudService;\nimport com.baidu.p2p.system.uic.UICTransInfoUtils;\nimport com.baidu.p2p.system.uic.dto.UICUserInfoDto;\nimport com.baidu.p2p.system.web.session.SessionUtils;\nimport com.baidu.tms.loan.dao.LoanCommonEventMyDao;\nimport com.baidu.tms.loan.dao.LoanCommonReqMyDao;\nimport com.baidu.tms.loan.domain.LoanBankDrawDetail;\nimport com.baidu.tms.loan.domain.LoanBankDrawList;\nimport com.baidu.tms.loan.domain.LoanBankIrsDetail;\nimport com.baidu.tms.loan.domain.LoanBankListDetail;\nimport com.baidu.tms.loan.domain.LoanBankReqDetail;\nimport com.baidu.tms.loan.domain.LoanBankReqHead;\nimport com.baidu.tms.loan.domain.LoanCommonEventInfo;\nimport com.baidu.tms.loan.domain.LoanCommonEventQueryCon;\nimport com.baidu.tms.loan.domain.LoanCommonReqList;\nimport com.baidu.tms.loan.domain.LoanCommonReqQueryCon;\nimport com.baidu.tms.loan.domain.LoanCommonReqSuggest;\nimport com.baidu.tms.loan.service.LoanBankDrawService;\nimport com.baidu.tms.loan.service.LoanBankIrsService;\nimport com.baidu.tms.loan.service.LoanBankListService;\nimport com.baidu.tms.loan.service.LoanBankReqService;\nimport com.baidu.tms.loan.service.LoanCommonEventService;\nimport com.baidu.tms.loan.util.LoanConstants;\nimport com.baidu.tms.persistent.loan.dao.TmsLoanBankReqDAO;\nimport com.baidu.tms.persistent.loan.domain.TmsLoanBankDraw;\nimport com.baidu.tms.persistent.loan.domain.TmsLoanBankIrs;\nimport com.baidu.tms.persistent.loan.domain.TmsLoanBankList;\nimport com.baidu.tms.persistent.loan.domain.TmsLoanBankReq;\nimport com.baidu.tms.trx.service.TransactionTypeService;\nimport com.github.pagehelper.PageHelper;\nimport com.github.pagehelper.PageInfo;\nimport com.google.common.base.CaseFormat;\nimport org.apache.commons.lang.StringUtils;\nimport org.apache.logging.log4j.LogManager;\nimport org.apache.logging.log4j.Logger;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.beans.factory.annotation.Value;\nimport org.springframework.stereotype.Service;\n\nimport java.math.BigDecimal;\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.Calendar;\nimport java.util.Date;\nimport java.util.List;\nimport java.util.Map;\n\nimport static com.baidu.p2p.bpm.common.ProcessConstants.PERSON_SPLIT;\n\n@Service\npublic class LoanBankReqServiceImpl extends SysCrudService<TmsLoanBankReqDAO, TmsLoanBankReq> implements\n        LoanBankReqService {\n\n    private static Logger logger = LogManager.getLogger(LoanBankReqServiceImpl.class);\n    private static final String SOURCE_TABLE = CaseFormat.UPPER_CAMEL.to(CaseFormat.UPPER_UNDERSCORE,\n            TmsLoanBankReq.class.getSimpleName());\n\n    @Value(\"${contract.url.viewByCode}\")\n    private String setCMSUrl;\n    @Value(\"${contract.aesKey}\")\n    private String aesKey;\n    @Autowired\n    LoanCommonReqMyDao loanCommonReqMyDao;\n    @Autowired\n    FndDescFlexColumnApi fndDescFlexColumnApi;\n    @Autowired\n    private NumberGenerater numberGenerater;\n    @Autowired\n    private LoanBankListService loanBankListService;\n    @Autowired\n    private LoanBankDrawService loanBankDrawService;\n    @Autowired\n    private LoanBankIrsService loanBankIrsService;\n    @Autowired\n    private FndFlexValueApi fndFlexValueApi;\n    @Autowired\n    private FndLookupApi fndLookupApi;\n    @Autowired\n    private TransactionTypeService transactionTypeService;\n    @Autowired\n    private LoanCommonEventService loanCommonEventService;\n    @Autowired\n    private LoanCommonEventMyDao loanCommonEventMyDao;\n\n    @Override\n    public List<LoanCommonReqSuggest> reqNumSuggest(LoanCommonReqQueryCon condition) {\n        PageParams pageParams = new PageParams(1, 10);\n        // 判断是否分页\n        if (pageParams != null && pageParams.getPage() > 0 && pageParams.getPageSize() > 0) {\n            PageHelper.startPage(pageParams.getPage(), pageParams.getPageSize());\n        }\n        return new PageInfo<>(loanCommonReqMyDao.reqNumSuggest(condition)).getList();\n    }\n\n    @Override\n    public PageInfo<LoanCommonReqList> findByCondition(LoanCommonReqQueryCon condition) {\n        // 加分页参数\n        PageParams pageParams = new PageParams(condition.getPage(), condition.getPageSize());\n        // 判断是否分页\n        if (pageParams != null && pageParams.getPage() > 0 && pageParams.getPageSize() > 0) {\n            PageHelper.startPage(pageParams.getPage(), pageParams.getPageSize());\n        }\n        List<LoanCommonReqList> list = loanCommonReqMyDao.queryByCondition(condition);\n        fndFlexValueApi.translate(list, \"processType\", BizConstants.FndFlexSet.TMS_DEAL_TYPE);\n        UICTransInfoUtils uicUtils = UICTransInfoUtils.getInstance();\n        list.forEach(record -> {\n            Map<String, String> trxTypeCodeAndNamePairs = transactionTypeService.getCodeAndNamePairs\n                    (record.getProcessType());\n            record.setProductTypeName(trxTypeCodeAndNamePairs.get(record.getProductType()));\n            UICUserInfoDto realUser = uicUtils.getUserByUserName(record.getReqBy());\n            record.setReqByName(realUser.getName());\n        });\n\n        return new PageInfo<>(list);\n    }\n\n    @Override\n    public LoanBankReqHead initLoanBankReq() {\n        SequenceGenerator sequenceGenerator = sequenceFactory.name(\"tmsLoanBankReq\");\n        Long id = sequenceGenerator.nextLongValue();\n        LoanBankReqHead reqHead = new LoanBankReqHead();\n        reqHead.setBankReqId(id);\n        String nextNum = numberGenerater\n                .generateCommonNumber(\"tms_loan_bank_req\", \"bank_req_num\", \"L\", 4, s -> StringUtils\n                        .substringAfterLast(s, \"L\"));\n        reqHead.setBankReqNum(nextNum);\n        reqHead.setLoanAddtionInfoColumns(fndDescFlexColumnApi.selectByFlexAndContext(SOURCE_TABLE,\n                \"ATTRIBUTE_CATEGORY\", LoanConstants.LOAN_ADDITIONINF));\n        return reqHead;\n    }\n\n    @Override\n    public LoanBankReqHead saveHead(LoanBankReqHead loanBankReqHead) {\n        TmsLoanBankReq bankReq = this.findOne(loanBankReqHead.getBankReqId());\n        if (bankReq == null) {\n            loanBankReqHead.setAmountOutstanding(new BigDecimal(0));\n        }\n        loanBankReqHead.setProcessType(LoanConstants.LOAN);\n        loanBankReqHead.setReqBy(SessionUtils.getSessionUser().getUicUser().getUsername());\n        loanBankReqHead.setReqDate(new Date());\n        String encryptContractNums = \"\";\n        if (StringUtils.isNotBlank(loanBankReqHead.getContractNo())) {\n            String[] contractNos = org.apache.commons.lang3.StringUtils.split(loanBankReqHead.getContractNo(),\n                    PERSON_SPLIT);\n            List<String> contractNoList = Arrays.asList(contractNos);\n            for (String contractNo : contractNoList) {\n                try {\n                    encryptContractNums = encryptContractNums + DESUtil.aesEncrypt(contractNo, aesKey) + \",\";\n                } catch (Exception e) {\n                    e.printStackTrace();\n                }\n            }\n        }\n        loanBankReqHead.setEncryptContractNum(encryptContractNums);\n        this.saveOrUpdatePre(loanBankReqHead);\n        return loanBankReqHead;\n    }\n\n    @Override\n    public LoanBankListDetail saveBankList(LoanBankListDetail list) {\n        TmsLoanBankList example = new TmsLoanBankList();\n        example.setBankType(list.getBankType());\n        example.setBankName(list.getBankName());\n        example.setBankReqId(list.getBankReqId());\n        List<TmsLoanBankList> bankLists = loanBankListService.findList(example);\n        if (bankLists.size() > 0 && !bankLists.get(0).getBankListId().equals(list.getBankListId())) {\n            throw new ServiceException(\"相同贷款行类型下，名称不可以重复！\");\n        }\n        loanBankListService.saveBankList(list);\n        return list;\n    }\n\n    @Override\n    public void deleteBankList(Long id) {\n        loanBankListService.delete(id);\n    }\n\n    @Override\n    public String getNewDrawNum() {\n        String nextNum = numberGenerater\n                .generateCommonNumber(\"tms_loan_bank_draw\", \"draw_num\", \"D\", 4, s -> StringUtils\n                        .substringAfterLast(s, \"D\"));\n        return nextNum;\n    }\n\n    @Override\n    public String getNewIrsNum() {\n        String irsNum = numberGenerater\n                .generateCommonNumber(\"tms_loan_bank_irs\", \"irs_num\", \"IRS\", 4, s -> StringUtils\n                        .substringAfterLast(s, \"IRS\"));\n        return irsNum;\n    }\n\n    private void validateDraw(LoanBankDrawDetail drawDetail) {\n        TmsLoanBankReq req = this.findOne(drawDetail.getBankReqId());\n        BigDecimal amount;\n        if (\"Term Loan\".equals(drawDetail.getDrawType())) {\n            amount = req.getFixedAmount().subtract(drawDetail.getDrawAmount());\n        } else {\n            amount = req.getCycleAmount().subtract(drawDetail.getDrawAmount());\n        }\n        if (amount.compareTo(BigDecimal.ZERO) < 0) {\n            throw new ServiceException(\"提款金额超过单据金额！\");\n        }\n        TmsLoanBankDraw con = new TmsLoanBankDraw();\n        con.setBankReqId(drawDetail.getBankReqId());\n        List<TmsLoanBankDraw> list = loanBankDrawService.findList(con);\n        for (TmsLoanBankDraw rec : list) {\n            if (!rec.getDrawId().equals(drawDetail.getDrawId()) && !LoanConstants.INVALID.equals(rec.getStatus())) {\n                if (rec.getDrawType().equals(drawDetail.getDrawType())) {\n                    amount = amount.subtract(rec.getDrawAmount());\n                    if (amount.compareTo(BigDecimal.ZERO) < 0) {\n                        throw new ServiceException(\"提款金额超过单据可提款金额！\");\n                    }\n                }\n            }\n        }\n    }\n\n    private boolean isSameDay(final Date date1, final Date date2) {\n        if (date1 == null && date2 == null) {\n            return true;\n        }\n        if (date1 == null || date2 == null) {\n            return false;\n        }\n        final Calendar cal1 = Calendar.getInstance();\n        cal1.setTime(date1);\n        final Calendar cal2 = Calendar.getInstance();\n        cal2.setTime(date2);\n        return DateUtils.isSameDay(cal1, cal2);\n    }\n\n    private boolean isSameBigDecimal(final BigDecimal x, final BigDecimal y) {\n        if (x == null && y == null) {\n            return true;\n        }\n        if (x == null || y == null) {\n            return false;\n        }\n        if (x.compareTo(y) == 0) {\n            return true;\n        }\n        return false;\n    }\n\n    private boolean drawCompare(LoanBankDrawDetail drawDetail, TmsLoanBankDraw bankDrawOrigin) {\n        if (bankDrawOrigin == null) {\n            return true;\n        }\n        if (!isSameBigDecimal(drawDetail.getDrawAmount(), bankDrawOrigin.getDrawAmount()) || !isSameDay(drawDetail\n                .getBeginDate(), bankDrawOrigin.getBeginDate()) || !isSameDay(drawDetail\n                .getEndDate(), bankDrawOrigin.getEndDate()) || !StringUtils.equals(drawDetail.getDrawType()\n                , bankDrawOrigin.getDrawType()) || !StringUtils.equals(drawDetail.getInterestCycle()\n                , bankDrawOrigin.getInterestCycle()) || !StringUtils.equals(drawDetail.getBaseRateType()\n                , bankDrawOrigin.getBaseRateType()) || !StringUtils.equals(drawDetail.getInterestType()\n                , bankDrawOrigin.getInterestType()) || !StringUtils.equals(drawDetail.getStatus()\n                , bankDrawOrigin.getStatus()) || !StringUtils.equals(drawDetail.getRateType()\n                , bankDrawOrigin.getRateType()) || !isSameBigDecimal(drawDetail.getMargin(), bankDrawOrigin.getMargin\n                ()) || !isSameBigDecimal(drawDetail.getRate(), bankDrawOrigin.getRate())) {\n            return true;\n        }\n        return false;\n    }\n\n    @Override\n    public LoanBankDrawDetail saveDrawIrs(LoanBankDrawDetail drawDetail) {\n        validateDraw(drawDetail);\n        TmsLoanBankDraw bankDrawOrigin = new TmsLoanBankDraw();\n        if (drawDetail.getDrawId() != null) {\n            bankDrawOrigin = loanBankDrawService.findOne(drawDetail.getDrawId());\n        }\n        if (!StringUtils.equals(bankDrawOrigin.getStatus(), drawDetail.getStatus()) && LoanConstants.EFFECTIVE.equals\n                (drawDetail.getStatus())) {\n            drawDetail.setDrawAmountRemain(drawDetail.getDrawAmount());\n        }\n        if (bankDrawOrigin != null && bankDrawOrigin.getRepayment() != null) {\n            throw new ServiceException(\"此提款处于还款暂存状态，不能编辑!\");\n        }\n        loanBankDrawService.saveBankDraw(drawDetail);\n        BigDecimal drawAmount = drawDetail.getDrawAmount();\n        for (LoanBankIrsDetail irs : drawDetail.getIrsList()) {\n            drawAmount = drawAmount.subtract(irs.getIrsExchangeAmount());\n            if (drawAmount.compareTo(BigDecimal.ZERO) < 0) {\n                throw new ServiceException(\"IRS/CCS金额超过提款金额！\");\n            }\n            irs.setDrawId(drawDetail.getDrawId());\n            loanCommonEventService.validateEvent(drawDetail.getBankReqId(), drawDetail.getDrawId(), irs);\n            if (\"Y\".equals(irs.getDeleteFlag())) {\n                loanCommonEventService.deleteMIrsEvent(drawDetail.getBankReqId(), LoanConstants.LOAN, drawDetail\n                        .getDrawId(), irs.getIrsNum());\n                loanBankIrsService.delete(irs.getIrsId());\n            } else {\n                loanBankIrsService.saveBankIrs(irs);\n            }\n        }\n        if (LoanConstants.INVALID.equals(bankDrawOrigin.getStatus())) {\n            throw new ServiceException(\"请重新查询刷新页面后再操作！\");\n        } else if (StringUtils.equals(bankDrawOrigin.getStatus(), drawDetail.getStatus()) && LoanConstants.EFFECTIVE\n                .equals(drawDetail.getStatus())) {\n            if (drawCompare(drawDetail, bankDrawOrigin)) {\n                throw new ServiceException(\"请重新查询刷新页面后再操作！\");\n            }\n            loanCommonEventService.editBankEvent(drawDetail);\n        } else if (LoanConstants.EFFECTIVE.equals(bankDrawOrigin.getStatus()) && !LoanConstants.EFFECTIVE.equals\n                (drawDetail.getStatus())) {\n            throw new ServiceException(\"请重新查询刷新页面后再操作！\");\n        } else if (!StringUtils.equals(bankDrawOrigin.getStatus(), drawDetail.getStatus()) && LoanConstants.INVALID\n                .equals(drawDetail.getStatus())) {\n            loanCommonEventService.disableBankEvent(drawDetail);\n        } else {\n            if (LoanConstants.EFFECTIVE.equals(drawDetail.getStatus())) {\n                TmsLoanBankReq bankReq = this.findOne(drawDetail.getBankReqId());\n                bankReq.setAmountOutstanding(drawDetail.getDrawAmount().add(bankReq.getAmountOutstanding()));\n                this.saveOrUpdate(bankReq);\n            }\n            loanCommonEventService.createBankEvent(drawDetail);\n        }\n        return drawDetail;\n    }\n\n    @Override\n    public LoanBankReqDetail findBankReq(Long id) {\n        LoanBankReqDetail detail = new LoanBankReqDetail();\n        // 银行贷款头信息\n        TmsLoanBankReq req = this.findOne(id);\n        LoanBankReqHead reqHead = new LoanBankReqHead();\n        UtilType.copyProperties(reqHead, req);\n        Map<String, String> trxTypeCodeAndNamePairs = transactionTypeService.getCodeAndNamePairs\n                (reqHead.getProcessType());\n        reqHead.setProductTypeName(trxTypeCodeAndNamePairs.get(reqHead.getProductType()));\n        reqHead.setLoanAddtionInfoColumns(fndDescFlexColumnApi.selectByFlexAndContext(SOURCE_TABLE,\n                \"ATTRIBUTE_CATEGORY\", LoanConstants.LOAN_ADDITIONINF));\n        for (FndDescFlexColumnsCom flexColumn : reqHead.getLoanAddtionInfoColumns()) {\n            String dataType = flexColumn.getDataType();\n            if (StringUtils.isNotBlank(dataType) && dataType.equalsIgnoreCase(\"suggest\")) {\n                fndFlexValueApi.translate(reqHead, flexColumn.getAttributeColumn(),\n                        flexColumn.getDataParameter());\n            }\n        }\n        reqHead.setBizPk(String.valueOf(reqHead.getBankReqId()));\n        reqHead.setBizType(CommonEnums.AttachmentBizType.LOAN_BANK_REQ_ATTACH.getValue());\n        reqHead.setCmsUrl(setCMSUrl);\n        String encryptContractNums = \"\";\n        if (StringUtils.isNotBlank(reqHead.getContractNo())) {\n            String[] contractNos = org.apache.commons.lang3.StringUtils.split(reqHead.getContractNo(), PERSON_SPLIT);\n            List<String> contractNoList = Arrays.asList(contractNos);\n            for (String contractNo : contractNoList) {\n                try {\n                    encryptContractNums = encryptContractNums + DESUtil.aesEncrypt(contractNo, aesKey) + \",\";\n                } catch (Exception e) {\n                    e.printStackTrace();\n                }\n            }\n        }\n        reqHead.setEncryptContractNum(encryptContractNums);\n        detail.setReqHead(reqHead);\n        // 银行贷款银行信息\n        TmsLoanBankList bankListCon = new TmsLoanBankList();\n        bankListCon.setBankReqId(id);\n        List<TmsLoanBankList> bankList = loanBankListService.findList(bankListCon);\n        List<LoanBankListDetail> bankListDetail = new ArrayList<>();\n        bankList.forEach(record -> {\n            LoanBankListDetail listDetail = new LoanBankListDetail();\n            UtilType.copyProperties(listDetail, record);\n            bankListDetail.add(listDetail);\n        });\n        detail.setBankList(bankListDetail);\n        // 银行贷款提款信息\n        TmsLoanBankDraw drawCon = new TmsLoanBankDraw();\n        drawCon.setBankReqId(id);\n        List<TmsLoanBankDraw> drawList = loanBankDrawService.findList(drawCon);\n        List<LoanBankDrawDetail> drawDetailsList = new ArrayList<>();\n        drawList.forEach(record -> {\n            LoanBankDrawDetail drawDetail = new LoanBankDrawDetail();\n            UtilType.copyProperties(drawDetail, record);\n            TmsLoanBankIrs irsCon = new TmsLoanBankIrs();\n            irsCon.setDrawId(record.getDrawId());\n            List<TmsLoanBankIrs> irsList = loanBankIrsService.findList(irsCon);\n            List<LoanBankIrsDetail> irsDetailList = new ArrayList<>();\n            irsList.forEach(irs -> {\n                LoanBankIrsDetail irsDetail = new LoanBankIrsDetail();\n                UtilType.copyProperties(irsDetail, irs);\n                fndFlexValueApi.translate(irsDetail, \"irsInterestCycle\", BizConstants.FndFlexSet\n                        .TMS_DEAL_LOAN_FREQUENCY);\n                fndLookupApi.translate(irsDetail, \"irsInterestType\", BizConstants.FndLookupType\n                        .TMS_DEAL_LOAN_IRMODE);\n                LoanCommonEventQueryCon con = new LoanCommonEventQueryCon();\n                con.setRequestId(id);\n                con.setRequestType(LoanConstants.LOAN);\n                con.setDetailId(irs.getDrawId());\n                con.setIrsNum(irs.getIrsNum());\n                List<LoanCommonEventInfo> eventList = loanCommonEventMyDao.findIrsEvent(con);\n                if (eventList.size() > 0) {\n                    irsDetail.setDisabledFlag(\"Y\");\n                }\n                if (irsDetail.getIrsEndDate() != null) {\n                    irsDetail.setDisabledFlag(\"Y\");\n                }\n                irsDetailList.add(irsDetail);\n            });\n            drawDetail.setIrsList(irsDetailList);\n            drawDetailsList.add(drawDetail);\n        });\n        detail.setDrawList(drawDetailsList);\n        fndFlexValueApi.translate(detail.getReqHead(), \"rateType\", BizConstants.FndFlexSet.TMS_DEAL_INTEREST_TYPE,\n                \"baseRateType\", BizConstants.FndFlexSet.TMS_DEAL_IR_Reference);\n        fndLookupApi.translate(detail.getReqHead(), \"interestType\", BizConstants.FndLookupType.TMS_DEAL_IR_MODE);\n        fndFlexValueApi.translate(detail.getBankList(), \"bankType\", BizConstants.FndFlexSet.TMS_LOAN_BANK_TYPE);\n        fndFlexValueApi.translate(detail.getDrawList(), \"rateType\", BizConstants.FndFlexSet.TMS_DEAL_INTEREST_TYPE,\n                \"baseRateType\", BizConstants.FndFlexSet.TMS_DEAL_IR_Reference, \"status\", BizConstants.FndFlexSet\n                        .TMS_DRAWDOWN_STATUS, \"drawType\", BizConstants.FndFlexSet.TMS_DEAL_DRAWDOWNTYPE,\n                \"interestCycle\", BizConstants.FndFlexSet.TMS_DEAL_LOAN_FREQUENCY, \"irsFlag\", BizConstants.FndFlexSet\n                        .TMS_DERIVATIVE_TYPE);\n        fndLookupApi.translate(detail.getDrawList(), \"interestType\", BizConstants.FndLookupType.TMS_DEAL_LOAN_IRMODE);\n\n        return detail;\n    }\n\n    @Override\n    public List<LoanBankDrawList> bankDrawList(LoanCommonReqQueryCon condition) {\n        List<LoanBankDrawList> list = loanCommonReqMyDao.bankDrawList(condition);\n        return list;\n    }\n\n    @Override\n    public void terminatIrs(LoanBankIrsDetail irsDetail) {\n        TmsLoanBankDraw draw = loanBankDrawService.findOne(irsDetail.getDrawId());\n        LoanBankDrawDetail drawDetail = new LoanBankDrawDetail();\n        UtilType.copyProperties(drawDetail, draw);\n        TmsLoanBankIrs irsCon = new TmsLoanBankIrs();\n        irsCon.setDrawId(irsDetail.getDrawId());\n       /* List<TmsLoanBankIrs> irsList = loanBankIrsService.findList(irsCon);\n        List<LoanBankIrsDetail> irsDetailList = new ArrayList<>();\n        irsList.forEach(irs -> {\n            LoanBankIrsDetail irsDetailTemp = new LoanBankIrsDetail();\n            UtilType.copyProperties(irsDetailTemp, irs);\n            LoanCommonEventQueryCon con = new LoanCommonEventQueryCon();\n            con.setRequestId(draw.getBankReqId());\n            con.setRequestType(LoanConstants.LOAN);\n            con.setDetailId(irs.getDrawId());\n            con.setIrsNum(irs.getIrsNum());\n            List<LoanCommonEventInfo> eventList = loanCommonEventMyDao.findIrsEvent(con);\n            if (irsDetailTemp.getIrsEndDate() != null || eventList.size() > 0) {\n                irsDetailTemp.setDisabledFlag(\"Y\");\n            }\n            irsDetailList.add(irsDetailTemp);\n        });\n        drawDetail.setIrsList(irsDetailList);*/\n        loanCommonEventService.irsTerminateEvent(drawDetail, irsDetail);\n        loanBankIrsService.saveBankIrs(irsDetail);\n    }\n\n    @Override\n    public void bankPrepayment(List<LoanBankDrawList> prepaymentList) {\n        prepaymentList.forEach(rec -> {\n            if (rec.getRepayment() != null && rec.getRepaymentDate() != null && rec.getRepaymentDate().getTime() <=\n                    rec.getEndDate().getTime()) {\n                TmsLoanBankDraw draw = loanBankDrawService.findOne(rec.getDrawId());\n                if (draw.getDrawAmountRemain().compareTo(rec.getRepayment()) >= 0) {\n                    loanCommonEventService.bankPrepayment(draw, rec);\n                    if (\"Y\".equals(rec.getRepaymentConfirm())) {\n                        draw.setDrawAmountRemain(draw.getDrawAmountRemain().subtract(rec.getRepayment()));\n                        draw.setRepayment(null);\n                        draw.setRepaymentDate(null);\n                        draw.setRepaymentConfirm(null);\n                    } else {\n                        draw.setRepayment(rec.getRepayment());\n                        draw.setRepaymentDate(rec.getRepaymentDate());\n                        draw.setRepaymentConfirm(rec.getRepaymentConfirm());\n                    }\n                    loanBankDrawService.saveBankDraw(draw);\n                }\n            }\n        });\n    }\n\n    @Override\n    public List<LoanCommonReqList> getDatasByCondition(LoanCommonReqQueryCon condition) {\n        List<LoanCommonReqList> list = loanCommonReqMyDao.queryByCondition(condition);\n        fndFlexValueApi.translate(list, \"processType\", BizConstants.FndFlexSet.TMS_DEAL_TYPE);\n        UICTransInfoUtils uicUtils = UICTransInfoUtils.getInstance();\n        list.forEach(record -> {\n            Map<String, String> trxTypeCodeAndNamePairs = transactionTypeService.getCodeAndNamePairs\n                    (record.getProcessType());\n            record.setProductTypeName(trxTypeCodeAndNamePairs.get(record.getProductType()));\n            UICUserInfoDto realUser = uicUtils.getUserByUserName(record.getReqBy());\n            record.setReqByName(realUser.getName());\n        });\n        return list;\n    }\n\n}\n",
                "content": "package com.baidu.tms.loan.service.impl;\n\nimport com.baidu.p2p.commons.constants.BizConstants;\nimport com.baidu.p2p.commons.constants.CommonEnums;\nimport com.baidu.p2p.core.j2ee.exception.ServiceException;\nimport com.baidu.p2p.core.jdbc.pk.NumberGenerater;\nimport com.baidu.p2p.core.jdbc.pk.SequenceGenerator;\nimport com.baidu.p2p.core.utils.DESUtil;\nimport com.baidu.p2p.core.utils.DateUtils;\nimport com.baidu.p2p.core.utils.UtilType;\nimport com.baidu.p2p.fnd.api.FndDescFlexColumnApi;\nimport com.baidu.p2p.fnd.api.FndFlexValueApi;\nimport com.baidu.p2p.fnd.api.FndLookupApi;\nimport com.baidu.p2p.fnd.domain.FndDescFlexColumnsCom;\nimport com.baidu.p2p.system.dto.PageParams;\nimport com.baidu.p2p.system.service.SysCrudService;\nimport com.baidu.p2p.system.uic.UICTransInfoUtils;\nimport com.baidu.p2p.system.uic.dto.UICUserInfoDto;\nimport com.baidu.p2p.system.web.session.SessionUtils;\nimport com.baidu.tms.loan.dao.LoanCommonEventMyDao;\nimport com.baidu.tms.loan.dao.LoanCommonReqMyDao;\nimport com.baidu.tms.loan.domain.LoanBankDrawDetail;\nimport com.baidu.tms.loan.domain.LoanBankDrawList;\nimport com.baidu.tms.loan.domain.LoanBankIrsDetail;\nimport com.baidu.tms.loan.domain.LoanBankListDetail;\nimport com.baidu.tms.loan.domain.LoanBankReqDetail;\nimport com.baidu.tms.loan.domain.LoanBankReqHead;\nimport com.baidu.tms.loan.domain.LoanCommonEventInfo;\nimport com.baidu.tms.loan.domain.LoanCommonEventQueryCon;\nimport com.baidu.tms.loan.domain.LoanCommonReqList;\nimport com.baidu.tms.loan.domain.LoanCommonReqQueryCon;\nimport com.baidu.tms.loan.domain.LoanCommonReqSuggest;\nimport com.baidu.tms.loan.service.LoanBankDrawService;\nimport com.baidu.tms.loan.service.LoanBankIrsService;\nimport com.baidu.tms.loan.service.LoanBankListService;\nimport com.baidu.tms.loan.service.LoanBankReqService;\nimport com.baidu.tms.loan.service.LoanCommonEventService;\nimport com.baidu.tms.loan.util.LoanConstants;\nimport com.baidu.tms.persistent.loan.dao.TmsLoanBankReqDAO;\nimport com.baidu.tms.persistent.loan.domain.TmsLoanBankDraw;\nimport com.baidu.tms.persistent.loan.domain.TmsLoanBankIrs;\nimport com.baidu.tms.persistent.loan.domain.TmsLoanBankList;\nimport com.baidu.tms.persistent.loan.domain.TmsLoanBankReq;\nimport com.baidu.tms.trx.service.TransactionTypeService;\nimport com.github.pagehelper.PageHelper;\nimport com.github.pagehelper.PageInfo;\nimport com.google.common.base.CaseFormat;\nimport org.apache.commons.lang.StringUtils;\nimport org.apache.logging.log4j.LogManager;\nimport org.apache.logging.log4j.Logger;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.beans.factory.annotation.Value;\nimport org.springframework.stereotype.Service;\n\nimport java.math.BigDecimal;\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.Calendar;\nimport java.util.Date;\nimport java.util.List;\nimport java.util.Map;\n\nimport static com.baidu.p2p.bpm.common.ProcessConstants.PERSON_SPLIT;\n\n@Service\npublic class LoanBankReqServiceImpl extends SysCrudService<TmsLoanBankReqDAO, TmsLoanBankReq> implements\n        LoanBankReqService {\n\n    private static Logger logger = LogManager.getLogger(LoanBankReqServiceImpl.class);\n    private static final String SOURCE_TABLE = CaseFormat.UPPER_CAMEL.to(CaseFormat.UPPER_UNDERSCORE,\n            TmsLoanBankReq.class.getSimpleName());\n\n    @Value(\"${contract.url.viewByCode}\")\n    private String setCMSUrl;\n    @Value(\"${contract.aesKey}\")\n    private String aesKey;\n    @Autowired\n    LoanCommonReqMyDao loanCommonReqMyDao;\n    @Autowired\n    FndDescFlexColumnApi fndDescFlexColumnApi;\n    @Autowired\n    private NumberGenerater numberGenerater;\n    @Autowired\n    private LoanBankListService loanBankListService;\n    @Autowired\n    private LoanBankDrawService loanBankDrawService;\n    @Autowired\n    private LoanBankIrsService loanBankIrsService;\n    @Autowired\n    private FndFlexValueApi fndFlexValueApi;\n    @Autowired\n    private FndLookupApi fndLookupApi;\n    @Autowired\n    private TransactionTypeService transactionTypeService;\n    @Autowired\n    private LoanCommonEventService loanCommonEventService;\n    @Autowired\n    private LoanCommonEventMyDao loanCommonEventMyDao;\n\n    @Override\n    public List<LoanCommonReqSuggest> reqNumSuggest(LoanCommonReqQueryCon condition) {\n        PageParams pageParams = new PageParams(1, 10);\n        // 判断是否分页\n        if (pageParams != null && pageParams.getPage() > 0 && pageParams.getPageSize() > 0) {\n            PageHelper.startPage(pageParams.getPage(), pageParams.getPageSize());\n        }\n        return new PageInfo<>(loanCommonReqMyDao.reqNumSuggest(condition)).getList();\n    }\n\n    @Override\n    public PageInfo<LoanCommonReqList> findByCondition(LoanCommonReqQueryCon condition) {\n        // 加分页参数\n        PageParams pageParams = new PageParams(condition.getPage(), condition.getPageSize());\n        // 判断是否分页\n        if (pageParams != null && pageParams.getPage() > 0 && pageParams.getPageSize() > 0) {\n            PageHelper.startPage(pageParams.getPage(), pageParams.getPageSize());\n        }\n        List<LoanCommonReqList> list = loanCommonReqMyDao.queryByCondition(condition);\n        fndFlexValueApi.translate(list, \"processType\", BizConstants.FndFlexSet.TMS_DEAL_TYPE);\n        UICTransInfoUtils uicUtils = UICTransInfoUtils.getInstance();\n        list.forEach(record -> {\n            Map<String, String> trxTypeCodeAndNamePairs = transactionTypeService.getCodeAndNamePairs\n                    (record.getProcessType());\n            record.setProductTypeName(trxTypeCodeAndNamePairs.get(record.getProductType()));\n            if (StringUtils.isNotBlank(record.getReqBy())) {\n                try {\n                    UICUserInfoDto realUser = uicUtils.getUserByUserName(record.getReqBy());\n                    record.setReqByName(realUser != null ? realUser.getName() : record.getReqBy());\n                } catch (Exception e) {\n                    log.warn(\"Failed to get user info for {}\", record.getReqBy(), e);\n                    record.setReqByName(record.getReqBy());\n                }\n            }\n        });\n\n        return new PageInfo<>(list);\n    }\n\n    @Override\n    public LoanBankReqHead initLoanBankReq() {\n        SequenceGenerator sequenceGenerator = sequenceFactory.name(\"tmsLoanBankReq\");\n        Long id = sequenceGenerator.nextLongValue();\n        LoanBankReqHead reqHead = new LoanBankReqHead();\n        reqHead.setBankReqId(id);\n        String nextNum = numberGenerater\n                .generateCommonNumber(\"tms_loan_bank_req\", \"bank_req_num\", \"L\", 4, s -> StringUtils\n                        .substringAfterLast(s, \"L\"));\n        reqHead.setBankReqNum(nextNum);\n        reqHead.setLoanAddtionInfoColumns(fndDescFlexColumnApi.selectByFlexAndContext(SOURCE_TABLE,\n                \"ATTRIBUTE_CATEGORY\", LoanConstants.LOAN_ADDITIONINF));\n        return reqHead;\n    }\n\n    @Override\n    public LoanBankReqHead saveHead(LoanBankReqHead loanBankReqHead) {\n        TmsLoanBankReq bankReq = this.findOne(loanBankReqHead.getBankReqId());\n        if (bankReq == null) {\n            loanBankReqHead.setAmountOutstanding(new BigDecimal(0));\n        }\n        loanBankReqHead.setProcessType(LoanConstants.LOAN);\n        loanBankReqHead.setReqBy(SessionUtils.getSessionUser().getUicUser().getUsername());\n        loanBankReqHead.setReqDate(new Date());\n        String encryptContractNums = \"\";\n        if (StringUtils.isNotBlank(loanBankReqHead.getContractNo())) {\n            String[] contractNos = org.apache.commons.lang3.StringUtils.split(loanBankReqHead.getContractNo(),\n                    PERSON_SPLIT);\n            List<String> contractNoList = Arrays.asList(contractNos);\n            for (String contractNo : contractNoList) {\n                try {\n                    encryptContractNums = encryptContractNums + DESUtil.aesEncrypt(contractNo, aesKey) + \",\";\n                } catch (Exception e) {\n                    e.printStackTrace();\n                }\n            }\n        }\n        loanBankReqHead.setEncryptContractNum(encryptContractNums);\n        this.saveOrUpdatePre(loanBankReqHead);\n        return loanBankReqHead;\n    }\n\n    @Override\n    public LoanBankListDetail saveBankList(LoanBankListDetail list) {\n        TmsLoanBankList example = new TmsLoanBankList();\n        example.setBankType(list.getBankType());\n        example.setBankName(list.getBankName());\n        example.setBankReqId(list.getBankReqId());\n        List<TmsLoanBankList> bankLists = loanBankListService.findList(example);\n        if (bankLists.size() > 0 && !bankLists.get(0).getBankListId().equals(list.getBankListId())) {\n            throw new ServiceException(\"相同贷款行类型下，名称不可以重复！\");\n        }\n        loanBankListService.saveBankList(list);\n        return list;\n    }\n\n    @Override\n    public void deleteBankList(Long id) {\n        loanBankListService.delete(id);\n    }\n\n    @Override\n    public String getNewDrawNum() {\n        String nextNum = numberGenerater\n                .generateCommonNumber(\"tms_loan_bank_draw\", \"draw_num\", \"D\", 4, s -> StringUtils\n                        .substringAfterLast(s, \"D\"));\n        return nextNum;\n    }\n\n    @Override\n    public String getNewIrsNum() {\n        String irsNum = numberGenerater\n                .generateCommonNumber(\"tms_loan_bank_irs\", \"irs_num\", \"IRS\", 4, s -> StringUtils\n                        .substringAfterLast(s, \"IRS\"));\n        return irsNum;\n    }\n\n    private void validateDraw(LoanBankDrawDetail drawDetail) {\n        TmsLoanBankReq req = this.findOne(drawDetail.getBankReqId());\n        BigDecimal amount;\n        if (\"Term Loan\".equals(drawDetail.getDrawType())) {\n            amount = req.getFixedAmount().subtract(drawDetail.getDrawAmount());\n        } else {\n            amount = req.getCycleAmount().subtract(drawDetail.getDrawAmount());\n        }\n        if (amount.compareTo(BigDecimal.ZERO) < 0) {\n            throw new ServiceException(\"提款金额超过单据金额！\");\n        }\n        TmsLoanBankDraw con = new TmsLoanBankDraw();\n        con.setBankReqId(drawDetail.getBankReqId());\n        List<TmsLoanBankDraw> list = loanBankDrawService.findList(con);\n        for (TmsLoanBankDraw rec : list) {\n            if (!rec.getDrawId().equals(drawDetail.getDrawId()) && !LoanConstants.INVALID.equals(rec.getStatus())) {\n                if (rec.getDrawType().equals(drawDetail.getDrawType())) {\n                    amount = amount.subtract(rec.getDrawAmount());\n                    if (amount.compareTo(BigDecimal.ZERO) < 0) {\n                        throw new ServiceException(\"提款金额超过单据可提款金额！\");\n                    }\n                }\n            }\n        }\n    }\n\n    private boolean isSameDay(final Date date1, final Date date2) {\n        if (date1 == null && date2 == null) {\n            return true;\n        }\n        if (date1 == null || date2 == null) {\n            return false;\n        }\n        final Calendar cal1 = Calendar.getInstance();\n        cal1.setTime(date1);\n        final Calendar cal2 = Calendar.getInstance();\n        cal2.setTime(date2);\n        return DateUtils.isSameDay(cal1, cal2);\n    }\n\n    private boolean isSameBigDecimal(final BigDecimal x, final BigDecimal y) {\n        if (x == null && y == null) {\n            return true;\n        }\n        if (x == null || y == null) {\n            return false;\n        }\n        if (x.compareTo(y) == 0) {\n            return true;\n        }\n        return false;\n    }\n\n    private boolean drawCompare(LoanBankDrawDetail drawDetail, TmsLoanBankDraw bankDrawOrigin) {\n        if (bankDrawOrigin == null) {\n            return true;\n        }\n        if (!isSameBigDecimal(drawDetail.getDrawAmount(), bankDrawOrigin.getDrawAmount()) || !isSameDay(drawDetail\n                .getBeginDate(), bankDrawOrigin.getBeginDate()) || !isSameDay(drawDetail\n                .getEndDate(), bankDrawOrigin.getEndDate()) || !StringUtils.equals(drawDetail.getDrawType()\n                , bankDrawOrigin.getDrawType()) || !StringUtils.equals(drawDetail.getInterestCycle()\n                , bankDrawOrigin.getInterestCycle()) || !StringUtils.equals(drawDetail.getBaseRateType()\n                , bankDrawOrigin.getBaseRateType()) || !StringUtils.equals(drawDetail.getInterestType()\n                , bankDrawOrigin.getInterestType()) || !StringUtils.equals(drawDetail.getStatus()\n                , bankDrawOrigin.getStatus()) || !StringUtils.equals(drawDetail.getRateType()\n                , bankDrawOrigin.getRateType()) || !isSameBigDecimal(drawDetail.getMargin(), bankDrawOrigin.getMargin\n                ()) || !isSameBigDecimal(drawDetail.getRate(), bankDrawOrigin.getRate())) {\n            return true;\n        }\n        return false;\n    }\n\n    @Override\n    public LoanBankDrawDetail saveDrawIrs(LoanBankDrawDetail drawDetail) {\n        validateDraw(drawDetail);\n        TmsLoanBankDraw bankDrawOrigin = new TmsLoanBankDraw();\n        if (drawDetail.getDrawId() != null) {\n            bankDrawOrigin = loanBankDrawService.findOne(drawDetail.getDrawId());\n        }\n        if (!StringUtils.equals(bankDrawOrigin.getStatus(), drawDetail.getStatus()) && LoanConstants.EFFECTIVE.equals\n                (drawDetail.getStatus())) {\n            drawDetail.setDrawAmountRemain(drawDetail.getDrawAmount());\n        }\n        if (bankDrawOrigin != null && bankDrawOrigin.getRepayment() != null) {\n            throw new ServiceException(\"此提款处于还款暂存状态，不能编辑!\");\n        }\n        loanBankDrawService.saveBankDraw(drawDetail);\n        BigDecimal drawAmount = drawDetail.getDrawAmount();\n        for (LoanBankIrsDetail irs : drawDetail.getIrsList()) {\n            drawAmount = drawAmount.subtract(irs.getIrsExchangeAmount());\n            if (drawAmount.compareTo(BigDecimal.ZERO) < 0) {\n                throw new ServiceException(\"IRS/CCS金额超过提款金额！\");\n            }\n            irs.setDrawId(drawDetail.getDrawId());\n            loanCommonEventService.validateEvent(drawDetail.getBankReqId(), drawDetail.getDrawId(), irs);\n            if (\"Y\".equals(irs.getDeleteFlag())) {\n                loanCommonEventService.deleteMIrsEvent(drawDetail.getBankReqId(), LoanConstants.LOAN, drawDetail\n                        .getDrawId(), irs.getIrsNum());\n                loanBankIrsService.delete(irs.getIrsId());\n            } else {\n                loanBankIrsService.saveBankIrs(irs);\n            }\n        }\n        if (LoanConstants.INVALID.equals(bankDrawOrigin.getStatus())) {\n            throw new ServiceException(\"请重新查询刷新页面后再操作！\");\n        } else if (StringUtils.equals(bankDrawOrigin.getStatus(), drawDetail.getStatus()) && LoanConstants.EFFECTIVE\n                .equals(drawDetail.getStatus())) {\n            if (drawCompare(drawDetail, bankDrawOrigin)) {\n                throw new ServiceException(\"请重新查询刷新页面后再操作！\");\n            }\n            loanCommonEventService.editBankEvent(drawDetail);\n        } else if (LoanConstants.EFFECTIVE.equals(bankDrawOrigin.getStatus()) && !LoanConstants.EFFECTIVE.equals\n                (drawDetail.getStatus())) {\n            throw new ServiceException(\"请重新查询刷新页面后再操作！\");\n        } else if (!StringUtils.equals(bankDrawOrigin.getStatus(), drawDetail.getStatus()) && LoanConstants.INVALID\n                .equals(drawDetail.getStatus())) {\n            loanCommonEventService.disableBankEvent(drawDetail);\n        } else {\n            if (LoanConstants.EFFECTIVE.equals(drawDetail.getStatus())) {\n                TmsLoanBankReq bankReq = this.findOne(drawDetail.getBankReqId());\n                bankReq.setAmountOutstanding(drawDetail.getDrawAmount().add(bankReq.getAmountOutstanding()));\n                this.saveOrUpdate(bankReq);\n            }\n            loanCommonEventService.createBankEvent(drawDetail);\n        }\n        return drawDetail;\n    }\n\n    @Override\n    public LoanBankReqDetail findBankReq(Long id) {\n        LoanBankReqDetail detail = new LoanBankReqDetail();\n        // 银行贷款头信息\n        TmsLoanBankReq req = this.findOne(id);\n        LoanBankReqHead reqHead = new LoanBankReqHead();\n        UtilType.copyProperties(reqHead, req);\n        Map<String, String> trxTypeCodeAndNamePairs = transactionTypeService.getCodeAndNamePairs\n                (reqHead.getProcessType());\n        reqHead.setProductTypeName(trxTypeCodeAndNamePairs.get(reqHead.getProductType()));\n        reqHead.setLoanAddtionInfoColumns(fndDescFlexColumnApi.selectByFlexAndContext(SOURCE_TABLE,\n                \"ATTRIBUTE_CATEGORY\", LoanConstants.LOAN_ADDITIONINF));\n        for (FndDescFlexColumnsCom flexColumn : reqHead.getLoanAddtionInfoColumns()) {\n            String dataType = flexColumn.getDataType();\n            if (StringUtils.isNotBlank(dataType) && dataType.equalsIgnoreCase(\"suggest\")) {\n                fndFlexValueApi.translate(reqHead, flexColumn.getAttributeColumn(),\n                        flexColumn.getDataParameter());\n            }\n        }\n        reqHead.setBizPk(String.valueOf(reqHead.getBankReqId()));\n        reqHead.setBizType(CommonEnums.AttachmentBizType.LOAN_BANK_REQ_ATTACH.getValue());\n        reqHead.setCmsUrl(setCMSUrl);\n        String encryptContractNums = \"\";\n        if (StringUtils.isNotBlank(reqHead.getContractNo())) {\n            String[] contractNos = org.apache.commons.lang3.StringUtils.split(reqHead.getContractNo(), PERSON_SPLIT);\n            List<String> contractNoList = Arrays.asList(contractNos);\n            for (String contractNo : contractNoList) {\n                try {\n                    encryptContractNums = encryptContractNums + DESUtil.aesEncrypt(contractNo, aesKey) + \",\";\n                } catch (Exception e) {\n                    e.printStackTrace();\n                }\n            }\n        }\n        reqHead.setEncryptContractNum(encryptContractNums);\n        detail.setReqHead(reqHead);\n        // 银行贷款银行信息\n        TmsLoanBankList bankListCon = new TmsLoanBankList();\n        bankListCon.setBankReqId(id);\n        List<TmsLoanBankList> bankList = loanBankListService.findList(bankListCon);\n        List<LoanBankListDetail> bankListDetail = new ArrayList<>();\n        bankList.forEach(record -> {\n            LoanBankListDetail listDetail = new LoanBankListDetail();\n            UtilType.copyProperties(listDetail, record);\n            bankListDetail.add(listDetail);\n        });\n        detail.setBankList(bankListDetail);\n        // 银行贷款提款信息\n        TmsLoanBankDraw drawCon = new TmsLoanBankDraw();\n        drawCon.setBankReqId(id);\n        List<TmsLoanBankDraw> drawList = loanBankDrawService.findList(drawCon);\n        List<LoanBankDrawDetail> drawDetailsList = new ArrayList<>();\n        drawList.forEach(record -> {\n            LoanBankDrawDetail drawDetail = new LoanBankDrawDetail();\n            UtilType.copyProperties(drawDetail, record);\n            TmsLoanBankIrs irsCon = new TmsLoanBankIrs();\n            irsCon.setDrawId(record.getDrawId());\n            List<TmsLoanBankIrs> irsList = loanBankIrsService.findList(irsCon);\n            List<LoanBankIrsDetail> irsDetailList = new ArrayList<>();\n            irsList.forEach(irs -> {\n                LoanBankIrsDetail irsDetail = new LoanBankIrsDetail();\n                UtilType.copyProperties(irsDetail, irs);\n                fndFlexValueApi.translate(irsDetail, \"irsInterestCycle\", BizConstants.FndFlexSet\n                        .TMS_DEAL_LOAN_FREQUENCY);\n                fndLookupApi.translate(irsDetail, \"irsInterestType\", BizConstants.FndLookupType\n                        .TMS_DEAL_LOAN_IRMODE);\n                LoanCommonEventQueryCon con = new LoanCommonEventQueryCon();\n                con.setRequestId(id);\n                con.setRequestType(LoanConstants.LOAN);\n                con.setDetailId(irs.getDrawId());\n                con.setIrsNum(irs.getIrsNum());\n                List<LoanCommonEventInfo> eventList = loanCommonEventMyDao.findIrsEvent(con);\n                if (eventList.size() > 0) {\n                    irsDetail.setDisabledFlag(\"Y\");\n                }\n                if (irsDetail.getIrsEndDate() != null) {\n                    irsDetail.setDisabledFlag(\"Y\");\n                }\n                irsDetailList.add(irsDetail);\n            });\n            drawDetail.setIrsList(irsDetailList);\n            drawDetailsList.add(drawDetail);\n        });\n        detail.setDrawList(drawDetailsList);\n        fndFlexValueApi.translate(detail.getReqHead(), \"rateType\", BizConstants.FndFlexSet.TMS_DEAL_INTEREST_TYPE,\n                \"baseRateType\", BizConstants.FndFlexSet.TMS_DEAL_IR_Reference);\n        fndLookupApi.translate(detail.getReqHead(), \"interestType\", BizConstants.FndLookupType.TMS_DEAL_IR_MODE);\n        fndFlexValueApi.translate(detail.getBankList(), \"bankType\", BizConstants.FndFlexSet.TMS_LOAN_BANK_TYPE);\n        fndFlexValueApi.translate(detail.getDrawList(), \"rateType\", BizConstants.FndFlexSet.TMS_DEAL_INTEREST_TYPE,\n                \"baseRateType\", BizConstants.FndFlexSet.TMS_DEAL_IR_Reference, \"status\", BizConstants.FndFlexSet\n                        .TMS_DRAWDOWN_STATUS, \"drawType\", BizConstants.FndFlexSet.TMS_DEAL_DRAWDOWNTYPE,\n                \"interestCycle\", BizConstants.FndFlexSet.TMS_DEAL_LOAN_FREQUENCY, \"irsFlag\", BizConstants.FndFlexSet\n                        .TMS_DERIVATIVE_TYPE);\n        fndLookupApi.translate(detail.getDrawList(), \"interestType\", BizConstants.FndLookupType.TMS_DEAL_LOAN_IRMODE);\n\n        return detail;\n    }\n\n    @Override\n    public List<LoanBankDrawList> bankDrawList(LoanCommonReqQueryCon condition) {\n        List<LoanBankDrawList> list = loanCommonReqMyDao.bankDrawList(condition);\n        return list;\n    }\n\n    @Override\n    public void terminatIrs(LoanBankIrsDetail irsDetail) {\n        TmsLoanBankDraw draw = loanBankDrawService.findOne(irsDetail.getDrawId());\n        LoanBankDrawDetail drawDetail = new LoanBankDrawDetail();\n        UtilType.copyProperties(drawDetail, draw);\n        TmsLoanBankIrs irsCon = new TmsLoanBankIrs();\n        irsCon.setDrawId(irsDetail.getDrawId());\n       /* List<TmsLoanBankIrs> irsList = loanBankIrsService.findList(irsCon);\n        List<LoanBankIrsDetail> irsDetailList = new ArrayList<>();\n        irsList.forEach(irs -> {\n            LoanBankIrsDetail irsDetailTemp = new LoanBankIrsDetail();\n            UtilType.copyProperties(irsDetailTemp, irs);\n            LoanCommonEventQueryCon con = new LoanCommonEventQueryCon();\n            con.setRequestId(draw.getBankReqId());\n            con.setRequestType(LoanConstants.LOAN);\n            con.setDetailId(irs.getDrawId());\n            con.setIrsNum(irs.getIrsNum());\n            List<LoanCommonEventInfo> eventList = loanCommonEventMyDao.findIrsEvent(con);\n            if (irsDetailTemp.getIrsEndDate() != null || eventList.size() > 0) {\n                irsDetailTemp.setDisabledFlag(\"Y\");\n            }\n            irsDetailList.add(irsDetailTemp);\n        });\n        drawDetail.setIrsList(irsDetailList);*/\n        loanCommonEventService.irsTerminateEvent(drawDetail, irsDetail);\n        loanBankIrsService.saveBankIrs(irsDetail);\n    }\n\n    @Override\n    public void bankPrepayment(List<LoanBankDrawList> prepaymentList) {\n        prepaymentList.forEach(rec -> {\n            if (rec.getRepayment() != null && rec.getRepaymentDate() != null && rec.getRepaymentDate().getTime() <=\n                    rec.getEndDate().getTime()) {\n                TmsLoanBankDraw draw = loanBankDrawService.findOne(rec.getDrawId());\n                if (draw.getDrawAmountRemain().compareTo(rec.getRepayment()) >= 0) {\n                    loanCommonEventService.bankPrepayment(draw, rec);\n                    if (\"Y\".equals(rec.getRepaymentConfirm())) {\n                        draw.setDrawAmountRemain(draw.getDrawAmountRemain().subtract(rec.getRepayment()));\n                        draw.setRepayment(null);\n                        draw.setRepaymentDate(null);\n                        draw.setRepaymentConfirm(null);\n                    } else {\n                        draw.setRepayment(rec.getRepayment());\n                        draw.setRepaymentDate(rec.getRepaymentDate());\n                        draw.setRepaymentConfirm(rec.getRepaymentConfirm());\n                    }\n                    loanBankDrawService.saveBankDraw(draw);\n                }\n            }\n        });\n    }\n\n    @Override\n    public List<LoanCommonReqList> getDatasByCondition(LoanCommonReqQueryCon condition) {\n        List<LoanCommonReqList> list = loanCommonReqMyDao.queryByCondition(condition);\n        fndFlexValueApi.translate(list, \"processType\", BizConstants.FndFlexSet.TMS_DEAL_TYPE);\n        UICTransInfoUtils uicUtils = UICTransInfoUtils.getInstance();\n        list.forEach(record -> {\n            Map<String, String> trxTypeCodeAndNamePairs = transactionTypeService.getCodeAndNamePairs\n                    (record.getProcessType());\n            record.setProductTypeName(trxTypeCodeAndNamePairs.get(record.getProductType()));\n            UICUserInfoDto realUser = uicUtils.getUserByUserName(record.getReqBy());\n            record.setReqByName(realUser.getName());\n        });\n        return list;\n    }\n\n}\n",
