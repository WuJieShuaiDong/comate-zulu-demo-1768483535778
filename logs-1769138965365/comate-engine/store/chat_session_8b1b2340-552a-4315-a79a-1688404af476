re.j2ee.action.JsonResult.okJsonResultWithData;\nimport static com.baidu.p2p.core.j2ee.action.JsonResult.okJsonResultWithMsg;\n\n@RestController\n@RequestMapping(\"/loan/bankReq\")\npublic class LoanBankReqController extends BaseController {\n\n    @Autowired\n    LoanBankReqService loanBankReqService;\n    @Autowired\n    private LoanSelectInitComponent loanSelectInitComponent;\n\n    /**\n     * loanReqSuggest\n     *\n     * @param condition\n     *\n     * @return\n     */\n    @RequestMapping(\"/reqNumSuggest\")\n    public JsonResult<?> loanReqSuggest(@RequestBody LoanCommonReqQueryCon condition) {\n        List<LoanCommonReqSuggest> list = loanBankReqService.reqNumSuggest(condition);\n        return okJsonResultWithData(list);\n    }\n\n    /**\n     * 查询list\n     *\n     * @param condition\n     *\n     * @return\n     */\n    @RequestMapping(\"/list\")\n    public JsonResult<?> list(@RequestBody LoanCommonReqQueryCon condition) {\n        PageInfo<LoanCommonReqList> pageInfo = loanBankReqService.findByCondition(condition);\n        return okJsonResultWithData(pageInfo);\n    }\n\n    @RequestMapping(\"/initLoanBankReq\")\n    public JsonResult<?> initLoanBankReq() {\n        return okJsonResultWithData(loanBankReqService.initLoanBankReq());\n    }\n\n    @RequestMapping(\"/save\")\n    public JsonResult<?> saveHead(@RequestBody LoanBankReqHead detail) {\n        try {\n            LoanBankReqHead result = loanBankReqService.saveHead(detail);\n            return okJsonResultWithData(result);\n        } catch (Exception e) {\n            logger.error(\"保存失败，失败原因：\", e);\n            return failJsonResult(e.getMessage());\n        }\n    }\n\n    @RequestMapping(\"/saveBank\")\n    public JsonResult<?> saveBank(@RequestBody LoanBankListDetail detail) {\n        try {\n            LoanBankListDetail result = loanBankReqService.saveBankList(detail);\n            return okJsonResultWithData(result);\n        } catch (Exception e) {\n            logger.error(\"保存