  @RequestMapping(\"/bankDrawList\")\n    public JsonResult<?> bankDrawList(@RequestBody @Validated LoanReqFind find, BindingResult result) {\n        if (result.hasErrors()) {\n            return failJsonResultWithData(result.getAllErrors());\n        }\n        LoanCommonReqQueryCon condition = new LoanCommonReqQueryCon();\n        condition.setReqId(find.getId());\n        List<LoanBankDrawList> list = loanBankReqService.bankDrawList(condition);\n        return okJsonResultWithData(list);\n    }\n\n    @RequestMapping(\"/terminatIrs\")\n    public JsonResult<?> terminatIrs(@RequestBody LoanBankIrsDetail irsDetail) {\n        try {\n            loanBankReqService.terminatIrs(irsDetail);\n        } catch (Exception e) {\n            logger.error(\"irs终止失败，失败原因：\", e);\n            return failJsonResult(e.getMessage());\n        }\n        return okJsonResult();\n    }\n\n    @RequestMapping(\"/bankPrepayment\")\n    public JsonResult<?> bankPrepayment(@RequestBody List<LoanBankDrawList> prepaymentList) {\n        try {\n            loanBankReqService.bankPrepayment(prepaymentList);\n        } catch (Exception e) {\n            logger.error(\"保存失败，失败原因：\", e);\n            return failJsonResult(e.getMessage());\n        }\n        return okJsonResult();\n    }\n\n    /**\n     * @Author:v_miaopeixin\n     * @Description:融资贷款管理导出Excel功能\n     * @return:JsonResult\n     * @Date: 2018/4/26 13:53\n     */\n    @RequestMapping(\"/loanExportToExcel\")\n    @ExportRepeatCheckLock\n    public void exportExcelData(LoanCommonReqQueryCon condition, HttpServletRequest request,\n                                         HttpServletResponse response, BindingResult result) {\n        if (result.hasErrors()) {\n            throw new WebException(\"参数验证失败\");\n        }\n        try {\n            List<LoanCommonReqList> details = loanBankReqService.getDatasByCondition(condition);\n            //转换日期格式为yyyy-MM-dd\n            details.forEach(\n                    detail -> {\n                        if (detail.getReqDate() != null) {\n                            detail.setReqDateStr(DateUtils.formatDate(detail.getReqDate(), \"yyyy-MM-dd\"));\n                        }\n                    }\n            );\n            String templateName = CommonEnums.ExcelTemplateName.TMS_LOAN_FINACIAL_MANAGE.getValue();\n            InputStream is = ExcelKit.createExcelWithTemp(details, templateName);\n            String fileName = \"融资贷款管理\" + DateUtils.getDate(\"yyyyMMddHHmmss\") + \".xlsx\";\n            ResponseStream.out(is, fileName, ResponseStream.ContentType.EXCEL, request, response);\n        } catch (Exception e) {\n            throw new WebException(\"导出异常\");\n        }\n    }\n}\n",
