      "content": "/**\n * 项目名：tms-web\n * 包名：com.baidu.tms.balance\n * 文件名：BalnaceController.java\n * 版本信息：@version 1.0\n * 日期：2017年4月17日-下午5:46:45\n * 作者：liumeng09\n */\npackage com.baidu.tms.account.controller;\n\nimport com.baidu.ce.config.ExportRepeatCheckLock;\nimport com.baidu.p2p.commons.constants.BizConstants.FndFlexSet;\nimport com.baidu.p2p.commons.constants.CommonEnums;\nimport com.baidu.p2p.core.j2ee.action.JsonResult;\nimport com.baidu.p2p.core.j2ee.action.ResponseStream;\nimport com.baidu.p2p.core.j2ee.exception.WebException;\nimport com.baidu.p2p.core.j2ee.web.BaseController;\nimport com.baidu.p2p.core.poi.excel.utils.ExcelKit;\nimport com.baidu.p2p.core.utils.DateUtils;\nimport com.baidu.p2p.core.utils.StringUtils;\nimport com.baidu.p2p.core.utils.UtilType;\nimport com.baidu.p2p.fnd.api.FndFlexValueApi;\nimport com.baidu.p2p.fnd.facade.dto.FndFlexValueDTO;\nimport com.baidu.p2p.system.dto.PageParams;\nimport com.baidu.tms.account.domain.AccountBalance;\nimport com.baidu.tms.account.domain.report.AccountBalanceReportDaily;\nimport com.baidu.tms.account.domain.statistic.AccountBalanceStatisticReturn;\nimport com.baidu.tms.account.domain.statistic.QueryParam;\nimport com.baidu.tms.account.service.AccountBalanceReportService;\nimport com.baidu.tms.account.service.AccountBalanceService;\nimport com.baidu.tms.account.util.AccountConstans;\nimport com.baidu.tms.cmb.service.TmsAccountBalanceCmbService;\nimport com.github.pagehelper.PageInfo;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Controller;\nimport org.springframework.util.ResourceUtils;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.RequestParam;\nimport org.springframework.web.bind.annotation.ResponseBody;\nimport org.springframework.web.multipart.commons.CommonsMultipartFile;\n\nimport javax.servlet.http.HttpServletRequest;\nimport javax.servlet.http.HttpServletResponse;\nimport java.io.FileInputStream;\nimport java.io.IOException;\nimport java.io.InputStream;\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\n/**\n * 类描述：账户余额查询的controller\n * 创建人：liumeng09\n * 创建时间：2017年4月17日 下午5:46:45\n * 修改备注：\n */\n\n@Controller\n@RequestMapping(\"accountbalance\")\npublic class AccountBalnaceController extends BaseController {\n    @Autowired\n    private FndFlexValueApi fndFlexValueApi;\n\n    @Autowired\n    private AccountBalanceService accountBalanceService;\n\n    @Autowired\n    private TmsAccountBalanceCmbService tmsAccountBalanceCmbService;\n\n    @Autowired\n    private AccountBalanceReportService accountBalanceReportService;\n\n    /**\n     * 账户余额查询\n     *\n     * @param accountBalance\n     * @return\n     */\n    @ResponseBody\n    @RequestMapping(\"selectbalance\")\n    public JsonResult<?> selectBalance(@RequestBody(required = false) AccountBalance accountBalance) {\n        PageInfo<AccountBalance> pageInfo = new PageInfo<AccountBalance>();\n        // 页面查询用字典\n        HashMap<String, Object> dic = new HashMap<>();\n        // 账户类型\n        List<FndFlexValueDTO> typeDTO = fndFlexValueApi.selectByTypeAll(FndFlexSet.TMS_ACCT_TYPE);\n        dic.put(FndFlexSet.TMS_ACCT_TYPE, typeDTO);\n        // 初始化分页条件\n        PageParams params = new PageParams();\n        params.setPage(accountBalance.getPage() == 0 ? 1 : accountBalance.getPage());\n        params.setPageSize(accountBalance.getPageSize() == 0 ? 10 : accountBalance.getPageSize());\n\n        pageInfo = this.accountBalanceService.selectAccountBalance(accountBalance, params);\n        fndFlexValueApi.translate(pageInfo.getList(), \"finAccount\", FndFlexSet.BD_ACCOUNT,\n                \"companyCode\",\n                FndFlexSet.BD_COMPANY, \"currency\", FndFlexSet.CURRENCY, \"bank\", FndFlexSet.BANK, \"type\",\n                FndFlexSet.TMS_ACCT_TYPE);\n\n        Map<String, Object> map = UtilType.toMap(pageInfo);\n        map.put(\"dic\", dic);\n\n        // 封装返回结果\n        return JsonResult.okJsonResultWithData(map);\n    }\n\n    /**\n     * 账户余额查询页统计接口\n     *\n     * @param accountBalance\n     * @return\n     */\n    @ResponseBody\n    @RequestMapping(\"/selectBalanceCount\")\n    public JsonResult<?> selectBalanceCount(@RequestBody(required = false) AccountBalance accountBalance) {\n\n        return JsonResult.okJsonResultWithData(accountBalanceService.selectAccountBalanceCount(accountBalance));\n    }\n\n    /**\n     * 账户余额导出\n     *\n     * @param accountBalance 账户余额对象\n     * @param request        请求\n     * @param response       响应\n     */\n    @RequestMapping(\"exportbalance\")\n    @ExportRepeatCheckLock\n    public void exportSet(AccountBalance accountBalance, HttpServletRequest request, HttpServletResponse response) {\n        if (accountBalance == null) {\n            accountBalance = new AccountBalance();\n        }\n\n        PageInfo<AccountBalance> pageInfo = this.accountBalanceService.selectAccountBalance(accountBalance, null);\n\n        fndFlexValueApi.translate(pageInfo.getList(), \"finAccount\", FndFlexSet.BD_ACCOUNT, \"companyCode\",\n                FndFlexSet.BD_COMPANY, \"currency\", FndFlexSet.CURRENCY, \"bank\", FndFlexSet.BANK, \"type\",\n                FndFlexSet.TMS_ACCT_TYPE, \"province\", FndFlexSet.PROVINCE, \"city\", FndFlexSet.CITY,\n                \"origUsage\", FndFlexSet.TMS_ACCT_USAGE, \"state\", FndFlexSet.TMS_ACC_STATUS, \"category\",\n                FndFlexSet.TMS_FIN_TM_BA_CATEGORY);\n\n        // 导出  TMS_ACCOUNT_THIRDPART_BALANCE_EXPORT\n\n\n        String templateName = CommonEnums.ExcelTemplateName.TMS_ACCOUNT_BALANCE_EXPORT.getValue();\n        if (StringUtils.equals(accountBalance.getType(), AccountConstans.TMS_ACCT_TYPE_THIRDPART)) {\n            templateName = CommonEnums.ExcelTemplateName.TMS_ACCOUNT_THIRDPART_BALANCE_EXPORT.getValue();\n        }\n        // 加一个exportExcelFlag 选择导出模版 add liugang07\n        if (accountBalance.getExportExcelFlag().equals(\"currentBalanceExport\")) {\n            // 活期余额模版导出\n            templateName = CommonEnums.ExcelTemplateName.TMS_ACCOUNT_CURRENT_BALANCE_EXPORT.getValue();\n        }\n\n        InputStream is = ExcelKit.createExcelWithTemp(pageInfo.getList(),\n                templateName);\n        try {\n            ResponseStream\n                    .out(is, \"账户余额\" + DateUtils.getDate(\"yyyyMMddHHmmss\") + \".xlsx\", ResponseStream.ContentType.EXCEL,\n                            request, response);\n        } catch (Exception e) {\n            throw new WebException(\"导出异常\");\n        }\n    }\n\n    /**\n     * 导入花旗余额\n     * hujianfeng20170524\n     *\n     * @return 错误信息\n     */\n    @RequestMapping(path = \"/importAccountBalanceCiti\", name = \"导入花旗余额\")\n    @ResponseBody\n    public JsonResult importAccountBalanceCiti() {\n        Map errorMap = null;\n        try {\n            errorMap = tmsAccountBalanceCmbService.importFromCiti();\n            // 同时，复制昨日账单余额\n            tmsAccountBalanceCmbService.invokeCopyYesterDayCitiBal();\n            if (errorMap == null || (errorMap != null && ((ArrayList) errorMap.get(\"detail\")).size() == 0)) {\n                // 如果没错误，则不发邮件\n                return JsonResult.okJsonResult();\n            }\n        } catch (Exception e) {\n            errorMap = new HashMap();\n            errorMap.put(\"summary\", e.getMessage());\n            // errorMap.put(\"detail\", e.getStackTrace()[0]);\n            e.printStackTrace();\n        }\n        // 如果有错误消息，则返回错误消息。\n        tmsAccountBalanceCmbService.sendEmail(errorMap);\n        logger.info(\"\\t导入花旗余额错误，发送邮件>>\" + JsonResult.failJsonResultWithData(errorMap).toJSONString());\n        return JsonResult.failJsonResultWithData(errorMap);\n    }\n\n    /**\n     * 导入花旗余额\n     * hujianfeng20170524\n     *\n     * @return 错误信息\n     */\n    @RequestMapping(path = \"/copyYesterDayCitiBal\", name = \"复制昨日花旗余额\")\n    @ResponseBody\n    public JsonResult copyYesterDayCitiBal() {\n        Map copyMap = null;\n        try {\n            copyMap = tmsAccountBalanceCmbService.copyYesterDayCitiBal();\n            if (copyMap == null || (copyMap != null && ((ArrayList) copyMap.get(\"detail\")).size() == 0)) {\n                return JsonResult.okJsonResult();\n            }\n        } catch (Exception e) {\n            copyMap = new HashMap();\n            copyMap.put(\"summary\", e.getMessage());\n            e.printStackTrace();\n        }\n        // 如果有错误消息，则返回错误消息。\n        tmsAccountBalanceCmbService.sendEmail(copyMap);\n        logger.info(\"\\t复制花旗余额错误，发送邮件>>\" + JsonResult.failJsonResultWithData(copyMap).toJSONString());\n        return JsonResult.failJsonResultWithData(copyMap);\n    }\n\n    /**\n     * 导入手工余额\n     * hujianfeng20170427\n     *\n     * @return\n     */\n    @RequestMapping(path = \"/importAccountBalance\", name = \"导入手工余额\")\n    @ResponseBody\n    public JsonResult importAccountBalance(@RequestParam(\"file\") CommonsMultipartFile file) {\n        logger.info(\"导入手工余额开始\");\n        //        String errorMsg = tmsAccountBalanceCmbService.importAccountBalance(file);\n        //        if(errorMsg==null || \"\".equals(errorMsg)) {\n        //            return JsonResult.okJsonResult();\n        //        }\n        //         如果有错误消息，则返回错误消息。\n        //        return JsonResult.failJsonResult(errorMsg);\n        Map<String, Object> errorMap = new HashMap();\n        try {\n            errorMap = tmsAccountBalanceCmbService.importAccountBalance(file);\n\n            if (((ArrayList) errorMap.get(\"detail\")).size() == 0) {\n                return JsonResult.okJsonResult();\n            }\n            // 如果有错误消息，则返回错误消息。\n            return JsonResult.failJsonResultWithData(errorMap);\n        } catch (NullPointerException e) {\n            //            e.printStackTrace();\n            errorMap.put(\"summary\", \"文件数据异常，请检查后重新导入。\");\n            errorMap.put(\"detail\", e.getStackTrace()[0]);\n            e.printStackTrace();\n            return JsonResult.failJsonResultWithData(errorMap);\n        } catch (Exception e) {\n            errorMap.put(\"summary\", \"此文件为异常文件，请检查后重新导入。\");\n            errorMap.put(\"detail\", e.getStackTrace()[0]);\n            e.printStackTrace();\n            // errorMap.put(\"detail\", e.getStackTrace());\n            return JsonResult.failJsonResultWithData(errorMap);\n        }\n    }\n\n    /**\n     * 导入手工余额 模板文件下载\n     * http://localhost:8080/accountbalance/downAccountBalanceTemp\n     * hujianfeng20170427\n     */\n    @ResponseBody\n    @RequestMapping(path = \"/downAccountBalanceTemp\", name = \"手工余额模板下载\")\n    public void downAccountBalanceTemp(HttpServletRequest request, HttpServletResponse response) throws IOException {\n        ResponseStream.out(new FileInputStream(ResourceUtils.getFile(\"classpath:doc/TMS_ACCOUNT_BALANCE.xlsx\")),\n                \"手工余额导入模板.xlsx\",\n                ResponseStream.ContentType.EXCEL,\n                request, response);\n\n    }\n\n\n    /***************************************余额总览 开始******************************************/\n\n    /**\n     * 获取余额概览 按公司分类\n     *\n     * @return 余额对象\n     */\n    @ResponseBody\n    @RequestMapping(\"getBalanceOverviewByCompany23\")\n    public JsonResult<?> getBalanceOverviewByCompany23(@RequestBody QueryParam qm) {\n        AccountBalanceStatisticReturn abr = this.accountBalanceService.getBalanceOverviewByCompany23(qm);\n        return JsonResult.okJsonResultWithData(abr);\n    }\n\n    /**\n     * 获取余额概览 按银行分类\n     *\n     * @return 余额对象\n     */\n    @ResponseBody\n    @RequestMapping(\"getBalanceOverviewByBank\")\n    public JsonResult<?> getBalanceOverviewByBank(@RequestBody QueryParam qm) {\n        AccountBalanceStatisticReturn abr = this.accountBalanceService.getBalanceOverviewByBank(qm);\n        return JsonResult.okJsonResultWithData(abr);\n    }\n\n\n    /**\n     * 活期、第三方 按照公司进行划分的余额\n     *\n     * @return 余额对象\n     */\n    @ResponseBody\n    @RequestMapping(\"getCompanyBalanceStatistic\")\n    public JsonResult<?> getCompanyBalanceStatistic(@RequestBody QueryParam qm) {\n        AccountBalanceStatisticReturn abr = this.accountBalanceService.getBalanceThirdOrCurrentByCompany(qm);\n        return JsonResult.okJsonResultWithData(abr);\n\n    }\n\n    /**\n     * 获取公司三级的余额信息\n     *\n     * @return 余额对象\n     */\n    @ResponseBody\n    @RequestMapping(\"getCompany3BalanceStatistic\")\n    public JsonResult<?> getCompany3BalanceStatistic(@RequestBody QueryParam qm) {\n        AccountBalanceStatisticReturn abr = this.accountBalanceService.getCompany3BalanceStatistic(qm);\n        return JsonResult.okJsonResultWithData(abr);\n    }\n\n\n    /**\n     * 获取活期余额 按银行分类\n     *\n     * @return 余额对象\n     */\n    @ResponseBody\n    @RequestMapping(\"getCurrentByBankCategory\")\n    public JsonResult<?> getCurrentByBankCategory(@RequestBody QueryParam qm) {\n        AccountBalanceStatisticReturn abr = this.accountBalanceService.getCurrentByBankCategory(qm);\n        return JsonResult.okJsonResultWithData(abr);\n    }\n\n\n    /**\n     * 获取第三方 按银行 的余额信息\n     *\n     * @return 余额对象\n     */\n    @ResponseBody\n    @RequestMapping(\"getBankThirdPartBalance\")\n    public JsonResult<?> getBankThirdPartBalance(@RequestBody QueryParam qm) {\n        AccountBalanceStatisticReturn abr = this.accountBalanceService.getBalanceThirdByThird(qm);\n        return JsonResult.okJsonResultWithData(abr);\n    }\n\n    /**\n     * 获取余额概览 按公司分类\n     *\n     * @return 余额对象\n     */\n    @ResponseBody\n    @RequestMapping(\"getBalanceOverviewByCompany\")\n    public JsonResult<?> getBalanceOverviewByCompany(@RequestBody QueryParam qm) {\n        AccountBalanceStatisticReturn abr = this.accountBalanceService.getBalanceOverviewByCompany(qm);\n        return JsonResult.okJsonResultWithData(abr);\n    }\n\n    /**\n     * 导出 账户余额概览 按公司\n     *\n     * @param qm       账户余额对象\n     * @param request  请求\n     * @param response 响应\n     */\n    @RequestMapping(\"exportBalanceStatistic\")\n    public void exportBalanceOverviewByCompany(QueryParam qm, HttpServletRequest request,\n                                               HttpServletResponse response) {\n        if (StringUtils.equals(qm.getType(), \"overviewByCompany\")) {\n            InputStream is = this.accountBalanceService.exBalanceOverviewByCompany(qm);\n            try {\n                ResponseStream.out(is, \"余额总览-公司-余额日期\" + DateUtils.formatDate(qm.getBalanceDate(), \"yyyyMMdd\") + \"_\"\n                                + DateUtils.getDate(\"yyyyMMddHHmmss\") + \".xlsx\", ResponseStream.ContentType.EXCEL,\n                        request, response);\n            } catch (IOException e) {\n                logger.error(\"余额总览-公司-发生异常 _余额日期 \" + qm.getBalanceDate(), e);\n            }\n        } else if (StringUtils.equals(qm.getType(), \"overviewByBank\")) {\n            InputStream is = this.accountBalanceService.exBalanceOverviewByBank(qm);\n            try {\n                ResponseStream.out(is, \"余额总览-银行-余额日期\" + DateUtils.formatDate(qm.getBalanceDate(), \"yyyyMMdd\") + \"_\"\n                                + DateUtils.getDate(\"yyyyMMddHHmmss\") + \".xlsx\", ResponseStream.ContentType.EXCEL,\n                        request, response);\n            } catch (IOException e) {\n                logger.error(\"余额总览-银行-发生异常 _余额日期 \" + qm.getBalanceDate(), e);\n            }\n        } else if (StringUtils.equals(qm.getType(), \"overviewByCategory\")) {\n            List<AccountBalanceStatisticReturn> returnList =\n                    this.accountBalanceService.exportBalanceOverviewByCategory(qm);\n            InputStream is = ExcelKit.createExcelWithTemp(returnList,\n                    CommonEnums.ExcelTemplateName.TMS_ACCOUNT_BALANCE_STASTIC_OVERVIEW_BY_CATEGORY.getValue());\n            try {\n                ResponseStream.out(is, \"余额总览-资金种类_余额日期\" + DateUtils.formatDate(qm.getBalanceDate(), \"yyyyMMdd\") + \"_\"\n                                + DateUtils.getDate(\"yyyyMMddHHmmss\") + \".xlsx\", ResponseStream.ContentType.EXCEL,\n                        request, response);\n            } catch (IOException e) {\n                logger.error(\"余额总览-资金种类导出发生异常 _余额日期 \" + qm.getBalanceDate(), e);\n            }\n        } else if (StringUtils.equals(qm.getType(), \"currentByCompany\")) {\n            qm.setType(AccountConstans.TMS_ACCT_TYPE_BANK);\n            InputStream is = accountBalanceService.exBalanceCurrentByCompany(qm);\n            try {\n                ResponseStream.out(is, \"活期余额-公司主体-余额日期\" + DateUtils.formatDate(qm.getBalanceDate(), \"yyyyMMdd\") + \"_\"\n                                + DateUtils.getDate(\"yyyyMMddHHmmss\") + \".xlsx\", ResponseStream.ContentType.EXCEL,\n                        request, response);\n            } catch (IOException e) {\n                logger.error(\"活期按公司导出发生异常 _余额日期 \" + qm.getBalanceDate(), e);\n            }\n        } else if (StringUtils.equals(qm.getType(), \"currentByBank\")) {\n            qm.setType(AccountConstans.TMS_ACCT_TYPE_THIRDPART);\n            InputStream is = this.accountBalanceService.exBalanceCurrentByBank(qm);\n            ;\n            try {\n                ResponseStream.out(is, \"活期余额-银行-余额日期\" + DateUtils.formatDate(qm.getBalanceDate(), \"yyyyMMdd\") + \"_\"\n                                + DateUtils.getDate(\"yyyyMMddHHmmss\") + \".xlsx\", ResponseStream.ContentType.EXCEL,\n                        request, response);\n            } catch (IOException e) {\n                logger.error(\"活期按银行导出发生异常 _余额日期 \" + qm.getBalanceDate(), e);\n            }\n        } else if (StringUtils.equals(qm.getType(), \"thirdpartByCompany\")) {\n            qm.setType(AccountConstans.TMS_ACCT_TYPE_THIRDPART);\n            InputStream is = accountBalanceService.exBalanceThirdByCompany(qm);\n            try {\n                ResponseStream.out(is, \"第三方-公司主体-余额日期\" + DateUtils.formatDate(qm.getBalanceDate(), \"yyyyMMdd\") + \"_\"\n                                + DateUtils.getDate(\"yyyyMMddHHmmss\") + \".xlsx\", ResponseStream.ContentType.EXCEL,\n                        request, response);\n            } catch (IOException e) {\n                logger.error(\"第三方按公司导出发生异常 _余额日期 \" + qm.getBalanceDate(), e);\n            }\n        } else if (StringUtils.equals(qm.getType(), \"thirdpartByThirdpart\")) {\n            qm.setType(AccountConstans.TMS_ACCT_TYPE_THIRDPART);\n            InputStream is = this.accountBalanceService.exBalanceThirdByBank(qm);\n            try {\n                ResponseStream.out(is, \"第三方-银行-余额日期\" + DateUtils.formatDate(qm.getBalanceDate(), \"yyyyMMdd\") + \"_\"\n                                + DateUtils.getDate(\"yyyyMMddHHmmss\") + \".xlsx\", ResponseStream.ContentType.EXCEL,\n                        request, response);\n            } catch (IOException e) {\n                logger.error(\"第三方-银行导出发生异常 _余额日期 \" + qm.getBalanceDate(), e);\n            }\n        }\n    }\n\n    /**\n     * 刷新余额缓存数据\n     *\n     * @return 余额对象\n     */\n    @ResponseBody\n    @RequestMapping(\"refreshAccountBalanceStatistic\")\n    public JsonResult<?> refreshAccountBalanceStatistic(@RequestBody QueryParam qm) {\n        this.accountBalanceService.refreshAccountBalanceStatistic(qm);\n        return JsonResult.okJsonResult();\n    }\n\n    /***************************************余额总览 结束******************************************/\n\n\n    /***************************************资金报告 开始******************************************/\n    /**\n     * 获取日报\n     *\n     * @return 余额对象\n     */\n    @ResponseBody\n    @RequestMapping(\"getBalanceDailyReport\")\n    public JsonResult<?> getBalanceDailyReport(@RequestBody QueryParam qm) {\n        List<AccountBalanceReportDaily> rl = accountBalanceReportService.getDailyReport(qm);\n        return JsonResult.okJsonResultWithData(rl);\n    }\n\n    /**\n     * 获取日报\n     *\n     * @return 余额对象\n     */\n    @RequestMapping(\"exportReport\")\n    public void exportReport(QueryParam qm, HttpServletRequest request,\n                             HttpServletResponse response) {\n        if (StringUtils.equals(qm.getType(), \"daily\")) {\n            InputStream is = accountBalanceReportService.exDailyReport(qm);\n            try {\n                ResponseStream.out(is, \"资金报告-日报-余额日期\" + DateUtils.formatDate(qm.getBalanceDate(), \"yyyyMMdd\") + \"_\"\n                                + DateUtils.getDate(\"yyyyMMddHHmmss\") + \".xlsx\", ResponseStream.ContentType.EXCEL,\n                        request, response);\n            } catch (IOException e) {\n                logger.error(\"资金报告-日报导出发生异常_日期 \" + qm.getBalanceDate(), e);\n            }\n        }\n    }\n    /***************************************资金报告 结束******************************************/\n}\n",
