                "originalContent": "package com.baidu.pmc.web.service.financing.impl;\n\nimport com.baidu.pmc.common.ResponseMessage;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.pojo.qo.PmcFinanceBankBaseQO;\nimport com.baidu.pmc.web.clients.PmcSupplierAdmClient;\nimport com.baidu.pmc.web.clients.cmb.CmbFinancingClient;\nimport com.baidu.pmc.web.clients.cmbc.CmbcFinancingClient;\nimport com.baidu.pmc.web.service.financing.PmcFinancingBankService;\nimport com.baidu.pmc.web.service.payebankfile.PayBankConstants;\nimport lombok.extern.slf4j.Slf4j;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\nimport org.springframework.web.multipart.MultipartFile;\n\nimport java.util.HashMap;\nimport java.util.Map;\n\n@Slf4j\n@Service\npublic class PmcFinancingBankServiceImpl implements PmcFinancingBankService {\n\n    @Autowired\n    private CmbFinancingClient cmbClient;\n\n    @Autowired\n    private CmbcFinancingClient cmbcClient;\n\n    @Autowired\n    private PmcSupplierAdmClient pmcSupplierAdmClient;\n\n\n    @Override\n    public ResponseMessage calculateFinancing(PmcFinanceBankBaseQO query) {\n        // 1. 参数校验\n        if (query == null || query.getBankCode() == null) {\n            return ResponseMessage.fail(\"参数错误：银行编码不能为空\");\n        }\n\n        // 2 通用业务校验\n        pmcSupplierAdmClient.commonCheckData(query, \"calculateFinancing\");\n\n        // 2. 调用银行接口进行测算\n        if (PayBankConstants.CMB_BANK_CODE.equals(query.getBankCode())) {\n            return cmbClient.financingCalculate(query);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(query.getBankCode())) {\n            return cmbcClient.financingCalculate(query);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n\n    @Override\n    public ResponseMessage submitFinancingApply(PmcFinanceBankBaseQO applyDTO) {\n        // 1. 参数校验\n        if (applyDTO == null || appl