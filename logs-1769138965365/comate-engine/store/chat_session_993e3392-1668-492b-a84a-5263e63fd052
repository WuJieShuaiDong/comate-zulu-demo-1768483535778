@Override\n    public ResponseMessage submitFinancingApplyByDetail(Map<String, Object> detail) {\n        final String methodName = \"submitFinancingApplyByDetail\";\n        PmcFinanceBankBaseQO assembledRequest = null;\n        try {\n            // 1. 记录请求开始\n            log.info(\"[{}] 开始处理融资申请，detail参数keys: {}\", methodName, detail.keySet());\n\n            // 2. 参数组装\n            assembledRequest = assembleFinancingRequest(detail);\n            if (assembledRequest == null) {\n                throw new IllegalArgumentException(\"参数组装失败\");\n            }\n            log.info(\"[{}] 参数组装完成，申请单号：{}，银行编码：{}，供应商：{}，融资金额：{}\",\n                methodName, assembledRequest.getApplyNumber(),\n                assembledRequest.getBankCode(), assembledRequest.getSupplierName(),\n                assembledRequest.getFinanceAmount());\n\n            // 3. 参数校验\n            if (StringUtils.isBlank(assembledRequest.getBankCode())) {\n                log.error(\"[{}] 银行编码为空，申请单号：{}\", methodName, assembledRequest.getApplyNumber());\n                throw new IllegalArgumentException(\"银行编码不能为空\");\n            }\n\n            // 4. 调用银行接口\n            log.info(\"[{}] 开始调用银行接口，申请单号：{}，融资金额：{}，币种：{}，计划付款日期：{}\",\n                methodName, assembledRequest.getApplyNumber(),\n                assembledRequest.getFinanceAmount(), assembledRequest.getCurrency(),\n                assembledRequest.getPayPlanDate());\n            long startTime = System.currentTimeMillis();\n            ResponseMessage responseMessage = submitFinancingApply(assembledRequest);\n            log.info(\"[{}] 银行接口调用完成，耗时：{}ms，申请单号：{}，结果：{}，消息：{}\",\n                methodName, (System.currentTimeMillis() - startTime),\n                assembledRequest.getApplyNumber(), responseMessage.getStatus(),\n                responseMessage.getMessage());\n\n            // 5. 处理银行响应\n            if (ResponseMessage.FAIL.equals(responseMessage.getStatus())) {\n                log.warn(\"[{}] 银行接口调用失败，开始回滚，申请单号：{}，错误原因：{}\",\n                    methodName, assembledRequest.getApplyNumber(), responseMessage.getMessage());\n                try {\n                    rollbackLocalStatus(assembledRequest);\n                    return ResponseMessage.fail(\"银行处理失败：\" + responseMessage.getMessage())\n                        .addData(\"originalError\", responseMessage.getMessage())\n                        .addData(\"applyNumber\", assembledRequest.getApplyNumber());\n                } catch (Exception rollbackEx) {\n                    log.error(\"[{}] 回滚过程中发生异常，申请单号：{}\", methodName, assembledRequest.getApplyNumber(), rollbackEx);\n                    return ResponseMessage.fail(\"银行处理失败且回滚异常：\" + rollbackEx.getMessage())\n                        .addData(\"originalError\", responseMessage.getMessage())\n                        .addData(\"applyNumber\", assembledRequest.getApplyNumber());\n                }\n            }\n\n            // 6. 记录成功日志\n            log.info(\"[{}] 融资申请处理成功，申请单号：{}\", methodName, assembledRequest.getApplyNumber());\n            return responseMessage.addData(\"applyNumber\", assembledRequest.getApplyNumber());\n\n        } catch (IllegalArgumentException e) {\n            log.error(\"[{}] 参数校验异常，申请单号：{}\",\n                methodName, assembledRequest != null ? assembledRequest.getApplyNumber() : \"未知\", e);\n            if (assembledRequest != null) {\n                try {\n                    rollbackLocalStatus(assembledRequest);\n                } catch (Exception rollbackEx) {\n                    log.error(\"[{}] 参数异常回滚失败，申请单号：{}\",\n                        methodName, assembledRequest.getApplyNumber(), rollbackEx);\n                }\n            }\n            return ResponseMessage.fail(\"参数错误：\" + e.getMessage())\n                .addData(\"applyNumber\", assembledRequest != null ? assembledRequest.getApplyNumber() : \"未知\");\n\n        } catch (Exception e) {\n            log.error(\"[{}] 系统处理异常，申请单号：{}\",\n                methodName, assembledRequest != null ? assembledRequest.getApplyNumber() : \"未知\", e);\n            if (assembledRequest != null) {\n                try {\n                    rollbackLocalStatus(assembledRequest);\n                } catch (Exception rollbackEx) {\n                    log.error(\"[{}] 系统异常回滚失败，申请单号：{}\",\n                        methodName, assembledRequest.getApplyNumber(), rollbackEx);\n                }\n            }\n            return ResponseMessage.fail(\"系统处理异常：\" + e.getMessage())\n                .addData(\"exceptionType\", e.getClass().getSimpleName())\n                .addData(\"applyNumber\", assembledRequest != null ? assembledRequest.getApplyNumber() : \"未知\");\n        }\n    }\n\n    @Override\n    public ResponseMessage queryFinancingResult(PmcFinanceBankBaseQO query) {\n        // 1. 参数校验\n        if (query == null || query.getBankCode() == null) {\n            return ResponseMessage.fail(\"参数错误：银行编码不能为空\");\n        }\n\n        // 2 通用业务校验\n        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(query, \"queryFinancingResult\");\n        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n            return checkResult;\n        }\n\n        // 3. 查询融资结果\n        if (PayBankConstants.CMB_BANK_CODE.equals(query.getBankCode())) {\n            return cmbClient.queryFinancingResult(query);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(query.getBankCode())) {\n            return cmbcClient.queryFinancingResult(query);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n\n    @Override\n    public ResponseMessage queryFinancingQuota(PmcFinanceBankBaseQO query) {\n        // 1. 参数校验\n        if (query == null || query.getSupplierCode() == null || query.getBankCode() == null) {\n            return ResponseMessage.fail(\"参数错误：银行编码或者供应商编码不能为空\");\n        }\n\n        // 2 通用业务校验\n        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(query, \"queryFinancingQuota\");\n        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n            return checkResult;\n        }\n\n        // 3. 查询额度信息\n        if (PayBankConstants.CMB_BANK_CODE.equals(query.getBankCode())) {\n            return  cmbClient.queryFinancingQuota(query);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(query.getBankCode())) {\n            return cmbcClient.queryFinancingQuota(query);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n\n    @Override\n    public ResponseMessage uploadFinancingAttachment(MultipartFile file, PmcFinanceBankBaseQO qo) {\n        // 1. 参数校验\n        if (file == null || file.isEmpty() || qo == null || StringUtils.isBlank(qo.getBankCode())) {\n            return ResponseMessage.fail(\"参数错误：文件或银行编码不能为空\");\n        }\n\n        // 2 通用业务校验\n        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(qo, \"uploadFinancingAttachment\");\n        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n            return checkResult;\n        }\n\n        // 3. 文件上传处理\n        if (PayBankConstants.CMB_BANK_CODE.equals(qo.getBankCode())) {\n            return cmbClient.uploadAttachment(file, qo);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(qo.getBankCode())) {\n            return cmbcClient.uploadAttachment(file, qo);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n\n    @Override\n    public ResponseMessage supplementFinancingAttachment(MultipartFile file, PmcFinanceBankBaseQO qo) {\n        // 1. 参数校验\n        if (file == null || file.isEmpty() || qo == null || StringUtils.isBlank(qo.getBankCode())) {\n            return ResponseMessage.fail(\"参数错误：文件或银行编码不能为空\");\n        }\n        // 2 通用业务校验\n        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(qo, \"supplementFinancingAttachment\");\n        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n            return checkResult;\n        }\n        // 3. 文件补充处理\n        if (PayBankConstants.CMB_BANK_CODE.equals(qo.getBankCode())) {\n            return cmbClient.supplementFinancingAttachment(file, qo);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(qo.getBankCode())) {\n            return cmbcClient.supplementFinancingAttachment(file, qo);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n\n\n    /**\n     * 组装银行融资申请参数\n     * @param detail 包含applyDTO和payChecksSupplierCodeDTO的Map\n     * @return 组装好的PmcFinanceBankBaseQO请求对象\n     * @throws IllegalArgumentException 当参数不完整或类型不匹配时抛出\n     */\n    private PmcFinanceBankBaseQO assembleFinancingRequest(Map<String, Object> detail) {\n        final String methodName = \"assembleFinancingRequest\";\n        try {\n            // 1. 参数校验\n            if (detail == null) {\n                throw new IllegalArgumentException(\"detail参数不能为null\");\n            }\n            if (detail.isEmpty()) {\n                throw new IllegalArgumentException(\"detail参数不能为空\");\n            }\n\n            log.debug(\"[{}] 开始验证输入参数keys: {}\", methodName, detail.keySet());\n\n            // 2. 获取并校验DTO对象\n            PmcFinanceSupplierApplyDTO applyDTO = getAndValidateDTO(detail, \"applyDTO\", PmcFinanceSupplierApplyDTO.class);\n            PmcPayChecksSupplierCodeDTO payChecksDTO = getAndValidateDTO(detail, \"payChecksSupplierCodeDTO\", PmcPayChecksSupplierCodeDTO.class);\n            PmcDataP2pSupplier supplier = getAndValidateDTO(detail, \"supplier\", PmcDataP2pSupplier.class);\n\n            // 3. 校验关键字段\n            validateRequiredFields(applyDTO, payChecksDTO, supplier);\n\n            log.info(\"[{}] 开始组装请求参数，申请单号：{}，供应商：{}\", \n                methodName, applyDTO.getApplyNumber(), applyDTO.getSupplierName());\n\n            // 4. 组装请求对象\n            PmcFinanceBankBaseQO request = new PmcFinanceBankBaseQO();\n            \n            // 4.1 基础信息组装\n            assembleBasicInfo(request, applyDTO, supplier);\n            log.debug(\"[{}] 基础信息组装完成\", methodName);\n            \n            // 4.2 金额信息组装\n            assembleAmountInfo(request, applyDTO, payChecksDTO);\n            log.debug(\"[{}] 金额信息组装完成，融资金额：{}\", \n                methodName, request.getFinanceAmount());\n            \n            // 4.3 发票信息组装\n            assembleInvoiceInfo(request, payChecksDTO);\n            log.debug(\"[{}] 发票信息组装完成，发票号：{}\", \n                methodName, request.getInvoiceNumber());\n\n            // 4.4 校验请求对象\n            validateRequestObject(request);\n\n            log.info(\"[{}] 参数组装完成，申请单号：{}，总金额：{}\", \n                methodName, request.getApplyNumber(), request.getFinanceAmount());\n            return request;\n\n        } catch (IllegalArgumentException e) {\n            log.error(\"[{}] 参数校验异常 - {}\", methodName, e.getMessage());\n            throw e;\n        } catch (Exception e) {\n            log.error(\"[{}] 参数组装异常 - {}\", methodName, e.getMessage(), e);\n            throw new RuntimeException(\"参数组装失败: \" + e.getMessage(), e);\n        }\n    }\n\n    /**\n     * 校验请求对象必填字段\n     */\n    private void validateRequestObject(PmcFinanceBankBaseQO request) {\n        if (StringUtils.isBlank(request.getApplyNumber())) {\n            throw new IllegalArgumentException(\"请求对象缺少applyNumber\");\n        }\n        if (StringUtils.isBlank(request.getBankCode())) {\n            throw new IllegalArgumentException(\"请求对象缺少bankCode\");\n        }\n        if (request.getFinanceAmount() == null || request.getFinanceAmount().compareTo(BigDecimal.ZERO) <= 0) {\n            throw new IllegalArgumentException(\"融资金额必须大于0\");\n        }\n        if (StringUtils.isBlank(request.getCurrency())) {\n            throw new IllegalArgumentException(\"请求对象缺少currency\");\n        }\n        if (request.getPayPlanDate() == null) {\n            throw new IllegalArgumentException(\"请求对象缺少payPlanDate\");\n        }\n    }\n\n    /**\n     * 校验请求对象必填字段\n     */\n    private void validateRequestObject(PmcFinanceBankBaseQO request) {\n        if (StringUtils.isBlank(request.getApplyNumber())) {\n            throw new IllegalArgumentException(\"请求对象缺少applyNumber\");\n        }\n        if (StringUtils.isBlank(request.getBankCode())) {\n            throw new IllegalArgumentException(\"请求对象缺少bankCode\");\n        }\n        if (request.getFinanceAmount() == null || request.getFinanceAmount().compareTo(BigDecimal.ZERO) <= 0) {\n            throw new IllegalArgumentException(\"融资金额必须大于0\");\n        }\n        if (StringUtils.isBlank(request.getCurrency())) {\n            throw new IllegalArgumentException(\"请求对象缺少currency\");\n        }\n    }\n\n    /**\n     * 从Map中获取并验证DTO对象\n     */\n    private <T> T getAndValidateDTO(Map<String, Object> detail, String key, Class<T> clazz) {\n        Object obj = detail.get(key);\n        if (obj == null) {\n            throw new IllegalArgumentException(\"缺少必要参数: \" + key);\n        }\n        try {\n            return clazz.cast(obj);\n        } catch (ClassCastException e) {\n            throw new IllegalArgumentException(key + \"参数类型不匹配，期望类型: \" + clazz.getSimpleName());\n        }\n    }\n\n    /**\n     * 校验必填字段\n     */\n    private void validateRequiredFields(PmcFinanceSupplierApplyDTO applyDTO,\n                                      PmcPayChecksSupplierCodeDTO payChecksDTO,\n                                      PmcDataP2pSupplier supplier) {\n        if (StringUtils.isBlank(applyDTO.getApplyNumber())) {\n            throw new IllegalArgumentException(\"applyDTO缺少applyNumber\");\n        }\n        if (StringUtils.isBlank(applyDTO.getBankCode())) {\n            throw new IllegalArgumentException(\"applyDTO缺少bankCode\");\n        }\n        if (StringUtils.isBlank(supplier.getRegistrationCode())) {\n            throw new IllegalArgumentException(\"supplier缺少registrationCode\");\n        }\n    }\n\n    /**\n     * 组装基础信息\n     */\n    private void assembleBasicInfo(PmcFinanceBankBaseQO request,\n                                 PmcFinanceSupplierApplyDTO applyDTO,\n                                 PmcDataP2pSupplier supplier) {\n        request.setApplyNumber(applyDTO.getApplyNumber());\n        request.setPayCheckNum(applyDTO.getPayCheckNum());\n        request.setSupplierCode(applyDTO.getSupplierCode());\n        request.setSupplierName(applyDTO.getSupplierName());\n        request.setBankCode(applyDTO.getBankCode());\n        request.setRegistrationCode(supplier.getRegistrationCode());\n        request.setPayPlanDate(applyDTO.getPatyPlanDate());\n    }\n\n    /**\n     * 组装金额信息\n     */\n    private void assembleAmountInfo(PmcFinanceBankBaseQO request,\n                                  PmcFinanceSupplierApplyDTO applyDTO,\n                                  PmcPayChecksSupplierCodeDTO payChecksDTO) {\n        request.setFinanceAmount(applyDTO.getFinanceAmount());\n        request.setSupplierAccount(payChecksDTO.getAccount());\n        request.setBankCode(payChecksDTO.getBankCode());\n        request.setSupplierAddress(payChecksDTO.getPayChecksAttribute4());\n        request.setInvoiceNumber(payChecksDTO.getSourceNum());\n        request.setDocumentAmount(payChecksDTO.getAmount());\n        request.setPayableAmount(request.getFinanceAmount());\n        request.setCurrency(applyDTO.getCurrency());\n        request.setBuyerAccount(payChecksDTO.getAccount());\n        request.setFinanceNumber(applyDTO.getPayCheckNum());\n    }\n\n    /**\n     * 组装发票信息\n     */\n    private void assembleInvoiceInfo(PmcFinanceBankBaseQO request,\n                                   PmcPayChecksSupplierCodeDTO payChecksDTO) {\n        request.setInvoiceType(payChecksDTO.getInvoiceType());\n        request.setInvoiceNumber(payChecksDTO.getInvoiceNumber());\n        request.setInvoiceCode(payChecksDTO.getInvoiceCode());\n        request.setInvoiceDate(payChecksDTO.getInvoiceDate());\n        request.setTaxExcludedAmount(payChecksDTO.getInvoiceAmount());\n        request.setDocumentAmount(payChecksDTO.getTotalAmount());\n    }\n}"
