bleBasicInfo(request, applyDTO, supplier);\n            log.debug(\"[{}] 基础信息组装完成\", methodName);\n            \n            // 4.2 金额信息组装\n            assembleAmountInfo(request, applyDTO, payChecksDTO);\n            log.debug(\"[{}] 金额信息组装完成，融资金额：{}\", \n                methodName, request.getFinanceAmount());\n            \n            // 4.3 发票信息组装\n            assembleInvoiceInfo(request, payChecksDTO);\n            log.debug(\"[{}] 发票信息组装完成，发票号：{}\", \n                methodName, request.getInvoiceNumber());\n\n            // 4.4 校验请求对象\n            validateRequestObject(request);\n\n            log.info(\"[{}] 参数组装完成，申请单号：{}，总金额：{}\", \n                methodName, request.getApplyNumber(), request.getFinanceAmount());\n            return request;\n\n        } catch (IllegalArgumentException e) {\n            log.error(\"[{}] 参数校验异常 - {}\", methodName, e.getMessage());\n            throw e;\n        } catch (Exception e) {\n            log.error(\"[{}] 参数组装异常 - {}\", methodName, e.getMessage(), e);\n            throw new RuntimeException(\"参数组装失败: \" + e.getMessage(), e);\n        }\n    }\n\n    /**\n     * 校验请求对象必填字段\n     */\n    private void validateRequestObject(PmcFinanceBankBaseQO request) {\n        if (StringUtils.isBlank(request.getApplyNumber())) {\n            throw new IllegalArgumentException(\"请求对象缺少applyNumber\");\n        }\n        if (StringUtils.isBlank(request.getBankCode())) {\n            throw new IllegalArgumentException(\"请求对象缺少bankCode\");\n        }\n        if (request.getFinanceAmount() == null || request.getFinanceAmount().compareTo(BigDecimal.ZERO) <= 0) {\n            throw new IllegalArgumentException(\"融资金额必须大于0\");\n        }\n        if (StringUtils.isBlank(request.getCurrency())) {\n            throw new IllegalArgumentException(\"请求对象缺少currency\");\n        }\n    }\n\n    /**\n     * 从Map中获取并验证DTO对象\n     */\n    private <T> T getAndValidateDTO(Map<String, Object> detail, String key, Class<T> clazz) {\n        Object obj