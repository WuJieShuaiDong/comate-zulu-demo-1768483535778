lient.financingCalculate(query);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n\n    @Override\n    public ResponseMessage submitFinancingApply(PmcFinanceBankBaseQO applyDTO) {\n        // 1. 参数校验\n        if (applyDTO == null || applyDTO.getBankCode() == null) {\n            return ResponseMessage.fail(\"参数错误：申请信息不完整\");\n        }\n        // 2 通用业务校验\n       /* ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(applyDTO, \"submitFinancingApply\");\n        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n            return checkResult;\n        }*/\n        // 3. 提交申请\n        if (PayBankConstants.CMB_BANK_CODE.equals(applyDTO.getBankCode())) {\n            return cmbClient.submitFinancingApply(applyDTO);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(applyDTO.getBankCode())) {\n            return cmbcClient.submitFinancingApply(applyDTO);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n\n        // 4. 返回申请结果\n    }\n\n    /**\n     * 执行本地状态回滚操作\n     * @param request 请求对象\n     */\n    private void rollbackLocalStatus(PmcFinanceBankBaseQO request) {\n        try {\n            log.info(\"开始回滚本地状态，申请单号：{}\", request.getApplyNumber());\n            ResponseMessage rollback = pmcSupplierAdmClient.rollbackApplyStatus(request);\n            if (ResponseMessage.FAIL.equals(rollback.getStatus())) {\n                log.error(\"回滚本地状态失败，申请单号：{}，错误信息：{}\",\n                    request.getApplyNumber(), rollback.getMessage());\n                throw new RuntimeException(\"回滚本地状态失败：\" + rollback.getMessage());\n            }\n            log.info(\"本地状态回滚成功，申请单号：{}\", request.getApplyNumber());\n        } catch (Exception rollbackException) {\n            log.error(\"回滚本地状态时发生异常，申请单号：{}\", request.getApplyNumber(), rollbackException);\n            throw new RuntimeException(\"回滚本地状态异常\", rollbackException);\n        }\n    }\n\n    @Override\n    public ResponseMessage submitFinancingApplyByDetail(Map<String, Object> detail) {\n        PmcFinanceBankBaseQO assembledRequest = null;\n        try {\n            log.info(\"开始处理融资申请，detail参数：{}\", detail);\n\n            // 1. 参数组装\n            assembledRequest = assembleFinancingRequest(detail);\n            log.info(\"参数组装完成，申请单号：{}\", assembledRequest.getApplyNumber());\n\n            // 2. 参数校验\n            if (StringUtils.isBlank(assembledRequest.getBankCode())) {\n                log.error(\"银行编码为空，申请单号：{}\", assembledRequest.getApplyNumber());\n                throw new IllegalArgumentException(\"参数错误：银行编码不能为空\");\n            }\n\n            // 3. 调用银行接口\n            log.info(\"开始调用银行接口，申请单号：{}\", assembledRequest.getApplyNumber());\n            ResponseMessage responseMessage = submitFinancingApply(assembledRequest);\n            log.info(\"银行接口调用完成，申请单号：{}，结果：{}\",\n                assembledRequest.getApplyNumber(), responseMessage.getStatus());\n\n            // 4. 银行接口调用失败时回滚\n            if (ResponseMessage.FAIL.equals(responseMessage.getStatus())) {\n                log.warn(\"银行接口调用失败，开始回滚，申请单号：{}\", assembledRequest.getApplyNumber());\n                rollbackLocalStatus(assembledRequest);\n            }\n\n            return responseMessage;\n\n        } catch (IllegalArgumentException e) {\n            log.error(\"参数校验异常\", e);\n            // 参数异常时回滚\n            if (assembledRequest != null) {\n                try {\n                    rollbackLocalStatus(assembledRequest);\n                } catch (Exception rollbackEx) {\n                    log.error(\"参数异常回滚失败，申请单号：{}\",\n                        assembledRequest.getApplyNumber(), rollbackEx);\n                }\n            }\n            return ResponseMessage.fail(e.getMessage());\n\n        } catch (Exception e) {\n            log.error(\"系统处理异常\", e);\n            // 系统异常时回滚\n            if (assembledRequest != null) {\n                try {\n                    rollbackLocal