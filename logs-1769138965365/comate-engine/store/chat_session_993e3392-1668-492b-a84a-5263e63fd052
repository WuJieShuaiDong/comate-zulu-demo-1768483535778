lient.financingCalculate(query);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n\n    @Override\n    public ResponseMessage submitFinancingApply(PmcFinanceBankBaseQO applyDTO) {\n        // 1. 参数校验\n        if (applyDTO == null || applyDTO.getBankCode() == null) {\n            return ResponseMessage.fail(\"参数错误：申请信息不完整\");\n        }\n        // 2 通用业务校验\n       /* ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(applyDTO, \"submitFinancingApply\");\n        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n            return checkResult;\n        }*/\n        // 3. 提交申请\n        if (PayBankConstants.CMB_BANK_CODE.equals(applyDTO.getBankCode())) {\n            return cmbClient.submitFinancingApply(applyDTO);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(applyDTO.getBankCode())) {\n            return cmbcClient.submitFinancingApply(applyDTO);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n\n        // 4. 返回申请结果\n    }\n\n    @Override\n    public ResponseMessage submitFinancingApplyByDetail(Map<String, Object> detail) {\n        ResponseMessage responseMessage;\n        PmcFinanceBankBaseQO assembledRequest = assembleFinancingRequest(detail);\n        try {\n            // 银行编码校验\n            if (StringUtils.isBlank(assembledRequest.getBankCode())) {\n                return ResponseMessage.fail(\"参数错误：银行编码不能为空\");\n            }\n            // 调用银行接口\n            responseMessage = submitFinancingApply(assembledRequest);\n\n            if (ResponseMessage.FAIL.equals(responseMessage.getStatus())) {\n                // 回滚本地状态\n                ResponseMessage rollback =  pmcSupplierAdmClient.rollbackApplyStatus(assembledRequest);\n                if (ResponseMessage.FAIL.equals(rollback.getStatus())) {\n                    log.error(\"回滚本地状态失败 {} \", rollback.getMessage());\n                }\n            }\n        } catch (IllegalArgumentException e) {\n            // 回滚本地状态\n            ResponseMessage rollback = pmcSupplierAdmClient.rollbackApplyStatus(assembledRequest);\n            if (ResponseMessage.FAIL.equals(rollback.getStatus())) {\n                log.error(\"回滚本地状态失败 {} \", rollback.getMessage());\n            }\n            return ResponseMessage.fail(e.getMessage());\n        } catch (Exception e) {\n            // 回滚本地状态\n            ResponseMessage rollback = pmcSupplierAdmClient.rollbackApplyStatus(assembledRequest);\n            if (ResponseMessage.FAIL.equals(rollback.getStatus())) {\n                log.error(\"回滚本地状态失败 {} \", rollback.getMessage());\n            }\n            log.error(\"提交融资申请失败\", e);\n            return ResponseMessage.fail(\"系统错误：\" + e.getMessage());\n        }\n        return responseMessage;\n    }\n\n    @Override\n    public ResponseMessage queryFinancingResult(PmcFinanceBankBaseQO query) {\n        // 1. 参数校验\n        if (query == null || query.getBankCode() == null) {\n            return ResponseMessage.fail(\"参数错误：银行编码不能为空\");\n        }\n\n        // 2 通用业务校验\n        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(query, \"queryFinancingResult\");\n        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n            return checkResult;\n        }\n\n        // 3. 查询融资结果\n        if (PayBankConstants.CMB_BANK_CODE.equals(query.getBankCode())) {\n            return cmbClient.queryFinancingResult(query);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(query.getBankCode())) {\n            return cmbcClient.queryFinancingResult(query);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n\n    @Override\n    public ResponseMessage queryFinancingQuota(PmcFinanceBankBaseQO query) {\n        // 1. 参数校验\n        if (query == null || query.getSupplierCode() == null || query.getBankCode() == null) {\n            return ResponseMessage.fail(\"参数错误：银行编码或者供应商编码不能为空\")