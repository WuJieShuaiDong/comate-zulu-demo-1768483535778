sicInfo(request, applyDTO, supplier);\n            log.debug(\"[{}] 基础信息组装完成\", methodName);\n\n            // 4.2 金额信息组装\n            assembleAmountInfo(request, applyDTO, payChecksDTO);\n            log.debug(\"[{}] 金额信息组装完成，融资金额：{}\",\n                methodName, request.getFinanceAmount());\n\n            // 4.3 发票信息组装\n            assembleInvoiceInfo(request, payChecksDTO);\n            log.debug(\"[{}] 发票信息组装完成，发票号：{}\",\n                methodName, request.getInvoiceNumber());\n\n            log.info(\"[{}] 参数组装完成，申请单号：{}，总金额：{}\",\n                methodName, request.getApplyNumber(), request.getFinanceAmount());\n            return request;\n\n        } catch (IllegalArgumentException e) {\n            log.error(\"[{}] 参数校验异常 - {}\", methodName, e.getMessage());\n            throw e;\n        } catch (Exception e) {\n            log.error(\"[{}] 参数组装异常 - {}\", methodName, e.getMessage(), e);\n            throw new RuntimeException(\"参数组装失败: \" + e.getMessage(), e);\n        }\n    }\n\n    /**\n     * 从Map中获取并验证DTO对象\n     */\n    private <T> T getAndValidateDTO(Map<String, Object> detail, String key, Class<T> clazz) {\n        Object obj = detail.get(key);\n        if (obj == null) {\n            throw new IllegalArgumentException(\"缺少必要参数: \" + key);\n        }\n        try {\n            return clazz.cast(obj);\n        } catch (ClassCastException e) {\n            throw new IllegalArgumentException(key + \"参数类型不匹配，期望类型: \" + clazz.getSimpleName());\n        }\n    }\n\n    /**\n     * 校验必填字段\n     */\n    private void validateRequiredFields(PmcFinanceSupplierApplyDTO applyDTO,\n                                      PmcPayChecksSupplierCodeDTO payChecksDTO,\n                                      PmcDataP2pSupplier supplier) {\n        if (StringUtils.isBlank(applyDTO.getApplyNumber())) {\n            throw new IllegalArgumentException(\"applyDTO缺少applyNumber\");\n        }\n        if (StringUtils.isBlank(applyDTO.getBankCode())) {\n            throw new IllegalArgumentException(\"applyDTO缺少bankCode\");\n        }\n        if (StringUtils.isBlank(supplier.getRegistrationCode())) {\n            throw new IllegalArgumentException(\"supplier缺少registrationCode\");\n        }\n    }\n\n    /**\n     * 组装基础信息\n     */\n    private void assembleBasicInfo(PmcFinanceBankBaseQO request,\n                                 PmcFinanceSupplierApplyDTO applyDTO,\n                                 PmcDataP2pSupplier supplier) {\n        request.setApplyNumber(applyDTO.getApplyNumber());\n        request.setPayCheckNum(applyDTO.getPayCheckNum());\n        request.setSupplierCode(applyDTO.getSupplierCode());\n        request.setSupplierName(applyDTO.getSupplierName());\n        request.setBankCode(applyDTO.getBankCode());\n        request.setRegistrationCode(supplier.getRegistrationCode());\n        request.setPayPlanDate(applyDTO.getPatyPlanDate());\n    }\n\n    /**\n     * 组装金额信息\n     */\n    private void assembleAmountInfo(PmcFinanceBankBaseQO request,\n                                  PmcFinanceSupplierApplyDTO applyDTO,\n                                  PmcPayChecksSupplierCodeDTO payChecksDTO) {\n        request.setFinanceAmount(applyDTO.getFinanceAmount());\n        request.setSupplierAccount(payChecksDTO.getAccount());\n        request.setBankCode(payChecksDTO.getBankCode());\n        request.setSupplierAddress(payChecksDTO.getPayChecksAttribute4());\n        request.setInvoiceNumber(payChecksDTO.getSourceNum());\n        request.setDocumentAmount(payChecksDTO.getAmount());\n        request.setPayableAmount(request.getFinanceAmount());\n        request.setCurrency(applyDTO.getCurrency());\n        request.setBuyerAccount(payChecksDTO.getAccount());\n        request.setFinanceNumber(applyDTO.getPayCheckNum());\n    }\n\n    /**\n     * 组装发票信息\n     */\n    private void assembleInvoiceInfo(PmcFinanceBankBaseQO request,\n                                   PmcPayChecksSupplierCodeDTO payChecksDTO) {\n        request.setInvoice