erName(applyDTO.getSupplierName());\n        request.setBankCode(applyDTO.getBankCode());\n        \n        // 金额信息\n        request.setFinanceAmount(applyDTO.getFinanceAmount());\n        request.setInvoiceAmount(payChecksDTO.getInvoiceAmount());\n        request.setPayAmount(payChecksDTO.getPayAmount());\n        \n        // 日期信息\n        request.setPayPlanDate(payChecksDTO.getPayPlanDate());\n        request.setCreateDate(new Date());\n        \n        return request;\n    }\n\n    @Override\n    public ResponseMessage submitFinancingApplyByDetail(PmcFinanceBankBaseQO request, Map<String, Object> detail) {\n        try {\n            // 参数组装\n            PmcFinanceBankBaseQO assembledRequest = assembleFinancingRequest(detail);\n            BeanUtils.copyProperties(assembledRequest, request);\n            \n            // 银行编码校验\n            if (StringUtils.isBlank(request.getBankCode())) {\n                return ResponseMessage.fail(\"参数错误：银行编码不能为空\");\n            }\n            \n            // 调用银行接口\n            return pmcBankClient.submitFinancingApply(request);\n        } catch (IllegalArgumentException e) {\n            return ResponseMessage.fail(e.getMessage());\n        } catch (Exception e) {\n            log.error(\"提交融资申请失败\", e);\n            return ResponseMessage.fail(\"系统错误：\" + e.getMessage());\n        }\n    }\n\n    @Override\n    public ResponseMessage queryFinancingResult(PmcFinanceBankBaseQO query) {\n        // 1. 参数校验\n        if (query == null || query.getBankCode() == null) {\n            return ResponseMessage.fail(\"参数错误：银行编码不能为空\");\n        }\n\n        // 2 通用业务校验\n        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(query, \"queryFinancingResult\");\n        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n            return checkResult;\n        }\n\n        // 3. 查询融资结果\n        if (PayBankConstants.CMB_BANK_CODE.equals(query.getBankCode())) {\n            return cmbClient.queryFinancingResult(query);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(query.getBankCode())) {\n            return cmbcClient.queryFinancingResult(query);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n\n    @Override\n    public ResponseMessage queryFinancingQuota(PmcFinanceBankBaseQO query) {\n        // 1. 参数校验\n        if (query == null || query.getSupplierCode() == null || query.getBankCode() == null) {\n            return ResponseMessage.fail(\"参数错误：银行编码或者供应商编码不能为空\");\n        }\n\n        // 2 通用业务校验\n        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(query, \"queryFinancingQuota\");\n        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n            return checkResult;\n        }\n\n        // 3. 查询额度信息\n        if (PayBankConstants.CMB_BANK_CODE.equals(query.getBankCode())) {\n            return  cmbClient.queryFinancingQuota(query);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(query.getBankCode())) {\n            return cmbcClient.queryFinancingQuota(query);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n\n    @Override\n    public ResponseMessage uploadFinancingAttachment(MultipartFile file, PmcFinanceBankBaseQO qo) {\n        // 1. 参数校验\n        if (file == null || file.isEmpty() || qo == null || StringUtils.isBlank(qo.getBankCode())) {\n            return ResponseMessage.fail(\"参数错误：文件或银行编码不能为空\");\n        }\n\n        // 2 通用业务校验\n        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(qo, \"uploadFinancingAttachment\");\n        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n            return checkResult;\n        }\n\n        // 3. 文件上传处理\n        if (PayBankConstants.CMB_BANK_CODE.equals(qo.getBankCode())) {\n            return cmbClient.uploadAttachment(file, qo);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(qo.getBankCode())) {\n            return cmbcClient.uploadAttachment(file, qo);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n\n    @Override\n    public ResponseMessage supplementFinancingAttachment(MultipartFile file, PmcFinanceBankBaseQO qo) {\n        // 1. 参数校验\n        if (file == null || file.isEmpty() || qo == null || StringUtils.isBlank(qo.getBankCode())) {\n            return ResponseMessage.fail(\"参数错误：文件或银行编码不能为空\");\n        }\n        // 2 通用业务校验\n        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(qo, \"supplementFinancingAttachment\");\n        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n            return checkResult;\n        }\n        // 3. 文件补充处理\n        if (PayBankConstants.CMB_BANK_CODE.equals(qo.getBankCode())) {\n            return cmbClient.supplementFinancingAttachment(file, qo);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(qo.getBankCode())) {\n            return cmbcClient.supplementFinancingAttachment(file, qo);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n}"
