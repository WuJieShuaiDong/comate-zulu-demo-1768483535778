                  "content": "package com.baidu.pmc.bankcommon.core.utils;\n\nimport com.baidu.pmc.bankcommon.core.constants.Constants;\nimport com.baidu.pmc.bankcommon.core.constants.Constants.TransType;\nimport com.baidu.pmc.bankcommon.core.constants.SqlConstants;\nimport com.baidu.pmc.bankcommon.core.service.BankCommonPayInstructInterService;\nimport com.baidu.pmc.bankcommon.core.service.PmcPayCommonBankColSetService;\nimport com.baidu.pmc.bankcommon.core.service.impl.OperateByJDBC;\nimport com.baidu.pmc.bankcommon.persistence.dao.BankCommonPayInstructMyMapper;\nimport com.baidu.pmc.bankcommon.persistence.dao.PmcPayCommonBankColSetMapper;\nimport com.baidu.pmc.bankcommon.persistence.domain.PmcPayCommonBankColSet;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.pojo.constants.PayStatus;\nimport com.baidu.pmc.pojo.dto.PayChecksDTO;\nimport com.baidu.pmc.pojo.model.fnd.FndFlexValue;\nimport com.baidubce.util.JsonUtils;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections4.CollectionUtils;\nimport org.apache.commons.collections4.ListUtils;\nimport org.apache.commons.collections4.MapUtils;\nimport org.apache.commons.lang3.StringUtils;\nimport org.springframework.beans.BeanUtils;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\nimport org.springframework.transaction.annotation.Transactional;\n\nimport java.util.Collections;\nimport java.util.Date;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Objects;\nimport java.util.Set;\nimport java.util.function.Function;\nimport java.util.stream.Collectors;\n\nimport static com.baidu.pmc.bankcommon.core.constants.SqlConstants.PAY_INSTRUCT_HIS_TABLE_NAME;\nimport static com.baidu.pmc.bankcommon.core.constants.SqlConstants.PAY_INSTRUCT_TABLE_NAME;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.XML_ILLEGAL_CHARACTER;\n\n/**\n * 银行指令相关\n * 1.创建银行指令表\n * 2.根据银行配置构建银行指令\n */\n@Slf4j\n@Service\npublic class BankInstructUtil {\n\n    @Autowired\n    private PmcPayCommonBankColSetMapper bankColSetMapper;\n\n    @Autowired\n    private BankCommonPayInstructMyMapper instructMyMapper;\n\n    @Autowired\n    private PmcPayCommonBankColSetService commonBankColSetService;\n\n    @Autowired\n    private BankCommonPayInstructInterService bankCommonPayInstructInterService;\n\n    @Autowired\n    private OperateByJDBC operateByJDBC;\n\n    /**\n     * 生成付款指令表 + 付款指令历史表\n     *\n     * @param bankCode 银行code\n     */\n    @Transactional(rollbackFor = Exception.class)\n    public void createBankInstructTable(String bankCode, String bankSuffixCode) {\n        if (StringUtils.isAnyBlank(bankCode)) {\n            return;\n        }\n\n        bankSuffixCode = StringUtils.isBlank(bankSuffixCode) ? commonBankColSetService.getBankSuffix(bankCode)\n                : bankSuffixCode;\n        // 建表这里不查缓存\n        PmcPayCommonBankColSet query = new PmcPayCommonBankColSet();\n        query.setBankCode(bankCode);\n        query.setTableFlag(Constants.ENABLED_Y);\n        query.setStandardFlag(Constants.ENABLED_N);\n        query.setEnableFlag(Constants.ENABLED_Y);\n        List<PmcPayCommonBankColSet> list = bankColSetMapper.select(query);\n        list = ListUtils.emptyIfNull(list).stream()\n                .filter(col -> StringUtils.isNotBlank(col.getColumnCode())).collect(Collectors.toList());\n        if (CollectionUtils.isEmpty(list)) {\n            log.error(\"bank {} {} do not have any config\", bankCode, bankSuffixCode);\n        }\n        // 校验字段是否重复\n        Map<String, Integer> map = ListUtils.emptyIfNull(list).stream().map(PmcPayCommonBankColSet::getColumnCode)\n                .collect(Collectors.groupingBy(Function.identity(), Collectors.counting())).entrySet()\n                .stream().filter(entry -> entry.getValue() > 1)\n                .collect(Collectors.toMap(Map.Entry::getKey, entry -> entry.getValue().intValue()));\n        if (MapUtils.isNotEmpty(map)) {\n            log.error(\"bank {} {} has duplicate column code {}\", bankCode, bankSuffixCode, map.keySet());\n            throw new RuntimeException(\"银行 \" + bankCode + \" \" + bankSuffixCode + \" 存在重复字段 \" + map.keySet());\n        }\n        //  调试时需要初始化配置时打开\n        if (false) {\n            // 校验是否跟标准字段重复\n            Set<String> columCodes = ListUtils.emptyIfNull(list).stream().map(PmcPayCommonBankColSet::getColumnCode).collect(Collectors.toSet());\n            columCodes.retainAll(SqlConstants.PRE_FIELD_CODES);\n            if (CollectionUtils.isNotEmpty(columCodes)) {\n                log.error(\"bank {} {} has duplicate column code with standard field\", bankCode, bankSuffixCode);\n                throw new RuntimeException(\"银行 \" + bankCode + \" \" + bankSuffixCode + \" 存在重复标准字段 \" + map.keySet());\n            }\n            // 初始化字段配置\n            instructMyMapper.initBankCommonColSet(bankCode);\n        }\n        bankSuffixCode = StringUtils.lowerCase(bankSuffixCode);\n        String tableName = String.format(PAY_INSTRUCT_TABLE_NAME, bankSuffixCode);\n        String hisTableName = String.format(PAY_INSTRUCT_HIS_TABLE_NAME, bankSuffixCode);\n        if (instructMyMapper.tableExist(tableName) < 1) {\n            log.info(\"create bank instruct table {}\", tableName);\n            instructMyMapper.createBankInstructTable(tableName, list);\n        } else {\n            log.info(\"bank instruct table {} already existed\", tableName);\n        }\n        if (instructMyMapper.tableExist(hisTableName) < 1) {\n            log.info(\"create bank instruct his table {}\", hisTableName);\n            instructMyMapper.createBankInstructTable(hisTableName, list);\n        } else {\n            log.info(\"bank instruct his table {} already existed\", hisTableName);\n        }\n    }\n\n    /**\n     * 根据付款单生成付款指令并保存到 pmc_xxx_pay_instruct 表中\n     *\n     * @param bankCode\n     * @param payChecks\n     * @param bankSuffixCode\n     * @return\n     */\n    public Map<String, Object> createPayInstruct(String bankCode, String bankSuffixCode, PayChecksDTO payChecks) {\n        if (StringUtils.isAnyBlank(bankCode) || Objects.isNull(payChecks)) {\n            return Collections.emptyMap();\n        }\n        bankSuffixCode = StringUtils.isBlank(bankSuffixCode) ? commonBankColSetService.getBankSuffix(bankCode) :\n                bankSuffixCode;\n        List<PmcPayCommonBankColSet> bankColSet = commonBankColSetService.getBankColSet(bankCode);\n        if (CollectionUtils.isEmpty(bankColSet)) {\n            log.error(\"bank {} {} do not have any config, cannot create instruct, pay check num {} use default\",\n                    bankCode, bankSuffixCode, payChecks.getPayCheckNum());\n            // 没有配置使用默认逻辑\n            return defaultPayInstruct(payChecks, bankCode);\n        }\n        Map<String, Object> instruct = new HashMap<>();\n        log.info(\"动态转化生成付款指令，payChecks={}\", JsonUtils.toJsonString(payChecks));\n        for (PmcPayCommonBankColSet colSet : bankColSet) {\n            String filedName = FiledNameUtils.underlineToCamel(colSet.getColumnCode()); // 转换成驼峰格式再取\n            String dataSourcedName = FiledNameUtils.underlineToCamel(colSet.getTransDetail()); // 转换成驼峰格式再取\n\n            log.info(\"付款单：{}->转化类型:{}，转化字段：{}，取值来源：{}\",\n                    payChecks.getPayCheckNum(),\n                    colSet.getTransType(),\n                    filedName,\n                    dataSourcedName);\n            if (TransType.PAY.equals(colSet.getTransType())) {\n                // 尝试从 payChecks 中获取\n                Object value = null;\n                try {\n                    value = ReflectUtils.invokeGetMethod(payChecks, dataSourcedName);\n                } catch (Exception e) {\n                    log.error(\"get pay check {} field {} error\", payChecks.getPayCheckNum(), filedName, e);\n                }\n                instruct.put(filedName, value);\n            } else if (TransType.FLEX.equals(colSet.getTransType())) {\n                Object value = commonBankColSetService.getBankCommonFlexValue(colSet);\n                instruct.put(filedName, value);\n                // instruct.put(colSet.getColumnCode(), value);\n            }else if (TransType.DATE.equals(colSet.getTransType())) {\n                try {\n                    Object value = DateUtils.formatDate(new Date(), colSet.getTransDetail());\n                    instruct.put(filedName, value);\n                } catch (Exception e) {\n                    log.error(\"get pay check error\", e);\n                }\n            }\n        }\n        // 通用默认字段\n\n        // 唯一性字段\n        instruct.put(\"trnUid\", this.genBankcommonInstructTrnUid(payChecks.getPayCheckNum(), bankCode));\n        instruct.put(\"status\", PayStatus.PAY_ORDER_GEN.name());\n\n\n        if (Objects.isNull(instruct.get(\"payDate\"))) {\n            instruct.put(\"payDate\", new Date());\n        }\n\n        if (Objects.isNull(instruct.get(\"remark\"))) {\n            instruct.put(\"remark\", this.filterCharacter(payChecks.getRemark()));\n        }\n\n        if (StringUtils.equals(payChecks.getAttribute3(), payChecks.getBankCode())) {\n            instruct.put(\"interBankFlag\", Constants.ENABLED_N);\n        } else {\n            instruct.put(\"interBankFlag\", Constants.ENABLED_Y);\n        }\n\n        if (com.baidu.pmc.common.utils.StringUtils.equals(payChecks.getAttributeCategory(), Constants.WIRE_CN)\n                || com.baidu.pmc.common.utils.StringUtils.equals(payChecks.getAttributeCategory(), Constants.PAYCARD_CN)) {\n            if (Objects.isNull(instruct.get(\"payee\"))) {\n                instruct.put(\"payee\", payChecks.getAttribute1());\n            }\n            if (Objects.isNull(instruct.get(\"payeeAccount\"))) {\n                instruct.put(\"payeeAccount\", payChecks.getAttribute2());\n            }\n            if (Objects.isNull(instruct.get(\"payeeBank\"))) {\n                instruct.put(\"payeeBank\", payChecks.getAttribute3Name());\n            }\n            if (Objects.isNull(instruct.get(\"payeeBanch\"))) {\n                instruct.put(\"payeeBanch\", payChecks.getAttribute4());\n            }\n            if (Objects.isNull(instruct.get(\"payeeProv\"))) {\n                instruct.put(\"payeeProv\", payChecks.getAttribute5Name());\n            }\n            if (Objects.isNull(instruct.get(\"payeeCity\"))) {\n                instruct.put(\"payeeCity\", payChecks.getAttribute6Name());\n            }\n            if (Objects.isNull(instruct.get(\"payeeBanchNumber\"))) {\n                instruct.put(\"payeeBanchNumber\", payChecks.getAttribute7());\n            }\n        }\n        return instruct;\n    }\n\n    public Map<String, Object> defaultPayInstruct(PayChecksDTO payCheck, String bankCode) {\n        Map<String, Object> payInstruct = new HashMap<>();\n        BeanUtils.copyProperties(payCheck, payInstruct);\n        payInstruct.put(\"acAccountId\", payCheck.getAcAccountId());\n        // 付款日期设置成指令生成日期\n        payInstruct.put(\"payDate\", new Date());\n        payInstruct.put(\"account\", payCheck.getAccount());\n        payInstruct.put(\"amount\", payCheck.getAmount());\n        payInstruct.put(\"amountCurrency\", payCheck.getAmountCurrency());\n        payInstruct.put(\"bankCode\", payCheck.getBankCode());\n        // 付款指令uid\n        payInstruct.put(\"clientId\", this.genBankcommonInstructTrnUid(payCheck.getPayCheckNum(), bankCode));\n        if (StringUtils.isNotBlank(payCheck.getAccount())) {\n            payInstruct.put(\"accountProv\", payCheck.getAccount().substring(0, 2));\n        }\n        payInstruct.put(\"checkId\", payCheck.getCheckId());\n        payInstruct.put(\"companyCode\", payCheck.getCompanyCode());\n        // 付款账户联行号\n        payInstruct.put(\"payeeBanchNumber\", payCheck.getAttribute7());\n        payInstruct.put(\"transCode\", \"DLINTTRN\");\n        payInstruct.put(\"payCheckNum\", payCheck.getPayCheckNum());\n        payInstruct.put(\"status\", PayStatus.PAY_ORDER_GEN.name());\n        if (StringUtils.equals(payCheck.getAttributeCategory(), Constants.WIRE_CN)\n                || StringUtils.equals(payCheck.getAttributeCategory(), Constants.PAYCARD_CN)) {\n            payInstruct.put(\"payee\", payCheck.getAttribute1());\n            payInstruct.put(\"payeeAccount\", payCheck.getAttribute2());\n            payInstruct.put(\"payeeBank\", payCheck.getAttribute3Name());\n            payInstruct.put(\"payeeBanch\", payCheck.getAttribute4());\n            payInstruct.put(\"payeeProv\", payCheck.getAttribute5Name());\n            payInstruct.put(\"payeeCity\", payCheck.getAttribute6Name());\n            payInstruct.put(\"payeeBanchNumber\", payCheck.getAttribute7());\n        }\n        // 是否跨行(用于指令表页面查询,生成指令时接口所需字段为是否同行,即该字段取反)\n        if (StringUtils.equals(payCheck.getAttribute3(), payCheck.getBankCode())) {\n            payInstruct.put(\"interBankFlag\", Constants.ENABLED_N);\n        } else {\n            payInstruct.put(\"interBankFlag\", Constants.ENABLED_Y);\n        }\n        payInstruct.put(\"protocolNumber\", payCheck.getProtocolNumber());\n        payInstruct.put(\"remark\", this.filterCharacter(payCheck.getRemark()));\n        return payInstruct;\n    }\n\n\n    /**\n     * 根据付款单号生成付款唯一id\n     */\n    private String genBankcommonInstructTrnUid(String payCheckNum, String bankCode) {\n        int queueNum = 0;\n        String oldTrnUid = bankCommonPayInstructInterService.selectTrnUidByCheckNum(payCheckNum, bankCode);\n        if (StringUtils.isNotBlank(oldTrnUid)) {\n            String number = oldTrnUid.replace(payCheckNum, StringUtils.EMPTY);\n            queueNum = Integer.parseInt(number) + 1;\n        }\n        return payCheckNum.concat(String.format(Constants.COMMON_INSTRUCT_TRN_UID, queueNum));\n    }\n\n\n    /**\n     * 过滤特殊字符\n     *\n     * @param filterString 待过滤的数据\n     * @return 过滤后的数据\n     */\n    private String filterCharacter(String filterString) {\n        if (StringUtils.isBlank(filterString)) {\n            return filterString;\n        }\n        List<FndFlexValue> fndFlexValues = operateByJDBC.selectByConTwo(XML_ILLEGAL_CHARACTER);\n        String replace = \"\";\n        for (FndFlexValue fndFlexValue : fndFlexValues) {\n            if (filterString.contains(fndFlexValue.getFlexValue())) {\n                replace = filterString.replace(fndFlexValue.getFlexValue(),\n                        fndFlexValue.getDescription());\n                filterString = replace;\n            }\n        }\n        return filterString.trim();\n    }\n}",
