                  "content": "package com.baidu.pmc.bankcommon.core.service.strategy;\n\nimport com.baidu.pmc.bankcommon.core.constants.Constants;\nimport com.baidu.pmc.bankcommon.core.constants.Constants.BankStrategyCode;\nimport com.baidu.pmc.bankcommon.core.service.BankStrategy;\nimport com.baidu.pmc.bankcommon.core.service.BankcommonPayInstructService;\nimport com.baidu.pmc.bankcommon.core.service.BankcommonReceiptService;\nimport com.baidu.pmc.bankcommon.core.service.BankcommonService;\nimport com.baidu.pmc.bankcommon.core.service.MachineService;\nimport com.baidu.pmc.bankcommon.core.service.impl.SendMailService;\nimport com.baidu.pmc.bankcommon.core.utils.BankInstructUtil;\nimport com.baidu.pmc.bankcommon.core.utils.NodeDistributeUtil;\nimport com.baidu.pmc.bankcommon.core.utils.OkHttpUtils;\nimport com.baidu.pmc.bankcommon.persistence.dao.PmcPayCommonBankSetMapper;\nimport com.baidu.pmc.pojo.dto.PayChecksDTO;\nimport com.baidu.pmc.pojo.dto.cmb.BalanceInfo;\nimport com.baidu.pmc.pojo.dto.cmb.PayInstructDTO;\nimport com.baidu.pmc.pojo.dto.cmb.PmcCmbMachineDTO;\nimport com.baidu.pmc.pojo.dto.cmb.TmsAccountBalanceCmb;\nimport com.baidu.pmc.pojo.dto.cmb.TransInfo;\nimport com.baidu.pmc.pojo.model.PmcPayChecks;\nimport com.baidu.pmc.pojo.model.PmcPayCommonBankSet;\nimport com.baidu.pmc.pojo.model.cmb.PayQO;\nimport com.baidu.pmc.pojo.model.cmb.PmcCmbMachine;\nimport com.baidu.pmc.pojo.qo.BankcommonBalanceOldQO;\nimport com.baidu.pmc.pojo.qo.cmb.PayInstructQO;\nimport com.github.pagehelper.Page;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections4.CollectionUtils;\nimport org.apache.commons.lang3.StringUtils;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\nimport tk.mybatis.mapper.entity.Example;\n\nimport java.math.BigDecimal;\nimport java.util.ArrayList;\nimport java.util.Collections;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Objects;\nimport java.util.function.Function;\nimport java.util.stream.Collectors;\n\n/**\n * 通用策略\n */\n@Slf4j\n@Service\npublic class CommonBankStrategy implements BankStrategy {\n\n    /**\n     * 引入以下3个接口原因：\n     * 最初这个CommonBankStrategy是用来做通用化处理逻辑实现的，但是因为分工不同，已经在BankcommonXXXService中实现了，\n     * 所以这里不再实现，而是引入这几个模块，直接调用对应的方法即可。\n     * 后续接入新的银行时，则参考CmbBankStrategy\n     * 需要特殊处理时则重写对应方法，否则引入CommonBankStrategy然后直接调用CommonBankStrategy对应方法即可\n     */\n    @Autowired\n    private BankcommonPayInstructService bankcommonPayInstructService;\n\n    @Autowired\n    private BankcommonService bankcommonService;\n\n    @Autowired\n    private BankcommonReceiptService bankcommonReceiptService;\n\n    @Autowired\n    private BankInstructUtil bankInstructUtil;\n\n    @Autowired\n    private MachineService machineService;\n\n    @Autowired\n    private SendMailService mailService;\n\n    @Autowired\n    private PmcPayCommonBankSetMapper pmcPayCommonBankSetMapper;\n\n\n    @Override\n    public String getBankStrategy() {\n        return BankStrategyCode.COMMON;\n    }\n\n    @Override\n    public Page<PayInstructDTO> getPayInstructList(PayInstructQO qo) {\n        return bankcommonPayInstructService.bankcommonInstructList(qo, null);\n    }\n\n    @Override\n    public Integer genBankUnUrgentPay(String bankCode) {\n        return bankcommonPayInstructService.genBankcommonUnUrgentPay(bankCode, null);\n    }\n\n    @Override\n    public List<TransInfo> selectBankTrans(PayQO qo) {\n        return bankcommonService.selectBankcommonTrans(qo, null);\n    }\n\n    @Override\n    public List<BalanceInfo> selectBankBalance(PayQO qo) {\n        return bankcommonService.selectBankcommonBalance(qo, null);\n    }\n\n    @Override\n    public List<BalanceInfo> queryBalanceForCheck(List<PayQO> qos) {\n        return bankcommonService.queryBankcommonBalanceForCheck(qos, null);\n    }\n\n    @Override\n    public Page<PayInstructDTO> bankSuspectList(PayInstructQO qo) {\n        return bankcommonPayInstructService.bankcommonSuspectList(qo, null);\n    }\n\n    @Override\n    public String bankAnalysisSuspect(PayInstructQO payInstructQO) {\n        return bankcommonService.bankcommonAnalysisSuspect(payInstructQO, null);\n    }\n\n    @Override\n    public String updateInstruct(PayInstructQO payInstructQO) {\n        return bankcommonPayInstructService.updateBankcommonInstruct(payInstructQO, null);\n    }\n\n    @Override\n    public void updateInstructFailedBatch(String bankCode, List<Long> payIds) {\n        bankcommonPayInstructService.updateBankcommonInstructFailedBatch(payIds, bankCode, null);\n    }\n\n    @Override\n    public int bankDirectBankPay(String bankCode) {\n        return bankcommonService.bankcommonDirectBankPay(bankCode, null);\n    }\n\n    @Override\n    public List<Map<String, Object>> queryPayResult(List<Map<String, Object>> instructs, String bankCode) {\n        return bankcommonService.queryPayResult(instructs, bankCode, null);\n    }\n\n    @Override\n    public String selectElectReceipt(PayQO payQO) {\n        return bankcommonReceiptService.selectElectReceipt(payQO, null);\n    }\n\n    @Override\n    public String selectBankcommonRefund(PayQO payQO) {\n        return bankcommonService.selectBankcommonRefund(payQO, null);\n    }\n\n    @Override\n    public List<TmsAccountBalanceCmb> selectBankBalanceOld(BankcommonBalanceOldQO bankcommonBalanceOldQO) {\n        return bankcommonService.selectBankcommonBalanceOld(bankcommonBalanceOldQO, null);\n    }\n\n    @Override\n    public List<Map<String, Object>> generateBankPayInstructs(String bankCode, List<PayChecksDTO> checks) {\n        if (StringUtils.isBlank(bankCode) || CollectionUtils.isEmpty(checks)) {\n            return Collections.emptyList();\n        }\n        List<Map<String, Object>> instructs = new ArrayList<>();\n        checks.forEach(payChecks -> {\n            Map<String, Object> instruct = bankInstructUtil.createPayInstruct(bankCode, null, payChecks);\n            if (Objects.nonNull(instruct)) {\n                instructs.add(instruct);\n            }\n        });\n        return instructs;\n    }\n\n    @Override\n    public String bankQueryPayResultJob(String bankCode) {\n        return bankcommonService.bankcommonQueryPayResultJob(bankCode, null);\n    }\n\n    @Override\n    public Integer getBankUnUrgentPayTask() {\n        return 0;\n    }\n\n    @Override\n    public Integer bankUnUrgentPayTask() {\n        return 0;\n    }\n\n    @Override\n    public Integer bankQueryPayResultTask() {\n        return 0;\n    }\n\n    @Override\n    public Integer selectBankElectReceiptTask() {\n        return 0;\n    }\n\n    /**\n     * 校验指令-收款方\n     */\n    @Override\n    public String verityReceive(PayChecksDTO payChecksDTO, PmcPayChecks payCheck, String bankCode) {\n        // 收款方信息校验\n        StringBuilder failedStringBuilder = new StringBuilder();\n        if (com.baidu.pmc.common.utils.StringUtils.isBlank(payChecksDTO.getAttributeCategory())) {\n            failedStringBuilder.append(\"收款人信息弹性域字段为空！\");\n        } else if (!Constants.WIRE_CN.equals(payChecksDTO.getAttributeCategory())\n                && !Constants.PAYCARD_CN.equals(payChecksDTO.getAttributeCategory())) {\n            failedStringBuilder.append(\"收款人信息弹性域非工资卡中国或电汇中国! \");\n        }\n        if (com.baidu.pmc.common.utils.StringUtils.isBlank(payChecksDTO.getAttribute1())) {\n            failedStringBuilder.append(\"收款人名称为空! \");\n        } else if (com.baidu.pmc.common.utils.StringUtils.length(payChecksDTO.getAttribute1()) > 122) {\n            failedStringBuilder.append(\"收款人名称长度大于122! \");\n        }\n        if (com.baidu.pmc.common.utils.StringUtils.isBlank(payChecksDTO.getAttribute2())) {\n            failedStringBuilder.append(\"收款方帐号为空！\");\n        } else if (payChecksDTO.getAttribute2().length() > 32) {\n            failedStringBuilder.append(\"收款方帐号长度大于32！\");\n        } else if (payChecksDTO.getAttribute2().contains(\"/\") || payChecksDTO.getAttribute2().contains(\"\\\\\")) {\n            failedStringBuilder.append(\"收款账号字段格式错误！ \");\n        }\n        if (com.baidu.pmc.common.utils.StringUtils.isBlank(payChecksDTO.getAttribute3())) {\n            failedStringBuilder.append(\"收款账号开户行为空！ \");\n        }\n        // 收款方值集翻译失败\n        if (com.baidu.pmc.common.utils.StringUtils.isBlank(payChecksDTO.getAttribute3Name())) {\n            failedStringBuilder.append(\"银行code:\").append(payChecksDTO.getAttribute3()).append(\"值集翻译失败\");\n        }\n\n        if (com.baidu.pmc.common.utils.StringUtils.isBlank(payChecksDTO.getAttribute4())) {\n            failedStringBuilder.append(\"收款账号开户行支行为空！ \");\n        } else {\n            String bankBranch = payChecksDTO.getAttribute3Name() + payChecksDTO.getAttribute4();\n            if (bankBranch.length() > 122) {\n                failedStringBuilder.append(\"收款人开户行+开户支行名称长度大于122！\");\n            }\n        }\n\n        if (com.baidu.pmc.common.utils.StringUtils.isNotBlank(payChecksDTO.getRemark())\n                && com.baidu.pmc.common.utils.StringUtils.length(payChecksDTO.getRemark()) > 102) {\n            failedStringBuilder.append(\"用途字段长度大于102！\");\n        } else if (com.baidu.pmc.common.utils.StringUtils.isNotBlank(payChecksDTO.getRemark())\n                && payChecksDTO.getRemark().contains(\"|\")) {\n            failedStringBuilder.append(\"用途字段格式错误！\");\n        }\n\n        payCheck.setFailureReasons(failedStringBuilder.toString());\n        return payCheck.getFailureReasons();\n    }\n\n    /**\n     * 校验指令-付款方\n     */\n    @Override\n    public String verityPay(List<String> bankCodes, PayChecksDTO payChecksDTO, PmcPayChecks payCheck, String bankCode) {\n\n        StringBuilder verityFailedStringBuilder = new StringBuilder();\n        // 付款方信息校验\n        if (!Constants.TYPE_HOME.equals(payChecksDTO.getAccountType())) {\n            verityFailedStringBuilder.append(\"付款账户非国内账户！\");\n        }\n        if (!bankCodes.contains(payChecksDTO.getBankCode())) {\n            verityFailedStringBuilder.append(\"付款银行没有开通银企直连！\");\n        }\n        if (com.baidu.pmc.common.utils.StringUtils.isBlank(payChecksDTO.getReferenceNumber())) {\n            verityFailedStringBuilder.append(\"业务参考号为空！\");\n        } else if (payChecksDTO.getReferenceNumber().length() > 20) {\n            payChecksDTO.setReferenceNumber(payChecksDTO.getReferenceNumber().substring(0, 19));\n        }\n        if (com.baidu.pmc.common.utils.StringUtils.isBlank(payChecksDTO.getAccount())) {\n            verityFailedStringBuilder.append(\"付款账户为空！\");\n        } else if (payChecksDTO.getAccount().length() > 19) {\n            verityFailedStringBuilder.append(\"付款账户长度大于19！\");\n        }\n        if (!com.baidu.pmc.common.utils.StringUtils.equals(payChecksDTO.getCurrency(), payChecksDTO.getAmountCurrency())) {\n            verityFailedStringBuilder.append(\"付款币种和账户币种不一致！\");\n        }\n        if (!Constants.CNY.equals(payChecksDTO.getAmountCurrency())) {\n            verityFailedStringBuilder.append(\"币种不是人民币！\");\n        }\n        if (payChecksDTO.getAmount() == null || payChecksDTO.getAmount().compareTo(BigDecimal.ZERO) <= 0) {\n            verityFailedStringBuilder.append(\"金额小于等于0！\");\n        }\n        if (!Constants.ENABLED_Y.equals(payChecksDTO.getDirectFlag())) {\n            verityFailedStringBuilder.append(\"没有启用银企支付！\");\n        }\n        payCheck.setFailureReasons(verityFailedStringBuilder.toString());\n        return payCheck.getFailureReasons();\n    }\n\n    @Override\n    public String postBankHttp(String request, String uri, Map<String, Object> dto, String bankCode) {\n        return \"\";\n    }\n\n    @Override\n    public String postMACHINE(String request, String hashValue, Long tenantId, String[] ipArr, String bankCode) {\n        PmcCmbMachineDTO cmbMachineDTO = new PmcCmbMachineDTO();\n        cmbMachineDTO.setTenantId(tenantId);\n        cmbMachineDTO.setStatus(Constants.UP);\n        cmbMachineDTO.setMachineBank(bankCode);\n        List<PmcCmbMachine> pmcCmbMachines = machineService.selectMachine(cmbMachineDTO);\n        if (org.apache.commons.collections.CollectionUtils.isEmpty(pmcCmbMachines)) {\n            log.error(\"无可用前置机 postMACHINE\");\n            // 无可用前置机\n            mailService.sendMachineFailedMail(\"无可用前置机\", new ArrayList<>(), \"\");\n            return Constants.NO_ENABLED_MACHINE;\n        }\n        pmcCmbMachines.forEach(detail -> log.info(\"可用前置机：\" + detail.getName() + \" \" + detail.getIp()));\n        log.info(\"租户：\" + tenantId);\n        // 一致性哈希算法 获取分配机器\n        Map<String, PmcCmbMachine> map = pmcCmbMachines.stream()\n                .collect(Collectors.toMap(PmcCmbMachine::getIp, Function.identity(), (k1, k2) -> k1));\n        String[] currentServers = map.keySet().toArray(new String[0]);\n        String server = new NodeDistributeUtil().getServer(hashValue, currentServers);\n        log.info(\"request server : \" + server);\n        PmcCmbMachine machine = map.get(server);\n        log.info(\"请求前置机ip地址: {}\", machine.getIp());\n        String[] ipPort;\n        if (server.split(\"//\").length != 2\n                || (ipPort = server.split(\"//\")[1].split(\":\")).length != 2) {\n            log.error(\"ip = {}, 格式不正确\", server);\n            return Constants.NO_ENABLED_MACHINE;\n        }\n        if (null != ipArr) {\n            ipArr[0] = ipPort[0];\n        }\n        try {\n            // 请求报文\n            log.info(\"请求报文 request={}\", request);\n            Example example = new Example(PmcPayCommonBankSet.class);\n            example.createCriteria().\n                    andEqualTo(\"bankCode\", bankCode)\n                    .andEqualTo(\"transferFlag\", Constants.ENABLED_Y);\n            List<PmcPayCommonBankSet> pmcPayCommonBankSets = pmcPayCommonBankSetMapper.selectByExample(example);\n            String requestType = Constants.RequestTypeEnum.XML;\n            if (org.apache.commons.collections.CollectionUtils.isNotEmpty(pmcPayCommonBankSets)) {\n                requestType = pmcPayCommonBankSets.get(0).getRequestType();\n            }\n            String response = null;\n            if (Constants.RequestTypeEnum.XML.equals(requestType)) {\n                response = OkHttpUtils.sendHttpRequest(machine.getIp(), request);\n            } else {\n                response = OkHttpUtils.sendHttpRequestJson(machine.getIp(), request);\n            }\n            log.info(\"response :\" + response);\n            return response;\n        } catch (Exception e) {\n            log.error(\"网络出错，请检查网络！\", e);\n        }\n        return Constants.BANK_POST_EXCEPTION;\n    }\n\n}\n",
