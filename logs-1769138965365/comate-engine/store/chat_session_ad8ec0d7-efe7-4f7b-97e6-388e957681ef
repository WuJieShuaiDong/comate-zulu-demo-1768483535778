                  "content": "     * @return 返回对应的Map<String, Object>对象集合\n     */\n    @Override\n    public List<Map<String, Object>> queryPayResult(List<Map<String, Object>> instructs, String bankCode, Map<String, String> extentionParams) {\n        List<Map<String, Object>> dtoList = new ArrayList<>();\n\n        for (Map<String, Object> payInstruct : instructs) {\n            Map<String, Object> dto = new HashMap<String, Object>(payInstruct);\n            dto.put(\"bankCode\", bankCode);\n            // 组装支付结果查询报文\n            String request = messageBuilder.queryPayStatusMessage(dto, extentionParams);\n\n            // 发送银行前置机\n            String response = this.postBank(request, dto, bankCode);\n            if (Constants.NO_ENABLED_MACHINE.equals(response) || Constants.BANK_POST_EXCEPTION.equals(response)) {\n                log.error(\"付款结果查询时 无可用前置机异常 或网络错误\");\n                continue;\n            }\n            dto.put(\"funName\", Constants.BankcommonTranscodeEnum.PAY_STATUS);\n            ResponseHeaderDTO resDto = responseXmlParser.parseResponseXml(response, dto);\n            if (resDto == null || resDto.getHeader() == null) {\n                log.error(\"付款结果查询时 银行反馈结果为空\");\n            } else if (!Constants.RESPONSE_SUCCESS.equals(resDto.getHeader().getStatus())) {\n                log.error(\"付款结果查询时 银行反馈结果 relCode={}, resMeg={}\",\n                        resDto.getHeader().getStatus(), resDto.getHeader().getStatusText());\n            } else if (resDto.getBody() == null) {\n                log.error(\"付款结果查询时 银行反馈成功，子节点为空\");\n            } else {\n                this.dealBackStatus(dto, resDto);\n            }\n            dtoList.add(dto);\n        }\n        return dtoList;\n    }\n\n    /**\n     * 处理状态反馈的数据结果\n     */\n    private void dealBackStatus(Map<String, Object> dto, ResponseHeaderDTO resDto) {\n        List<Map<String, Object>> successBackDto = new ArrayList<>();\n        log.info(\"dealBackStatus dto={}\", JSON.toJSONString(dto