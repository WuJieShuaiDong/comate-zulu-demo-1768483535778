ount> crList = loanAccounts.stream().filter(o ->\n                    LoanConstants.LOAN_GL_DIRECTION_CR.equals(o.getDirection())).collect(Collectors.toList());\n            if (CollectionUtils.isEmpty(drList) || CollectionUtils.isEmpty(crList)) {\n                throw new ServiceException(\"会计分录数据不完整\");\n            }\n            if (crList.size() == 1) {\n                List<LoanAccount> drTemp = drList.stream().filter(o -> !\"Y\".equals(o.getPlFlag()))\n                        .collect(Collectors.toList());\n                List<LoanAccount> temp = drList.stream().filter(o -> \"Y\".equals(o.getPlFlag()))\n                        .collect(Collectors.toList());\n                List<LoanAccount> crTemp = crList;\n                BigDecimal dr = drTemp.stream().map(LoanAccount::getAccounted).reduce(BigDecimal::add)\n                        .orElse(BigDecimal.ZERO);\n                BigDecimal cr = crTemp.stream().map(LoanAccount::getAccounted).reduce(BigDecimal::add)\n                        .orElse(BigDecimal.ZERO);\n                if (dr.compareTo(cr) < 0) {\n                    temp.get(0).setAccounted(cr.subtract(dr));\n                    temp.get(0).setAccountedDr(cr.subtract(dr));\n                    temp.get(0).setEntered(cr.subtract(dr));\n                } else if (dr.compareTo(cr) > 0) {\n                    temp.get(0).setDirection(LoanConstants.LOAN_GL_DIRECTION_CR);\n                    temp.get(0).setAccounted(dr.subtract(cr));\n                    temp.get(0).setAccountedDr(null);\n                    temp.get(0).setAccountedCr(dr.subtract(cr));\n                    temp.get(0).setEntered(dr.subtract(cr));\n                }\n\n            } else if (crList.size() == 2) {\n                List<LoanAccount> drTemp = drList;\n                List<LoanAccount> temp = crList.stream().filter(o -> \"Y\".equals(o.getPlFlag()))\n                        .collect(Collectors.toList());\n                List<LoanAccount> crTemp = crList.stream().filter(o -> !\"Y\".equals(o.getPlFlag()))\n                        .collect(Collectors.toList());\n                BigDecimal dr = drTemp.stream().map(LoanAccount::getAccounted).reduce(BigDecimal::add)\n                        .orElse(BigDecimal.ZERO);\n                BigDecimal cr = crTemp.stream().map(LoanAccount::getAccounted).reduce(BigDecimal::add)\n                        .orElse(BigDecimal.ZERO);\n                if (dr.compareTo(cr) < 0) {\n                    temp.get(0).setDirection(LoanConstants.LOAN_GL_DIRECTION_DR);\n                    temp.get(0).setAccounted(cr.subtract(dr));\n                    temp.get(0).setAccountedDr(cr.subtract(dr));\n                    temp.get(0).setAccountedCr(null);\n                    temp.get(0).setEntered(cr.subtract(dr));\n                } else if (dr.compareTo(cr) > 0) {\n                    temp.get(0).setAccounted(dr.subtract(cr));\n                    temp.get(0).setAccountedCr(dr.subtract(cr));\n                    temp.get(0).setEntered(dr.subtract(cr));\n                }\n            } else {\n                throw new ServiceException(\"会计分录贷方数据不完整\");\n            }\n\n        });\n        return loanAccountList;\n    }\n\n\n    /**\n     * 获取交易计提利息记账信息 用于创建理财记账\n     *\n     * @param account eventIdList\n     * @return 理财计提利息记账信息\n     */\n    @Override\n    public List<LoanAccount> getDealAccrualAccounts(LoanAccount account) {\n        List<LoanAccount> accounts = new ArrayList<>();\n        List<Long> eventIds = account.getEventIds().stream().distinct().collect(Collectors.toList());\n        eventIds.forEach(accrualId -> {\n            List<LoanAccount> accountAssembleds = assembleDealAccrualAccount(accrualId);\n            sortAccouts(accountAssembleds);\n            accounts.addAll(accountAssembleds);\n        });\n        logger.info(\"获取计提分录数据,入参:\" + StringUtils.join(eventIds.toArray(), \",\") + \";返回数量:\" + accounts.size());\n        return accounts;\n    }\n\n    /**\n     * 公司间借款--计提利息--获取分录明细数据：0\n     *\n     * @param account eventIdList\n     * @return\n     */\n    @Override\n    public List<LoanAccount> getLoanAccrualAccounts(LoanAccount account) {\n        List<LoanAccount> loanAccountList = Lists.newArrayList();\n        if (CollectionUtils.isEmpty(account.getEventIds())) {\n            return loanAccountList;\n        }\n\n        List<Long> eventIds = account.getEventIds().stream().distinct().collect(Collectors.toList());\n        eventIds.forEach(accrualId -> {\n            List<LoanAccount> accountList = assembleCompanyAccrualAccount(accrualId);\n            accountList = accountList.stream().sorted(Comparator.comparing(LoanAccount::getDirection)\n                    .reversed()).collect(Collectors.toList());\n            loanAccountList.addAll(accountList);\n        });\n        logger.info(\"获取公司间借款计提分录数据,入参:{};返回数量:{}\", StringUtils.join(eventIds.toArray(), \",\"), loanAccountList.size());\n\n        fndFlexValueApi.translate(loanAccountList,\n                \"segment1\", BizConstants.FndFlexSet.BD_COMPANY,\n                \"segment2\", BizConstants.FndFlexSet.BD_DEPARTMENT,\n                \"segment3\", BizConstants.FndFlexSet.BD_ACCOUNT,\n                \"segment4\", BizConstants.FndFlexSet.BD_PRODUCT,\n                \"segment5\", BizConstants.FndFlexSet.BD_INTERCOMPANY,\n                \"segment6\", BizConstants.FndFlexSet.BD_PROJECT,\n                \"segment7\", BizConstants.FndFlexSet.BD_SPARE1,\n                \"segment8\", BizConstants.FndFlexSet.BD_SPARE2,\n                \"eventType\", BizConstants.FndFlexSet.TMS_DEAL_ACCEVENTTYPE);\n        Map<String, String> trxTypeCodeAndNamePairs = transactionTypeService.getCodeAndNamePairs();\n        FndFlexValue fndFlexValue = new FndFlexValue();\n        fndFlexValue.setFlexValueSetName(BizConstants.FndFlexSet.TMS_CURRENCY);\n        List<FndFlexValue> flexValueList = fndFlexValueDAO.selectByConditionSetVague(fndFlexValue);\n        // 翻译交易类型&设置币种精度\n        loanAccountList.forEach(la -> {