ull(account.getEntered())) {\n                    account.setEntered(account.getEntered().negate());\n                }\n                if (account.getDirection().equals(LoanConstants.LOAN_GL_DIRECTION_CR)) {\n                    account.setAccountedCr(account.getAccounted());\n                }\n                if (account.getDirection().equals(LoanConstants.LOAN_GL_DIRECTION_DR)) {\n                    account.setAccountedDr(account.getAccounted());\n                }\n                account.setSegment1(valueDTO.getAttribute2());\n                if (account.getExchangeRate() != null) {\n                    account.setExchangeRateStr(account.getExchangeRate().stripTrailingZeros().toString());\n                }\n                account.setAttribute4(IFRS);\n            }\n            las.addAll(loanAccountsByfairId);\n            // 3、借方\n            LoanAccount debit = this.getIfrsFairvalueAccounts(rule, LoanConstants.LOAN_GL_DIRECTION_DR, accountingDate);\n            las.add(debit);\n\n            // 4、贷方\n            LoanAccount credit =\n                    this.getIfrsFairvalueAccounts(rule, LoanConstants.LOAN_GL_DIRECTION_CR, accountingDate);\n            las.add(credit);\n        }\n        return las;\n    }\n\n    /**\n     * 公司间借款--计提利息--获取分录明细数据：1-根据ID 组装公司间借款计提利息记账用数据\n     *\n     * @param accrualId\n     * @return\n     */\n    private List<LoanAccount> assembleCompanyAccrualAccount(Long accrualId) {\n        List<LoanAccount> las = new ArrayList<>();\n        // 1、先根据计提id查询分录明细中是否已存在明细数据\n        List<LoanAccount> saved = getSavedAccouts(null, Arrays.asList(INTERCOMPANY_INTEREST_ACCRUAL,\n                BUSINESS_TYPE_INTERCOMPANY), accrualId);\n        if (CollectionUtils.isNotEmpty(saved)) {\n            las.addAll(saved);\n        } else {\n            // 2、实时获取计提数据与记账规则数据，拼接借方、贷方、税额分录\n            List<LoanAccount> rules = loanAccountDao.getCompanyAccrualAccounts(accrualId);\n            if (CollectionUtils.isEmpty(rules)) {\n                