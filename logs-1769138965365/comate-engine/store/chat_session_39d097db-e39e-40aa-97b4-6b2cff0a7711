      "content": "package com.baidu.pmc.bankcommon.core.utils;\n\nimport com.alibaba.fastjson.JSON;\nimport com.baidu.pmc.bankcommon.core.dto.BankcommonReceiptDTO;\nimport com.baidu.pmc.bankcommon.persistence.dao.ReceiptTransactionsRefMapper;\nimport com.baidu.pmc.bankcommon.persistence.domain.ReceiptTransactionsRef;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidubce.Protocol;\nimport com.baidubce.auth.DefaultBceCredentials;\nimport com.baidubce.services.bos.BosClient;\nimport com.baidubce.services.bos.BosClientConfiguration;\nimport com.baidubce.services.bos.model.ObjectMetadata;\nimport com.baidubce.services.bos.model.PutObjectRequest;\nimport com.baidubce.services.bos.model.PutObjectResponse;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.codec.binary.Base64;\nimport org.apache.commons.collections.CollectionUtils;\nimport org.apache.pdfbox.pdmodel.PDDocument;\nimport org.apache.pdfbox.rendering.PDFRenderer;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.beans.factory.annotation.Value;\nimport org.springframework.stereotype.Component;\n\nimport javax.imageio.ImageIO;\nimport java.awt.image.BufferedImage;\nimport java.io.BufferedInputStream;\nimport java.io.BufferedOutputStream;\nimport java.io.ByteArrayInputStream;\nimport java.io.ByteArrayOutputStream;\nimport java.io.File;\nimport java.io.FileInputStream;\nimport java.io.FileOutputStream;\nimport java.io.IOException;\nimport java.io.InputStream;\nimport java.io.OutputStream;\nimport java.math.BigDecimal;\nimport java.text.ParseException;\nimport java.util.Date;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Objects;\nimport java.util.zip.ZipEntry;\nimport java.util.zip.ZipOutputStream;\n\n@Slf4j\n@Component\npublic class ReceiptUtils {\n\n    public static final String SUFFIX_PDF = \".pdf\";\n    public static final String SUFFIX_JPG = \".jpg\";\n    public static final String TYPE_PNG = \"png\";\n    /**\n     * 文件暂存路径\n     */\n    @Value(\"${pmc.bankcommon.attachment.dir.diskPath}\")\n    public String filePath;\n    /**\n     * 用户的Access Key ID\n     */\n    @Value(\"${BOS.ACCESS_KEY_ID}\")\n    private String accessKeyId;\n    /**\n     * 用户的Secret Access Key\n     */\n    @Value(\"${BOS.SECRET_ACCESS_KEY}\")\n    private String secretAccessKey;\n    /**\n     * 指定的域名\n     */\n    @Value(\"${BOS.ENDPOINT}\")\n    private String endpoint;\n    /**\n     * 指bucketname\n     */\n    @Value(\"${BOS.BUCKET_NAME}\")\n    private String bucketName;\n    @Autowired\n    private ReceiptTransactionsRefMapper receiptTransactionsRefMapper;\n\n    /**\n     * 处理回单文件\n     *\n     * @return\n     */\n    public void dealReceiptFile(BankcommonReceiptDTO bankcommonReceiptDTO, Map<String, Object> dto) {\n        String content = bankcommonReceiptDTO.getFileContent();\n        // 回单文件名为空，采用回单编号+.pdf作为文件名\n        if (StringUtils.isBlank(bankcommonReceiptDTO.getFileName())) {\n            bankcommonReceiptDTO.setFileName(bankcommonReceiptDTO.getBrseqNo() + SUFFIX_PDF);\n        }\n        BufferedOutputStream os = null;\n        String path = null;\n        try {\n\n            // 回单文件流水号校验\n            path = filePath + bankcommonReceiptDTO.getFileName();\n            // 保存回单文件\n            byte[] bytes = Base64.decodeBase64(content);\n            os = new BufferedOutputStream(new FileOutputStream(new File(path)));\n            os.write(bytes);\n            os.flush();\n        } catch (Exception e) {\n            log.error(\"dealReceiptFile 文件保存错误\");\n        } finally {\n            try {\n                if (os != null) {\n                    os.close();\n                }\n            } catch (IOException e) {\n                log.error(\"dealReceiptFile 文件输出流关闭异常\", e);\n            }\n        }\n        // 回单文件转换为jpg\n        try {\n            File file = new File(filePath + bankcommonReceiptDTO.getFileName());\n            String fileName = this.convertPdfToJpg(file);\n            log.info(\"文件名称 fileName={}\", fileName);\n            if (StringUtils.isNotBlank(fileName)) {\n                File jpgFile = new File(filePath + fileName);\n                ReceiptTransactionsRef refDto = this.uploadAndSaveReceipt(jpgFile, bankcommonReceiptDTO);\n                if (StringUtils.isNotBlank(refDto.getEtag())) {\n                    boolean delete = jpgFile.delete();\n                    if (delete) {\n                        log.info(\"jpg file delete success\");\n                    }\n                }\n            }\n        } catch (Exception e) {\n            log.error(\"dealReceiptFile 电子回单转换失败，receipt:{}\", JSON.toJSONString(bankcommonReceiptDTO), e);\n        }\n    }\n\n    /**\n     * 压缩文件\n     *\n     * @param fileByte\n     * @param fileName\n     * @param zipOut\n     * @throws IOException\n     */\n    public void fileToZip(byte[] fileByte, String fileName, ZipOutputStream zipOut) throws IOException {\n        // 需要压缩的文件\n        // 获取文件名称,如果有特殊命名需求,可以将参数列表拓展,传fileName\n        ByteArrayInputStream byteArrayInputStream = new ByteArrayInputStream(fileByte);\n        // 缓冲\n        byte[] bufferArea = new byte[1024 * 10];\n        BufferedInputStream bufferStream = new BufferedInputStream(byteArrayInputStream, 1024 * 10);\n        // 将当前文件作为一个zip实体写入压缩流,fileName代表压缩文件中的文件名称\n        zipOut.putNextEntry(new ZipEntry(fileName));\n        int length = 0;\n        // 最常规IO操作,不必紧张\n        while ((length = bufferStream.read(bufferArea, 0, 1024 * 10)) != -1) {\n            zipOut.write(bufferArea, 0, length);\n        }\n        // 关闭流\n        byteArrayInputStream.close();\n        // 需要注意的是缓冲流必须要关闭流,否则输出无效\n        bufferStream.close();\n        // 压缩流不必关闭,使用完后再关\n    }\n\n\n    /**\n     * pdf转图片 -- 一张\n     */\n    public String convertPdfToJpg(File file) {\n        // 解压后pdf转jpg\n        InputStream is = null;\n        PDDocument doc = null;\n        ByteArrayOutputStream os = null;\n        OutputStream out = null;\n        String fileName = null;\n        try {\n            is = new FileInputStream(file);\n            doc = PDDocument.load(file);\n            // pdf文件大于1页,不转换图片，直接返回pdf上传\n            if (doc.getNumberOfPages() > 1) {\n                return file.getName();\n            }\n            // 调整页面位置大小  调试数据\n            PDFRenderer pdfRenderer = new PDFRenderer(doc);\n            BufferedImage bim = pdfRenderer.renderImageWithDPI(0, 200);\n            os = new ByteArrayOutputStream();\n            ImageIO.write(bim, TYPE_PNG, os);\n            byte[] imgBytes = os.toByteArray();\n            // jpg文件转出路径\n            fileName = file.getName().replace(SUFFIX_PDF, SUFFIX_JPG);\n            out = new FileOutputStream(filePath + fileName);\n            out.write(imgBytes);\n            // 删除pdf\n            boolean delete = file.delete();\n            if (delete) {\n                log.info(\"downloadFile pdf file delete success\");\n            }\n        } catch (IOException e) {\n            log.error(\"图片转换错误\", e);\n        } finally {\n            if (is != null) {\n                try {\n                    is.close();\n                } catch (IOException e) {\n                    log.error(\"InputStream close error\", e);\n                }\n            }\n            if (doc != null) {\n                try {\n                    doc.close();\n                } catch (IOException e) {\n                    log.error(\"PDDocument close error\", e);\n                }\n            }\n            if (os != null) {\n                try {\n                    os.close();\n                } catch (IOException e) {\n                    log.error(\"ByteArrayOutputStream close error\", e);\n                }\n            }\n            if (out != null) {\n                try {\n                    out.close();\n                } catch (IOException e) {\n                    log.error(\"OutputStream close error\", e);\n                }\n            }\n        }\n        return fileName;\n    }\n\n    /**\n     * 电子回单上传到bos并保存关联关系\n     */\n    public ReceiptTransactionsRef uploadAndSaveReceipt(File file, BankcommonReceiptDTO receiptDTO) throws ParseException {\n        if (Objects.isNull(file)) {\n            return new ReceiptTransactionsRef();\n        }\n        Date printDate = DateUtils.parseDate(StringUtils.toString(receiptDTO.getTranDate()), \"yyyyMMdd\");\n        String refnbr = StringUtils.toString(receiptDTO.getSerialNumber());\n        String printNumber = StringUtils.toString(receiptDTO.getBrseqNo());\n        BigDecimal amt = new BigDecimal(receiptDTO.getTranAmt());\n        String payeeAccount = StringUtils.toString(receiptDTO.getPayeeAccNo());\n        // 设置初始值\n        ReceiptTransactionsRef transactionsRef = new ReceiptTransactionsRef();\n        transactionsRef.setFileName(file.getName());\n        transactionsRef.setAccountNo(receiptDTO.getAccount());\n        transactionsRef.setPrintDateBegin(printDate);\n        transactionsRef.setPrintDateEnd(printDate);\n        transactionsRef.setPrintNumber(printNumber);\n        transactionsRef.setBank(receiptDTO.getBank());\n        transactionsRef.setRefnbr(refnbr);\n        transactionsRef.setAmount(amt);\n        transactionsRef.setPayeeAccount(payeeAccount);\n\n        // 先获取校验重复\n        ReceiptTransactionsRef ref = new ReceiptTransactionsRef();\n        ref.setBank(transactionsRef.getBank());\n        ref.setPrintNumber(transactionsRef.getPrintNumber());\n        List<ReceiptTransactionsRef> old = receiptTransactionsRefMapper.select(ref);\n        if (CollectionUtils.isNotEmpty(old)) {\n            log.info(\"重复的回单关联关系数据\");\n            transactionsRef.setEtag(old.get(0).getEtag());\n            transactionsRef.setBucketName(old.get(0).getBucketName());\n            return transactionsRef;\n        }\n        // 读文件\n        InputStream inputStream = null;\n        String etag = null;\n        try {\n            inputStream = new FileInputStream(file);\n            etag = this.uploadFile(inputStream, printNumber);\n        } catch (Exception e) {\n            log.error(\"receipt file upload bos error\", e);\n        } finally {\n            if (inputStream != null) {\n                try {\n                    inputStream.close();\n                } catch (IOException e) {\n                    log.error(\"输入流关闭异常\", e);\n                }\n            }\n        }\n        transactionsRef.setBucketName(bucketName);\n        transactionsRef.setEtag(etag);\n        if (StringUtils.isBlank(etag)) {\n            // 上传失败了\n            log.info(\"bos 上传文件失败了\");\n            return transactionsRef;\n        }\n        // 增量入库\n        transactionsRef.setCreateDate(new Date());\n        receiptTransactionsRefMapper.insert(transactionsRef);\n        return transactionsRef;\n    }\n\n    public String uploadFile(InputStream inputStream, String printInstanceNumber) {\n        log.info(\"*****BOS文件开始上传********\");\n        // 初始化一个BosClient\n        BosClientConfiguration config = new BosClientConfiguration();\n        config.setCredentials(new DefaultBceCredentials(accessKeyId, secretAccessKey));\n        config.setEndpoint(endpoint);\n        config.setProtocol(Protocol.HTTPS); // 如果不指明, 则使用http\n        BosClient client = new BosClient(config);\n\n        // 初始化上传输入流\n        ObjectMetadata meta = new ObjectMetadata();\n        // 设置ContentType\n        meta.setContentType(\"image/jpg\");\n\n        PutObjectRequest request = new PutObjectRequest(bucketName, printInstanceNumber, inputStream, meta);\n        // 以数据流形式上传Object\n        PutObjectResponse putObjectResponseFromInputStream = client.putObject(request);\n\n        String etag = putObjectResponseFromInputStream.getETag();\n        if (StringUtils.isNotBlank(etag)) {\n            log.info(\"*****BOS文件上传成功******** etag={}\", etag);\n        } else {\n            log.info(\"*****BOS文件上传失败********\");\n        }\n        return etag;\n    }\n\n}\n",
