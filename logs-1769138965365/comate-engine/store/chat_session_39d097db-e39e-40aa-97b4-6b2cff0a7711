      "content": "package com.baidu.pmc.bankcommon.persistence.domain;\n\nimport lombok.Data;\n\nimport javax.persistence.Column;\nimport javax.persistence.Id;\nimport javax.persistence.Table;\nimport java.math.BigDecimal;\nimport java.util.Date;\n\n@Data\n@Table(name = \"pmc_bankcommon_pay_instruct_his\")\npublic class BankcommonPayInstructHis {\n    /**\n     * 主键\n     */\n    @Id\n    @Column(name = \"pay_his_id\")\n    private Long payHisId;\n\n    /**\n     * 指令表id\n     */\n    @Column(name = \"pay_id\")\n    private Long payId;\n\n    /**\n     * 付款单id\n     */\n    @Column(name = \"check_id\")\n    private Long checkId;\n\n    /**\n     * 付款清单号\n     */\n    @Column(name = \"pay_check_num\")\n    private String payCheckNum;\n\n    /**\n     * 租户id\n     */\n    @Column(name = \"tenant_id\")\n    private Long tenantId;\n\n    /**\n     * 公司代码(付款户)\n     */\n    @Column(name = \"company_code\")\n    private String companyCode;\n\n    /**\n     * 付款时间\n     */\n    @Column(name = \"pay_date\")\n    private Date payDate;\n\n    /**\n     * 银行代码\n     */\n    @Column(name = \"bank_code\")\n    private String bankCode;\n\n    /**\n     * 银行账户id\n     */\n    @Column(name = \"ac_account_id\")\n    private Long acAccountId;\n\n    /**\n     * 银行账户\n     */\n    private String account;\n\n    /**\n     * 账户所在省市代码\n     */\n    @Column(name = \"account_prov\")\n    private String accountProv;\n\n    /**\n     * 付款指令请求流水号\n     */\n    @Column(name = \"client_id\")\n    private String clientId;\n\n    /**\n     * 网银交易流水号\n     */\n    private String obssid;\n\n    /**\n     * 金额\n     */\n    private BigDecimal amount;\n\n    /**\n     * 付款金额币种\n     */\n    @Column(name = \"amount_currency\")\n    private String amountCurrency;\n\n    /**\n     * 业务参考号\n     */\n    @Column(name = \"reference_number\")\n    private String referenceNumber;\n\n    /**\n     * 用途\n     */\n    private String remark;\n\n    /**\n     * ֧摘要\n     */\n    private String naryur;\n\n    /**\