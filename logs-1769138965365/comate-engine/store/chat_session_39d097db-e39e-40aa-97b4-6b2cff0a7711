      "absolutePath": "/Users/xiaoliu/baidu/bpit-proc-apps/pmc/pmc-basic-bankcommon/src/main/java/com/baidu/pmc/bankcommon/core/service/bcm/impl/BankBcmReceiptServiceImpl.java",
      "content": "package com.baidu.pmc.bankcommon.core.service.bcm.impl;\n\n\nimport com.alibaba.fastjson.JSON;\nimport com.baidu.pmc.bankcommon.core.constants.Constants;\nimport com.baidu.pmc.bankcommon.core.dto.BankcommonReceiptDTO;\nimport com.baidu.pmc.bankcommon.core.dto.ResponseHeaderDTO;\nimport com.baidu.pmc.bankcommon.core.service.AccountService;\nimport com.baidu.pmc.bankcommon.core.service.BankcommonService;\nimport com.baidu.pmc.bankcommon.core.service.bcm.BankBcmReceiptService;\nimport com.baidu.pmc.bankcommon.core.service.bcm.BankBcmService;\nimport com.baidu.pmc.bankcommon.core.utils.DateTool;\nimport com.baidu.pmc.bankcommon.core.utils.MessageBuilder;\nimport com.baidu.pmc.bankcommon.core.utils.ReceiptUtils;\nimport com.baidu.pmc.bankcommon.core.utils.ResponseXmlParser;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.pojo.dto.cmb.TransInfo;\nimport com.baidu.pmc.pojo.model.PmcAccount;\nimport com.baidu.pmc.pojo.model.cmb.PayQO;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections.CollectionUtils;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\n\nimport java.util.ArrayList;\nimport java.util.Date;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\n@Slf4j\n@Service\npublic class BankBcmReceiptServiceImpl implements BankBcmReceiptService {\n\n    @Autowired\n    private AccountService accountService;\n\n    @Autowired\n    private BankcommonService bankcommonService;\n\n    @Autowired\n    private ReceiptUtils receiptUtils;\n\n    @Autowired\n    private MessageBuilder messageBuilder;\n\n    @Autowired\n    private ResponseXmlParser responseXmlParser;\n\n    @Autowired\n    private BankBcmService bankBcmService;\n\n    /**\n     * 通用电子回单获取，适用于以下场合\n     * 1.回单基于流水查询，回单和流水一一对应\n     * 2.回单是文件流接口\n     * @param payQO\n     * @param extentionParams\n     * @return\n     */\n    @Override\n    public String selectElectReceipt(PayQO payQO, Map<String, String> extentionParams) {\n        String bankCode = payQO.getBank();\n        log.info(\"电子回单任务开始 param={}\", JSON.toJSONString(payQO));\n        // 获取银行启用银企直联账户\n        List<PmcAccount> pmcAccounts = accountService.queryBankcommonAccount(payQO);\n        if (CollectionUtils.isEmpty(pmcAccounts)) {\n            log.info(\"没有启用中的银行账户\");\n            return \"没有启用中的银行账户\";\n        }\n        log.info(\"待查询的银行账户数量 size={}\", pmcAccounts.size());\n\n        // 日期设置\n        List<String> dateList = new ArrayList<>();\n        if (payQO.getStartDate() != null && payQO.getEndDate() != null) {\n            dateList.addAll(DateUtils.dateBetweenDay(payQO.getStartDate(), payQO.getEndDate(),\n                    DateTool.DAY_PARTTEN_YYYYMMDD));\n        } else {\n            dateList.add(DateUtils.formatDate(DateUtils.addDays(new Date(), -2),\n                    DateTool.DAY_PARTTEN_YYYYMMDD));\n            dateList.add(DateUtils.formatDate(DateUtils.yesterday(), DateTool.DAY_PARTTEN_YYYYMMDD));\n        }\n\n        if (CollectionUtils.isEmpty(dateList)) {\n            log.info(\"没有符合的回单拉取时间段\");\n            return \"时间段不符合要求\";\n        }\n        // 回单按照日期查询，返回所有账户的回单\n        for (PmcAccount account : pmcAccounts) {\n            for (String date : dateList) {\n                try {\n\n                    log.info(\"selectElectReceipt 查询回单任务, date={}, accountNo={}\", date, account.getAccountNo());\n                    PayQO payQOTransInfo = new PayQO();\n                    payQOTransInfo.setBank(bankCode);\n                    payQOTransInfo.setAccount(account.getAccountNo());\n                    payQOTransInfo.setStartDate(DateUtils.parseDate(date, DateTool.DAY_PARTTEN_YYYYMMDD));\n                    payQOTransInfo.setEndDate(DateUtils.parseDate(date, DateTool.DAY_PARTTEN_YYYYMMDD));\n                    List<TransInfo> transInfos = bankBcmService.selectBankcommonTrans(payQOTransInfo, extentionParams);\n                    // 基于流水查询回单\n                    for (TransInfo transInfo : transInfos) {\n                        HashMap<String, Object> dto = new HashMap<>();\n                        dto.put(\"account\", account.getAccountNo());\n                        dto.put(\"serialNumber\", transInfo.getSerialNumber());\n                        dto.put(\"transDate\", date);\n                        dto.put(\"bankCode\", bankCode);\n                        dto.put(\"processInstanceNumber\", transInfo.getProcessInstanceNumber());\n                        ResponseHeaderDTO fileDto = this.getElectReceiptFile(dto, extentionParams);\n                        if (fileDto != null && fileDto.getBody() != null) {\n                            BankcommonReceiptDTO receipt = fileDto.getBody().getReceipt();\n                            if (receipt != null) {\n                                // 文件处理\n                                receipt.setBank(bankCode);\n                                receipt.setAccount(account.getAccountNo());\n                                receipt.setPayeeAccNo(transInfo.getAccount());\n                                receipt.setSerialNumber(transInfo.getSerialNumber());\n                                receipt.setTranDate(date);\n                                receipt.setTranAmt(transInfo.getTransAmount());\n                                receiptUtils.dealReceiptFile(receipt, dto);\n                            }\n                        }\n                    }\n\n\n                } catch (Exception e) {\n                    log.error(\"selectElectReceiptError\", e);\n                }\n            }\n        }\n        log.info(\"回单拉取任务执行完成\");\n        return \"执行成功\";\n    }\n\n    /**\n     * 获取回单文件\n     *\n     * @param dto\n     * @return\n     */\n    public ResponseHeaderDTO getElectReceiptFile(Map<String, Object> dto, Map<String, String> extentionParams) {\n        dto.put(\"funName\", Constants.BankcommonTranscodeEnum.ELECT_RECEIPT_QEURY);\n        String request = messageBuilder.queryElectReceiptQueryMessage(dto, extentionParams);\n        // 发送银行前置机\n        String[] ipArr = new String[1];\n        String response = bankcommonService.postBank(request, dto, StringUtils.toString(dto.get(\"bankCode\")));\n        if (Constants.NO_ENABLED_MACHINE.equals(response)) {\n            log.error(\"回单下载时 无可用前置机异常, accountNo={}\", StringUtils.toString(dto.get(\"account\")));\n            return null;\n        } else if (Constants.BANK_POST_EXCEPTION.equals(response)) {\n            log.error(\"回单下载请求异常, accountNo={}\", StringUtils.toString(dto.get(\"account\")));\n            return null;\n        }\n        ResponseHeaderDTO responseHeaderDto =\n                responseXmlParser.parseResponseXml(response, dto);\n        log.info(\"getElectReceiptFile 处理银行请求结果 resDto={}\", JSON.toJSONString(responseHeaderDto));\n        if (responseHeaderDto == null\n                || responseHeaderDto.getHeader() == null || !Constants.RESPONSE_SUCCESS.equals(responseHeaderDto.getHeader().getStatus())\n                || responseHeaderDto.getBody() == null || !Constants.RESPONSE_SUCCESS.equals(responseHeaderDto.getBody().getStatus())) {\n            log.error(\"getElectReceiptFile 银行报文解析发生错误\");\n            return null;\n        }\n        return responseHeaderDto;\n    }\n}\n",
