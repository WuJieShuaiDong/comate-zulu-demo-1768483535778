                "basename": "RedisLock.java",
                "originalContent": "package com.baidu.p2p.core.utils.lock;\n\nimport com.baidu.p2p.core.j2ee.context.Config;\nimport com.baidu.p2p.core.j2ee.context.SpringContextHolder;\nimport com.baidu.p2p.core.j2ee.exception.LockException;\nimport com.baidu.p2p.core.utils.StrUtils;\nimport com.baidu.p2p.system.config.ConfigConstants;\nimport org.apache.logging.log4j.LogManager;\nimport org.apache.logging.log4j.Logger;\nimport redis.clients.jedis.Jedis;\nimport redis.clients.jedis.JedisPool;\nimport redis.clients.jedis.Transaction;\nimport redis.clients.jedis.exceptions.JedisException;\n\nimport java.util.List;\nimport java.util.Random;\nimport java.util.UUID;\n\n/**\n * Jedis实现分布式锁\n * \n * @author v_zoupengfei\n *\n */\npublic class RedisLock implements ILock{\n    private final Logger log = LogManager.getLogger(RedisLock.class);\n\n    private   JedisPool jedisPool;\n    private   Jedis redis;\n    private   String LOCK_KEY_PRE =\n            Config.get(ConfigConstants.REDIS_KEY_PREFIX).toUpperCase() + Config.get(ConfigConstants.APPLICATION_PROFILE)\n                    .toUpperCase()+\"_REDIS_LOCK:\";\n    private String lockName; // 竞争获取锁key\n    private long acquireTimeoutInMS; // 获取锁超时时间\n    private long lockTimeoutInMS; //  锁的超时时间\n    private String identifier; //   锁标识\n    private boolean returnFlag = false;\n    private boolean waitGet = false;\n\n    public RedisLock(String lockName, long acquireTimeoutInMS,long lockTimeoutInMS) {\n        this.lockName=lockName;\n        this.acquireTimeoutInMS=acquireTimeoutInMS;\n        this.lockTimeoutInMS=lockTimeoutInMS;\n        this.jedisPool =  SpringContextHolder.getBean(\"jedisPool\", JedisPool.class);\n        this.redis = getJedis();\n    }\n    private Jedis getJedis(){\n        Jedis redis = null;\n        int tryTimes=0;\n        log.info(\"Start get redis.\");\n        while(tryTimes++ < 5) {\n            try {\n                redis = jedisPool.getResource();\n                if(redis!=null){\n                    log.info(\"Get redis success.\");\n                    return redis;\n                }\n                log.info(\"Wait 10ms to get redis {}.\");\n                // 短暂休眠，避免出现活锁\n                Thread.sleep(3, new Random().nextInt(500));\n            } catch (Exception e) {\n                returnRedis(redis);\n                log.info(\" Can't get redis ,times{}\",tryTimes);\n                e.printStackTrace();\n                throw new LockException(\"Get redis {} error.\",lockName);\n            }\n\n        }\n\n        if(redis==null){\n            log.info(\"Cant't redis error.\");\n            throw new LockException(\"Can't get redis {}.\",lockName);\n        }\n        return redis;\n    }\n\n    /**\n     * 回收redis资源\n     * @param redis\n     */\n    private  void returnRedis(Jedis redis){\n        if (!returnFlag && redis != null) {\n            try {\n                if(redis.isConnected()){\n                    redis.close();\n                }\n                returnFlag = true;\n            } catch (Exception e) {\n                e.printStackTrace();\n                log.error(\"The lock {} return reids.\",lockName);\n            }\n            this.redis = null;\n        }\n    }\n    /**\n     * 获取分布式锁\n     */\n    public void acquirLock() throws LockException{\n        try {\n\n            String _identifier = UUID.randomUUID().toString();\n            String lockKey = LOCK_KEY_PRE + lockName;\n            int lockExpire = (int) (lockTimeoutInMS / 1000);\n\n            long end = System.currentTimeMillis() + acquireTimeoutInMS;\n            log.info(\"Start get lock {}.\",lockName);\n            while (System.currentTimeMillis() < end) {\n                if (redis.setnx(lockKey, _identifier) == 1) {\n                    log.info(\"Get lock {} success:{}.\",lockName,_identifier);\n                    redis.expire(lockKey, lockExpire);\n                    this.identifier = _identifier;\n                    if (redis.ttl(lockKey) == -1) {\n                        redis.expire(lockKey, lockExpire);\n                    }\n                    break;\n                }\n\n                log.info(\"Continue get lock {}.\",lockName);\n\n                // 短暂休眠，避免出现活锁\n                Thread.sleep(3, new Random().nextInt(500));\n            }\n\n            if(StrUtils.isEmpty(this.identifier)){\n                log.error(\"Can't get lock {}.\",lockName);\n                throw new LockException(\"Get lock {} error.\",lockName);\n            }\n\n        } catch (Exception je) {\n            if(!waitGet){\n                returnRedis(redis);\n            }\n            je.printStackTrace();\n            log.error(\"Get lock {} error.\",lockName,je);\n            if(je instanceof LockException){\n                throw (LockException)je;\n            }else{\n                throw new LockException(je);\n            }\n        }\n    }\n\n    @Override\n    public void acquirLockWait()  throws LockException{\n        waitGet = true;\n        try {\n             int tryTimes = 0;\n             while(tryTimes++ < 5){\n                 log.info(\"Try get lock {},times {}.\",lockName,tryTimes);\n\n                 try {\n                     acquirLock();\n                 } catch (LockException e) {\n                     log.info(\"This times can't get lock {} , next...\",lockName);\n                     continue;\n                 }\n\n                 if(StrUtils.isNotEmpty(this.identifier)){\n                     log.info(\"Try get lock {} success,times {}.\",lockName,tryTimes);\n                     break;\n                 }\n                 log.info(\"Wait try get lock {}.\",lockName);\n                 // 短暂休眠，避免出现活锁\n                  Thread.sleep(3, new Random().nextInt(500));\n\n             }\n            if(StrUtils.isEmpty(this.identifier)){\n                log.error(\"Try can't get lock {}.\",lockName);\n                throw new LockException(\"Try and get lock {} error.\",lockName);\n            }\n        }catch (Exception e){\n            returnRedis(redis);\n            log.error(\"Try get lock {} error.\",lockName);\n            if( e instanceof LockException){\n                throw (LockException)e;\n            }else{\n                throw new LockException(\"Try get lock  error\",e);\n            }\n        }\n\n    }\n\n    /**\n     * 释放锁\n     * @return\n     */\n    public void releaseLock()  throws LockException{\n        String lockKey = LOCK_KEY_PRE + lockName;\n        if (this.redis == null) {\n            return;\n        }\n        try {\n            log.info(\"Start release lock {}.\",lockName);\n            while (true) {\n                this.redis.watch(lockKey);\n                if (StrUtils.isNotEmpty(this.identifier) && this.identifier.equals(this.redis.get(lockKey))) {\n                    Transaction trans = this.redis.multi();\n                    trans.del(lockKey);\n                    List<Object> results = trans.exec();\n                    if (results == null) {\n                        continue;\n                    }\n                }\n                this.redis.unwatch();\n\n                log.info(\"Release lock {} success.\",lockName);\n                break;\n            }\n\n        } catch (JedisException je) {\n            je.printStackTrace();\n            log.error(\"Release lock {} error.\",lockName,je);\n           // throw new LockException(je);\n        } finally {\n            returnRedis(redis);\n            log.error(\"End release lock {}.\",lockName);\n        }\n    }\n\n\n}",
                "content": "package com.baidu.p2p.core.utils.lock;\n\nimport com.baidu.p2p.core.j2ee.context.Config;\nimport com.baidu.p2p.core.j2ee.context.SpringContextHolder;\nimport com.baidu.p2p.core.j2ee.exception.LockException;\nimport com.baidu.p2p.core.utils.StrUtils;\nimport com.baidu.p2p.system.config.ConfigConstants;\nimport org.apache.logging.log4j.LogManager;\nimport org.apache.logging.log4j.Logger;\nimport redis.clients.jedis.Jedis;\nimport redis.clients.jedis.JedisPool;\nimport redis.clients.jedis.Transaction;\nimport redis.clients.jedis.exceptions.JedisException;\n\nimport java.util.List;\nimport java.util.Random;\nimport java.util.UUID;\n\n/**\n * Jedis实现分布式锁\n * \n * @author v_zoupengfei\n *\n */\npublic class RedisLock implements ILock{\n    private final Logger log = LogManager.getLogger(RedisLock.class);\n\n    private   JedisPool jedisPool;\n    private   Jedis redis;\n    private   String LOCK_KEY_PRE =\n            Config.get(ConfigConstants.REDIS_KEY_PREFIX).toUpperCase() + Config.get(ConfigConstants.APPLICATION_PROFILE)\n                    .toUpperCase()+\"_REDIS_LOCK:\";\n    private String lockName; // 竞争获取锁key\n    private long acquireTimeoutInMS; // 获取锁超时时间\n    private long lockTimeoutInMS; //  锁的超时时间\n    private String identifier; //   锁标识\n    private boolean returnFlag = false;\n    private boolean waitGet = false;\n\n    public RedisLock(String lockName, long acquireTimeoutInMS,long lockTimeoutInMS) {\n        this.lockName=lockName;\n        this.acquireTimeoutInMS=Math.max(acquireTimeoutInMS, 5000L); // 最小5秒超时\n        this.lockTimeoutInMS=lockTimeoutInMS;\n        this.jedisPool =  SpringContextHolder.getBean(\"jedisPool\", JedisPool.class);\n        this.redis = getJedis();\n    }\n    private Jedis getJedis(){\n        Jedis redis = null;\n        int tryTimes=0;\n        log.info(\"Start get redis for lock: {}\", lockName);\n        while(tryTimes++ < 5) {\n            try {\n                redis = jedisPool.getResource();\n                if(redis!=null){\n                    // 连接测试，确保连接可用\n                    redis.ping();\n                    log.info(\"Get redis success for lock: {}\", lockName);\n                    return redis;\n                }\n                log.info(\"Wait to get redis for lock: {}, times: {}\", lockName, tryTimes);\n                // 短暂休眠，避免出现活锁\n                Thread.sleep(3, new Random().nextInt(500));\n            } catch (Exception e) {\n                returnRedis(redis);\n                log.error(\"Can't get redis for lock: {}, times: {}, error: {}\", lockName, tryTimes, e.getMessage());\n                if(tryTimes >= 5) {\n                    log.error(\"Failed to get redis connection after {} attempts for lock: {}\", tryTimes, lockName);\n                    throw new LockException(\"Get redis connection failed after {} attempts for lock: {}\", tryTimes, lockName);\n                }\n            }\n        }\n\n        log.error(\"Cannot get redis connection after maximum retries for lock: {}\", lockName);\n        throw new LockException(\"Cannot get redis connection for lock: {}\", lockName);\n    }\n\n    /**\n     * 回收redis资源\n     * @param redis\n     */\n    private  void returnRedis(Jedis redis){\n        if (!returnFlag && redis != null) {\n            try {\n                if(redis.isConnected()){\n                    redis.close();\n                }\n                returnFlag = true;\n            } catch (Exception e) {\n                e.printStackTrace();\n                log.error(\"The lock {} return reids.\",lockName);\n            }\n            this.redis = null;\n        }\n    }\n    /**\n     * 获取分布式锁\n     */\n    public void acquirLock() throws LockException{\n        try {\n\n            String _identifier = UUID.randomUUID().toString();\n            String lockKey = LOCK_KEY_PRE + lockName;\n            int lockExpire = (int) (lockTimeoutInMS / 1000);\n\n            long end = System.currentTimeMillis() + acquireTimeoutInMS;\n            log.info(\"Start get lock {}.\",lockName);\n            while (System.currentTimeMillis() < end) {\n                if (redis.setnx(lockKey, _identifier) == 1) {\n                    log.info(\"Get lock {} success:{}.\",lockName,_identifier);\n                    redis.expire(lockKey, lockExpire);\n                    this.identifier = _identifier;\n                    if (redis.ttl(lockKey) == -1) {\n                        redis.expire(lockKey, lockExpire);\n                    }\n                    break;\n                }\n\n                log.info(\"Continue get lock {}.\",lockName);\n\n                // 短暂休眠，避免出现活锁\n                Thread.sleep(3, new Random().nextInt(500));\n            }\n\n            if(StrUtils.isEmpty(this.identifier)){\n                log.error(\"Can't get lock {}.\",lockName);\n                throw new LockException(\"Get lock {} error.\",lockName);\n            }\n\n        } catch (Exception je) {\n            if(!waitGet){\n                returnRedis(redis);\n            }\n            je.printStackTrace();\n            log.error(\"Get lock {} error.\",lockName,je);\n            if(je instanceof LockException){\n                throw (LockException)je;\n            }else{\n                throw new LockException(je);\n            }\n        }\n    }\n\n    @Override\n    public void acquirLockWait()  throws LockException{\n        waitGet = true;\n        try {\n             int tryTimes = 0;\n             while(tryTimes++ < 5){\n                 log.info(\"Try get lock {},times {}.\",lockName,tryTimes);\n\n                 try {\n                     acquirLock();\n                 } catch (LockException e) {\n                     log.info(\"This times can't get lock {} , next...\",lockName);\n                     continue;\n                 }\n\n                 if(StrUtils.isNotEmpty(this.identifier)){\n                     log.info(\"Try get lock {} success,times {}.\",lockName,tryTimes);\n                     break;\n                 }\n                 log.info(\"Wait try get lock {}.\",lockName);\n                 // 短暂休眠，避免出现活锁\n                  Thread.sleep(3, new Random().nextInt(500));\n\n             }\n            if(StrUtils.isEmpty(this.identifier)){\n                log.error(\"Try can't get lock {}.\",lockName);\n                throw new LockException(\"Try and get lock {} error.\",lockName);\n            }\n        }catch (Exception e){\n            returnRedis(redis);\n            log.error(\"Try get lock {} error.\",lockName);\n            if( e instanceof LockException){\n                throw (LockException)e;\n            }else{\n                throw new LockException(\"Try get lock  error\",e);\n            }\n        }\n\n    }\n\n    /**\n     * 释放锁\n     * @return\n     */\n    public void releaseLock()  throws LockException{\n        String lockKey = LOCK_KEY_PRE + lockName;\n        if (this.redis == null) {\n            return;\n        }\n        try {\n            log.info(\"Start release lock {}.\",lockName);\n            while (true) {\n                this.redis.watch(lockKey);\n                if (StrUtils.isNotEmpty(this.identifier) && this.identifier.equals(this.redis.get(lockKey))) {\n                    Transaction trans = this.redis.multi();\n                    trans.del(lockKey);\n                    List<Object> results = trans.exec();\n                    if (results == null) {\n                        continue;\n                    }\n                }\n                this.redis.unwatch();\n\n                log.info(\"Release lock {} success.\",lockName);\n                break;\n            }\n\n        } catch (JedisException je) {\n            je.printStackTrace();\n            log.error(\"Release lock {} error.\",lockName,je);\n           // throw new LockException(je);\n        } finally {\n            returnRedis(redis);\n            log.error(\"End release lock {}.\",lockName);\n        }\n    }\n\n\n}"