gy.selectBankTrans(payQOTransInfo);\n                    // 基于流水查询回单\n                    for (TransInfo transInfo : transInfos) {\n                        HashMap<String, Object> dto = new HashMap<>();\n                        dto.put(\"account\", account.getAccountNo());\n                        dto.put(\"serialNumber\", transInfo.getSerialNumber());\n                        dto.put(\"beginDate\", date);\n                        dto.put(\"endDate\", date);\n                        dto.put(\"processInstanceNumber\", transInfo.getProcessInstanceNumber());\n                        dto.put(\"bankCode\", bankCode);\n                        ResponseHeaderDTO fileDto = this.getElectReceiptFile(dto, extentionParams);\n                        if (fileDto != null && fileDto.getBody() != null) {\n                            BankcommonReceiptDTO receipt = fileDto.getBody().getReceipt();\n                            if (receipt != null) {\n                                // 文件处理\n                                receipt.setBank(bankCode);\n                                receipt.setAccount(account.getAccountNo());\n                                receipt.setPayeeAccNo(transInfo.getAccount());\n                                receipt.setSerialNumber(transInfo.getSerialNumber());\n                                receipt.setTranDate(date);\n                                receipt.setTranAmt(transInfo.getTransAmount());\n                                receiptUtils.dealReceiptFile(receipt, dto);\n                            }\n                        }\n                    }\n\n                } catch (Exception e) {\n                    log.error(\"BCM银行selectElectReceiptError\", e);\n                }\n            }\n        }\n        log.info(\"BCM银行回单拉取任务执行完成\");\n        return \"BCM银行执行成功\";\n    }\n\n    /**\n     * 获取回单文件\n     *\n     * @param dto\n     * @param extentionParams 扩展参数\n     * @return\n     */\n    public ResponseHeaderDTO getElectReceiptFile(Map<String, Obj