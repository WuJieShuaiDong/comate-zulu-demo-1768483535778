      "content": "package com.baidu.pmc.bankcommon.core.service.bcm;\n\nimport com.baidu.pmc.pojo.model.cmb.PayQO;\n\nimport java.util.Map;\n\n/**\n * 电子回单相关服务\n *\n * @author liuyanzhong\n */\npublic interface BankBcmReceiptService {\n\n\n    /**\n     * 回单任务\n     *\n     * @param payQO\n     * @param extentionParams 扩展参数\n     * @return\n     */\n    String selectElectReceipt(PayQO payQO, Map<String, String> extentionParams);\n\n\n}",
