            "content": "package com.baidu.p2p.core.utils;\n\nimport static org.junit.Assert.*;\n\nimport org.junit.After;\nimport org.junit.Before;\nimport org.junit.Test;\n\nimport java.util.concurrent.*;\nimport java.util.concurrent.atomic.AtomicBoolean;\n\npublic class NewThreadPoolExecutorUtilTest{\n\n\n    private ExecutorService customExecutor;\n\n    private ThreadPoolExecutor executor;\n    @Before\n    public void setup() {\n        ExecutorService executor = NewThreadPoolExecutorUtil.getExecutorService();\n        executor.shutdown();\n        try {\n            if (!executor.awaitTermination(5, TimeUnit.SECONDS)) {\n                executor.shutdownNow();\n            }\n        } catch (InterruptedException e) {\n            executor.shutdownNow();\n            Thread.currentThread().interrupt();\n        }\n    }\n\n    @After\n    public void teardown() {\n        ExecutorService executor = NewThreadPoolExecutorUtil.getExecutorService();\n        executor.shutdown();\n        try {\n            if (!executor.awaitTermination(5, TimeUnit.SECONDS)) {\n                executor.shutdownNow();\n            }\n        } catch (InterruptedException e) {\n            executor.shutdownNow();\n            Thread.currentThread().interrupt();\n        }\n    }\n    // testCreateExecutorServiceWithValidParameters 用于测试 createExecutorService\n    // generated by Comate\n    @Test\n    public void testCreateExecutorServiceWithValidParameters() {\n        int corePoolSize = 5;\n        int maxPoolSize = 10;\n        int queueSize = 100;\n        \n        ThreadPoolExecutor executor = NewThreadPoolExecutorUtil.createExecutorService(corePoolSize, maxPoolSize, queueSize,\n                \"test-pool-\");\n        \n        assertNotNull(executor);\n        assertEquals(corePoolSize, executor.getCorePoolSize());\n        assertEquals(maxPoolSize, executor.getMaximumPoolSize());\n        assertFalse(executor.isShutdown());\n    }\n\n    // testCreateExecutorServiceWithNegativeCorePoolSize 用于测试 createExecutorService\n    // generated by Comate\n    @Test(expected = IllegalArgumentException.class)\n    public void testCreateExecutorServiceWithNegativeCorePoolSize() {\n        NewThreadPoolExecutorUtil.createExecutorService(-1, 10, 100, \"invalid-pool-\");\n    }\n\n    // testShutdownExecutorNullExecutor 用于测试 shutdownExecutor\n    // generated by Comate\n    @Test\n    public void testShutdownExecutorNullExecutor() {\n        NewThreadPoolExecutorUtil.shutdownExecutor(null, 1, TimeUnit.SECONDS);\n    }\n\n    // testSubmitNullExecutor 用于测试 submit\n    // generated by Comate\n    @Test(expected = IllegalArgumentException.class)\n    public void testSubmitNullExecutor() {\n        Callable<String> task = () -> \"test\";\n        NewThreadPoolExecutorUtil.submit(null, task);\n    }\n\n    // testSubmitWithRealExecutor 用于测试 submit\n    // generated by Comate\n    @Test\n    public void testSubmitWithRealExecutor() throws Exception {\n        ExecutorService executor = java.util.concurrent.Executors.newSingleThreadExecutor();\n        try {\n            Callable<String> task = () -> \"real result\";\n            Future<String> future = NewThreadPoolExecutorUtil.submit(executor, task);\n            assertEquals(\"real result\", future.get(1, TimeUnit.SECONDS));\n        } finally {\n            executor.shutdown();\n            executor.awaitTermination(1, TimeUnit.SECONDS);\n        }\n    }\n\n    // testExecuteNullExecutor 用于测试 execute\n    // generated by Comate\n    @Test(expected = IllegalArgumentException.class)\n    public void testExecuteNullExecutor() {\n        Runnable task = () -> System.out.println(\"Task executed\");\n        NewThreadPoolExecutorUtil.execute(null, task);\n    }\n\n    // testWrapExecutorWithNullExecutor 用于测试 wrapExecutor\n    // generated by Comate\n    @Test(expected = NullPointerException.class)\n    public void testWrapExecutorWithNullExecutor() {\n        NewThreadPoolExecutorUtil.wrapExecutor(null);\n    }\n\n    // testSetCorePoolSizeWithValidValue 用于测试 setCorePoolSize\n    // generated by Comate\n    @Test\n    public void testSetCorePoolSizeWithValidValue() {\n    ThreadPoolExecutor executor = NewThreadPoolExecutorUtil.createExecutorService(5, 10, 100, \"test-pool-\");\n    int newCorePoolSize = 7;\n    \n    NewThreadPoolExecutorUtil.setCorePoolSize(executor, newCorePoolSize);\n    \n    assertEquals(newCorePoolSize, executor.getCorePoolSize());\n    }\n\n    // testSetCorePoolSizeWithNegativeValue 用于测试 setCorePoolSize\n    // generated by Comate\n    @Test(expected = IllegalArgumentException.class)\n    public void testSetCorePoolSizeWithNegativeValue() {\n    ThreadPoolExecutor executor = NewThreadPoolExecutorUtil.createExecutorService(5, 10, 100, \"test-pool-\");\n    NewThreadPoolExecutorUtil.setCorePoolSize(executor, -1);\n    }\n\n    // testSetMaximumPoolSizeWithValidValue 用于测试 setMaximumPoolSize\n    // generated by Comate\n    @Test\n    public void testSetMaximumPoolSizeWithValidValue() {\n        ThreadPoolExecutor executor = new ThreadPoolExecutor(\n            2, 5, 5, TimeUnit.MINUTES, \n            new LinkedBlockingQueue<>(10)\n        );\n        int newMaxPoolSize = 8;\n        \n        NewThreadPoolExecutorUtil.setMaximumPoolSize(executor, newMaxPoolSize);\n        \n        assertEquals(newMaxPoolSize, executor.getMaximumPoolSize());\n    }\n\n    // testSetMaximumPoolSizeWithZeroValue 用于测试 setMaximumPoolSize\n    // generated by Comate\n    @Test(expected = IllegalArgumentException.class)\n    public void testSetMaximumPoolSizeWithZeroValue() {\n        ThreadPoolExecutor executor = new ThreadPoolExecutor(\n            2, 5, 5, TimeUnit.MINUTES, \n            new LinkedBlockingQueue<>(10)\n        );\n        NewThreadPoolExecutorUtil.setMaximumPoolSize(executor, 0);\n    }\n\n    // testPrintThreadPoolStatusWithNullExecutor 用于测试 printThreadPoolStatus\n    // generated by Comate\n    @Test\n    public void testPrintThreadPoolStatusWithNull