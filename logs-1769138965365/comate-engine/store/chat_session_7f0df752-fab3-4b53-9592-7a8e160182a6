0);\n        \n        NewThreadPoolExecutorUtil.printThreadPoolStatus(executor, \"full-pool\");\n        assertEquals(10, executor.getQueue().size());\n    \n        executor.shutdown();\n        try {\n            if (!executor.awaitTermination(5, TimeUnit.SECONDS)) {\n                executor.shutdownNow();\n            }\n        } catch (InterruptedException e) {\n            executor.shutdownNow();\n            Thread.currentThread().interrupt();\n        }\n    }\n\n    // testExecuteWithErrorThrowingTask 用于测试 execute\n    // generated by Comate\n    @Test\n    public void testExecuteWithErrorThrowingTask() throws InterruptedException {\n        // 创建一个单线程池用于测试\n        ExecutorService executor = Executors.newFixedThreadPool(1);\n        \n        // 创建一个会抛出Error的任务\n        Runnable errorTask = () -> {\n            throw new OutOfMemoryError(\"Simulated memory error\");\n        };\n        \n        try {\n            NewThreadPoolExecutorUtil.execute(executor, errorTask, \"error-task\");\n            \n            // 给任务一点时间执行\n            Thread.sleep(500);\n            \n            // 验证日志中是否记录了Error（实际项目中可能需要验证日志）\n            // 这里主要验证程序不会崩溃，且Error被捕获\n        } finally {\n            executor.shutdown();\n            executor.awaitTermination(1, TimeUnit.SECONDS);\n        }\n    }\n\n    // testExecuteNormalTask 用于测试 execute\n    // generated by Comate\n    @Test\n    public void testExecuteNormalTask() throws InterruptedException {\n        // 创建一个单线程池用于测试\n        ExecutorService executor = Executors.newFixedThreadPool(1);\n        \n        // 创建一个正常任务\n        final boolean[] taskExecuted = {false};\n        Runnable normalTask = () -> {\n            taskExecuted[0] = true;\n        };\n        \n        try {\n            NewThreadPoolExecutorUtil.execute(executor, normalTask, \"normal-task\");\n            \n            // 给任务一点时间执行\n            Thread.sleep(500);\n            \n            // 验证任务确实执行了\n            assertTrue(taskExecuted[0]);\n        } finally {\n            executor.shutdown();\n            executor.awaitTermination(1, TimeUnit.SECONDS);\n        }\n    }\n\n    // testSubmitWithExceptionThrowingTask 用于测试 submit\n    // generated by Comate\n    @Test\n    public void testSubmitWithExceptionThrowingTask() throws Exception {\n        ExecutorService executor = Executors.newSingleThreadExecutor();\n        try {\n            Callable<String> exceptionTask = () -> {\n                throw new RuntimeException(\"Simulated runtime exception\");\n            };\n            Future<String> future = NewThreadPoolExecutorUtil.submit(\n                executor, \n                exceptionTask, \n                \"exception-task\"\n            );\n            try {\n                future.get();\n                fail(\"Expected ExecutionException to be thrown\");\n            } catch (ExecutionException e) {\n                assertTrue(e.getCause() instanceof RuntimeException);\n                assertEquals(\"Simulated runtime exception\", e.getCause().getMessage());\n            }\n        } finally {\n            executor.shutdown();\n            executor.awaitTermination(1, TimeUnit.SECONDS);\n        }\n    }\n\n    // testExecuteWithCustomExecutor 用于测试 execute\n    // generated by Comate\n    @Test\n    public void testExecuteWithCustomExecutor() throws InterruptedException {\n        customExecutor = NewThreadPoolExecutorUtil.createExecutorService(\n            2, 4, 10, \"test-pool\");\n        ExecutorService defaultExecutor = NewThreadPoolExecutorUtil.getExecutorService();\n        defaultExecutor.shutdown();\n        try {\n            if (!defaultExecutor.awaitTermination(5, TimeUnit.SECONDS)) {\n                defaultExecutor.shutdownNow();\n            }\n        } catch (InterruptedException e) {\n            defaultExecutor.shutdownNow();\n            Thread.currentThread().interrupt();\n        }\n        AtomicBoolean taskExecuted = new AtomicBoolean(false);\n        Runnable task = () -> taskExecuted.set(true);\n        NewThreadPoolExecutorUtil.execute(customExecutor, task);\n        Thread.sleep(100);\n        assertTrue(\"Task should be executed\", taskExecuted.get());\n        if (customExecutor != null) {\n            customExecutor.shutdownNow();\n        }\n        defaultExecutor = NewThreadPoolExecutorUtil.getExecutorService();\n        defaultExecutor.shutdown();\n        try {\n            if (!defaultExecutor.awaitTermination(5, TimeUnit.SECONDS)) {\n                defaultExecutor.shutdownNow();\n            }\n        } catch (InterruptedException e) {\n            defaultExecutor.shutdownNow();\n            Thread.currentThread().interrupt();\n        }\n    }\n\n    // testGetExecutorServiceAfterShutdown 用于测试 getExecutorService\n    // generated by Comate\n    @Test\n    public void testGetExecutorServiceAfterShutdown() throws InterruptedException {\n        // Get and shutdown executor\n        ExecutorService executor = NewThreadPoolExecutorUtil.getExecutorService();\n        executor.shutdown();\n        assertTrue(executor.awaitTermination(5, TimeUnit.SECONDS));\n    \n        // Get new executor instance\n        ExecutorService newExecutor = NewThreadPoolExecutorUtil.getExecutorService();\n        assertNotNull(\"New executor should not be null\", newExecutor);\n        assertFalse(\"New executor should not be shutdown\", newExecutor.isShutdown());\n        assertFalse(\"New executor should not be terminated\", newExecutor.isTerminated());\n    }\n\n    // testGetExecutorServiceReturnsSameInstance 用于测试 getExecutorService\n    // generated by Comate\n    @Test\n    public void testGetExecutorServiceReturnsSameInstance() {\n        ExecutorService executor1 = NewThreadPoolExecutorUtil.getExecutorService();\n        ExecutorService executor2 = NewThreadPoolExecutorUtil.getExecutorService();\n        assertSame(\"Should return same executor instance\", executor1, executor2);\n    }\n\n    // testExecutorServiceThreadFac