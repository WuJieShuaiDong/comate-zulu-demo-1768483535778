                  "content": "package com.example.demo.util;\n\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.HashMap;\nimport java.util.HashSet;\nimport java.util.List;\n\npublic class LeetCode {\n\n    /**\n     * 在给定数组中查找两个数，使它们的和等于目标值\n     *\n     * @param nums   整数数组\n     * @param target 目标和\n     * @return 包含两个数索引的数组，如果不存在这样的两个数则返回null\n     */\n    public static int[] twoSum(int[] nums, int target) {\n        HashMap<Integer, Integer> map = new HashMap<>();\n        for (int i = 0; i < nums.length; i++) {\n            if (map.containsKey(target - nums[i])) {\n                return new int[]{map.get(target - nums[i]), i};\n            }\n            map.put(nums[i], i);\n        }\n        return null;\n    }\n\n\n    /**\n     * 将字母异位词分组\n     * <p>\n     * 字母异位词指字母相同，但排列不同的字符串。该方法通过将每个字符串排序后作为键，\n     * 将具有相同排序结果的字符串归为一组。\n     *\n     * @param strs 字符串数组，包含待分组的字符串\n     * @return 分组后的列表，每个子列表包含一组字母异位词\n     */\n    public List<List<String>> groupAnagrams(String[] strs) {\n        HashMap<String, List<String>> map = new HashMap<>();\n        for (String str : strs) {\n            char[] chars = str.toCharArray();\n            Arrays.sort(chars);\n            String sorted = new String(chars);\n            if (!map.containsKey(sorted)) {\n                map.put(sorted, new ArrayList<>());\n            }\n            map.get(sorted).add(str);\n        }\n        return new ArrayList<>(map.values());\n    }\n\n\n    /**\n     * 最长连续序列长度\n     *\n     */\n    public int longestConsecutive(int[] nums) {\n        HashSet<Integer> set = new HashSet<>();\n        for (int num : nums) {\n            set.add(num);\n        }\n        // [100,4,200,1,3,2]\n        int longestStreak = 0;\n        // 小于他的数不存在，说明是连续序列的起始点\n        for (int num : set) {\n            // 判断是否为连续序列的起始点\n            // 100, 4, 200, 1, 3, 2\n            if (!set.contains(num - 1)) {\n                int currentNum = num;\n                int currentStreak = 1;\n                // 找到连续序列最小数，然后找出来他最大的长度\n                // 4、1、3、2  这里就是1\n                while (set.contains(currentNum + 1)) {\n                    currentNum += 1;\n                    currentStreak += 1;\n                }\n\n                longestStreak = Math.max(longestStreak, currentStreak);\n            }\n        }\n\n        return longestStreak;\n    }\n\n\n    /**\n     * 将0移到末尾\n     *\n     */\n    public void moveZeroes(int[] nums) {\n        //1 2 0 1 0 2 3 -> 12300\n        int index = 0;\n        for (int i = 0; i < nums.length; i++) {\n            if (nums[i] != 0) {\n                nums[index++] = nums[i];\n            }\n        }\n        for (int i = index; i < nums.length; i++) {\n            nums[i] = 0;\n        }\n    }\n\n    /**\n     * 最大容积\n     *\n     */\n    public int maxArea(int[] height) {\n        int max = 0;\n        int left = 0;\n        int right = height.length - 1;\n        int area = 0;\n        while (left < right) {\n            area = Math.min(height[left], height[right]) * (right - left);\n            max = Math.max(max, area);\n            if (height[left] < height[right]) {\n                left++;\n            } else {\n                right--;\n            }\n        }\n        return max;\n    }\n\n\n    /**\n     * 三数之和\n     *\n     */\n    //定义三个指针，保证遍历数组中的每一个结果\n    //画图，解答\n    public List<List<Integer>> threeSum(int[] nums) {\n        //定义一个结果集\n        List<List<Integer>> res = new ArrayList<>();\n        //数组的长度\n        int len = nums.length;\n        //当前数组的长度为空，或者长度小于3时，直接退出\n        if (len < 3) {\n            return res;\n        }\n        if (nums[0] > 0 || nums[len-1] < 0) {\n            return res;\n        }\n        //将数组进行排序\n        Arrays.sort(nums);\n        //遍历数组中的每一个元素\n        for (int i = 0; i < len; i++) {\n            if(nums[i]>0){\n                break;\n            }\n            if (i > 0 && nums[i] == nums[i - 1]) {\n                continue;\n            }\n            int l = i+1;\n            int r = len - 1;\n            while (l < r) {\n                int sum = nums[i] + nums[l] + nums[r];\n                if (sum == 0) {\n                    res.add(Arrays.asList(nums[i], nums[l], nums[r]));\n                    while (l < r && nums[l] == nums[l+1]) {\n                        l++;\n                    }\n                    while (l < r && nums[r] == nums[r-1]) {\n                        r--;\n                    }\n                    l++;\n                    r--;\n                } else if (sum < 0) {\n                    l++;\n                }  else {\n                    r--;\n                }\n            }\n        }\n        return res;\n    }\n\n\n    /**\n    * 接雨水\n    * */\n    public int trap(int[] height) {\n        if (height == null || height.length == 0) {\n            return 0;\n        }\n        int len = height.length;\n        int left = 0;\n        int right = len - 1;\n        int leftMax = height[left];\n        int rightMax = height[right];\n        int res = 0;\n        while (left < right) {\n            if (leftMax < rightMax) {\n                left++;\n                leftMax = Math.max(leftMax, height[left]);\n                res += leftMax - height[left];\n            } else {\n                right--;\n                rightMax = Math.max(rightMax, height[right]);\n                res += rightMax - height[right];\n            }\n        }\n        return res;\n    }\n}\n",
