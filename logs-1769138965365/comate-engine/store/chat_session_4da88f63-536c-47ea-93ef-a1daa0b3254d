ide\n    public String postMACHINE(String request, String hashValue, Long tenantId, String[] ipArr, String bankCode) {\n        // 1. 对请求报文进行签名\n        request = bcmSign(request);\n        String requestLength = StringUtils.leftPad(String.valueOf(request.length() + 6), 6, '0');\n        request = requestLength + request;\n\n        // 2. 获取可用前置机列表\n        PmcCmbMachineDTO cmbMachineDTO = new PmcCmbMachineDTO();\n        cmbMachineDTO.setTenantId(tenantId);\n        cmbMachineDTO.setStatus(Constants.UP);\n        cmbMachineDTO.setMachineBank(bankCode);\n        List<PmcCmbMachine> machines = machineService.selectMachine(cmbMachineDTO);\n\n        if (CollectionUtils.isEmpty(machines)) {\n            log.error(\"无可用BCM银行前置机\");\n            mailService.sendMachineFailedMail(\"无可用BCM银行前置机\", new ArrayList<>(), bankCode);\n            return Constants.NO_ENABLED_MACHINE;\n        }\n\n        // 3. 使用一致性哈希选择前置机\n        Map<String, PmcCmbMachine> machineMap = machines.stream()\n                .collect(Collectors.toMap(PmcCmbMachine::getIp, Function.identity(), (k1, k2) -> k1));\n        String server = new NodeDistributeUtil().getServer(hashValue, machineMap.keySet().toArray(new String[0]));\n        log.info(\"选择BCM银行前置机: {}\", server);\n\n        PmcCmbMachine machine = machineMap.get(server);\n        if (ipArr != null && ipArr.length > 0) {\n            ipArr[0] = machine.getIp();\n        }\n\n        try {\n            // 4. 获取银行配置确定请求类型\n            Example example = new Example(PmcPayCommonBankSet.class);\n            example.createCriteria()\n                .andEqualTo(\"bankCode\", bankCode)\n                .andEqualTo(\"transferFlag\", Constants.ENABLED_Y);\n            List<PmcPayCommonBankSet> bankSets = pmcPayCommonBankSetMapper.selectByExample(example);\n\n            String requestType = CollectionUtils.isNotEmpty(bankSets)\n                ? bankSets.get(0).getRequestType()\n                : Constants.RequestTypeEnum.XML;\n\n            // 5. 发送请求