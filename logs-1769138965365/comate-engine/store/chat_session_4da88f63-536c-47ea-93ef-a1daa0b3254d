      "content": "package com.baidu.pmc.bankcommon.core.constants;\n\n/**\n * BCM银行(交通银行)特定常量\n */\npublic class BcmConstants {\n\n    /**\n     * BCM银行编码\n     */\n    public static final String BANK_CODE = \"B017\";\n\n    /**\n     * 签名服务内容类型\n     */\n    public static class ContentType {\n        public static final String SIGN = \"application/x-bcm-sign\";\n        public static final String VERIFY_SIGN = \"application/x-bcm-verify-sign\";\n    }\n\n    /**\n     * BCM银行交易类型\n     */\n    public static class TransCode {\n        public static final String PAY = \"BCM_PAY\"; // 支付交易\n        public static final String QUERY = \"BCM_QUERY\"; // 查询交易\n        public static final String BALANCE = \"BCM_BALANCE\"; // 余额查询\n    }\n\n    /**\n     * BCM银行响应码\n     */\n    public static class ResponseCode {\n        public static final String SUCCESS = \"0000\"; // 交易成功\n        public static final String PROCESSING = \"1000\"; // 处理中\n        public static final String FAILURE = \"2000\"; // 交易失败\n    }\n\n    /**\n     * BCM银行字段长度限制\n     */\n    public static class FieldLength {\n        public static final int ACCOUNT_NAME = 60; // 账户名称最大长度\n        public static final int ACCOUNT_NO = 32; // 账号最大长度\n        public static final int BANK_NAME = 100; // 银行名称最大长度\n        public static final int REMARK = 60; // 备注最大长度\n    }\n}",
