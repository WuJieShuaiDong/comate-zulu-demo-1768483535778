                "content": "package com.example.demo.interceptor;\n\nimport org.springframework.stereotype.Component;\nimport org.springframework.web.servlet.HandlerInterceptor;\n\nimport javax.servlet.http.HttpServletRequest;\nimport javax.servlet.http.HttpServletResponse;\n\n/**\n * @author liumandong\n */\n@Component\npublic class PmcPortalAuthInterceptor implements HandlerInterceptor {\n\n    @Override\n    public boolean preHandle(HttpServletRequest request, HttpServletResponse response, Object handler) throws Exception {\n        // ===== 1. AES解密鉴权 =====\n        // 从请求头获取加密的鉴权信息（客户端需在Authorization头传递加密串）\n        String authHeader = request.getHeader(\"Authorization\");\n        if (authHeader == null || authHeader.isEmpty()) {\n            response.sendError(HttpServletResponse.SC_UNAUTHORIZED, \"缺少鉴权信息\");\n            return false;\n        }\n\n        // 解密鉴权信息（客户端需用AES加密\"valid\"作为合法标识，此处可自定义规则）\n        String decryptedAuth;\n        try {\n            decryptedAuth = AesUtils.decrypt(authHeader);\n        } catch (Exception e) {\n            response.sendError(HttpServletResponse.SC_UNAUTHORIZED, \"鉴权失败：加密串无效\");\n            return false;\n        }\n        //解密后不乱码有中文数字字母则通过鉴权通过\n        if (!\"valid\".equals(decryptedAuth)) {\n            response.sendError(HttpServletResponse.SC_UNAUTHORIZED, \"鉴权失败：权限不足\");\n            return false;\n        }\n\n        // ===== 2. 从URL解析登录人信息 =====\n        // 假设登录人ID（supId）通过URL参数传递，如 /pmcPortal/xxx?supId=abc_123\n        String supId = request.getParameter(\"supId\");\n        if (supId == null || supId.isEmpty()) {\n            response.sendError(HttpServletResponse.SC_BAD_REQUEST, \"缺少登录人ID（supId）\");\n            return false;\n        }\n\n        // ===== 3. 存入ThreadLocal =====\n        PmcPortalLogin.LoginInfo loginInfo = new PmcPortalLogin.LoginInfo();\n        loginInfo.setSupId(supId);\n        PmcPortalLogin.setLoginInfo(loginInfo);\n\n        return true; // 鉴权通过，放行请求\n    }\n\n    @Override\n    public void afterCompletion(HttpServletRequest request, HttpServletResponse response, Object handler, Exception ex) {\n        // 清理ThreadLocal, 防止内存泄漏\n        PmcPortalLogin.clear();\n    }\n}",
