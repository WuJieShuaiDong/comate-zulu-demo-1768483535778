                "basename": "BankTransactionParser.java",
                "originalContent": "package com.baidu.pmc.bankcommon.core.utils.bcm;\n\nimport com.baidu.pmc.bankcommon.core.model.bcm.BankBcmTransaction;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.lang3.StringUtils;\n\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.List;\nimport java.util.regex.Pattern;\n\n/**\n * 银行交易记录解析工具类\n * 用于解析银行流水文本数据，按照固定分隔符分割字段\n *\n * @author baidu.pmc\n * @since 2025-01-09\n */\n@Slf4j\npublic class BankTransactionParser {\n\n    private static final String FIELD_SEPARATOR = \"\\\\|\";\n    private static final int EXPECTED_FIELD_COUNT = 26;\n    // 正则表达式匹配多种行分隔符：Windows(\\r\\n)、Unix(\\n)、Mac(\\r)，以及没有分隔符的单行情况\n    private static final Pattern LINE_SEPARATOR_PATTERN = Pattern.compile(\"\\\\r?\\\\n|\\\\r\");\n\n    /**\n     * 解析银行交易记录字符串（使用默认字段数26）\n     *\n     * @param dataString 包含表头和数据的完整字符串\n     * @return 解析后的交易记录列表\n     */\n    public static List<BankBcmTransaction> parseBankTransactions(String dataString) {\n        return parseBankTransactions(dataString, EXPECTED_FIELD_COUNT);\n    }\n\n    /**\n     * 解析银行交易记录字符串\n     *\n     * @param dataString 包含表头和数据的完整字符串\n     * @param expectedFieldCount 预期的字段数量\n     * @return 解析后的交易记录列表\n     */\n    public static List<BankBcmTransaction> parseBankTransactions(String dataString, int expectedFieldCount) {\n        List<BankBcmTransaction> transactions = new ArrayList<>();\n\n        if (StringUtils.isBlank(dataString)) {\n            log.warn(\"银行交易记录字符串为空\");\n            return transactions;\n        }\n\n        // 按行分割字符串 - 兼容多种行分隔符（Windows\\\\r\\\\n、Unix\\\\n、Mac\\\\r）以及单行情况\n        String[] lines = LINE_SEPARATOR_PATTERN.split(dataString);\n\n        if (lines.length == 0) {\n            log.warn(\"银行交易记录数据为空\");\n            return transactions;\n        }\n\n        // 处理单行数据情况（没有换行符）\n        if (lines.length == 1) {\n            return handleSingleLineData(dataString, expectedFieldCount);\n        }\n\n        // 处理多行数据情况\n        return handleMultiLineData(lines, expectedFieldCount);\n    }\n\n    /**\n     * 处理单行银行交易数据\n     * @param dataString 单行数据字符串\n     * @param expectedFieldCount 预期的字段数量\n     * @return 解析后的交易记录列表\n     */\n    private static List<BankBcmTransaction> handleSingleLineData(String dataString, int expectedFieldCount) {\n        List<BankBcmTransaction> transactions = new ArrayList<>();\n\n        // 检查是否包含数据分隔符（确认是否为有效数据）\n        if (!dataString.contains(\"|\")) {\n            log.warn(\"单行银行交易记录数据格式无效，未找到字段分隔符\");\n            return transactions;\n        }\n\n        // 检查是否是\"表头+数据\"模式（包含字段名和具体数值）\n        if (isHeaderDataCombinedLine(dataString)) {\n            return handleHeaderDataCombinedLine(dataString, expectedFieldCount);\n        }\n\n        log.info(\"检测到单行银行交易记录数据，尝试解析\");\n\n        try {\n            // 尝试解析单行数据\n            BankBcmTransaction transaction = parseDataLine(dataString, 1);\n            if (transaction != null) {\n                transactions.add(transaction);\n                log.info(\"成功解析单行数据：流水号={}, 交易金额={}\",\n                        transaction.getSerialNumber(), transaction.getTransactionAmount());\n            } else {\n                log.warn(\"单行银行交易记录数据解析失败\");\n            }\n        } catch (Exception e) {\n            log.error(\"解析单行银行交易记录数据时发生异常\", e);\n        }\n\n        return transactions;\n    }\n\n    /**\n     * 判断是否是表头和数据合并在一行的情况\n     * @param dataString 单行数据字符串\n     * @return true如果是表头数据合并行，false否则\n     */\n    private static boolean isHeaderDataCombinedLine(String dataString) {\n        if (StringUtils.isBlank(dataString)) {\n            return false;\n        }\n\n        // 基本的表头特征关键词检查\n        String[] headerKeywords = {\"状态\", \"交易日期\", \"交易时间\", \"业务类型\", \"流水号\", \"账号\", \"户名\", \"收支标志\",\n                                 \"币种\", \"交易金额\", \"余额\", \"可用余额\", \"对方账号\", \"对方户名\", \"对方地址\"};\n\n        for (String keyword : headerKeywords) {\n            if (dataString.contains(keyword)) {\n                return true;\n            }\n        }\n\n        return false;\n    }\n\n    /**\n     * 处理表头和数据合并在一行的情况\n     * @param combinedLine 合并的表头和数据行\n     * @return 解析后的交易记录列表\n     */\n    private static List<BankBcmTransaction> handleHeaderDataCombinedLine(String combinedLine) {\n        List<BankBcmTransaction> transactions = new ArrayList<>();\n\n        log.info(\"检测到表头和数据合并在一行的情况，尝试提取并解析数据部分\");\n\n        try {\n            String[] fields = combinedLine.split(\"\\\\|\", -1);\n\n            // 检查是否包含多条数据记录\n            List<Integer> dataStartPositions = findDataStartPositions(fields);\n\n            if (dataStartPositions.isEmpty()) {\n                log.warn(\"无法在合并行中找到有效的数据部分\");\n                return transactions;\n            }\n\n            log.info(\"检测到 {} 条数据记录在同一行中\", dataStartPositions.size());\n\n            // 解析每条数据记录\n            for (int recordIndex = 0; recordIndex < dataStartPositions.size(); recordIndex++) {\n                int dataStartPos = dataStartPositions.get(recordIndex);\n                int dataEndPos = (recordIndex == dataStartPositions.size() - 1)\n                    ? fields.length\n                    : dataStartPositions.get(recordIndex + 1);\n\n                // 构建单条数据行\n                StringBuilder dataBuilder = new StringBuilder();\n                for (int i = dataStartPos; i < dataEndPos; i++) {\n                    if (i > dataStartPos) {\n                        dataBuilder.append(\"|\");\n                    }\n                    dataBuilder.append(fields[i]);\n                }\n\n                String dataLine = dataBuilder.toString();\n                BankBcmTransaction transaction = parseDataLine(dataLine, recordIndex + 1);\n                if (transaction != null) {\n                    transactions.add(transaction);\n                    log.info(\"成功解析第{}条数据记录：流水号={}, 交易金额={}, 交易日期={}\",\n                            recordIndex + 1, transaction.getSerialNumber(),\n                            transaction.getTransactionAmount(), transaction.getTransactionDate());\n                } else {\n                    log.warn(\"第{}条数据记录解析失败\", recordIndex + 1);\n                }\n            }\n\n        } catch (Exception e) {\n            log.error(\"解析表头数据合并行时发生异常\", e);\n        }\n\n        return transactions;\n    }\n\n    /**\n     * 查找所有数据记录的起始位置\n     * @param fields 分割后的字段数组\n     * @return 数据记录起始位置列表\n     */\n    private static List<Integer> findDataStartPositions(String[] fields) {\n        List<Integer> positions = new ArrayList<>();\n\n        // 预期的每条数据记录的大致字段数（基于表头字段数）\n        int approxFieldsPerRecord = 26;\n\n        // 如果字段总数接近预期记录的倍数，可能需要调整逻辑\n        if (fields.length <= approxFieldsPerRecord) {\n            // 如果字段总数不超过一条记录的长度，直接返回第一个数据位置\n            int firstDataPos = findFirstDataPosition(fields);\n            if (firstDataPos >= 0) {\n                positions.add(firstDataPos);\n            }\n            return positions;\n        }\n\n        // 对于大量字段，使用更智能的边界检测\n        for (int i = 0; i < fields.length - 10; i++) { // 留出足够的字段来检查模式\n            if (isDataSequenceStart(fields, i, approxFieldsPerRecord)) {\n                positions.add(i);\n                // 跳过近似的一条记录长度，避免重复检测\n                i += approxFieldsPerRecord - 5; // 留出一些重叠以应对字段数变化\n            }\n        }\n\n        return positions;\n    }\n\n    /**\n     * 判断是否是一个数据序列的开始\n     * @param fields 字段数组\n     * @param startPos 开始位置\n     * @param expectedFields 预期的字段数\n     * @return true如果是数据序列开始\n     */\n    private static boolean isDataSequenceStart(String[] fields, int startPos, int expectedFields) {\n        // 至少需要检查前几个字段的模式\n        if (startPos + 5 >= fields.length) {\n            return false;\n        }\n\n        // 检查前几个关键字段是否符合银行交易数据的模式\n        String status = fields[startPos].trim();\n        String date = fields[startPos + 1].trim();\n        String time = fields[startPos + 2].trim();\n        String amount = fields.length > startPos + 10 ? fields[startPos + 10].trim() : \"\";\n\n        // 状态字段应该是数字或特定值\n        if (!status.matches(\"[01YN]|正常|成功\")) {\n            return false;\n        }\n\n        // 日期字段应该是8位数字\n        if (!date.matches(\"\\\\d{8}\")) {\n            return false;\n        }\n\n        // 时间字段应该是6位数字\n        if (!time.matches(\"\\\\d{6}\")) {\n            return false;\n        }\n\n        // 可选：检查金额字段的格式\n        if (!amount.isEmpty() && !amount.matches(\"\\\\d+\\\\.\\\\d{2}\")) {\n            // 金额字段不是必须的，但如果存在应该是对的\n            if (amount.matches(\".*\\\\d.*\")) { // 至少要包含数字\n                // 可以认为是有效的\n            } else {\n                return false;\n            }\n        }\n\n        return true;\n    }\n\n    /**\n     * 查找第一个数据记录的起始位置\n     * @param fields 字段数组\n     * @return 第一个数据记录起始位置，-1表示未找到\n     */\n    private static int findFirstDataPosition(String[] fields) {\n        for (int i = 0; i < fields.length - 5; i++) {\n            if (isDataSequenceStart(fields, i, 26)) {\n                return i;\n            }\n        }\n        return -1;\n    }\n\n    /**\n     * 查找数据部分的开始位置\n     * @param fields 分割后的字段数组\n     * @return 数据开始位置，-1表示未找到\n     */\n    private static int findDataStartPosition(String[] fields) {\n        // 数据特征：通常包含具体的数值（日期、金额等）\n        for (int i = 0; i < fields.length; i++) {\n            String field = fields[i].trim();\n\n            // 检查字段是否看起来像数据（包含数字或特定格式）\n            if (looksLikeDataField(field)) {\n                return i;\n            }\n        }\n\n        return -1;\n    }\n\n    /**\n     * 判断字段是否看起来像数据字段\n     * @param field 字段值\n     * @return true如果像数据字段，false否则\n     */\n    private static boolean looksLikeDataField(String field) {\n        if (StringUtils.isBlank(field)) {\n            return false;\n        }\n\n        // 检查是否包含数字（交易金额、余额、日期等）\n        if (field.matches(\".*\\\\d.*\")) {\n            return true;\n        }\n\n        // 检查是否是特定格式的日期（如20251105）\n        if (field.matches(\"\\\\d{8}\")) {\n            return true;\n        }\n\n        // 检查是否是特定格式的时间（如093003）\n        if (field.matches(\"\\\\d{6}\")) {\n            return true;\n        }\n\n        // 检查是否是数字金额格式（如100.00）\n        if (field.matches(\"\\\\d+\\\\.\\\\d{2}\")) {\n            return true;\n        }\n\n        return false;\n    }\n\n    /**\n     * 处理多行银行交易数据\n     * @param lines 按行分割的数据数组\n     * @return 解析后的交易记录列表\n     */\n    private static List<BankBcmTransaction> handleMultiLineData(String[] lines) {\n        List<BankBcmTransaction> transactions = new ArrayList<>();\n\n        if (lines.length < 2) {\n            log.warn(\"银行交易记录数据行数不足，至少需要表头和一行数据\");\n            return transactions;\n        }\n\n        try {\n            log.info(\"开始解析银行交易记录，共发现 {} 条数据记录\", lines.length - 1);\n\n            // 跳过表头，直接处理数据行\n            for (int i = 1; i < lines.length; i++) {\n                String dataLine = lines[i].trim();\n                if (StringUtils.isBlank(dataLine)) {\n                    continue;\n                }\n\n                BankBcmTransaction transaction = parseDataLine(dataLine, i);\n                if (transaction != null) {\n                    transactions.add(transaction);\n                    log.info(\"成功解析第{}行数据：流水号={}, 交易金额={}\",\n                            i, transaction.getSerialNumber(), transaction.getTransactionAmount());\n                }\n            }\n\n        } catch (Exception e) {\n            log.error(\"解析银行交易记录时发生异常\", e);\n        }\n\n        log.info(\"银行交易记录解析完成，共解析 {} 条记录\", transactions.size());\n        return transactions;\n    }\n\n    /**\n     * 解析单行数据\n     *\n     * @param line 数据行内容\n     * @param lineNumber 行号\n     * @return 解析后的交易记录对象，解析失败返回null\n     */\n    private static BankBcmTransaction parseDataLine(String line, int lineNumber) {\n        try {\n            // 使用固定分隔符分割，保留所有空字段\n            String[] fields = line.split(FIELD_SEPARATOR, -1);\n\n            // 如果字段多于预期，可能是末尾有额外的空字段，截取前26个\n            if (fields.length > EXPECTED_FIELD_COUNT) {\n                log.warn(\"第{}行发现{}个字段，截取前{}个字段\", lineNumber, fields.length, EXPECTED_FIELD_COUNT);\n                fields = Arrays.copyOf(fields, EXPECTED_FIELD_COUNT);\n            } else if (fields.length < EXPECTED_FIELD_COUNT) {\n                log.error(\"第{}行字段不足：期望{}个，实际{}个\", lineNumber, EXPECTED_FIELD_COUNT, fields.length);\n                return null;\n            }\n\n            // 创建交易记录对象\n            BankBcmTransaction transaction = new BankBcmTransaction();\n\n            // 按固定位置设置字段值\n            transaction.setStatus(cleanField(fields[0]));\n            transaction.setTransactionDate(cleanField(fields[1]));\n            transaction.setTransactionTime(cleanField(fields[2]));\n            transaction.setBusinessType(cleanField(fields[3]));\n            transaction.setSerialNumber(cleanField(fields[4]));\n            transaction.setSequenceNumber(cleanField(fields[5]));\n            transaction.setAccountNumber(cleanField(fields[6]));\n            transaction.setAccountName(cleanField(fields[7]));\n            transaction.setIncomeExpenseFlag(cleanField(fields[8]));\n            transaction.setCurrency(cleanField(fields[9]));\n            transaction.setTransactionAmount(cleanField(fields[10]));\n            transaction.setBalance(cleanField(fields[11]));\n            transaction.setAvailableBalance(cleanField(fields[12]));\n            transaction.setCounterpartyAccount(cleanField(fields[13]));\n            transaction.setCounterpartyName(cleanField(fields[14]));\n            transaction.setCounterpartyAddress(cleanField(fields[15]));\n            transaction.setCounterpartyBankCode(cleanField(fields[16]));\n            transaction.setCounterpartyBankName(cleanField(fields[17]));\n            transaction.setBillType(cleanField(fields[18]));\n            transaction.setBillNumber(cleanField(fields[19]));\n            transaction.setBillName(cleanField(fields[20]));\n            transaction.setBillIssueDate(cleanField(fields[21]));\n            transaction.setRemarkMemo(cleanField(fields[22]));\n            transaction.setAdditionalRemark(cleanField(fields[23]));\n            transaction.setTransactionCode(cleanField(fields[24]));\n            transaction.setBackupField(cleanField(fields[25]));\n\n            return transaction;\n\n        } catch (Exception e) {\n            log.error(\"解析第{}行数据时发生异常\", lineNumber, e);\n            return null;\n        }\n    }\n\n    /**\n     * 清理字段值\n     *\n     * @param field 原始字段值\n     * @return 清理后的字段值\n     */\n    private static String cleanField(String field) {\n        return field != null ? field.trim() : \"\";\n    }\n\n    /**\n     * 打印解析结果（用于调试和验证）\n     *\n     * @param transactions 交易记录列表\n     */\n    public static void printParsingResult(List<BankBcmTransaction> transactions) {\n        log.info(\"=== 银行交易记录解析结果 ===\");\n        log.info(\"共解析出 {} 条交易记录\", transactions.size());\n\n        if (transactions.isEmpty()) {\n            log.info(\"没有解析到有效的交易记录\");\n            return;\n        }\n\n        for (int i = 0; i < Math.min(transactions.size(), 5); i++) {\n            BankBcmTransaction transaction = transactions.get(i);\n            log.info(\"第 {} 条记录:\", i + 1);\n            log.info(\"  状态: {}\", transaction.getStatus());\n            log.info(\"  交易日期: {}\", transaction.getTransactionDate());\n            log.info(\"  交易时间: {}\", transaction.getTransactionTime());\n            log.info(\"  业务类型: {}\", transaction.getBusinessType());\n            log.info(\"  流水号: {}\", transaction.getSerialNumber());\n            log.info(\"  账号: {}\", maskAccountNumber(transaction.getAccountNumber()));\n            log.info(\"  户名: {}\", transaction.getAccountName());\n            log.info(\"  收支标志: {}\", transaction.getIncomeExpenseFlag());\n            log.info(\"  交易金额: {}\", transaction.getTransactionAmount());\n            log.info(\"  余额: {}\", transaction.getBalance());\n            log.info(\"  附言: {}\", transaction.getRemarkMemo());\n            log.info(\"---\");\n        }\n        if (transactions.size() > 5) {\n            log.info(\"... 省略 {} 条记录\", transactions.size() - 5);\n        }\n    }\n\n    /**\n     * 脱敏处理账号信息（用于日志输出）\n     *\n     * @param accountNumber 原始账号\n     * @return 脱敏后的账号\n     */\n    private static String maskAccountNumber(String accountNumber) {\n        if (StringUtils.isBlank(accountNumber) || accountNumber.length() <= 8) {\n            return accountNumber;\n        }\n        return accountNumber.substring(0, 4) + \"****\" + accountNumber.substring(accountNumber.length() - 4);\n    }\n\n    /**\n     * 测试方法 - 验证行分隔符兼容性\n     */\n    public static void testLineSeparatorCompatibility() {\n        String testData = \"状态|交易日期|交易时间|业务类型|流水号|顺序号|账号|户名|收支标志|币种|交易金额|余额|可用余额|对方账号|对方户名||对方银行号|对方银行名称|票据类型|票据号码|票据名称|票据开票日|附言|附加附言|交易代码|备用字段\";\n\n        // 测试Unix换行符(\\n)\n        String unixStyle = testData + \"\\n\" + \"正常|20250110|143000|转账|001|1|123456789|测试用户|1|CNY|100.00|1000.00|1000.00|987654321|对方用户||301290000007|XX银行|0|||20250110|测试备注||301290001||||\";\n        List<BankBcmTransaction> unixResult = parseBankTransactions(unixStyle);\n        log.info(\"Unix换行符测试结果: {}条记录\", unixResult.size());\n\n        // 测试Windows换行符(\\r\\n)\n        String windowsStyle = testData + \"\\r\\n\" + \"正常|20250110|143000|转账|002|1|123456789|测试用户|1|CNY|200.00|1000.00|1000.00|987654321|对方用户||301290000007|XX银行|0|||20250110|测试备注||301290001||||\";\n        List<BankBcmTransaction> windowsResult = parseBankTransactions(windowsStyle);\n        log.info(\"Windows换行符测试结果: {}条记录\", windowsResult.size());\n\n        // 测试Mac换行符(\\r)\n        String macStyle = testData + \"\\r\" + \"正常|20250110|143000|转账|003|1|123456789|测试用户|1|CNY|300.00|1000.00|1000.00|987654321|对方用户||301290000007|XX银行|0|||20250110|测试备注||301290001||||\";\n        List<BankBcmTransaction> macResult = parseBankTransactions(macStyle);\n        log.info(\"Mac换行符测试结果: {}条记录\", macResult.size());\n\n        // 测试单行数据（无换行符）\n        String singleLine = \"正常|20250110|143000|转账|004|1|123456789|测试用户|1|CNY|400.00|1000.00|1000.00|987654321|对方用户||301290000007|XX银行|0|||20250110|单行测试备注||301290001||||\";\n        List<BankBcmTransaction> singleResult = parseBankTransactions(singleLine);\n        log.info(\"单行数据测试结果: {}条记录\", singleResult.size());\n\n        log.info(\"=== 行分隔符兼容性测试完成 ===\");\n    }\n}",
                "content": "package com.baidu.pmc.bankcommon.core.utils.bcm;\n\nimport com.baidu.pmc.bankcommon.core.model.bcm.BankBcmTransaction;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.lang3.StringUtils;\n\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.List;\nimport java.util.regex.Pattern;\n\n/**\n * 银行交易记录解析工具类\n * 用于解析银行流水文本数据，按照固定分隔符分割字段\n *\n * @author baidu.pmc\n * @since 2025-01-09\n */\n@Slf4j\npublic class BankTransactionParser {\n\n    private static final String FIELD_SEPARATOR = \"\\\\|\";\n    private static final int EXPECTED_FIELD_COUNT = 26;\n    // 正则表达式匹配多种行分隔符：Windows(\\r\\n)、Unix(\\n)、Mac(\\r)，以及没有分隔符的单行情况\n    private static final Pattern LINE_SEPARATOR_PATTERN = Pattern.compile(\"\\\\r?\\\\n|\\\\r\");\n\n    /**\n     * 解析银行交易记录字符串（使用默认字段数26）\n     *\n     * @param dataString 包含表头和数据的完整字符串\n     * @return 解析后的交易记录列表\n     */\n    public static List<BankBcmTransaction> parseBankTransactions(String dataString) {\n        return parseBankTransactions(dataString, EXPECTED_FIELD_COUNT);\n    }\n\n    /**\n     * 解析银行交易记录字符串\n     *\n     * @param dataString 包含表头和数据的完整字符串\n     * @param expectedFieldCount 预期的字段数量\n     * @return 解析后的交易记录列表\n     */\n    public static List<BankBcmTransaction> parseBankTransactions(String dataString, int expectedFieldCount) {\n        List<BankBcmTransaction> transactions = new ArrayList<>();\n\n        if (StringUtils.isBlank(dataString)) {\n            log.warn(\"银行交易记录字符串为空\");\n            return transactions;\n        }\n\n        // 按行分割字符串 - 兼容多种行分隔符（Windows\\\\r\\\\n、Unix\\\\n、Mac\\\\r）以及单行情况\n        String[] lines = LINE_SEPARATOR_PATTERN.split(dataString);\n\n        if (lines.length == 0) {\n            log.warn(\"银行交易记录数据为空\");\n            return transactions;\n        }\n\n        // 处理单行数据情况（没有换行符）\n        if (lines.length == 1) {\n            return handleSingleLineData(dataString, expectedFieldCount);\n        }\n\n        // 处理多行数据情况\n        return handleMultiLineData(lines, expectedFieldCount);\n    }\n\n    /**\n     * 处理单行银行交易数据\n     * @param dataString 单行数据字符串\n     * @param expectedFieldCount 预期的字段数量\n     * @return 解析后的交易记录列表\n     */\n    private static List<BankBcmTransaction> handleSingleLineData(String dataString, int expectedFieldCount) {\n        List<BankBcmTransaction> transactions = new ArrayList<>();\n\n        // 检查是否包含数据分隔符（确认是否为有效数据）\n        if (!dataString.contains(\"|\")) {\n            log.warn(\"单行银行交易记录数据格式无效，未找到字段分隔符\");\n            return transactions;\n        }\n\n        // 检查是否是\"表头+数据\"模式（包含字段名和具体数值）\n        if (isHeaderDataCombinedLine(dataString)) {\n            return handleHeaderDataCombinedLine(dataString, expectedFieldCount);\n        }\n\n        log.info(\"检测到单行银行交易记录数据，尝试解析\");\n\n        try {\n            // 尝试解析单行数据\n            BankBcmTransaction transaction = parseDataLine(dataString, 1);\n            if (transaction != null) {\n                transactions.add(transaction);\n                log.info(\"成功解析单行数据：流水号={}, 交易金额={}\",\n                        transaction.getSerialNumber(), transaction.getTransactionAmount());\n            } else {\n                log.warn(\"单行银行交易记录数据解析失败\");\n            }\n        } catch (Exception e) {\n            log.error(\"解析单行银行交易记录数据时发生异常\", e);\n        }\n\n        return transactions;\n    }\n\n    /**\n     * 判断是否是表头和数据合并在一行的情况\n     * @param dataString 单行数据字符串\n     * @return true如果是表头数据合并行，false否则\n     */\n    private static boolean isHeaderDataCombinedLine(String dataString) {\n        if (StringUtils.isBlank(dataString)) {\n            return false;\n        }\n\n        // 基本的表头特征关键词检查\n        String[] headerKeywords = {\"状态\", \"交易日期\", \"交易时间\", \"业务类型\", \"流水号\", \"账号\", \"户名\", \"收支标志\",\n                                 \"币种\", \"交易金额\", \"余额\", \"可用余额\", \"对方账号\", \"对方户名\", \"对方地址\"};\n\n        for (String keyword : headerKeywords) {\n            if (dataString.contains(keyword)) {\n                return true;\n            }\n        }\n\n        return false;\n    }\n\n    /**\n     * 处理表头和数据合并在一行的情况\n     * @param combinedLine 合并的表头和数据行\n     * @param expectedFieldCount 预期的字段数量\n     * @return 解析后的交易记录列表\n     */\n    private static List<BankBcmTransaction> handleHeaderDataCombinedLine(String combinedLine, int expectedFieldCount) {\n        List<BankBcmTransaction> transactions = new ArrayList<>();\n\n        log.info(\"检测到表头和数据合并在一行的情况，尝试提取并解析数据部分，预期字段数: {}\", expectedFieldCount);\n\n        try {\n            String[] fields = combinedLine.split(\"\\\\|\", -1);\n\n            // 检查是否包含多条数据记录\n            List<Integer> dataStartPositions = findDataStartPositions(fields, expectedFieldCount);\n\n            if (dataStartPositions.isEmpty()) {\n                log.warn(\"无法在合并行中找到有效的数据部分\");\n                return transactions;\n            }\n\n            log.info(\"检测到 {} 条数据记录在同一行中\", dataStartPositions.size());\n\n            // 解析每条数据记录\n            for (int recordIndex = 0; recordIndex < dataStartPositions.size(); recordIndex++) {\n                int dataStartPos = dataStartPositions.get(recordIndex);\n                int dataEndPos = (recordIndex == dataStartPositions.size() - 1)\n                    ? fields.length\n                    : dataStartPositions.get(recordIndex + 1);\n\n                // 构建单条数据行\n                StringBuilder dataBuilder = new StringBuilder();\n                for (int i = dataStartPos; i < dataEndPos; i++) {\n                    if (i > dataStartPos) {\n                        dataBuilder.append(\"|\");\n                    }\n                    dataBuilder.append(fields[i]);\n                }\n\n                String dataLine = dataBuilder.toString();\n                BankBcmTransaction transaction = parseDataLine(dataLine, recordIndex + 1, expectedFieldCount);\n                if (transaction != null) {\n                    transactions.add(transaction);\n                    log.info(\"成功解析第{}条数据记录：流水号={}, 交易金额={}, 交易日期={}\",\n                            recordIndex + 1, transaction.getSerialNumber(),\n                            transaction.getTransactionAmount(), transaction.getTransactionDate());\n                } else {\n                    log.warn(\"第{}条数据记录解析失败\", recordIndex + 1);\n                }\n            }\n\n        } catch (Exception e) {\n            log.error(\"解析表头数据合并行时发生异常\", e);\n        }\n\n        return transactions;\n    }\n\n    /**\n     * 查找所有数据记录的起始位置\n     * @param fields 分割后的字段数组\n     * @return 数据记录起始位置列表\n     */\n    private static List<Integer> findDataStartPositions(String[] fields) {\n        List<Integer> positions = new ArrayList<>();\n\n        // 预期的每条数据记录的大致字段数（基于表头字段数）\n        int approxFieldsPerRecord = 26;\n\n        // 如果字段总数接近预期记录的倍数，可能需要调整逻辑\n        if (fields.length <= approxFieldsPerRecord) {\n            // 如果字段总数不超过一条记录的长度，直接返回第一个数据位置\n            int firstDataPos = findFirstDataPosition(fields);\n            if (firstDataPos >= 0) {\n                positions.add(firstDataPos);\n            }\n            return positions;\n        }\n\n        // 对于大量字段，使用更智能的边界检测\n        for (int i = 0; i < fields.length - 10; i++) { // 留出足够的字段来检查模式\n            if (isDataSequenceStart(fields, i, approxFieldsPerRecord)) {\n                positions.add(i);\n                // 跳过近似的一条记录长度，避免重复检测\n                i += approxFieldsPerRecord - 5; // 留出一些重叠以应对字段数变化\n            }\n        }\n\n        return positions;\n    }\n\n    /**\n     * 判断是否是一个数据序列的开始\n     * @param fields 字段数组\n     * @param startPos 开始位置\n     * @param expectedFields 预期的字段数\n     * @return true如果是数据序列开始\n     */\n    private static boolean isDataSequenceStart(String[] fields, int startPos, int expectedFields) {\n        // 至少需要检查前几个字段的模式\n        if (startPos + 5 >= fields.length) {\n            return false;\n        }\n\n        // 检查前几个关键字段是否符合银行交易数据的模式\n        String status = fields[startPos].trim();\n        String date = fields[startPos + 1].trim();\n        String time = fields[startPos + 2].trim();\n        String amount = fields.length > startPos + 10 ? fields[startPos + 10].trim() : \"\";\n\n        // 状态字段应该是数字或特定值\n        if (!status.matches(\"[01YN]|正常|成功\")) {\n            return false;\n        }\n\n        // 日期字段应该是8位数字\n        if (!date.matches(\"\\\\d{8}\")) {\n            return false;\n        }\n\n        // 时间字段应该是6位数字\n        if (!time.matches(\"\\\\d{6}\")) {\n            return false;\n        }\n\n        // 可选：检查金额字段的格式\n        if (!amount.isEmpty() && !amount.matches(\"\\\\d+\\\\.\\\\d{2}\")) {\n            // 金额字段不是必须的，但如果存在应该是对的\n            if (amount.matches(\".*\\\\d.*\")) { // 至少要包含数字\n                // 可以认为是有效的\n            } else {\n                return false;\n            }\n        }\n\n        return true;\n    }\n\n    /**\n     * 查找第一个数据记录的起始位置\n     * @param fields 字段数组\n     * @return 第一个数据记录起始位置，-1表示未找到\n     */\n    private static int findFirstDataPosition(String[] fields) {\n        for (int i = 0; i < fields.length - 5; i++) {\n            if (isDataSequenceStart(fields, i, 26)) {\n                return i;\n            }\n        }\n        return -1;\n    }\n\n    /**\n     * 查找数据部分的开始位置\n     * @param fields 分割后的字段数组\n     * @return 数据开始位置，-1表示未找到\n     */\n    private static int findDataStartPosition(String[] fields) {\n        // 数据特征：通常包含具体的数值（日期、金额等）\n        for (int i = 0; i < fields.length; i++) {\n            String field = fields[i].trim();\n\n            // 检查字段是否看起来像数据（包含数字或特定格式）\n            if (looksLikeDataField(field)) {\n                return i;\n            }\n        }\n\n        return -1;\n    }\n\n    /**\n     * 判断字段是否看起来像数据字段\n     * @param field 字段值\n     * @return true如果像数据字段，false否则\n     */\n    private static boolean looksLikeDataField(String field) {\n        if (StringUtils.isBlank(field)) {\n            return false;\n        }\n\n        // 检查是否包含数字（交易金额、余额、日期等）\n        if (field.matches(\".*\\\\d.*\")) {\n            return true;\n        }\n\n        // 检查是否是特定格式的日期（如20251105）\n        if (field.matches(\"\\\\d{8}\")) {\n            return true;\n        }\n\n        // 检查是否是特定格式的时间（如093003）\n        if (field.matches(\"\\\\d{6}\")) {\n            return true;\n        }\n\n        // 检查是否是数字金额格式（如100.00）\n        if (field.matches(\"\\\\d+\\\\.\\\\d{2}\")) {\n            return true;\n        }\n\n        return false;\n    }\n\n    /**\n     * 处理多行银行交易数据\n     * @param lines 按行分割的数据数组\n     * @return 解析后的交易记录列表\n     */\n    private static List<BankBcmTransaction> handleMultiLineData(String[] lines) {\n        List<BankBcmTransaction> transactions = new ArrayList<>();\n\n        if (lines.length < 2) {\n            log.warn(\"银行交易记录数据行数不足，至少需要表头和一行数据\");\n            return transactions;\n        }\n\n        try {\n            log.info(\"开始解析银行交易记录，共发现 {} 条数据记录\", lines.length - 1);\n\n            // 跳过表头，直接处理数据行\n            for (int i = 1; i < lines.length; i++) {\n                String dataLine = lines[i].trim();\n                if (StringUtils.isBlank(dataLine)) {\n                    continue;\n                }\n\n                BankBcmTransaction transaction = parseDataLine(dataLine, i);\n                if (transaction != null) {\n                    transactions.add(transaction);\n                    log.info(\"成功解析第{}行数据：流水号={}, 交易金额={}\",\n                            i, transaction.getSerialNumber(), transaction.getTransactionAmount());\n                }\n            }\n\n        } catch (Exception e) {\n            log.error(\"解析银行交易记录时发生异常\", e);\n        }\n\n        log.info(\"银行交易记录解析完成，共解析 {} 条记录\", transactions.size());\n        return transactions;\n    }\n\n    /**\n     * 解析单行数据\n     *\n     * @param line 数据行内容\n     * @param lineNumber 行号\n     * @return 解析后的交易记录对象，解析失败返回null\n     */\n    private static BankBcmTransaction parseDataLine(String line, int lineNumber) {\n        try {\n            // 使用固定分隔符分割，保留所有空字段\n            String[] fields = line.split(FIELD_SEPARATOR, -1);\n\n            // 如果字段多于预期，可能是末尾有额外的空字段，截取前26个\n            if (fields.length > EXPECTED_FIELD_COUNT) {\n                log.warn(\"第{}行发现{}个字段，截取前{}个字段\", lineNumber, fields.length, EXPECTED_FIELD_COUNT);\n                fields = Arrays.copyOf(fields, EXPECTED_FIELD_COUNT);\n            } else if (fields.length < EXPECTED_FIELD_COUNT) {\n                log.error(\"第{}行字段不足：期望{}个，实际{}个\", lineNumber, EXPECTED_FIELD_COUNT, fields.length);\n                return null;\n            }\n\n            // 创建交易记录对象\n            BankBcmTransaction transaction = new BankBcmTransaction();\n\n            // 按固定位置设置字段值\n            transaction.setStatus(cleanField(fields[0]));\n            transaction.setTransactionDate(cleanField(fields[1]));\n            transaction.setTransactionTime(cleanField(fields[2]));\n            transaction.setBusinessType(cleanField(fields[3]));\n            transaction.setSerialNumber(cleanField(fields[4]));\n            transaction.setSequenceNumber(cleanField(fields[5]));\n            transaction.setAccountNumber(cleanField(fields[6]));\n            transaction.setAccountName(cleanField(fields[7]));\n            transaction.setIncomeExpenseFlag(cleanField(fields[8]));\n            transaction.setCurrency(cleanField(fields[9]));\n            transaction.setTransactionAmount(cleanField(fields[10]));\n            transaction.setBalance(cleanField(fields[11]));\n            transaction.setAvailableBalance(cleanField(fields[12]));\n            transaction.setCounterpartyAccount(cleanField(fields[13]));\n            transaction.setCounterpartyName(cleanField(fields[14]));\n            transaction.setCounterpartyAddress(cleanField(fields[15]));\n            transaction.setCounterpartyBankCode(cleanField(fields[16]));\n            transaction.setCounterpartyBankName(cleanField(fields[17]));\n            transaction.setBillType(cleanField(fields[18]));\n            transaction.setBillNumber(cleanField(fields[19]));\n            transaction.setBillName(cleanField(fields[20]));\n            transaction.setBillIssueDate(cleanField(fields[21]));\n            transaction.setRemarkMemo(cleanField(fields[22]));\n            transaction.setAdditionalRemark(cleanField(fields[23]));\n            transaction.setTransactionCode(cleanField(fields[24]));\n            transaction.setBackupField(cleanField(fields[25]));\n\n            return transaction;\n\n        } catch (Exception e) {\n            log.error(\"解析第{}行数据时发生异常\", lineNumber, e);\n            return null;\n        }\n    }\n\n    /**\n     * 清理字段值\n     *\n     * @param field 原始字段值\n     * @return 清理后的字段值\n     */\n    private static String cleanField(String field) {\n        return field != null ? field.trim() : \"\";\n    }\n\n    /**\n     * 打印解析结果（用于调试和验证）\n     *\n     * @param transactions 交易记录列表\n     */\n    public static void printParsingResult(List<BankBcmTransaction> transactions) {\n        log.info(\"=== 银行交易记录解析结果 ===\");\n        log.info(\"共解析出 {} 条交易记录\", transactions.size());\n\n        if (transactions.isEmpty()) {\n            log.info(\"没有解析到有效的交易记录\");\n            return;\n        }\n\n        for (int i = 0; i < Math.min(transactions.size(), 5); i++) {\n            BankBcmTransaction transaction = transactions.get(i);\n            log.info(\"第 {} 条记录:\", i + 1);\n            log.info(\"  状态: {}\", transaction.getStatus());\n            log.info(\"  交易日期: {}\", transaction.getTransactionDate());\n            log.info(\"  交易时间: {}\", transaction.getTransactionTime());\n            log.info(\"  业务类型: {}\", transaction.getBusinessType());\n            log.info(\"  流水号: {}\", transaction.getSerialNumber());\n            log.info(\"  账号: {}\", maskAccountNumber(transaction.getAccountNumber()));\n            log.info(\"  户名: {}\", transaction.getAccountName());\n            log.info(\"  收支标志: {}\", transaction.getIncomeExpenseFlag());\n            log.info(\"  交易金额: {}\", transaction.getTransactionAmount());\n            log.info(\"  余额: {}\", transaction.getBalance());\n            log.info(\"  附言: {}\", transaction.getRemarkMemo());\n            log.info(\"---\");\n        }\n        if (transactions.size() > 5) {\n            log.info(\"... 省略 {} 条记录\", transactions.size() - 5);\n        }\n    }\n\n    /**\n     * 脱敏处理账号信息（用于日志输出）\n     *\n     * @param accountNumber 原始账号\n     * @return 脱敏后的账号\n     */\n    private static String maskAccountNumber(String accountNumber) {\n        if (StringUtils.isBlank(accountNumber) || accountNumber.length() <= 8) {\n            return accountNumber;\n        }\n        return accountNumber.substring(0, 4) + \"****\" + accountNumber.substring(accountNumber.length() - 4);\n    }\n\n    /**\n     * 测试方法 - 验证行分隔符兼容性\n     */\n    public static void testLineSeparatorCompatibility() {\n        String testData = \"状态|交易日期|交易时间|业务类型|流水号|顺序号|账号|户名|收支标志|币种|交易金额|余额|可用余额|对方账号|对方户名||对方银行号|对方银行名称|票据类型|票据号码|票据名称|票据开票日|附言|附加附言|交易代码|备用字段\";\n\n        // 测试Unix换行符(\\n)\n        String unixStyle = testData + \"\\n\" + \"正常|20250110|143000|转账|001|1|123456789|测试用户|1|CNY|100.00|1000.00|1000.00|987654321|对方用户||301290000007|XX银行|0|||20250110|测试备注||301290001||||\";\n        List<BankBcmTransaction> unixResult = parseBankTransactions(unixStyle);\n        log.info(\"Unix换行符测试结果: {}条记录\", unixResult.size());\n\n        // 测试Windows换行符(\\r\\n)\n        String windowsStyle = testData + \"\\r\\n\" + \"正常|20250110|143000|转账|002|1|123456789|测试用户|1|CNY|200.00|1000.00|1000.00|987654321|对方用户||301290000007|XX银行|0|||20250110|测试备注||301290001||||\";\n        List<BankBcmTransaction> windowsResult = parseBankTransactions(windowsStyle);\n        log.info(\"Windows换行符测试结果: {}条记录\", windowsResult.size());\n\n        // 测试Mac换行符(\\r)\n        String macStyle = testData + \"\\r\" + \"正常|20250110|143000|转账|003|1|123456789|测试用户|1|CNY|300.00|1000.00|1000.00|987654321|对方用户||301290000007|XX银行|0|||20250110|测试备注||301290001||||\";\n        List<BankBcmTransaction> macResult = parseBankTransactions(macStyle);\n        log.info(\"Mac换行符测试结果: {}条记录\", macResult.size());\n\n        // 测试单行数据（无换行符）\n        String singleLine = \"正常|20250110|143000|转账|004|1|123456789|测试用户|1|CNY|400.00|1000.00|1000.00|987654321|对方用户||301290000007|XX银行|0|||20250110|单行测试备注||301290001||||\";\n        List<BankBcmTransaction> singleResult = parseBankTransactions(singleLine);\n        log.info(\"单行数据测试结果: {}条记录\", singleResult.size());\n\n        log.info(\"=== 行分隔符兼容性测试完成 ===\");\n    }\n}",
