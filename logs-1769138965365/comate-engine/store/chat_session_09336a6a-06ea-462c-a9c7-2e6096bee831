tatusList\", statusList);\n        result.put(\"bankList\", bankList);\n        result.put(\"companyList\", cnmpanyList);\n        result.put(\"dealList\", dealList);\n        result.put(\"bankUrlList\", bankUrlList);\n        result.put(\"bankQuotaList\", bankQuotaList);\n\n        return result;\n    }\n\n    @Override\n    public BigDecimal calculateAvailableQuota(PmcPortalRemainQuotaQO qo) {\n        BigDecimal availableQuota;\n        // 1. 获取供应商额度\n        Example example = new Example(PmcFinanceSupplierQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n        criteria.andEqualTo(\"supplierCode\", qo.getSupplierCode());\n        criteria.andEqualTo(\"financeFlag\", \"Y\");\n        criteria.andGreaterThanOrEqualTo(\"effectiveEndDate\", new Date());\n        criteria.andLessThanOrEqualTo(\"effectiveStartDate\", new Date());\n        List<PmcFinanceSupplierQuotaSet> pmcFinanceSupplierQuotaSet\n                = pmcFinanceSupplierQuotaSetMapper.selectByExample(example);\n        if (CollectionUtils.isEmpty(pmcFinanceSupplierQuotaSet)) {\n            log.info(\"供应商{}额度计算，无额度配置\", qo.getSupplierCode());\n            return BigDecimal.ZERO;\n        }\n        availableQuota = pmcFinanceSupplierQuotaSet.get(0).getCreditQuota();\n\n        // 2. 获取已占用金额\n        BigDecimal usedQuota = getUseFinancingAmt(qo.getSupplierCode(), \"\", \"\", \"\");\n\n        // 3. 获取主体剩余额度\n        if (StringUtils.isNotBlank(qo.getCompanyCode()) && StringUtils.isNotBlank(qo.getBankCode())) {\n            List<PmcFinanceCompQuotaSet> compQuotaSet = queryValidCompQuotaSet(qo.getBankCode(), qo.getCompanyCode());\n            if (CollectionUtils.isNotEmpty(compQuotaSet)) {\n                log.info(\"供应商:{},供应商额度:{},主体额度:{},已用额度:{}\", qo.getSupplierCode(),\n                        availableQuota, compQuotaSet.get(0).getAvailableFinancingQuota(), usedQuota);\n                if (availableQuota.subtract(usedQuota).compareTo(compQuotaSet.get(0).getAvailableFinancingQuota()) > 0) {\n                    return compQuotaSet.get(0).getAvailableFinancingQuota();\n                }\n            } else {\n                log.info(\"主体{},银行{}额度计算，无额度配置\", qo.getCompanyCode(), qo.getBankCode());\n                return BigDecimal.ZERO;\n            }\n        }\n        return availableQuota.subtract(usedQuota);\n    }\n\n    /**\n     * 根据银行代码、公司代码查询有效的公司额度设置\n     * @param bankCode 银行代码\n     * @param companyCode 公司代码\n     * @return 符合条件的公司额度设置列表\n     */\n    private List<PmcFinanceCompQuotaSet> queryValidCompQuotaSet(String bankCode, String companyCode) {\n        Example exampleComp = new Example(PmcFinanceCompQuotaSet.class);\n        Example.Criteria criteriaComp = exampleComp.createCriteria();\n        criteriaComp.andEqualTo(\"bankCode\", bankCode);\n        criteriaComp.andEqualTo(\"companyCode\", companyCode);\n        criteriaComp.andEqualTo(\"enableFlag\", \"Y\");\n        return pmcFinanceCompQuotaSetMapper.selectByExample(exampleComp);\n    }\n\n    /**\n     * 供应商模糊查询建议\n     *\n     * @param parameter 查询参数对象，至少需要包含以下一个字段：\n     *                  - supplierCode 供应商编码(模糊匹配)",
