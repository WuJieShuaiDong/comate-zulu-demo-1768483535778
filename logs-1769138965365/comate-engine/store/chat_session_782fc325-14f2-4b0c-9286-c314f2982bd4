                "basename": "CmbFinancingServiceImpl.java",
                "originalContent": "package com.baidu.pmc.core.service.impl;\n\nimport com.baidu.microschedule.client.annotation.MicroScheduleExecutor;\nimport com.baidu.microschedule.client.context.MicroScheduleContext;\nimport com.baidu.microschedule.client.logger.Logger;\nimport com.baidu.pmc.common.ResponseMessage;\nimport com.baidu.pmc.common.utils.BeanUtils;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.common.utils.UtilType;\nimport com.baidu.pmc.core.constants.Constants;\nimport com.baidu.pmc.core.constants.Constants.CoType;\nimport com.baidu.pmc.core.constants.Constants.FunCode;\nimport com.baidu.pmc.core.dto.AttachmentBindRequest;\nimport com.baidu.pmc.core.dto.AttachmentBindResponse;\nimport com.baidu.pmc.core.dto.AttachmentBindResponse.BindResult;\nimport com.baidu.pmc.core.dto.AttachmentBindResponse.BindResultDetail;\nimport com.baidu.pmc.core.dto.CmbResponse;\nimport com.baidu.pmc.core.dto.CmbResponseHead;\nimport com.baidu.pmc.core.dto.FileUploadRequest;\nimport com.baidu.pmc.core.dto.FileUploadResponse;\nimport com.baidu.pmc.core.dto.FinanceApplyQueryRequest;\nimport com.baidu.pmc.core.dto.FinanceApplyQueryResponse;\nimport com.baidu.pmc.core.dto.FinanceApplyRequest;\nimport com.baidu.pmc.core.dto.FinanceApplyResponse;\nimport com.baidu.pmc.core.dto.FinanceEstimateRequest;\nimport com.baidu.pmc.core.dto.FinanceEstimateRequest.FinanceEstimateItem;\nimport com.baidu.pmc.core.dto.FinancingEstimateResponse;\nimport com.baidu.pmc.core.dto.FinancingEstimateResponse.FinancingEstimateResponsePartA;\nimport com.baidu.pmc.core.dto.FinancingEstimateResponse.FinancingEstimateResponsePartB;\nimport com.baidu.pmc.core.dto.FinancingQuotaQryRequest;\nimport com.baidu.pmc.core.dto.FinancingQuotaQryResponse;\nimport com.baidu.pmc.core.dto.FinancingQuotaQryResponse.FinancingQuota;\nimport com.baidu.pmc.core.service.CmbFinancingService;\nimport com.baidu.pmc.core.service.PayChecksHisService;\nimport com.baidu.pmc.core.service.PayChecksWriteBackService;\nimport com.baidu.pmc.persistence.commons.WkExample;\nimport com.baidu.pmc.persistence.dao.PmcAccountMapper;\nimport com.baidu.pmc.persistence.dao.PmcFinanceSupplierApplyHisMapper;\nimport com.baidu.pmc.persistence.dao.PmcFinanceSupplierApplyMapper;\nimport com.baidu.pmc.persistence.dao.PmcPayChecksMapper;\nimport com.baidu.pmc.persistence.domain.PmcAccount;\nimport com.baidu.pmc.pojo.constants.PayNode;\nimport com.baidu.pmc.pojo.constants.PayOperation;\nimport com.baidu.pmc.pojo.constants.PayStatus;\nimport com.baidu.pmc.pojo.constants.SupplierFinancingApplyStatus;\nimport com.baidu.pmc.pojo.dto.cmb.FinanceQuotaDTO;\nimport com.baidu.pmc.pojo.dto.cmb.FinancingApplyResultDTO;\nimport com.baidu.pmc.pojo.dto.cmb.FinancingApplyResultQueryDTO;\nimport com.baidu.pmc.pojo.dto.cmb.FinancingEstimateResultDTO;\nimport com.baidu.pmc.pojo.dto.cmb.PmcCmbCloudDirectQO;\nimport com.baidu.pmc.pojo.model.PmcFinanceSupplierApply;\nimport com.baidu.pmc.pojo.model.PmcFinanceSupplierApplyHis;\nimport com.baidu.pmc.pojo.model.PmcPayChecks;\nimport com.baidu.pmc.pojo.qo.PmcFinanceBankBaseQO;\nimport com.fasterxml.jackson.core.type.TypeReference;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections.CollectionUtils;\nimport org.apache.commons.lang3.RandomStringUtils;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.beans.factory.annotation.Value;\nimport org.springframework.stereotype.Service;\nimport org.springframework.transaction.annotation.Transactional;\nimport tk.mybatis.mapper.entity.Example;\n\nimport java.math.BigDecimal;\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.Collections;\nimport java.util.Date;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Objects;\n\n@Slf4j\n@Service\npublic class CmbFinancingServiceImpl implements CmbFinancingService {\n\n    @Value(\"${cmb.bank.core.id}\")\n    private String bankCoreId;\n\n    @Value(\"${cmb.bank.machine:CMB002}\")\n    private String bankMachine; // 测试使用CMB002\n\n    @Autowired\n    private CmbCloudDirectBaseService baseService;\n\n    @Autowired\n    private PmcFinanceSupplierApplyMapper pmcFinanceSupplierApplyMapper;\n    @Autowired\n    private PmcPayChecksMapper pmcPayChecksMapper;\n    @Autowired\n    private PmcAccountMapper pmcAccountMapper;\n    @Autowired\n    private PayChecksWriteBackService payChecksWriteBackService;\n\n    @Autowired\n    private PmcFinanceSupplierApplyHisMapper pmcFinanceSupplierApplyHisMapper;\n\n    @Autowired\n    private PayChecksHisService payChecksHisService;\n\n    @Override\n    public ResponseMessage financingEstimate(PmcFinanceBankBaseQO calcQO) {\n        String currency = Constants.Currency.getCmbCode(calcQO.getCurrency());\n        if (StringUtils.isBlank(currency)) {\n            return ResponseMessage.fail(\"不支持的币种类型\");\n        }\n        FinanceEstimateRequest request = new FinanceEstimateRequest();\n        FinanceEstimateItem item = new FinanceEstimateItem();\n        item.setCoreid(bankCoreId);\n        item.setCotype(CoType.CORE_ENT.getCode());\n        item.setSmfcod(calcQO.getRegistrationCode());\n        item.setMaxedt(DateUtils.formatDate(calcQO.getPayPlanDate(), \"yyyyMMdd\"));\n        item.setFinamt(calcQO.getFinanceAmount());    // 融资合计金额\n        item.setDocamt(calcQO.getDocAmt());    // 应付账款合计金额\n        item.setBilamt(calcQO.getBilAmt());    // 票面合计金额\n        item.setDocnum(1);  // 固定为 1\n        item.setFinccy(currency);\n        request.setTdorpcalx(Collections.singletonList(item));\n\n        PmcCmbCloudDirectQO qo = buildCloudDirectQo(calcQO);\n        CmbResponse<FinancingEstimateResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FINANCING_CAL.getCode(), request, qo,\n                    new TypeReference<CmbResponse<FinancingEstimateResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"fail to get financing cal result， request: {}\", UtilType.bean2Json(request), e);\n        }\n        if (Objects.isNull(response)) {\n            log.error(\"fail to get financing cal result, request: {}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"融资测算请求失败\");\n        }\n        FinancingEstimateResponse estimateResponse = response.getResponse().getBody();\n        List<FinancingEstimateResponsePartA> partAList = estimateResponse.getTdorpcaly();\n        List<FinancingEstimateResponsePartB> partBList = estimateResponse.getTdorpcalz();\n\n        // todo:把 response 转换成需要的统一格式结果\n        FinancingEstimateResultDTO estimateResult = new FinancingEstimateResultDTO();\n        if (CollectionUtils.isNotEmpty(partAList)) {\n            FinancingEstimateResponsePartA partA = partAList.get(0);\n            estimateResult.setCurrency(Constants.Currency.cmbCode2Code(partA.getFinccy()));\n            estimateResult.setEndDate(partA.getEnddat());\n            estimateResult.setFinanceAmount(partA.getFinamt());\n            estimateResult.setFinanceRate(partA.getFinrat());\n            estimateResult.setFinancePercent(partA.getFinpro());\n            estimateResult.setSettlementMode(partA.getSetmod());    // todo:映射\n        }\n        if (CollectionUtils.isNotEmpty(partBList)) {\n            FinancingEstimateResponsePartB partB = partBList.get(0);\n            estimateResult.setFeeAmount(partB.getFeeamt());\n            estimateResult.setFeeRate(partB.getFerate());\n            estimateResult.setFeeType(partB.getFeetyp());   // todo:映射\n            estimateResult.setPayAccount(partB.getPayacc());\n            estimateResult.setPayRate(partB.getSfnrat());\n            estimateResult.setPayAmount(partB.getSfnamt());\n            estimateResult.setOtherAmount(partB.getOthamt());\n        }\n        return ResponseMessage.success(estimateResult);\n    }\n\n    @Override\n    public ResponseMessage financingApply(PmcFinanceBankBaseQO submitQO) {\n        String currency = Constants.Currency.getCmbCode(submitQO.getCurrency());\n        if (StringUtils.isBlank(currency)) {\n            return ResponseMessage.fail(\"不支持的币种类型\");\n        }\n        FinanceApplyRequest request = new FinanceApplyRequest();\n\n        FinanceApplyRequest.FinanceApplyItemBase item = new FinanceApplyRequest.FinanceApplyItemBase();\n        item.setCoreid(bankCoreId);\n        item.setCotype(CoType.CORE_ENT.getCode());\n        item.setYurref(submitQO.getFinanceNumber());\n        item.setSmfcod(submitQO.getRegistrationCode());\n        // 固定为 02310100：国内保理\n        item.setBiztyp(StringUtils.isBlank(submitQO.getBizType()) ? \"02310100\" : submitQO.getBizType());\n        item.setFinccy(currency);\n        request.setTdorpaddx(Collections.singletonList(item));\n\n        FinanceApplyRequest.FinanceApplyItemCont itemCont = new FinanceApplyRequest.FinanceApplyItemCont();\n\n        itemCont.setSmfacc(submitQO.getSupplierAccount());\n        itemCont.setSmfbak(submitQO.getSupplierBank());\n        itemCont.setSmfadd(submitQO.getSupplierAddress());\n        itemCont.setRevCcy(currency);\n        itemCont.setRevamt(submitQO.getPayableAmount());\n        itemCont.setPrdexp(submitQO.getPayPlanDate());\n        itemCont.setDocamt(submitQO.getDocumentAmount());\n        itemCont.setDocuid(submitQO.getInvoiceNumber());\n        // 01订单、02结算单、03发票、04付款承诺、05其他\n        itemCont.setDoctyp(StringUtils.isBlank(submitQO.getInvoiceType()) ? \"03\" : submitQO.getInvoiceType());\n        request.setTdorpaddy(Collections.singletonList(itemCont));\n\n        PmcCmbCloudDirectQO qo = buildCloudDirectQo(submitQO);\n        CmbResponse<FinanceApplyResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FINANCING_APPLY.getCode(), request, qo,\n                    new TypeReference<CmbResponse<FinanceApplyResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"融资申请->fail to get financing cal result， request: {}\", UtilType.bean2Json(request), e);\n            return ResponseMessage.fail(\"发送招行融资申请接口失败!\");\n\n        }\n        if (Objects.isNull(response) || Objects.isNull(response.getResponse())) {\n            log.error(\"融资申请->fail to get financing cal result, request: {}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"融资申请请求失败，response/response.getResponse() 返回为空\");\n        }\n        FinanceApplyResponse applyResponse = response.getResponse().getBody();\n        CmbResponseHead head = response.getResponse().getHead();\n        String msg = \"\";\n        if (Objects.nonNull(head)) {\n            msg = head.getResultmsg();\n        }\n        if (Objects.isNull(applyResponse)) {\n            log.error(\"融资申请->fail to get financing cal result getBody, request: {},  response: {} \",\n                    UtilType.bean2Json(request), UtilType.bean2Json(response));\n            return ResponseMessage.fail(\"融资申请请求失败 response body 为空\" + msg);\n        }\n        FinancingApplyResultDTO resultDTO = new FinancingApplyResultDTO();\n        List<FinanceApplyResponse.MainResponse> mainResponseList = applyResponse.getTdorpaddz();\n        if (CollectionUtils.isNotEmpty(mainResponseList)) {\n            FinanceApplyResponse.MainResponse mainResponse = mainResponseList.get(0);\n            if (!\"SCDS000\".equals(mainResponse.getRtncod())) {\n                log.error(\"融资申请->fail to get financing cal result, request: {}, response: {}\",\n                        UtilType.bean2Json(request), UtilType.bean2Json(response));\n                return ResponseMessage.fail(\"融资申请请求结果失败 错误编码 {\"+mainResponse.getRtncod()+\"}, \" +\n                        \"错误信息 {\"+mainResponse.getRtnmsg()+\"} \");\n            }\n            resultDTO.setFinanceNumber(mainResponse.getFinnbr());\n            resultDTO.setFinanceCode(mainResponse.getRtncod());\n            resultDTO.setFinanceMessage(mainResponse.getRtnmsg());\n        } else {\n            log.error(\"融资申请->fail to get financing cal result getTdorpaddz, request: {}, response: {}\",\n                    UtilType.bean2Json(request), UtilType.bean2Json(response));\n            return ResponseMessage.fail(\"融资申请请求结果失败 response getTdorpaddz() 为空\"  + msg);\n        }\n        if (StringUtils.isNotBlank(resultDTO.getFinanceNumber())) {\n            pmcFinanceSupplierApplyMapper.updateBankApplyNumber(resultDTO.getFinanceNumber()\n                    , submitQO.getApplyNumber());\n            log.info(\"融资申请->update bank_apply_number success: {} by apply_number: {}\", resultDTO.getFinanceNumber(),\n                    submitQO.getApplyNumber());\n        } else {\n            log.error(\"融资申请->update bank_apply_number failed: {} by apply_number: {}\", resultDTO.getFinanceNumber(),\n                    submitQO.getApplyNumber());\n            return ResponseMessage.fail(\"融资申请请求结果失败 返回银行融资编号bank_apply_number为空\");\n        }\n        return ResponseMessage.success(resultDTO);\n    }\n\n    @Override\n    public ResponseMessage financingApplyDetails(PmcFinanceBankBaseQO submitQO) {\n\n        FinanceApplyQueryRequest request = new FinanceApplyQueryRequest();\n\n        FinanceApplyQueryRequest.FinanceApplyItemBase item = new FinanceApplyQueryRequest.FinanceApplyItemBase();\n        item.setCoreid(bankCoreId);\n        item.setCotype(CoType.CORE_ENT.getCode());\n        item.setFinnbr(submitQO.getFinanceNumber());\n        request.setTdorpquyx(Collections.singletonList(item));\n\n        PmcCmbCloudDirectQO qo = buildCloudDirectQo(submitQO);\n        CmbResponse<FinanceApplyQueryResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FINANCING_APPLY_DETAILS.getCode(), request, qo,\n                    new TypeReference<CmbResponse<FinanceApplyQueryResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"融资结果查询->fail to get financing cal result， request: {}\", UtilType.bean2Json(request), e);\n            return ResponseMessage.fail(\"融资申请结果查询失败\");\n\n        }\n        if (Objects.isNull(response)) {\n            log.error(\"融资结果查询->fail to get financing cal result, request: {}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"融资申请查询失败\");\n        }\n        // todo:把 response 转换成需要的统一格式结果\n        FinancingApplyResultQueryDTO resultQueryDTO = new FinancingApplyResultQueryDTO();\n\n        FinanceApplyQueryResponse applyResponse = response.getResponse().getBody();\n        if (applyResponse == null) {\n            log.error(\"融资结果查询->fail to get financing cal result, request: {}, response {}\",\n                    UtilType.bean2Json(request), UtilType.bean2Json(response));\n            return ResponseMessage.fail(\"融资申请查询失败\");\n        }\n        List<FinanceApplyQueryResponse.ContInfo> contInfos = applyResponse.getTdorpquyy();\n        List<FinanceApplyQueryResponse.FeeInfo> feeInfos = applyResponse.getTdorpquyz();\n        List<FinanceApplyQueryResponse.DocumentInfo> documentInfos = applyResponse.getTdorpquyw();\n        if (CollectionUtils.isNotEmpty(contInfos)) {\n            FinanceApplyQueryResponse.ContInfo contInfo = contInfos.get(0);\n            resultQueryDTO.setTransferRequestId(contInfo.getTreqid());\n            resultQueryDTO.setCoreCorpCode(contInfo.getCorcod());\n            resultQueryDTO.setCoreCorpName(contInfo.getCornam());\n            resultQueryDTO.setTotalCount(contInfo.getTotsum());\n            resultQueryDTO.setTotalAmount(contInfo.getTotamt());\n            resultQueryDTO.setSupplierName(contInfo.getSmfnam());\n            resultQueryDTO.setSupplierCode(contInfo.getSmfcod());\n            resultQueryDTO.setApplyDate(contInfo.getOpdate());\n            resultQueryDTO.setDueDate(contInfo.getEnddat());\n            resultQueryDTO.setLoanStartDate(contInfo.getRelopd());\n            resultQueryDTO.setLoanEndDate(contInfo.getRelend());\n            resultQueryDTO.setFinanceAmount(contInfo.getFinamt());\n            resultQueryDTO.setFinanceType(contInfo.getFintyp());\n            resultQueryDTO.setSource(contInfo.getSource());\n            resultQueryDTO.setBusinessType(contInfo.getBiztyp());\n            resultQueryDTO.setOperationStatus(contInfo.getOprsts());\n            resultQueryDTO.setCurrency(Constants.Currency.cmbCode2Code(contInfo.getFinccy()));\n            resultQueryDTO.setFinanceRate(contInfo.getFinrat());\n            resultQueryDTO.setInterest(contInfo.getIntere());\n        }\n        if (CollectionUtils.isNotEmpty(feeInfos)) {\n            FinanceApplyQueryResponse.FeeInfo feeInfo = feeInfos.get(0);\n            resultQueryDTO.setFeeRate(feeInfo.getFerate());\n            resultQueryDTO.setFeeAmount(feeInfo.getFeeamt());\n            resultQueryDTO.setPaymentMethod(feeInfo.getPaytra());\n            resultQueryDTO.setPaymentAccount(feeInfo.getPayacc());\n            resultQueryDTO.setFeeType(feeInfo.getFeetyp());\n            resultQueryDTO.setServiceProviderName(feeInfo.getSernam());\n            resultQueryDTO.setServiceAccount(feeInfo.getSeracc());\n            resultQueryDTO.setBankName(feeInfo.getOpname());\n        }\n        if (CollectionUtils.isNotEmpty(documentInfos)) {\n            FinanceApplyQueryResponse.DocumentInfo documentInfo = documentInfos.get(0);\n            resultQueryDTO.setSupplierAccount(documentInfo.getSmfacc());\n            resultQueryDTO.setSupplierCode(documentInfo.getSmfcod());\n            resultQueryDTO.setSupplierBank(documentInfo.getSmfbak());\n            resultQueryDTO.setSupplierAddress(documentInfo.getSmfadd());\n            resultQueryDTO.setContractId(documentInfo.getContid());\n            resultQueryDTO.setContractName(documentInfo.getConnam());\n            resultQueryDTO.setDocumentId(documentInfo.getDocuid());\n            resultQueryDTO.setDocumentAmount(documentInfo.getDocamt());\n            resultQueryDTO.setPayableAmount(documentInfo.getRevamt());\n            resultQueryDTO.setPayableStartDate(documentInfo.getCaltim());\n            resultQueryDTO.setDocumentType(documentInfo.getDoctyp());\n            resultQueryDTO.setBuyerAccount(documentInfo.getBuyacc());\n            resultQueryDTO.setRemark(documentInfo.getRemark());\n            resultQueryDTO.setPayPlanDate(documentInfo.getPrdexp());\n        }\n        return ResponseMessage.success(resultQueryDTO);\n    }\n\n    @Override\n    public ResponseMessage financingQuotaQuery(PmcFinanceBankBaseQO queryQO) {\n        FinancingQuotaQryRequest request = new FinancingQuotaQryRequest();\n        FinancingQuotaQryRequest.FinancingQuotaQry quotaQry = new FinancingQuotaQryRequest.FinancingQuotaQry();\n        quotaQry.setCoreid(bankCoreId);\n        // quotaQry.setCrdtid(bankCreditId);\n        quotaQry.setCotype(CoType.CORE_ENT.getCode());\n        request.setPchxcquyx(Collections.singletonList(quotaQry));\n        PmcCmbCloudDirectQO qo = buildCloudDirectQo(queryQO);\n        CmbResponse<FinancingQuotaQryResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FINANCING_QUOTA_QRY.getCode(), request, qo,\n                    new TypeReference<CmbResponse<FinancingQuotaQryResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"融资额度查询->fail to query financing quota, request :{}\", UtilType.bean2Json(request), e);\n            return ResponseMessage.fail(\"招行云直联查询额度失败\");\n\n        }\n        if (Objects.isNull(response)) {\n            log.error(\"融资额度查询->fail to query financing quota, request :{}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"招行云直联查询额度失败\");\n        }\n        FinanceQuotaDTO quotaDTO = new FinanceQuotaDTO();\n        FinancingQuotaQryResponse quotaRes = response.getResponse().getBody();\n        if (Objects.nonNull(quotaRes)) {\n            List<FinancingQuota> quotas = quotaRes.getPchxcquyw();\n            if (CollectionUtils.isEmpty(quotas)) {\n                // todo zzb 测试环境先写死数据，后续测试该逻辑\n                quotas = new ArrayList<>();\n                FinancingQuota test = new FinancingQuota();\n                test.setEavamt(new BigDecimal(99999));\n                quotas = new ArrayList<>();\n                quotas.add(test);\n                // return ResponseMessage.fail(\"招行云直联未返回结果\");\n            }\n            FinancingQuota quota = quotas.get(0);\n            quotaDTO.setCurrency(Constants.Currency.cmbCode2Code(quota.getExoccy()));\n            quotaDTO.setCreditType(quota.getCrdtyp());\n            quotaDTO.setStartDate(quota.getStadat());\n            quotaDTO.setEndDate(quota.getEnddat());\n            quotaDTO.setIsExop(quota.getIsexop());\n            quotaDTO.setExoAmount(quota.getExoamt());\n            quotaDTO.setExoUsedAmount(quota.getEudamt());\n            quotaDTO.setExoAvailableAmount(quota.getEavamt());\n            quotaDTO.setCreditAmount(quota.getCrdamt());\n            quotaDTO.setCreditUsedAmount(quota.getCudamt());\n            quotaDTO.setCreditAvailableAmount(quota.getCavamt());\n            quotaDTO.setCreditStatus(quota.getCrests());\n        }\n        return ResponseMessage.success(quotaDTO);\n    }\n\n    @Override\n    public ResponseMessage uploadAttachment(PmcFinanceBankBaseQO uploadQO) {\n        // todo: 上传合同和发票，改为供应商在银行上传，展示不用接入\n        if (StringUtils.isBlank(uploadQO.getFilePath())) {\n            return ResponseMessage.fail(\"缺少附件信息\");\n        }\n        FileUploadRequest request = new FileUploadRequest();\n        request.setFilepath(uploadQO.getFilePath());\n        CmbResponse<FileUploadResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FILE_UPLOAD.getCode(), request, buildCloudDirectQo(uploadQO),\n                    new TypeReference<CmbResponse<FileUploadResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"融资上传->ffail to upload\");\n            return ResponseMessage.fail(\"附件上传失败\");\n        }\n        if (Objects.isNull(response)) {\n            log.error(\"融资上传->fail to upload file, response is empty, request :{}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"附件上传失败\");\n        }\n        FileUploadResponse uploadResponse = response.getResponse().getBody();\n        String fileKey = uploadResponse.getFilkey();\n        if (StringUtils.isBlank(fileKey)) {\n            return ResponseMessage.fail(\"文件上传失败\");\n        }\n        return ResponseMessage.success(fileKey);\n    }\n\n    @Override\n    public ResponseMessage attachmentRelate(PmcFinanceBankBaseQO supplementQO) {\n\n        AttachmentBindRequest request = new AttachmentBindRequest();\n        AttachmentBindRequest.ApplyInfo applyInfo = new AttachmentBindRequest.ApplyInfo();  // 融资申请部分\n        applyInfo.setCoreid(bankCoreId);\n        applyInfo.setBscode(Constants.FunCode.FINANCING_APPLY.getCode());   // 这里固定为融资申请\n        applyInfo.setYurref(supplementQO.getPayCheckNum()); // 业务参考号，取付款清单号\n        applyInfo.setRelyrf(supplementQO.getPayCheckNum()); // todo:关联的融资申请业务参考号,这里还要确定一下取哪个\n        // todo:是否支持多个附件\n        AttachmentBindRequest.AttachmentInfo attachmentInfo = new AttachmentBindRequest.AttachmentInfo();   // 附件部分\n        attachmentInfo.setAtthid(supplementQO.getAttachmentNumber());\n        attachmentInfo.setAtthnm(supplementQO.getAttachmentName());\n        request.setPcclbsatx(Collections.singletonList(applyInfo));\n        request.setPcclbsaty(Collections.singletonList(attachmentInfo));\n\n        PmcCmbCloudDirectQO qo = buildCloudDirectQo(supplementQO);\n        CmbResponse<AttachmentBindResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FINANCING_ATTACH_BIND.getCode(), request, qo,\n                    new TypeReference<CmbResponse<AttachmentBindResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"融资附件业务绑定->fail to bind attachment\", e);\n            return ResponseMessage.fail(\"附件绑定业务失败\");\n\n        }\n        if (Objects.isNull(response)) {\n            log.error(\"融资附件业务绑定->fail to bind attachment, response is empty, request :{}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"附件绑定业务失败\");\n        }\n        AttachmentBindResponse bindResponse = response.getResponse().getBody();\n        List<BindResult> bindResult = bindResponse.getPcclbsatz();\n        if (CollectionUtils.isEmpty(bindResult)) {\n            return ResponseMessage.fail(\"附件绑定业务请求异常\");\n        }\n        if (Constants.CmbResponseCode.BIND_SUCCESS_CODE.equals(bindResult.get(0).getRtncod())) {\n            return ResponseMessage.success(\"绑定成功\");\n        }\n        List<BindResultDetail> details = bindResponse.getPcclbsatw();\n        StringBuilder builder = new StringBuilder();\n        if (CollectionUtils.isNotEmpty(details)) {\n            details.forEach(detail -> {\n                builder.append(detail.getAtthid()).append(\":\").append(detail.getErrmsg()).append(\";\");\n            });\n        }\n        return ResponseMessage.fail(builder.toString());\n    }\n\n    private PmcCmbCloudDirectQO buildCloudDirectQo(PmcFinanceBankBaseQO bankBaseQO) {\n        PmcCmbCloudDirectQO qo = new PmcCmbCloudDirectQO();\n        String acc = RandomStringUtils.randomAlphanumeric(10);\n        if (StringUtils.isNotBlank(bankBaseQO.getBuyerAccount())) {\n            acc = bankBaseQO.getBuyerAccount();\n        }\n        qo.setMachineBank(bankMachine);\n        qo.setAccnbr(acc);\n        qo.setYurref(bankBaseQO.getYurref());   // 作为reqid参数，要求前17位是yyyyMMddHHmmssSSS格式，有前置机可以不传\n        return qo;\n    }\n\n\n    /**\n     * 定时刷新融资申请结果查询\n     */\n    @Override\n    @MicroScheduleExecutor(code = \"getCmbFinancingResultJob\")\n    public void getFinancingResultJob() {\n        Logger logger = MicroScheduleContext.currentTaskContext().getLogger();\n        logger.info(\"*****定时刷新融资申请结果查询开始*******\");\n        queryAllFinancingResult();\n        logger.info(\"*****定时刷新融资申请结果查询结束*******\");\n    }\n\n    /**\n     * 根据未完结单据查询并刷新融资结果\n     */\n    private void queryAllFinancingResult() {\n        HashMap<String, String> cmbStatusMapping = new HashMap<>();\n        cmbStatusMapping.put(\"00\", SupplierFinancingApplyStatus.BANK_PROCESSING.name());\n        cmbStatusMapping.put(\"01\", SupplierFinancingApplyStatus.REJECTED.name());\n        cmbStatusMapping.put(\"04\", SupplierFinancingApplyStatus.PENDING_DISBURSEMEN.name());\n        cmbStatusMapping.put(\"08\", SupplierFinancingApplyStatus.DISBURSED.name());\n        cmbStatusMapping.put(\"09\", SupplierFinancingApplyStatus.REJECT.name());\n        cmbStatusMapping.put(\"20\", SupplierFinancingApplyStatus.SETTLED.name());\n\n        List<String> pendingStatus = Arrays.asList(SupplierFinancingApplyStatus.SUBMITTED.name(),\n                SupplierFinancingApplyStatus.BANK_PROCESSING.name(),\n                SupplierFinancingApplyStatus.PENDING_DISBURSEMEN.name(),\n                SupplierFinancingApplyStatus.DISBURSED.name());\n\n\n        List<PmcFinanceSupplierApply> financeSupplierApplyList =\n                pmcFinanceSupplierApplyMapper.getPendingFinanceApplyByStatus(pendingStatus);\n        log.info(\"待查询融资单据数量：{}\", financeSupplierApplyList.size());\n        financeSupplierApplyList.forEach(apply -> {\n            PmcFinanceBankBaseQO query = new PmcFinanceBankBaseQO();\n            query.setFinanceNumber(apply.getBankApplyNumber());\n            ResponseMessage responseMessage = this.financingApplyDetails(query);\n            if (ResponseMessage.OK.equals(responseMessage.getStatus())) {\n                FinancingApplyResultQueryDTO result = (FinancingApplyResultQueryDTO) responseMessage.getData();\n                String returnStatus = result.getOperationStatus();\n                if (StringUtils.isEmpty(returnStatus)) {\n                    log.info(\"单据：{},查询银行状态异常，状态为\", apply.getApplyNumber());\n                    return;\n                }\n                String pmcStatus = cmbStatusMapping.get(returnStatus);\n                if (StringUtils.isEmpty(pmcStatus)) {\n                    pmcStatus = returnStatus;\n                }\n                if (!apply.getStatus().equals(pmcStatus)) {\n                    log.info(\"单据：{},由状态：{}变更为：{}\", apply.getApplyNumber(), apply.getStatus(), pmcStatus);\n                    apply.setStatus(pmcStatus);\n                    apply.setLastUpdateDate(DateUtils.getNow());\n                    changeApplyStatus(apply);\n                } else {\n                    log.info(\"单据：{},无状态变更，当前状态：{}，{}\", apply.getApplyNumber(), apply.getStatus(), pmcStatus);\n                }\n            } else {\n                log.info(\"单据：{},查询银行状态异常，返回异常\", apply.getApplyNumber());\n\n            }\n        });\n\n    }\n\n    /**\n     * 变更状态\n     */\n    @Override\n    @Transactional(rollbackFor = Exception.class)\n    public void changeApplyStatus(PmcFinanceSupplierApply apply) {\n        // 更新融资单\n        pmcFinanceSupplierApplyMapper.updateByPrimaryKey(apply);\n        // 插入历史\n        PmcFinanceSupplierApplyHis applyHis = new PmcFinanceSupplierApplyHis();\n        BeanUtils.copyProperties(apply, applyHis);\n        // 操作人 供应商或者银行\n        applyHis.setCreateDate(new Date());\n        applyHis.setLastUpdateDate(new Date());\n        applyHis.setCreateBy(\"system\");\n        applyHis.setLastUpdateBy(\"system\");\n        applyHis.setOperationNode(SupplierFinancingApplyStatus.getOperationNode(apply.getStatus()));\n        pmcFinanceSupplierApplyHisMapper.insert(applyHis);\n\n        // 更新付款单\n        List<String> payCheckFinStatus = Arrays.asList(PayStatus.APPLY_FIN.name(), PayStatus.FINANCED.name());\n        Example example = new WkExample(PmcPayChecks.class);\n        example.createCriteria().\n                andEqualTo(\"payCheckNum\", apply.getPayCheckNum())\n                .andIn(\"status\", payCheckFinStatus);\n        List<PmcPayChecks> payChecks = pmcPayChecksMapper.selectByExample(example);\n\n        if (CollectionUtils.isEmpty(payChecks)) {\n            log.error(\"申请单{}未找到申请融资流程中的付款单：{}\", apply.getApplyNumber(),\n                    apply.getPayCheckNum());\n            return;\n        }\n        PmcPayChecks payCheck = payChecks.get(0);\n\n        // 已融资\n        if (SupplierFinancingApplyStatus.DISBURSED.name().equals(apply.getStatus())) {\n\n            payCheck.setStatus(PayStatus.FINANCED.name());\n            pmcPayChecksMapper.updateByPrimaryKey(payCheck);\n        }\n\n        // 拒绝 需要恢复原始付款单信息\n        if (SupplierFinancingApplyStatus.REJECTED.name().equals(apply.getStatus())\n                || SupplierFinancingApplyStatus.REJECT.name().equals(apply.getStatus())) {\n            payCheck.setStatus(apply.getPayOriginStatus());\n            payCheck.setPayGroup(apply.getPayOriginGroup());\n            pmcPayChecksMapper.updateByPrimaryKey(payCheck);\n        }\n        // 结清需要修改原始付款单信息\n        if (SupplierFinancingApplyStatus.SETTLED.name().equals(apply.getStatus())) {\n            payCheck.setActualPayDate(new Date());\n            PmcAccount pmcAccount =\n                    pmcAccountMapper.findByAccountNo(apply.getFinanceAccount(), null);\n            payCheck.setAcAccountId(pmcAccount.getAcAccountId());\n            payCheck.setAccount(apply.getFinanceAccount());\n            payCheck.setStatus(PayStatus.PAYED.name());\n            pmcPayChecksMapper.updateByPrimaryKey(payCheck);\n            // 触发回传\n            payChecksWriteBackService.writeBack(payCheck);\n        }\n\n\n        payChecksHisService.saveOrUpdateHis(payCheck, payCheck.getStatus()\n                , PayNode.FINANCE_APPLY.name()\n                , PayOperation.FINANCE_BANK_RETURN.name()\n                , \"融资银行回调状态变更为\" + SupplierFinancingApplyStatus.getDescription(apply.getStatus()));\n\n    }\n\n\n    /**\n     * 定时重发处理中的融资申请\n     */\n    @Override\n    @MicroScheduleExecutor(code = \"getFinancingApplyJob\")\n    public void getFinancingApplyJob() {\n        Logger logger = MicroScheduleContext.currentTaskContext().getLogger();\n        logger.info(\"*****定时重发处理中的融资申请开始*******\");\n        queryAllFinancingApply();\n        logger.info(\"*****定时重发处理中的融资申请结束*******\");\n    }\n\n    /**\n     * 根据未完结单据查询并刷新融资结果\n     */\n    private void queryAllFinancingApply() {\n        HashMap<String, String> cmbStatusMapping = new HashMap<>();\n        cmbStatusMapping.put(\"00\", SupplierFinancingApplyStatus.BANK_PROCESSING.name());\n        cmbStatusMapping.put(\"01\", SupplierFinancingApplyStatus.REJECTED.name());\n        cmbStatusMapping.put(\"04\", SupplierFinancingApplyStatus.PENDING_DISBURSEMEN.name());\n        cmbStatusMapping.put(\"08\", SupplierFinancingApplyStatus.DISBURSED.name());\n        cmbStatusMapping.put(\"09\", SupplierFinancingApplyStatus.REJECT.name());\n        cmbStatusMapping.put(\"20\", SupplierFinancingApplyStatus.SETTLED.name());\n\n        List<String> pendingStatus = Arrays.asList(SupplierFinancingApplyStatus.SEND_BANK.name());\n\n        List<PmcFinanceSupplierApply> financeSupplierApplyList =\n                pmcFinanceSupplierApplyMapper.getPendingFinanceApplyByStatus(pendingStatus);\n\n        log.info(\"待查询融资单据数量：{}\", financeSupplierApplyList.size());\n        financeSupplierApplyList.forEach(apply -> {\n            PmcFinanceBankBaseQO query = new PmcFinanceBankBaseQO();\n            query.setFinanceNumber(apply.getBankApplyNumber());\n            ResponseMessage responseMessage = this.financingApplyDetails(query);\n            if (ResponseMessage.OK.equals(responseMessage.getStatus())) {\n                FinancingApplyResultQueryDTO result = (FinancingApplyResultQueryDTO) responseMessage.getData();\n                String returnStatus = result.getOperationStatus();\n                if (StringUtils.isEmpty(returnStatus)) {\n                    log.info(\"单据：{},查询银行状态异常，状态为\", apply.getApplyNumber());\n                    return;\n                }\n                String pmcStatus = cmbStatusMapping.get(returnStatus);\n                if (StringUtils.isEmpty(pmcStatus)) {\n                    pmcStatus = returnStatus;\n                }\n                if (!apply.getStatus().equals(pmcStatus)) {\n                    log.info(\"单据：{},由状态：{}变更为：{}\", apply.getApplyNumber(), apply.getStatus(), pmcStatus);\n                    apply.setStatus(pmcStatus);\n                    apply.setLastUpdateDate(DateUtils.getNow());\n                    changeApplyStatus(apply);\n                } else {\n                    log.info(\"单据：{},无状态变更，当前状态：{}，{}\", apply.getApplyNumber(), apply.getStatus(), pmcStatus);\n                }\n            } else {\n                log.info(\"单据：{},查询银行状态异常，返回异常\", apply.getApplyNumber());\n\n            }\n        });\n\n    }\n}\n",
                "content": "package com.baidu.pmc.core.service.impl;\n\nimport com.baidu.microschedule.client.annotation.MicroScheduleExecutor;\nimport com.baidu.microschedule.client.context.MicroScheduleContext;\nimport com.baidu.microschedule.client.logger.Logger;\nimport com.baidu.pmc.common.ResponseMessage;\nimport com.baidu.pmc.common.utils.BeanUtils;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.common.utils.UtilType;\nimport com.baidu.pmc.core.constants.Constants;\nimport com.baidu.pmc.core.constants.Constants.CoType;\nimport com.baidu.pmc.core.constants.Constants.FunCode;\nimport com.baidu.pmc.core.dto.AttachmentBindRequest;\nimport com.baidu.pmc.core.dto.AttachmentBindResponse;\nimport com.baidu.pmc.core.dto.AttachmentBindResponse.BindResult;\nimport com.baidu.pmc.core.dto.AttachmentBindResponse.BindResultDetail;\nimport com.baidu.pmc.core.dto.CmbResponse;\nimport com.baidu.pmc.core.dto.CmbResponseHead;\nimport com.baidu.pmc.core.dto.FileUploadRequest;\nimport com.baidu.pmc.core.dto.FileUploadResponse;\nimport com.baidu.pmc.core.dto.FinanceApplyQueryRequest;\nimport com.baidu.pmc.core.dto.FinanceApplyQueryResponse;\nimport com.baidu.pmc.core.dto.FinanceApplyRequest;\nimport com.baidu.pmc.core.dto.FinanceApplyResponse;\nimport com.baidu.pmc.core.dto.FinanceEstimateRequest;\nimport com.baidu.pmc.core.dto.FinanceEstimateRequest.FinanceEstimateItem;\nimport com.baidu.pmc.core.dto.FinancingEstimateResponse;\nimport com.baidu.pmc.core.dto.FinancingEstimateResponse.FinancingEstimateResponsePartA;\nimport com.baidu.pmc.core.dto.FinancingEstimateResponse.FinancingEstimateResponsePartB;\nimport com.baidu.pmc.core.dto.FinancingQuotaQryRequest;\nimport com.baidu.pmc.core.dto.FinancingQuotaQryResponse;\nimport com.baidu.pmc.core.dto.FinancingQuotaQryResponse.FinancingQuota;\nimport com.baidu.pmc.core.service.CmbFinancingService;\nimport com.baidu.pmc.core.service.PayChecksHisService;\nimport com.baidu.pmc.core.service.PayChecksWriteBackService;\nimport com.baidu.pmc.persistence.commons.WkExample;\nimport com.baidu.pmc.persistence.dao.PmcAccountMapper;\nimport com.baidu.pmc.persistence.dao.PmcFinanceSupplierApplyHisMapper;\nimport com.baidu.pmc.persistence.dao.PmcFinanceSupplierApplyMapper;\nimport com.baidu.pmc.persistence.dao.PmcPayChecksMapper;\nimport com.baidu.pmc.persistence.domain.PmcAccount;\nimport com.baidu.pmc.pojo.constants.PayNode;\nimport com.baidu.pmc.pojo.constants.PayOperation;\nimport com.baidu.pmc.pojo.constants.PayStatus;\nimport com.baidu.pmc.pojo.constants.SupplierFinancingApplyStatus;\nimport com.baidu.pmc.pojo.dto.cmb.FinanceQuotaDTO;\nimport com.baidu.pmc.pojo.dto.cmb.FinancingApplyResultDTO;\nimport com.baidu.pmc.pojo.dto.cmb.FinancingApplyResultQueryDTO;\nimport com.baidu.pmc.pojo.dto.cmb.FinancingEstimateResultDTO;\nimport com.baidu.pmc.pojo.dto.cmb.PmcCmbCloudDirectQO;\nimport com.baidu.pmc.pojo.model.PmcFinanceSupplierApply;\nimport com.baidu.pmc.pojo.model.PmcFinanceSupplierApplyHis;\nimport com.baidu.pmc.pojo.model.PmcPayChecks;\nimport com.baidu.pmc.pojo.qo.PmcFinanceBankBaseQO;\nimport com.fasterxml.jackson.core.type.TypeReference;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections.CollectionUtils;\nimport org.apache.commons.lang3.RandomStringUtils;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.beans.factory.annotation.Value;\nimport org.springframework.stereotype.Service;\nimport org.springframework.transaction.annotation.Transactional;\nimport tk.mybatis.mapper.entity.Example;\n\nimport java.math.BigDecimal;\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.Collections;\nimport java.util.Date;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Objects;\n\n@Slf4j\n@Service\npublic class CmbFinancingServiceImpl implements CmbFinancingService {\n\n    @Value(\"${cmb.bank.core.id}\")\n    private String bankCoreId;\n\n    @Value(\"${cmb.bank.machine:CMB002}\")\n    private String bankMachine; // 测试使用CMB002\n\n    @Autowired\n    private CmbCloudDirectBaseService baseService;\n\n    @Autowired\n    private PmcFinanceSupplierApplyMapper pmcFinanceSupplierApplyMapper;\n    @Autowired\n    private PmcPayChecksMapper pmcPayChecksMapper;\n    @Autowired\n    private PmcAccountMapper pmcAccountMapper;\n    @Autowired\n    private PayChecksWriteBackService payChecksWriteBackService;\n\n    @Autowired\n    private PmcFinanceSupplierApplyHisMapper pmcFinanceSupplierApplyHisMapper;\n\n    @Autowired\n    private PayChecksHisService payChecksHisService;\n\n    @Override\n    public ResponseMessage financingEstimate(PmcFinanceBankBaseQO calcQO) {\n        String currency = Constants.Currency.getCmbCode(calcQO.getCurrency());\n        if (StringUtils.isBlank(currency)) {\n            return ResponseMessage.fail(\"不支持的币种类型\");\n        }\n        FinanceEstimateRequest request = new FinanceEstimateRequest();\n        FinanceEstimateItem item = new FinanceEstimateItem();\n        item.setCoreid(bankCoreId);\n        item.setCotype(CoType.CORE_ENT.getCode());\n        item.setSmfcod(calcQO.getRegistrationCode());\n        item.setMaxedt(DateUtils.formatDate(calcQO.getPayPlanDate(), \"yyyyMMdd\"));\n        item.setFinamt(calcQO.getFinanceAmount());    // 融资合计金额\n        item.setDocamt(calcQO.getDocAmt());    // 应付账款合计金额\n        item.setBilamt(calcQO.getBilAmt());    // 票面合计金额\n        item.setDocnum(1);  // 固定为 1\n        item.setFinccy(currency);\n        request.setTdorpcalx(Collections.singletonList(item));\n\n        PmcCmbCloudDirectQO qo = buildCloudDirectQo(calcQO);\n        CmbResponse<FinancingEstimateResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FINANCING_CAL.getCode(), request, qo,\n                    new TypeReference<CmbResponse<FinancingEstimateResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"fail to get financing cal result， request: {}\", UtilType.bean2Json(request), e);\n        }\n        if (Objects.isNull(response)) {\n            log.error(\"fail to get financing cal result, request: {}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"融资测算请求失败\");\n        }\n        FinancingEstimateResponse estimateResponse = response.getResponse().getBody();\n        List<FinancingEstimateResponsePartA> partAList = estimateResponse.getTdorpcaly();\n        List<FinancingEstimateResponsePartB> partBList = estimateResponse.getTdorpcalz();\n\n        // todo:把 response 转换成需要的统一格式结果\n        FinancingEstimateResultDTO estimateResult = new FinancingEstimateResultDTO();\n        if (CollectionUtils.isNotEmpty(partAList)) {\n            FinancingEstimateResponsePartA partA = partAList.get(0);\n            estimateResult.setCurrency(Constants.Currency.cmbCode2Code(partA.getFinccy()));\n            estimateResult.setEndDate(partA.getEnddat());\n            estimateResult.setFinanceAmount(partA.getFinamt());\n            estimateResult.setFinanceRate(partA.getFinrat());\n            estimateResult.setFinancePercent(partA.getFinpro());\n            estimateResult.setSettlementMode(partA.getSetmod());    // todo:映射\n        }\n        if (CollectionUtils.isNotEmpty(partBList)) {\n            FinancingEstimateResponsePartB partB = partBList.get(0);\n            estimateResult.setFeeAmount(partB.getFeeamt());\n            estimateResult.setFeeRate(partB.getFerate());\n            estimateResult.setFeeType(partB.getFeetyp());   // todo:映射\n            estimateResult.setPayAccount(partB.getPayacc());\n            estimateResult.setPayRate(partB.getSfnrat());\n            estimateResult.setPayAmount(partB.getSfnamt());\n            estimateResult.setOtherAmount(partB.getOthamt());\n        }\n        return ResponseMessage.success(estimateResult);\n    }\n\n    @Override\n    public ResponseMessage financingApply(PmcFinanceBankBaseQO submitQO) {\n        String currency = Constants.Currency.getCmbCode(submitQO.getCurrency());\n        if (StringUtils.isBlank(currency)) {\n            return ResponseMessage.fail(\"不支持的币种类型\");\n        }\n        FinanceApplyRequest request = new FinanceApplyRequest();\n\n        FinanceApplyRequest.FinanceApplyItemBase item = new FinanceApplyRequest.FinanceApplyItemBase();\n        item.setCoreid(bankCoreId);\n        item.setCotype(CoType.CORE_ENT.getCode());\n        item.setYurref(submitQO.getFinanceNumber());\n        item.setSmfcod(submitQO.getRegistrationCode());\n        // 固定为 02310100：国内保理\n        item.setBiztyp(StringUtils.isBlank(submitQO.getBizType()) ? \"02310100\" : submitQO.getBizType());\n        item.setFinccy(currency);\n        request.setTdorpaddx(Collections.singletonList(item));\n\n        FinanceApplyRequest.FinanceApplyItemCont itemCont = new FinanceApplyRequest.FinanceApplyItemCont();\n\n        itemCont.setSmfacc(submitQO.getSupplierAccount());\n        itemCont.setSmfbak(submitQO.getSupplierBank());\n        itemCont.setSmfadd(submitQO.getSupplierAddress());\n        itemCont.setRevCcy(currency);\n        itemCont.setRevamt(submitQO.getPayableAmount());\n        itemCont.setPrdexp(submitQO.getPayPlanDate());\n        itemCont.setDocamt(submitQO.getDocumentAmount());\n        itemCont.setDocuid(submitQO.getInvoiceNumber());\n        // 01订单、02结算单、03发票、04付款承诺、05其他\n        itemCont.setDoctyp(StringUtils.isBlank(submitQO.getInvoiceType()) ? \"03\" : submitQO.getInvoiceType());\n        request.setTdorpaddy(Collections.singletonList(itemCont));\n\n        PmcCmbCloudDirectQO qo = buildCloudDirectQo(submitQO);\n        CmbResponse<FinanceApplyResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FINANCING_APPLY.getCode(), request, qo,\n                    new TypeReference<CmbResponse<FinanceApplyResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"融资申请->fail to get financing cal result， request: {}\", UtilType.bean2Json(request), e);\n            return ResponseMessage.fail(\"发送招行融资申请接口失败!\");\n\n        }\n        if (Objects.isNull(response) || Objects.isNull(response.getResponse())) {\n            log.error(\"融资申请->fail to get financing cal result, request: {}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"融资申请请求失败，response/response.getResponse() 返回为空\");\n        }\n        FinanceApplyResponse applyResponse = response.getResponse().getBody();\n        CmbResponseHead head = response.getResponse().getHead();\n        String msg = \"\";\n        if (Objects.nonNull(head)) {\n            msg = head.getResultmsg();\n        }\n        if (Objects.isNull(applyResponse)) {\n            log.error(\"融资申请->fail to get financing cal result getBody, request: {},  response: {} \",\n                    UtilType.bean2Json(request), UtilType.bean2Json(response));\n            return ResponseMessage.fail(\"融资申请请求失败 response body 为空\" + msg);\n        }\n        FinancingApplyResultDTO resultDTO = new FinancingApplyResultDTO();\n        List<FinanceApplyResponse.MainResponse> mainResponseList = applyResponse.getTdorpaddz();\n        if (CollectionUtils.isNotEmpty(mainResponseList)) {\n            FinanceApplyResponse.MainResponse mainResponse = mainResponseList.get(0);\n            if (!\"SCDS000\".equals(mainResponse.getRtncod())) {\n                log.error(\"融资申请->fail to get financing cal result, request: {}, response: {}\",\n                        UtilType.bean2Json(request), UtilType.bean2Json(response));\n                return ResponseMessage.fail(\"融资申请请求结果失败 错误编码 {\"+mainResponse.getRtncod()+\"}, \" +\n                        \"错误信息 {\"+mainResponse.getRtnmsg()+\"} \");\n            }\n            resultDTO.setFinanceNumber(mainResponse.getFinnbr());\n            resultDTO.setFinanceCode(mainResponse.getRtncod());\n            resultDTO.setFinanceMessage(mainResponse.getRtnmsg());\n        } else {\n            log.error(\"融资申请->fail to get financing cal result getTdorpaddz, request: {}, response: {}\",\n                    UtilType.bean2Json(request), UtilType.bean2Json(response));\n            return ResponseMessage.fail(\"融资申请请求结果失败 response getTdorpaddz() 为空\"  + msg);\n        }\n        if (StringUtils.isNotBlank(resultDTO.getFinanceNumber())) {\n            pmcFinanceSupplierApplyMapper.updateBankApplyNumber(resultDTO.getFinanceNumber()\n                    , submitQO.getApplyNumber());\n            log.info(\"融资申请->update bank_apply_number success: {} by apply_number: {}\", resultDTO.getFinanceNumber(),\n                    submitQO.getApplyNumber());\n        } else {\n            log.error(\"融资申请->update bank_apply_number failed: {} by apply_number: {}\", resultDTO.getFinanceNumber(),\n                    submitQO.getApplyNumber());\n            return ResponseMessage.fail(\"融资申请请求结果失败 返回银行融资编号bank_apply_number为空\");\n        }\n        return ResponseMessage.success(resultDTO);\n    }\n\n    @Override\n    public ResponseMessage financingApplyDetails(PmcFinanceBankBaseQO submitQO) {\n\n        FinanceApplyQueryRequest request = new FinanceApplyQueryRequest();\n\n        FinanceApplyQueryRequest.FinanceApplyItemBase item = new FinanceApplyQueryRequest.FinanceApplyItemBase();\n        item.setCoreid(bankCoreId);\n        item.setCotype(CoType.CORE_ENT.getCode());\n        item.setFinnbr(submitQO.getFinanceNumber());\n        request.setTdorpquyx(Collections.singletonList(item));\n\n        PmcCmbCloudDirectQO qo = buildCloudDirectQo(submitQO);\n        CmbResponse<FinanceApplyQueryResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FINANCING_APPLY_DETAILS.getCode(), request, qo,\n                    new TypeReference<CmbResponse<FinanceApplyQueryResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"融资结果查询->fail to get financing cal result， request: {}\", UtilType.bean2Json(request), e);\n            return ResponseMessage.fail(\"融资申请结果查询失败\");\n\n        }\n        if (Objects.isNull(response)) {\n            log.error(\"融资结果查询->fail to get financing cal result, request: {}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"融资申请查询失败\");\n        }\n        // todo:把 response 转换成需要的统一格式结果\n        FinancingApplyResultQueryDTO resultQueryDTO = new FinancingApplyResultQueryDTO();\n\n        FinanceApplyQueryResponse applyResponse = response.getResponse().getBody();\n        if (applyResponse == null) {\n            log.error(\"融资结果查询->fail to get financing cal result, request: {}, response {}\",\n                    UtilType.bean2Json(request), UtilType.bean2Json(response));\n            return ResponseMessage.fail(\"融资申请查询失败\");\n        }\n        List<FinanceApplyQueryResponse.ContInfo> contInfos = applyResponse.getTdorpquyy();\n        List<FinanceApplyQueryResponse.FeeInfo> feeInfos = applyResponse.getTdorpquyz();\n        List<FinanceApplyQueryResponse.DocumentInfo> documentInfos = applyResponse.getTdorpquyw();\n        if (CollectionUtils.isNotEmpty(contInfos)) {\n            FinanceApplyQueryResponse.ContInfo contInfo = contInfos.get(0);\n            resultQueryDTO.setTransferRequestId(contInfo.getTreqid());\n            resultQueryDTO.setCoreCorpCode(contInfo.getCorcod());\n            resultQueryDTO.setCoreCorpName(contInfo.getCornam());\n            resultQueryDTO.setTotalCount(contInfo.getTotsum());\n            resultQueryDTO.setTotalAmount(contInfo.getTotamt());\n            resultQueryDTO.setSupplierName(contInfo.getSmfnam());\n            resultQueryDTO.setSupplierCode(contInfo.getSmfcod());\n            resultQueryDTO.setApplyDate(contInfo.getOpdate());\n            resultQueryDTO.setDueDate(contInfo.getEnddat());\n            resultQueryDTO.setLoanStartDate(contInfo.getRelopd());\n            resultQueryDTO.setLoanEndDate(contInfo.getRelend());\n            resultQueryDTO.setFinanceAmount(contInfo.getFinamt());\n            resultQueryDTO.setFinanceType(contInfo.getFintyp());\n            resultQueryDTO.setSource(contInfo.getSource());\n            resultQueryDTO.setBusinessType(contInfo.getBiztyp());\n            resultQueryDTO.setOperationStatus(contInfo.getOprsts());\n            resultQueryDTO.setCurrency(Constants.Currency.cmbCode2Code(contInfo.getFinccy()));\n            resultQueryDTO.setFinanceRate(contInfo.getFinrat());\n            resultQueryDTO.setInterest(contInfo.getIntere());\n        }\n        if (CollectionUtils.isNotEmpty(feeInfos)) {\n            FinanceApplyQueryResponse.FeeInfo feeInfo = feeInfos.get(0);\n            resultQueryDTO.setFeeRate(feeInfo.getFerate());\n            resultQueryDTO.setFeeAmount(feeInfo.getFeeamt());\n            resultQueryDTO.setPaymentMethod(feeInfo.getPaytra());\n            resultQueryDTO.setPaymentAccount(feeInfo.getPayacc());\n            resultQueryDTO.setFeeType(feeInfo.getFeetyp());\n            resultQueryDTO.setServiceProviderName(feeInfo.getSernam());\n            resultQueryDTO.setServiceAccount(feeInfo.getSeracc());\n            resultQueryDTO.setBankName(feeInfo.getOpname());\n        }\n        if (CollectionUtils.isNotEmpty(documentInfos)) {\n            FinanceApplyQueryResponse.DocumentInfo documentInfo = documentInfos.get(0);\n            resultQueryDTO.setSupplierAccount(documentInfo.getSmfacc());\n            resultQueryDTO.setSupplierCode(documentInfo.getSmfcod());\n            resultQueryDTO.setSupplierBank(documentInfo.getSmfbak());\n            resultQueryDTO.setSupplierAddress(documentInfo.getSmfadd());\n            resultQueryDTO.setContractId(documentInfo.getContid());\n            resultQueryDTO.setContractName(documentInfo.getConnam());\n            resultQueryDTO.setDocumentId(documentInfo.getDocuid());\n            resultQueryDTO.setDocumentAmount(documentInfo.getDocamt());\n            resultQueryDTO.setPayableAmount(documentInfo.getRevamt());\n            resultQueryDTO.setPayableStartDate(documentInfo.getCaltim());\n            resultQueryDTO.setDocumentType(documentInfo.getDoctyp());\n            resultQueryDTO.setBuyerAccount(documentInfo.getBuyacc());\n            resultQueryDTO.setRemark(documentInfo.getRemark());\n            resultQueryDTO.setPayPlanDate(documentInfo.getPrdexp());\n        }\n        return ResponseMessage.success(resultQueryDTO);\n    }\n\n    @Override\n    public ResponseMessage financingQuotaQuery(PmcFinanceBankBaseQO queryQO) {\n        FinancingQuotaQryRequest request = new FinancingQuotaQryRequest();\n        FinancingQuotaQryRequest.FinancingQuotaQry quotaQry = new FinancingQuotaQryRequest.FinancingQuotaQry();\n        quotaQry.setCoreid(bankCoreId);\n        // quotaQry.setCrdtid(bankCreditId);\n        quotaQry.setCotype(CoType.CORE_ENT.getCode());\n        request.setPchxcquyx(Collections.singletonList(quotaQry));\n        PmcCmbCloudDirectQO qo = buildCloudDirectQo(queryQO);\n        CmbResponse<FinancingQuotaQryResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FINANCING_QUOTA_QRY.getCode(), request, qo,\n                    new TypeReference<CmbResponse<FinancingQuotaQryResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"融资额度查询->fail to query financing quota, request :{}\", UtilType.bean2Json(request), e);\n            return ResponseMessage.fail(\"招行云直联查询额度失败\");\n\n        }\n        if (Objects.isNull(response)) {\n            log.error(\"融资额度查询->fail to query financing quota, request :{}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"招行云直联查询额度失败\");\n        }\n        FinanceQuotaDTO quotaDTO = new FinanceQuotaDTO();\n        FinancingQuotaQryResponse quotaRes = response.getResponse().getBody();\n        if (Objects.nonNull(quotaRes)) {\n            List<FinancingQuota> quotas = quotaRes.getPchxcquyw();\n            if (CollectionUtils.isEmpty(quotas)) {\n                // todo zzb 测试环境先写死数据，后续测试该逻辑\n                quotas = new ArrayList<>();\n                FinancingQuota test = new FinancingQuota();\n                test.setEavamt(new BigDecimal(99999));\n                quotas = new ArrayList<>();\n                quotas.add(test);\n                // return ResponseMessage.fail(\"招行云直联未返回结果\");\n            }\n            FinancingQuota quota = quotas.get(0);\n            quotaDTO.setCurrency(Constants.Currency.cmbCode2Code(quota.getExoccy()));\n            quotaDTO.setCreditType(quota.getCrdtyp());\n            quotaDTO.setStartDate(quota.getStadat());\n            quotaDTO.setEndDate(quota.getEnddat());\n            quotaDTO.setIsExop(quota.getIsexop());\n            quotaDTO.setExoAmount(quota.getExoamt());\n            quotaDTO.setExoUsedAmount(quota.getEudamt());\n            quotaDTO.setExoAvailableAmount(quota.getEavamt());\n            quotaDTO.setCreditAmount(quota.getCrdamt());\n            quotaDTO.setCreditUsedAmount(quota.getCudamt());\n            quotaDTO.setCreditAvailableAmount(quota.getCavamt());\n            quotaDTO.setCreditStatus(quota.getCrests());\n        }\n        return ResponseMessage.success(quotaDTO);\n    }\n\n    @Override\n    public ResponseMessage uploadAttachment(PmcFinanceBankBaseQO uploadQO) {\n        // todo: 上传合同和发票，改为供应商在银行上传，展示不用接入\n        if (StringUtils.isBlank(uploadQO.getFilePath())) {\n            return ResponseMessage.fail(\"缺少附件信息\");\n        }\n        FileUploadRequest request = new FileUploadRequest();\n        request.setFilepath(uploadQO.getFilePath());\n        CmbResponse<FileUploadResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FILE_UPLOAD.getCode(), request, buildCloudDirectQo(uploadQO),\n                    new TypeReference<CmbResponse<FileUploadResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"融资上传->ffail to upload\");\n            return ResponseMessage