etMapper.updateByPrimaryKey(pmcFinanceSupplierQuotaSet);\n        } else {\n            pmcFinanceSupplierQuotaSet.setCreateDate(new Date());\n            pmcFinanceSupplierQuotaSetMapper.insert(pmcFinanceSupplierQuotaSet);\n        }\n        return pmcFinanceSupplierQuotaSet.getId();\n    }\n\n\n    private List<PmcFinanceSupplierQuotaSet> getSupplierQuotaSetList(PmcFinanceSupplierQuotaSetQO query) {\n        Example example = new Example(PmcFinanceSupplierQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n        String supId = PmcPortalLogin.getSupId();\n        PmcDataP2pSupplier supplier  = null;\n        if (StringUtils.isNotBlank(supId)) {\n            supplier = pmcDataP2pSupplierMapper.selectBySupplierCode(supId);\n            if (supplier == null) {\n                throw new ServiceException(\"供应商信息不存在: supId=\" + supId);\n            }\n        }\n        if (StringUtils.isBlank(query.getSupplierName()) && supplier != null) {\n            query.setSupplierName(supplier.getSupplierName());\n        }\n        if (StringUtils.isBlank(query.getSupplierCode()) && supplier != null) {\n            query.setSupplierCode(supplier.getSupplierCode());\n        }\n        criteria.andEqualTo(\"supplierName\", query.getSupplierName())\n                .andEqualTo(\"supplierCode\", query.getSupplierCode());\n\n        if (StringUtils.isNotBlank(query.getRegistrationCode())) {\n            criteria.andEqualTo(\"registrationCode\", query.getRegistrationCode());\n        }\n        if (StringUtils.isNotBlank(query.getFinanceFlag())) {\n            criteria.andEqualTo(\"financeFlag\", query.getFinanceFlag());\n        }\n        List<PmcFinanceSupplierQuotaSet> list = pmcFinanceSupplierQuotaSetMapper.selectByExample(example);\n        return list;\n    }\n\n\n    private List<PmcFinanceCompQuotaSetDTO> getQuotaSetList(PmcFinanceCompQuotaSetQO query) {\n        Example example = new Example(PmcFinanceCompQuotaSet.class);\n\n        Example.Criteria criteria = example.createCriteria();\n        if (StringUtils.isNotBlank(query.getBankCode())) {\n            criteria.andEqualTo(\"bankCode\", query.getBankCode());\n        }\n        if (StringUtils.isNotBlank(query.getCreditCompCode())) {\n            criteria.andEqualTo(\"creditCompCode\", query.getCreditCompCode());\n        }\n        if (StringUtils.isNotBlank(query.getEnableFlag())) {\n            criteria.andEqualTo(\"enableFlag\", query.getEnableFlag());\n        }\n        if (StringUtils.isNotBlank(query.getPayAccount())) {\n            criteria.andEqualTo(\"payAccount\", query.getPayAccount());\n        }\n        List<PmcFinanceCompQuotaSet> list = pmcFinanceCompQuotaSetMapper.selectByExample(example);\n\n\n        List<PmcFinanceCompQuotaSetDTO> dtoList = list.stream().map(his -> {\n            PmcFinanceCompQuotaSetDTO dto = new PmcFinanceCompQuotaSetDTO();\n            BeanUtils.copyProperties(his, dto);\n            dto.setCompanyName(operateByJDBC.translate(BD_COMPANY, StringUtils.toString(dto.getCompanyCode())));\n            dto.setCreditCompName(operateByJDBC.translate(BD_COMPANY, StringUtils.toString(dto.getCreditCompCode())));\n            dto.setBankName(operateByJDBC.translate(BANK, StringUtils.toString(dto.getBankCode())));\n            return dto;\n        }).collect(Collectors.toList());\n        setPayAccountNames(dtoList);\n        return dtoList;\n    }\n\n\n    private void setPayAccountNames(List<PmcFinanceCompQuotaSetDTO> list) {\n        if (CollectionUtils.isEmpty(list)) {\n            return;\n        }\n        // 收集所有accountNo\n        List<String> accountNos = list.stream()\n                .map(PmcFinanceCompQuotaSet::getPayAccount)\n                .filter(StringUtils::isNotBlank)\n                .distinct()\n                .collect(Collectors.toList());\n\n        if (CollectionUtils.isEmpty(accountNos)) {\n            return;\n        }\n        // 批量查询accountName\n        Map<String, String> accountNameMap = accountMapper.batchSelectAccountNames(accountNos);\n\n        // 为每条记录设置PayAccountName\n        list.forEach(dto -> {\n            if (StringUtils.isNotBlank(dto.getPayAccount())) {\n                dto.setPayAccountName(accountNameMap.get(dto.getPayAccount()));\n                String currencyName = (operateByJDBC.translate(CURRENCY, \"CNY\"));\n                dto.setPayAccountInfo(dto.getPayAccount() + \"-\"+ currencyName+ \"-\"\n                        + dto.getBankName()+ \"-\"+dto.getPayAccountName());\n            }\n        });\n    }\n    @Override\n    public Map<String, Object> getSelectInit() {\n        Map<String, Object> result = new HashMap<>();\n        // 获取所有状态及描述\n        List<CodeDesc> statusList = SupplierFinancingApplyStatus.getAllStatuses();\n\n        // 获取融资机构列表\n        List<CodeDesc> bankList = operateByJDBC.selectByCon(BANK_FINANCING_RATES)\n                .stream()\n                .map(info -> new CodeDesc(info.getFlexValue(), info.getDescription()))\n                .collect(Collectors.toList());\n\n        List<FndFlexValueDTO> enbleFlagList = fndFlexValueApi.selectByType(Constants.PmcLookupInfoCode.YES_NO);\n\n\n        // 获取公司列表\n        List<CodeDesc> cnmpanyList = operateByJDBC.selectByCon(BD_COMPANY)\n                .stream()\n                .map(info -> new CodeDesc(info.getFlexValue(), info.getDescription()))\n                .collect(Collectors.toList());\n\n        // 处理步骤列表\n        List<CodeDesc> dealList = FinancingStatus.getAllStatuses();\n\n        result.put(\"yesNo\", fndFlexValueApi.convertToCodedLabelDTO(enbleFlagList));\n        result.put(\"statusList\", statusList);\n        result.put(\"bankList\", bankList);\n        result.put(\"companyList\", cnmpanyList);\n        result.put(\"dealList\", dealList);\n\n        return result;\n    }\n\n    @Override\n    public BigDecimal calculateAvailableQuota(PmcPortalRemainQuotaQO qo){\n        BigDecimal availableQuota;\n        // 1. 获取供应商额度\n        Example example = new Example(PmcFinanceSupplierQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n        criteria.andEqualTo(\"supplierCode\", qo.getSupplierCode());\n        criteria.andEqualTo(\"financeFlag\", \"1\");\n        List<PmcFinanceSupplierQuotaSet> pmcFinanceSupplierQuotaSet\n                = pmcFinanceSupplierQuotaSetMapper.selectByExample(criteria);\n        availableQuota = pmcFinanceSupplierQuotaSet.get(0).getCreditQuota();\n\n        // 2. 获取已占用金额\n        List<String> targetStatuses = Arrays.asList(\n                SupplierFinancingApplyStatus.SUBMITTED.name(),\n                SupplierFinancingApplyStatus.BANK_PROCESSING.name(),\n                SupplierFinancingApplyStatus.PENDING_DISBURSEMEN.name(),\n                SupplierFinancingApplyStatus.DISBURSED.name(),\n                SupplierFinancingApplyStatus.SETTLED.name());\n\n        Map<String, Object> resultMap = pmcFinanceSupplierApplyMapper.selectSummaryByStatus(targetStatuses,\n                qo.getSupplierCode());\n        BigDecimal usedQuota = (BigDecimal) resultMap.get(\"totalAmount\");\n\n        return availableQuota.subtract(usedQuota);\n    }\n\n    @Override\n    public List<CodeDesc> selectSuggest(SuggestParameter parameter) {\n        if (parameter == null || StringUtils.isBlank(parameter.getInputVal())) {\n            throw new IllegalArgumentException(\"查询关键字不能为空\");\n        }\n\n        Example example = new Example(PmcDataP2pSupplier.class);\n        Example.Criteria criteria = example.createCriteria();\n\n        // 构建模糊查询条件\n        String keyword = \"%\" + parameter.getInputVal() + \"%\";\n        criteria.orLike(\"supplierName\", keyword)\n               .orLike(\"registrationCode\", keyword)\n               .orLike(\"supplierId\", keyword);\n\n        // 执行查询\n        List<PmcDataP2pSupplier> suppliers = pmcDataP2pSupplierMapper.selectByExample(example);\n\n        // 转换为CodeDesc列表\n        return suppliers.stream()\n                .map(supplier -> new CodeDesc(\n                    String.valueOf(supplier.getSupplierId()),\n                    supplier.getSupplierName() + \"~\" + supplier.getRegistrationCode() + \"\"\n                ))\n                .collect(Collectors.toList());\n    }\n    @Override\n    public String commonCheckData(PmcFinanceBankBaseQO query, String methodName) {\n        try {\n            log.info(\"执行通用数据校验，方法名：{}，参数类型：{}\", methodName,\n                    query != null ? query.getClass().getSimpleName() : \"null\");\n            switch (methodName) {\n                case \"calculateFinancing\":\n                    return validateCalculateFinancing(query);\n                case \"submitFinancingApply\":\n                    return validateSubmitFinancingApply(query);\n                case \"queryFinancingResult\":\n                    return validateQueryFinancingResult(query);\n                case \"queryFinancingQuota\":\n                    return validateQueryFinancingQuota(query);\n                case \"uploadFinancingAttachment\":\n                case \"supplementFinancingAttachment\":\n                    return validateFileOperation(query);\n                default:\n                    log.warn(\"未知的方法名：{}，执行默认校验\", methodName);\n                    return validateDefault(query);\n            }\n\n        } catch (Exception e) {\n            log.error(\"通用数据校验异常，方法名：{}\", methodName, e);\n            return \"数据校验异常：\" + e.getMessage();\n        }\n    }\n\n    /**\n     * 融资测算校验\n     */\n    private String validateCalculateFinancing(PmcFinanceBankBaseQO query) {\n        return \"ok\";\n    }\n\n    /**\n     * 融资申请提交校验\n     */\n    private String validateSubmitFinancingApply(PmcFinanceBankBaseQO query) {\n        if (StringUtils.isBlank(query.getPayCheckNum())) {\n            return \"付款单号不能为空\";\n        }\n        if (StringUtils.isBlank(query.getApplyNumber())) {\n            return \"融资单号不能为空\";\n        }\n        // 查询申请明细\n        PmcFinanceSupplierApply apply = pmcFinanceSupplierApplyMapper.selectByApplyNumber(query.getApplyNumber());\n        if (apply == null) {\n            return \"未找到对应的融资申请单\";\n        }\n        if (!apply.getStatus().equals(SupplierFinancingApplyStatus.SUBMITTED.name())) {\n            return \"pmc系统融资申请单状态不为已提交\";\n        }\n        return \"ok\";\n    }\n\n    /**\n     * 融资结果查询校验\n     */\n    private String validateQueryFinancingResult(Object query) {\n        return \"ok\";\n    }\n\n    /**\n     * 融资额度查询校验\n     */\n    private String validateQueryFinancingQuota(Object query) {\n        return \"ok\";\n    }\n\n    /**\n     * 文件操作校验\n     */\n    private String validateFileOperation(Object query) {\n        return \"ok\";\n    }\n\n    /**\n     * 默认校验\n     */\n    private String validateDefault(Object query) {\n        return \"ok\";\n    }\n\n}",
