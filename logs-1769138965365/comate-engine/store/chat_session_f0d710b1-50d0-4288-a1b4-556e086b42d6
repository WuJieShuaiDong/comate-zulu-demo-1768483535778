hecksQO) {\n        PmcPayChecksSupplierCodeDTO result = pmcPortalClient.selectPmcPayCheckByPayCheckNum(payChecksQO);\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", result), HttpStatus.OK);\n    }\n\n\n    /**\n     * 导出供应商额度\n     */\n    @PostMapping(\"/export\")\n    @ResponseBody\n    @ExportRepeatCheckLock\n    public ResponseMessage exportSupplierQuotaSet(@RequestBody PmcFinanceSupplierApplyQO query,\n                                                  HttpServletRequest request, HttpServletResponse response) {\n        log.info(\"供应商点击导出融资申请列表\");\n        List<PmcFinanceSupplierApplyDTO> result = pmcPortalClient.export(query);\n        List<List<List<List<String>>>> detailsList = new ArrayList<>();\n        List<List<List<String>>> detailsNew = new ArrayList<>();\n        List<List<String>> resultIn = new ArrayList<>();\n        result.forEach(data -> {\n            List<String> values = new ArrayList<>();\n            // 序号\n            values.add(String.valueOf(result.indexOf(data) + 1));\n            values.add(String.valueOf(data.getSupplierName()));\n            values.add(String.valueOf(data.getApplyNumber()));\n            values.add(String.valueOf(data.getPayCheckNum()));\n            values.add(String.valueOf(data.getPayAmount()));\n            values.add(String.valueOf(data.getFinanceAmount()));\n            values.add(String.valueOf(data.getCurrencyName()));\n            values.add(String.valueOf(data.getBankName()));\n            values.add(String.valueOf(data.getFinanceDay()));\n            values.add(String.valueOf(data.getStatusDesc()));\n            resultIn.add(values);\n        });\n        detailsNew.add(resultIn);\n        detailsList.add(detailsNew);\n        String[] sheetName = {\"供应商融资列表导出\"};\n        String[] headerIn = {\"序号\", \"供应商名称\", \"融资申请单号\", \"付款单号\", \"可融资金额\",\n                \"融资申请金额\", \"币种\", \"融资机构\", \"融资天数\", \"融资申请状态\"};\n        List<String[]> headers = new ArrayList<>();\n        headers.add