\n    private static final String TMS_UIC_USERINFO = \"TMS_UIC_USERINFO_\";\n\n    private static final String TMS_UIC_DEPARTMENT_USERINFO = \"TMS_UIC_DEPARTMENT_USERINFO\";\n\n    /**\n     * 私有化实例\n     */\n    private static UICTransInfoUtils instance = null;\n\n/*    *//**\n     * 注入用户信息远程接口\n     *//*\n    private static IUserRemoteService uicUserRemoteService;\n\n    *//**\n     * 注入部门信息远程接口\n     *//*\n    private static IDepartmentRemoteService uicDepartmentRemoteService; */\n\n\n    private static HrStorePersonDAO hrStorePersonDAO=null;\n\n    private static HrStorePersonService hrStorePersonService = null;\n\n    /**\n     * 私有化实例\n     */\n\n\n    /**\n     * 不允许外部新建实例\n     */\n    private UICTransInfoUtils() {\n    }\n\n    /**\n     * 获取到实例对象\n     */\n    public static synchronized UICTransInfoUtils getInstance() {\n\n        if (instance == null) {\n            instance = new UICTransInfoUtils();\n        }\n//        if (uicUserRemoteService == null) {\n//            uicUserRemoteService = SpringContextHolder.getBean(IUserRemoteService.class);\n//        }\n//        if (uicDepartmentRemoteService == null) {\n//            uicDepartmentRemoteService = SpringContextHolder.getBean(IDepartmentRemoteService.class);\n//        }\n\n        if (hrStorePersonDAO == null) {\n            hrStorePersonDAO =SpringContextHolder.getBean(HrStorePersonDAO.class);\n        }\n\n        if (hrStorePersonService == null) {\n            hrStorePersonService = SpringContextHolder.getBean(HrStorePersonService.class);\n        }\n        return instance;\n    }\n\n    /**\n     * 获取部门code,包含已离职人员信息\n     * @param userName\n     * @return\n     */\n    public String getDepartmentCodeByUserName(String userName) {\n        UICUserInfoDto userInfoDto = JedisUtil.getObject(TMS_UIC_DEPARTMENT_USERINFO + userName, UICUserInfoDto.class);\n        if (userInfoDto == null) {\n            HrStorePerson person=new HrStorePerson();\n            person.setUserName(userName);\n            List<HrStorePerson> storePersons= hrStorePersonDAO.selectSelective(person);\n            if (CollectionUtils.isNotEmpty(storePersons)) {\n                JedisUtil.setex(TMS_UIC_USERINFO + userName, 3600, userInfoDto);\n                return storePersons.get(0).getDepartmentCode();\n            } else {\n                UICUserInfoDto userByUserNameCache = getUserByUserName(userName);\n                if (userByUserNameCache != null) {\n                    JedisUtil.setex(TMS_UIC_USERINFO + userName, 3600, userInfoDto);\n                    return userByUserNameCache.getDepartmentCode();\n                }\n            }\n        } else {\n            return userInfoDto.getDepartmentCode();\n        }\n        return null;\n    }\n\n    /**\n     * 增加一个带缓存的人员查询\n     * @param userName\n     * @return\n     */\n    public UICUserInfoDto getUserByUserNameCache(String userName) {\n        UICUserInfoDto userInfoDto = JedisUtil.getObject(TMS_UIC_USERINFO + userName, UICUserInfoDto.class);\n        if (userInfoDto == null) {\n            userInfoDto = getUserByUserName(userName);\n            JedisUtil.setex(TMS_UIC_USERINFO + userName, 3600, userInfoDto);\n        }\n        return userInfoDto;\n    }\n\n    /**\n     * 根据用户名从UIC获取用户数据\n     */\n    public UICUserInfoDto getUserByUserName(String userName) {\n\n\n        // 传入的参数\n        Object obj = new Object[] {\"userName=\" + userName};\n\n        AtomicInteger atoInt = new AtomicInteger();\n        UserDTO userDTO = null;\n        // UIC取得的数据为空，并且没有大于最大的获取次数\n        while (userDTO == null) {\n            if (atoInt.getAndAdd(1) > LAST_GET) {\n                this.debugLog(\"UIC获取数据失败\", obj);\n                // 写入公共类\n\n                break;\n            }\n            // 短暂休眠，避免出现活锁\n            try {\n                Thread.sleep(3, new Random().nextInt(500));\n            } catch (InterruptedException e) {\n                e.printStackTrace();\n            }\n\n            userDTO = realGetUserByUserName(userName, obj);\n        }\n        // 是否离职标志\n        boolean isDimission = (userDTO != null) ? false : true;\n        if (userDTO != null ) {\n            HrStorePerson person=new HrStorePerson();\n            person.setUserName(userName);\n            List<HrStorePerson> storePersons= hrStorePersonDAO.selectSelective(person);\n            if(CollectionUtils.isEmpty(storePersons)){\n                HrStorePerson hrStorePerson = new HrStorePerson();\n                BeanUtils.copyProperties(userDTO, hrStorePerson);\n                hrStorePerson.setUserName(userDTO.getUsername());\n                // hrStorePersonDAO.insertSelective(hrStorePerson);\n                hrStorePersonService.saveOrUpdate(hrStorePerson, true);\n            } /*else {\n                HrStorePerson hrStorePerson = FastJsonUtil.beanCopy(userDTO, HrStorePerson.class);\n                // hrStorePersonDAO.updateByPrimaryKeySelective(hrStorePerson);\n                hrStorePersonService.saveOrUpdate(hrStorePerson, false);\n            }*/\n        }\n        //如果为空，从本地获取\n        if (userDTO == null && StrUtils.isNotEmpty(userName)) {\n            HrStorePerson person=new HrStorePerson();\n            person.setUserName(userName);\n            List<HrStorePerson> storePersons= hrStorePersonDAO.selectSelective(person);\n            if(CollectionUtils.isNotEmpty(storePersons)) {\n                if (Objects.isNull(storePersons.get(0).getServiceEndDate())) {\n                    // 离职时间设置为当天\n                    String s = DateUtils.formatDate(new Date(), \"yyyy-MM-dd\");\n                    storePersons.get(0).setServiceEndDate(s);\n                    // hrStorePersonDAO.updateByPrimaryKeySelective(storePersons.get(0));\n                    hrStorePersonService.saveOrUpdate(storePersons.get(0), false);\n                }\n                //  userDTO = FastJsonUtil.beanCopy(storePersons.get(0), UserDTO.class);\n            }\n        }\n\n        if(userDTO == null){\n            return null;\n        }\n        // 用户数据并转换\n        UICUserInfoDto tmpUICUserInfoDto = (UICUserInfoDto) this.copyProperties(userDTO);\n\n        //是否离职标志\n        if(tmpUICUserInfoDto != null)  tmpUICUserInfoDto.setIsDimission(isDimission);\n\n        return tmpUICUserInfoDto;\n    }\n\n\n    private UserDTO realGetUserByUserName(String userName, Object obj) {\n        Map<String, String> params = new HashMap<>();\n        params.put(\"username\", userName);\n        params.put(\"returnFields\", \"username,name,email,departmentCode,departmentName,superiorUsername,employeeNumber\");\n        String uicServiceUrlForByUsername = Config.get(\"uic.config.uicServiceUrlForByUsername\");\n        String uicAppKey = Config.get(\"uic.config.uicAppKey\");\n        String uicSecretKey = Config.get(\"uic.config.uicSecretKey\");\n        String result = null;\n        try {\n            result = UICInvokeUtil.invoke(uicServiceUrlForByUsername, params, uicAppKey, uicSecretKey);\n        } catch (IOException e) {\n            e.printStackTrace();\n        }\n        return UICInvokeUtil.parseDTO(result, UserDTO.class);\n    }\n\n    /**\n     * 刷新全量用戶\n     */\n    public List<UserDTO> refreshAllUsers() {\n        Map<String, String> params = new HashMap<>();\n        params.put(\"returnFields\", \"username,name,email\");\n        String uicServiceUrlForByUsername = Config.get(\"uic.config.uicServiceUrlForAllUsername\");\n        String uicAppKey = Config.get(\"uic.config.uicAppKey\");\n        String uicSecretKey = Config.get(\"uic.config.uicSecretKey\");\n        String result = null;\n        try {\n            result = UICInvokeUtil.invoke(uicServiceUrlForByUsername, params, uicAppKey, uicSecretKey);\n        } catch (IOException e) {\n            e.printStackTrace();\n        }\n        return UICInvokeUtil.parseCollectionDTO(result, UserDTO.class);\n    }\n\n    /**\n     * 根据用户名获取上级用户信息\n     * @param userName\n     * @return\n     */\n    public UserDTO getSuperiorByUsername(String userName) {\n        Map<String, String> params = new HashMap<>();\n        params.put(\"username\", userName);\n        params.put(\"returnFields\", \"username,name,email\");\n        String uicServiceUrlForByUsername = Config.get(\"uic.config.uicServiceUrlSuperiorByUsername\");\n        String uicAppKey = Config.get(\"uic.config.uicAppKey\");\n        String uicSecretKey = Config.get(\"uic.config.uicSecretKey\");\n        String result = null;\n        try {\n            result = UICInvokeUtil.invoke(uicServiceUrlForByUsername, params, uicAppKey, uicSecretKey);\n        } catch (IOException e) {\n            e.printStackTrace();\n        }\n        return UICInvokeUtil.parseDTO(result, UserDTO.class);\n    }\n\n    /**\n     * 根据输入的字符串模糊查询邮箱\n     */\n    public List<UICUserInfoDto> getAllUsersByBlurEmail(String blurEmail) {\n\n        // 传入的参数\n        Object obj = new Object[] {\"blurEmail=\" + blurEmail};\n\n        // 传入参数为空，返回\n        if (blurEmail == null) {\n            return null;\n        }\n\n        AtomicInteger atoInt = new AtomicInteger();\n        List<UserDTO> userDTOList = null;\n        // UIC取得的数据为空，并且没有大于最大的获取次数\n        while (userDTOList == null) {\n            if (atoInt.getAndAdd(1) > LAST_GET) {\n                this.debugLog(\"UIC获取数据失败\", obj);\n                return null;\n            }\n        }\n        // 设置返回数据\n        List<UICUserInfoDto> returnList = new ArrayList<UICUserInfoDto>();\n        // 用户数据并转换\n        this.copyProperties(returnList, userDTOList);\n        return returnList;\n    }\n\n    /**\n     * 根据名称模糊查找用户\n     */\n    public List<UICUserInfoDto> getAllUsersByBlurName(String blurName) {\n        // 传入的参数\n        Object obj = new Object[] {\"blurName=\" + blurName};\n\n        // 传入参数为空，返回\n        if (blurName == null) {\n            return null;\n        }\n\n        AtomicInteger atoInt = new AtomicInteger();\n        List<UserDTO> userDTOList = null;\n        // UIC取得的数据为空，并且没有大于最大的获取次数\n        while (userDTOList == null) {\n            if (atoInt.getAndAdd(1) > LAST_GET) {\n                this.debugLog(\"UIC获取数据失败\", obj);\n                return null;\n            }\n        }\n        // 设置返回数据\n        List<UICUserInfoDto> returnList = new ArrayList<UICUserInfoDto>();\n        // 用户数据并转换\n        this.copyProperties(returnList, userDTOList);\n\n        return returnList;\n    }\n\n    /**\n     * 根据用户联系信息搜索用户\n     */\n    public List<UICUserInfoDto> getAllUsersByContact(String contact,int start,int limit, String uicServiceUrl,\n                                                     String uicAppKey, String uicSecretKey) {\n        // 传入的参数\n        Object obj = new Object[] {\"contact=\" + contact};\n\n        // 传入参数为空，返回\n        if (contact == null) {\n            return null;\n        }\n\n        AtomicInteger atoInt = new AtomicInteger();\n        List<UserDTO> userDTOList = null;\n        // UIC取得的数据为空，并且没有大于最大的获取次数\n        while (userDTOList == null) {\n            if (atoInt.getAndAdd(1) > LAST_GET) {\n                this.debugLog(\"UIC获取数据失败\", obj);\n                return null;\n            }\n            userDTOList = realGetAllUsersByContact(contact,start,limit, uicServiceUrl, uicAppKey, uicSecretKey);\n        }\n        // 设置返回数据\n        List<UICUserInfoDto> returnList = new ArrayList<UICUserInfoDto>();\n        // 用户数据并转换\n        this.copyProperties(returnList, userDTOList);\n\n        return returnList;\n    }\n\n    private List<UserDTO> realGetAllUsersByContact(String contact,int start,int limit, String uicServiceUrl,\n                                                   String uicAppKey, String uicSecretKey) {\n        Map<String, String> params = new HashMap<>();\n        params.put(\"usernameBlurPrefix\", contact);\n        params.put(\"returnSize\", \"\" + limit);\n        params.put(\"returnFields\", \"username,name,email,departmentName\");\n        String result = null;\n        try {\n            result = UICInvokeUtil.invoke(uicServiceUrl, params, uicAppKey, uicSecretKey);\n        } catch (IOException e) {\n            e.printStackTrace();\n        }\n        return UICInvokeUtil.parseCollectionDTO(result, UserDTO.class);\n    }\n\n    public List<String> getAllSubUsernamesBySuperiorUsername(String superiorUsername){\n        List<String> userNameList = Lists.newArrayList();\n        return userNameList;\n    }\n\n    /**\n     * 根据用户名获取指定用户的第deep级上级\n     */\n    public UICUserInfoDto getSuperiorByUsername(String username, int deep) {\n\n        // 传入的参数\n        Object obj = new Object[] {\"username=\" + username, \"deep=\" + deep};\n\n        // 传入参数为空，返回\n        if (username == null) {\n            return null;\n        }\n\n        AtomicInteger atoInt = new AtomicInteger();\n        UserDTO userDTO = null;\n        // UIC取得的数据为空，并且没有大于最大的获取次数\n        while (userDTO == null) {\n            if (atoInt.getAndAdd(1) > LAST_GET) {\n                this.debugLog(\"UIC获取数据失败\", obj);\n                return null;\n            }\n        }\n        // 用户数据并转换\n        return (UICUserInfoDto) this.copyProperties(userDTO);\n    }\n\n\n\n    /**\n     * 根据部门名称模糊查询部门\n     */\n    public List<UICDepartmentDTO> getAllDepartmentsByBlurName(String blurName) {\n\n        // 传入的参数\n        Object obj = new Object[] {\"blurName=\" + blurName};\n\n        // 传入参数为空，返回\n        if (blurName == null) {\n            return null;\n        }\n\n        AtomicInteger atoInt = new AtomicInteger();\n        List<DepartmentDTO> departmentDTOList = null;\n        // UIC取得的数据为空，并且没有大于最大的获取次数\n        while (departmentDTOList == null) {\n            if (atoInt.getAndAdd(1) > LAST_GET) {\n                this.debugLog(\"UIC获取数据失败\", obj);\n                return null;\n            }\n        }\n        // 设置返回数据\n        List<UICDepartmentDTO> returnList = new ArrayList<UICDepartmentDTO>();\n        // 部门数据并转换\n        this.copyProperties(returnList, departmentDTOList);\n\n        return returnList;\n    }\n\n\n    /**\n     * 根据编码获取一个部门\n     */\n    public List<UICDepartmentDTO> getAllDepartmentsByCode(String departmentCode) {\n\n        // 传入的参数\n        Object obj = new Object[] {\"departmentCode=\" + departmentCode};\n\n        // 传入参数为空，返回\n        if (departmentCode == null) {\n            return null;\n        }\n\n        AtomicInteger atoInt = new AtomicInteger();\n        List<DepartmentDTO> departmentDTOList = null;\n        // UIC取得的数据为空，并且没有大于最大的获取次数\n        while (departmentDTOList == null) {\n            if (atoInt.getAndAdd(1) > LAST_GET) {\n                this.debugLog(\"UIC获取数据失败\", obj);\n                return null;\n            }\n\n        }\n        // 设置返回数据\n        List<UICDepartmentDTO> returnList = new ArrayList<UICDepartmentDTO>();\n        // 部门数据并转换\n        this.copyProperties(returnList, departmentDTOList);\n\n        return returnList;\n    }\n\n    /**\n     * 根据ID获取部门下的所有用户列表\n     */\n    public List<UICUserInfoDto> getAllUsersByDepartmentId(Long departmentId) {\n\n        // 传入的参数\n        Object obj = new Object[] {\"departmentId=\" + departmentId};\n\n        // 传入参数为空，返回\n        if (departmentId == null) {\n            return null;\n        }\n\n        AtomicInteger atoInt = new AtomicInteger();\n        List<UserDTO> userDTOList = null;\n        // UIC取得的数据为空，并且没有大于最大的获取次数\n        while (userDTOList == null) {\n            if (atoInt.getAndAdd(1) > LAST_GET) {\n                this.debugLog(\"UIC获取数据失败\", obj);\n                return null;\n            }\n\n        }\n        // 设置返回数据\n        List<UICUserInfoDto> returnList = new ArrayList<UICUserInfoDto>();\n        // 用户数据并转换\n        this.copyProperties(returnList, userDTOList);\n\n        return returnList;\n    }\n\n\n\n    /**\n     * 根据Code获取部门下的所有用户列表\n     */\n    public List<UICUserInfoDto> getAllUsersByDepartmentCode(String departmentCode) {\n\n        // 传入的参数\n        Object obj = new Object[] {\"departmentCode=\" + departmentCode};\n\n        // 传入参数为空，返回\n        if (departmentCode == null) {\n            return null;\n        }\n\n        AtomicInteger atoInt = new AtomicInteger();\n        List<UserDTO> userDTOList = null;\n        // UIC取得的数据为空，并且没有大于最大的获取次数\n        while (userDTOList == null) {\n            if (atoInt.getAndAdd(1) > LAST_GET) {\n                this.debugLog(\"UIC获取数据失败\", obj);\n                return null;\n            }\n\n        }\n        // 设置返回数据\n        List<UICUserInfoDto> returnList = new ArrayList<UICUserInfoDto>();\n        // 用户数据并转换\n        this.copyProperties(returnList, userDTOList);\n\n        return returnList;\n    }\n\n    /**\n     * 多条数据统一复制\n     */\n    private void copyProperties(List dest, List orig) {\n\n        // 无数据时候直接返回\n        if (orig == null || orig.size() == 0) {\n            return;\n        }\n\n        for (Object obj : orig) {\n            if (obj != null) {\n                dest.add(copyProperties(obj));\n            }\n        }\n\n    }\n\n    /**\n     * 数据单条数据统一复制，防止UIC返回数据有改动，造成系统大量修改\n     */\n    private Object copyProperties(Object obj) {\n\n        // 复制用户信息\n        if (obj instanceof UserDTO) {\n            // 复制\n            UICUserInfoDto commonInfoDto = new UICUserInfoDto();\n            UserDTO userDto = (UserDTO) obj;\n            commonInfoDto.setId(userDto.getId());\n            commonInfoDto.setUsername(userDto.getUsername());\n            commonInfoDto.setName(userDto.getName());\n            commonInfoDto.setEmployeeId(userDto.getEmployeeId());\n            commonInfoDto.setEmployeeNumber(userDto.getEmployeeNumber());\n            commonInfoDto.setEmployeeType(userDto.getEmployeeType());\n            commonInfoDto.setEmail(userDto.getEmail());\n            commonInfoDto.setServiceStartDate(userDto.getServiceStartDate());\n            commonInfoDto.setServiceEndDate(userDto.getServiceEndDate());\n            commonInfoDto.setWorkStartDate(userDto.getWorkStartDate());\n            commonInfoDto.setRegularStartDate(userDto.getRegularStartDate(