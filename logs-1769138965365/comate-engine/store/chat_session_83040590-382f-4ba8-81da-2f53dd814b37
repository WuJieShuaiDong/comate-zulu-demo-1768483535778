            "originalContent": "package com.baidu.pmc.core.service.impl;\n\nimport com.baidu.pmc.persistence.mapper.pmc.PmcFinanceSupplierApplyMapper;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyDTO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceSupplierApplyQO;\nimport com.github.pagehelper.Page;\nimport com.github.pagehelper.PageInfo;\n\nimport org.junit.Test;\nimport org.mockito.InjectMocks;\nimport org.mockito.Mock;\nimport org.mockito.MockitoAnnotations;\n\nimport java.util.Arrays;\nimport java.util.List;\n\nimport static org.mockito.Mockito.*;\n\nclass PmcPortalFinancingServiceImplTest {\n\n    @Mock\n    private PmcFinanceSupplierApplyMapper pmcFinanceSupplierApplyMapper;\n\n    @InjectMocks\n    private PmcPortalFinancingServiceImpl pmcPortalFinancingService;\n\n    @BeforeEach\n    void setUp() {\n        MockitoAnnotations.openMocks(this);\n    }\n\n    @Test\n    void findByConditionSupplierCode_shouldReturnPaginatedResult() {\n        // 准备测试数据\n        PmcFinanceSupplierApplyQO qo = new PmcFinanceSupplierApplyQO();\n        qo.setPageNum(1);\n        qo.setPageSize(10);\n\n        List<PmcFinanceSupplierApplyDTO> mockList = Arrays.asList(\n                new PmcFinanceSupplierApplyDTO(),\n                new PmcFinanceSupplierApplyDTO()\n        );\n\n        // 创建模拟分页对象\n        Page<PmcFinanceSupplierApplyDTO> page = new Page<>();\n        page.addAll(mockList);\n        page.setTotal(2);\n\n        // 模拟Mapper行为\n        when(pmcFinanceSupplierApplyMapper.selectApplyListBySupplierCode(qo))\n                .thenReturn(page);\n\n        // 执行测试\n        PageInfo<PmcFinanceSupplierApplyDTO> result =\n                pmcPortalFinancingService.findByConditionSupplierCode(qo);\n\n        // 验证结果\n        assertNotNull(result);\n        assertEquals(2, result.getList().size());\n        assertEquals(2, result.getTotal());\n        verify(pmcFinanceSupplierApplyMapper).selectApplyListBySupplierCode(qo);\n    }\n\n    @Test\n    void findByConditionSupplierCode_shouldHandleNonPagination() {\n        // 准备测试数据(不分页情况)\n        PmcFinanceSupplierApplyQO qo = new PmcFinanceSupplierApplyQO();\n        qo.setPageNum(0);\n        qo.setPageSize(0);\n\n        List<PmcFinanceSupplierApplyDTO> mockList = Arrays.asList(\n                new PmcFinanceSupplierApplyDTO()\n        );\n\n        // 模拟Mapper行为\n        when(pmcFinanceSupplierApplyMapper.selectApplyListBySupplierCode(qo))\n                .thenReturn(mockList);\n\n        // 执行测试\n        PageInfo<PmcFinanceSupplierApplyDTO> result =\n                pmcPortalFinancingService.findByConditionSupplierCode(qo);\n\n        // 验证结果\n        assertNotNull(result);\n        assertEquals(1, result.getList().size());\n    }\n\n    @Test\n    void findByConditionSupplierCode_shouldHandleEmptyResult() {\n        // 准备测试数据\n        PmcFinanceSupplierApplyQO qo = new PmcFinanceSupplierApplyQO();\n        qo.setPageNum(1);\n        qo.setPageSize(10);\n\n        // 创建空分页对象\n        Page<PmcFinanceSupplierApplyDTO> emptyPage = new Page<>();\n        emptyPage.setTotal(0);\n\n        // 模拟Mapper返回空列表\n        when(pmcFinanceSupplierApplyMapper.selectApplyListBySupplierCode(qo))\n                .thenReturn(emptyPage);\n\n        // 执行测试\n        PageInfo<PmcFinanceSupplierApplyDTO> result =\n                pmcPortalFinancingService.findByConditionSupplierCode(qo);\n\n        // 验证结果\n        assertNotNull(result);\n        assertTrue(result.getList().isEmpty());\n        assertEquals(0, result.getTotal());\n    }\n}",
