   </if>\n        </where>\n        GROUP BY pmc_pay.trx_type\n    </select>\n\n    <select id=\"selectFutureCashPositionByDate\" resultType=\"java.util.Map\">\n        SELECT\n          <if test=\"dateType != null and dateType eq 'byMonth'\">\n              <foreach collection=\"reportDate\" item=\"item\" separator=\",\" close=\",\">\n                  sum(case DATE_FORMAT(pmc_pay.pay_plan_date,'%Y-%m') when #{item} then -pmc_pay.amount else 0 end ) as #{item}\n              </foreach>\n          </if>\n          <if test=\"dateType != null and dateType eq 'byDay'\">\n              <foreach collection=\"reportDate\" item=\"item\" separator=\",\" close=\",\">\n                  sum(case pmc_pay.pay_plan_date when #{item} then -pmc_pay.amount else 0 end) as #{item}\n              </foreach>\n          </if>\n        pmc_pay.trx_type cashFlowCode\n        FROM\n        pmc_pay_checks pmc_pay\n        inner JOIN pmc_account ac ON pmc_pay.ac_account_id = ac.ac_account_id\n        <where>\n            ac.type IN ('HOME', 'ABROAD')\n            AND pmc_pay.`status` IN (\n            'CREATED',\n            'APPROVING',\n            'APPROVED',\n            'RELEASED',\n            'PENDING_SENT',\n            'PAYAGAIN',\n            'SAVED',\n            'ACCEPTED',\n            'APPROVED_LEVER1',\n            'APPROVED_LEVER2',\n            'REVISED_REFUSE',\n            'REVISED',\n            'SUSPECTED',\n            'DRAFT',\n            'SENDING',\n            'PAY_ORDER_GEN',\n            'BANK_PROCESSING',\n            'FAILED_BALANCE',\n            'VERITY_FAILED'\n            )\n            <if test=\"analysisBeginDate != null\">\n                and pmc_pay.pay_plan_date &gt;= #{analysisBeginDate}\n            </if>\n            <if test=\"analysisEndDate != null\">\n                and pmc_pay.pay_plan_date &lt;= #{analysisEndDate}\n            </if>\n            <if test=\"currencyCode != null and currencyCode != ''\">\n                and ac.currency = #{currencyCode}\n            </if>\n            <if test=\"companyList != null and companyList.size() > 0\">\n                and ac.company_code in\n                <foreach collection=\"companyList\" item=\"item\" open=\"(\" close=\")\" separator=\",\">\n                    #{item}\n                </foreach>\n            </if>\n            <if test=\"accountPool != null and accountPool != ''\">\n                and ac.ac_account_id IN (\n                SELECT\n                detail.ac_account_id\n                FROM\n                pmc_account_pool pool\n                INNER JOIN pmc_account_pool_detail detail ON pool.ac_pool_id = detail.ac_pool_id\n                WHERE\n                pool.ac_pool_code = #{accountPool})\n            </if>\n            <if test=\"account != null and account != ''\">\n                and ac.account_no = #{account}\n            </if>\n            <if test=\"tenantId != null\">\n                and pmc_pay.tenant_id = #{tenantId}\n            </if>\n        </where>\n        GROUP BY pmc_pay.trx_type\n        union all\n        SELECT\n        <if test=\"dateType != null and dateType eq 'byMonth'\">\n            <foreach collection=\"reportDate\" item=\"item\" separator=\",\" close=\",\">\n                sum(case DATE_FORMAT(pmc_pay.pay_plan_date,'%Y-%m') when #{item} then pmc_pay.exchange_amount\n                else 0 end\n                ) as #{item}\n            </foreach>\n        </if>\n        <if test=\"dateType != null and dateType eq 'byDay'\">\n            <foreach collection=\"reportDate\" item=\"item\" separator=\",\" close=\",\">\n                sum(case pmc_pay.pay_plan_date when #{item} then pmc_pay.exchange_amount else 0 end ) as #{item}\n            </foreach>\n        </if>\n        pmc_pay.trx_type cashFlowCode\n        FROM\n        pmc_pay_checks pmc_pay\n        left join pmc_pay_info info on pmc_pay.pay_info_id = info.pay_info_id\n        inner JOIN pmc_account ac ON info.attribute2 = ac.account_no and pmc_pay.amount_currency = ac.currency\n        <where>\n            pmc_pay.voucher_source = 'ZJHB'\n            and ac.type IN ('HOME', 'ABROAD')\n            AND pmc_pay.`status` IN (\n            'CREATED',\n            'APPROVING',\n            'APPROVED',\n            'RELEASED',\n            'PENDING_SENT',\n            'PAYAGAIN',\n            'SAVED',\n            'ACCEPTED',\n            'APPROVED_LEVER1',\n            'APPROVED_LEVER2',\n            'REVISED_REFUSE',\n            'REVISED',\n            'SUSPECTED',\n            'DRAFT',\n            'SENDING',\n            'PAY_ORDER_GEN',\n            'BANK_PROCESSING',\n            'FAILED_BALANCE',\n            'VERITY_FAILED'\n            )\n            <if test=\"analysisBeginDate != null\">\n                and pmc_pay.pay_plan_date &gt;= #{analysisBeginDate}\n            </if>\n            <if test=\"analysisEndDate != null\">\n                and pmc_pay.pay_plan_date &lt;= #{analysisEndDate}\n            </if>\n            <if test=\"currencyCode != null and currencyCode != ''\">\n                and ac.currency = #{currencyCode}\n            </if>\n            <if test=\"companyList != null and companyList.size() > 0\">\n                and ac.company_code in\n                <foreach collection=\"companyList\" item=\"item\" open=\"(\" close=\")\" separator=\",\">\n                    #{item}\n                </foreach>\n            </if>\n            <if test=\"accountPool != null and accountPool != ''\">\n                and ac.ac_account_id IN (\n                SELECT\n                detail.ac_account_id\n                FROM\n                pmc_account_pool pool\n                INNER JOIN pmc_account_pool_detail detail ON pool.ac_pool_id = detail.ac_pool_id\n                WHERE\n                pool.ac_pool_code = #{accountPool})\n            </if>\n            <if test=\"account != null and account != ''\">\n                and ac.account_no = #{account}\n            </if>\n            <if test=\"tenantId != null\">\n                and pmc_pay.tenant_id = #{tenantId}\n            </if>\n        </where>\n        GROUP BY pmc_pay.trx_type\n    </select>\n\n    <select id=\"selectCibPayListOne\" resultType=\"com.baidu.pmc.pojo.dto.PmcCmbPayInstructDTO\">\n        SELECT\n        ppci.pay_check_num,  -- 付款单号\n        ppcih.pay_date as payDate, -- 实际付款日期\n        ppcih.handle_date as handleDate, -- 实际付款日期\n        ppcih.amount as amount, -- 付款金额\n        ppcih.account as account, -- 付款银行账户\n        ppcih.amount_currency as amountCurrency, -- 账户币种\n        ppcih.payee as payee, -- 收款人全称\n        ppcih.payee_account as payeeAccount, -- 收款人银行账号\n        ppcih.payee_bank as payeeBank, -- 收款银行\n        ppcih.`status`,  -- 付款状态\n        ppcih.last_update_date, -- 处理时间\n        ppcih.process_message as processMessage, -- 银行反馈信息\n        ppcih.process_instance_number as serialNumber, -- 支付流水号\n        ppcih.payee_prov as payeeProv, -- 收款账户省\n        ppcih.payee_city as payeeCity -- 收款账户市\n        FROM\n        pmc_cib_pay_instruct ppci,\n        pmc_pay_checks ppc,\n        pmc_cib_pay_instruct_his ppcih\n        <where>\n            ppci.check_id = #{checkId,jdbcType=VARCHAR}\n            AND ppci.check_id = ppc.check_id\n            AND ppcih.pay_check_num = ppci.pay_check_num\n            AND ppcih.status in ('PAY_ORDER_GEN','FAILED','PAYED','REFUND')\n        </where>\n    </select>\n\n    <select id=\"selectAbcPayListOne\" resultType=\"com.baidu.pmc.pojo.dto.PmcCmbPayInstructDTO\">\n        SELECT\n        ppci.pay_check_num,  -- 付款单号\n        ppcih.pay_date as payDate, -- 实际付款日期\n        ppcih.handle_date as handleDate, -- 实际付款日期\n        ppcih.amount as amount, -- 付款金额\n        ppcih.account as account, -- 付款银行账户\n        ppcih.amount_currency as amountCurrency, -- 账户币种\n        ppcih.payee as payee, -- 收款人全称\n        ppcih.payee_account as payeeAccount, -- 收款人银行账号\n        ppcih.payee_bank as payeeBank, -- 收款银行\n        ppcih.`status`,  -- 付款状态\n        ppcih.last_update_date, -- 处理时间\n        ppcih.process_message as processMessage, -- 银行反馈信息\n        ppcih.req_seq_no as serialNumber, -- 支付流水号\n        ppcih.payee_prov as payeeProv, -- 收款账户省\n        ppcih.payee_city as payeeCity -- 收款账户市\n        FROM\n        pmc_abc_pay_instruct ppci,\n        pmc_pay_checks ppc,\n        pmc_abc_pay_instruct_his ppcih\n        <where>\n            ppci.check_id = #{checkId,jdbcType=VARCHAR}\n            AND ppci.check_id = ppc.check_id\n            AND ppcih.pay_id = ppci.pay_id\n            AND ppcih.status in ('PAY_ORDER_GEN','FAILED','PAYED','REFUND')\n        </where>\n    </select>\n\n    <select id=\"selectCebPayListOne\" resultType=\"com.baidu.pmc.pojo.dto.PmcCmbPayInstructDTO\">\n        SELECT\n        ppci.pay_check_num,  -- 付款单号\n        ppcih.pay_date as payDate, -- 实际付款日期\n        ppcih.handle_date as handleDate, -- 实际付款日期\n        ppcih.amount as amount, -- 付款金额\n        ppcih.account as account, -- 付款银行账户\n        ppcih.amount_currency as amountCurrency, -- 账户币种\n        ppcih.payee as payee, -- 收款人全称\n        ppcih.payee_account as payeeAccount, -- 收款人银行账号\n        ppcih.payee_bank as payeeBank, -- 收款银行\n        ppcih.`status`,  -- 付款状态\n        ppcih.last_update_date, -- 处理时间\n        ppcih.process_message as processMessage, -- 银行反馈信息\n        ppcih.client_patch_id as serialNumber, -- 支付流水号\n        ppcih.payee_prov as payeeProv, -- 收款账户省\n        ppcih.payee_city as payeeCity -- 收款账户市\n        FROM\n        pmc_ceb_pay_instruct ppci,\n        pmc_pay_checks ppc,\n        pmc_ceb_pay_instruct_his ppcih\n        <where>\n            ppci.check_id = #{checkId,jdbcType=VARCHAR}\n            AND ppci.check_id = ppc.check_id\n            AND ppcih.pay_id = ppci.pay_id\n            AND ppcih.status in ('PAY_ORDER_GEN','FAILED','PAYED','REFUND')\n        </where>\n    </select>\n\n    <select id=\"selectCiticPayListOne\" resultType=\"com.baidu.pmc.pojo.dto.PmcCmbPayInstructDTO\">\n        SELECT\n        ppci.pay_check_num,  -- 付款单号\n        ppcih.pay_date as payDate, -- 实际付款日期\n        ppcih.handle_date as handleDate, -- 实际付款日期\n        ppcih.amount as amount, -- 付款金额\n        ppcih.account as account, -- 付款银行账户\n        ppcih.amount_currency as amountCurrency, -- 账户币种\n        ppcih.payee as payee, -- 收款人全称\n        ppcih.payee_account as payeeAccount, -- 收款人银行账号\n        ppcih.payee_bank as payeeBank, -- 收款银行\n        ppcih.`status`,  -- 付款状态\n        ppcih.last_update_date, -- 处理时间\n        ppcih.process_message as processMessage, -- 银行反馈信息\n        ppcih.client_id as serialNumber, -- 支付流水号\n        ppcih.payee_prov as payeeProv, -- 收款账户省\n        ppcih.payee_city as payeeCity -- 收款账户市\n        FROM\n        pmc_ceb_pay_instruct ppci,\n        pmc_pay_checks ppc,\n        pmc_citic_pay_instruct_his ppcih\n        <where>\n            ppci.check_id = #{checkId,jdbcType=VARCHAR}\n            AND ppci.check_id = ppc.check_id\n            AND ppcih.pay_id = ppci.pay_id\n            AND ppcih.status in ('PAY_ORDER_GEN','FAILED','PAYED','REFUND')\n        </where>\n    </select>\n\n    <select id=\"getReceiptByPayCheckNum\" resultType=\"com.baidu.pmc.pojo.dto.cmb.ElectronicReceiptDTO\">\n        SELECT refnbr,\n               print_number printInstanceNumber,\n               file_name fileName\n        FROM pmc_receipt_transactions_ref\n        WHERE refnbr in\n            <foreach close=\")\" collection=\"payCheckNums\" item=\"num\" open=\"(\" separator=\",\">\n                #{num}\n            </foreach>\n    </select>\n    <select id=\"selectPayRollPayChecks\" parameterType=\"com.baidu.pmc.pojo.qo.PayChecksQO\"\n            resultType=\"com.baidu.pmc.pojo.dto.PayChecksDTO\">\n        ${safeOrderBy=orderBy,@java.util.Objects@requireNonNull(orderBy == null || orderBy.toString().matches(\"[\\\\w\\\\s$.*,]+\") ? \"\" : null, \"orderBy is not valid\")}\n\n        select\n        <include refid=\"Base_Column_List\"/>\n        from pmc_pay_checks tpc use index (pmc_pay_checks_u1,pmc_pay_checks_n2,pmc_pay_checks_n3,pmc_pay_checks_n4)\n        left join pmc_pay_info tpi\n        on tpc.pay_info_id = tpi.pay_info_id\n        <where>\n            tpc.hangup_flag != 'Y'\n            and tpc.status IN ('CREATED', 'APPROVING')\n            <if test=\"trxType != null and trxType != ''\">\n                and tpc.trx_type = #{trxType,jdbcType=VARCHAR}\n            </if>\n            <if test=\"companyCodes != null and companyCodes.size &gt; 0\">\n                and tpc.company_code in\n                <foreach close=\")\" collection=\"companyCodes\" item=\"companyCode\" open=\"(\" separator=\",\">\n                    #{companyCode}\n                </foreach>\n            </if>\n            <if test=\"teamId != null and teamId != ''\">\n                and (tpc.pay_recipient) IN (select finance_accountant_name FROM pmc_finance_accountant pfa,\n                pmc_finance_team pft\n                where\n                pfa.finance_team_id =\n                pft.finance_team_id AND pft.finance_team_id = #{teamId, jdbcType=BIGINT})\n            </if>\n            <if test=\"sourceNum != null and sourceNum != ''\">\n                and tpc.source_num = #{sourceNum,jdbcType=VARCHAR}\n            </if>\n            <if test=\"voucherSource != null and voucherSource != ''\">\n                and tpc.voucher_source = #{voucherSource,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payChecksAttribute12 != null and payChecksAttribute12 != ''\">\n                and tpc.attribute12 = #{payChecksAttribute12,jdbcType=VARCHAR}\n            </if>\n            <if test=\"currency != null and currency != ''\">\n                and tpc.currency = #{currency,jdbcType=VARCHAR}\n            </if>\n            <if test=\"account != null and account != ''\">\n                and tpc.account = #{account,jdbcType=VARCHAR}\n            </if>\n            <if test=\"acPoolId != null and acPoolId != ''\">\n                and tpc.ac_account_id in (select ac_account_id from pmc_account_pool_detail where ac_pool_id =\n                #{acPoolId,jdbcType=BIGINT})\n            </if>\n            <if test=\"payPlanDateEnd != null\">\n                and tpc.pay_plan_date &lt;= #{payPlanDateEnd,jdbcType=DATE}\n            </if>\n            <if test=\"payCheckNum != null and payCheckNum != ''\">\n                and tpc.pay_check_num = #{payCheckNum,jdbcType=VARCHAR}\n            </if>\n            <if test=\"attribute1 != null and attribute1 != ''\">\n                and tpi.attribute1 = #{attribute1,jdbcType=VARCHAR}\n            </if>\n            <if test=\"status != null and status != ''\">\n                and tpc.status = #{status,jdbcType=VARCHAR}\n            </if>\n            <if test=\"bdDirectFlag != null and bdDirectFlag != ''\">\n                and tpc.bd_direct_flag = #{bdDirectFlag,jdbcType=VARCHAR}\n            </if>\n            <if test=\"amountBegin != null and amountBegin != ''\">\n                and tpc.amount &gt;= #{amountBegin,jdbcType=DECIMAL}\n            </if>\n            <if test=\"amountEnd != null and amountEnd != ''\">\n                and tpc.amount &lt;= #{amountEnd,jdbcType=DECIMAL}\n            </if>\n            <if test=\"tenantId != null and tenantId !=''\">\n                AND tpc.tenant_id = #{tenantId, jdbcType=BIGINT}\n            </if>\n        </where>\n        <if test=\"orderBy != null and orderBy != ''\">\n            order by ${safeOrderBy}\n        </if>\n    </select>\n\n    <select id=\"getOverdraftAmount\" parameterType=\"com.baidu.pmc.pojo.dto.third.PayAmountQueryDTO\"\n            resultType=\"com.baidu.pmc.pojo.dto.cmb.BalanceInfo\">\n        select\n        tpc.account,\n        count(*) overdraftCount,\n        sum(tpc.amount) overdraftAmount\n        from pmc_pay_checks tpc\n        <where>\n            tpc.status in('FAILED_BALANCE')\n            <if test=\"accountList != null and accountList.size &gt; 0\">\n                and tpc.account in\n                <foreach close=\")\" collection=\"accountList\" item=\"account\" open=\"(\" separator=\",\">\n                    #{account}\n                </foreach>\n            </if>\n        </where>\n        GROUP BY tpc.account\n    </select>\n\n    <select id=\"getPreparePaymentAmount\" parameterType=\"com.baidu.pmc.pojo.dto.third.PayAmountQueryDTO\"\n            resultType=\"com.baidu.pmc.pojo.dto.cmb.BalanceInfo\">\n        select\n        tpc.account,\n        count(*) PreparePaymentCount,\n        sum(tpc.amount) PreparePaymentAmount\n        from pmc_pay_checks tpc\n        <where>\n            tpc.status in('APPROVED', 'RELEASED', 'PAY_ORDER_GEN', 'SENDING')\n            and tpc.pay_route = 'EPAYMENT'\n            and tpc.hangup_flag = 'N'\n            and pay_plan_date <![CDATA[  <= ]]> CURDATE()\n            <if test=\"accountList != null and accountList.size > 0\">\n                and tpc.account in\n                <foreach close=\")\" collection=\"accountList\" item=\"account\" open=\"(\" separator=\",\">\n                    #{account}\n                </foreach>\n            </if>\n            <if test=\"tenantId != null and tenantId !=''\">\n                AND tpc.tenant_id = #{tenantId, jdbcType=BIGINT}\n            </if>\n        </where>\n        GROUP BY tpc.account\n    </select>\n\n\n    <!-- 根据供应商编码查询付款单 -->\n    <select id=\"selectBySupplierCode\" resultType=\"com.baidu.pmc.pojo.dto.PmcPayChecksSupplierCodeDTO\">\n        SELECT\n        tpc.* FROM pmc_pay_checks tpc\n        <where>\n            tpc.pay_plan_date >= #{currentDatePlus3Days}\n            and tpc.pay_route = 'EPAYMENT'\n            AND tpc.status IN\n            <foreach collection=\"statusList\" item=\"status\" open=\"(\" separator=\",\" close=\")\">\n                #{tpc.status}\n            </foreach>\n            and not exists (select 1 from pmc_finance_supplier_apply pfsa WHERE tpc.pay_check_num = pfsa.pay_check_num\n              and pfsa.status in\n            <foreach collection=\"targetStatuses\" item=\"status\" open=\"(\" separator=\",\" close=\")\">\n                #{pfsa.status}\n            </foreach>\n             )\n            AND tpc.attribute15 = #{supplierCode}\n        </where>\n    </select>\n\n    <!-- 计算供应商当月可融资金额 -->\n    <select id=\"sumAmountBySupplierAndMonth\" resultType=\"java.util.Map\">\n        SELECT COALESCE(SUM(tpc.amount), 0) AS monthAmount\n        FROM pmc_pay_checks tpc\n        WHERE tpc.attribute15 = #{supplierCode}\n        AND tpc.status IN\n        <foreach collection=\"statusList\" item=\"status\" open=\"(\" separator=\",\" close=\")\">\n            #{status}\n        </foreach>\n        AND tpc.pay_plan_date > #{currentDatePlus7Days}\n        AND DATE_FORMAT(tpc.create_date, '%Y%m') = DATE_FORMAT(CURRENT_DATE, '%Y%m')\n    </select>\n\n    <!-- 计算供应商全年可融资金额 -->\n    <select id=\"sumAmountBySupplierAndYear\" resultType=\"java.util.Map\">\n        SELECT COALESCE(SUM(tpc.amount), 0) AS yearAmount\n        FROM pmc_pay_checks tpc\n        WHERE tpc.attribute15 = #{supplierCode}\n        AND tpc.status IN\n        <foreach collection=\"statusList\" item=\"status\" open=\"(\" separator=\",\" close=\")\">\n            #{status}\n        </foreach>\n        AND tpc.pay_plan_date > #{currentDatePlus7Days}\n        AND DATE_FORMAT(tpc.create_date, '%Y') = DATE_FORMAT(CURRENT_DATE, '%Y')\n    </select>\n\n    <select id=\"selectNotInvoiceList\" resultType=\"com.baidu.pmc.pojo.model.PmcPayChecks\">\n        SELECT *\n        FROM pmc_pay_checks p\n        WHERE NOT EXISTS (SELECT 1\n                          FROM pmc_pay_ic_invoices_data ic\n                          WHERE p.source_num = ic.source_num)\n          AND p.create_date > DATE_SUB(NOW(), INTERVAL 2 DAY)\n          and p.source_system = 'FSSC'\n    </select>\n\n</mapper>",
                "content": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE mapper PUBLIC \"-//mybatis.org//DTD Mapper 3.0//EN\" \"http://mybatis.org/dtd/mybatis-3-mapper.dtd\">\n<mapper namespace=\"com.baidu.pmc.persistence.mapper.pmc.PmcPayChecksMapper\">\n    <resultMap id=\"BaseResultMap\" type=\"com.baidu.pmc.pojo.model.PmcPayChecks\">\n        <!--\n          WARNING - @mbg.generated\n        -->\n        <id column=\"check_id\" property=\"checkId\" jdbcType=\"BIGINT\"/>\n        <result column=\"pay_check_num\" property=\"payCheckNum\" jdbcType=\"VARCHAR\"/>\n        <result column=\"tenant_id\" property=\"tenantId\" jdbcType=\"BIGINT\"/>\n        <result column=\"source_system\" property=\"sourceSystem\" jdbcType=\"VARCHAR\"/>\n        <result column=\"voucher_source\" property=\"voucherSource\" jdbcType=\"VARCHAR\"/>\n        <result column=\"expense_category\" property=\"expenseCategory\" jdbcType=\"VARCHAR\"/>\n        <result column=\"expense_type\" property=\"expenseType\" jdbcType=\"VARCHAR\"/>\n        <result column=\"source_num\" property=\"sourceNum\" jdbcType=\"VARCHAR\"/>\n        <result column=\"source_id\" property=\"sourceId\" jdbcType=\"BIGINT\"/>\n        <result column=\"source_detail_id\" property=\"sourceDetailId\" jdbcType=\"BIGINT\"/>\n        <result column=\"pay_schedule_id\" property=\"payScheduleId\" jdbcType=\"BIGINT\"/>\n        <result column=\"pay_plan_date\" property=\"payPlanDate\" jdbcType=\"DATE\"/>\n        <result column=\"urgency_flag\" property=\"urgencyFlag\" jdbcType=\"VARCHAR\"/>\n        <result column=\"bd_direct_flag\" property=\"bdDirectFlag\" jdbcType=\"VARCHAR\"/>\n        <result column=\"company_code\" property=\"companyCode\" jdbcType=\"VARCHAR\"/>\n        <result column=\"bank_code\" property=\"bankCode\" jdbcType=\"VARCHAR\"/>\n        <result column=\"trx_type\" property=\"trxType\" jdbcType=\"VARCHAR\"/>\n        <result column=\"pay_method\" property=\"payMethod\" jdbcType=\"VARCHAR\"/>\n        <result column=\"pay_group\" property=\"payGroup\" jdbcType=\"VARCHAR\"/>\n        <result column=\"pay_route\" property=\"payRoute\" jdbcType=\"VARCHAR\"/>\n        <result column=\"ac_account_id\" property=\"acAccountId\" jdbcType=\"BIGINT\"/>\n        <result column=\"account\" property=\"account\" jdbcType=\"VARCHAR\"/>\n        <result column=\"beneficiary_type_flag\" property=\"beneficiaryTypeFlag\" jdbcType=\"VARCHAR\"/>\n        <result column=\"currency\" property=\"currency\" jdbcType=\"VARCHAR\"/>\n        <result column=\"original_pay_check_num\" jdbcType=\"VARCHAR\" property=\"originalPayCheckNum\"/>\n        <result column=\"split_amount\" jdbcType=\"DECIMAL\" property=\"splitAmount\"/>\n        <result column=\"original_amount\" jdbcType=\"DECIMAL\" property=\"originalAmount\"/>\n        <result column=\"amount\" property=\"amount\" jdbcType=\"DECIMAL\"/>\n        <result column=\"amount_currency\" property=\"amountCurrency\" jdbcType=\"VARCHAR\"/>\n        <result column=\"exchange_rate\" property=\"exchangeRate\" jdbcType=\"DECIMAL\"/>\n        <result column=\"exchange_amount\" property=\"exchangeAmount\" jdbcType=\"DECIMAL\"/>\n        <result column=\"pay_desc\" property=\"payDesc\" jdbcType=\"VARCHAR\"/>\n        <result column=\"apply_date\" property=\"applyDate\" jdbcType=\"DATE\"/>\n        <result column=\"status\" property=\"status\" jdbcType=\"VARCHAR\"/>\n        <result column=\"ebank_export_flag\" property=\"ebankExportFlag\" jdbcType=\"VARCHAR\"/>\n        <result column=\"hangup_flag\" property=\"hangupFlag\" jdbcType=\"VARCHAR\"/>\n        <result column=\"naryur\" property=\"naryur\" jdbcType=\"VARCHAR\"/>\n        <result column=\"reference_number\" property=\"referenceNumber\" jdbcType=\"VARCHAR\"/>\n        <result column=\"remark\" property=\"remark\" jdbcType=\"VARCHAR\"/>\n        <result column=\"suspected_desc\" property=\"suspectedDesc\" jdbcType=\"VARCHAR\"/>\n        <result column=\"check_code\" property=\"checkCode\" jd