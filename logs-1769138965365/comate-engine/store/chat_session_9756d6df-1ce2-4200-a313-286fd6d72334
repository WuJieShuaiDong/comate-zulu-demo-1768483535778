etBankCode()));\n\n        if (requireFullFinancing &&\n                pmcFinanceSupplierApply.getFinanceAmount().compareTo(payChecks.getAmount()) != 0) {\n            log.error(\"{}银行不允许部分融资，供应商编码: {}, 付款单金额: {}, 融资金额: {}\",\n                    pmcFinanceSupplierApply.getBankCode(),\n                    pmcFinanceSupplierApply.getSupplierCode(),\n                    payChecks.getAmount(),\n                    pmcFinanceSupplierApply.getFinanceAmount());\n            throw new ServiceException(pmcFinanceSupplierApply.getBankCode() + \"银行不允许部分融资，请申请全额融资!\");\n        }\n\n    }\n\n\n    private PmcFinanceBankBaseQO assembleFinancingRequest(Map<String, Object> detail) {\n        // 融资申请单DTO - 安全类型转换\n        Object applyDTOObj = detail.get(\"applyDetail\");\n        PmcFinanceSupplierApplyDTO applyDTO = new PmcFinanceSupplierApplyDTO();\n        UtilType.copyProperties(applyDTO, applyDTOObj, true);\n        log.info(\"applyDTO:{}\", applyDTO);\n\n        // 付款单DTO - 安全类型转换\n        Object payChecksDTOObj = detail.get(\"payChecksSupplierCodeDTO\");\n        PmcPayChecksSupplierCodeDTO payChecksDTO = new PmcPayChecksSupplierCodeDTO();\n        UtilType.copyProperties(payChecksDTO, payChecksDTOObj, true);\n\n\n        // 供应商信息 - 安全类型转换\n        Object supplierObj = detail.get(\"supplier\");\n        PmcDataP2pSupplier supplier = new PmcDataP2pSupplier();\n        UtilType.copyProperties(supplier, supplierObj, true);\n\n\n        PmcFinanceBankBaseQO request = new PmcFinanceBankBaseQO();\n        // 基础信息 - 添加空值检查\n        request.setApplyNumber(applyDTO.getApplyNumber());\n        request.setPayCheckNum(applyDTO.getPayCheckNum());\n        request.setSupplierCode(applyDTO.getSupplierCode());\n        request.setSupplierName(applyDTO.getSupplierName());\n        request.setBankCode(applyDTO.getBankCode());\n        request.setCompanyCode(payChecksDTO.getCompanyCode());\n\n        request.setRegistrationCode(supplier.getRegistrationCode());\n        request.setPayPlanDate(applyDTO.getPatyPlanDate());\n\n\n        request.setFinanceAmount(applyDTO.getFinanceAmount());\n        request.setSupplierAccount(payChecksDTO.getAccount());\n        // todo 供应商开户银行和开户地址\n        request.setSupplierBank(StringUtils.isBlank(payChecksDTO.getBankCodeName()) ? applyDTO.getBankCodeName() : payChecksDTO.getBankCodeName());\n        request.setSupplierAddress(StringUtils.isBlank(payChecksDTO.getAttribute4()) ? payChecksDTO.getAttribute6() : payChecksDTO.getAttribute4());\n\n        request.setPayableAmount(payChecksDTO.getAmount());\n        request.setCurrency(applyDTO.getCurrency());\n        request.setFinanceNumber(applyDTO.getPayCheckNum());\n\n        // 发票信息\n        // request.setInvoiceType(payChecksDTO.getInvoiceType());\n        /*request.setInvoiceNumber(payChecksDTO.getInvoiceNumber());\n        request.setInvoiceCode(payChecksDTO.getInvoiceCode());\n        request.setInvoiceDate(payChecksDTO.getInvoiceDate());\n        request.setTaxExcludedAmount(payChecksDTO.getInvoiceAmount());\n        request.setDocumentAmount(payChecksDTO.getTotalAmount());*/\n        request.setSupplierInvoicesDTOList(payChecksDTO.getInvoicesDTOList());\n\n        // 合同信息\n        request.setContractId(StringUtils.isBlank(payChecksDTO.getContractNum()) ?\n                payChecksDTO.getPayChecksAttribute16() : payChecksDTO.getContractNum());\n        request.setContractName(StringUtils.isBlank(applyDTO.getContractName()) ? \"/\" :\n                applyDTO.getContractName());\n        // 合同类型没有\n        // request.setContractType(payChecksDTO.getContractType());\n        request.setContractAmount(payChecksDTO.getContractAmount());\n        request.setContractEffectDate(DateUtils.formatDate(payChecksDTO.getContractEffectiveDate(), \"yyyyMMdd\"));\n        // 还款账户\n        request.setBuyerAccount(applyDTO.getPayAccount());\n\n        // 融资开始日期和融资结束日期\n        request.setFinanceStartDate(new Date());\n        request.setFinanceEndDate(applyDTO.getPatyPlanDate());\n\n        return request;\n    }\n\n    /**\n     * 校验银行融资基础请求参数\n     *\n     * @param request 融资请求参数\n     * @throws IllegalArgumentException 包含具体字段的错误提示\n     */\n    private void validateFinancingRequest(PmcFinanceBankBaseQO request) {\n        // 1. 基础信息校验\n        Validate.notBlank(request.getApplyNumber(), \"融资申请单号(applyNumber)不能为空\");\n        Validate.notBlank(request.getPayCheckNum(), \"付款单号(payCheckNum)不能为空\");\n        Validate.notBlank(request.getSupplierCode(), \"供应商编码(supplierCode)不能为空\");\n        Validate.notBlank(request.getSupplierName(), \"供应商名称(supplierName)不能为空\");\n        Validate.notBlank(request.getBankCode(), \"银行编码(bankCode)不能为空\");\n        Validate.notBlank(request.getCompanyCode(), \"公司编码(companyCode)不能为空\");\n\n        // 2. 金额校验\n        Validate.notNull(request.getFinanceAmount(), \"融资金额(financeAmount)不能为空\");\n        Validate.isTrue(request.getFinanceAmount().compareTo(BigDecimal.ZERO) > 0,\n                \"融资金额必须大于0\");\n\n        // 3. 账户信息校验\n        Validate.notBlank(request.getSupplierAccount(), \"供应商账户(supplierAccount)不能为空\");\n        Validate.notBlank(request.getSupplierBank(), \"供应商开户行(supplierBank)不能为空\");\n        Validate.notBlank(request.getSupplierAddress(), \"供应商开户地址(supplierAddress)不能为空\");\n\n        // 4. 时间校验\n        Validate.notNull(request.getPayPlanDate(), \"付款计划日期(payPlanDate)不能为空\");\n\n\n        // 5. 发票信息校验\n        if (request.getSupplierInvoicesDTOList().isEmpty()) {\n            throw new IllegalArgumentException(\"发票信息(supplierInvoicesDTOList)不能为空\");\n        }\n        request.getSupplierInvoicesDTOList().forEach(invoice -> {\n            Validate.notBlank(invoice.getInvoiceNumber(), \"发票号码(invoiceNumber)不能为空\");\n            Validate.notBlank(invoice.getInvoiceCode(), \"发票代码(invoiceCode)不能为空\");\n            Validate.notNull(invoice.getInvoiceDate(), \"发票日期(invoiceDate)不能为空\");\n            Validate.notNull(invoice.getTaxExcludedAmount(), \"不含税金额(taxExcludedAmount)不能为空\");\n            Validate.