      "content": "/*\n * Copyright (C) 2018 Baidu, Inc. All Rights Reserved.\n */\npackage com.baidu.pmc.web.configuration;\n\nimport com.baidu.bpit.inf.apigo.sdk.verify.ApiGoReqJwtVerifyFilter;\nimport com.baidu.bpit.inf.apigo.sdk.verify.strategy.UrlPatternMatcherStrategy;\nimport com.baidu.bpit.inf.apigo.sdk.verify.strategy.impl.DefaultAntUrlPatternMatcherStrategy;\nimport lombok.Data;\nimport org.springframework.boot.context.properties.ConfigurationProperties;\nimport org.springframework.boot.web.servlet.FilterRegistrationBean;\nimport org.springframework.context.annotation.Bean;\nimport org.springframework.context.annotation.Configuration;\nimport org.springframework.core.Ordered;\n\n/**\n * @author liuyanzhong\n */\n@Configuration\n@ConfigurationProperties(prefix = \"pmc.apiGo\")\n@Data\npublic class ApiGoClientConfig {\n\n    private String jwtSignKey;\n\n    @Bean\n    public UrlPatternMatcherStrategy urlPatternMatcherStrategy() {\n        DefaultAntUrlPatternMatcherStrategy urlPatternMatcherStrategy = new DefaultAntUrlPatternMatcherStrategy();\n        // 多个路径用英文逗号分隔\n        urlPatternMatcherStrategy.setPattern(\"/test/**,/static/**\");\n        return urlPatternMatcherStrategy;\n    }\n\n    @Bean\n    public ApiGoReqJwtVerifyFilter apiGoReqJwtVerifyFilter() {\n        ApiGoReqJwtVerifyFilter apiGoReqJwtVerifyFilter = new ApiGoReqJwtVerifyFilter();\n        apiGoReqJwtVerifyFilter.setJwtSignKey(jwtSignKey);\n        // 注入豁免的匹配类\n        apiGoReqJwtVerifyFilter.setIgnoreUrlPatternMatcherStrategy(urlPatternMatcherStrategy());\n        return apiGoReqJwtVerifyFilter;\n    }\n\n    @Bean\n    public FilterRegistrationBean apiGoFilterRegistration(ApiGoReqJwtVerifyFilter jwtVerifyFilter) {\n        FilterRegistrationBean apiGoFilterReg = new FilterRegistrationBean();\n        apiGoFilterReg.setFilter(jwtVerifyFilter);\n        apiGoFilterReg.setOrder(Ordered.HIGHEST_PRECEDENCE);\n        // 进去apiGo鉴权路径模式\n        apiGoFilterReg.addUrlPatterns(\"/pmcApiGo/*\");\n        return apiGoFilterReg;\n    }\n}\n",
