      "content": "package com.baidu.pmc.web.controller.third;\n\n\nimport com.alibaba.fastjson.JSON;\nimport com.baidu.pmc.common.ResponseMessage;\nimport com.baidu.pmc.pojo.dto.PmcBocomhkTransQO;\nimport com.baidu.pmc.pojo.dto.cmb.PmcCmbCloudDirectQO;\nimport com.baidu.pmc.pojo.dto.third.PaycheckRequestDTO;\nimport com.baidu.pmc.pojo.model.PmcAccount;\nimport com.baidu.pmc.pojo.model.cmb.PayQO;\nimport com.baidu.pmc.pojo.qo.BankcommonBalanceOldQO;\nimport com.baidu.pmc.pojo.qo.PmcAccountSearchQO;\nimport com.baidu.pmc.web.clients.AccountClient;\nimport com.baidu.pmc.web.clients.BankToPayClient;\nimport com.baidu.pmc.web.clients.bankcommon.BankCommonClient;\nimport com.baidu.pmc.web.clients.bankcommonpilot.BankCommonPilotClient;\nimport com.baidu.pmc.web.clients.bocomhk.BocomhkApiGoClient;\nimport com.baidu.pmc.web.clients.third.CmbApiGoClient;\nimport com.baidu.pmc.web.clients.third.PayChecksDataClient;\nimport lombok.extern.slf4j.Slf4j;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.http.HttpStatus;\nimport org.springframework.http.ResponseEntity;\nimport org.springframework.stereotype.Controller;\nimport org.springframework.web.bind.annotation.PostMapping;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.ResponseBody;\n\nimport java.util.List;\n\n/**\n * pmc apiGo 接入接口\n *\n * @author liuyanzhong\n */\n@RequestMapping(\"/pmcApiGo\")\n@Slf4j\n@Controller\npublic class ApiGoController {\n\n    @Autowired\n    private CmbApiGoClient cmbApiGoClient;\n\n    @Autowired\n    private BocomhkApiGoClient bocomhkApiGoClient;\n\n    @Autowired\n    private BankCommonClient bankCommonClient;\n\n    @Autowired\n    private PayChecksDataClient payChecksDataClient;\n\n    @Autowired\n    private BankToPayClient bankToPayClient;\n\n    @Autowired\n    private AccountClient accountClient;\n\n    @Autowired\n    private BankCommonPilotClient bankCommonPilotClient;\n\n    /**\n     * 测试接口\n     */\n    @PostMapping(\"/test\")\n    @ResponseBody\n    public ResponseEntity<Object> test() {\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\"), HttpStatus.OK);\n    }\n\n\n    @PostMapping(\"/queryAccountingSubunit\")\n    @ResponseBody\n    public ResponseEntity<Object> queryAccountingSubunit(@RequestBody PmcCmbCloudDirectQO requestDTO) {\n        log.info(\"交易管家-查询记账子单元信息, 入参:{}\", JSON.toJSONString(requestDTO));\n        ResponseEntity<Object> responseMessage = cmbApiGoClient.queryAccountingSubunit(requestDTO);\n        return responseMessage;\n    }\n\n    @PostMapping(\"/addAccountingSubunit\")\n    @ResponseBody\n    public ResponseEntity<Object> addAccountingSubunit(@RequestBody PmcCmbCloudDirectQO requestDTO) {\n        log.info(\"交易管家-新增记账子单元, 入参:{}\", JSON.toJSONString(requestDTO));\n        ResponseEntity<Object> responseMessage = cmbApiGoClient.addAccountingSubunit(requestDTO);\n        return responseMessage;\n    }\n\n    @PostMapping(\"/deleteAccountingSubunit\")\n    @ResponseBody\n    public ResponseEntity<Object> deleteAccountingSubunit(@RequestBody PmcCmbCloudDirectQO requestDTO) {\n        log.info(\"交易管家-关闭记账子单元, 入参:{}\", JSON.toJSONString(requestDTO));\n        ResponseEntity<Object> responseMessage = cmbApiGoClient.deleteAccountingSubunit(requestDTO);\n        return responseMessage;\n    }\n\n    @PostMapping(\"/getBocomhkTransInfo\")\n    @ResponseBody\n    public ResponseEntity<Object> getBocomhkTransInfo(@RequestBody PmcBocomhkTransQO bocomhkTransQO) {\n        log.info(\"getBocomhkTransInfo, 入参:{}\", JSON.toJSONString(bocomhkTransQO));\n        ResponseEntity<Object> responseMessage = bocomhkApiGoClient.getBocomhkTransInfo(bocomhkTransQO);\n        return responseMessage;\n    }\n\n    @PostMapping(\"/selectBankcommonTrans\")\n    @ResponseBody\n    public ResponseMessage selectBankcommonTrans(@RequestBody PayQO payQO) {\n        log.info(\"selectBankcommonTrans, 入参:{}\", JSON.toJSONString(payQO));\n        String bankCode = \"\";\n        try {\n            PmcAccountSearchQO qo = new PmcAccountSearchQO();\n            qo.setAccountNo(payQO.getAccount());\n            List<PmcAccount> accountList = accountClient.selectByAccountNo(qo);\n            bankCode = accountList.get(0).getBank();\n        }catch (Exception e){\n            log.error(\"获取银行信息异常\");\n        }\n        if (bankToPayClient.getTransferPilotBankCodeList().contains(bankCode)) {\n            return bankCommonPilotClient.selectBankcommonTrans(payQO);\n        } else {\n            return bankCommonClient.selectBankcommonTrans(payQO);\n        }\n    }\n\n    @PostMapping(\"/selectBankcommonBalanceOld\")\n    @ResponseBody\n    public ResponseMessage selectBankcommonBalanceOld(@RequestBody BankcommonBalanceOldQO qo) {\n        log.info(\"selectBankcommonBalanceOld, 入参:{}\", JSON.toJSONString(qo));\n        String bankCode = \"\";\n        try {\n            bankCode = qo.getAccountList().get(0).getBank();\n        }catch (Exception e){\n            log.error(\"获取银行信息异常\");\n        }\n        if (bankToPayClient.getTransferPilotBankCodeList().contains(bankCode)) {\n            return bankCommonPilotClient.selectBankcommonBalanceOld(qo);\n        } else {\n            return bankCommonClient.selectBankcommonBalanceOld(qo);\n        }\n    }\n\n    @PostMapping(\"/financingStatus\")\n    @ResponseBody\n    public ResponseMessage financingStatus(@RequestBody PaycheckRequestDTO qo) {\n        log.info(\"financingStatus, 入参:{}\", JSON.toJSONString(qo));\n        return payChecksDataClient.getFinanceStatus(qo);\n    }\n}\n",
