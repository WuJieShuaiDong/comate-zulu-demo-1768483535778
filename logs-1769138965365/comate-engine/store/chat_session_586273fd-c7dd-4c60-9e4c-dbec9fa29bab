DD {col_def};\")\n            elif db_type == \"Oracle\":\n                # Oracle ADD 语法稍有不同，括号包裹\n                # 简化处理：单条 ADD\n                sqls.append(f\"ALTER TABLE {q}{table_name}{q} ADD ({col_def});\")\n            elif db_type == \"SQLite\":\n                sqls.append(f\"ALTER TABLE {q}{table_name}{q} ADD COLUMN {col_def};\")\n            \n            # 补注释\n            if db_type in [\"PostgreSQL\", \"Oracle\"] and row.get(\"注释\"):\n                sqls.append(f\"COMMENT ON COLUMN {q}{table_name}{q}.{q}{row['字段名']}{q} IS '{row['注释']}';\")\n\n    # --- 3. 修改字段 ---\n    elif action_type == \"修改字段\":\n        for _, row in valid_rows.iterrows():\n            col_name = row[\"字段名\"]\n            col_def_core = get_field_definition(db_type, row, q)\n            # 去掉字段名部分，只取定义 (简化处理)\n            # 这里的 get_field_definition 返回了 \"name type ...\", 我们需要拆解\n            # 更好的方式是重构 get_field_definition，但为了快速实现，这里做字符串处理\n            # 或者针对 Modify 重新组装\n            \n            type_part = row.get(\"类型\")\n            if row.get(\"长度/参数\"): type_part += f\"({row.get('长度/参数')})\"\n            \n            if db_type == \"MySQL\":\n                # MySQL: MODIFY COLUMN col_name definition\n                sqls.append(f\"ALTER TABLE {q}{table_name}{q} MODIFY COLUMN {col_def_core};\")\n            elif db_type == \"PostgreSQL\":\n                # PG 比较麻烦，通常分拆\n                # 1. Type\n                sqls.append(f\"ALTER TABLE {q}{table_name}{q} ALTER COLUMN {q}{col_name}{q} TYPE {type_part};\")\n                # 2. Not Null\n                nn_op = \"SET NOT NULL\" if row.get(\"非空\") else \"DROP NOT NULL\"\n                sqls.append(f\"ALTER TABLE {q}{table_name}{q} ALTER COLUMN {q}{col_name}{q} {nn_op};\")\n                # 3. Default\n                default_val = row.get(\"默认值\")\n                if default_val:\n                    val = default_val if default_val.upper() in [\"NULL\", \"TRUE\", \"FALSE\"] or row.get(\"类型\") in [\"INT\", \"INTEGER\"] else f\"'{default_val}'\"\n                    sqls.append(f\"ALTER TABLE {q}{table_name}{q} ALTER COLUMN {q}{col_name}{q} SET DEFAULT {val};\")\n                else:\n                    sqls.append(f\"ALTER TABLE {q}{table_name}{q} ALTER COLUMN {q}{col_name}{q} DROP DEFAULT;\")\n            elif db_type == \"SQL Server\":\n                # SQL Server: ALTER COLUMN col_name type [NULL|NOT NULL]\n                null_part = \"NOT NULL\" if row.get(\"非空\") else \"NULL\"\n                sqls.append(f\"ALTER TABLE {q}{table_name}{q} ALTER COLUMN {q}{col_name}{q} {type_part} {null_part};\")\n            elif db_type == \"Oracle\":\n                # Oracle: MODIFY (col_name type ...)\n                # Oracle 修改定义不重复写字段名，而是 (name type ...)\n                def_only = col_def_core # 包含名字\n                sqls.append(f\"ALTER TABLE {q}{table_name}{q} MODIFY ({def_only});\")\n\n    # --- 4. 删除字段 ---\n    elif action_type == \"删除字段\":\n        for _, row in valid_rows.iterrows():\n            col_name = row[\"字段名\"]\n            if db_type in [\"MySQL\", \"PostgreSQL\", \"SQL Server\", \"Oracle\"]:\n                sqls.append(f\"ALTER TABLE {q}{table_name}{q} DROP COLUMN {q}{col_name}{q};\")\n            elif db_type == \"SQLite\":\n                # SQLite 较新版本支持 DROP COLUMN\n                sqls.append(f\"ALTER TABLE {q}{table_name}{q} DROP COLUMN {q}{col_name}{q};\")\n\n    # --- 5. 索引操作 ---\n    elif action_type == \"添加索引\":\n        for _, row in valid_rows.iterrows():\n            idx_name = row.get(\"索引名\", f\"idx_{table_name}_{row['字段名']}\")\n            cols = row.get(\"字段名\", \"\") # 这里作为索引列字符串\n            unique = \"UNIQUE \" if row.get(\"唯一\", False) else \"\"\n            sqls.append(f\"CREATE {unique}INDEX {idx_name} ON {q}{table_name}{q} ({cols});\")\n    \n    elif action_type == \"删除索引\":\n        for _, row in valid_rows.iterrows():\n            idx_name = row[\"索引名\"]\n            if db_type == \"MySQL\":\n                sqls.append(f\"DROP INDEX {idx_name} ON {q}{table_name}{q};\")\n            elif db_type == \"SQL Server\":\n                sqls.append(f\"DROP INDEX {q}{table_name}{q}.{idx_name};\")\n            else:\n                sqls.append(f\"DROP INDEX {idx_name};\")\n\n    # --- 6. 表操作 ---\n    elif action_type == \"删除表\":\n        sqls.append(f\"DROP TABLE IF EXISTS {q}{table_name}{q};\")\n    \n    elif action_type == \"清空表\":\n        if db_type == \"SQLite\":\n            sqls.append(f\"DELETE FROM {q}{table_name}{q};\")\n            sqls.append(\"VACUUM;\")\n        else:\n            sqls.append(f\"TRUNCATE TABLE {q}{table_name}{q};\")\n\n    return \"\\n\".join(sqls)\n\n# --- 界面逻辑 ---\n\nst.sidebar.header(\"🛠️ 配置面板\")\ndb_type = st.sidebar.selectbox(\"数据库类型\", list(DB_CONFIG.keys()))\ntable_name = st.sidebar.text_input(\"目标表名\", value=\"users\")\n\n# 操作类型选择\naction_map = {\n    \"✨ 新建表 (CREATE)\": \"新建表\",\n    \"➕ 添加字段 (ADD)\": \"添加字段\",\n    \"🔧 修改字段 (MODIFY)\": \"修改字段\",\n    \"❌ 删除字段 (DROP)\": \"删除字段\",\n    \"🔍 添加索引 (INDEX)\": \"添加索引\",\n    \"🗑️ 删除索引 (DROP INDEX)\": \"删除索引\",\n    \"💣 删除/清空表\": \"删除表\" # 特殊处理\n}\naction_label = st.sidebar.radio(\"选择操作\", list(action_map.keys()))\naction_type = action_map[action_label]\n\nif action_type == \"删除表\":\n    sub_action = st.sidebar.radio(\"具体操作\", [\"删除表 (DROP)\", \"清空表 (TRUNCATE)\"])\n    action_type = \"删除表\" if \"DROP\" in sub_action else \"清空表\"\n\n# 额外选项\nextra_options = {}\nif db_type == \"MySQL\" and action_type == \"新建表\":\n    with st.sidebar.expander(\"MySQL 特有选项\", expanded=True):\n        extra_options[\"engine\"] = st.selectbox(\"存储引擎\", [\"InnoDB\", \"MyISAM\"])\n        extra_options[\"charset\"] = st.selectbox(\"字符集\", [\"utf8mb4\", \"utf8\", \"latin1\"])\n\n# 主界面\nst.title(f\"SQL 生成器 - {action_type}\")\n\n# 根据操作类型定义 DataFrame 的列结构\nif \"df\" not in st.session_state:\n    st.session_state.df = pd.DataFrame([{\"字段名\": \"id\", \"类型\": \"INT\", \"长度/参数\": \"\", \"主键\": True, \"非空\": True, \"自增\": True, \"注释\": \"ID\"}])\n\n# 动态调整列配置\ncolumn_config = {}\ndefault_data = []\n\nif action_type in [\"新建表\", \"添加字段\", \"修改字段\"]:\n    # 完整列定义\n    column_config = {\n        \"字段名\": st.column_config.TextColumn(required=True),\n        \"类型\": st.column_config.SelectboxColumn(options=DB_CONFIG[db_type][\"types\"], required=True),\n        \"非空\": st.column_config.CheckboxColumn(default=False),\n        \"默认值\": st.column_config.TextColumn(),\n        \"注释\": st.column_config.TextColumn()\n    }\n    if action_type == \"新建表\":\n        column_config[\"主键\"] = st.column_config.CheckboxColumn(default=False)\n        column_config[\"自增\"] = st.column_config.CheckboxColumn(default=False)\n    \n    # 初始化数据结构\n    if action_type == \"新建表\":\n        default_data = [{\"字段名\": \"id\", \"类型\": \"INT\", \"主键\": True, \"非空\": True, \"自增\": True}]\n    else:\n        default_data = [{\"字段名\": \"new_column\", \"类型\": \"VARCHAR\", \"长度/参数\": \"255\"}]\n\nelif action_type == \"删除字段\":\n    column_config = {\n        \"字段名\": st.column_config.TextColumn(\"要删除的字段名\", required=True)\n    }\n    default_data = [{\"字段名\": \"old_column\"}]\n\nelif action_type == \"添加索引\":\n    column_config = {\n        \"索引名\": st.column_config.TextColumn(required=True),\n        \"字段名\": st.column_config.TextColumn(\"包含字段(逗号分隔)\", required=True),\n        \"唯一\": st.column_config.CheckboxColumn(default=False)\n    }\n    default_data = [{\"索引名\": f\"idx_{table_name}_col\", \"字段名\": \"col1\", \"唯一\": False}]\n\nelif action_type == \"删除索引\":\n    column_config = {\n        \"索引名\": st.column_config.TextColumn(required=True)\n    }\n    default_data = [{\"索引名\": \"idx_name\"}]\n\n# 渲染表格 (清空表操作不需要表格)\nedited_df = pd.DataFrame()\nif action_type not in [\"删除表\", \"清空表\"]:\n    # 每次切换操作类型时重置数据有点烦人，这里尝试保留 session 里的数据结构如果是兼容的\n    # 简单起见，这里每次都给一个干净的表格模板，用户体验可能更好一点\n    df_template = pd.DataFrame(default_data)\n    \n    edited_df = st.data_editor(\n        df_template,\n        column_config=column_config,\n        num_rows=\"dynamic\",\n        use_container_width=True,\n        hide_index=True\n    )\n\n# 生成按钮\nst.markdown(\"---\")\nif st.button(\"🚀 生成 SQL\", type=\"primary\", use_container_width=True):\n    try:\n        sql = generate_sql(action_type, db_type, table_name, edited_df, extra_options)\n        \n        st.subheader(\"生成结果\")\n        st.code(sql, language=\"sql\")\n        \n        st.download_button(\"📥 下载 SQL\", sql, f\"{table_name}_{action_type}.sql\")\n    except Exception as e:\n        st.error(f\"生成出错: {e}\")\n",
                "afterChangeFileContent": "import streamlit as st\nimport pandas as pd\nimport base64\nimport json\nimport io\nfrom openai import OpenAI\n\n# --- 配置部分 ---\nst.set_page_config(page_title=\"全能 SQL 生成器\", layout=\"wide\", page_icon=\"🛠️\")\n\n# 数据库配置与类型定义\nDB_CONFIG = {\n    \"MySQL\": {\n        \"types\": [\"INT\", \"BIGINT\", \"VARCHAR\", \"CHAR\", \"TEXT\", \"LONGTEXT\", \"DATETIME\", \"DATE\", \"TIMESTAMP\", \"DECIMAL\", \"FLOAT\", \"DOUBLE\", \"BOOLEAN\", \"JSON\", \"BLOB\"],\n        \"quote\": \"`\",\n        \"features\": [\"comment_inline\", \"engine_option\"]\n    },\n    \"PostgreSQL\": {\n        \"types\": [\"INTEGER\", \"BIGINT\", \"VARCHAR\", \"CHAR\", \"TEXT\", \"TIMESTAMP\", \"DATE\", \"TIME\", \"BOOLEAN\", \"NUMERIC\", \"REAL\", \"DOUBLE PRECISION\", \"JSON\", \"JSONB\", \"UUID\", \"BYTEA\"],\n        \"quote\": \"\\\"\",\n        \"features\": [\"comment_statement\", \"serial_type\"]\n    },\n    \"SQLite\": {\n        \"types\": [\"INTEGER\", \"TEXT\", \"BLOB\", \"REAL\", \"NUMERIC\"],\n        \"quote\": \"\\\"\",\n        \"features\": []\n    },\n    \"SQL Server\": {\n        \"types\": [\"INT\", \"BIGINT\", \"VARCHAR\", \"NVARCHAR\", \"CHAR\", \"NCHAR\", \"TEXT\", \"DATETIME\", \"DATE\", \"DECIMAL\", \"FLOAT\", \"BIT\", \"MONEY\"],\n        \"quote\": \"\\\"\", # or []\n        \"features\": [\"comment_dash\"]\n    },\n    \"Oracle\": {\n        \"types\": [\"NUMBER\", \"INTEGER\", \"VARCHAR2\", \"NVARCHAR2\", \"CHAR\", \"DATE\", \"TIMESTAMP\", \"CLOB\", \"BLOB\", \"FLOAT\"],\n        \"quote\": \"\\\"\",\n        \"features\": [\"comment_statement\"]\n    }\n}\n\n# --- 辅助函数：AI 与文件处理 ---\n\ndef image_to_base64(image_file):\n    \"\"\"将上传的图片文件转换为 Base64 字符串\"\"\"\n    return base64.b64encode(image_file.getvalue()).decode('utf-8')\n\ndef extract_schema_from_image(image_file, api_key, base_url=None, model=\"gpt-4o\"):\n    \"\"\"调用多模态大模型解析图片结构\"\"\"\n    if not api_key:\n        return None, \"请先在侧边栏配置 API Key\"\n    \n    try:\n        # 兼容第三方 OpenAI 格式的接口\n        client = OpenAI(api_key=api_key, base_url=base_url if base_url else None)\n        base64_image = image_to_base64(image_file)\n        \n        with st.spinner('AI 正在观察并分析图片结构...'):\n            response = client.chat.completions.create(\n                model=model,\n                messages=[\n                    {\n                        \"role\": \"system\",\n                        \"content\": \"你是一个专业的数据库架构师。你的任务是从图片中提取数据库表结构信息。\"\n                    },\n                    {\n                        \"role\": \"user\",\n                        \"content\": [\n                            {\"type\": \"text\", \"text\": \"请分析这张图片（可能是ER图、表格设计文档、Excel截图或数据截图），提取出数据库建表所需的字段信息。\\n\\n请严格返回一个纯 JSON 数组（Array of Objects），不要包含 markdown 格式标记（如 ```json）。\\n\\n数组中每个对象必须包含以下键（如果无法推断请留空或使用默认值）：\\n- '字段名' (String): 英文或拼音字段名\\n- '类型' (String): 标准SQL类型(如 INT, VARCHAR, DATETIME)\\n- '长度/参数' (String): 如 '255', '10,2'\\n- '默认值' (String)\\n- '主键' (Boolean): true/false\\n- '非空' (Boolean): true/false\\n- '自增' (Boolean): true/false\\n- '注释' (String): 字段的中文描述\"},\n                            {\n                                \"type\": \"image_url\",\n                                \"image_url\": {\n                                    \"url\": f\"data:image/jpeg;base64,{base64_image}\"\n                                },\n                            },\n                        ],\n                    }\n                ],\n                max_tokens=4000,\n                temperature=0.1\n            )\n            content = response.choices[0].message.content\n            \n            # 清理可能存在的 Markdown 标记\n            content = content.strip()\n            if content.startswith(\"```json\"):\n                content = content[7:]\n            if content.startswith(\"```\"):\n                content = content[3:]\n            if content.endswith(\"```\"):\n                content = content[:-3]\n                \n            data = json.loads(content)\n            return pd.DataFrame(data), None\n    except Exception as e:\n        return None, f\"AI 解析失败: {str(e)}\"\n\ndef extract_schema_from_file(uploaded_file):\n    \"\"\"从 Excel/CSV 导入结构\"\"\"\n    try:\n        if uploaded_file.name.lower().endswith('.csv'):\n            df = pd.read_csv(uploaded_file)\n        else:\n            df = pd.read_excel(uploaded_file)\n            \n        # 策略 A：判断是否为“数据字典/结构定义表”\n        # 检查列名是否包含特定的关键词组合\n        col_str = \" \".join([str(c).lower() for c in df.columns])\n        keywords = [\"字段\", \"类型\", \"field\", \"type\", \"comment\", \"注释\"]\n        match_count = sum(1 for k in keywords if k in col_str)\n        \n        is_schema_def = match_count >= 2\n        \n        new_data = []\n        \n        if is_schema_def:\n            # 尝试映射列\n            for _, row in df.iterrows():\n                item = {}\n                for col in df.columns:\n                    c = str(col).lower()\n                    val = row[col]\n                    if pd.isna(val): val = \"\"\n                    else: val = str(val).strip()\n                    \n                    if \"字段\" in c or \"name\" in c or \"code\" in c: item[\"字段名\"] = val\n                    elif \"类型\" in c or \"type\" in c: item[\"类型\"] = val\n                    elif \"长\" in c or \"len\" in c: item[\"长度/参数\"] = val\n                    elif \"默认\" in c or \"default\" in c: item[\"默认值\"] = val\n                    elif \"主\" in c or \"pk\" in c or \"key\" in c: item[\"主键\"] = str(val).lower() in ['true', '1', 'yes', '是', 'y']\n                    elif \"非\" in c or \"null\" in c or \"nn\" in c: item[\"非空\"] = str(val).lower() in ['true', '1', 'yes', '是', 'y', 'not null']\n                    elif \"增\" in c or \"auto\" in c or \"ai\" in c: item[\"自增\"] = str(val).lower() in ['true', '1', 'yes', '是', 'y']\n                    elif \"注\" in c or \"comment\" in c or \"desc\" in c: item[\"注释\"] = val\n                \n                if item.get(\"字段名\"):\n                    # 补全默认值\n                    item.setdefault(\"类型\", \"VARCHAR\")\n                    item.setdefault(\"长度/参数\", \"\")\n                    item.setdefault(\"默认值\", \"\")\n                    item.setdefault(\"主键\", False)\n                    item.setdefault(\"非空\", False)\n                    item.setdefault(\"自增\", False)\n                    item.setdefault(\"注释\", \"\")\n                    new_data.append(item)\n        else:\n            # 策略 B：原始数据，根据数据推断结构\n            for col in df.columns:\n                dtype = df[col].dtype\n                sql_type = \"VARCHAR\"\n                length = \"255\"\n                \n                if pd.api.types.is_integer_dtype(dtype):\n                    sql_type = \"INT\"\n                    length = \"\"\n                elif pd.api.types.is_float_dtype(dtype):\n                    sql_type = \"DECIMAL\"\n                    length = \"10,2\"\n                elif pd.api.types.is_datetime64_any_dtype(dtype):\n                    sql_type = \"DATETIME\"\n                    length = \"\"\n                elif pd.api.types.is_bool_dtype(dtype):\n                    sql_type = \"BOOLEAN\"\n                    length = \"\"\n                \n                new_data.append({\n                    \"字段名\": str(col).strip(),\n                    \"类型\": sql_type,\n                    \"长度/参数\": length,\n                    \"默认值\": \"\",\n                    \"主键\": False,\n                    \"非空\": False,\n                    \"自增\": False,\n                    \"注释\": \"\"\n                })\n            \n            # 智能猜测：如果第一个字段叫 id，设为主键\n            if new_data and new_data[0][\"字段名\"].lower() in [\"id\", \"uid\", \"user_id\", \"pk\"]:\n                new_data[0][\"主键\"] = True\n                new_data[0][\"自增\"] = True\n                new_data[0][\"非空\"] = True\n\n        if not new_data:\n            return None, \"无法从文件中提取有效字段信息\"\n            \n        return pd.DataFrame(new_data), None\n        \n    except Exception as e:\n        return None, f\"文件解析出错: {str(e)}\"\n\n# --- 核心逻辑 ---\n\ndef get_field_definition(db_type, row, q):\n    \"\"\"根据数据库类型生成单个字段的定义字符串\"\"\"\n    col_name = str(row.get(\"字段名\", \"\")).strip()\n    col_type = str(row.get(\"类型\", \"VARCHAR\")).strip()\n    col_len = str(row.get(\"长度/参数\", \"\")).strip()\n    default_val = str(row.get(\"默认值\", \"\")).strip()\n    is_nn = row.get(\"非空\", False)\n    is_ai = row.get(\"自增\", False)\n    comment = str(row.get(\"注释\", \"\")).strip()\n    \n    parts = []\n    parts.append(f\"{q}{col_name}{q}\")\n    \n    full_type = col_type\n    # PG Serial 特殊处理\n    if db_type == \"PostgreSQL\" and is_ai and col_type.upper() in [\"INTEGER\", \"BIGINT\", \"INT\"]:\n        full_type = \"SERIAL\" if \"BIG\" not in col_type.upper() else \"BIGSERIAL\"\n        is_ai = False \n    elif col_len and col_type.upper() not in [\"TEXT\", \"DATE\", \"DATETIME\", \"TIMESTAMP\", \"BOOLEAN\", \"INT\", \"INTEGER\", \"BIGINT\", \"SERIAL\", \"UUID\", \"JSON\", \"JSONB\"]:\n        full_type = f\"{col_type}({col_len})\"\n    parts.append(full_type)\n    \n    if default_val:\n        if default_val.upper() in [\"NULL\", \"CURRENT_TIMESTAMP\", \"NOW()\"] or \\\n           col_type.upper() in [\"INT\", \"INTEGER\", \"BIGINT\", \"DECIMAL\", \"NUMERIC\", \"FLOAT\", \"DOUBLE\", \"BOOLEAN\"]:\n            parts.append(f\"DEFAULT {default_val}\")\n        else:\n            parts.append(f\"DEFAULT '{default_val}'\")\n\n    if is_nn:\n        parts.append(\"NOT NULL\")\n    elif db_type == \"SQL Server\" and not is_nn:\n        parts.append(\"NULL\") \n\n    if is_ai:\n        if db_type == \"MySQL\":\n            parts.append(\"AUTO_INCREMENT\")\n        elif db_type == \"SQLite\":\n            parts.append(\"AUTOINCREMENT\") \n        elif db_type == \"SQL Server\":\n            parts.append(\"IDENTITY(1,1)\")\n        elif db_type == \"Oracle\":\n            parts.append(\"GENERATED BY DEFAULT AS 