                "originalContent": null,
                "content": "import streamlit as st\nimport pandas as pd\n\n# --- 配置部分 ---\nst.set_page_config(page_title=\"通用 SQL 生成器\", layout=\"wide\")\n\n# 数据库支持的常见类型定义\nDB_TYPES_CONFIG = {\n    \"MySQL\": {\n        \"types\": [\"INT\", \"BIGINT\", \"VARCHAR\", \"CHAR\", \"TEXT\", \"LONGTEXT\", \"DATETIME\", \"DATE\", \"TIMESTAMP\", \"DECIMAL\", \"FLOAT\", \"DOUBLE\", \"BOOLEAN\", \"JSON\", \"BLOB\"],\n        \"quote_char\": \"`\",\n        \"pk_inline\": True,\n        \"auto_inc_keyword\": \"AUTO_INCREMENT\"\n    },\n    \"PostgreSQL\": {\n        \"types\": [\"INTEGER\", \"BIGINT\", \"VARCHAR\", \"CHAR\", \"TEXT\", \"TIMESTAMP\", \"DATE\", \"TIME\", \"BOOLEAN\", \"NUMERIC\", \"REAL\", \"DOUBLE PRECISION\", \"JSON\", \"JSONB\", \"UUID\", \"BYTEA\"],\n        \"quote_char\": \"\\\"\",\n        \"pk_inline\": True,\n        \"auto_inc_keyword\": \"SERIAL\" # 特殊处理\n    },\n    \"SQLite\": {\n        \"types\": [\"INTEGER\", \"TEXT\", \"BLOB\", \"REAL\", \"NUMERIC\"],\n        \"quote_char\": \"\\\"\",\n        \"pk_inline\": True,\n        \"auto_inc_keyword\": \"AUTOINCREMENT\"\n    },\n    \"SQL Server\": {\n        \"types\": [\"INT\", \"BIGINT\", \"VARCHAR\", \"NVARCHAR\", \"CHAR\", \"NCHAR\", \"TEXT\", \"DATETIME\", \"DATE\", \"DECIMAL\", \"FLOAT\", \"BIT\", \"MONEY\"],\n        \"quote_char\": \"\\\"\", # 或者 []\n        \"pk_inline\": True,\n        \"auto_inc_keyword\": \"IDENTITY(1,1)\"\n    },\n    \"Oracle\": {\n        \"types\": [\"NUMBER\", \"INTEGER\", \"VARCHAR2\", \"NVARCHAR2\", \"CHAR\", \"DATE\", \"TIMESTAMP\", \"CLOB\", \"BLOB\", \"FLOAT\"],\n        \"quote_char\": \"\\\"\",\n        \"pk_inline\": True,\n        \"auto_inc_keyword\": \"GENERATED BY DEFAULT AS IDENTITY\" # Oracle 12c+\n    }\n}\n\ndef generate_create_table_sql(db_type, version, table_name, columns_df, engine=\"InnoDB\", charset=\"utf8mb4\"):\n    config = DB_TYPES_CONFIG.get(db_type, DB_TYPES_CONFIG[\"MySQL\"])\n    q = config[\"quote_char\"]\n    \n    if not table_name:\n        table_name = \"example_table\"\n\n    lines = []\n    lines.append(f\"CREATE TABLE {q}{table_name}{q} (\")\n    \n    pks = []\n    col_defs = []\n    \n    for idx, row in columns_df.iterrows():\n        col_name = row.get(\"字段名\", \"\").strip()\n        if not col_name:\n            continue\n            \n        col_type = row.get(\"类型\", \"VARCHAR\")\n        col_len = str(row.get(\"长度/参数\", \"\")).strip()\n        default_val = str(row.get(\"默认值\", \"\")).strip()\n        is_pk = row.get(\"主键\", False)\n        is_nn = row.get(\"非空\", False)\n        is_ai = row.get(\"自增\", False)\n        comment = str(row.get(\"注释\", \"\")).strip()\n        \n        # 构建字段定义部分\n        field_parts = [f\"  {q}{col_name}{q}\"]\n        \n        # 类型处理\n        full_type = col_type\n        if col_len and col_type not in [\"TEXT\", \"LONGTEXT\", \"BLOB\", \"CLOB\", \"JSON\", \"JSONB\", \"DATE\", \"DATETIME\", \"TIMESTAMP\", \"BOOLEAN\", \"INT\", \"INTEGER\", \"BIGINT\", \"SERIAL\", \"UUID\"]:\n            full_type = f\"{col_type}({col_len})\"\n        \n        # PostgreSQL SERIAL 特殊处理\n        if db_type == \"PostgreSQL\" and is_ai and col_type in [\"INTEGER\", \"BIGINT\"]:\n            full_type = \"SERIAL\" if col_type == \"INTEGER\" else \"BIGSERIAL\"\n            is_ai = False # 已包含在类型中\n            \n        field_parts.append(full_type)\n        \n        # 属性处理\n        if is_nn:\n            field_parts.append(\"NOT NULL\")\n            \n        # 默认值处理\n        if default_val:\n            if default_val.upper() in [\"NULL\", \"CURRENT_TIMESTAMP\", \"NOW()\"]:\n                field_parts.append(f\"DEFAULT {default_val}\")\n            elif col_type in [\"INT\", \"INTEGER\", \"BIGINT\", \"DECIMAL\", \"NUMERIC\", \"FLOAT\", \"DOUBLE\", \"REAL\", \"NUMBER\", \"BIT\", \"BOOLEAN\"]:\n                 field_parts.append(f\"DEFAULT {default_val}\")\n            else:\n                 field_parts.append(f\"DEFAULT '{default_val}'\")\n                 \n        # 自增处理\n        if is_ai and config[\"auto_inc_keyword\"]:\n            field_parts.append(config[\"auto_inc_keyword\"])\n            \n        # 注释处理 (MySQL支持inline comment)\n        if db_type == \"MySQL\" and comment:\n            field_parts.append(f\"COMMENT '{comment}'\")\n            \n        col_defs.append(\" \".join(field_parts))\n        \n        if is_pk:\n            pks.append(col_name)\n\n    # 组合主键 (对于某些数据库，推荐在最后定义主键，尤其是复合主键)\n    if pks:\n        pk_cols = \", \".join([f\"{q}{c}{q}\" for c in pks])\n        col_defs.append(f\"  PRIMARY KEY ({pk_cols})\")\n\n    lines.append(\",\\n\".join(col_defs))\n    lines.append(\")\")\n    \n    # 尾部选项\n    if db_type == \"MySQL\":\n        lines[-1] += f\" ENGINE={engine} DEFAULT CHARSET={charset};\"\n    else:\n        lines[-1] += \";\"\n        \n    # 其他数据库的注释通常是独立语句\n    comment_sqls = []\n    if db_type != \"MySQL\":\n        for idx, row in columns_df.iterrows():\n            col_name = row.get(\"字段名\", \"\").strip()\n            comment = str(row.get(\"注释\", \"\")).strip()\n            if col_name and comment:\n                if db_type == \"PostgreSQL\" or db_type == \"Oracle\":\n                     comment_sqls.append(f\"COMMENT ON COLUMN {q}{table_name}{q}.{q}{col_name}{q} IS '{comment}';\")\n                elif db_type == \"SQL Server\":\n                     comment_sqls.append(f\"-- 注释: {col_name} -> {comment}\")\n\n    final_sql = \"\\n\".join(lines)\n    if comment_sqls:\n        final_sql += \"\\n\\n\" + \"\\n\".join(comment_sqls)\n        \n    return final_sql\n\n# --- 界面部分 ---\nst.title(\"🛠️ 通用数据库建表 SQL 生成器\")\nst.markdown(\"选择数据库类型，在下方表格中配置字段，即可生成标准的 DDL 语句。\")\n\n# 侧边栏配置\nwith st.sidebar:\n    st.header(\"⚙️ 全局配置\")\n    db_type = st.selectbox(\"数据库类型\", list(DB_TYPES_CONFIG.keys()))\n    \n    version_options = [\"默认\"]\n    if db_type == \"MySQL\":\n        version_options = [\"5.7\", \"8.0\"]\n    elif db_type == \"PostgreSQL\":\n        version_options = [\"12\", \"13\", \"14\", \"15\"]\n    elif db_type == \"Oracle\":\n        version_options = [\"11g\", \"12c\", \"19c\", \"21c\"]\n        \n    version = st.selectbox(\"数据库版本\", version_options)\n    \n    st.subheader(\"表信息\")\n    table_name = st.text_input(\"表名 (Table Name)\", value=\"users\")\n    \n    mysql_engine = \"InnoDB\"\n    mysql_charset = \"utf8mb4\"\n    if db_type == \"MySQL\":\n        st.subheader(\"MySQL 特有配置\")\n        mysql_engine = st.selectbox(\"存储引擎\", [\"InnoDB\", \"MyISAM\"])\n        mysql_charset = st.selectbox(\"字符集\", [\"utf8mb4\", \"utf8\", \"latin1\"])\n\n# 初始化数据\nif \"df\" not in st.session_state:\n    # 默认示例行\n    data = {\n        \"字段名\": [\"id\", \"username\", \"created_at\"],\n        \"类型\": [\"INT\", \"VARCHAR\", \"DATETIME\"],\n        \"长度/参数\": [\"\", \"50\", \"\"],\n        \"默认值\": [\"\", \"\", \"CURRENT_TIMESTAMP\"],\n        \"主键\": [True, False, False],\n        \"非空\": [True, True, True],\n        \"自增\": [True, False, False],\n        \"注释\": [\"主键ID\", \"用户名\", \"创建时间\"]\n    }\n    st.session_state.df = pd.DataFrame(data)\n\n# 主界面：字段编辑器\nst.subheader(\"📝 字段配置\")\n\n# 根据选择的数据库类型更新类型下拉选项\ncurrent_types = DB_TYPES_CONFIG[db_type][\"types\"]\n\ncolumn_config = {\n    \"字段名\": st.column_config.TextColumn(\"字段名\", required=True),\n    \"类型\": st.column_config.SelectboxColumn(\"类型\", options=current_types, required=True),\n    \"长度/参数\": st.column_config.TextColumn(\"长度/参数\", help=\"如 VARCHAR(255) 填 255\"),\n    \"默认值\": st.column_config.TextColumn(\"默认值\"),\n    \"主键\": st.column_config.CheckboxColumn(\"主键\", default=False),\n    \"非空\": st.column_config.CheckboxColumn(\"非空\", default=False),\n    \"自增\": st.column_config.CheckboxColumn(\"自增\", default=False),\n    \"注释\": st.column_config.TextColumn(\"注释\")\n}\n\nedited_df = st.data_editor(\n    st.session_state.df,\n    column_config=column_config,\n    num_rows=\"dynamic\",\n    use_container_width=True,\n    hide_index=True\n)\n\n# 生成按钮\nst.divider()\ngenerate_btn = st.button(\"✨ 生成 SQL 语句\", type=\"primary\", use_container_width=True)\n\nif generate_btn:\n    try:\n        # 在生成前先简单清洗数据（移除空行）\n        valid_rows = edited_df[edited_df[\"字段名\"].str.strip() != \"\"]\n        \n        if valid_rows.empty:\n            st.warning(\"请至少添加一个有效的字段！\")\n        else:\n            sql = generate_create_table_sql(\n                db_type, version, table_name, valid_rows, \n                engine=mysql_engine, charset=mysql_charset\n            )\n            \n            st.subheader(\"📄 生成结果\")\n            st.code(sql, language=\"sql\")\n            \n            # 简单的下载功能\n            st.download_button(\n                label=\"📥 下载 SQL 文件\",\n                data=sql,\n                file_name=f\"{table_name}_create.sql\",\n                mime=\"text/plain\"\n            )\n            \n    except Exception as e:\n        st.error(f\"生成失败: {str(e)}\")\n        st.exception(e)\n",
