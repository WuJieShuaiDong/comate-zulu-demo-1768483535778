 table_name:\n        table_name = \"example_table\"\n\n    lines = []\n    lines.append(f\"CREATE TABLE {q}{table_name}{q} (\")\n    \n    pks = []\n    col_defs = []\n    \n    for idx, row in columns_df.iterrows():\n        col_name = row.get(\"字段名\", \"\").strip()\n        if not col_name:\n            continue\n            \n        col_type = row.get(\"类型\", \"VARCHAR\")\n        col_len = str(row.get(\"长度/参数\", \"\")).strip()\n        default_val = str(row.get(\"默认值\", \"\")).strip()\n        is_pk = row.get(\"主键\", False)\n        is_nn = row.get(\"非空\", False)\n        is_ai = row.get(\"自增\", False)\n        comment = str(row.get(\"注释\", \"\")).strip()\n        \n        # 构建字段定义部分\n        field_parts = [f\"  {q}{col_name}{q}\"]\n        \n        # 类型处理\n        full_type = col_type\n        if col_len and col_type not in [\"TEXT\", \"LONGTEXT\", \"BLOB\", \"CLOB\", \"JSON\", \"JSONB\", \"DATE\", \"DATETIME\", \"TIMESTAMP\", \"BOOLEAN\", \"INT\", \"INTEGER\", \"BIGINT\", \"SERIAL\", \"UUID\"]:\n            full_type = f\"{col_type}({col_len})\"\n        \n        # PostgreSQL SERIAL 特殊处理\n        if db_type == \"PostgreSQL\" and is_ai and col_type in [\"INTEGER\", \"BIGINT\"]:\n            full_type = \"SERIAL\" if col_type == \"INTEGER\" else \"BIGSERIAL\"\n            is_ai = False # 已包含在类型中\n            \n        field_parts.append(full_type)\n        \n        # 属性处理\n        if is_nn:\n            field_parts.append(\"NOT NULL\")\n            \n        # 默认值处理\n        if default_val:\n            if default_val.upper() in [\"NULL\", \"CURRENT_TIMESTAMP\", \"NOW()\"]:\n                field_parts.append(f\"DEFAULT {default_val}\")\n            elif col_type in [\"INT\", \"INTEGER\", \"BIGINT\", \"DECIMAL\", \"NUMERIC\", \"FLOAT\", \"DOUBLE\", \"REAL\", \"NUMBER\", \"BIT\", \"BOOLEAN\"]:\n                 field_parts.append(f\"DEFAULT {default_val}\")\n            else:\n                 field_parts.append(f\"DEFAULT '{default_val}'\")\n                 \n        # 自增处理\n        if is_ai and config[\"auto_inc_keyword\"]:\n            field_parts.append(config[\"auto_inc_keyword\"])\n            \n        # 注释处理 (MySQL支持inline comment)\n        if db_type == \"MySQL\" and comment:\n            field_parts.append(f\"COMMENT '{comment}'\")\n            \n        col_defs.append(\" \".join(field_parts))\n        \n        if is_pk:\n            pks.append(col_name)\n\n    # 组合主键 (对于某些数据库，推荐在最后定义主键，尤其是复合主键)\n    if pks:\n        pk_cols = \", \".join([f\"{q}{c}{q}\" for c in pks])\n        col_defs.append(f\"  PRIMARY KEY ({pk_cols})\")\n\n    lines.append(\",\\n\".join(col_defs))\n    lines.append(\")\")\n    \n    # 尾部选项\n    if db_type == \"MySQL\":\n        lines[-1] += f\" ENGINE={engine} DEFAULT CHARSET={charset};\"\n    else:\n        lines[-1] += \";\"\n        \n    # 其他数据库的注释通常是独立语句\n    comment_sqls = []\n    if db_type != \"MySQL\":\n        for idx, row in columns_df.iterrows():\n            col_name = row.get(\"字段名\", \"\").strip()\n            comment = str(row.get(\"注释\", \"\")).strip()\n            if col_name and comment:\n                if db_type == \"PostgreSQL\" or db_type == \"Oracle\":\n                     comment_sqls.append(f\"COMMENT ON COLUMN {q}{table_name}{q}.{q}{col_name}{q} IS '{comment}';\")\n                elif db_type == \"SQL Server\":\n                     comment_sqls.append(f\"-- 注释: {col_name} -> {comment}\")\n\n    final_sql = \"\\n\".join(lines)\n    if comment_sqls:\n        final_sql += \"\\n\\n\" + \"\\n\".join(comment_sqls)\n        \n    return final_sql\n\n# --- 界面部分 ---\nst.title(\"🛠️ 通用数据库建表 SQL 生成器\")\nst.markdown(\"选择数据库类型，在下方表格中配置字段，即可生成标准的 DDL 语句。\")\n\n# 侧边栏配置\nwith st.sidebar:\n    st.header(\"⚙️ 全局配置\")\n    db_type = st.selectbox(\"数据库类型\", list(DB_TYPES_CONFIG.keys()))\n    \n    version_options = [\"默认\"]\n    if db_type == \"MySQL\":\n        version_options = [\"5.7\", \"8.0\"]\n    elif db_type == \"PostgreSQL\":\n        version_options = [\"12\", \"13\", \"14\", \"15\"]\n    elif db_type == \"Oracle\":\n        version_options = [\"11g\", \"12c\", \"19c\", \"21c\"]\n        \n    version = st.selectbox(\"数据库版本\", version_options)\n    \n    st.subheader(\"表信息\")\n    table_name = st.text_input(\"表名 (Table Name)\", value=\"users\")\n    \n    mysql_engine = \"InnoDB\"\n    mysql_charset = \"utf8mb4\"\n    if db_type == \"MySQL\":\n        st.subheader(\"MySQL 特有配置\")\n        mysql_engine = st.selectbox(\"存储引擎\", [\"InnoDB\", \"MyISAM\"])\n        mysql_charset = st.selectbox(\"字符集\", [\"utf8mb4\", \"utf8\", \"latin1\"])\n\n# 初始化数据\nif \"df\" not in st.session_state:\n    # 默认示例行\n    data = {\n        \"字段名\": [\"id\", \"username\", \"created_at\"],\n        \"类型\": [\"INT\", \"VARCHAR\", \"DATETIME\"],\n        \"长度/参数\": [\"\", \"50\", \"\"],\n        \"默认值\": [\"\", \"\", \"CURRENT_TIMESTAMP\"],\n        \"主键\": [True, False, False],\n        \"非空\": [True, True, True],\n        \"自增\": [True, False, False],\n        \"注释\": [\"主键ID\", \"用户名\", \"创建时间\"]\n    }\n    st.session_state.df = pd.DataFrame(data)\n\n# 主界面：字段编辑器\nst.subheader(\"📝 字段配置\")\n\n# 根据选择的数据库类型更新类型下拉选项\ncurrent_types = DB_TYPES_CONFIG[db_type][\"types\"]\n\ncolumn_config = {\n    \"字段名\": st.column_config.TextColumn(\"字段名\", required=True),\n    \"类型\": st.column_config.SelectboxColumn(\"类型\", options=current_types, required=True),\n    \"长度/参数\": st.column_config.TextColumn(\"长度/参数\", help=\"如 VARCHAR(255) 填 255\"),\n    \"默认值\": st.column_config.TextColumn(\"默认值\"),\n    \"主键\": st.column_config.CheckboxColumn(\"主键\", default=False),\n    \"非空\": st.column_config.CheckboxColumn(\"非空\", default=False),\n    \"自增\": st.column_config.CheckboxColumn(\"自增\", default=False),\n    \"注释\": st.column_config.TextColumn(\"注释\")\n}\n\nedited_df = st.data_editor(\n    st.session_state.df,\n    column_config=column_config,\n    num_rows=\"dynamic\",\n    use_container_width=True,\n    hide_index=True\n)\n\n# 生成按钮\nst.divider()\ngenerate_btn = st.button(\"✨ 生成 SQL 语句\", type=\"primary\", use_container_width=True)\n\nif generate_btn:\n    try:\n        # 在生成前先简单清洗数据（移除空行）\n        valid_rows = edited_df[edited_df[\"字段名\"].str.strip() != \"\"]\n        \n        if valid_rows.empty:\n            st.warning(\"请至少添加一个有效的字段！\")\n        else:\n            sql = generate_create_table_sql(\n                db_type, version, table_name, valid_rows, \n                engine=mysql_engine, charset=mysql_charset\n            )\n            \n            st.subheader(\"📄 生成结果\")\n            st.code(sql, language=\"sql\")\n            \n            # 简单的下载功能\n            st.download_button(\n                label=\"📥 下载 SQL 文件\",\n                data=sql,\n                file_name=f\"{table_name}_create.sql\",\n                mime=\"text/plain\"\n            )\n            \n    except Exception as e:\n        st.error(f\"生成失败: {str(e)}\")\n        st.exception(e)\n",
                "afterChangeFileContent": "import streamlit as st\nimport pandas as pd\n\n# --- 配置部分 ---\nst.set_page_config(page_title=\"全能 SQL 生成器\", layout=\"wide\", page_icon=\"🛠️\")\n\n# 数据库配置与类型定义\nDB_CONFIG = {\n    \"MySQL\": {\n        \"types\": [\"INT\", \"BIGINT\", \"VARCHAR\", \"CHAR\", \"TEXT\", \"LONGTEXT\", \"DATETIME\", \"DATE\", \"TIMESTAMP\", \"DECIMAL\", \"FLOAT\", \"DOUBLE\", \"BOOLEAN\", \"JSON\", \"BLOB\"],\n        \"quote\": \"`\",\n        \"features\": [\"comment_inline\", \"engine_option\"]\n    },\n    \"PostgreSQL\": {\n        \"types\": [\"INTEGER\", \"BIGINT\", \"VARCHAR\", \"CHAR\", \"TEXT\", \"TIMESTAMP\", \"DATE\", \"TIME\", \"BOOLEAN\", \"NUMERIC\", \"REAL\", \"DOUBLE PRECISION\", \"JSON\", \"JSONB\", \"UUID\", \"BYTEA\"],\n        \"quote\": \"\\\"\",\n        \"features\": [\"comment_statement\", \"serial_type\"]\n    },\n    \"SQLite\": {\n        \"types\": [\"INTEGER\", \"TEXT\", \"BLOB\", \"REAL\", \"NUMERIC\"],\n        \"quote\": \"\\\"\",\n        \"features\": []\n    },\n    \"SQL Server\": {\n        \"types\": [\"INT\", \"BIGINT\", \"VARCHAR\", \"NVARCHAR\", \"CHAR\", \"NCHAR\", \"TEXT\", \"DATETIME\", \"DATE\", \"DECIMAL\", \"FLOAT\", \"BIT\", \"MONEY\"],\n        \"quote\": \"\\\"\", # or []\n        \"features\": [\"comment_dash\"]\n    },\n    \"Oracle\": {\n        \"types\": [\"NUMBER\", \"INTEGER\", \"VARCHAR2\", \"NVARCHAR2\", \"CHAR\", \"DATE\", \"TIMESTAMP\", \"CLOB\", \"BLOB\", \"FLOAT\"],\n        \"quote\": \"\\\"\",\n        \"features\": [\"comment_statement\"]\n    }\n}\n\ndef get_field_definition(db_type, row, q):\n    \"\"\"根据数据库类型生成单个字段的定义字符串\"\"\"\n    col_name = row.get(\"字段名\", \"\").strip()\n    col_type = row.get(\"类型\", \"VARCHAR\")\n    col_len = str(row.get(\"长度/参数\", \"\")).strip()\n    default_val = str(row.get(\"默认值\", \"\")).strip()\n    is_nn = row.get(\"非空\", False)\n    is_ai = row.get(\"自增\", False)\n    comment = str(row.get(\"注释\", \"\")).strip()\n    \n    parts = []\n    \n    # 1. 字段名\n    parts.append(f\"{q}{col_name}{q}\")\n    \n    # 2. 类型处理\n    full_type = col_type\n    # PG Serial 特殊处理\n    if db_type == \"PostgreSQL\" and is_ai and col_type in [\"INTEGER\", \"BIGINT\"]:\n        full_type = \"SERIAL\" if col_type == \"INTEGER\" else \"BIGSERIAL\"\n        is_ai = False \n    elif col_len and col_type not in [\"TEXT\", \"DATE\", \"DATETIME\", \"TIMESTAMP\", \"BOOLEAN\", \"INT\", \"INTEGER\", \"BIGINT\", \"SERIAL\", \"UUID\", \"JSON\", \"JSONB\"]:\n        full_type = f\"{col_type}({col_len})\"\n    parts.append(full_type)\n    \n    # 3. 默认值 (Oracle/PG 部分情况 DEFAULT 需在前)\n    # 大多数数据库 DEFAULT 在 NOT NULL 之前或之后都行，为了通用性放在中间\n    if default_val:\n        if default_val.upper() in [\"NULL\", \"CURRENT_TIMESTAMP\", \"NOW()\"] or \\\n           col_type in [\"INT\", \"INTEGER\", \"BIGINT\", \"DECIMAL\", \"NUMERIC\", \"FLOAT\", \"DOUBLE\", \"BOOLEAN\"]:\n            parts.append(f\"DEFAULT {default_val}\")\n        else:\n            parts.append(f\"DEFAULT '{default_val}'\")\n\n    # 4. 非空约束\n    if is_nn:\n        parts.append(\"NOT NULL\")\n    elif db_type == \"SQL Server\" and not is_nn:\n        parts.append(\"NULL\") # SQL Server 显式声明 NULL 好习惯\n\n    # 5. 自增\n    if is_ai:\n        if db_type == \"MySQL\":\n            parts.append(\"AUTO_INCREMENT\")\n        elif db_type == \"SQLite\":\n            # SQLite 自增必须是 INTEGER PRIMARY KEY AUTOINCREMENT，这里只加关键字，需配合 PK\n            parts.append(\"AUTOINCREMENT\") \n        elif db_type == \"SQL Server\":\n            parts.append(\"IDENTITY(1,1)\")\n        elif db_type == \"Oracle\":\n            parts.append(\"GENERATED BY DEFAULT AS IDENTITY\")\n\n    # 6. 行内注释 (MySQL)\n    if db_type == \"MySQL\" and comment:\n        parts.append(f\"COMMENT '{comment}'\")\n        \n    return \" \".join(parts)\n\ndef generate_sql(action_type, db_type, table_name, df, extra_options=None):\n    config = DB_CONFIG.get(db_type, DB_CONFIG[\"MySQL\"])\n    q = config[\"quote\"]\n    sqls = []\n    \n    # 过滤空行\n    valid_rows = df[df[\"字段名\"].str.strip() != \"\"]\n    if valid_rows.empty and action_type not in [\"删除表\", \"清空表\"]:\n        return \"-- 请至少输入一个字段\"\n\n    # --- 1. 新建表 ---\n    if action_type == \"新建表\":\n        lines = [f\"CREATE TABLE {q}{table_name}{q} (\"]\n        pks = []\n        col_defs = []\n        \n        for _, row in valid_rows.iterrows():\n            col_def = get_field_definition(db_type, row, q)\n            col_defs.append(f\"  {col_def}\")\n            if row.get(\"主键\", False):\n                pks.append(row[\"字段名\"])\n        \n        if pks:\n            pk_str = \", \".join([f\"{q}{pk}{q}\" for pk in pks])\n            col_defs.append(f\"  PRIMARY KEY ({pk_str})\")\n            \n        lines.append(\",\\n\".join(col_defs))\n        lines.append(\")\")\n        \n        # 表级选项\n        if db_type == \"MySQL\":\n            engine = extra_options.get(\"engine\", \"InnoDB\")\n            charset = extra_options.get(\"charset\", \"utf8mb4\")\n            lines[-1] += f\" ENGINE={engine} DEFAULT CHARSET={charset};\"\n        else:\n            lines[-1] += \";\"\n        \n        sqls.append(\"\\n\".join(lines))\n        \n        # 额外注释语句\n        if db_type in [\"PostgreSQL\", \"Oracle\"]:\n            for _, row in valid_rows.iterrows():\n                if row.get(\"注释\"):\n                    sqls.append(f\"COMMENT ON COLUMN {q}{table_name}{q}.{q}{row['字段名']}{q} IS '{row['注释']}';\")\n\n    # --- 2. 添加字段 ---\n    elif action_type == \"添加字段\":\n        for _, row in valid_rows.iterrows():\n            col_def = get_field_definition(db_type, row, q)\n            if db_type in [\"MySQL\", \"PostgreSQL\", \"SQL Server\"]:\n                sqls.append(f\"ALTER TABLE {q}{table_name}{q} ADD {col_def};\")\n            elif db_type == \"Oracle\":\n                # Oracle ADD 语法稍有不同，括号包裹\n                # 简化处理：单条 ADD\n                sqls.append(f\"ALTER TABLE {q}{table_name}{q} ADD ({col_def});\")\n            elif db_type == \"SQLite\":\n                sqls.append(f\"ALTER TABLE {q}{table_name}{q} ADD COLUMN {col_def};\")\n            \n            # 补注释\n            if db_type in [\"PostgreSQL\", \"Oracle\"] and row.get(\"注释\"):\n                sqls.append(f\"COMMENT ON COLUMN {q}{table_name}{q}.{q}{row['字段名']}{q} IS '{row['注释']}';\")\n\n    # --- 3. 修改字段 ---\n    elif action_type == \"修改字段\":\n        for _, row in valid_rows.iterrows():\n            col_name = row[\"字段名\"]\n            col_def_core = get_field_definition(db_type, row, q)\n            # 去掉字段名部分，只取定义 (简化处理)\n            # 这里的 get_field_definition 返回了 \"name type ...\", 我们需要拆解\n            # 更好的方式是重构 get_field_definition，但为了快速实现，这里做字符串处理\n            # 或者针对 Modify 重新组装\n            \n            type_part = row.get(\"类型\")\n            if row.get(\"长度/参数\"): type_part += f\"({row.get('长度/参数')})\"\n            \n            if db_type == \"MySQL\":\n                # MySQL: MODIFY COLUMN col_name definition\n                sqls.append(f\"ALTER TABLE {q}{table_name}{q} MODIFY COLUMN {col_def_core};\")\n            elif db_type == \"PostgreSQL\":\n                # PG 比较麻烦，通常分拆\n                # 1. Type\n                sqls.append(f\"ALTER TABLE {q}{table_name}{q} ALTER COLUMN {q}{col_name}{q} TYPE {type_part};\")\n                # 2. Not Null\n                nn_op = \"SET NOT NULL\" if row.get(\"非空\") else \"DROP NOT NULL\"\n                sqls.append(f\"ALTER TABLE {q}{table_name}{q} ALTER COLUMN {q}{col_name}{q} {nn_op};\")\n                # 3. Default\n                default_val = row.get(\"默认值\")\n                if default_val:\n                    val = default_val if default_val.upper() in [\"NULL\", \"TRUE\", \"FALSE\"] or row.get(\"类型\") in [\"INT\", \"INTEGER\"] else f\"'{default_val}'\"\n                    sqls.append(f\"ALTER TABLE {q}{table_name}{q} ALTER COLUMN {q}{col_name}{q} SET DEFAULT {val};\")\n                else:\n                    sqls.append(f\"ALTER TABLE {q}{table_name}{q} ALTER COLUMN {q}{col_name}{q} DROP DEFAULT;\")\n            elif db_type == \"SQL Server\":\n                # SQL Server: ALTER COLUMN col_name type [NULL|NOT NULL]\n                null_part = \"NOT NULL\" if row.get(\"非空\") else \"NULL\"\n                sqls.append(f\"ALTER TABLE {q}{table_name}{q} ALTER COLUMN {q}{col_name}{q} {type_part} {null_part};\")\n            elif db_type == \"Oracle\":\n                # Oracle: MODIFY (col_name type ...)\n                # Oracle 修改定义不重复写字段名，而是 (name type ...)\n                def_only = col_def_core # 包含名字\n                sqls.append(f\"ALTER TABLE {q}{table_name}{q} MODIFY ({def_only});\")\n\n    # --- 4. 删除字段 ---\n    elif action_type == \"删除字段\":\n        for _, row in valid_rows.iterrows():\n            col_name = row[\"字段名\"]\n            if db_type in [\"MySQL\", \"PostgreSQL\", \"SQL Server\", \"Oracle\"]:\n                sqls.append(f\"ALTER TABLE {q}{table_name}{q} DROP COLUMN {q}{col_name}{q};\")\n            elif db_type == \"SQLite\":\n                # SQLite 较新版本支持 DROP COLUMN\n                sqls.append(f\"ALTER TABLE {q}{table_name}{q} DROP COLUMN {q}{col_name}{q};\")\n\n    # --- 5. 索引操作 ---\n    elif action_type == \"添加索引\":\n        for _, row in valid_rows.iterrows():\n            idx_name = row.get(\"索引名\", f\"idx_{table_name}_{row['字段名']}\")\n            cols = row.get(\"字段名\", \"\") # 这里作为索引列字符串\n            unique = \"UNIQUE \" if row.get(\"唯一\", False) else \"\"\n            sqls.append(f\"CREATE {unique}INDEX {idx_name} ON {q}{table_name}{q} ({cols});\")\n    \n    elif action_type == \"删除索引\":\n        for _, row in valid_rows.iterrows():\n            idx_name = row[\"索引名\"]\n            if db_type == \"MySQL\":\n                sqls.append(f\"DROP INDEX {idx_name} ON {q}{table_name}{q};\")\n            elif db_type == \"SQL Server\":\n                sqls.append(f\"DROP INDEX {q}{table_name}{q}.{idx_name};\")\n            else:\n                sqls.append(f\"DROP INDEX {idx_name};\")\n\n    # --- 6. 表操作 ---\n    elif action_type == \"删除表\":\n        sqls.append(f\"DROP TABLE IF EXISTS {q}{table_name}{q};\")\n    \n    elif action_type == \"清空表\":\n        if db_type == \"SQLite\":\n            sqls.append(f\"DELETE FROM {q}{table_name}{q};\")\n            sqls.append(\"VACUUM;\")\n        else:\n            sqls.append(f\"TRUNCATE TABLE {q}{table_name}{q};\")\n\n    return \"\\n\".join(sqls)\n\n# --- 界面逻辑 ---\n\nst.sidebar.header(\"🛠️ 配置面板\")\ndb_type = st.sidebar.selectbox(\"数据库类型\", list(DB_CONFIG.keys()))\ntable_name = st.sidebar.text_input(\"目标表名\", value=\"users\")\n\n# 操作类型选择\naction_map = {\n    \"✨ 新建表 (CREATE)\": \"新建表\",\n    \"➕ 添加字段 (ADD)\": \"添加字段\",\n    \"🔧 修改字段 (MODIFY)\": \"修改字段\",\n    \"❌ 删除字段 (DROP)\": \"删除字段\",\n    \"🔍 添加索引 (INDEX)\": \"添加索引\",\n    \"🗑️ 删除索引 (DROP INDEX)\": \"删除索引\",\n    \"💣 删除/清空表\": \"删除表\" # 特殊处理\n}\naction_label = st.sidebar.radio(\"选择操作\", list(action_map.keys()))\naction_type = action_map[action_label]\n\nif action_type == \"删除表\":\n    sub_action = st.sidebar.radio(\"具体操作\", [\"删除表 (DROP)\", \"清空表 (TRUNCATE)\"])\n    action_type = \"删除表\" if \"DROP\" in sub_action else \"清空表\"\n\n# 额外选项\nextra_options = {}\nif db_type == \"MySQL\" and action_type == \"新建表\":\n    with st.sidebar.expander(\"MySQL 特有选项\", expanded=True):\n        extra_options[\"engine\"] = st.selectbox(\"存储引擎\", [\"InnoDB\", \"MyISAM\"])\n        extra_options[\"charset\"] = st.selectbox(\"字符集\", [\"utf8mb4\", \"utf8\", \"latin1\"])\n\n# 主界面\nst.title(f\"SQL 生成器 - {action_type}\")\n\n# 根据操作类型定义 DataFrame 的列结构\nif \"df\" not in st.session_state:\n    st.session_state.df = pd.DataFrame([{\"字段名\": \"id\", \"类型\": \"INT\", \"长度/参数\": \"\", \"主键\": True, \"非空\": True, \"自增\": True, \"注释\": \"ID\"}])\n\n# 动态调整列配置\ncolumn_config = {}\ndefault_data = []\n\nif action_type in [\"新建表\", \"添加字段\", \"修改字段\"]:\n    # 完整列定义\n    column_config = {\n        \"字段名\": st.column_config.TextColumn(required=True),\n        \"类型\": st.column_config.SelectboxColumn(opt