ask, T result) {\n            Callable<T> wrappedCallable = () -> {\n                task.run();\n                return result;\n            };\n            return submit(wrappedCallable);\n        }\n\n        @Override\n        public Future<?> submit(Runnable task) {\n            return submit(task, null);\n        }\n\n        @Override\n        public <T> List<Future<T>> invokeAll(Collection<? extends Callable<T>> tasks) throws InterruptedException {\n            List<Callable<T>> wrappedTasks = tasks.stream()\n                    .map(task -> wrapCallable(task, \"batch-task-\" + TASK_ID_GENERATOR.incrementAndGet()))\n                    .collect(Collectors.toList());\n            return target.invokeAll(wrappedTasks);\n        }\n\n        @Override\n        public <T> List<Future<T>> invokeAll(Collection<? extends Callable<T>> tasks, long timeout, TimeUnit unit)\n                throws InterruptedException {\n            List<Callable<T>> wrappedTasks = tasks.stream()\n                    .map(task -> wrapCallable(task, \"timed-batch-task-\" + TASK_ID_GENERATOR.incrementAndGet()))\n                    .collect(Collectors.toList());\n            return target.invokeAll(wrappedTasks, timeout, unit);\n        }\n\n        @Override\n        public <T> T invokeAny(Collection<? extends Callable<T>> tasks)\n                throws InterruptedException, ExecutionException {\n            List<Callable<T>> wrappedTasks = tasks.stream()\n                    .map(task -> wrapCallable(task, \"any-task-\" + TASK_ID_GENERATOR.incrementAndGet()))\n                    .collect(Collectors.toList());\n            return target.invokeAny(wrappedTasks);\n        }\n\n        @Override\n        public <T> T invokeAny(Collection<? extends Callable<T>> tasks, long timeout, TimeUnit unit)\n                throws InterruptedException, ExecutionException, TimeoutException {\n            List<Callable<T>> wrappedTasks = tasks.stream()\n                    .map(task -> wrapCallable(task