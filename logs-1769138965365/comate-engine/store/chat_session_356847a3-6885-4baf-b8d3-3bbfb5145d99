  </if>\n            <if test=\"status != null and status != ''\">\n                AND a.status = #{status, jdbcType=VARCHAR}\n            </if>\n            <if test=\"bankCode != null and bankCode != ''\">\n                AND a.bank_code = #{bankCode, jdbcType=VARCHAR}\n            </if>\n            <if test=\"payCheckNum != null and payCheckNum != ''\">\n                AND a.pay_check_num = #{payCheckNum, jdbcType=VARCHAR}\n            </if>\n            <if test=\"applyDateStart != null\">\n                AND a.CREATE_DATE &gt;= #{applyDateStart, jdbcType=DATE}\n            </if>\n            <if test=\"applyDateEnd != null\">\n                AND a.CREATE_DATE &lt;= #{applyDateEnd, jdbcType=DATE}\n            </if>\n        </where>\n        ORDER BY a.CREATE_DATE DESC\n    </select>\n\n\n    <select id=\"selectApplyListByAll\" parameterType=\"com.baidu.pmc.pojo.qo.PmcFinanceSupplierApplyQO\"\n            resultType=\"com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyDTO\">\n        SELECT\n        a.apply_number,\n        a.pay_check_num,\n        a.finance_amount,\n        a.pay_amount,\n        a.currency,\n        a.bank_code,\n        a.finance_day,\n        a.apply_submit,\n        a.status,\n        latest_his.next_operation_node,\n        latest_his.operation_node,\n        c.supplier_name,\n        a.create_date\n        FROM pmc_finance_supplier_apply a\n        LEFT JOIN (\n            SELECT\n                b1.apply_number,\n                b1.attribute1 as next_operation_node,\n                b1.operation_node\n            FROM pmc_finance_supplier_apply_his b1\n            INNER JOIN (\n                SELECT\n                    apply_number,\n                    MAX(create_date) as max_create_date\n                FROM pmc_finance_supplier_apply_his\n                GROUP BY apply_number\n            ) b2 ON b1.apply_number = b2.apply_number AND b1.create_date = b2.max_create_date\n        ) latest_his ON a.apply_number = latest_his.apply_number\n        , pmc_data_p2p_supplier c\n        <where>\n            c.supplier_code = a.supplier_code\n            <if test=\"applyNumber != null and applyNumber != ''\">\n                AND a.apply_number = #{applyNumber, jdbcType=BIGINT}\n            </if>\n            <if test=\"supplierCode != null and supplierCode != ''\">\n                AND a.supplier_code = #{supplierCode, jdbcType=VARCHAR}\n            </if>\n            <if test=\"status != null and status != ''\">\n                AND a.status = #{status, jdbcType=VARCHAR}\n            </if>\n            <if test=\"bankCode != null and bankCode != ''\">\n                AND a.bank_code = #{bankCode, jdbcType=VARCHAR}\n            </if>\n            <if test=\"payCheckNum != null and payCheckNum != ''\">\n                AND a.pay_check_num = #{payCheckNum, jdbcType=VARCHAR}\n            </if>\n            <if test=\"supplierName != null and supplierName != ''\">\n                AND c.supplier_name = #{supplierName, jdbcType=VARCHAR}\n            </if>\n            <if test=\"supplierCode != null and supplierCode != ''\">\n                AND c.supplier_code = #{supplierCode, jdbcType=VARCHAR}\n            </if>\n            <if test=\"applyDateStart != null\">\n                AND a.CREATE_DATE &gt;= #{applyDateStart, jdbcType=Date}\n            </if>\n            <if test=\"applyDateEnd != null\">\n                AND a.CREATE_DATE &lt;= #{applyDateEnd, jdbcType=Date}\n            </if>\n        </where>\n        ORDER BY a.CREATE_DATE DESC\n    </select>\n\n    <select id=\"selectByApplyNumber\" parameterType=\"java.lang.String\"\n            resultType=\"com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyDTO\">\n        SELECT\n        a.apply_number,\n        a.pay_check_num,\n        a.finance_amount,\n        a.pay_amount,\n        a.currency,\n        a.bank_code,\n        a.finance_day,\n        a.apply_submit,\n        a.status,\n        c.supplier_name\n        FROM pmc_finance_supplier_apply a\n