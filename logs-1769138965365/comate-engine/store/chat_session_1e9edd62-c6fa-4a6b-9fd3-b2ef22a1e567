uota());\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", remainQuota), HttpStatus.OK);\n    }\n    /**\n     * 管理员拒绝发送中的融资\n     */\n    @PostMapping(\"/admRejectSendBank\")\n    @ResponseBody\n    public ResponseMessage admReject(@RequestBody PmcFinanceSupplierApplyDTO query) {\n        return pmcSupplierAdmClient.admRejectSendBank(query);\n    }\n\n    /**\n     * 管理员再次提交发送中的融资到银行\n     */\n    @PostMapping(\"/admSendToBank\")\n    @ResponseBody\n    public ResponseMessage admSendToBank(@RequestBody PmcFinanceSupplierApplyDTO query) {\n        return pmcFinancingBankService.adminSubmitFinancingApply(query);\n    }\n\n}\n",
