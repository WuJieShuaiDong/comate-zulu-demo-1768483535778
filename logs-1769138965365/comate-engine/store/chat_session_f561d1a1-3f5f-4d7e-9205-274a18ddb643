                "content": "package com.baidu.pmc.web.service.prompt;\n\nimport com.baidu.pmc.pojo.model.FinancingPromptPreference;\nimport com.baidu.pmc.web.repository.FinancingPromptRepository;\nimport lombok.RequiredArgsConstructor;\nimport lombok.extern.slf4j.Slf4j;\nimport org.springframework.stereotype.Service;\n\nimport java.time.LocalDate;\n\n/**\n * 融资首页大图提示服务实现类\n */\n@Service\n@Slf4j\n@RequiredArgsConstructor\npublic class FinancingPromptServiceImpl implements FinancingPromptService {\n    \n    private final FinancingPromptRepository financingPromptRepository;\n\n    @Override\n    public boolean shouldShowPrompt(String supplierCode) {\n        try {\n            FinancingPromptPreference preference = financingPromptRepository.findBySupplierCode(supplierCode);\n            \n            if (preference == null) {\n                log.info(\"供应商 {} 首次访问，显示提示\", supplierCode);\n                return true; // 新供应商默认显示\n            }\n            \n            if (preference.getNeverShow()) {\n                log.info(\"供应商 {} 已选择永久不显示提示\", supplierCode);\n                return false; // 供应商选择永久不显示\n            }\n            \n            LocalDate today = LocalDate.now();\n            boolean shouldShow = !today.equals(preference.getLastCloseDate());\n            \n            if (shouldShow) {\n                log.info(\"供应商 {} 今天未关闭过提示，显示提示\", supplierCode);\n            } else {\n                log.info(\"供应商 {} 今天已关闭过提示，不显示提示\", supplierCode);\n            }\n            \n            return shouldShow;\n        } catch (Exception e) {\n            log.error(\"检查供应商 {} 提示状态失败\", supplierCode, e);\n            return true; // 异常情况下默认显示\n        }\n    }\n\n    @Override\n    public void disablePromptPermanently(String supplierCode) {\n        try {\n            FinancingPromptPreference preference = getOrCreatePreference(supplierCode);\n            preference.setNeverShow(true);\n            preference.setLastCloseDate(null); // 清除关闭日期\n            financingPromptRepository.save(preference);\n            log.info(\"供应商 {} 已设置永久不显示提示\", supplierCode);\n        } catch (Exception e) {\n            log.error(\"设置供应商 {} 永久不显示提示失败\", supplierCode, e);\n            throw new RuntimeException(\"设置失败\");\n        }\n    }\n\n    @Override\n    public void closePromptForToday(String supplierCode) {\n        try {\n            FinancingPromptPreference preference = getOrCreatePreference(supplierCode);\n            preference.setLastCloseDate(LocalDate.now());\n            financingPromptRepository.save(preference);\n            log.info(\"供应商 {} 已设置当天不显示提示\", supplierCode);\n        } catch (Exception e) {\n            log.error(\"设置供应商 {} 当天不显示提示失败\", supplierCode, e);\n            throw new RuntimeException(\"设置失败\");\n        }\n    }\n\n    private FinancingPromptPreference getOrCreatePreference(String supplierCode) {\n        FinancingPromptPreference preference = financingPromptRepository.findBySupplierCode(supplierCode);\n        if (preference == null) {\n            preference = new FinancingPromptPreference();\n            preference.setSupplierCode(supplierCode);\n        }\n        return preference;\n    }\n}",
