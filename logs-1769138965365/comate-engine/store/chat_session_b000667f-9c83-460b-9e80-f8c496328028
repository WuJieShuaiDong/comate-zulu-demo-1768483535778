          "content": "```java\nimport static org.junit.jupiter.api.Assertions.*;\nimport static org.mockito.Mockito.*;\n\nimport java.math.BigDecimal;\nimport java.util.Date;\n\nimport org.junit.jupiter.api.BeforeEach;\nimport org.junit.jupiter.api.Test;\nimport org.mockito.InjectMocks;\nimport org.mockito.Mock;\nimport org.mockito.MockitoAnnotations;\n\nimport com.baidu.tms.loan.constant.LoanConstants;\nimport com.baidu.tms.loan.domain.LoanAccount;\nimport com.baidu.tms.loan.domain.TmsLoanCompanyRule;\nimport com.baidu.tms.loan.service.LoanCompanyRuleService;\nimport com.baidu.tms.loan.service.impl.LoanAccountServiceImpl;\n\nclass LoanAccountServiceImplTest {\n\n    @Mock\n    private LoanCompanyRuleService loanCompanyRuleService;\n\n    @InjectMocks\n    private LoanAccountServiceImpl loanAccountServiceImpl;\n\n    @BeforeEach\n    void setUp() {\n        MockitoAnnotations.openMocks(this);\n    }\n\n    @Test\n    void testGetTaxAccount_WithA03EventTypeAndValidTaxRate() {\n        LoanAccount laa = new LoanAccount();\n        laa.setCompanyCode(\"COMP001\");\n        laa.setTaxSegment3(\"TAX001\");\n        laa.setEventType(LoanConstants.TMS_DEAL_ACCEVENTTYPE_A03);\n        laa.setCounterpartyCode(\"CP001\");\n        laa.setEntered(new BigDecimal(\"100.00\"));\n\n        LoanAccount debit = new LoanAccount();\n        debit.setEntered(new BigDecimal(\"100.00\"));\n        LoanAccount credit = new LoanAccount();\n        credit.setEntered(new BigDecimal(\"100.00\"));\n\n        TmsLoanCompanyRule rule = new TmsLoanCompanyRule();\n        rule.setTaxRate(new BigDecimal(\"0.06\"));\n\n        when(loanCompanyRuleService.getCompanyRuleByTaxType(\n            eq(LoanConstants.LOAN_ACCOUNT_COMPANY_RULE_TYPE_VAT), \n            eq(\"CP001\"))).thenReturn(rule);\n\n        LoanAccount result = loanAccountServiceImpl.getTaxAccount(\n            laa, debit, credit, new Date());\n\n        assertNotNull(result);\n        assertEquals(new BigDecimal(\"5.66\"), result.getEntered());\n        assertEquals(new BigDecimal(\"94.34\"), credit.getEntered());\n        assertEquals(LoanConstants.LOAN_GL_DIRECTION_CR, result.getDirection());\n    }\n\n    @Test\n    void testGetTaxAccount_WithA03EventTypeAndNullTaxRate() {\n        LoanAccount laa = new LoanAccount();\n        laa.setEventType(LoanConstants.TMS_DEAL_ACCEVENTTYPE_A03);\n        laa.setCounterpartyCode(\"CP001\");\n        laa.setEntered(new BigDecimal(\"100.00\"));\n\n        when(loanCompanyRuleService.getCompanyRuleByTaxType(\n            anyString(), anyString())).thenReturn(null);\n\n        LoanAccount result = loanAccountServiceImpl.getTaxAccount(\n            laa, new LoanAccount(), new LoanAccount(), new Date());\n\n        assertNull(result);\n    }\n\n    @Test\n    void testGetTaxAccount_WithA03EventTypeAndZeroTaxRate() {\n        LoanAccount laa = new LoanAccount();\n        laa.setEventType(LoanConstants.TMS_DEAL_ACCEVENTTYPE_A03);\n        laa.setCounterpartyCode(\"CP001\");\n        laa.setEntered(new BigDecimal(\"100.00\"));\n\n        TmsLoanCompanyRule rule = new TmsLoanCompanyRule();\n        rule.setTaxRate(BigDecimal.ZERO);\n\n        when(loanCompanyRuleService.getCompanyRuleByTaxType(\n            anyString(), anyString())).thenReturn(rule);\n\n        LoanAccount result = loanAccountServiceImpl.getTaxAccount(\n            laa, new LoanAccount(), new LoanAccount(), new Date());\n\n        assertNull(result);\n    }\n\n    @Test\n    void testGetTaxAccount_WithA01EventTypeAndValidTaxRate() {\n        LoanAccount laa = new LoanAccount();\n        laa.setCompanyCode(\"COMP001\");\n        laa.setTaxSegment3(\"TAX001\");\n        laa.setEventType(LoanConstants.TMS_DEAL_ACCEVENTTYPE_A01);\n        laa.setCounterpartyCode(\"CP001\");\n        laa.setEntered(new BigDecimal(\"100.00\"));\n\n        LoanAccount debit = new LoanAccount();\n        debit.setEntered(new BigDecimal(\"100.00\"));\n        LoanAccount credit = new LoanAccount();\n        credit.setEntere