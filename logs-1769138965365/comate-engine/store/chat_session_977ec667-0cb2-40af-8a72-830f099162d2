n        }\n        fndFlexValueApi.translate(dtoList, \"segment1\", BizConstants.FndFlexSet.BD_COMPANY,\n                \"segment2\", BizConstants.FndFlexSet.BD_DEPARTMENT,\n                \"segment3\", BizConstants.FndFlexSet.BD_ACCOUNT,\n                \"segment4\", BizConstants.FndFlexSet.BD_PRODUCT,\n                \"segment5\", BizConstants.FndFlexSet.BD_INTERCOMPANY,\n                \"segment6\", BizConstants.FndFlexSet.BD_PROJECT,\n                \"segment7\", BizConstants.FndFlexSet.BD_SPARE1,\n                \"segment8\", BizConstants.FndFlexSet.BD_SPARE2,\n                \"eventType\", BizConstants.FndFlexSet.TMS_DEAL_TRASACTIONTYPE, \"trxCurrencyCode\", BizConstants\n                        .FndFlexSet.TMS_CURRENCY, \"approveStatus\", BizConstants.FndFlexSet.TMS_GL_APPROVAL_STATUS);\n        for (ApproveFundVoucherExportDTO dto : dtoList) {\n            dto.setSegment3Desc(getSegment3Desc(dto));\n        }\n        return dtoList;\n    }\n\n    private String getSegment3Desc(ApproveFundVoucherExportDTO dto) {\n        String segment3Desc = \"\";\n        String segment1Name =\n                StringUtils.equals(dto.getSegment1Name(), SEGMENT_NAME) ? \"\" : dto.getSegment1Name();\n        String segment2Name =\n                StringUtils.equals(dto.getSegment2Name(), SEGMENT_NAME) ? \"\" : SPOT_DESC + dto.getSegment2Name();\n        String segment3Name =\n                StringUtils.equals(dto.getSegment3Name(), SEGMENT_NAME) ? \"\" : SPOT_DESC + dto.getSegment3Name();\n        String segment4Name =\n                StringUtils.equals(dto.getSegment4Name(), SEGMENT_NAME) ? \"\" : SPOT_DESC + dto.getSegment4Name();\n        String segment5Name =\n                StringUtils.equals(dto.getSegment5Name(), SEGMENT_NAME) ? \"\" : SPOT_DESC + dto.getSegment5Name();\n        String segment6Name =\n                StringUtils.equals(dto.getSegment6Name(), SEGMENT_NAME) ? \"\" : SPOT_DESC + dto.getSegment6Name();\n        String segment7Name =\n          