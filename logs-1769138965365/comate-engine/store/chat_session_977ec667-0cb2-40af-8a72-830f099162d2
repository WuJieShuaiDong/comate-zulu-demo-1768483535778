           rule.impairment_cr_segment8,\n            rule.impairment_dr_segment1,\n            rule.impairment_dr_segment2,\n            rule.impairment_dr_segment3,\n            rule.impairment_dr_segment4,\n            rule.impairment_dr_segment5,\n            rule.impairment_dr_segment6,\n            rule.impairment_dr_segment7,\n            rule.impairment_dr_segment8,\n            rule.lstcod,\n            rel.ledger_id,\n            comp.counterparty_name\n        FROM\n            tms_deal_interest_accrual interest,\n            tms_deal deal,\n            tms_loan_account_rule rule,\n            (SELECT\n                 b.flex_value company_code,\n                 b.attribute3 ledger_id\n             FROM\n                 fnd_flex_value_b b,\n                 fnd_flex_value_set s\n             WHERE b.flex_value_set_id = s.flex_value_set_id\n               AND s.flex_value_set_name = 'COM_OU_SOB') rel,\n            (SELECT\n                 trans_code,\n                 trans_name\n             FROM tms_transaction_type\n             WHERE start_date_active &lt;= curdate()\n               AND (end_date_active is null or end_date_active >= curdate())\n               AND enabled_flag = 'Y') type,\n            (SELECT\n                 counterparty_name,\n                 company_code\n             FROM tms_loan_company_rule) comp,\n            tms_gl_ledger led\n        WHERE 1 = 1\n          AND interest.deal_id = deal.deal_id\n          AND (interest.reclassify_flag is not null and interest.reclassify_flag='N')\n          AND rule.lstcod = 'NONE'\n          AND deal.deal_type = rule.trstype\n          AND rule.entcod = interest.accrual_type  -- 事件类型：计提应付利息 or 计提应收利息\n          AND rule.end_date IS NULL\n          AND deal.deal_type = type.trans_code\n          AND deal.counterparty_code = comp.company_code\n          AND led.ledger_id = rel.ledger_id\n          AND rel.company_code = deal.company_code\n          AND interest.accrual_id = #{eventId, jdbcType=BIGINT}\n    </select>\n\n    <!-- 获取一个公司的历史账期 包括已关闭和当前打开的账期，不包括调整期-->\n    <select id=\"getAccountPeriodsOfCompany\" resultType=\"String\" parameterType=\"com.baidu.tms.loan.domain.LoanAccount\">\n        SELECT\n        t.PERIOD_NAME accountPeriod\n        FROM\n        tms_gl_periods t,\n        (SELECT\n        b.flex_value company_code,\n        b.attribute3 ledger_id\n        FROM\n        fnd_flex_value_b b,\n        fnd_flex_value_set s\n        WHERE b.flex_value_set_id = s.flex_value_set_id\n        AND s.flex_value_set_name = 'COM_OU_SOB') rel\n        WHERE t.CLOSING_STATUS IN ('C', 'O')\n        AND t.APPLICATION_ID = 101\n        AND t.ADJUSTMENT_PERIOD_FLAG = 'N'\n        AND rel.ledger_id = t.LEDGER_ID\n        AND rel.company_code = #{companyCode,jdbcType=VARCHAR}\n        <if test=\"accountPeriod != null and accountPeriod != ''\">\n            AND t.PERIOD_NAME like CONCAT('%',#{accountPeriod},'%')\n        </if>\n        ORDER BY t.PERIOD_NUM\n    </select>\n    <!-- 获取一个公司的历史账期 包括已关闭和当前打开的账期，不包括调整期-->\n    <select id=\"getDefaultAccountPeriodOfCompany\" resultType=\"String\"\n            parameterType=\"com.baidu.tms.loan.domain.LoanAccount\">\n        SELECT\n        t.PERIOD_NAME accountPeriod\n        FROM\n        tms_gl_periods t,\n        (SELECT\n        b.flex_value company_code,\n        b.attribute3 ledger_id\n        FROM\n        fnd_flex_value_b b,\n        fnd_flex_value_set s\n        WHERE b.flex_value_set_id = s.flex_value_set_id\n        AND s.flex_value_set_name = 'COM_OU_SOB') rel\n        WHERE t.CLOSING_STATUS IN ('O')\n        AND t.APPLICATION_ID = 101\n        AND t.ADJUSTMENT_PERIOD_FLAG = 'N'\n        AND rel.ledger_id = t.LEDGER_ID\n        AND rel.company_code = #{companyCode,jdbcType=VARCHAR}\n        <if test=\"accountPeriod != null and accountPeriod != ''\">\n            AND t.PERIOD_NAME like CONCAT('%',#{accountPeriod},'%')\n        </if>\n        ORDER BY t.creation_date desc ,t.period_id desc\n    </select>\n    <!-- 记提记账 当天 归还本金 收回本金的事件记账  -->\n    <select id=\"getAccrualsEvent\" resultType=\"com.baidu.tms.loan.domain.LoanAccountAccrual\"\n            parameterType=\"com.baidu.tms.loan.domain.LoanAccountAccrual\">\n        SELECT\n        e.request_id,\n        r.request_number,\n        e.event_id,\n        e.principal amount,\n        r.plan_begin_date,\n        r.interest_type,\n        r.rate,\n        CASE\n        WHEN r.image_flag = 'Y' THEN\n        'A01'\n        when r.trx_type in ('D5', 'D6') THEN\n        'A01'\n        ELSE\n        'A03'\n        END AS accrual_type\n        FROM\n        tms_loan_trx_event e,\n        tms_loan_req r\n        WHERE e.request_id = r.Id\n        AND e.event_status = 'COMPLETED'\n        AND e.event_type IN ('T05', 'T06')\n        and e.actual_pay_date = #{occurDate,jdbcType=DATE}\n        <if test=\"requestNumber != null and requestNumber != ''\">\n            and r.request_number = #{requestNumber,jdbcType=VARCHAR}\n        </if>\n        AND NOT EXISTS\n        (SELECT\n        1\n        FROM\n        tms_loan_account_accrual ac\n        WHERE ac.event_id = e.event_id)\n    </select>\n\n    <!-- 记提记账 用于记提记账的交易-->\n    <select id=\"getAccrualsTrx\" resultType=\"com.baidu.tms.loan.domain.LoanAccountAccrual\"\n            parameterType=\"com.baidu.tms.loan.domain.LoanAccountAccrual\">\n        SELECT\n        r.Id request_id,\n        r.request_number,\n        r.principal_remained amount,\n        r.plan_begin_date,\n        r.interest_type,\n        r.rate,\n        CASE\n        WHEN r.image_flag = 'Y' THEN\n        'A01'\n        when r.trx_type in ('D5', 'D6') THEN\n        'A01'\n        ELSE\n        'A03'\n        END AS accrual_type\n        FROM\n        tms_loan_req r\n        WHERE r.status = 'APPROVED'\n        and r.principal_remained <![CDATA[ > ]]> 0\n        AND ( r.interest_end_date <![CDATA[ > ]]>  #{occurDate,jdbcType=DATE} or r.overdue_flag = 'Y')\n        AND r.plan_begin_date <![CDATA[ <= ]]>  #{occurDate,jdbcType=DATE}\n        <if test=\"requestNumber != null and requestNumber != ''\">\n            and r.request_number = #{requestNumber,jdbcType=VARCHAR}\n        </if>\n        AND NOT EXISTS\n        (SELECT\n        1\n        FROM\n        tms_loan_account_accrual la\n        WHERE la.accrual_source_type = 'TRX'\n        AND la.occur_date = #{occurDate,jdbcType=DATE}\n        AND la.request_id = r.id)\n    </select>\n\n    <!-- 记提记账 用于记提记账的展期处理-->\n    <select id=\"getAccrualsExtendTrx\" resultType=\"com.baidu.tms.loan.domain.LoanAccountAccrual\"\n            parameterType=\"com.baidu.tms.loan.domain.LoanAccountAccrual\">\n        SELECT\n        r.Id request_id,\n        r.request_number,\n        r.source_req_id,\n        r.principal_remained amount,\n        r.plan_begin_date,\n        r.interest_type,\n        r.rate,\n        CASE\n        WHEN r.image_flag = 'Y' THEN\n        'A01'\n        when r.trx_type in ('D5', 'D6') THEN\n        'A01'\n        ELSE\n        'A03'\n        END AS accrual_type\n        FROM\n        tms_loan_req r,\n        tms_loan_req rex\n        WHERE r.status = 'APPROVED'\n        AND r.extend_flag='Y'\n        AND r.id = rex.source_req_id\n        AND r.interest_end_date = #{occurDate,jdbcType=DATE}\n        AND r.plan_begin_date <![CDATA[ < ]]>  #{occurDate,jdbcType=DATE}\n        <if test=\"requestNumber != null and requestNumber != ''\">\n            and r.request_number = #{requestNumber,jdbcType=VARCHAR}\n        </if>\n        AND NOT EXISTS\n        (SELECT\n        1\n        FROM\n        tms_loan_account_accrual la\n        WHERE la.accrual_source_type = 'TRX_EXTEND'\n        AND la.occur_date = #{occurDate,jdbcType=DATE}\n        AND la.request_id = r.id)\n    </select>\n\n    <!-- 提前终止交易的记提-->\n    <select id=\"getAccrualsTermination\" resultType=\"com.baidu.tms.loan.domain.LoanAccountAccrual\"\n            parameterType=\"com.baidu.tms.loan.domain.LoanAccountAccrual\">\n        SELECT\n        r.Id request_id,\n        r.request_number,\n        r.principal_remained amount,\n        r.plan_begin_date,\n        r.interest_type,\n        r.rate,\n        CASE\n        WHEN r.image_flag = 'Y' THEN\n        'A01'\n        when r.trx_type in ('D5', 'D6') THEN\n        'A01'\n        ELSE\n        'A03'\n        END AS accrual_type\n        FROM\n        tms_loan_req r\n        WHERE r.status = 'TERMINATED'\n        AND r.termination_flag = 'Y'\n        AND r.termination_date = #{occurDate,jdbcType=DATE}\n        AND r.plan_begin_date <![CDATA[ < ]]>  #{occurDate,jdbcType=DATE}\n        <if test=\"requestNumber != null and requestNumber != ''\">\n            and r.request_number = #{requestNumber,jdbcType=VARCHAR}\n        </if>\n        AND NOT EXISTS\n        (SELECT\n        1\n        FROM\n        tms_loan_account_accrual la\n        WHERE la.accrual_source_type = 'TERMINATION'\n        AND la.occur_date = #{occurDate,jdbcType=DATE}\n        AND la.request_id = r.id)\n    </select>\n\n    <!-- 获取当前的 上一笔日记账(最新的) -->\n    <select id=\"getAccrualsPrevious\" resultType=\"com.baidu.tms.loan.domain.LoanAccountAccrual\"\n            parameterType=\"com.baidu.tms.loan.domain.LoanAccountAccrual\">\n        SELECT\n          *\n        FROM\n          tms_loan_account_accrual a\n        WHERE a.request_id =#{requestId,jdbcType=VARCHAR}\n        order by occur_date desc\n        limit 1\n    </select>\n\n\n    <!-- 获取记提信息 用于生成分录-->\n    <select id=\"getAccruals\" parameterType=\"com.baidu.tms.loan.domain.LoanAccountAccrual\"\n            resultType=\"com.baidu.tms.loan.domain.LoanAccountAccrual\">\n        SELECT\n        req.company_code,\n        req.company company_code_name,\n        req.id source_id,\n        req.counterparty counterparty_code_name,\n        req.counterparty_code,\n        req.process_type,\n        req.currency_code trxCurrencyCode,\n        req.request_number,\n        la.amount,\n        la.start_date,\n        la.end_date,\n        req.rate,\n        req.interest_type,\n        la.day_count,\n        la.amount_sum_last_accrual,\n        la.amount_accrual,\n        la.amount_adjust,\n        la.account_period,\n        la.accrual_type,\n        la.accrual_id\n        FROM\n        tms_loan_account_accrual la,\n        tms_loan_req req,\n        (SELECT\n        DISTINCT l.line_value company_code\n        FROM\n        tms_loan_role_header h,\n        tms_loan_role_line l\n        WHERE h.role_header_id = l.role_header_id\n        AND h.role_user = #{userName,jdbcType=VARCHAR}\n        AND h.end_date IS NULL\n        AND l.line_type='LINE_COMPANY') companys\n\n        WHERE la.request_id = req.id\n        and companys.company_code = req.company_code\n        AND la.account_status in ('N','Y')\n        <if test=\"processType != null and processType != ''\">\n            and req.process_type = #{processType,jdbcType=VARCHAR}\n        </if>\n        <if test=\"companyCode != null and companyCode != ''\">\n            and req.company_code = #{companyCode,jdbcType=VARCHAR}\n        </if>\n        <if test=\"requestNumber != null and requestNumber != ''\">\n            and req.request_number = #{requestNumber,jdbcType=VARCHAR}\n        </if>\n        <if test=\"trxType != null and trxType != ''\">\n            and req.trx_type = #{trxType,jdbcType=VARCHAR}\n        </if>\n        <if test=\"accountStatus != null and accountStatus != ''\">\n            and la.account_status = #{accountStatus,jdbcType=VARCHAR}\n        </if>\n        <if test=\"accrualType != null and accrualType != ''\">\n            and la.accrual_type = #{accrualType,jdbcType=VARCHAR}\n        </if>\n        <if test=\"accountPeriod != null and accountPeriod != ''\">\n            and la.account_period = #{accountPeriod,jdbcType=VARCHAR}\n        </if>\n        <if test=\"trxCurrencyCode != null and trxCurrencyCode != ''\">\n            and req.currency_code = #{trxCurrencyCode,jdbcType=VARCHAR}\n        </if>\n        ORDER by req.company_code, req.request_number, la.start_date\n    </select>\n    <!-- 获取 记提记账分录信息-->\n    <select id=\"getAccrualAccounts\"\n            resultType=\"com.baidu.tms.loan.domain.LoanAccountAccrual\">\n        SELECT\n        req.Id source_id,\n        'N' man_created,\n        req.trx_type,\n        req.request_number,\n        req.counterparty_type,\n        la.accrual_type eventType,\n        ifnull(la.amount_accrual,0) +  ifnull(la.amount_adjust,0) entered,\n        la.account_period,\n        la.occur_date accounting_date,\n        la.accrual_id,\n        la.day_count,\n        la.amount_adjust,\n        rel.ledger_id,\n        req.company_code,\n        req.counterparty_code,\n        led.currency_code ledgerCurrencyCode,\n        req.currency_code  trxCurrencyCode,\n        req.process_type,\n        req.interest_type,\n        rule.cr_segment1,\n        rule.cr_segment2,\n        rule.cr_segment3,\n        rule.cr_segment4,\n        rule.cr_segment5,\n        rule.cr_segment6,\n        rule.cr_segment7,\n        rule.dr_segment1,\n        rule.dr_segment2,\n        rule.dr_segment3,\n        rule.dr_segment4,\n        rule.dr_segment5,\n        rule.dr_segment6,\n        rule.dr_segment7,\n        rule.tax_segment1,\n        rule.tax_segment2,\n        rule.tax_segment3,\n        rule.tax_segment4,\n        rule.tax_segment5,\n        rule.tax_segment6,\n        rule.tax_segment7,\n        rule.tax_segment8\n        FROM\n        tms_loan_account_accrual la,\n        tms_loan_req req,\n        (SELECT\n        b.flex_value company_code,\n        b.attribute3 ledger_id\n        FROM\n        fnd_flex_value_b b,\n        fnd_flex_value_set s\n        WHERE b.flex_value_set_id = s.flex_value_set_id\n        AND s.flex_value_set_name = 'COM_OU_SOB') rel,\n        tms_gl_ledger led,\n        tms_loan_account_rule rule\n        WHERE la.accrual_type = rule.entcod\n        AND req.Id = la.request_id\n      AND\n      CASE\n        WHEN ((\n            TO_DAYS(req.interest_end_date) - TO_DAYS(LAST_DAY(la.occur_date))\n        ) &gt;365 and req.frequency != 'Q')\n        THEN rule.lstcod = 'LONG_TERM'\n        ELSE rule.lstcod = 'SHORT_TERM'\n      END\n        AND req.trx_type = rule.trstype\n        AND rule.end_date IS NULL\n        AND led.ledger_id = rel.ledger_id\n        AND rel.company_code = req.company_code\n        AND la.accrual_id = #{accrualId,jdbcType=BIGINT}\n    </select>\n    <!-- 更新上次记提金额-->\n    <update id=\"updateAmountAdjust\" parameterType=\"com.baidu.tms.loan.domain.LoanAccountAccrual\">\n        UPDATE\n          tms_loan_account_accrual t\n        SET\n          t.amount_sum_last_accrual = IFNULL(t.amount_sum_last_accrual, 0) + #{amountAdjust,jdbcType=DECIMAL}\n        WHERE t.start_date > #{startDate,jdbcType=DATE}\n          AND t.request_id IN\n          (SELECT\n            r.Id\n          FROM\n            tms_loan_req r\n          WHERE r.request_number = #{requestNumber,jdbcType=VARCHAR})\n    </update>\n\n    <!-- 获取当前交易的上笔记提信息 按照开始日期倒序排列-->\n    <select id=\"getPreviousAccrual\" parameterType=\"com.baidu.tms.loan.domain.LoanAccountAccrual\"\n            resultType=\"com.baidu.tms.persistent.loan.domain.TmsLoanAccountAccrual\">\n        SELECT\n          *\n        FROM\n          tms_loan_account_accrual a\n        WHERE a.request_id IN\n          (SELECT\n            r.Id\n          FROM\n            tms_loan_req r\n          WHERE r.request_number = #{requestNumber,jdbcType=VARCHAR})\n        ORDER BY a.start_date DESC\n\n    </select>\n\n    <!-- 上月本金余额与上月底利息余额 -->\n    <select id=\"getLastMonthAccrual\" parameterType=\"com.baidu.tms.loan.domain.LoanAccountAccrual\"\n            resultType=\"com.baidu.tms.loan.domain.LoanAccountAccrual\">\n        SELECT\n        a.amount,\n        a.amount_accrual,\n        a.amount_sum_last_accrual,\n        a.amount_adjust\n        FROM\n        tms_loan_account_accrual a\n        WHERE a.request_id = #{requestId,jdbcType=BIGINT}\n        and a.occur_date = #{occurDate,jdbcType=DATE}\n    </select>\n\n    <!-- 交易事件的记账信息多个账户信息-->\n    <select id=\"getAccountsSettlement\" parameterType=\"java.lang.Long\"\n            resultType=\"com.baidu.tms.loan.domain.LoanAccount\">\n        SELECT\n        req.Id source_id, -- 借款申请单id\n        req.counterparty_type, -- 交易对手类型\n        req.company_code segment1,\n        req.counterparty_code, -- 对手方公司\n        info.company_account,\n        req.request_number,\n        req.trx_type,\n        type.trans_name trxTypeName,\n        env.event_number,\n        env.event_id,\n        env.event_type,\n        env.actual_pay_date accounting_date,\n        info.split_amount entered,\n        led.currency_code ledgerCurrencyCode,\n        req.currency_code trxCurrencyCode,\n        acc.fin_account,\n        facc.facc_description finAccountDescription,\n        rule.cr_segment1, -- 贷方科目1\n        rule.cr_segment2,\n        rule.cr_segment3,\n        rule.cr_segment4,\n        rule.cr_segment5,\n        rule.cr_segment6,\n        rule.cr_segment7,\n        rule.cr_segment8,\n        rule.dr_segment1, -- 借方科目1\n        rule.dr_segment2,\n        rule.dr_segment3,\n        rule.dr_segment4,\n        rule.dr_segment5,\n        rule.dr_segment6,\n        rule.dr_segment7,\n        rule.dr_segment8,\n        rule.tax_segment1, -- 税科目1\n        rule.tax_segment2,\n        rule.tax_segment3,\n        rule.tax_segment4,\n        rule.tax_segment5,\n        rule.tax_segment6,\n        rule.tax_segment7,\n        rule.tax_segment8,\n        rel.ledger_id\n        FROM\n        tms_loan_trx_event env,\n        tms_loan_req req,\n        tms_loan_account_rule rule,\n        (SELECT\n        b.flex_value company_code,\n        b.attribute3 ledger_id\n        FROM\n        fnd_flex_value_b b,\n        fnd_flex_value_set s\n        WHERE b.flex_value_set_id = s.flex_value_set_id\n        AND s.flex_value_set_name = 'COM_OU_SOB') rel,\n        (SELECT\n        b.flex_value faccno, -- 会计科目\n        tl.description facc_description -- 说明\n        FROM\n        fnd_flex_value_b b,\n        fnd_flex_value_tl tl,\n        fnd_flex_value_set s\n        WHERE b.flex_value_set_id = s.flex_value_set_id\n        AND tl.flex_value_id = b.flex_value_id\n        AND s.flex_value_set_name = 'BD_ACCOUNT' -- 会计科目值集\n        AND tl.language = 'ZHS') facc,\n        (SELECT\n            trans_code,\n            trans_name\n          FROM tms_transaction_type\n          WHERE start_date_active &lt;= curdate()\n            AND (end_date_active is null or end_date_active &gt;= curdate())\n            AND enabled_flag = 'Y') type,\n        tms_gl_ledger led,\n        tms_account acc,\n        tms_loan_event_settlement_info info\n        WHERE 1 = 1\n        AND env.request_id = req.Id\n        AND info.request_id = req.Id\n        AND info.event_id = env.event_id\n        AND\n        CASE\n        WHEN ((TO_DAYS(req.interest_end_date) - TO_DAYS(env.effective_date)) &gt; 365)\n        THEN rule.lstcod = 'LONG_TERM'\n        ELSE\n            rule.lstcod = 'SHORT_TERM'\n        END\n\n        AND req.trx_type = rule.trstype -- 交易类型\n        AND rule.entcod = env.event_type -- 事件类型\n        AND rule.end_date IS NULL\n        AND req.trx_type = type.trans_code\n        AND led.ledger_id = rel.ledger_id\n        AND facc.faccno = acc.fin_account\n        AND rel.company_code = req.company_code\n        AND info.company_account_id = acc.ac_account_id\n        AND env.event_id = #{eventId, jdbcType=BIGINT} ;\n    </select>\n\n    <!-- 第三方余额结转的记账信息-->\n    <select id=\"getThirdBalanceAccounts\" parameterType=\"java.lang.Long\" resultType=\"com.baidu.tms.loan.domain.LoanAccount\">\n        SELECT\n        acc.company_code segment1,\n\t\tacc.currency trxCurrencyCode,\n\t\tacc.account_no,\n        acc.bank,\n\t\tled.currency_code ledgerCurrencyCode,\n        rule.transaction_type trx_type,\n\t\trule.financial_scene event_type, -- 财务场景\n        rule.cr_segment1, -- 贷方科目1\n        rule.cr_segment2,\n        rule.cr_segment3,\n        rule.cr_segment4,\n        rule.cr_segment5,\n        rule.cr_segment6,\n        rule.cr_segment7,\n        rule.cr_segment8,\n        rule.dr_segment1, -- 借方科目1\n        rule.dr_segment2,\n        rule.dr_segment3,\n        rule.dr_segment4,\n        rule.dr_segment5,\n        rule.dr_segment6,\n        rule.dr_segment7,\n        rule.dr_segment8,\n        rule.superintend attribute1,\n\t\tba.end_amount entered,\n        ba.balance_date accounting_date,\n        ba.balance_qianbao_id event_id,\n        ba.balance_qianbao_id source_id,\n        ba.remark,\n        rel.ledger_id\n        FROM\n        tms_account_balance_qianbao ba,\n        tms_third_account_rule rule,\n        (SELECT\n        b.flex_value company_code,\n        b.attribute3 ledger_id\n        FROM\n        fnd_flex_value_b b,\n        fnd_flex_value_set s\n        WHERE b.flex_value_set_id = s.flex_value_set_id\n        AND s.flex_value_set_name = 'COM_OU_SOB') rel,\n        tms_gl_ledger led,\n        tms_account acc\n        WHERE\n        ba.ac_account_id = rule.ac_account_id\n\t\tAND rule.transaction_type='ZFB006'\n\t\tAND\n          CASE\n              WHEN ba.account_type = 'BASIC'\n                  THEN rule.financial_scene = '08'\n              WHEN ba.account_type = 'OPERATION'\n                  THEN rule.financial_scene = '11'\n              ELSE 1=1\n          END\n        AND led.ledger_id = rel.ledger_id\n        AND rel.company_code = acc.company_code\n        AND ba.ac_account_id = acc.ac_account_id\n        AND ba.balance_qianbao_id = #{balanceId, jdbcType=BIGINT}\n    </select>\n\n    <!-- 资金划拨的记账信息贷方-->\n    <select id=\"getTransferAccountsCR\" parameterType=\"java.lang.Long\" resultType=\"com.baidu.tms.loan.domain.LoanAccount\">\n        SELECT\n        fund.transfer_num requestNumber,\n        fund.transfer_type, -- 划拨类型\n        fund.company_code segment1, -- 所属主体（待确认）\n        fund.account_company_code companyCode,\n        fund.counterparty_code, -- 对手方公司\n        fund.account company_account, -- 付款账户\n        fund.transaction_type trx_type,\n        fund.transfer_num event_number,\n        fund.transfer_id source_id,\n        fund.transfer_id event_id,\n        fund.transfer_direct event_type, -- 事件类型\n        fund.actual_pay_date accounting_date,\n        fund.pay_subject as thirdPaySubject,\n        fund.re_subject as thirdReSubject,\n        fund.source_sys_code,\n        -- info.split_amount entered, -- 拆分结算金额？？？\n        fund.amount entered,\n        fund.re_bg_code,\n        fund.pay_bg_code,\n        led.currency_code ledgerCurrencyCode,\n        type.trans_name trxTypeName,\n        fund.currency trxCurrencyCode,\n        acc.fin_account, -- 会计科目\n        facc.facc_description finAccountDescription, -- 会计科目说明\n        rule.cr_segment1, -- 贷方科目1\n        rule.cr_segment2,\n        rule.cr_segment3,\n        rule.cr_segment4,\n        rule.cr_segment5,\n        rule.cr_segment6,\n        rule.cr_segment7,\n        rule.cr_segment8,\n        rule.dr_segment1, -- 借方科目1\n        rule.dr_segment2,\n        rule.dr_segment3,\n        rule.dr_segment4,\n        rule.dr_segment5,\n        rule.dr_segment6,\n        rule.dr_segment7,\n        rule.dr_segment8,\n        rule.tax_segment1, -- 税科目1\n        rule.tax_segment2,\n        rule.tax_segment3,\n        rule.tax_segment4,\n        rule.tax_segment5,\n        rule.tax_segment6,\n        rule.tax_segment7,\n        rule.tax_segment8,\n        rel.ledger_id\n        FROM\n        tms_fund_transfer_apply fund,\n        tms_loan_account_rule rule,\n        (SELECT\n        b.flex_value company_code,\n        b.attribute3 ledger_id\n        FROM\n        fnd_flex_value_b b,\n        fnd_flex_value_set s\n        WHERE b.flex_value_set_id = s.flex_value_set_id\n        AND s.flex_value_set_name = 'COM_OU_SOB') rel,\n        (SELECT\n        b.flex_value faccno, -- 会计科目\n        tl.description facc_description -- 说明\n        FROM\n        fnd_flex_value_b b,\n        fnd_flex_value_tl tl,\n        fnd_flex_value_set s\n        WHERE b.flex_value_set_id = s.flex_value_set_id\n        AND tl.flex_value_id = b.flex_value_id\n        AND s.flex_value_set_name = 'BD_ACCOUNT' -- 会计科目值集\n        AND tl.language = 'ZHS') facc,\n        (SELECT\n        trans_code,\n        trans_name\n        FROM tms_transaction_type\n        WHERE start_date_active &lt;= curdate()\n        and (end_date_active is null or end_date_active &gt;= curdate())\n        and enabled_flag = 'Y') type,\n        tms_gl_ledger led,\n        tms_account acc\n        WHERE 1 = 1\n        AND fund.transaction_type = rule.trstype\n        AND fund.transfer_direct = rule.entcod -- T10：支出、T11：收入\n        AND rule.end_date IS NULL\n        AND led.ledger_id = rel.ledger_id\n        AND fund.transaction_type = type.trans_code\n        AND facc.faccno = acc.fin_account\n        AND rel.company_code = fund.company_code\n        AND fund.pay_account_id = acc.ac_account_id\n        AND fund.transfer_id = #{transferId, jdbcType=BIGINT} ;\n    </select>\n\n    <!-- 资金划拨的记账信息借方-->\n    <select id=\"getTransferAccountsDR\" parameterType=\"java.lang.Long\" resultType=\"com.baidu.tms.loan.domain.LoanAccount\">\n        SELECT\n        fund.transfer_num requestNumber,\n        fund.transfer_type, -- 划拨类型\n        fund.company_code segment1, -- 所属主体（待确认）\n        fund.counterparty_code, -- 对手方公司\n        fund.account company_account, -- 付款账户\n        fund.transaction_type trx_type,\n        fund.transfer_num event_number,\n        fund.transfer_id source_id,\n        fund.transfer_id event_id,\n        fund.transfer_direct event_type, -- 事件类型\n        fund.actual_pay_date accounting_date,\n        fund.pay_subject as thirdPaySubject,\n        fund.re_subject as thirdReSubject,\n        fund.source_sys_code,\n        -- info.split_amount entered, -- 拆分结算金额？？？\n        fund.amount entered,\n        fund.re_bg_code,\n        fund.pay_bg_code,\n        fund.image_flag,\n        led.currency_code ledgerCurrencyCode,\n        type.trans_name trxTypeName,\n        fund.currency trxCurrencyCode,\n        acc.fin_account, -- 会计科目\n        facc.facc_description finAccountDescription, -- 会计科目说明\n        rule.cr_segment1, -- 贷方科目1\n        rule.cr_segment2,\n        rule.cr_segment3,\n        rule.cr_segment4,\n        rule.cr_segment5,\n        rule.cr_segment6,\n        rule.cr_segment7,\n        rule.cr_segment8,\n        rule.dr_segment1, -- 借方科目1\n        rule.dr_segment2,\n        rule.dr_segment3,\n        rule.dr_segment4,\n        rule.dr_segment5,\n        rule.dr_segment6,\n        rule.dr_segment7,\n        rule.dr_segment8,\n        rule.tax_segment1, -- 税科目1\n        rule.tax_segment2,\n        rule.tax_segment3,\n        rule.tax_segment4,\n        rule.tax_segment5,\n        rule.tax_segment6,\n        rule.tax_segment7,\n        rule.tax_segment8,\n        rel.ledger_id\n        FROM\n        tms_fund_transfer_apply fund,\n        tms_loan_account_rule rule,\n        (SELECT\n        b.flex_value company_code,\n        b.attribute3 ledger_id\n        FROM\n        fnd_flex_value_b b,\n        fnd_flex_value_set s\n        WHERE b.flex_value_set_id = s.flex_value_set_id\n        AND s.flex_value_set_name = 'COM_OU_SOB') rel,\n        (SELECT\n        b.flex_value faccno, -- 会计科目\n        tl.description facc_description -- 说明\n        FROM\n        fnd_flex_value_b b,\n        fnd_flex_value_tl tl,\n        fnd_flex_value_set s\n        WHERE b.flex_value_set_id = s.flex_value_set_id\n        AND tl.flex_value_id = b.flex_value_id\n        AND s.flex_value_set_name = 'BD_ACCOUNT' -- 会计科目值集\n        AND tl.language = 'ZHS') facc,\n        (SELECT\n        trans_code,\n        trans_name\n        FROM tms_transaction_type\n        WHERE start_date_active &lt;= curdate()\n        AND (end_date_active is null or end_date_active &gt;= curdate())\n        AND enabled_flag = 'Y') type,\n        tms_gl_ledger led,\n        tms_account acc\n        WHERE 1 = 1\n        AND fund.transaction_type = rule.trstype\n        AND fund.transfer_direct = rule.entcod -- T10：支出、T11：收入\n        AND rule.end_date IS NULL\n        AND led.ledger_id = rel.ledger_id\n        AND fund.transaction_type = type.trans_code\n        AND facc.faccno = acc.fin_account\n        AND rel.company_code = fund.company_code\n        AND fund.re_account_id = acc.ac_account_id\n        AND fund.transfer_id = #{transferId, jdbcType=BIGINT} ;\n    </select>\n\n    <!-- 获取未生成日记账的计提-->\n    <select id=\"getCountNoAccountAccrual\" parameterType=\"com.baidu.tms.loan.domain.LoanAccountAccrual\"\n            resultType=\"java.lang.Integer\">\n        SELECT count(1)\n        FROM tms_loan_account_accrual a\n        INNER JOIN tms_loan_account la ON a.accrual_id = la.accrual_id\n        WHERE\n        la.approve_status IN ('Y', 'P')\n        <if test=\"occurDate != null\">\n            and a.occur_date >= #{occurDate,jdbcType=DATE}\n        </if>\n        <if test=\"requestId != null\">\n            and a.request_id = #{requestId,jdbcType=BIGINT}\n        </if>\n    </select>\n\n    <!-- 获取未生成日记账的计提-->\n    <select id=\"deleteAccrual\" parameterType=\"com.baidu.tms.loan.domain.LoanAccountAccrual\">\n        DELETE\n        FROM tms_loan_account_accrual\n        where account_status = 'N'\n        <if test=\"occurDate != null\">\n            and occur_date >= #{occurDate,jdbcType=DATE}\n        </if>\n        <if test=\"requestId != null\">\n            and request_id = #{requestId,jdbcType=BIGINT}\n        </if>\n    </select>\n\n    <select id=\"getLoanAccountsForAttach\" resultType=\"com.baidu.tms.persistent.loan.domain.TmsLoanAccount\">\n        SELECT trx_category AS trxCategory FROM tms_loan_account\n        WHERE imp_batch_num = #{glImpBatchNum} OR approve_batch_id = #{glImpBatchNum}\n    </select>\n\n    <select id=\"suggestAccountsNum\" parameterType=\"java.lang.String\"\n            resultType=\"java.util.Map\">\n        SELECT distinct loan.request_number requestNumber FROM tms_loan_account loan\n        where request_number LIKE CONCAT(\"%\",#{requestNumber},\"%\")\n        order by creation_date desc\n    </select>\n\n    <select id=\"getCompanyCurrencyPair\" resultType=\"java.util.Map\">\n        SELECT\n            rel.company_code companyCode,\n            led.currency_code currencyCode\n        FROM\n            tms_gl_ledger led,\n            (\n                SELECT\n                    b.flex_value company_code,\n                    b.attribute3 ledger_id\n                FROM\n                    fnd_flex_value_b b,\n                    fnd_flex_value_set s\n                WHERE\n                    b.flex_value_set_id = s.flex_value_set_id\n                  AND s.flex_value_set_name = 'COM_OU_SOB'\n            ) rel\n        WHERE\n            led.ledger_id = rel.ledger_id\n    </select>\n    <!-- 查询待记账的的交易事件-->\n    <select id=\"selectEventByCondition\" parameterType=\"com.baidu.tms.loan.domain.LoanAccountEvent\"\n            resultType=\"com.baidu.tms.loan.domain.LoanAccountEvent\">\n    select\n        env.event_id,\n        req.id requestId,\n        req.company_code,\n        req.company company_code_name,\n        req.counterparty_code,\n        req.counterparty counterparty_code_name,\n        req.trx_type,\n        req.request_number,\n        env.event_type,\n        env.event_number,\n        req.currency_code trxCurrencyCode,\n        env.settlement_amount,\n        env.settlement_date,\n        env.event_status,\n        env.account_status trxAccountStatus,\n        env.actual_pay_date,\n        env.settlement_date,\n        env.direction,\n        env.accounting_user\n    from\n    tms_loan_trx_event env\n    left join tms_loan_req req on env.request_id = req.Id\n    <where>\n        AND env.event_status='COMPLETED'\n        AND env.event_type not in('EVENT_ADJUST_RATE')\n        AND env.account_status in ('N','Y','P','APPROVED')\n        AND EXISTS (SELECT 1 FROM\n        (SELECT DISTINCT\n        l.line_value company_code\n        FROM\n        tms_loan_role_header h,\n        tms_loan_role_line l\n        WHERE h.role_header_id = l.role_header_id\n        AND h.role_user = #{userName,jdbcType=VARCHAR}\n        AND h.end_date IS NULL\n        AND l.line_type = 'LINE_COMPANY') companys\n        WHERE companys.company_code = req.company_code)\n        and EXISTS (select 1 from (SELECT\n        DISTINCT l.line_value currency\n        FROM\n        tms_loan_role_header h,\n        tms_loan_role_line l\n        WHERE h.role_header_id = l.role_header_id\n        AND h.role_user = #{userName}\n        AND h.end_date IS NULL\n        AND l.line_type='LINE_CURRENCY') currencys\n        where currencys.currency = req.currency_code)\n        and EXISTS (select 1 from (SELECT\n        DISTINCT l.line_value transaction_type\n        FROM\n        tms_loan_role_header h,\n        tms_loan_role_line l\n        WHERE h.role_header_id = l.role_header_id\n        AND h.role_user = #{userName}\n        AND h.end_date IS NULL\n        AND l.line_type='LINE_TRANSACTION_TYPE') transactionTypes\n        where transactionTypes.transaction_type = req.trx_type)\n        <if test=\"trxType != null and trxType != ''\">\n            and req.trx_type = #{trxType,jdbcType=VARCHAR}\n        </if>\n        <if test=\"eventType != null and eventType != ''\">\n            and env.event_type = #{eventType,jdbcType=VARCHAR}\n        </if>\n        <if test=\"eventNumber != null and eventNumber != ''\">\n            and env.event_number = #{eventNumber,jdbcType=VARCHAR}\n        </if>\n        <if test=\"companyCode != null and companyCode != ''\">\n            and req.company_code = #{companyCode,jdbcType=VARCHAR}\n        </if>\n        <if test=\"companyCodeList != null and companyCodeList.size() > 0\">\n            and req.company_code in\n            <foreach collection=\"companyCodeList\" item=\"code\" index=\"index\" open=\"(\" close=\")\"\n                     separator=\",\">\n                #{code}\n            </foreach>\n        </if>\n        <if test=\"requestNumber != null and requestNumber != ''\">\n            and req.request_number = #{requestNumber,jdbcType=VARCHAR}\n        </if>\n        <if test=\"fromActualPayDate != null and fromActualPayDate!=''\">\n            AND env.actual_pay_date <![CDATA[ >= ]]>  #{fromActualPayDate,jdbcType=TIMESTAMP}\n        </if>\n        <if test=\"toActualPayDate != null and toActualPayDate!=''\">\n            AND env.actual_pay_date  <![CDATA[ <= ]]>  #{toActualPayDate,jdbcType=TIMESTAMP}\n        </if>\n        <if test=\"trxCurrencyCode != null and trxCurrencyCode != ''\">\n            and req.currency_code = #{trxCurrencyCode,jdbcType=VARCHAR}\n        </if>\n        <if test=\"trxAccountStatus != null and trxAccountStatus != ''\">\n            and env.account_status = #{trxAccountStatus,jdbcType=VARCHAR}\n        </if>\n        <if test=\"accountingUser != null and accountingUser != ''\">\n            and env.accounting_user = #{accountingUser,jdbcType=VARCHAR}\n        </if>\n    </where>\n    order by env.event_id desc\n    </select>\n\n    <!-- 获取 记提记账分录信息-->\n    <select id=\"getCompanyAccrualAccounts\" parameterType=\"java.lang.Long\"\n            resultType=\"com.baidu.tms.loan.domain.LoanAccount\">\n        SELECT\n            req.id source_id,\n            req.company_code,\n            req.counterparty_code,\n            req.company_account,\n            req.loan_method,\n            req.counterparty_type,\n            interest.request_num request_number,\n            interest.trx_type,\n            -- 'INTERCOMPANY' process_type, -- 交易类别放在流程类型上\n            req.deal_category process_type, -- 新交易类别\n            interest.accrual_id,\n            interest.day_count,\n            interest.amount_adjust,\n            interest.accrual_type eventType,\n            interest.account_period accountPeriod, -- 取计提利息会计期间\n            ifnull(interest.amount_accrual,0) + ifnull(interest.amount_adjust,0) entered,\n            interest.reclassify_flag, -- 是否重分类标识\n            interest.reclassify_interest, -- 重分类利息\n            led.currency_code ledgerCurrencyCode,\n            type.trans_name trxTypeName,\n            interest.currency_code trxCurrencyCode,\n            rule.cr_segment1,\n            rule.cr_segment2,\n            rule.cr_segment3,\n            rule.cr_segment4,\n            rule.cr_segment5,\n            rule.cr_segment6,\n            rule.cr_segment7,\n            rule.cr_segment8,\n            rule.dr_segment1,\n            rule.dr_segment2,\n            rule.dr_segment3,\n            rule.dr_segment4,\n            rule.dr_segment5,\n            rule.dr_segment6,\n            rule.dr_segment7,\n            rule.dr_segment8,\n            rule.tax_segment1,\n            rule.tax_segment2,\n            rule.tax_segment3,\n            rule.tax_segment4,\n            rule.tax_segment5,\n            rule.tax_segment6,\n            rule.tax_segment7,\n            rule.tax_segment8,\n            rule.lstcod,\n            rel.ledger_id,\n            comp.counterparty_name\n        FROM\n            tms_loan_interest_accrual interest,\n            tms_loan_req req,\n            tms_loan_account_rule rule,\n            (\n                SELECT\n                    b.flex_value company_code,\n                    b.attribute3 ledger_id\n                FROM\n                    fnd_flex_value_b b,\n                    fnd_flex_value_set s\n                WHERE\n                    b.flex_value_set_id = s.flex_value_set_id\n                    AND s.flex_value_set_name = 'COM_OU_SOB'\n            ) rel,\n            (\n                SELECT\n                    trans_code,\n                    trans_name\n                FROM\n                    tms_transaction_type\n                WHERE\n                    start_date_active &lt;= curdate()\n                    AND (\n                        end_date_active IS NULL\n                        OR end_date_active >= curdate()\n                    )\n                    AND enabled_flag = 'Y'\n            ) type,\n            (\n                SELECT\n                    counterparty_name,\n                    company_code\n                FROM\n                    tms_loan_company_rule\n            ) comp,\n            tms_gl_ledger led\n        WHERE\n            interest.request_id = req.id\n        AND (\n            interest.reclassify_flag IS NULL\n            OR interest.reclassify_flag = 'N'\n        )\n        AND CASE\n        WHEN (\n            (TO_DAYS(req.interest_end_date) - TO_DAYS(date_format(LAST_DAY(STR_TO_DATE(account_period,'%b-%y')),'%Y-%m-%d'))) > 365\n        ) THEN\n            rule.lstcod = 'LONG_TERM'\n        ELSE\n            rule.lstcod = 'SHORT_TERM'\n        END\n        AND interest.trx_type = rule.trstype\n        AND rule.entcod = interest.accrual_type -- 事件类型：计提应付利息 or 计提应收利息\n        AND interest.accrual_type !='A07'\n        AND rule.end_date IS NULL\n        AND interest.trx_type = type.trans_code\n        AND interest.counterparty_code = comp.company_code\n        AND led.ledger_id = rel.ledger_id\n        AND rel.company_code = interest.company_code\n        AND interest.accrual_id = #{accrualId,jdbcType=BIGINT}\n        union all\n        SELECT\n            req.id source_id,\n            req.company_code,\n            req.counterparty_code,\n            req.company_account,\n            req.loan_method,\n            req.counterparty_type,\n            interest.request_num request_number,\n            interest.trx_type,\n            -- 'INTERCOMPANY' process_type, -- 交易类别放在流程类型上\n            req.deal_category process_type, -- 新交易类别\n            interest.accrual_id,\n            interest.day_count,\n            interest.amount_adjust,\n            interest.accrual_type eventType,\n            interest.account_period accountPeriod, -- 取计提利息会计期间\n            ifnull(interest.balance,0) entered,\n            interest.reclassify_flag, -- 是否重分类标识\n            interest.reclassify_interest, -- 重分类利息\n            led.currency_code ledgerCurrencyCode,\n            type.trans_name trxTypeName,\n            interest.currency_code trxCurrencyCode,\n            rule.cr_segment1,\n            rule.cr_segment2,\n            rule.cr_segment3,\n            rule.cr_segment4,\n            rule.cr_segment5,\n            rule.cr_segment6,\n            rule.cr_segment7,\n            rule.cr_segment8,\n            rule.dr_segment1,\n            rule.dr_segment2,\n            rule.dr_segment3,\n            rule.dr_segment4,\n            rule.dr_segment5,\n            rule.dr_segment6,\n            rule.dr_segment7,\n            rule.dr_segment8,\n            rule.tax_segment1,\n            rule.tax_segment2,\n            rule.tax_segment3,\n            rule.tax_segment4,\n            rule.tax_segment5,\n            rule.tax_segment6,\n            rule.tax_segment7,\n            rule.tax_segment8,\n            rule.lstcod,\n            rel.ledger_id,\n            comp.counterparty_name\n        FROM\n            tms_loan_interest_accrual interest,\n            tms_loan_req req,\n            tms_loan_account_rule rule,\n            (\n                SELECT\n                    b.flex_value company_code,\n                    b.attribute3 ledger_id\n                FROM\n                    fnd_flex_value_b b,\n                    fnd_flex_value_set s\n                WHERE\n                    b.flex_value_set_id = s.flex_value_set_id\n                  AND s.flex_value_set_name = 'COM_OU_SOB'\n            ) rel,\n            (\n                SELECT\n                    trans_code,\n                    trans_name\n                FROM\n                    tms_transaction_type\n                WHERE\n                    start_date_active &lt;= curdate()\n                  AND (\n                        end_date_active IS NULL\n                        OR end_date_active >= curdate()\n                    )\n                  AND enabled_flag = 'Y'\n            ) type,\n            (\n                SELECT\n                    counterparty_name,\n                    company_code\n                FROM\n                    tms_loan_company_rule\n            ) comp,\n            tms_gl_ledger led\n        WHERE\n            interest.request_id = req.id\n          AND interest.reclassify_flag = 'Y'\n          AND rule.lstcod in ('LONG_TERM', 'SHORT_TERM')\n        AND interest.trx_type = rule.trstype\n        AND CASE\n          WHEN req.loan_method = 'OUT'\n           THEN rule.entcod = 'T01'\n          WHEN req.loan_method = 'IN'\n           THEN rule.entcod = 'T02'\n        END\n        AND interest.accrual_type = 'A07'\n        AND rule.end_date IS NULL\n        AND interest.trx_type = type.trans_code\n        AND interest.counterparty_code = comp.company_code\n        AND led.ledger_id = rel.ledger_id\n        AND rel.company_code = interest.company_code\n        AND interest.accrual_id = #{accrualId,jdbcType=BIGINT}\n    </select>\n\n    <select id=\"getLoanAccountsByBatchId\" resultType=\"com.baidu.tms.persistent.loan.domain.TmsLoanAccount\">\n        SELECT * FROM tms_loan_account\n        WHERE imp_batch_num = #{approveBatchId} OR approve_batch_id = #{approveBatchId}\n    </select>\n    <select id=\"getLoanAccountsByfairId\" parameterType=\"java.lang.Long\"\n            resultType=\"com.baidu.tms.loan.domain.LoanAccount\">\n        select\n        ifrs.fair_id accrualId,\n        account.source_id,\n        account.request_number,\n        account.trx_type,\n        account.account_type,\n        account.ledger_id,\n        account.process_type,\n        account.trx_currency_code,\n        account.ledger_currency_code,\n        account.entered,\n        account.segment1,\n        account.segment2,\n        account.segment3,\n        account.segment4,\n        account.segment5,\n        account.segment6,\n        account.segment7,\n        account.segment8,\n        account.accounted,\n        account.direction,\n        account.exchange_rate,\n        account.account_period,\n        account.accounting_date,\n        account.naryur\n        from\n        tms_deal_ifrs_fairvalue ifrs,\n        tms_deal_interest_accrual interest,\n        tms_loan_account account\n        where ifrs.deal_id = interest.deal_id\n        and ifrs.value_period = interest.account_period\n        and interest.accrual_id = account.accrual_id\n        and account.approve_status = 'Y'\n        and account.trx_category = 'DEALINTERESTACCRUAL'\n        and ifrs.fair_id = #{fairId,jdbcType=BIGINT}\n    </select>\n\n    <select id=\"getFairvalueAccounts\" parameterType=\"java.lang.Long\"\n            resultType=\"com.baidu.tms.loan.domain.LoanAccount\">\n        SELECT\n        deal.deal_id source_id,\n        deal.company_code segment1,\n        deal.counterparty_code,\n        deal.company_account,\n        deal.deal_num request_number,\n        deal.deal_type trx_type,\n        deal.deal_category process_type,\n        deal.product_name,\n        ifrs.fair_id accrualId,\n        ifrs.account_type,\n        ifrs.value_period accountPeriod,\n        ifrs.change_value entered,\n        led.currency_code ledgerCurrencyCode,\n        type.trans_name trxTypeName,\n        deal.currency_code trxCurrencyCode,\n        rule.ifrs_cr_segment1,\n        rule.ifrs_cr_segment2,\n        rule.ifrs_cr_segment3,\n        rule.ifrs_cr_segment4,\n        rule.ifrs_cr_segment5,\n        rule.ifrs_cr_segment6,\n        rule.ifrs_cr_segment7,\n        rule.ifrs_cr_segment8,\n        rule.ifrs_dr_segment1,\n        rule.ifrs_dr_segment2,\n        rule.ifrs_dr_segment3,\n        rule.ifrs_dr_segment4,\n        rule.ifrs_dr_segment5,\n        rule.ifrs_dr_segment6,\n        rule.ifrs_dr_segment7,\n        rule.ifrs_dr_segment8,\n        rule.tax_segment1,\n        rule.tax_segment2,\n        rule.tax_segment3,\n        rule.tax_segment4,\n        rule.tax_segment5,\n        rule.tax_segment6,\n        rule.tax_segment7,\n        rule.tax_segment8,\n        rule.lstcod,\n        rel.ledger_id,\n        comp.counterparty_name\n        FROM\n        tms_deal_ifrs_fairvalue ifrs,\n        tms_deal deal,\n        tms_loan_account_rule rule,\n        (SELECT\n        b.flex_value company_code,\n        b.attribute3 ledger_id\n        FROM\n        fnd_flex_value_b b,\n        fnd_flex_value_set s\n        WHERE b.flex_value_set_id = s.flex_value_set_id\n        AND s.flex_value_set_name = 'COM_OU_SOB') rel,\n        (SELECT\n        trans_code,\n        trans_name\n        FROM tms_transaction_type\n        WHERE start_date_active &lt;= curdate()\n        AND (end_date_active is null or end_date_active >= curdate())\n        AND enabled_flag = 'Y') type,\n        (SELECT\n        counterparty_name,\n        company_code\n        FROM tms_loan_company_rule) comp,\n        tms_gl_ledger led\n        WHERE 1 = 1\n        AND ifrs.deal_id = deal.deal_id\n        AND\n        CASE\n        WHEN deal.deal_category != 'TERMFINANCING'\n        THEN rule.lstcod = 'NONE'\n        WHEN deal.days_deposit &lt; 92 and deal.deal_category = 'TERMFINANCING'\n        THEN rule.lstcod = 'ULTRA_SHORT_TERM'\n        WHEN deal.days_deposit >= 92 and deal.days_deposit &lt;= 375 and deal.deal_category = 'TERMFINANCING'\n        THEN rule.lstcod = 'SHORT_TERM'\n        WHEN deal.days_deposit > 375 and deal.deal_category = 'TERMFINANCING'\n        THEN rule.lstcod = 'LONG_TERM'\n        END\n        AND deal.deal_type = rule.trstype\n        AND rule.entcod = 'A05'\n        AND rule.end_date IS NULL\n        AND deal.deal_type = type.trans_code\n        AND deal.counterparty_code = comp.company_code\n        AND led.ledger_id = rel.ledger_id\n        AND rel.company_code = deal.company_code\n        AND ifrs.fair_id = #{fairId, jdbcType=BIGINT}\n\t\tlimit 1;\n    </select>\n\n    <select id=\"getValueAccounts\" parameterType=\"java.lang.Long\" resultType=\"com.baidu.tms.