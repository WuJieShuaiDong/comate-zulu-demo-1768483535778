                  "content": "1-><?xml version=\"1.0\" encoding=\"UTF-8\" ?>\n2->\n3-><!DOCTYPE mapper PUBLIC \"-//mybatis.org//DTD Mapper 3.0//EN\" \"http://mybatis.org/dtd/mybatis-3-mapper.dtd\" >\n4-><mapper namespace=\"com.baidu.tms.loan.dao.LoanAccountDao\">\n5->    <!-- 待记账交易事件查询字段-->\n6->    <sql id=\"event_base_column\">\n7->      env.event_id eventId,\n8->      req.company company_code_name,\n9->      req.id requestId,\n10->      req.company_code,\n11->      led.currency_code ledgerCurrencyCode,\n12->      req.counterparty counterparty_code_name,\n13->      req.counterparty_code,\n14->      req.trx_type,\n15->      req.request_number,\n16->      env.event_type ,\n17->      env.event_number,\n18->      req.currency_code trxCurrencyCode,\n19->      env.settlement_amount,\n20->      env.event_status,\n21->      env.account_status trxAccountStatus,\n22->      env.actual_pay_date\n23->    </sql>\n24->\n25->    <!-- 待记账的的交易事件-->\n26->    <select id=\"getEvents\" parameterType=\"com.baidu.tms.loan.domain.LoanAccountEvent\"\n27->            resultType=\"com.baidu.tms.loan.domain.LoanAccountEvent\">\n28->        select\n29->        <include refid=\"event_base_column\"/>\n30->        from\n31->        tms_loan_req req,\n32->        tms_loan_trx_event env,\n33->        (SELECT\n34->        b.flex_value company_code,\n35->        b.attribute3 ledger_id\n36->        FROM\n37->        fnd_flex_value_b b,\n38->        fnd_flex_value_set s\n39->        WHERE b.flex_value_set_id = s.flex_value_set_id\n40->        AND s.flex_value_set_name = 'COM_OU_SOB') rel,\n41->        tms_gl_ledger led\n42->        <where>\n43->            req.Id = env.request_id\n44->            AND led.ledger_id = rel.ledger_id\n45->            AND rel.company_code = req.company_code\n46->            AND env.event_status='COMPLETED'\n47->            AND env.account_status in ('N','Y')\n48->            AND EXISTS\n49->            (SELECT\n50->            1\n51->            FROM\n52->            (SELECT DISTINCT\n53->            l.line_value company_code\n54->            FROM\n55->            tms_loan_role_header h,\n56->            tms_loan_role_line l\n57->            WHERE h.role_header_id = l.role_header_id\n58->            AND h.role_user = #{userName,jdbcType=VARCHAR}\n59->            AND h.end_date IS NULL\n60->            AND l.line_type = 'LINE_COMPANY') companys\n61->            WHERE companys.company_code = req.company_code)\n62->            <if test=\"trxType != null and trxType != ''\">\n63->                and req.trx_type = #{trxType,jdbcType=VARCHAR}\n64->            </if>\n65->            <if test=\"processType != null and processType != ''\">\n66->                and req.process_type = #{processType,jdbcType=VARCHAR}\n67->            </if>\n68->            <if test=\"companyCode != null and companyCode != ''\">\n69->                and req.company_code = #{companyCode,jdbcType=VARCHAR}\n70->            </if>\n71->            <if test=\"requestNumber != null and requestNumber != ''\">\n72->                and req.request_number = #{requestNumber,jdbcType=VARCHAR}\n73->            </if>\n74->            <if test=\"eventNumber != null and eventNumber != ''\">\n75->                and env.event_number = #{eventNumber,jdbcType=VARCHAR}\n76->            </if>\n77->            <if test=\"trxCurrencyCode != null and trxCurrencyCode != ''\">\n78->                and req.currency_code = #{trxCurrencyCode,jdbcType=VARCHAR}\n79->            </if>\n80->            <if test=\"trxAccountStatus != null and trxAccountStatus != ''\">\n81->                and env.account_status = #{trxAccountStatus,jdbcType=VARCHAR}\n82->            </if>\n83->            <if test=\"fromActualPayDate != null and fromActualPayDate!=''\">\n84->                AND env.actual_pay_date <![CDATA[ >= ]]>  #{fromActualPayDate,jdbcType=TIMESTAMP}\n85->            </if>\n86->            <if test=\"toActualPayDate != null and toActualPayDate!=''\">\n87->                AND env.actual_pay_date  <![CDATA[ <= ]]>  #{toActualPayDate,jdbcType=TIMESTAMP}\n88->            </if>\n89->\n90->\n91->        </where>\n92->        order by env.last_update_date\n93->    </select>\n94->    <!-- 交易事件的记账信息-->\n95->    <select id=\"getAccounts\" parameterType=\"java.lang.Long\"\n96->            resultType=\"com.baidu.tms.loan.domain.LoanAccount\">\n97->        SELECT\n98->          req.Id source_id,\n99->          req.counterparty_type,\n100->          req.company_code segment1,\n101->          req.counterparty_code,\n102->          req.company_account,\n103->          req.request_number,\n104->          req.trx_type,\n105->          type.trans_name trxTypeName,\n106->          env.event_number,\n107->          env.event_id,\n108->          env.event_type,\n109->          env.actual_pay_date accounting_date,\n110->          env.settlement_amount entered,\n111->          led.currency_code ledgerCurrencyCode,\n112->          req.currency_code trxCurrencyCode,\n113->          acc.fin_account,\n114->          facc.facc_description finAccountDescription,\n115->          rule.cr_segment1,\n116->          rule.cr_segment2,\n117->          rule.cr_segment3,\n118->          rule.cr_segment4,\n119->          rule.cr_segment5,\n120->          rule.cr_segment6,\n121->          rule.cr_segment7,\n122->          rule.cr_segment8,\n123->          rule.dr_segment1,\n124->          rule.dr_segment2,\n125->          rule.dr_segment3,\n126->          rule.dr_segment4,\n127->          rule.dr_segment5,\n128->          rule.dr_segment6,\n129->          rule.dr_segment7,\n130->          rule.dr_segment8,\n131->          rule.tax_segment1,\n132->          rule.tax_segment2,\n133->          rule.tax_segment3,\n134->          rule.tax_segment4,\n135->          rule.tax_segment5,\n136->          rule.tax_segment6,\n137->          rule.tax_segment7,\n138->          rule.tax_segment8,\n139->          rel.ledger_id\n140->        FROM\n141->          tms_loan_trx_event env,\n142->          tms_loan_req req,\n143->          tms_loan_account_rule rule,\n144->          (SELECT\n145->            b.flex_value company_code,\n146->            b.attribute3 ledger_id\n147->          FROM\n148->            fnd_flex_value_b b,\n149->            fnd_flex_value_set s\n150->          WHERE b.flex_value_set_id = s.flex_value_set_id\n151->            AND s.flex_value_set_name = 'COM_OU_SOB') rel,\n152->          (SELECT\n153->            b.flex_value faccno,\n154->            tl.description facc_description\n155->          FROM\n156->            fnd_flex_value_b b,\n157->            fnd_flex_value_tl tl,\n158->            fnd_flex_value_set s\n159->          WHERE b.flex_value_set_id = s.flex_value_set_id\n160->            AND tl.flex_value_id = b.flex_value_id\n161->            AND s.flex_value_set_name = 'BD_ACCOUNT'\n162->            AND tl.language = 'ZHS') facc,\n163->          (SELECT\n164->            trans_code,\n165->            trans_name\n166->          FROM tms_transaction_type\n167->          WHERE start_date_active &lt;= curdate()\n168->            AND (end_date_active is null or end_date_active &gt;= curdate())\n169->            AND enabled_flag = 'Y') type,\n170->          tms_gl_ledger led,\n171->          tms_account acc,\n172->          tms_loan_event_settlement_info info\n173->        WHERE 1 = 1\n174->          AND env.request_id = req.Id\n175->          AND info.request_id = req.Id\n176->          AND info.event_id = env.event_id\n177->          AND\n178->          CASE\n179->              WHEN ((TO_DAYS(req.interest_end_date) - TO_DAYS(env.effective_date)) &gt; 365)\n180->                  THEN rule.lstcod = 'LONG_TERM'\n181->              ELSE\n182->                  rule.lstcod = 'SHORT_TERM'\n183->          END\n184->\n185->          AND req.trx_type = rule.trstype\n186->          AND rule.entcod = env.event_type\n187->          AND rule.end_date IS NULL\n188->          AND req.trx_type = type.trans_code\n189->          AND led.ledger_id = rel.ledger_id\n190->          AND facc.faccno = acc.fin_account\n191->          AND rel.company_code = req.company_code\n192->          AND info.company_account_id = acc.ac_account_id\n193->          AND env.event_id = #{eventId, jdbcType=BIGINT} \n194->          limit 1 ;\n195->    </select>\n196->    <!-- 交易事件的记账信息-->\n197->    <select id=\"getFinancialAccounts\" parameterType=\"java.lang.Long\"\n198->            resultType=\"com.baidu.tms.loan.domain.LoanAccount\">\n199->        SELECT\n200->          deal.deal_id source_id,\n201->          deal.company_code segment1,\n202->          deal.counterparty_code,\n203->          env.company_account,\n204->          deal.deal_num request_number,\n205->          deal.deal_type trx_type,\n206->          deal.deal_category trx_category,\n207->          deal.product_name,\n208->          env.event_number,\n209->          env.event_id,\n210->          env.event_type,\n211->          env.sel_id,\n212->          env.settlement_date accounting_date,\n213->          env.total_interest,\n214->          case\n215->\t\t\twhen env.event_type = 'EVENT_INTEREST_PRINCIPAL'\n216->\t\t\t  then env.principal_balance\n217->            when env.event_type != 'EVENT_INTEREST_PRINCIPAL'\n218->\t\t\t  then env.settlement_amount\n219->\t\t  end\n220->\t\t  entered,\n221->          deal.amount billAmount,\n222->          deal.interest,\n223->          deal.net_amount,\n224->          led.currency_code ledgerCurrencyCode,\n225->          type.trans_name trxTypeName,\n226->          deal.currency_code trxCurrencyCode,\n227->          acc.fin_account,\n228->          facc.facc_description finAccountDescription,\n229->          rule.cr_segment1,\n230->          rule.cr_segment2,\n231->          rule.cr_segment3,\n232->          rule.cr_segment4,\n233->          rule.cr_segment5,\n234->          rule.cr_segment6,\n235->          rule.cr_segment7,\n236->          rule.cr_segment8,\n237->          rule.dr_segment1,\n238->          rule.dr_segment2,\n239->          rule.dr_segment3,\n240->          rule.dr_segment4,\n241->          rule.dr_segment5,\n242->          rule.dr_segment6,\n243->          rule.dr_segment7,\n244->          rule.dr_segment8,\n245->          rule.tax_segment1,\n246->          rule.tax_segment2,\n247->          rule.tax_segment3,\n248->          rule.tax_segment4,\n249->          rule.tax_segment5,\n250->          rule.tax_segment6,\n251->          rule.tax_segment7,\n252->          rule.tax_segment8,\n253->          rel.ledger_id,\n254->          comp.counterparty_name\n255->        FROM\n256->          tms_deal_event env,\n257->          tms_deal deal,\n258->          tms_loan_account_rule rule,\n259->          (SELECT\n260->            b.flex_value company_code,\n261->            b.attribute3 ledger_id\n262->          FROM\n263->            fnd_flex_value_b b,\n264->            fnd_flex_value_set s\n265->          WHERE b.flex_value_set_id = s.flex_value_set_id\n266->            AND s.flex_value_set_name = 'COM_OU_SOB') rel,\n267->          (SELECT\n268->            b.flex_value faccno,\n269->            tl.description facc_description\n270->          FROM\n271->            fnd_flex_value_b b,\n272->            fnd_flex_value_tl tl,\n273->            fnd_flex_value_set s\n274->          WHERE b.flex_value_set_id = s.flex_value_set_id\n275->            AND tl.flex_value_id = b.flex_value_id\n276->            AND s.flex_value_set_name = 'BD_ACCOUNT'\n277->            AND tl.language = 'ZHS') facc,\n278->        (SELECT\n279->        trans_code,\n280->        trans_name\n281->        FROM tms_transaction_type\n282->        WHERE start_date_active &lt;= curdate()\n283->        AND (end_date_active is null or end_date_active &gt;= curdate())\n284->        AND enabled_flag = 'Y') type,\n285->        (SELECT\n286->        counterparty_name,\n287->        company_code\n288->        FROM tms_loan_company_rule) comp,\n289->        tms_gl_ledger led,\n290->        tms_account acc\n291->        WHERE 1 = 1\n292->          AND env.deal_id = deal.deal_id\n293->          AND\n294->          CASE\n295->              WHEN deal.deal_category not in ('TERMFINANCING','BANKLOAN') or deal.deal_category = 'BILLFINANCING'\n296->                  THEN rule.lstcod = 'NONE'\n297->              WHEN deal.days_deposit &lt; 92 and deal.deal_category = 'TERMFINANCING'\n298->                  THEN rule.lstcod = 'ULTRA_SHORT_TERM'\n299->              WHEN deal.days_deposit >= 92 and deal.days_deposit &lt;= 375 and deal.deal_category = 'TERMFINANCING'\n300->                  THEN rule.lstcod = 'SHORT_TERM'\n301->              WHEN deal.days_deposit > 375 and deal.deal_category = 'TERMFINANCING'\n302->                  THEN rule.lstcod = 'LONG_TERM'\n303->              WHEN deal.days_deposit &lt;= 366 and deal.deal_category = 'BANKLOAN'\n304->                  THEN rule.lstcod = 'SHORT_TERM'\n305->              WHEN deal.days_deposit > 366 and deal.deal_category = 'BANKLOAN'\n306->                  THEN rule.lstcod = 'LONG_TERM'\n307->          END\n308->          AND deal.deal_type = rule.trstype\n309->          AND rule.entcod = env.event_type\n310->          AND rule.end_date IS NULL\n311->          AND deal.deal_type = type.trans_code\n312->          AND deal.counterparty_code = comp.company_code\n313->          AND led.ledger_id = rel.ledger_id\n314->          AND facc.faccno = acc.fin_account\n315->          AND rel.company_code = deal.company_code\n316->          AND env.company_account = acc.account_no\n317->          AND env.currency_code = acc.currency\n318->          AND env.event_id = #{eventId, jdbcType=BIGINT}\n319->          limit 1 ;\n320->    </select>\n321->\n322->\n323->    <select id=\"getForeignExchangeAccountsCR\" parameterType=\"java.lang.Long\"\n324->            resultType=\"com.baidu.tms.loan.domain.LoanAccount\">\n325->        SELECT\n326->            fore.id source_id,\n327->            fore.company segment1,\n328->            fore.Counterparty,\n329->--             bill.bg_code,\n330->--             env.company_account,\n331->            fore.Payment_Account companyAccount,\n332->            fore.Transaction_number request_number,\n333->            fore.Transaction_Type trx_type,\n334->            fore.Transaction_number event_number,\n335->            fore.id event_id,\n336->            fore.Settlement_Date accounting_date,\n337->            fore.Sell_Amount entered,\n338->            fore.Service_Charge serviceCharge,\n339->--             bill.bill_category trx_category,\n340->--             env.settlement_amount entered,\n341->--             env.principal_in_out billAmount,\n342->--             env.interest,\n343->            led.currency_code ledgerCurrencyCode,\n344->            type.trans_name trxTypeName,\n345->            fore.Sell_currency trxCurrencyCode,\n346->            acc.fin_account,\n347->            facc.facc_description finAccountDescription,\n348->            rule.cr_segment1,\n349->            rule.cr_segment2,\n350->            rule.cr_segment3,\n351->            rule.cr_segment4,\n352->            rule.cr_segment5,\n353->            rule.cr_segment6,\n354->            rule.cr_segment7,\n355->            rule.cr_segment8,\n356->            rule.dr_segment1,\n357->            rule.dr_segment2,\n358->            rule.dr_segment3,\n359->            rule.dr_segment4,\n360->            rule.dr_segment5,\n361->            rule.dr_segment6,\n362->            rule.dr_segment7,\n363->            rule.dr_segment8,\n364->            rule.tax_segment1,\n365->            rule.tax_segment2,\n366->            rule.tax_segment3,\n367->            rule.tax_segment4,\n368->            rule.tax_segment5,\n369->            rule.tax_segment6,\n370->            rule.tax_segment7,\n371->            rule.tax_segment8,\n372->            rule.pl_in_segment1,\n373->            rule.pl_in_segment2,\n374->            rule.pl_in_segment3,\n375->            rule.pl_in_segment4,\n376->            rule.pl_in_segment5,\n377->            rule.pl_in_segment6,\n378->            rule.pl_in_segment7,\n379->            rule.pl_in_segment8,\n380->            rule.pl_fe_segment1,\n381->            rule.pl_fe_segment2,\n382->            rule.pl_fe_segment3,\n383->            rule.pl_fe_segment4,\n384->            rule.pl_fe_segment5,\n385->            rule.pl_fe_segment6,\n386->            rule.pl_fe_segment7,\n387->            rule.pl_fe_segment8,\n388->            rel.ledger_id,\n389->            fore.attribute1 as product_type\n390->        FROM\n391->            tms_foreign_exchange_manage fore,\n392->            tms_loan_account_rule rule,\n393->            (SELECT\n394->                 b.flex_value company_code,\n395->                 b.attribute3 ledger_id\n396->             FROM\n397->                 fnd_flex_value_b b,\n398->                 fnd_flex_value_set s\n399->             WHERE b.flex_value_set_id = s.flex_value_set_id\n400->               AND s.flex_value_set_name = 'COM_OU_SOB') rel,\n401->            (SELECT\n402->                 b.flex_value faccno,\n403->                 tl.description facc_description\n404->             FROM\n405->                 fnd_flex_value_b b,\n406->                 fnd_flex_value_tl tl,\n407->                 fnd_flex_value_set s\n408->             WHERE b.flex_value_set_id = s.flex_value_set_id\n409->               AND tl.flex_value_id = b.flex_value_id\n410->               AND s.flex_value_set_name = 'BD_ACCOUNT'\n411->               AND tl.language = 'ZHS') facc,\n412->            (SELECT\n413->                 trans_code,\n414->                 trans_name\n415->             FROM tms_transaction_type\n416->             WHERE start_date_active &lt;= curdate()\n417->               AND (end_date_active is null or end_date_active &gt;= curdate())\n418->               AND enabled_flag = 'Y') type,\n419->            tms_gl_ledger led,\n420->            tms_account acc\n421->        WHERE 1 = 1\n422->          AND fore.Transaction_Type = rule.trstype\n423->--           AND rule.entcod = env.event_type\n424->          AND rule.end_date IS NULL\n425->          AND fore.Transaction_Type = type.trans_code\n426->          AND led.ledger_id = rel.ledger_id\n427->          AND facc.faccno = acc.fin_account\n428->          AND rel.company_code = fore.company\n429->          AND fore.Sell_currency = acc.currency\n430->          AND fore.id = #{eventId, jdbcType=BIGINT}\n431->            limit 1 ;\n432->    </select>\n433->\n434->    <select id=\"getForeignExchangeAccountsDR\" parameterType=\"java.lang.Long\"\n435->            resultType=\"com.baidu.tms.loan.domain.LoanAccount\">\n436->        SELECT\n437->            fore.id source_id,\n438->            fore.company segment1,\n439->            fore.Counterparty counterparty,\n440->--             bill.bg_code,\n441->--             env.company_account,\n442->            fore.Receiving_Account companyAccount,\n443->            fore.Transaction_number request_number,\n444->            fore.Transaction_Type trx_type,\n445->            fore.Transaction_number event_number,\n446->            fore.id event_id,\n447->            fore.Settlement_Date accounting_date,\n448->            fore.Buy_Amount entered,\n449->            fore.Service_Charge serviceCharge,\n450->--             bill.bill_category trx_category,\n451->--             env.settlement_amount entered,\n452->--             env.principal_in_out billAmount,\n453->--             env.interest,\n454->            led.currency_code ledgerCurrencyCode,\n455->            type.trans_name trxTypeName,\n456->            fore.Buy_currency trxCurrencyCode,\n457->            acc.fin_account,\n458->            facc.facc_description finAccountDescription,\n459->            rule.cr_segment1,\n460->            rule.cr_segment2,\n461->            rule.cr_segment3,\n462->            rule.cr_segment4,\n463->            rule.cr_segment5,\n464->            rule.cr_segment6,\n465->            rule.cr_segment7,\n466->            rule.cr_segment8,\n467->  