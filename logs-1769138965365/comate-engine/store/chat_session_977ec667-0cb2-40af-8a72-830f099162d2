an.util.LoanConstants.BILL_CATEGORY_NOTEREC;\nimport static com.baidu.tms.loan.util.LoanConstants.CFT;\nimport static com.baidu.tms.loan.util.LoanConstants.DIRECT_LOAN;\nimport static com.baidu.tms.loan.util.LoanConstants.EVENT_STATUS_APPROVED;\nimport static com.baidu.tms.loan.util.LoanConstants.EVENT_STATUS_PRE_APPROVED;\nimport static com.baidu.tms.loan.util.LoanConstants.EVENT_STATUS_REJECTED;\nimport static com.baidu.tms.loan.util.LoanConstants.FX;\nimport static com.baidu.tms.loan.util.LoanConstants.IFT;\nimport static com.baidu.tms.loan.util.LoanConstants.INTERCOMPANY_INTEREST_ACCRUAL;\nimport static com.baidu.tms.loan.util.LoanConstants.LOAN_GL_APPROVE_STATUS_P;\nimport static com.baidu.tms.loan.util.LoanConstants.LOAN_GL_APPROVE_STATUS_R;\nimport static com.baidu.tms.loan.util.LoanConstants.LOAN_GL_APPROVE_STATUS_REVIEW;\nimport static com.baidu.tms.loan.util.LoanConstants.LOAN_GL_APPROVE_STATUS_Y;\nimport static com.baidu.tms.loan.util.LoanConstants.LOAN_GL_CREATED_STATUS_APPROVED;\nimport static com.baidu.tms.loan.util.LoanConstants.LOAN_GL_DIRECTION_CR;\nimport static com.baidu.tms.loan.util.LoanConstants.LOAN_GL_DIRECTION_DR;\nimport static com.baidu.tms.loan.util.LoanConstants.THIRD_ACCOUNT_BALANCE;\nimport static com.baidu.tms.loan.util.LoanConstants.THIRD_ACCOUNT_TRANS;\nimport static com.baidu.tms.loan.util.LoanConstants.THIRD_ACCOUNT_TRANS_SUMMARY;\n\n@Service\n@Slf4j\npublic class ApprovalFundVoucherServiceImpl implements ApprovalFundVoucherService {\n\n    @Autowired\n    private FundTransferBookkeepingService bookkeepingService;\n\n    @Autowired\n    private TmsLoanAccountDAO loanAccountDAO;\n\n    @Autowired\n    private FndFlexValueApi fndFlexValueApi;\n\n    @Autowired\n    private TransactionTypeService transactionTypeService;\n\n    @Autowired\n    private LoanAccountService loanAccountService;\n\n    @Autowired\n    private FundTransferService fundTransferService;\n\n    @Autowired\n    private TmsLoanAccountHeaderDAO loanAccountHeaderDAO;\n\n    @Autowired\n    private TmsLoanAccountHeaderHisDAO hisDAO;\n\n    @Autowired\n    private TmsEventProcessService processService;\n\n    @Autowired\n    private DealInterestAccrualService interestAccrualService;\n\n    @Autowired\n    private LoanAccountHeaderDao accountHeaderDao;\n\n    @Autowired\n    private CommonAttachmentDAO attachmentDAO;\n\n    @Autowired\n    private LoanInterestAccrualService loanInterestAccrualService;\n\n    @Autowired\n    private LoanEventConfirmService loanEventConfirmService;\n\n    @Autowired\n    private IfrsFairvalueChangeService changeService;\n\n    @Autowired\n    private DealProductNetvalueService productNetvalueService;\n\n    @Autowired\n    private BpmApprovalRecordsApi bpmApprovalRecordsApi;\n\n    @Autowired\n    private FndFlexValueDAO fndFlexValueDAO;\n\n    @Autowired\n    private ThirdAccountEndBalanceService balanceService;\n\n    @Autowired\n    private ThirdTransAccountingService thirdTransAccountingService;\n\n    @Autowired\n    private ThirdTansSummaryCommonService summaryCommonService;\n\n    @Autowired\n    private UploadAttachService uploadAttachService;\n\n    @Autowired\n    private BillEventService billEventService;\n\n    @Autowired\n    private ForeignExchangeService foreignExchangeService;\n\n    @Value(\"${uuap.serverName}\")\n    private String serverName;\n\n    @Autowired\n    private HrStorePersonService hrStorePersonService;\n\n    private static final String SPOT = \".\";\n    private static final String SPOT_DESC = \"-\";\n    private static final String SEGMENT_NAME = \"缺省\";\n\n    @Override\n    public Map<String, Object> getSelectInit() {\n        HashMap<String, Object> dic = new HashMap<>();\n        dic.put(\"approveStatus\", bookkeepingService.getFndFlexSetSelectDTOsFor(BizConstants.FndFlexSet\n                .TMS_GL_APPROVAL_STATUS));\n        dic.put(\"currency\", bookkeepingService.getRoleCurrency(BizConstants.FndFlexSet.TMS_CURRENCY));\n        dic.putAll(getDicInit());\n        return dic;\n    }\n\n    @Override\n    public HashMap<String, Object> getDicInit() {\n        HashMap<String, Object> dic = new HashMap<>();\n        // 交易类别\n        List<FndFlexValueDTO> trscodDTOS = fndFlexValueApi.selectByTypeAll(BizConstants.FndFlexSet.TMS_DEAL_TYPE);\n        List<CodedLabel> ruleTrscod = new ArrayList<>();\n        trscodDTOS.stream().forEach(trscodDTO -> {\n            ruleTrscod.add(new CodedLabel(trscodDTO));\n        });\n        dic.put(\"ruleTrscod\", ruleTrscod);\n\n        // 交易类型\n        RuleTrsType trsType = null;\n        List<SelectDTO> selectDTOS = null;\n        List<RuleTrsType> ruleTrsTypes = new ArrayList<>();\n        // 获取当前用户有权限的交易类型\n        List<String> roleTransactionType = bookkeepingService.getValue(LINE_TRANSACTION_TYPE);\n        // 交易类型(交易类别和交易设置中的查找集一一对应，这里遍历交易类别即可)\n        for (CodedLabel trscod : ruleTrscod) { // 遍历交易类型取交易类型设置\n            trsType = new RuleTrsType();\n            selectDTOS = getTransactionType(trscod.getCode()); // 获取交易类别下的交易类型\n            trsType.setTrscod(trscod.getCode());\n            if (CollectionUtils.isNotEmpty(roleTransactionType)) {\n                // 获取当前用户交易类别下有权限的交易类型\n                List<SelectDTO> roleType = selectDTOS.stream().filter(dto -> roleTransactionType\n                        .contains(dto.getValue())).collect(Collectors.toList());\n                trsType.setTrstype(roleType);\n                ruleTrsTypes.add(trsType);\n            }\n        }\n        dic.put(\"ruleTrstype\", ruleTrsTypes);\n\n        // 记账类型\n        List<FndFlexValueDTO> actcodDTOS = fndFlexValueApi.selectByTypeAll(BizConstants.FndFlexSet.TMS_DEAL_ACC_TYPE);\n        List<CodedLabel> ruleActcod = new ArrayList<>();\n        actcodDTOS.stream().forEach(actcodDTO -> {\n            ruleActcod.add(new CodedLabel(actcodDTO.getCode(), actcodDTO.getDescription()));\n        });\n        dic.put(\"ruleActcod\", ruleActcod);\n\n        // 事件交易类型\n        List<RuleEntCod> ruleEntCods = new ArrayList<>();\n        RuleEntCod entCod = null;\n        List<CodeDesc> ruleEntCod1 = new ArrayList<>();\n        List<CodeDesc> ruleEntCod2 = new ArrayList<>();\n        List<FndFlexValueDTO> entcodDTOS = null;\n        for (CodedLabel actcod : ruleActcod) { // 这里按照记账类型只有2种处理\n\n            if (StringUtils.equals(actcod.getDispLabel(), \"交易事件记账\")) {\n                entCod = new RuleEntCod();\n                // 记账类型\n                entCod.setActcod(actcod.getCode());\n                entcodDTOS = fndFlexValueApi.selectByTypeAll(BizConstants.FndFlexSet.TMS_DEAL_TRASACTIONTYPE);\n                entcodDTOS.stream().forEach(entcodDTO -> {\n                    ruleEntCod1.add(new CodeDesc(entcodDTO));\n                });\n                // 事件类型\n                entCod.setRuleEntcod(ruleEntCod1);\n                ruleEntCods.add(entCod);\n            }\n            if (StringUtils.equals(actcod.getDispLabel(), \"会计事件记账\")) {\n                entCod = new RuleEntCod();\n                entCod.setActcod(actcod.getCode());\n                entcodDTOS = fndFlexValueApi.selectByTypeAll(BizConstants.FndFlexSet.TMS_DEAL_ACCEVENTTYPE);\n                entcodDTOS.stream().forEach(entcodDTO -> {\n                    ruleEntCod2.add(new CodeDesc(entcodDTO));\n                });\n                // 事件类型\n                entCod.setRuleEntcod(ruleEntCod2);\n                ruleEntCods.add(entCod);\n            }\n        }\n        dic.put(\"ruleEntCod\", ruleEntCods);\n\n        return dic;\n    }\n\n    /**\n     * 获取交易类型下拉列表\n     *\n     * @return\n     */\n    public List<SelectDTO> getTransactionType(String payType) {\n        List<TmsTransactionType> transactionTypes = transactionTypeService.getAllSimpleTransactionTypes(payType);\n        List<SelectDTO> selectDTOS = new ArrayList<>(transactionTypes.size());\n        transactionTypes.forEach(type -> selectDTOS.add(new SelectDTO(type.getTransCode(), type.getTransName())));\n        return selectDTOS;\n    }\n\n    @Override\n    public List<ApproveFundVoucherDTO> fundVoucherSuggest(ApproveFundVoucherQueryDTO queryDTO) {\n        PageParams pageParams = new PageParams(queryDTO.getPage(), queryDTO.getPageSize());\n        // 判断是否分页\n        if (pageParams != null && pageParams.getPage() > 0 && pageParams.getPageSize() > 0) {\n            PageHelper.startPage(pageParams.getPage(), pageParams.getPageSize());\n        }\n        List<ApproveFundVoucherDTO> results = new ArrayList<>();\n        List<String> uuapList = hrStorePersonService.listPerson(queryDTO.getCreatedBy());\n        uuapList.forEach(item -> {\n            ApproveFundVoucherDTO voucherDTO = new ApproveFundVoucherDTO();\n            voucherDTO.setAccountCreatedBy(item);\n            results.add(voucherDTO);\n        });\n        return results;\n\n        // TmsLoanAccountHeaderExample example = new TmsLoanAccountHeaderExample();\n        // TmsLoanAccountHeaderExample.Criteria criteria = example.createCriteria();\n        // if (StringUtils.isNotBlank(queryDTO.getRequestNumber())) {\n        //     criteria.andRequestNumberLike(\"%\" + queryDTO.getRequestNumber() + \"%\");\n        // }\n        // if (StringUtils.isNotBlank(queryDTO.getCreatedBy())) {\n        //     criteria.andAccountCreatedByLike(\"%\" + queryDTO.getCreatedBy() + \"%\");\n        // }\n        // List<TmsLoanAccountHeader> accountHeaders = loanAccountHeaderDAO.selectByExample(example);\n        // PageInfo<TmsLoanAccountHeader> headerPageInfo = new PageInfo<>(accountHeaders);\n        // PageInfo<ApproveFundVoucherDTO> dtoPageInfo = new PageInfo<>();\n        // UtilType.copyProperties(dtoPageInfo, headerPageInfo);\n        // List<ApproveFundVoucherDTO> dtoList = new ArrayList<>();\n        // for (TmsLoanAccountHeader account : accountHeaders) {\n        //     ApproveFundVoucherDTO voucherDTO = new ApproveFundVoucherDTO();\n        //     BeanUtils.copyProperties(account, voucherDTO);\n        //     dtoList.add(voucherDTO);\n        // }\n        // dtoPageInfo.setList(dtoList);\n        // return dtoPageInfo.getList();\n    }\n\n    @Override\n    public PageInfo<ApproveFundVoucherDTO> selectFundVoucher(ApproveFundVoucherQueryDTO queryDTO) {\n        PageParams pageParams = new PageParams(queryDTO.getPage(), queryDTO.getPageSize());\n        // 判断是否分页\n        if (pageParams != null && pageParams.getPage() > 0 && pageParams.getPageSize() > 0) {\n            PageHelper.startPage(pageParams.getPage(), pageParams.getPageSize());\n        }\n        queryDTO.setUserName(SessionUtils.getSessionUser().getUsername());\n        List<ApproveFundVoucherDTO> tmsLoanAccountHeaders = accountHeaderDao.selectVoucherByCondition(queryDTO);\n        PageInfo<ApproveFundVoucherDTO> pageInfo = new PageInfo<>(tmsLoanAccountHeaders);\n        Map<String, String> codeAndNamePairs = transactionTypeService.getTransactionTypeAllMap();\n        for (ApproveFundVoucherDTO voucherDTO : tmsLoanAccountHeaders) {\n            voucherDTO.setTrxTypeName(codeAndNamePairs.get(voucherDTO.getTrxType()));\n        }\n        fndFlexValueApi.translate(pageInfo.getList(), \"segment1\", BizConstants.FndFlexSet.BD_COMPANY,\n                \"eventType\", BizConstants.FndFlexSet.TMS_DEAL_TRASACTIONTYPE, \"trxCurrencyCode\", BizConstants\n                        .FndFlexSet.TMS_CURRENCY, \"approveStatus\", BizConstants.FndFlexSet.TMS_GL_APPROVAL_STATUS);\n        return pageInfo;\n    }\n\n    @Override\n    @Transactional(rollbackFor = Exception.class)\n    public JsonResult<?> fundVoucherAudit(ApproveFundVoucherQueryDTO queryDTO, boolean firstAudit) {\n        List<String> headerIdList = queryDTO.getHeaderIdList();\n        // 1、校验\n        if (Collections3.isEmpty(headerIdList)) {\n            return JsonResult.failJsonResult(\"日记账头id不允许为空\");\n        }\n        TmsLoanAccountExample example = new TmsLoanAccountExample();\n        TmsLoanAccountExample.Criteria criteria = example.createCriteria();\n        criteria.andAttribute3In(headerIdList);\n        List<TmsLoanAccount> tmsLoanAccounts = loanAccountDAO.selectByExample(example);\n        if (Collections3.isEmpty(tmsLoanAccounts)) {\n            return JsonResult.failJsonResult(\"凭证不存在\");\n        }\n        String msg = this.checkStatus(headerIdList, tmsLoanAccounts, firstAudit);\n        if (StringUtils.isNotBlank(msg)) {\n            return JsonResult.failJsonResult(msg);\n        }\n\n        // 区分初审&复审操作\n        if (firstAudit) {\n            // 初审操作，看那些类型需要复审\n            List<FndFlexValueDTO> flexValueDTOS = fndFlexValueApi.selectByType(TMS_REGISTERED_CAPITAL);\n            List<String> reviewAuditCode = Lists.newArrayList();\n            if (CollectionUtils.isNotEmpty(flexValueDTOS)) {\n                reviewAuditCode = flexValueDTOS.stream().map(FndFlexValueDTO::getCode).collect(Collectors.toList());\n            }\n            List<TmsLoanAccount> firstAuditList = Lists.newArrayList();\n            List<TmsLoanAccount> finalAuditList = Lists.newArrayList();\n            for (TmsLoanAccount loanAccount : tmsLoanAccounts) {\n                if (reviewAuditCode.contains(loanAccount.getTrxType())) {\n                    firstAuditList.add(loanAccount);\n                } else {\n                    finalAuditList.add(loanAccount);\n                }\n            }\n            this.firstAudit(firstAuditList, queryDTO);\n            this.finalAudit(finalAuditList, queryDTO, true);\n\n        } else {\n            // 最终审核完成\n            this.finalAudit(tmsLoanAccounts, queryDTO, true);\n        }\n\n        return JsonResult.okJsonResultWithData(\"操作成功\");\n    }\n\n    /**\n     * 校验操作单据状态\n     *\n     * @param headerIdList\n     * @param tmsLoanAccounts\n     * @param firstAudit\n     * @return\n     */\n    private String checkStatus(List<String> headerIdList,\n                               List<TmsLoanAccount> tmsLoanAccounts,\n                               boolean firstAudit) {\n        Optional<TmsLoanAccount> first = tmsLoanAccounts.stream().filter(\n                t -> LOAN_GL_APPROVE_STATUS_P.equals(t.getApproveStatus())).findFirst();\n        if (!first.isPresent()) {\n            return \"有凭证状态不符合审批要求，请确认后重试\";\n        }\n        //  初审校验所有状态（凭证头）都为审批(初审)中\n        //  复审校验所有状态（凭证头）都为复审中\n        List<Long> headerIds = headerIdList.stream().map(s -> Long.parseLong(s.trim())).collect(Collectors.toList());\n        TmsLoanAccountHeaderExample headerExample = new TmsLoanAccountHeaderExample();\n        TmsLoanAccountHeaderExample.Criteria criteria1 =\n                headerExample.createCriteria().andAccountHeaderIdIn(headerIds);\n        if (firstAudit) {\n            criteria1.andApproveStatusEqualTo(LOAN_GL_APPROVE_STATUS_P);\n        } else {\n            criteria1.andApproveStatusEqualTo(LOAN_GL_APPROVE_STATUS_REVIEW);\n        }\n        List<TmsLoanAccountHeader> headerList = loanAccountHeaderDAO.selectByExample(headerExample);\n        if (CollectionUtils.isEmpty(headerList) || headerIds.size() != headerList.size()) {\n            return \"凭证审批信息不存在或凭证状态不允许审批,请检查后重新审批\";\n        }\n        return null;\n    }\n\n    /**\n     * 初审通过（只修改凭证审核状态为复审中，增加审核记录，其余不变，走下一级审批）\n     *\n     * @param tmsLoanAccounts\n     * @param queryDTO\n     */\n    private void firstAudit(List<TmsLoanAccount> tmsLoanAccounts, ApproveFundVoucherQueryDTO queryDTO) {\n        if (CollectionUtils.isEmpty(tmsLoanAccounts)) {\n            return;\n        }\n        // 修改凭证头信息状态\n        Set<String> headerIdList = tmsLoanAccounts.stream()\n                .map(TmsLoanAccount::getAttribute3).collect(Collectors.toSet());\n        Map<String, List<TmsLoanAccount>> accountByHeaderId = tmsLoanAccounts.stream().collect(Collectors\n                .groupingBy(TmsLoanAccount::getAttribute3));\n        for (String id : headerIdList) {\n            List<TmsLoanAccount> accounts = accountByHeaderId.get(id);\n            TmsLoanAccountHeader header = new TmsLoanAccountHeader();\n            header.setAccountHeaderId(Long.valueOf(id));\n            header.setApproveStatus(LOAN_GL_APPROVE_STATUS_REVIEW);\n            loanAccountHeaderDAO.updateByPrimaryKeySelective(header);\n            header.setTrxType(accounts.get(0).getTrxType());\n            loanAccountService.saveAccountHis(header, EVENT_STATUS_PRE_APPROVED, queryDTO.getRemark());\n        }\n    }\n\n    /**\n     * 最终审核（审批完成、推送主库、回写原始单据审批完成状态）\n     * 1、初审即最终审核（初审对应的单据交易类型不在复审值集中）\n     * 2、复审\n     *\n     * @param tmsLoanAccounts\n     * @param queryDTO\n     * @param insertHisFlag\n     */\n    private void finalAudit(List<TmsLoanAccount> tmsLoanAccounts, ApproveFundVoucherQueryDTO queryDTO,\n                            boolean insertHisFlag) {\n        if (CollectionUtils.isEmpty(tmsLoanAccounts)) {\n            return;\n        }\n        List<Long> idList = tmsLoanAccounts.stream().map(TmsLoanAccount::getAccountId).collect(Collectors.toList());\n        Set<String> headerIdList = tmsLoanAccounts.stream()\n                .map(TmsLoanAccount::getAttribute3).collect(Collectors.toSet());\n\n        // 1、修改分录状态\n        TmsLoanAccountExample example = new TmsLoanAccountExample();\n        TmsLoanAccountExample.Criteria criteria = example.createCriteria();\n        criteria.andAccountIdIn(idList);\n        TmsLoanAccount tmsLoanAccount = new TmsLoanAccount();\n        tmsLoanAccount.setApproveStatus(LOAN_GL_APPROVE_STATUS_Y);\n        tmsLoanAccount.setAttribute1(SessionUtils.getSessionUser().getUsername()); // 审批人\n        tmsLoanAccount.setAttribute2(SessionUtils.getSessionUser().getUsername());\n        tmsLoanAccount.setLastUpdatedBy(SessionUtils.getSessionUser().getUsername());\n        tmsLoanAccount.setLastUpdateDate(new Date());\n        loanAccountDAO.updateByExampleSelective(tmsLoanAccount, example);\n\n        // 2、修改凭证头信息状态\n        Map<String, List<TmsLoanAccount>> accountByHeaderId = tmsLoanAccounts.stream().collect(Collectors\n                .groupingBy(TmsLoanAccount::getAttribute3));\n        for (String id : headerIdList) {\n            List<TmsLoanAccount> accounts = accountByHeaderId.get(id);\n            TmsLoanAccountHeader header = new TmsLoanAccountHeader();\n            header.setAccountHeaderId(Long.valueOf(id));\n            header.setApproveStatus(LOAN_GL_APPROVE_STATUS_Y);\n            loanAccountHeaderDAO.updateByPrimaryKeySelective(header);\n            header.setTrxType(accounts.get(0).getTrxType());\n            if (insertHisFlag) {\n                loanAccountService.saveAccountHis(header, EVENT_STATUS_APPROVED, queryDTO.getRemark());\n            }\n        }\n\n        // 3、审批后修改原始单据状态\n        Map<String, List<TmsLoanAccount>> loanMaps =\n                tmsLoanAccounts.stream().collect(Collectors.groupingBy(TmsLoanAccount::getApproveBatchId));\n        for (String batchId : loanMaps.keySet()) {\n            List<TmsLoanAccount> accounts = loanMaps.get(batchId);\n            if (CollectionUtils.isEmpty(accounts)) {\n                return;\n            }\n            this.handleSourceBillStatus(accounts, LOAN_GL_CREATED_STATUS_APPROVED);\n        }\n\n        // 4、推送主库\n        Map<String, List<TmsLoanAccount>> accountByBatchId = tmsLoanAccounts.stream().collect(Collectors\n                .groupingBy(TmsLoanAccount::getApproveBatchId));\n        accountByBatchId.entrySet().forEach(entry -> {\n            loanAccountService.sendLoanAccountToGLbyBSD(entry.getKey(), entry.getValue().size());\n        });\n    }\n\n    /**\n     * 更新原始单据状态为审批通过、审批拒绝（保存）\n     *\n     * @param tmsLoanAccounts\n     * @param status\n     */\n    private void handleSourceBillStatus(List<TmsLoanAccount> tmsLoanAccounts, String status) {\n        if (CollectionUtils.isEmpty(tmsLoanAccounts)) {\n            return;\n        }\n        switch (tmsLoanAccounts.get(0).getTrxCategory()) {\n\n            case CFT:\n                // fall through to case IFT\n            case IFT:\n                // 修改划拨单分录状态\n                fundTransferService.updateApproveStatus(tmsLoanAccounts.get(0).getEventId(), status);\n                break;\n            case DEAL_TYPE_TERMDEPOSIT:\n                // fall through to case DEAL_TYPE_CURRFINANCING\n            case DEAL_TYPE_NOTICEDEPOSIT:\n                // fall through to case DEAL_TYPE_CURRFINANCING\n            case DEAL_TYPE_TERMFINANCING:\n                // fall through to case DEAL_TYPE_CURRFINANCING\n            case DEAL_TYPE_CURRFINANCING:\n            case DEAL_TYPE_BANKLOAN:\n            case BILLFINANCING:\n            case DEAL_TYPE_MONEYMARKET:\n                // 修改投资理财分录状态（区分交易事件+计提利息）\n                if (LoanConstants.LOAN_ACCOUNT_TYPE_TRX.equals(tmsLoanAccounts.get(0).getAccountType())) {\n                    DealEventProcessDTO dto = new DealEventProcessDTO();\n                    List<Long> eventIds = tmsLoanAccounts.stream().map(TmsLoanAccount::getEventId)\n                            .collect(Collectors.toList())\n                            .stream().distinct().collect(Collectors.toList());\n                    eventIds.forEach(id -> {\n                        dto.setAccountingStatus(status);\n                        dto.setEventId(id);\n                        // 更新理财交易事件分录状态  已提交\n                        processService.updateAccountingStatus(dto);\n                    });\n                }\n                // 如果是重分类事件，则更新interestAccrualService\n                if (LoanConstants.TMS_DEAL_ACCEVENTTYPE_A07.equals(tmsLoanAccounts.get(0).getEventType())) {\n                    // 投资理财计提利息\n                    DealInterestAccrualDTO dto = new DealInterestAccrualDTO();\n                    dto.setAccountStatus(status);\n                    dto.setAccrualId(tmsLoanAccounts.get(0).getAccrualId());\n                    interestAccrualService.updateAccountingStatus(dto);\n                }\n                break;\n            case DEAL_INTEREST_ACCRUAL:\n                // 投资理财计提利息\n                DealInterestAccrualDTO dto = new DealInterestAccrualDTO();\n                dto.setAccountStatus(status);\n                dto.setAccrualId(tmsLoanAccounts.get(0).getAccrualId());\n                interestAccrualService.updateAccountingStatus(dto);\n                break;\n            case DIRECT_LOAN:\n                // 修改公司间借款分录状态（区分交易事件+计提利息）\n                if (LoanConstants.LOAN_ACCOUNT_TYPE_TRX.equals(tmsLoanAccounts.get(0).getAccountType())) {\n                    // 更新公司间借款交易事件状态\n                    LoanEventDTO eventDTO = new LoanEventDTO();\n                    List<Long> eventIds = tmsLoanAccounts.stream().map(TmsLoanAccount::getEventId)\n                            .collect(Collectors.toList())\n                            .stream().distinct().collect(Collectors.toList());\n                    eventIds.forEach(id -> {\n                        eventDTO.setAccountStatus(status);\n                        eventDTO.setEventId(id);\n                        // 更新公司间借款交易事件分录状态  已提交\n                        loanEventConfirmService.updateAccountingStatus(eventDTO);\n                    });\n                }\n                break;\n            case INTERCOMPANY_INTEREST_ACCRUAL:\n                // 公司间借款计提利息\n                DealInterestAccrualDTO accrualDTO = new DealInterestAccrualDTO();\n                accrualDTO.setAccountStatus(status);\n                accrualDTO.setAccrualId(tmsLoanAccounts.get(0).getAccrualId());\n                loanInterestAccrualService.updateAccountingStatus(accrualDTO);\n                break;\n            case DealTypeConstants.DEAL_IFRS_FAIRVALUE:\n                // 投资理财IFRS核算\n                DealIfrsFairvalueDTO fairvalueDTO = new DealIfrsFairvalueDTO();\n                fairvalueDTO.setAccountingStatus(status);\n                fairvalueDTO.setFairId(tmsLoanAccounts.get(0).getAccrualId());\n                changeService.updateAccountingStatus(fairvalueDTO);\n                break;\n            case DEAL_PRODUCT_NETVALUE:\n                // 净值理财\n                DealProductNetvalueDTO netvalueDTO = new DealProductNetvalueDTO();\n                netvalueDTO.setAccountingStatus(status);\n                netvalueDTO.setId(tmsLoanAccounts.get(0).getAccrualId());\n                productNetvalueService.updateAccountingStatus(netvalueDTO, DealNetvalueEnum.OPERATE_APPROVAL_REJECT);\n                break;\n            case THIRD_ACCOUNT_TRANS:\n                // 修改第三方流水\n                TmsLoanAccount loanAccount = tmsLoanAccounts.get(0);\n                thirdTransAccountingService.updateAccountingStatus(loanAccount.getAttribute3(), null, status);\n                break;\n            case THIRD_ACCOUNT_BALANCE:\n                // 修改第三方余额结转\n                balanceService.updateAccountingStatus(tmsLoanAccounts.get(0).getEventId(), status);\n                break;\n            case THIRD_ACCOUNT_TRANS_SUMMARY:\n                // 修改第三方流水汇总\n                TmsLoanAccount account = tmsLoanAccounts.get(0);\n                summaryCommonService.updateAccountingStatusByHeaderId(Long.valueOf(account.getAttribute3()), status);\n                break;\n            case BILL_CATEGORY_NOTEREC:\n                // 更新应收票据交易事件状态\n                TmsBillTrxEvent eventDTO = new TmsBillTrxEvent();\n                List<Long> eventIds = tmsLoanAccounts.stream().map(TmsLoanAccount::getEventId)\n                        .distinct().collect(Collectors.toList());\n                eventIds.forEach(id -> {\n                    eventDTO.setAccountingStatus(status);\n                    eventDTO.setEventId(id);\n                    // 更新应收票据交易事件状态\n                    billEventService.updateAccountingStatus(eventDTO);\n                });\n\n                break;\n            case FX:\n                this.updateForeignStatus(tmsLoanAccounts, status);\n                break;\n            default:\n                throw new WebException(\"会计分录交易类别:\" + tmsLoanAccounts.get(0).getTrxCategory() + \" 有误,操作失败\");\n        }\n    }\n\n    public void updateForeignStatus(List<TmsLoanAccount> tmsLoanAccounts, String status) {\n        ForeignExchangeDTO foreignEventDTO = new ForeignExchangeDTO();\n        List<Long> foreignEventIds = tmsLoanAccounts.stream().map(TmsLoanAccount::getEventId)\n                .distinct().collect(Collectors.toList());\n        foreignEventIds.forEach(id -> {\n            foreignEventDTO.setAccountingStatus(status);\n            foreignEventDTO.setId(id);\n            foreignExchangeService.updateAccountingStatus(foreignEventDTO);\n        });\n    }\n\n    @Override\n    @Transactional(rollbackFor = Exception.class)\n    public JsonResult<?> fundVoucherReject(ApproveFundVoucherQueryDTO queryDTO, boolean insertHisFlag) {\n        String accountHeaderId = queryDTO.getAccountHeaderId();\n        if (accountHeaderId == null || StringUtils.isBlank(queryDTO.getRemark())) {\n            return JsonResult.failJsonResult(\"日记账头id和拒绝原因不允许为空\");\n        }\n        TmsLoanAccountExample example = new TmsLoanAccountExample();\n        TmsLoanAccountExample.Criteria criteria = example.createCriteria();\n        criteria.andAttribute3EqualTo(accountHeaderId);\n        List<TmsLoanAccount> tmsLoanAccounts = loanAccountDAO.selectByExample(example);\n        if (Collections3.isEmpty(tmsLoanAccounts)) {\n            return JsonResult.failJsonResult(\"凭证不存在\");\n        }\n        if (!StringUtils.equals(tmsLoanAccounts.get(0).getApproveStatus(), LOAN_GL_APPROVE_STATUS_P)) {\n            return JsonResult.failJsonResult(\"有凭证状态不符合审批要求，请确认后重试\");\n        }\n        // 修改日记账审批状态\n        TmsLoanAccount tmsLoanAccount = new TmsLoanAccount();\n        tmsLoanAccount.setApproveStatus(LOAN_GL_APPROVE_STATUS_R);\n        tmsLoanAccount.setLastUpdatedBy(SessionUtils.getSessionUser().getUsername());\n        tmsLoanAccount.setLastUpdateDate(new Date());\n        loanAccountDAO.updateByExampleSelective(tmsLoanAccount, example);\n\n        // 更新原始单据状态\n        this.handleSourceBillStatus(tmsLoanAccounts, LoanConstants.LOAN_GL_CREATED_STATUS_Y);\n\n        // 删除批上关联的附件\n        List<String> batchNums = tmsLoanAccounts.stream().filter(t -> StringUtils.isNotBlank(t.getImpBatchNum()))\n                .map(TmsLoanAccount::getImpBatchNum).collect(Collectors.toList());\n        List<String> attachBizTypeList = Arrays.asList(TRANSFER_ACCOUNT_ATTACH.getValue());\n        if (CollectionUtils.isNotEmpty(batchNums)) {\n            for (String impBatchNum : batchNums) {\n                attachmentDAO.batchDeleteByPkAndTypes(attachBizTypeList, impBatchNum);\n            }\n        }\n\n        // 修改记账头状态\n        TmsLoanAccountHeader header = new TmsLoanAccountHeader();\n        header.setAccountHeaderId(Long.valueOf(accountHeaderId));\n        header.setApproveStatus(LOAN_GL_APPROVE_STATUS_R);\n        loanAccountHeaderDAO.updateByPrimaryKeySelective(header);\n        // 保存日记账头操作的历史记录\n        if (insertHisFlag) {\n            header.setTrxType(tmsLoanAccounts.get(0).getTrxType());\n            loanAccountService.saveAccountHis(header, EVENT_STATUS_REJECTED, queryDTO.getRemark());\n        }\n        return JsonResult.okJsonResultWithData(\"操作成功\");\n    }\n\n    @Override\n    public Map<String, Object> selectFundVoucherByHeaderId(ApproveFundVoucherQueryDTO queryDTO) {\n        if (queryDTO.getAccountHeaderId() == null) {\n            throw new ServiceException(\"日记账头id不允许为空\");\n        }\n        Map<String, Object> resultMap = new HashMap<>();\n        TmsLoanAccountExample example = new TmsLoanAccountExample();\n        TmsLoanAccountExample.Criteria criteria = example.createCriteria();\n        criteria.andAttribute3EqualTo(queryDTO.getAccountHeaderId());\n        List<ApproveFundVoucherDTO> voucherDTOS = new ArrayList<>();\n        List<TmsLoanAccount> tmsLoanAccounts = loanAccountDAO.selectByExample(example);\n\n        List<String> dealCategoryList = Arrays.asList(TrxCategoryEnum.CATEGORY_THIRD_TRANS.getCode(),\n                TrxCategoryEnum.CATEGORY_THIRD_BALANCE.getCode(),\n                TrxCategoryEnum.THIRD_ACCOUNT_TRANS_SUMMARY.getCode());\n        for (TmsLoanAccount account : tmsLoanAccounts) {\n            ApproveFundVoucherDTO voucherDTO = new ApproveFundVoucherDTO();\n            BeanUtils.copyProperties(account, voucherDTO);\n            voucherDTO.setAttribute3(queryDTO.getAccountHeaderId());\n            if (StringUtils.equals(account.getDirection(), LOAN_GL_DIRECTION_DR)) {\n                voucherDTO.setAccountedDr(account.getAccounted());\n            } else if (StringUtils.equals(account.getDirection(), LOAN_GL_DIRECTION_CR)) {\n                voucherDTO.setAccountedCr(account.getAccounted());\n            }\n            if (StringUtils.equals(YesOrNo.yes(), account.getManCreated())) {\n                voucherDTO.setManCreatedName(\"人工\");\n            } else {\n                voucherDTO.setManCreatedName(\"系统\");\n            }\n            if (account.getExchangeRate() != null) {\n                voucherDTO.setExchangeRateStr(account.getExchangeRate().stripTrailingZeros().toPlainString());\n            }\n            voucherDTO.setSegmentInfo(account.getSegment1() + SPOT + account.getSegment2() + SPOT + account\n                    .getSegment3() + SPOT + account.getSegment4() + SPOT + account.getSegment5() + SPOT + account\n                    .getSegment6() + SPOT + account.getSegment7() + SPOT + account.getSegment8());\n\n            if (dealCategoryList.contains(account.getTrxCategory())) {\n                voucherDTO.setAccountNo(account.getRequestNumber());\n                // todo 临时方案(requestNumber应设置账户，临时取不到 先从批次中取一次)\n                if (StringUtils.isBlank(voucherDTO.getAccountNo())) {\n                    voucherDTO.setAccountNo(account.getJeBatchName().split(\"-\")[2]);\n                }\n            }\n            voucherDTOS.add(voucherDTO);\n        }\n\n        TmsLoanAccountHeader header =\n                loanAccountHeaderDAO.selectByPrimaryKey(Long.valueOf(queryDTO.getAccountHeaderId()));\n\n        if (dealCategoryList.contains(header.getTrxCategory())) {\n\n            ApproveFundVoucherDTO headerDTO = new ApproveFundVoucherDTO();\n            headerDTO.setAccountHeaderId(header.getAccountHeaderId());\n            headerDTO.setSegment1(header.getSegment1());\n            headerDTO.setAccountPeriod(header.getAccountPeriod());\n            headerDTO.setTrxCurrencyCode(header.getTrxCurrencyCode());\n            headerDTO.setTrxCategory(header.getTrxCategory());\n            headerDTO.setApproveStatus(header.getApproveStatus());\n            headerDTO.setApproveBatchId(header.getApproveBatchId());\n            headerDTO.setCompanySob(header.getSegment1());\n            headerDTO.setTrxCategoryName(TrxCategoryEnum.getAllMap().get(header.getTrxCategory()));\n            headerDTO.setSourceName(BizConstants.SOURCE_TMS_NAME);\n            fndFlexValueApi.translate(headerDTO, \"segment1\", BizConstants.FndFlexSet.BD_COMPANY,\n                    \"trxCurrencyCode\", BizConstants.FndFlexSet.TMS_CURRENCY,\n                    \"companySob\", BizConstants.FndFlexSet.COM_OU_SOB);\n\n            resultMap.put(\"accountHeader\", headerDTO);\n            // 第三方流水/余额入账逻辑\n            fndFlexValueApi.translate(voucherDTOS, \"segment1\", BizConstants.FndFlexSet.BD_COMPANY,\n                    \"segment2\", BizConstants.FndFlexSet.BD_DEPARTMENT,\n                    \"segment3\", BizConstants.FndFlexSet.BD_ACCOUNT,\n                    \"segment4\", BizConstants.FndFlexSet.BD_PRODUCT,\n                    \"segment5\", BizConstants.FndFlexSet.BD_INTERCOMPANY,\n                    \"segment6\", BizConstants.FndFlexSet.BD_PROJECT,\n                    \"segment7\", BizConstants.FndFlexSet.BD_SPARE1,\n                    \"segment8\", BizConstants.FndFlexSet.BD_SPARE2,\n                    \"eventType\", BizConstants.FndFlexSet.TMS_JOURNAL_CLASS,\n                    \"trxCurrencyCode\", BizConstants.FndFlexSet.TMS_CURRENCY,\n                    \"approveStatus\", BizConstants.FndFlexSet.TMS_GL_APPROVAL_STATUS,\n                    \"trxType\", BizConstants.FndFlexSet.TMS_TRANSACTION_TYPE);\n            resultMap.put(\"loanAccounts\", voucherDTOS);\n\n            // 历史记录\n            List<ProcessRecordDTO> bpmHistory = getProcessRecords(queryDTO.getAccountHeaderId());\n            resultMap.put(\"loanAccountHis\", bpmHistory);\n\n            List<ThirdApprovalTrscodSummaryDTO> summaryList =\n                    thirdTransAccountingService.getTransTypeSummaryData(header);\n            resultMap.put(\"summaryList\", summaryList);\n        } else {\n            fndFlexValueApi.translate(voucherDTOS, \"segment1\", BizConstants.FndFlexSet.BD_COMPANY, \"segment3\",\n                    BizConstants.FndFlexSet.BD_ACCOUNT, \"eventType\", BizConstants.FndFlexSet.TMS_DEAL_TRASACTIONTYPE,\n                    \"trxCurrencyCode\", BizConstants.FndFlexSet.TMS_CURRENCY, \"approveStatus\",\n                    BizConstants.FndFlexSet.TMS_GL_APPROVAL_STATUS);\n            resultMap.put(\"loanAccounts\", voucherDTOS);\n            TmsLoanAccountHeaderHisExample example1 = new TmsLoanAccountHeaderHisExample();\n            TmsLoanAccountHeaderHisExample.Criteria criteria1 = example1.createCriteria();\n            criteria1.andAccountHeaderIdEqualTo(Long.valueOf(queryDTO.getAccountHeaderId()));\n            example1.setOrderByClause(\"account_his_id desc\");\n            List<TmsLoanAccountHeaderHis> accountHisList = hisDAO.selectByExample(example1);\n            List<TmsLoanAccountHeaderHisDTO> hisDTOS = new ArrayList<>();\n            for (TmsLoanAccountHeaderHis his : accountHisList) {\n                TmsLoanAccountHeaderHisDTO dto = new TmsLoanAccountHeaderHisDTO();\n                BeanUtils.copyProperties(his, dto);\n                hisDTOS.add(dto);\n            }\n            fndFlexValueApi.translate(hisDTOS, \"operation\", BizConstants.FndFlexSet.TMS_DEAL_TRA_STATUS);\n            resultMap.put(\"loanAccountHis\", hisDTOS);\n        }\n        return resultMap;\n    }\n\n    @Override\n    public Map<String, Object> selectApprovalDetailByHeaderId(ApproveFundVoucherQueryDTO queryDTO) {\n        Map<String, Object> resultMap = this.selectFundVoucherByHeaderId(queryDTO);\n        ApproveFundVoucherDTO headerDTO = (ApproveFundVoucherDTO) resultMap.get(\"accountHeader\");\n        if (Objects.nonNull(headerDTO)) {\n            // 补充附件信息\n            List<LegoAttachmentDTO> attachmentDTOList = Lists.newArrayList();\n            PpsCommAttachment attachment = new PpsCommAttachment();\n            // 获取记账页面上传的附件\n            attachment.setBizType(CommonEnums.AttachmentBizType.THIRD_BALANCE_ACCOUNT_ATTACH.getValue());\n            attachment.setBizPk(String.valueOf(headerDTO.getApproveBatchId()));\n            List<PpsCommAttachment> loanAttachments = uploadAttachService.inintFileAtt(attachment);\n            loanAttachments.stream().forEach(t -> {\n                LegoAttachmentDTO attachmentDTO = new LegoAttachmentDTO();\n                String fileName = t.getFileName();\n                attachmentDTO.setId(t.getAttachId());\n                attachmentDTO.setName(t.getFileName());\n                String suffix = StringUtils.isBlank(fileName) ? \"other\" :\n                        fileName.substring(fileName.lastIndexOf(\".\") + 1);\n                String fileType = LegoFileTypeEnum.getTypeByExtension(suffix);\n                attachmentDTO.setType(fileType);\n                attachmentDTO.setBizType(t.getBizType());\n                attachmentDTO.setDownloadUrl(\"/attach/download/\" + t.getAttachId());\n                attachmentDTOList.add(attachmentDTO);\n            });\n            resultMap.put(\"attachmentList\", attachmentDTOList);\n        }\n        return resultMap;\n    }\n\n    /**\n     * 获取审批历史记录\n     *\n     * @param businessId\n     * @return\n     */\n    public List<ProcessRecordDTO> getProcessRecords(String businessId) {\n        List<ProcessRecordDTO> bpmHistory = new ArrayList<>();\n        List<ProcessRecordDTO> bpmActivity =\n               