nDELIMITER ;\n\nDELIMITER $$\n\nDROP FUNCTION IF EXISTS p2pnextval$$\n\nCREATE FUNCTION `p2pnextval`(seq_name VARCHAR(500)) RETURNS int(11)\n    DETERMINISTIC\nBEGIN\n  DECLARE VALUE INT(20);\n  DECLARE COUNT INT(20);\n  UPDATE fnd_sequence SET nextid = nextid + 1 WHERE NAME = seq_name;\n  select row_count() into COUNT;\n  IF COUNT = 0 THEN \n    SET VALUE = 1;\n    INSERT INTO fnd_sequence (name, nextid, increment, padding, prefix) VALUES (seq_name, VALUE + 1, 1, 1, '');\n  ELSE\n    select p2pcurrval(seq_name) INTO VALUE;\n    SET VALUE = VALUE - 1;\n  end if;\n  RETURN VALUE;\nEND$$\n\nDELIMITER ;\n\n\n\nINSERT INTO `fnd_language_b` (`language_id`, `language_code`, `installed_flag`, `created_by`, `creation_date`, `last_updated_by`, `last_update_date`) VALUES ('1', 'ZHS', 'B', '-1', '2016-09-01 20:34:34', '-1', '2016-09-01 20:34:34');\nINSERT INTO `fnd_language_b` (`language_id`, `language_code`, `installed_flag`, `created_by`, `creation_date`, `last_updated_by`, `last_update_date`) VALUES ('2', 'US', 'I', '-1', '2016-06-24 18:30:08', '-1', '2016-06-24 18:30:08');\n\nINSERT INTO `fnd_language_tl` (`id`, `language_code`, `description`, `language`, `created_by`, `creation_date`, `last_updated_by`, `last_update_date`, `language_id`) VALUES ('1', 'ZHS', '中文', 'ZHS', '-1', '2016-06-24 18:34:53', '-1', '2016-06-24 18:34:53', '1');\nINSERT INTO `fnd_language_tl` (`id`, `language_code`, `description`, `language`, `created_by`, `creation_date`, `last_updated_by`, `last_update_date`, `language_id`) VALUES ('2', 'ZHS', 'CHINESE', 'US', '-1', '2016-06-24 18:35:12', '-1', '2016-06-24 18:35:12', '1');\nINSERT INTO `fnd_language_tl` (`id`, `language_code`, `description`, `language`, `created_by`, `creation_date`, `last_updated_by`, `last_update_date`, `language_id`) VALUES ('3', 'US', 'English', 'US', '-1', '2016-06-24 18:35:33', '-1', '2016-06-24 18:35:33', '2');\nINSERT INTO `fnd_language_tl` (`id`, `language_code`, `description`, `language`, `created_by`, `creation_date`, `la