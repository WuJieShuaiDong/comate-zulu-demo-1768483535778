    AND h.end_date IS NULL\n            AND l.line_type='LINE_CURRENCY') currencys\n            where currencys.currency = heade.trx_currency_code)\n            and EXISTS (select 1 from (SELECT\n            DISTINCT l.line_value transaction_type\n            FROM\n            tms_loan_role_header h,\n            tms_loan_role_line l\n            WHERE h.role_header_id = l.role_header_id\n            AND h.role_user = #{userName}\n            AND h.end_date IS NULL\n            AND l.line_type='LINE_TRANSACTION_TYPE') transactionTypes\n            where transactionTypes.transaction_type = heade.trx_type)\n            AND  (EXISTS (select 1 from (SELECT\n            DISTINCT l.line_value bg\n            FROM\n            tms_loan_role_header h,\n            tms_loan_role_line l\n            WHERE h.role_header_id = l.role_header_id\n            AND h.role_user = #{userName}\n            AND h.end_date IS NULL\n            AND l.line_type='LINE_BG')bgs\n            where bgs.bg = heade.bg_code) or heade.bg_code is null)\n            <if test=\"trxCategory != null and trxCategory != ''\">\n                and heade.trx_category = #{trxCategory,jdbcType=VARCHAR}\n            </if>\n            <if test=\"accountType != null and accountType != ''\">\n                and heade.account_type = #{accountType,jdbcType=VARCHAR}\n            </if>\n            <if test=\"trxType != null and trxType != ''\">\n                and heade.trx_type = #{trxType,jdbcType=VARCHAR}\n            </if>\n            <if test=\"eventType != null and eventType != ''\">\n                and heade.event_type = #{eventType,jdbcType=VARCHAR}\n            </if>\n            <if test=\"segment1 != null and segment1 != ''\">\n                and heade.segment1 = #{segment1,jdbcType=VARCHAR}\n            </if>\n            <if test=\"requestNumber != null and requestNumber != ''\">\n                and heade.request_number = #{requestNumber,jdbcType=VARCHAR}\n            </if>\n            <if test=\"approveStatus != null and approveStatus != ''\">\n                and heade.approve_status = #{approveStatus,jdbcType=VARCHAR}\n            </if>\n            <if test=\"trxCurrencyCode != null and trxCurrencyCode != ''\">\n                and heade.trx_currency_code = #{trxCurrencyCode,jdbcType=VARCHAR}\n            </if>\n            <if test=\"accountPeriod != null and accountPeriod != ''\">\n                and heade.account_period = #{accountPeriod,jdbcType=VARCHAR}\n            </if>\n            <if test=\"createdBy != null and createdBy != ''\">\n                and heade.created_by = #{createdBy,jdbcType=VARCHAR}\n            </if>\n            <if test=\"bgCode != null and bgCode != ''\">\n                and heade.bg_code = #{bgCode,jdbcType=VARCHAR}\n            </if>\n        </where>\n        order by heade.account_header_id desc\n    </select>\n\n    <select id=\"selectExportVoucherList\" parameterType=\"com.baidu.tms.loan.dto.ApproveFundVoucherQueryDTO\"\n            resultType=\"com.baidu.tms.persistent.loan.domain.TmsLoanAccount\">\n        select\n        acc.trx_type,\n\t\tacc.segment1,\n\t\tacc.request_number,\n\t\tacc.event_number,\n\t\tacc.event_type,\n\t\tacc.trx_currency_code,\n\t\tacc.gl_transfer_date,\n\t\tacc.segment2,\n        acc.segment3,\n\t\tacc.segment4,\n\t\tacc.segment5,\n\t\tacc.segment6,\n\t\tacc.segment7,\n\t\tacc.segment8,\n\t\tacc.accounted,\n        acc.entered,\n\t\tacc.exchange_rate,\n\t\tacc.account_period,\n\t\tacc.naryur,\n\t\tacc.approve_status,\n\t\tacc.je_batch_name,\n\t\tacc.je_header_name,\n\t\tacc.direction\n        from tms_loan_account acc,\n        tms_loan_account_header heade\n        where\n        acc.attribute3 = heade.account_header_id\n\t\tand EXISTS (select 1 from (SELECT\n            DISTINCT l.line_value company_code\n            FROM\n            tms_loan_role_header h,\n            tms_loan_role_line l\n            WHERE h.role_header_id = l.role_header_id\n            AND h.role_user = #{userName}\n            AND h.end_date IS NULL\n            AND l.line_type='LINE_COMPANY') companys\n            where companys.company_code = heade.segment1)\n            and EXISTS (select 1 from (SELECT\n            DISTINCT l.line_value currency\n            FROM\n            tms_loan_role_header h,\n            tms_loan_role_line l\n            WHERE h.role_header_id = l.role_header_id\n            AND h.role_user = #{userName}\n            AND h.end_date IS NULL\n            AND l.line_type='LINE_CURRENCY') currencys\n            where currencys.currency = heade.trx_currency_code)\n            and EXISTS (select 1 from (SELECT\n            DISTINCT l.line_value transaction_type\n            FROM\n            tms_loan_role_header h,\n            tms_loan_role_line l\n            WHERE h.role_header_id = l.role_header_id\n            AND h.role_user = #{userName}\n            AND h.end_date IS NULL\n            AND l.line_type='LINE_TRANSACTION_TYPE') transactionTypes\n        where transactionTypes.transaction_type = heade.trx_type)\n        AND (EXISTS (select 1 from (SELECT\n        DISTINCT l.line_value bg\n        FROM\n        tms_loan_role_header h,\n        tms_loan_role_line l\n        WHERE h.role_header_id = l.role_header_id\n        AND h.role_user = #{userName}\n        AND h.end_date IS NULL\n        AND l.line_type='LINE_BG')bgs\n        where bgs.bg = heade.bg_code) or heade.bg_code is null)\n        <if test=\"trxCategory != null and trxCategory != ''\">\n            and heade.trx_category = #{trxCategory,jdbcType=VARCHAR}\n        </if>\n        <if test=\"accountType != null and accountType != ''\">\n            and heade.account_type = #{accountType,jdbcType=VARCHAR}\n        </if>\n        <if test=\"trxType != null and trxType != ''\">\n            and heade.trx_type = #{trxType,jdbcType=VARCHAR}\n        </if>\n        <if test=\"eventType != null and eventType != ''\">\n            and heade.event_type = #{eventType,jdbcType=VARCHAR}\n        </if>\n        <if test=\"segment1 != null and segment1 != ''\">\n            and heade.segment1 = #{segment1,jdbcType=VARCHAR}\n        </if>\n        <if test=\"requestNumber != null and requestNumber != ''\">\n            and heade.request_number = #{requestNumber,jdbcType=VARCHAR}\n        </if>\n        <if test=\"approveStatus != null and approveStatus != ''\">\n            and heade.approve_status = #{approveStatus,jdbcType=VARCHAR}\n        </if>\n        <if test=\"trxCurrencyCode != null and trxCurrencyCode != ''\">\n            and heade.trx_currency_code = #{trxCurrencyCode,jdbcType=VARCHAR}\n        </if>\n        <if test=\"accountPeriod != null and accountPeriod != ''\">\n            and heade.account_period = #{accountPeriod,jdbcType=VARCHAR}\n        </if>\n        <if test=\"createdBy != null and createdBy != ''\">\n            and heade.created_by = #{createdBy,jdbcType=VARCHAR}\n        </if>\n\t\torder by heade.account_header_id desc\n    </select>\n\n    <!-- 批量查询凭证头和分录信息 -->\n    <select id=\"selectVoucherWithHeaderByIds\" parameterType=\"java.util.List\" resultType=\"java.util.HashMap\">\n        SELECT\n            h.account_header_id,\n            h.approve_status,\n            a.account_id,\n            a.approve_status as account_status,\n            a.trx_type,\n            a.trx_category,\n            a.event_type,\n            a.account_type,\n            a.event_id,\n            a.accrual_id,\n            a.approve_batch_id\n        FROM tms_loan_account_header h\n        LEFT JOIN tms_loan_account a ON a.attribute3 = h.account_header_id\n        WHERE h.account_header_id IN\n        <foreach collection=\"list\" item=\"headerId\" open=\"(\" separator=\",\" close=\")\">\n            #{headerId}\n        </foreach>\n        ORDER BY h.account_header_id, a.account_id\n    </select>\n\n    <!-- 批量更新分录状态 -->\n    <update id=\"batchUpdateAccountStatus\" parameterType=\"java.util.Map\">\n        UPDATE tms_loan_account\n        SET\n            