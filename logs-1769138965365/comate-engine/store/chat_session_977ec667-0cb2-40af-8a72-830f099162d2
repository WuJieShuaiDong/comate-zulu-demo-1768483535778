      "absolutePath": "/Users/xiaoliu/baidu/bpit-proc-apps/tms/tms-core/src/main/java/com/baidu/p2p/core/utils/NewThreadPoolExecutorUtil.java",
      "content": "package com.baidu.p2p.core.utils;\n\nimport lombok.extern.slf4j.Slf4j;\nimport org.slf4j.MDC;\n\nimport java.util.Collection;\nimport java.util.List;\nimport java.util.Objects;\nimport java.util.concurrent.ArrayBlockingQueue;\nimport java.util.concurrent.BlockingQueue;\nimport java.util.concurrent.Callable;\nimport java.util.concurrent.ExecutorService;\nimport java.util.concurrent.ExecutionException;\nimport java.util.concurrent.Future;\nimport java.util.concurrent.RejectedExecutionHandler;\nimport java.util.concurrent.ThreadFactory;\nimport java.util.concurrent.ThreadPoolExecutor;\nimport java.util.concurrent.TimeUnit;\nimport java.util.concurrent.TimeoutException;\nimport java.util.concurrent.atomic.AtomicBoolean;\nimport java.util.concurrent.atomic.AtomicInteger;\nimport java.util.concurrent.atomic.AtomicLong;\nimport java.util.stream.Collectors;\n\nimport static java.util.concurrent.ThreadPoolExecutor.CallerRunsPolicy;\n\n\n\n/**\n * 公用的线程池工具类\n * 功能：\n * 1. 全链路异常捕获（含Error），解决线程丢失问题\n * 2. 完善的线程池关闭机制（优雅关闭+超时控制）\n * 3. 支持线程池状态监控与队列饱和预警\n * 4. 核心与非核心线程分离，支持动态参数调整\n * 5. 兼容CompletableFuture等原生组件，保持接口一致性\n * 6、通过MDC将任务名注入所有日志，便于链路追踪\n * Created by liumandong on 2025/09/18\n */\n@Slf4j\npublic class NewThreadPoolExecutorUtil {\n\n    public static final String MDC_TASK_NAME_KEY = \"taskName\";\n    private static final AtomicLong TASK_ID_GENERATOR = new AtomicLong(1);\n    private static final double QUEUE_WARN_THRESHOLD = 0.8;\n    private static final long DEFAULT_TASK_TIMEOUT = 30;\n\n\n    private static final int DEFAULT_CORE_POOL_SIZE = 10;\n    private static final int DEFAULT_MAX_POOL_SIZE = 20;\n    private static final int DEFAULT_QUEUE_SIZE = 1000;\n    private static final long KEEP_ALIVE_TIME = 5;\n    private static final TimeUnit KEEP_ALIVE_TIME_UNIT = TimeUnit.MINUTES;\n    private static final RejectedExecutionHandler DEFAULT_REJECTED_HANDLER = new LoggingCallerRunsPolicy();\n\n    private static ExecutorService wrappedDefaultExecutor;\n\n    static {\n        ThreadPoolExecutor rawExecutor = initRawDefaultExecutor();\n        wrappedDefaultExecutor = new WrappedExecutorService(rawExecutor);\n\n        Runtime.getRuntime().addShutdownHook(new Thread(() -> {\n            log.info(\"JVM is shutting down, shutting down default thread pool gracefully...\");\n            shutdownAndAwaitTermination(wrappedDefaultExecutor, 30, TimeUnit.SECONDS);\n        }));\n    }\n\n    /**\n     * 初始化默认线程池（原始实例，未包装）\n     */\n    private static ThreadPoolExecutor initRawDefaultExecutor() {\n        BlockingQueue<Runnable> queue = new ArrayBlockingQueue<>(DEFAULT_QUEUE_SIZE);\n        ThreadFactory threadFactory = new NamedThreadFactory(\"default-pool-\", Thread.NORM_PRIORITY);\n\n        ThreadPoolExecutor executor = new ThreadPoolExecutor(\n                DEFAULT_CORE_POOL_SIZE,\n                DEFAULT_MAX_POOL_SIZE,\n                KEEP_ALIVE_TIME,\n                KEEP_ALIVE_TIME_UNIT,\n                queue,\n                threadFactory,\n                DEFAULT_REJECTED_HANDLER\n        );\n\n        executor.allowCoreThreadTimeOut(false);\n        log.info(\"Default thread pool initialized. Core: {}, Max: {}, Queue: {}\",\n                DEFAULT_CORE_POOL_SIZE, DEFAULT_MAX_POOL_SIZE, DEFAULT_QUEUE_SIZE);\n        return executor;\n    }\n\n    /**\n     * 获取默认线程池实例（已包装，强制使用工具类提交方法）\n     */\n    public static ExecutorService getExecutorService() {\n        ThreadPoolExecutor rawExecutor = (ThreadPoolExecutor) ((WrappedExecutorService) wrappedDefaultExecutor).getTarget();\n        if (rawExecutor.isTerminated() || rawExecutor.isShutdown()) {\n            log.warn(\"Default thread pool is unavailable, recreating...\");\n            rawExecutor = initRawDefaultExecutor();\n            wrappedDefaultExecutor = new WrappedExecutorService(rawExecutor);\n        }\n        return wrappedDefaultExecutor;\n    }\n\n    /**\n     * 获取执行器的目标执行器（解包装）\n     *\n     * @param executor 输入的执行器，可能是包装类或原始执行器\n     * @return 解包装后的目标执行器，如果输入是包装类则返回其target，否则返回原执行器\n     */\n    public static ExecutorService unwrapExecutor(ExecutorService executor) {\n        if (executor instanceof WrappedExecutorService) {\n            return ((WrappedExecutorService) executor).getTarget();\n        }\n        return executor;\n    }\n\n    /**\n     * 创建自定义线程池（支持全参数配置）\n     */\n    public static ThreadPoolExecutor createExecutorService(\n            int corePoolSize, int maxPoolSize, BlockingQueue<Runnable> queue,\n            int threadPriority, RejectedExecutionHandler rejectedHandler,\n            String threadNamePrefix) {\n\n        if (corePoolSize < 0 || maxPoolSize <= 0 || maxPoolSize < corePoolSize || queue == null) {\n            throw new IllegalArgumentException(\"Invalid thread pool parameters: \" +\n                    \"core=\" + corePoolSize + \", max=\" + maxPoolSize + \", queue=\" + queue);\n        }\n\n        ThreadFactory threadFactory = new NamedThreadFactory(threadNamePrefix, threadPriority);\n        RejectedExecutionHandler handler = rejectedHandler != null ? rejectedHandler : DEFAULT_REJECTED_HANDLER;\n\n        ThreadPoolExecutor executor = new ThreadPoolExecutor(\n                corePoolSize,\n                maxPoolSize,\n                KEEP_ALIVE_TIME,\n                KEEP_ALIVE_TIME_UNIT,\n                queue,\n                threadFactory,\n                handler\n        );\n\n        log.info(\"Custom thread pool created. Core: {}, Max: {}, Queue: {}, Prefix: {}\",\n                corePoolSize, maxPoolSize, queue.getClass().getSimpleName(), threadNamePrefix);\n        return executor;\n    }\n\n    /**\n     * 简化版自定义线程池创建（默认队列和拒绝策略）\n     */\n    public static ThreadPoolExecutor createExecutorService(\n            int corePoolSize, int maxPoolSize, int queueSize, String threadNamePrefix) {\n        BlockingQueue<Runnable> queue = new ArrayBlockingQueue<>(queueSize);\n        return createExecutorService(corePoolSize, maxPoolSize, queue,\n                Thread.NORM_PRIORITY, DEFAULT_REJECTED_HANDLER, threadNamePrefix);\n    }\n\n    /**\n     * 包装自定义线程池，强制使用工具类的任务提交逻辑\n     */\n    public static ExecutorService wrapExecutor(ThreadPoolExecutor executor) {\n        return new WrappedExecutorService(executor);\n    }\n\n    /**\n     * 动态调整核心线程数\n     */\n    public static void setCorePoolSize(ThreadPoolExecutor executor, int corePoolSize) {\n        if (corePoolSize < 0) {\n            throw new IllegalArgumentException(\"Core pool size cannot be negative\");\n        }\n        executor.setCorePoolSize(corePoolSize);\n        log.info(\"Thread pool core size adjusted to: {}\", corePoolSize);\n    }\n\n    /**\n     * 动态调整最大线程数\n     */\n    public static void setMaximumPoolSize(ThreadPoolExecutor executor, int maxPoolSize) {\n        if (maxPoolSize <= 0) {\n            throw new IllegalArgumentException(\"Max pool size must be positive\");\n        }\n        executor.setMaximumPoolSize(maxPoolSize);\n        log.info(\"Thread pool max size adjusted to: {}\", maxPoolSize);\n    }\n\n    /**\n     * 优雅关闭线程池\n     */\n    public static void shutdownExecutor(ExecutorService executor, long timeout, TimeUnit unit) {\n        if (executor == null || executor.isTerminated()) {\n            return;\n        }\n        shutdownAndAwaitTermination(unwrapExecutor(executor), timeout, unit);\n    }\n\n    /**\n     * 优雅关闭线程池并等待终止\n     */\n    private static void shutdownAndAwaitTermination(ExecutorService executor, long timeout, TimeUnit unit) {\n        if (executor == null) {\n            return;\n        }\n        ExecutorService targetExecutor = unwrapExecutor(executor);\n        try {\n            targetExecutor.shutdown();\n            if (!targetExecutor.awaitTermination(timeout, unit)) {\n                log.warn(\"Thread pool not terminated in time, forcing shutdown...\");\n                List<Runnable> remainingTasks = targetExecutor.shutdownNow();\n                log.info(\"Remaining unexecuted tasks: {}\", remainingTasks.size());\n                if (!targetExecutor.awaitTermination(timeout, unit)) {\n                    log.error(\"Thread pool still not terminated after forced shutdown\");\n                }\n            }\n        } catch (InterruptedException ie) {\n            targetExecutor.shutdownNow();\n            Thread.currentThread().interrupt();\n        }\n    }\n\n    /**\n     * 打印线程池状态（含队列饱和预警）\n     */\n    public static void printThreadPoolStatus(ThreadPoolExecutor executor, String poolName) {\n        if (executor == null) {\n            log.warn(\"ThreadPool is null, cannot print status\");\n            return;\n        }\n\n        BlockingQueue<Runnable> queue = executor.getQueue();\n        int queueSize = queue.size();\n        int queueCapacity = queueSize + queue.remainingCapacity();\n        double queueUsage = queueCapacity == 0 ? 0 : (double) queueSize / queueCapacity;\n\n        if (queueUsage > QUEUE_WARN_THRESHOLD) {\n            log.warn(\"ThreadPool [{}] queue is nearly full. Usage: {:.2f}%\",\n                    poolName, queueUsage * 100);\n        }\n\n        log.info(\"ThreadPool [{}] Status: \" +\n                        \"Core={}, Pool={}, Active={}, Largest={}, \" +\n                        \"TaskCount={}, Completed={}, \" +\n                        \"QueueSize={}/{}, QueueUsage={}%, \" +\n                        \"Shutdown={}, Terminating={}, Terminated={}\",\n                poolName,\n                executor.getCorePoolSize(),\n                executor.getPoolSize(),\n                executor.getActiveCount(),\n                executor.getLargestPoolSize(),\n                executor.getTaskCount(),\n                executor.getCompletedTaskCount(),\n                queueSize, queueCapacity, queueUsage * 100,\n                executor.isShutdown(),\n                executor.isTerminating(),\n                executor.isTerminated()\n        );\n    }\n\n    /**\n     * 打印默认线程池状态\n     */\n    public static void printDefaultThreadPoolStatus() {\n        ThreadPoolExecutor rawExecutor = (ThreadPoolExecutor) ((WrappedExecutorService) wrappedDefaultExecutor).getTarget();\n        printThreadPoolStatus(rawExecutor, \"DefaultThreadPool\");\n    }\n\n    /**\n     * 带超时控制的submit（自定义任务名称和超时时间）\n     */\n    public static <T> T submitWithTimeout(Callable<T> task, String taskName, long timeout, TimeUnit unit)\n            throws ExecutionException, InterruptedException, TimeoutException {\n        Future<T> future = submit(task, taskName);\n        return future.get(timeout, unit);\n    }\n\n    /**\n     * 带超时控制的submit（使用默认超时时间）\n     */\n    public static <T> T submitWithTimeout(Callable<T> task, String taskName)\n            throws ExecutionException, InterruptedException, TimeoutException {\n        return submitWithTimeout(task, taskName, DEFAULT_TASK_TIMEOUT, TimeUnit.SECONDS);\n    }\n\n    /**\n     * 简化版submit（默认线程池、自定义任务名称）\n     */\n    public static <T> Future<T> submit(Callable<T> task, String taskName) {\n        return submit(getExecutorService(), task, taskName);\n    }\n\n    /**\n     * 提交任务（带异常处理和自定义任务名称，通过MDC注入任务名）\n     */\n    public static <T> Future<T> submit(ExecutorService executor, Callable<T> task, String taskName) {\n        Objects.requireNonNull(executor, \"Executor cannot be null\");\n        Objects.requireNonNull(task, \"Task cannot be null\");\n\n        ExecutorService targetExecutor = unwrapExecutor(executor);\n\n        Callable<T> wrappedTask = () -> {\n            // 保存原始MDC上下文（避免线程复用导致的上下文污染）\n            String originalTaskName = MDC.get(MDC_TASK_NAME_KEY);\n            try {\n                // 注入当前任务名到MDC\n                MDC.put(MDC_TASK_NAME_KEY, taskName);\n                // 执行任务（任务内部的日志会自动包含taskName）\n                return wrapTaskWithLog(task, taskName).call();\n            } catch (Throwable t) {\n                log.error(\"Task [{}] execution failed\", taskName, t);\n                if (t instanceof Error) {\n                    log.error(\"Task [{}] encountered critical error, thread may be terminated\", taskName);\n                }\n                throw t;\n            } finally {\n                // 恢复原始MDC上下文\n                if (originalTaskName == null) {\n                    MDC.remove(MDC_TASK_NAME_KEY);\n                } else {\n                    MDC.put(MDC_TASK_NAME_KEY, originalTaskName);\n                }\n            }\n        };\n        return targetExecutor.submit(wrappedTask);\n    }\n\n    /**\n     * 提交任务（自动生成任务名称）\n     */\n    public static <T> Future<T> submit(ExecutorService executor, Callable<T> task) {\n        return submit(executor, task, \"task-\" + TASK_ID_GENERATOR.incrementAndGet());\n    }\n\n    /**\n     * 简化版提交Runnable任务（默认线程池、自定义任务名称）\n     */\n    public static void execute(Runnable task, String taskName) {\n        execute(getExecutorService(), task, taskName);\n    }\n\n    /**\n     * 提交Runnable任务（带异常处理和自定义任务名称，通过MDC注入任务名）\n     */\n    public static void execute(ExecutorService executor, Runnable task, String taskName) {\n        Objects.requireNonNull(executor, \"Executor cannot be null\");\n        Objects.requireNonNull(task, \"Task cannot be null\");\n\n        ExecutorService targetExecutor = unwrapExecutor(executor);\n\n        Runnable wrappedTask = () -> {\n            // 保存原始MDC上下文\n            String originalTaskName = MDC.get(MDC_TASK_NAME_KEY);\n            try {\n                // 注入当前任务名到MDC\n                MDC.put(MDC_TASK_NAME_KEY, taskName);\n                // 执行任务\n                wrapRunnableWithLog(task, taskName).run();\n            } catch (Throwable t) {\n                log.error(\"Task [{}] execution failed\", taskName, t);\n                if (t instanceof Error) {\n                    log.error(\"Task [{}] encountered critical error, thread may be terminated\", taskName);\n                }\n            } finally {\n                // 恢复原始MDC上下文\n                if (originalTaskName == null) {\n                    MDC.remove(MDC_TASK_NAME_KEY);\n                } else {\n                    MDC.put(MDC_TASK_NAME_KEY, originalTaskName);\n                }\n            }\n        };\n        targetExecutor.execute(wrappedTask);\n    }\n\n    /**\n     * 提交Runnable任务（自动生成任务名称）\n     */\n    public static void execute(ExecutorService executor, Runnable task) {\n        execute(executor, task, \"task-\" + TASK_ID_GENERATOR.incrementAndGet());\n    }\n\n    /**\n     * 自定义线程工厂（支持优先级配置）\n     */\n    private static class NamedThreadFactory implements ThreadFactory {\n        private final String prefix;\n        private final AtomicBoolean daemon;\n        private final int threadPriority;\n        private final AtomicInteger threadNumber = new AtomicInteger(1);\n\n        public NamedThreadFactory(String prefix, int priority) {\n            this(prefix, priority, false);\n        }\n\n        public NamedThreadFactory(String prefix, int priority, boolean daemon) {\n            this.prefix = prefix;\n            this.threadPriority = priority;\n            this.daemon = new AtomicBoolean(daemon);\n            // 校验优先级范围\n            if (priority < Thread.MIN_PRIORITY || priority > Thread.MAX_PRIORITY) {\n                throw new IllegalArgumentException(\"Invalid thread priority: \" + priority);\n            }\n        }\n\n        @Override\n        public Thread newThread(Runnable r) {\n            Thread t = new Thread(r, prefix + threadNumber.getAndIncrement());\n            t.setDaemon(daemon.get());\n            t.setPriority(threadPriority);\n            return t;\n        }\n    }\n\n    /**\n     * 带日志的拒绝策略（含任务名称）\n     */\n    private static class LoggingCallerRunsPolicy extends CallerRunsPolicy {\n        @Override\n        public void rejectedExecution(Runnable r, ThreadPoolExecutor e) {\n            String taskName = resolveTaskName(r);\n\n            log.warn(\"Task [{}] rejected. Thread pool saturated. \" +\n                            \"Active: {}, Queue: {}, Pool: {}\",\n                    taskName, e.getActiveCount(), e.getQueue().size(), e.getPoolSize());\n            super.rejectedExecution(r, e);\n        }\n\n        private String resolveTaskName(Runnable r) {\n            // 1. 尝试从WrappedRunnable获取\n            if (r instanceof WrappedRunnable) {\n                return ((WrappedRunnable) r).getTaskName();\n            }\n\n            // 2. 尝试从MDC上下文获取\n            String mdcTaskName = MDC.get(MDC_TASK_NAME_KEY);\n            if (mdcTaskName != null && !mdcTaskName.isEmpty()) {\n                return mdcTaskName;\n            }\n\n            // 3. 尝试从线程名称推断\n            Thread currentThread = Thread.currentThread();\n            if (currentThread != null) {\n                String threadName = currentThread.getName();\n                if (threadName != null && !threadName.isEmpty()) {\n                    return \"thread-\" + threadName;\n                }\n            }\n\n            // 4. 最后备选\n            return \"unknown-\" + r.getClass().getSimpleName();\n        }\n    }\n    /**\n     * 包装ExecutorService，确保原生方法调用也通过MDC注入任务名\n     */\n    private static class WrappedExecutorService implements ExecutorService {\n        private final ExecutorService target;\n\n        public WrappedExecutorService(ExecutorService target) {\n            this.target = Objects.requireNonNull(target);\n        }\n\n        public ExecutorService getTarget() {\n            return target;\n        }\n\n        @Override\n        public void execute(Runnable command) {\n            NewThreadPoolExecutorUtil.execute(this, command,\n                    \"auto-execute-\" + TASK_ID_GENERATOR.incrementAndGet());\n        }\n\n        @Override\n        public <T> Future<T> submit(Callable<T> task) {\n            return NewThreadPoolExecutorUtil.submit(this, task,\n                    \"auto-submit-\" + TASK_ID_GENERATOR.incrementAndGet());\n        }\n\n        @Override\n        public <T> Future<T> submit(Runnable task, T result) {\n            Callable<T> wrappedCallable = () -> {\n                task.run();\n                return result;\n            };\n            return submit(wrappedCallable);\n        }\n\n        @Override\n        public Future<?> submit(Runnable task) {\n            return submit(task, null);\n        }\n\n        @Override\n        public <T> List<Future<T>> invokeAll(Collection<? extends Callable<T>> tasks) throws InterruptedException {\n            List<Callable<T>> wrappedTasks = tasks.stream()\n                    .map(task -> wrapCallable(task, \"batch-task-\" + TASK_ID_GENERATOR.incrementAndGet()))\n                    .collect(Collectors.toList());\n            return target.invokeAll(wrappedTasks);\n        }\n\n        @Override\n        public <T> List<Future<T>> invokeAll(Collection<? extends Callable<T>> tasks, long timeout, TimeUnit unit)\n                throws InterruptedException {\n            List<Callable<T>> wrappedTasks = tasks.stream()\n                    .map(task -> wrapCallable(task, \"timed-batch-task-\" + TASK_ID_GENERATOR.incrementAndGet()))\n                    .collect(Collectors.toList());\n            return target.invokeAll(wrappedTasks, timeout, unit);\n        }\n\n        @Override\n        public <T> T invokeAny(Collection<? extends Callable<T>> tasks)\n                throws InterruptedException, ExecutionException {\n            List<Callable<T>> wrappedTasks = tasks.stream()\n                    .map(task -> wrapCallable(task, \"any-task-\" + TASK_ID_GENERATOR.incrementAndGet()))\n                    .collect(Collectors.toList());\n            return target.invokeAny(wrappedTasks);\n        }\n\n        @Override\n        public <T> T invokeAny(Collection<? extends Callable<T>> tasks, long timeout, TimeUnit unit)\n                throws InterruptedException, ExecutionException, TimeoutException {\n            List<Callable<T>> wrappedTasks = tasks.stream()\n                    .map(task -> wrapCallable(task, \"timed-any-task-\" + TASK_ID_G