      "absolutePath": "/Users/xiaoliu/baidu/bpit-proc-apps/tms/tms-web/target/classes/com/baidu/tms/loan/dao/LoanAccountDAO.xml",
      "content": "<?xml version=\"1.0\" encoding=\"UTF-8\" ?>\n\n<!DOCTYPE mapper PUBLIC \"-//mybatis.org//DTD Mapper 3.0//EN\" \"http://mybatis.org/dtd/mybatis-3-mapper.dtd\" >\n<mapper namespace=\"com.baidu.tms.loan.dao.LoanAccountDao\">\n    <!-- 待记账交易事件查询字段-->\n    <sql id=\"event_base_column\">\n      env.event_id eventId,\n      req.company company_code_name,\n      req.id requestId,\n      req.company_code,\n      led.currency_code ledgerCurrencyCode,\n      req.counterparty counterparty_code_name,\n      req.counterparty_code,\n      req.trx_type,\n      req.request_number,\n      env.event_type ,\n      env.event_number,\n      req.currency_code trxCurrencyCode,\n      env.settlement_amount,\n      env.event_status,\n      env.account_status trxAccountStatus,\n      env.actual_pay_date\n    </sql>\n\n    <!-- 待记账的的交易事件-->\n    <select id=\"getEvents\" parameterType=\"com.baidu.tms.loan.domain.LoanAccountEvent\"\n            resultType=\"com.baidu.tms.loan.domain.LoanAccountEvent\">\n        select\n        <include refid=\"event_base_column\"/>\n        from\n        tms_loan_req req,\n        tms_loan_trx_event env,\n        (SELECT\n        b.flex_value company_code,\n        b.attribute3 ledger_id\n        FROM\n        fnd_flex_value_b b,\n        fnd_flex_value_set s\n        WHERE b.flex_value_set_id = s.flex_value_set_id\n        AND s.flex_value_set_name = 'COM_OU_SOB') rel,\n        tms_gl_ledger led\n        <where>\n            req.Id = env.request_id\n            AND led.ledger_id = rel.ledger_id\n            AND rel.company_code = req.company_code\n            AND env.event_status='COMPLETED'\n            AND env.account_status in ('N','Y')\n            AND EXISTS\n            (SELECT\n            1\n            FROM\n            (SELECT DISTINCT\n            l.line_value company_code\n            FROM\n            tms_loan_role_header h,\n            tms_loan_role_line l\n            WHERE h.role_header_id = l.role_header_id\n            AND h.role_user = #{userName,jdbcType=VARCHAR}\n            AND h.end_date IS NULL\n            AND l.line_type = 'LINE_COMPANY') companys\n            WHERE companys.company_code = req.company_code)\n            <if test=\"trxType != null and trxType != ''\">\n                and req.trx_type = #{trxType,jdbcType=VARCHAR}\n            </if>\n            <if test=\"processType != null and processType != ''\">\n                and req.process_type = #{processType,jdbcType=VARCHAR}\n            </if>\n            <if test=\"companyCode != null and companyCode != ''\">\n                and req.company_code = #{companyCode,jdbcType=VARCHAR}\n            </if>\n            <if test=\"requestNumber != null and requestNumber != ''\">\n                and req.request_number = #{requestNumber,jdbcType=VARCHAR}\n            </if>\n            <if test=\"eventNumber != null and eventNumber != ''\">\n                and env.event_number = #{eventNumber,jdbcType=VARCHAR}\n            </if>\n            <if test=\"trxCurrencyCode != null and trxCurrencyCode != ''\">\n                and req.currency_code = #{trxCurrencyCode,jdbcType=VARCHAR}\n            </if>\n            <if test=\"trxAccountStatus != null and trxAccountStatus != ''\">\n                and env.account_status = #{trxAccountStatus,jdbcType=VARCHAR}\n            </if>\n            <if test=\"fromActualPayDate != null and fromActualPayDate!=''\">\n                AND env.actual_pay_date <![CDATA[ >= ]]>  #{fromActualPayDate,jdbcType=TIMESTAMP}\n            </if>\n            <if test=\"toActualPayDate != null and toActualPayDate!=''\">\n                AND env.actual_pay_date  <![CDATA[ <= ]]>  #{toActualPayDate,jdbcType=TIMESTAMP}\n            </if>\n\n\n        </where>\n        order by env.last_update_date\n    </select>\n    <!-- 交易事件的记账信息-->\n    <select id=\"getAccounts\" parameterType=\"java.lang.Long\"\n            resultType=\"com.baidu.tms.loan.domain.LoanAccount\">\n        SELECT\n          req.Id source_id,\n          req.counterparty_type,\n          req.company_code segment1,\n          req.counterparty_code,\n          req.company_account,\n          req.request_number,\n          req.trx_type,\n          type.trans_name trxTypeName,\n          env.event_number,\n          env.event_id,\n          env.event_type,\n          env.actual_pay_date accounting_date,\n          env.settlement_amount entered,\n          led.currency_code ledgerCurrencyCode,\n          req.currency_code trxCurrencyCode,\n          acc.fin_account,\n          facc.facc_description finAccountDescription,\n          rule.cr_segment1,\n          rule.cr_segment2,\n          rule.cr_segment3,\n          rule.cr_segment4,\n          rule.cr_segment5,\n          rule.cr_segment6,\n          rule.cr_segment7,\n          rule.cr_segment8,\n          rule.dr_segment1,\n          rule.dr_segment2,\n          rule.dr_segment3,\n          rule.dr_segment4,\n          rule.dr_segment5,\n          rule.dr_segment6,\n          rule.dr_segment7,\n          rule.dr_segment8,\n          rule.tax_segment1,\n          rule.tax_segment2,\n          rule.tax_segment3,\n          rule.tax_segment4,\n          rule.tax_segment5,\n          rule.tax_segment6,\n          rule.tax_segment7,\n          rule.tax_segment8,\n          rel.ledger_id\n        FROM\n          tms_loan_trx_event env,\n          tms_loan_req req,\n          tms_loan_account_rule rule,\n          (SELECT\n            b.flex_value company_code,\n            b.attribute3 ledger_id\n          FROM\n            fnd_flex_value_b b,\n            fnd_flex_value_set s\n          WHERE b.flex_value_set_id = s.flex_value_set_id\n            AND s.flex_value_set_name = 'COM_OU_SOB') rel,\n          (SELECT\n            b.flex_value faccno,\n            tl.description facc_description\n          FROM\n            fnd_flex_value_b b,\n            fnd_flex_value_tl tl,\n            fnd_flex_value_set s\n          WHERE b.flex_value_set_id = s.flex_value_set_id\n            AND tl.flex_value_id = b.flex_value_id\n            AND s.flex_value_set_name = 'BD_ACCOUNT'\n            AND tl.language = 'ZHS') facc,\n          (SELECT\n            trans_code,\n            trans_name\n          FROM tms_transaction_type\n          WHERE start_date_active &lt;= curdate()\n            AND (end_date_active is null or end_date_active &gt;= curdate())\n            AND enabled_flag = 'Y') type,\n          tms_gl_ledger led,\n          tms_account acc,\n          tms_loan_event_settlement_info info\n        WHERE 1 = 1\n          AND env.request_id = req.Id\n          AND info.request_id = req.Id\n          AND info.event_id = env.event_id\n          AND\n          CASE\n              WHEN ((TO_DAYS(req.interest_end_date) - TO_DAYS(env.effective_date)) &gt; 365)\n                  THEN rule.lstcod = 'LONG_TERM'\n              ELSE\n                  rule.lstcod = 'SHORT_TERM'\n          END\n\n          AND req.trx_type = rule.trstype\n          AND rule.entcod = env.event_type\n          AND rule.end_date IS NULL\n          AND req.trx_type = type.trans_code\n          AND led.ledger_id = rel.ledger_id\n          AND facc.faccno = acc.fin_account\n          AND rel.company_code = req.company_code\n          AND info.company_account_id = acc.ac_account_id\n          AND env.event_id = #{eventId, jdbcType=BIGINT} \n          limit 1 ;\n    </select>\n    <!-- 交易事件的记账信息-->\n    <select id=\"getFinancialAccounts\" parameterType=\"java.lang.Long\"\n            resultType=\"com.baidu.tms.loan.domain.LoanAccount\">\n        SELECT\n          deal.deal_id source_id,\n          deal.company_code segment1,\n          deal.counterparty_code,\n          env.company_account,\n          deal.deal_num request_number,\n          deal.deal_type trx_type,\n          deal.deal_category trx_category,\n          deal.product_name,\n          env.event_number,\n          env.event_id,\n          env.event_type,\n          env.sel_id,\n          env.settlement_date accounting_date,\n          env.total_interest,\n          case\n\t\t\twhen env.event_type = 'EVENT_INTEREST_PRINCIPAL'\n\t\t\t  then env.principal_balance\n            when env.event_type != 'EVENT_INTEREST_PRINCIPAL'\n\t\t\t  then env.settlement_amount\n\t\t  end\n\t\t  entered,\n          deal.amount billAmount,\n          deal.interest,\n          deal.net_amount,\n          led.currency_code ledgerCurrencyCode,\n          type.trans_name trxTypeName,\n          deal.currency_code trxCurrencyCode,\n          acc.fin_account,\n          facc.facc_description finAccountDescription,\n          rule.cr_segment1,\n          rule.cr_segment2,\n          rule.cr_segment3,\n          rule.cr_segment4,\n          rule.cr_segment5,\n          rule.cr_segment6,\n          rule.cr_segment7,\n          rule.cr_segment8,\n          rule.dr_segment1,\n          rule.dr_segment2,\n          rule.dr_segment3,\n          rule.dr_segment4,\n          rule.dr_segment5,\n          rule.dr_segment6,\n          rule.dr_segment7,\n          rule.dr_segment8,\n          rule.tax_segment1,\n          rule.tax_segment2,\n          rule.tax_segment3,\n          rule.tax_segment4,\n          rule.tax_segment5,\n          rule.tax_segment6,\n          rule.tax_segment7,\n          rule.tax_segment8,\n          rel.ledger_id,\n          comp.counterparty_name\n        FROM\n          tms_deal_event env,\n          tms_deal deal,\n          tms_loan_account_rule rule,\n          (SELECT\n            b.flex_value company_code,\n            b.attribute3 ledger_id\n          FROM\n            fnd_flex_value_b b,\n            fnd_flex_value_set s\n          WHERE b.flex_value_set_id = s.flex_value_set_id\n            AND s.flex_value_set_name = 'COM_OU_SOB') rel,\n          (SELECT\n            b.flex_value faccno,\n            tl.description facc_description\n          FROM\n            fnd_flex_value_b b,\n            fnd_flex_value_tl tl,\n            fnd_flex_value_set s\n          W