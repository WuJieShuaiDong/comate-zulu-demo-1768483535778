            "content": "package com.baidu.p2p.core.utils;\n\nimport static org.junit.Assert.*;\n\nimport org.junit.After;\nimport org.junit.Before;\nimport org.junit.Test;\n\nimport java.util.concurrent.Callable;\nimport java.util.concurrent.ExecutorService;\nimport java.util.concurrent.Future;\nimport java.util.concurrent.ThreadPoolExecutor;\nimport java.util.concurrent.TimeUnit;\n\npublic class NewThreadPoolExecutorUtilTest{\n\n    @Before\n    public void setup() {\n        ExecutorService executor = NewThreadPoolExecutorUtil.getExecutorService();\n        executor.shutdown();\n        try {\n            if (!executor.awaitTermination(5, TimeUnit.SECONDS)) {\n                executor.shutdownNow();\n            }\n        } catch (InterruptedException e) {\n            executor.shutdownNow();\n            Thread.currentThread().interrupt();\n        }\n    }\n\n    @After\n    public void teardown() {\n        ExecutorService executor = NewThreadPoolExecutorUtil.getExecutorService();\n        executor.shutdown();\n        try {\n            if (!executor.awaitTermination(5, TimeUnit.SECONDS)) {\n                executor.shutdownNow();\n            }\n        } catch (InterruptedException e) {\n            executor.shutdownNow();\n            Thread.currentThread().interrupt();\n        }\n    }\n    // testCreateExecutorServiceWithValidParameters 用于测试 createExecutorService\n    // generated by Comate\n    @Test\n    public void testCreateExecutorServiceWithValidParameters() {\n        int corePoolSize = 5;\n        int maxPoolSize = 10;\n        int queueSize = 100;\n        \n        ThreadPoolExecutor executor = NewThreadPoolExecutorUtil.createExecutorService(corePoolSize, maxPoolSize, queueSize);\n        \n        assertNotNull(executor);\n        assertEquals(corePoolSize, executor.getCorePoolSize());\n        assertEquals(maxPoolSize, executor.getMaximumPoolSize());\n        assertFalse(executor.isShutdown());\n    }\n\n    // testCreateExecutorServiceWithNegativeCorePoolSize 用于测试 createExecutorService\n    // generated by Comate\n    @Test(expected = IllegalArgumentException.class)\n    public void testCreateExecutorServiceWithNegativeCorePoolSize() {\n        NewThreadPoolExecutorUtil.createExecutorService(-1, 10, 100, \"invalid-pool-\");\n    }\n\n    // testGetExecutorServiceInitialState 用于测试 getExecutorService\n    // generated by Comate\n    @Test\n    public void testGetExecutorServiceInitialState() {\n        ExecutorService executor = NewThreadPoolExecutorUtil.getExecutorService();\n        assertNotNull(\"Executor should not be null\", executor);\n        assertFalse(\"Executor should not be shutdown\", executor.isShutdown());\n        assertFalse(\"Executor should not be terminated\", executor.isTerminated());\n        assertTrue(\"Returned executor should be ThreadPoolExecutor\", \n            executor instanceof ThreadPoolExecutor);\n        ThreadPoolExecutor threadPool = (ThreadPoolExecutor) executor;\n        assertEquals(\"Core pool size should match default\", \n            10, threadPool.getCorePoolSize());\n        assertEquals(\"Max pool size should match default\", \n            20, threadPool.getMaximumPoolSize());\n    }\n\n    // testShutdownExecutorNullExecutor 用于测试 shutdownExecutor\n    // generated by Comate\n    @Test\n    public void testShutdownExecutorNullExecutor() {\n        NewThreadPoolExecutorUtil.shutdownExecutor(null, 1, TimeUnit.SECONDS);\n    }\n\n    // testSubmitNullExecutor 用于测试 submit\n    // generated by Comate\n    @Test(expected = IllegalArgumentException.class)\n    public void testSubmitNullExecutor() {\n        Callable<String> task = () -> \"test\";\n        NewThreadPoolExecutorUtil.submit(null, task);\n    }\n\n    // testSubmitWithRealExecutor 用于测试 submit\n    // generated by Comate\n    @Test\n    public void testSubmitWithRealExecutor() throws Exception {\n        ExecutorService executor = java.util.concurrent.Executors.newSingleThreadExecutor();\n        try {