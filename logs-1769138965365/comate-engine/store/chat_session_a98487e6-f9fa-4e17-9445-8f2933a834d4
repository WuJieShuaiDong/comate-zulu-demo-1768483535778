 ppci.pay_check_num,  -- 付款单号\n        ppcih.pay_date as payDate, -- 实际付款日期\n        ppcih.handle_date as handleDate, -- 实际付款日期\n        ppcih.amount as amount, -- 付款金额\n        ppcih.account as account, -- 付款银行账户\n        ppcih.amount_currency as amountCurrency, -- 账户币种\n        ppcih.payee as payee, -- 收款人全称\n        ppcih.payee_account as payeeAccount, -- 收款人银行账号\n        ppcih.payee_bank as payeeBank, -- 收款银行\n        ppcih.`status`,  -- 付款状态\n        ppcih.last_update_date, -- 处理时间\n        ppcih.process_message as processMessage, -- 银行反馈信息\n        ppcih.client_id as serialNumber, -- 支付流水号\n        ppcih.payee_prov as payeeProv, -- 收款账户省\n        ppcih.payee_city as payeeCity -- 收款账户市\n        FROM\n        pmc_ceb_pay_instruct ppci,\n        pmc_pay_checks ppc,\n        pmc_citic_pay_instruct_his ppcih\n        <where>\n            ppci.check_id = #{checkId,jdbcType=VARCHAR}\n            AND ppci.check_id = ppc.check_id\n            AND ppcih.pay_id = ppci.pay_id\n            AND ppcih.status in ('PAY_ORDER_GEN','FAILED','PAYED','REFUND')\n        </where>\n    </select>\n\n    <select id=\"getReceiptByPayCheckNum\" resultType=\"com.baidu.pmc.pojo.dto.cmb.ElectronicReceiptDTO\">\n        SELECT refnbr,\n               print_number printInstanceNumber,\n               file_name fileName\n        FROM pmc_receipt_transactions_ref\n        WHERE refnbr in\n            <foreach close=\")\" collection=\"payCheckNums\" item=\"num\" open=\"(\" separator=\",\">\n                #{num}\n            </foreach>\n    </select>\n    <select id=\"selectPayRollPayChecks\" parameterType=\"com.baidu.pmc.pojo.qo.PayChecksQO\"\n            resultType=\"com.baidu.pmc.pojo.dto.PayChecksDTO\">\n        ${safeOrderBy=orderBy,@java.util.Objects@requireNonNull(orderBy == null || orderBy.toString().matches(\"[\\\\w\\\\s$.*,]+\") ? \"\" : null, \"orderBy is not valid\")}\n\n        select\n        <include refid=\"Base_Column_List\"/>\n        from pmc_pay_checks tpc use index (pmc_pay_checks_u1,pmc_pay_checks_n2,pmc_pay_checks_n3,pmc_pay_checks_n4)\n        left join pmc_pay_info tpi\n        on tpc.pay_info_id = tpi.pay_info_id\n        <where>\n            tpc.hangup_flag != 'Y'\n            and tpc.status IN ('CREATED', 'APPROVING')\n            <if test=\"trxType != null and trxType != ''\">\n                and tpc.trx_type = #{trxType,jdbcType=VARCHAR}\n            </if>\n            <if test=\"companyCodes != null and companyCodes.size &gt; 0\">\n                and tpc.company_code in\n                <foreach close=\")\" collection=\"companyCodes\" item=\"companyCode\" open=\"(\" separator=\",\">\n                    #{companyCode}\n                </foreach>\n            </if>\n            <if test=\"teamId != null and teamId != ''\">\n                and (tpc.pay_recipient) IN (select finance_accountant_name FROM pmc_finance_accountant pfa,\n                pmc_finance_team pft\n                where\n                pfa.finance_team_id =\n                pft.finance_team_id AND pft.finance_team_id = #{teamId, jdbcType=BIGINT})\n            </if>\n            <if test=\"sourceNum != null and sourceNum != ''\">\n                and tpc.source_num = #{sourceNum,jdbcType=VARCHAR}\n            </if>\n            <if test=\"voucherSource != null and voucherSource != ''\">\n                and tpc.voucher_source = #{voucherSource,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payChecksAttribute12 != null and payChecksAttribute12 != ''\">\n                and tpc.attribute12 = #{payChecksAttribute12,jdbcType=VARCHAR}\n            </if>\n            <if test=\"currency != null and currency != ''\">\n                and tpc.currency = #{currency,jdbcType=VARCHAR}\n            </if>\n            <if test=\"account != null and account != ''\">\n                and tpc.account = #{account,jdbcType=VARCHAR}\n            </if>\n            <if test=\"acPoolId != null and acPoolId != ''\">\n                and tpc.ac_account_id in (select ac_account_id from pmc_account_pool_detail where ac_pool_id =\n                #{acPoolId,jdbcType=BIGINT})\n            </if>\n            <if test=\"payPlanDateEnd != null\">\n                and tpc.pay_plan_date &lt;= #{payPlanDateEnd,jdbcType=DATE}\n            </if>\n            <if test=\"payCheckNum != null and payCheckNum != ''\">\n                and tpc.pay_check_num = #{payCheckNum,jdbcType=VARCHAR}\n            </if>\n            <if test=\"attribute1 != null and attribute1 != ''\">\n                and tpi.attribute1 = #{attribute1,jdbcType=VARCHAR}\n            </if>\n            <if test=\"status != null and status != ''\">\n                and tpc.status = #{status,jdbcType=VARCHAR}\n            </if>\n            <if test=\"bdDirectFlag != null and bdDirectFlag != ''\">\n                and tpc.bd_direct_flag = #{bdDirectFlag,jdbcType=VARCHAR}\n            </if>\n            <if test=\"amountBegin != null and amountBegin != ''\">\n                and tpc.amount &gt;= #{amountBegin,jdbcType=DECIMAL}\n            </if>\n            <if test=\"amountEnd != null and amountEnd != ''\">\n                and tpc.amount &lt;= #{amountEnd,jdbcType=DECIMAL}\n            </if>\n            <if test=\"tenantId != null and tenantId !=''\">\n                AND tpc.tenant_id = #{tenantId, jdbcType=BIGINT}\n            </if>\n        </where>\n        <if test=\"orderBy != null and orderBy != ''\">\n            order by ${safeOrderBy}\n        </if>\n    </select>\n\n    <select id=\"getOverdraftAmount\" parameterType=\"com.baidu.pmc.pojo.dto.third.PayAmountQueryDTO\"\n            resultType=\"com.baidu.pmc.pojo.dto.cmb.BalanceInfo\">\n        select\n        tpc.account,\n        count(*) overdraftCount,\n        sum(tpc.amount) overdraftAmount\n        from pmc_pay_checks tpc\n        <where>\n            tpc.status in('FAILED_BALANCE')\n            <if test=\"accountList != null and accountList.size &gt; 0\">\n                and tpc.account in\n                <foreach close=\")\" collection=\"accountList\" item=\"account\" open=\"(\" separator=\",\">\n                    #{account}\n                </foreach>\n            </if>\n        </where>\n        GROUP BY tpc.account\n    </select>\n\n    <select id=\"getPreparePaymentAmount\" parameterType=\"com.baidu.pmc.pojo.dto.third.PayAmountQueryDTO\"\n            resultType=\"com.baidu.pmc.pojo.dto.cmb.BalanceInfo\">\n        select\n        tpc.account,\n        count(*) PreparePaymentCount,\n        sum(tpc.amount) PreparePaymentAmount\n        from pmc_pay_checks tpc\n        <where>\n            tpc.status in('APPROVED', 'RELEASED', 'PAY_ORDER_GEN', 'SENDING')\n            and tpc.pay_route = 'EPAYMENT'\n            and tpc.hangup_flag = 'N'\n            and pay_plan_date <![CDATA[  <= ]]> CURDATE()\n            <if test=\"accountList != null and accountList.size > 0\">\n                and tpc.account in\n                <foreach close=\")\" collection=\"accountList\" item=\"account\" open=\"(\" separator=\",\">\n                    #{account}\n                </foreach>\n            </if>\n            <if test=\"tenantId != null and tenantId !=''\">\n                AND tpc.tenant_id = #{tenantId, jdbcType=BIGINT}\n            </if>\n        </where>\n        GROUP BY tpc.account\n    </select>\n\n\n    <!-- 根据供应商编码查询付款单 -->\n    <select id=\"selectBySupplierCode\" resultType=\"com.baidu.pmc.pojo.dto.PmcPayChecksSupplierCodeDTO\">\n        SELECT\n        tpc.* FROM pmc_pay_checks tpc\n        <where>\n            tpc.pay_plan_date >= #{currentDatePlus3Days}\n            and tpc.pay_route = 'EPAYMENT'\n            AND tpc.status IN\n            <foreach collection=\"statusList\" item=\"status\" open=\"(\" separator=\",\" close=\")\">\n                #{status}\n            </foreach>\n            AND tpc.attribute15 = #{supplierCode}\n        </where>\n    </select>\n\n    <!-- 计算供应商当月可融资金额 -->\n    <select id=\"sumAmountBySupplierAndMonth\" resultType=\"java.math.BigDecimal\">\n        SELECT COALESCE(SUM(tpc.amount), 0)\n        FROM pmc_pay_checks tpc\n        WHERE tpc.attribute15 = #{supplierCode}\n        AND tpc.status IN\n        <foreach collection=\"statusList\" item=\"status\" open=\"(\" separator=\",\" close=\")\">\n            #{status}\n        </foreach>\n        AND tpc.pay_plan_date > #{currentDatePlus7Days}\n        AND EXTRACT(YEAR_MONTH FROM tpc.create_date) = EXTRACT(YEAR_MONTH FROM CURRENT_DATE)\n    </select>\n\n    <!-- 计算供应商全年可融资金额 -->\n    <select id=\"sumAmountBySupplierAndYear\" resultType=\"java.math.BigDecimal\">\n        SELECT COALESCE(SUM(tpc.amount), 0)\n        FROM pmc_pay_checks tpc\n        WHERE tpc.attribute15 = #{supplierCode}\n        AND tpc.status IN\n        <foreach collection=\"statusList\" item=\"status\" open=\"(\" separator=\",\" close=\")\">\n            #{status}\n        </foreach>\n        AND tpc.pay_plan_date > #{currentDatePlus7Days}\n        AND EXTRACT(YEAR FROM tpc.create_date) = EXTRACT(YEAR FROM CURRENT_DATE)\n    </select>\n\n</mapper>",
                "afterChangeFileContent": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE mapper PUBLIC \"-//mybatis.org//DTD Mapper 3.0//EN\" \"http://mybatis.org/dtd/mybatis-3-mapper.dtd\">\n<mapper namespace=\"com.baidu.pmc.persistence.mapper.pmc.PmcPayChecksMapper\">\n    <resultMap id=\"BaseResultMap\" type=\"com.baidu.pmc.pojo.model.PmcPayChecks\">\n        <!--\n          WARNING - @mbg.generated\n        -->\n        <id column=\"check_id\" property=\"checkId\" jdbcType=\"BIGINT\"/>\n        <result column=\"pay_check_num\" property=\"payCheckNum\" jdbcType=\"VARCHAR\"/>\n        <result column=\"tenant_id\" property=\"tenantId\" jdbcType=\"BIGINT\"/>\n        <result column=\"source_system\" property=\"sourceSystem\" jdbcType=\"VARCHAR\"/>\n        <result column=\"voucher_source\" property=\"voucherSource\" jdbcType=\"VARCHAR\"/>\n        <result column=\"expense_category\" property=\"expenseCategory\" jdbcType=\"VARCHAR\"/>\n        <result column=\"expense_type\" property=\"expenseType\" jdbcType=\"VARCHAR\"/>\n        <result column=\"source_num\" property=\"sourceNum\" jdbcType=\"VARCHAR\"/>\n        <result column=\"source_id\" property=\"sourceId\" jdbcType=\"BIGINT\"/>\n        <result column=\"source_detail_id\" property=\"sourceDetailId\" jdbcType=\"BIGINT\"/>\n        <result column=\"pay_schedule_id\" property=\"payScheduleId\" jdbcType=\"BIGINT\"/>\n        <result column=\"pay_plan_date\" property=\"payPlanDate\" jdbcType=\"DATE\"/>\n        <result column=\"urgency_flag\" property=\"urgencyFlag\" jdbcType=\"VARCHAR\"/>\n        <result column=\"bd_direct_flag\" property=\"bdDirectFlag\" jdbcType=\"VARCHAR\"/>\n        <result column=\"company_code\" property=\"companyCode\" jdbcType=\"VARCHAR\"/>\n        <result column=\"bank_code\" property=\"bankCode\" jdbcType=\"VARCHAR\"/>\n        <result column=\"trx_type\" property=\"trxType\" jdbcType=\"VARCHAR\"/>\n        <result column=\"pay_method\" property=\"payMethod\" jdbcType=\"VARCHAR\"/>\n        <result column=\"pay_group\" property=\"payGroup\" jdbcType=\"VARCHAR\"/>\n        <result column=\"pay_route\" property=\"payRoute\" jdbcType=\"VARCHAR\"/>\n        <result column=\"ac_account_id\" property=\"acAccountId\" jdbcType=\"BIGINT\"/>\n        <result column=\"account\" property=\"account\" jdbcType=\"VARCHAR\"/>\n        <result column=\"beneficiary_type_flag\" property=\"beneficiaryTypeFlag\" jdbcType=\"VARCHAR\"/>\n        <result column=\"currency\" property=\"currency\" jdbcType=\"VARCHAR\"/>\n        <result column=\"original_pay_check_num\" jdbcType=\"VARCHAR\" property=\"originalPayCheckNum\"/>\n        <result column=\"split_amount\" jdbcType=\"DECIMAL\" property=\"splitAmount\"/>\n        <result column=\"original_amount\" jdbcType=\"DECIMAL\" property=\"originalAmount\"/>\n        <result column=\"amount\" property=\"amount\" jdbcType=\"DECIMAL\"/>\n        <result column=\"amount_currency\" property=\"amountCurrency\" jdbcType=\"VARCHAR\"/>\n        <result column=\"exchange_rate\" property=\"exchangeRate\" jdbcType=\"DECIMAL\"/>\n        <result column=\"exchange_amount\" property=\"exchangeAmount\" jdbcType=\"DECIMAL\"/>\n        <result column=\"pay_desc\" property=\"payDesc\" jdbcType=\"VARCHAR\"/>\n        <result column=\"apply_date\" property=\"applyDate\" jdbcType=\"DATE\"/>\n        <result column=\"status\" property=\"status\" jdbcType=\"VARCHAR\"/>\n        <result column=\"ebank_export_flag\" property=\"ebankExportFlag\" jdbcType=\"VARCHAR\"/>\n        <result column=\"hangup_flag\" property=\"hangupFlag\" jdbcType=\"VARCHAR\"/>\n        <result column=\"naryur\" property=\"naryur\" jdbcType=\"VARCHAR\"/>\n        <result column=\"reference_number\" property=\"referenceNumber\" jdbcType=\"VARCHAR\"/>\n        <result column=\"remark\" property=\"remark\" jdbcType=\"VARCHAR\"/>\n        <result column=\"suspected_desc\" property=\"suspectedDesc\" jdbcType=\"VARCHAR\"/>\n        <result column=\"check_code\" property=\"checkCode\" jdbcType=\"VARCHAR\"/>\n        <result column=\"actual_pay_date\" property=\"actualPayDate\" jdbcType=\"DATE\"/>\n        <result column=\"failure_reasons\" property=\"failureReasons\" jdbcType=\"VARCHAR\"/>\n        <result column=\"pay_recipient\" property=\"payRecipient\" jdbcType=\"VARCHAR\"/>\n        <result column=\"submitter_full_name\" property=\"submitterFullName\" jdbcType=\"VARCHAR\"/>\n        <result column=\"submitter_email_address\" property=\"submitterEmailAddress\" jdbcType=\"VARCHAR\"/>\n        <result column=\"attribute_category\" property=\"attributeCategory\" jdbcType=\"VARCHAR\"/>\n        <result column=\"attribute1\" property=\"attribute1\" jdbcType=\"VARCHAR\"/>\n        <result column=\"attribute2\" property=\"attribute2\" jdbcType=\"VARCHAR\"/>\n        <result column=\"attribute3\" property=\"attribute3\" jdbcType=\"VARCHAR\"/>\n        <result column=\"attribute4\" property=\"attribute4\" jdbcType=\"VARCHAR\"/>\n        <result column=\"attribute5\" property=\"attribute5\" jdbcType=\"VARCHAR\"/>\n        <result column=\"attribute6\" property=\"attribute6\" jdbcType=\"VARCHAR\"/>\n        <result column=\"attribute7\" property=\"attribute7\" jdbcType=\"VARCHAR\"/>\n        <result column=\"attribute8\" property=\"attribute8\" jdbcType=\"VARCHAR\"/>\n        <result column=\"attribute9\" property=\"attribute9\" jdbcType=\"VARCHAR\"/>\n        <result column=\"attribute10\" property=\"attribute10\" jdbcType=\"VARCHAR\"/>\n        <result column=\"attribute11\" property=\"attribute11\" jdbcType=\"VARCHAR\"/>\n        <result column=\"attribute12\" property=\"attribute12\" jdbcType=\"VARCHAR\"/>\n        <result column=\"attribute13\" property=\"attribute13\" jdbcType=\"VARCHAR\"/>\n        <result column=\"attribute14\" property=\"attribute14\" jdbcType=\"VARCHAR\"/>\n        <result column=\"attribute15\" property=\"attribute15\" jdbcType=\"VARCHAR\"/>\n        <result column=\"pay_info_id\" property=\"payInfoId\" jdbcType=\"BIGINT\"/>\n        <result column=\"create_by\" property=\"createBy\" jdbcType=\"VARCHAR\"/>\n        <result column=\"create_date\" property=\"createDate\" jdbcType=\"TIMESTAMP\"/>\n        <result column=\"last_update_by\" property=\"lastUpdateBy\" jdbcType=\"VARCHAR\"/>\n        <result column=\"last_update_date\" property=\"lastUpdateDate\" jdbcType=\"TIMESTAMP\"/>\n        <result column=\"pay_info_complete\" property=\"payInfoComplete\" jdbcType=\"VARCHAR\"/>\n        <result column=\"iface_id\" property=\"ifaceId\" jdbcType=\"BIGINT\"/>\n    </resultMap>\n\n    <sql id=\"Base_Column_List\">\n    tpc.check_id, tpc.pay_check_num, tpc.tenant_id, tpc.source_system, tpc.voucher_source, tpc.expense_category,\n    tpc.expense_type, tpc.source_num, tpc.source_id, tpc.source_detail_id, tpc.pay_schedule_id, tpc.pay_plan_date,\n    tpc.urgency_flag, tpc.company_code, tpc.bank_code, tpc.trx_type, tpc.pay_method, tpc.pay_group, tpc.ac_account_id,\n    tpc.account, tpc.currency, tpc.original_pay_check_num,tpc.split_amount,tpc.original_amount,tpc.amount, tpc.amount_currency, tpc.pay_desc, tpc.apply_date, tpc.status,\n    tpc.hangup_flag, tpc.naryur,tpc.reference_number, tpc.remark, tpc.suspected_desc, tpc.check_code,\n    tpc.bd_direct_flag, tpc.submitter_full_name, tpc.submitter_email_address,\n    tpc.actual_pay_date, tpc.failure_reasons,tpc.pay_recipient, tpc.pay_info_complete, tpc.ebank_export_flag,\n    tpc.attribute1 as payChecksAttribute1, tpc.attribute2 as payChecksAttribute2, tpc.attribute3 as payChecksAttribute3,\n    tpc.attribute4 as payChecksAttribute4, tpc.attribute5 as payChecksAttribute5, tpc.attribute6 as payChecksAttribute6,\n    tpc.attribute7 as payChecksAttribute7, tpc.attribute8 as payChecksAttribute8, tpc.attribute9 as payChecksAttribute9,\n    tpc.attribute10 as payChecksAttribute10, tpc.attribute11 as payChecksAttribute11, tpc.attribute12 as\n    payChecksAttribute12, tpc.attribute13 as payChecksAttribute13, tpc.attribute14 as payChecksAttribute14,\n    tpc.attribute_category as payChecksAttributeCategory,tpc.attribute15 as payChecksAttribute15,\n    tpc.pay_route, tpc.beneficiary_type_flag, tpc.exchange_rate, tpc.exchange_amount,\n    tpi.pay_info_id, tpi.attribute_category, tpi.attribute1, tpi.attribute2, tpi.attribute3, tpi.attribute4,\n    tpi.attribute5, tpi.attribute6, tpi.attribute7, tpi.attribute8, tpi.attribute9, tpi.attribute10, tpi.attribute11,\n    tpi.attribute12, tpi.attribute13, tpi.attribute14, tpi.attribute15,\n    tpc.create_by, tpc.create_date, tpc.last_update_by, tpc.last_update_date, tpc.iface_id\n  </sql>\n    <select id=\"selectReleasedStatus\" parameterType=\"com.baidu.pmc.pojo.qo.PayChecksQO\"\n            resultType=\"com.baidu.pmc.pojo.model.PmcPayChecks\">\n        select tpc.check_id,tpc.pay_check_num,tpc.tenant_id,tpc.pay_plan_date\n        from pmc_pay_checks tpc\n        join pmc_account pa on\n        pa.account_no = tpc.account and pa.currency = tpc.currency and pa.tenant_id = tpc.tenant_id\n        where\n        tpc.pay_route='EPAYMENT'\n        and tpc.pay_group != 'BD_FINANCE'\n        and tpc.hangup_flag='N'\n        and pa.type in ('HOME','THIRDPART','ABROAD')\n        <if test=\"status != null and status != ''\">\n            and tpc.status = #{status,jdbcType=VARCHAR}\n        </if>\n        <if test=\"payPlanDate != null\">\n            and tpc.pay_plan_date &lt;= #{payPlanDate,jdbcType=DATE}\n        </if>\n    </select>\n    <select id=\"selectFailAndRefundQuery\" parameterType=\"com.baidu.pmc.pojo.qo.PayChecksQO\"\n            resultType=\"com.baidu.pmc.pojo.dto.PayChecksDTO\">\n        select\n        <include refid=\"Base_Column_List\"/>,\n        h.create_date hDate\n        from\n        pmc_pay_checks tpc,\n        pmc_pay_info tpi,\n        (\n        select pay_check_num,create_date,max(last_update_date)\n        from pmc_pay_checks_audit_his\n        where pay_check_num in (select pay_check_num from pmc_pay_checks where tenant_id = '1' and status in ('FAILED','REFUND'))\n        and status in('FAILED','REFUND')\n        group by pay_check_num\n        ) h\n        where\n        tpc.pay_info_id = tpi.pay_info_id\n        and tpc.pay_check_num = h.pay_check_num\n        and tpc.tenant_id = '1'\n        and tpc.status in ('FAILED','REFUND')\n        <if test=\"isWeak != null and isWeak != ''\">\n            and h.create_date between current_date()-7 and sysdate()\n        </if>\n    </select>\n\n    <select id=\"selectBankToPay\" parameterType=\"com.baidu.pmc.pojo.qo.PayChecksQO\"\n            resultType=\"com.baidu.pmc.pojo.dto.PayChecksDTO\">\n        select\n        <include refid=\"Base_Column_List\"/>\n        from pmc_pay_checks tpc\n        left join pmc_pay_info tpi\n        on tpc.pay_info_id = tpi.pay_info_id join pmc_account pa on\n        pa.account_no = tpc.account and pa.currency = tpc.currency and pa.tenant_id = tpc.tenant_id\n        where tpc.bd_direct_flag = 'Y'\n        <if test=\"sourceNum != null and sourceNum != ''\">\n            and tpc.source_num = #{sourceNum,jdbcType=VARCHAR}\n        </if>\n        <if test=\"payCheckNum != null and payCheckNum != ''\">\n            and tpc.pay_check_num = #{payCheckNum,jdbcType=VARCHAR}\n        </if>\n        <if test=\"status != null and status != ''\">\n            and tpc.status = #{status,jdbcType=VARCHAR}\n        </if>\n        <if test=\"tenantId != null and tenantId !=''\">\n            and tpc.tenant_id = #{tenantId, jdbcType=BIGINT}\n        </if>\n        <if test=\"payChecksAttribute12 != null and payChecksAttribute12 != ''\">\n            and tpc.attribute12 = #{payChecksAttribute12,jdbcType=VARCHAR}\n        </if>\n        and (tpc.attribute7 = '2' or tpc.attribute7 is null)\n        and tpc.status in ('CREATED', 'APPROVING', 'VERITY_FAILED', 'REFUND', 'APPROVED', 'RELEASED', 'IMCOMPLETE',\n        'FAILED')\n        and tpc.pay_group != 'BD_FINANCE'\n        <if test=\"currentUser != null and currentUser != ''\">\n            AND (EXISTS\n