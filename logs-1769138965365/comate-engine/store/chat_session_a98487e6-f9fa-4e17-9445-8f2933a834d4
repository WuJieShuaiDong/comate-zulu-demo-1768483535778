         pmc_account_pool pool\n                INNER JOIN pmc_account_pool_detail detail ON pool.ac_pool_id = detail.ac_pool_id\n                WHERE\n                pool.ac_pool_code = #{accountPool})\n            </if>\n            <if test=\"account != null and account != ''\">\n                and ac.account_no = #{account}\n            </if>\n            <if test=\"tenantId != null\">\n                and pmc_pay.tenant_id = #{tenantId}\n            </if>\n        </where>\n        <if test=\"groupType != null and groupType eq 'byAccount'\">\n            GROUP BY pmc_pay.trx_type,company_account\n        </if>\n        <if test=\"groupType != null and groupType eq 'byCompany'\">\n            GROUP BY pmc_pay.trx_type,company_code\n        </if>\n    </select>\n\n    <select id=\"selectActualCashPositionByDate\" resultType=\"java.util.Map\">\n        SELECT\n        <if test=\"dateType != null and dateType eq 'byMonth'\">\n               <if test=\"reportDate != null and reportDate.size() > 0\">\n                   <foreach collection=\"reportDate\" item=\"item\" separator=\",\" close=\",\">\n                       sum(case DATE_FORMAT(pmc_pay.actual_pay_date,'%Y-%m') when #{item} then -pmc_pay.amount else 0 end )\n                       as #{item}\n                   </foreach>\n               </if>\n        </if>\n        <if test=\"dateType != null and dateType eq 'byDay'\">\n            <if test=\"reportDate != null and reportDate.size() > 0\">\n                <foreach collection=\"reportDate\" item=\"item\" separator=\",\" close=\",\">\n                    sum(case pmc_pay.actual_pay_date when #{item} then -pmc_pay.amount else 0 end ) as #{item}\n                </foreach>\n            </if>\n        </if>\n        pmc_pay.trx_type cashFlowCode\n        FROM\n        pmc_pay_checks pmc_pay\n        inner JOIN pmc_account ac ON pmc_pay.ac_account_id = ac.ac_account_id\n        <where>\n            ac.type IN ('HOME', 'ABROAD')\n            AND pmc_pay.`status` = 'PAYED'\n            <if test=\"analysisBeginDate != null\">\n                and pmc_pay.actual_pay_date &gt;= #{analysisBeginDate}\n            </if>\n            <if test=\"analysisEndDate != null\">\n                and pmc_pay.actual_pay_date &lt;= #{analysisEndDate}\n            </if>\n            <if test=\"currencyCode != null and currencyCode != ''\">\n                and ac.currency = #{currencyCode}\n            </if>\n            <if test=\"companyList != null and companyList.size() > 0\">\n                and ac.company_code in\n                <foreach collection=\"companyList\" item=\"item\" open=\"(\" close=\")\" separator=\",\">\n                    #{item}\n                </foreach>\n            </if>\n            <if test=\"accountPool != null and accountPool != ''\">\n                and ac.ac_account_id IN (\n                SELECT\n                detail.ac_account_id\n                FROM\n                pmc_account_pool pool\n                INNER JOIN pmc_account_pool_detail detail ON pool.ac_pool_id = detail.ac_pool_id\n                WHERE\n                pool.ac_pool_code = #{accountPool})\n            </if>\n            <if test=\"account != null and account != ''\">\n                and ac.account_no = #{account}\n            </if>\n            <if test=\"tenantId != null\">\n                and pmc_pay.tenant_id = #{tenantId}\n            </if>\n        </where>\n        GROUP BY pmc_pay.trx_type\n        union all\n        SELECT\n        <if test=\"dateType != null and dateType eq 'byMonth'\">\n            <foreach collection=\"reportDate\" item=\"item\" separator=\",\" close=\",\">\n                sum(case DATE_FORMAT(pmc_pay.actual_pay_date,'%Y-%m') when #{item} then pmc_pay.exchange_amount\n                else 0 end\n                ) as #{item}\n            </foreach>\n        </if>\n        <if test=\"dateType != null and dateType eq 'byDay'\">\n            <foreach collection=\"reportDate\" item=\"item\" separator=\",\" close=\",\">\n                sum(case pmc_pay.actual_pay_date when #{item} then pmc_pay.exchange_amount\n                else 0 end ) as #{item}\n            </foreach>\n        </if>\n        pmc_pay.trx_type cashFlowCode\n        FROM\n        pmc_pay_checks pmc_pay\n        left join pmc_pay_info info on pmc_pay.pay_info_id = info.pay_info_id\n        inner JOIN pmc_account ac ON info.attribute2 = ac.account_no and pmc_pay.amount_currency = ac.currency\n        <where>\n            pmc_pay.voucher_source = 'ZJHB' and\n            ac.type IN ('HOME', 'ABROAD')\n            AND pmc_pay.`status` = 'PAYED'\n            <if test=\"analysisBeginDate != null\">\n                and pmc_pay.actual_pay_date &gt;= #{analysisBeginDate}\n            </if>\n            <if test=\"analysisEndDate != null\">\n                and pmc_pay.actual_pay_date &lt;= #{analysisEndDate}\n            </if>\n            <if test=\"currencyCode != null and currencyCode != ''\">\n                and ac.currency = #{currencyCode}\n            </if>\n            <if test=\"companyList != null and companyList.size() > 0\">\n                and ac.company_code in\n                <foreach collection=\"companyList\" item=\"item\" open=\"(\" close=\")\" separator=\",\">\n                    #{item}\n                </foreach>\n            </if>\n            <if test=\"accountPool != null and accountPool != ''\">\n                and ac.ac_account_id IN (\n                SELECT\n                detail.ac_account_id\n                FROM\n                pmc_account_pool pool\n                INNER JOIN pmc_account_pool_detail detail ON pool.ac_pool_id = detail.ac_pool_id\n                WHERE\n                pool.ac_pool_code = #{accountPool})\n            </if>\n            <if test=\"account != null and account != ''\">\n                and ac.account_no = #{account}\n            </if>\n            <if test=\"tenantId != null\">\n                and pmc_pay.tenant_id = #{tenantId}\n  