                "originalContent": "package com.baidu.pmc.web.controller;\n\nimport com.baidu.pmc.common.ResponseMessage;\n\n\nimport com.baidu.pmc.common.exception.WebException;\nimport com.baidu.pmc.common.i18n.constants.ResponseStream;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.pojo.dto.PmcAccountDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyHisDTO;\nimport com.baidu.pmc.pojo.dto.PmcPayChecksSupplierCodeDTO;\nimport com.baidu.pmc.pojo.dto.fnd.CodeDesc;\nimport com.baidu.pmc.pojo.dto.fnd.SuggestParameter;\nimport com.baidu.pmc.pojo.qo.PayChecksQO;\nimport com.baidu.pmc.pojo.qo.PmcAccountSearchQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceSupplierApplyQO;\nimport com.baidu.pmc.pojo.qo.PmcPortalRemainQuotaQO;\nimport com.baidu.pmc.pojo.vo.PageInfo;\nimport com.baidu.pmc.web.clients.PmcPortalClient;\nimport com.baidu.pmc.web.configuration.export.ExportRepeatCheckLock;\nimport com.baidu.pmc.web.utils.ExportExcelUtil;\n\nimport lombok.extern.slf4j.Slf4j;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.http.HttpStatus;\nimport org.springframework.http.ResponseEntity;\nimport org.springframework.stereotype.Controller;\nimport org.springframework.web.bind.annotation.PostMapping;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.ResponseBody;\n\n\n\nimport javax.servlet.http.HttpServletRequest;\nimport javax.servlet.http.HttpServletResponse;\nimport java.math.BigDecimal;\nimport java.util.ArrayList;\nimport java.util.List;\nimport java.util.Map;\n\n/**\n * pmc portal 接入接口\n *\n * @author liumandong\n */\n@RequestMapping(\"/pmcPortal\")\n@Slf4j\n@Controller\npublic class PmcPortalController {\n\n    @Autowired\n    private PmcPortalClient pmcPortalClient;\n\n    @Autowired\n    private ExportExcelUtil exportExcelUtil