set ppc.actual_pay_date = NULL\n    where ppc.check_id = #{checkId}\n  </update>\n\n    <select id=\"selectSuperCorrectionList\" parameterType=\"com.baidu.pmc.pojo.qo.PayChecksQO\"\n            resultType=\"com.baidu.pmc.pojo.dto.PayChecksDTO\">\n        select\n        tpc.check_id,\n        tpc.source_num,\n        tpc.pay_check_num,\n        tpc.pay_plan_date,\n        tpc.trx_type,\n        tpc.company_code,\n        tpc.attribute12 as payChecksAttribute12,\n        tpc.amount_currency,\n        tpc.amount,\n        tpc.pay_group,\n        tpc.status,\n        tpc.source_system,\n        tpc.voucher_source\n        from pmc_pay_checks tpc\n        where tpc.status not in('PAYED','PAY_ORDER_GEN','BANK_PROCESSING')\n        <if test=\"sourceNum != null and sourceNum != ''\">\n            and tpc.source_num = #{sourceNum,jdbcType=VARCHAR}\n        </if>\n        <if test=\"payCheckNum != null and payCheckNum != ''\">\n            and tpc.pay_check_num = #{payCheckNum,jdbcType=VARCHAR}\n        </if>\n        <if test=\"status != null and status != ''\">\n            and tpc.status = #{status,jdbcType=VARCHAR}\n        </if>\n        <if test=\"trxType != null and trxType != ''\">\n            and tpc.trx_type = #{trxType,jdbcType=VARCHAR}\n        </if>\n        <if test=\"sourceSystem != null and sourceSystem != ''\">\n            and tpc.source_system = #{sourceSystem,jdbcType=VARCHAR}\n        </if>\n        <if test=\"voucherSource != null and voucherSource != ''\">\n            and tpc.voucher_source = #{voucherSource,jdbcType=VARCHAR}\n        </if>\n        <if test=\"createDateBegin != null\">\n            AND tpc.create_date &gt;= #{createDateBegin, jdbcType=DATE}\n        </if>\n\n        <if test=\"createDateEnd != null\">\n            AND tpc.create_date &lt; date_add(#{createDateEnd}, interval 1 day)\n        </if>\n        order by tpc.check_id desc\n    </select>\n\n    <select id=\"selectCashPosition\" resultType=\"com.baidu.pmc.pojo.dto.CashPositionPredictDto\">\n        SELECT\n        pmc_pay.trx_type,\n        ac.company_code company_code,\n        ac.account_no company_account,\n        -pmc_pay.amount amount,\n        pmc_pay.status\n        FROM\n        pmc_pay_checks pmc_pay\n        inner JOIN pmc_account ac ON pmc_pay.ac_account_id = ac.ac_account_id\n        <where>\n            ac.type IN ('HOME', 'ABROAD')\n            AND (\n            pmc_pay.pay_plan_date &lt;= #{analysisDate}\n            AND pmc_pay.`status` IN (\n            'CREATED',\n            'APPROVING',\n            'APPROVED',\n            'RELEASED',\n            'PENDING_SENT',\n            'PAYAGAIN',\n            'SAVED',\n            'ACCEPTED',\n            'APPROVED_LEVER1',\n            'APPROVED_LEVER2',\n            'REVISED_REFUSE',\n            'REVISED',\n            'SUSPECTED',\n            'DRAFT',\n            'SENDING',\n            'PAY_ORDER_GEN',\n            'BANK_PROCESSING',\n            'FAILED_BALANCE',\n            'VERITY_FAILED'\n            )\n            OR (\n            pmc_pay.actual_pay_date = #{analysisDate}\n            AND pmc_pay.`status` = 'PAYED'\n            ))\n            <if test=\"currencyCode != null and currencyCode != ''\">\n                and ac.currency = #{currencyCode}\n            </if>\n            <if test=\"companyList != null and companyList.size() > 0\">\n                and ac.company_code in\n                <foreach collection=\"companyList\" item=\"item\" open=\"(\" close=\")\" separator=\",\">\n                    #{item}\n                </foreach>\n            </if>\n            <if test=\"accountPool != null and accountPool != ''\">\n                and ac.ac_account_id IN (\n                SELECT\n                detail.ac_account_id\n                FROM\n                pmc_account_pool pool\n                INNER JOIN pmc_account_pool_detail detail ON pool.ac_pool_id = detail.ac_pool_id\n                WHERE\n                pool.ac_pool_code = #{accountPool