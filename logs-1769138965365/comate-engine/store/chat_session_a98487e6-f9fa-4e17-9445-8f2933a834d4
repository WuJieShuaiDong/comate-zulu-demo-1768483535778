hecksQO) {\n        PmcPayChecksSupplierCodeDTO result = pmcPortalClient.selectPmcPayCheckByPayCheckNum(payChecksQO);\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", result), HttpStatus.OK);\n    }\n\n\n    /**\n     * 导出供应商额度\n     */\n    @PostMapping(\"/export\")\n    @ResponseBody\n    @ExportRepeatCheckLock\n    public ResponseMessage exportSupplierQuotaSet(@RequestBody PmcFinanceSupplierApplyQO query,\n                                                  HttpServletRequest request, HttpServletResponse response) {\n        log.info(\"供应商点击导出融资申请列表\");\n        List<PmcFinanceSupplierApplyDTO> result = pmcPortalClient.export(query);\n        List<List<List<List<String>>>> detailsList = new ArrayList<>();\n        List<List<List<String>>> detailsNew = new ArrayList<>();\n        List<List<String>> resultIn = new ArrayList<>();\n        result.forEach(data -> {\n            List<String> values = new ArrayList<>();\n            // 序号\n            values.add(String.valueOf(result.indexOf(data) + 1));\n            values.add(String.valueOf(data.getSupplierName()));\n            values.add(String.valueOf(data.getApplyNumber()));\n            values.add(String.valueOf(data.getPayCheckNum()));\n            values.add(String.valueOf(data.getPayAmount()));\n            values.add(String.valueOf(data.getFinanceAmount()));\n            values.add(String.valueOf(data.getCurrencyName()));\n            values.add(String.valueOf(data.getBankName()));\n            values.add(String.valueOf(data.getFinanceDay()));\n            values.add(String.valueOf(data.getStatusDesc()));\n            resultIn.add(values);\n        });\n        detailsNew.add(resultIn);\n        detailsList.add(detailsNew);\n        String[] sheetName = {\"供应商融资列表导出\"};\n        String[] headerIn = {\"序号\", \"供应商名称\", \"融资申请单号\", \"付款单号\", \"可融资金额\",\n                \"融资申请金额\", \"币种\", \"融资机构\", \"融资天数\", \"融资申请状态\"};\n        List<String[]> headers = new ArrayList<>();\n        headers.add(headerIn);\n        try {\n            ResponseStream.setHeader(\"供应商融资列表导出\".concat(DateUtils.getDate(\"yyyyMMddHHmmss\")).concat(\".xlsx\"),\n                    ResponseStream.ContentType.EXCEL, request, response);\n            exportExcelUtil.exportMoreDifferentSheetExcel(sheetName, headers, detailsList, response);\n        } catch (Exception e) {\n            throw new WebException(\"导出异常\");\n        }\n        return ResponseMessage.success(\"导出成功\");\n    }\n\n    @PostMapping(\"/selectInit\")\n    public ResponseEntity<Object> selectInit() {\n        Map<String, Object> selectMap = pmcPortalClient.selectInit();\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", selectMap), HttpStatus.OK);\n    }\n\n    /**\n     * 根据输入值模糊检索交易类型code和名称\n     * @param parameter\n     * @return\n     */\n    @PostMapping(value = \"/selectSuggest\")\n    @ResponseBody\n    public ResponseEntity<Object> selectSuggest(@RequestBody SuggestParameter parameter) {\n        List<CodeDesc> codeDescs = pmcPortalClient.selectSuggest(parameter);\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", codeDescs), HttpStatus.OK);\n    }\n\n    /**\n     * 计算供应商可用额度\n     * @return 可用额度\n     */\n    @PostMapping(\"/calculateAvailableQuota\")\n    @ResponseBody\n    public ResponseEntity<Object> calculateAvailableQuota(@RequestBody PmcPortalRemainQuotaQO query) {\n        try {\n            BigDecimal availableQuota = pmcPortalClient.calculateAvailableQuota(query);\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\", availableQuota), HttpStatus.OK);\n        } catch (Exception e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    @PostMapping(\"/selectSuggestAccount\")\n    @ResponseBody\n    public ResponseEntity selectAccount(@RequestBody PmcAccountSearchQO pmcAccountSearchQO) {\n        PageInfo<PmcAccountDTO> data = pmcPortalClient.getAccountViewPage(pmcAccountSearchQO);\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", data), HttpStatus.OK);\n    }\n\n    /**\n     * 生成融资申请单号\n     * @return 融资申请单号，格式：FA+日期时间+4位流水，例如：FA202506111200000001\n     */\n    @PostMapping(\"/generateFinancingNo\")\n    @ResponseBody\n    public ResponseEntity<?> generateFinancingApplicationNo() {\n        String applicationNoJson = pmcPortalClient.generateFinancingApplicationNo();\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", applicationNoJson), HttpStatus.OK);\n    }\n\n    /**\n     * 查询供应商融资指标数据\n     * @return 融资指标DTO\n     */\n    @PostMapping(\"/queryFinanceIndicators\")\n    @ResponseBody\n    public ResponseEntity<?> queryFinanceIndicators() {\n        try {\n            // 获取当前登录供应商编码\n            String supplierCode = pmcPortalClient.getCurrentSupplierCode();\n            FinanceIndicatorDTO indicators = pmcPortalClient.queryFinanceIndicators(supplierCode);\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\", indicators), HttpStatus.OK);\n        } catch (Exception e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n}\n",
