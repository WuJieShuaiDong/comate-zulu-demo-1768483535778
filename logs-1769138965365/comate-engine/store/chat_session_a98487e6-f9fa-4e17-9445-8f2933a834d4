    AND ppcih.status in ('PAY_ORDER_GEN','FAILED','PAYED','REFUND')\n        </where>\n    </select>\n\n    <!--  民生指令详细信息  -->\n    <select id=\"selectCmbcPayListOne\" resultType=\"com.baidu.pmc.pojo.dto.PmcCmbPayInstructDTO\">\n        SELECT\n        ppci.pay_check_num,  -- 付款单号\n        ppcih.pay_date as payDate, -- 实际付款日期\n        ppcih.handle_date as handleDate, -- 实际付款日期\n        ppcih.amount as amount, -- 付款金额\n        ppcih.account as account, -- 付款银行账户\n        ppcih.amount_currency as amountCurrency, -- 账户币种\n        ppcih.payee as payee, -- 收款人全称\n        ppcih.payee_account as payeeAccount, -- 收款人银行账号\n        ppcih.payee_bank as payeeBank, -- 收款银行\n        ppcih.`status`,  -- 付款状态\n        ppcih.last_update_date, -- 处理时间\n        ppcih.process_message as processMessage, -- 银行反馈信息\n        ppcih.process_instance_number as serialNumber, -- 支付流水号\n        ppcih.payee_prov as payeeProv, -- 收款账户省\n        ppcih.payee_city as payeeCity -- 收款账户市\n        FROM\n        pmc_cmbc_pay_instruct ppci,\n        pmc_pay_checks ppc,\n        pmc_cmbc_pay_instruct_his ppcih\n        <where>\n            ppci.check_id = #{checkId,jdbcType=VARCHAR}\n            AND ppci.check_id = ppc.check_id\n            AND ppcih.pay_check_num = ppci.pay_check_num\n            AND ppcih.status in ('PAY_ORDER_GEN','FAILED','PAYED','REFUND')\n        </where>\n    </select>\n\n    <select id=\"findDistinctTrxTypes\" resultType=\"java.lang.String\">\n        select distinct trx_type from pmc_pay_checks;\n    </select>\n\n    <select id=\"findStatisticData\" parameterType=\"com.baidu.pmc.pojo.qo.PayChecksQO\"\n            resultType=\"com.baidu.pmc.pojo.dto.PayStatisticData\">\n        select tpc.check_id, tpc.amount, tpc.status from pmc_pay_checks tpc\n        <where>\n            <if test=\"trxType != null and trxType != ''\">\n                and tpc.trx_type = #{trxType,jdbcType=VARCHAR}\n            </if>\n            <if test=\"trxTypes != null and trxTypes.size &gt; 0\">\n                and tpc.trx_type in\n                <foreach close=\")\" collection=\"trxTypes\" item=\"trxType\" open=\"(\" separator=\",\">\n                    #{trxType}\n                </foreach>\n            </if>\n            <if test=\"companyCodes != null and companyCodes.size &gt; 0\">\n                and tpc.company_code in\n                <foreach close=\")\" collection=\"companyCodes\" item=\"companyCode\" open=\"(\" separator=\",\">\n                    #{companyCode}\n                </foreach>\n            </if>\n            <if test=\"voucherSource != null and voucherSource != ''\">\n                and tpc.voucher_source = #{voucherSource,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payPlanDateBegin != null\">\n                and tpc.pay_plan_date &gt;= #{payPlanDateBegin,jdbcType=DATE}\n            </if>\n            <if test=\"payPlanDateEnd != null\">\n                and tpc.pay_plan_date &lt;= #{payPlanDateEnd,jdbcType=DATE}\n            </if>\n            <if test=\"sourceNum != null and sourceNum != ''\">\n                and tpc.source_num = #{sourceNum,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payCheckNum != null and payCheckNum != ''\">\n                and tpc.pay_check_num = #{payCheckNum,jdbcType=VARCHAR}\n            </if>\n            <if test=\"status != null and status != ''\">\n                and tpc.status = #{status,jdbcType=VARCHAR}\n            </if>\n            <if test=\"acPoolId != null and acPoolId != ''\">\n                and tpc.ac_account_id in (select ac_account_id from pmc_account_pool_detail where ac_pool_id =\n                #{acPoolId,jdbcType=BIGINT})\n            </if>\n            <if test=\"currency != null and currency != ''\">\n                and tpc.currency = #{currency,jdbcType=VARCHAR}\n            </if>\n            <if test=\"amountCurrency != null and amountCurrency != ''\">\n                and tpc.amount_currency = #{amountCurrency,jdbcType=VARCHAR}\n            </if>\n            <if test=\"account != null and account != ''\">\n                and tpc.account = #{account,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payGroup != null and payGroup != ''\">\n                and tpc.pay_group = #{payGroup,jdbcType=VARCHAR}\n            </if>\n            <if test=\"bankCode != null and bankCode != ''\">\n                and tpc.bank_code = #{bankCode,jdbcType=VARCHAR}\n            </if>\n            <if test=\"defaultStatus != null and defaultStatus.size &gt; 0\">\n                and tpc.status in\n                <foreach close=\")\" collection=\"defaultStatus\" item=\"item\" open=\"(\" separator=\",\">\n                    #{item}\n                </foreach>\n            </if>\n            <if test=\"defaultPayRoute != null and defaultPayRoute.size &gt; 0\">\n                and tpc.pay_route in\n                <foreach close=\")\" collection=\"defaultPayRoute\" item=\"item\" open=\"(\" separator=\",\">\n                    #{item}\n                </foreach>\n            </if>\n            <if test=\"checkIds != null and checkIds.size &gt; 0\">\n                and tpc.check_id in\n                <foreach close=\")\" collection=\"checkIds\" item=\"checkId\" open=\"(\" separator=\",\">\n                    #{checkId}\n                </foreach>\n            </if>\n            <if test=\"amount != null\">\n                and tpc.amount = #{amount,jdbcType=DECIMAL}\n            </if>\n            <if test=\"exclusivePayGroup != null and exclusivePayGroup!= ''\">\n                and tpc.pay_group != #{exclusivePayGroup,jdbcType=VARCHAR}\n            </if>\n            <if test=\"applyDateBegin != null\">\n                and tpc.apply_date &gt;= #{applyDateBegin,jdbcType=DATE}\n            </if>\n            <if test=\"applyDateEnd != null\">\n                and tpc.apply_date &lt;= #{applyDateEnd,jdbcType=DATE}\n            </if>\n            <if test=\"amountBegin != null and amountBegin != ''\">\n                and tpc.amount &gt;= #{amountBegin,jdbcType=DECIMAL}\n            </if>\n            <if test=\"amountEnd != null and amountEnd != ''\">\n                and tpc.amount &lt;= #{amountEnd,jdbcType=DECIMAL}\n            </if>\n            <if test=\"payMethod != null and payMethod != ''\">\n                and tpc.pay_method = #{payMethod,jdbcType=VARCHAR}\n            </if>\n            <if test=\"hangupFlag != null and hangupFlag != ''\">\n                and tpc.hangup_flag = #{hangupFlag,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payRoute != null and payRoute != ''\">\n                and tpc.pay_route = #{payRoute,jdbcType=VARCHAR}\n            </if>\n            <if test=\"tenantId != null and tenantId !=''\">\n                AND tpc.tenant_id = #{tenantId, jdbcType=BIGINT}\n            </if>\n        </where>\n        order by tpc.urgency_flag desc, tpc.pay_plan_date asc\n    </select>\n\n    <select id=\"selectBankPayChecks\" parameterType=\"com.baidu.pmc.pojo.qo.PayChecksQO\"\n            resultType=\"com.baidu.pmc.pojo.dto.PayChecksDTO\">\n        <!-- 过滤避免SQL注入 -->\n        ${safeOrderBy=orderBy,@java.util.Objects@requireNonNull(orderBy == null || orderBy.toString().matches(\"[\\\\w\\\\s$.*,]+\") ? \"\" : null, \"orderBy is not valid\")}\n        select\n        <include refid=\"Base_Column_List\"/>\n        from pmc_pay_checks tpc use index (pmc_pay_checks_u1,pmc_pay_checks_n2,pmc_pay_checks_n3,pmc_pay_checks_n4)\n        left join pmc_pay_info tpi\n        on tpc.pay_info_id = tpi.pay_info_id\n        <where>\n            tpc.hangup_flag != 'Y'\n            <if test=\"bdDirectFlag != null and bdDirectFlag != ''\">\n                and tpc.bd_direct_flag = #{bdDirectFlag,jdbcType=VARCHAR}\n            </if>\n            <if test=\"trxType != null and trxType != ''\">\n                and tpc.trx_type = #{trxType,jdbcType=VARCHAR}\n            </if>\n            <if test=\"companyCodes != null and companyCodes.size &gt; 0\">\n                and tpc.company_code in\n                <foreach close=\")\" collection=\"companyCodes\" item=\"companyCode\" open=\"(\" separator=\",\">\n                    #{companyCode}\n                </foreach>\n            </if>\n            <if test=\"voucherSource != null and voucherSource != ''\">\n                and tpc.voucher_source = #{voucherSource,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payPlanDateBegin != null\">\n                and tpc.pay_plan_date &gt;= #{payPlanDateBegin,jdbcType=DATE}\n            </if>\n            <if test=\"payPlanDateEnd != null\">\n                and tpc.pay_plan_date &lt;= #{payPlanDateEnd,jdbcType=DATE}\n            </if>\n            <if test=\"sourceNum != null and sourceNum != ''\">\n                and tpc.source_num = #{sourceNum,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payCheckNum != null and payCheckNum != ''\">\n                and tpc.pay_check_num = #{payCheckNum,jdbcType=VARCHAR}\n            </if>\n            <if test=\"status != null and status != ''\">\n                and tpc.status = #{status,jdbcType=VARCHAR}\n            </if>\n            <if test=\"acPoolId != null and acPoolId != ''\">\n                and tpc.ac_account_id in (select ac_account_id from pmc_account_pool_detail where ac_pool_id =\n                #{acPoolId,jdbcType=BIGINT})\n            </if>\n            <if test=\"currency != null and currency != ''\">\n                and tpc.currency = #{currency,jdbcType=VARCHAR}\n            </if>\n            <if test=\"amountCurrency != null and amountCurrency != ''\">\n                and tpc.amount_currency = #{amountCurrency,jdbcType=VARCHAR}\n            </if>\n            <if test=\"account != null and account != ''\">\n                and tpc.account = #{account,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payGroup != null and payGroup != ''\">\n                and tpc.pay_group = #{payGroup,jdbcType=VARCHAR}\n            </if>\n            <if test=\"bankCode != null and bankCode != ''\">\n                and tpc.bank_code = #{bankCode,jdbcType=VARCHAR}\n            </if>\n            <if test=\"defaultStatus != null and defaultStatus.size &gt; 0\">\n                and tpc.status in\n                <foreach close=\")\" collection=\"defaultStatus\" item=\"item\" open=\"(\" separator=\",\">\n                    #{item}\n                </foreach>\n            </if>\n            <if test=\"defaultPayRoute != null and defaultPayRoute.size &gt; 0\">\n                and tpc.pay_route in\n                <foreach close=\")\" collection=\"defaultPayRoute\" item=\"item\" open=\"(\" separator=\",\">\n                    #{item}\n                </foreach>\n            </if>\n            <if test=\"checkIds != null and checkIds.size &gt; 0\">\n                and tpc.check_id in\n                <foreach close=\")\" collection=\"checkIds\" item=\"checkId\" open=\"(\" separator=\",\">\n                    #{checkId}\n                </foreach>\n            </if>\n            <if test=\"amount != null\">\n                and tpc.amount = #{amount,jdbcType=DECIMAL}\n            </if>\n            <if test=\"payee != null and payee != ''\">\n                and tpi.attribute1 = #{payee,jdbcType=VARCHAR}\n            </if>\n            <if test=\"exclusivePayGroup != null and exclusivePayGroup!= ''\">\n                and tpc.pay_group != #{exclusivePayGroup,jdbcType=VARCHAR}\n            </if>\n            <if test=\"applyDateBegin != null\">\n                and tpc.apply_date &gt;= #{applyDateBegin,jdbcType=DATE}\n            </if>\n            <if test=\"applyDateEnd != null\">\n                and tpc.apply_date &lt;= #{applyDateEnd,jdbcType=DATE}\n            </if>\n            <if test=\"amountBegin != null and amountBegin != ''\">\n                and tpc.amount &gt;= #{amountBegin,jdbcType=DECIMAL}\n            </if>\n            <if test=\"amountEnd != null and amountEnd != ''\">\n           