rApply.setLastUpdateDate(new Date());\n            }\n            pmcFinanceSupplierApplyMapper.updateByPrimaryKey(pmcFinanceSupplierApply);\n        } else {\n            // 设置操作人和时间\n            if (StringUtils.isBlank(pmcFinanceSupplierApply.getCreateBy())) {\n                pmcFinanceSupplierApply.setCreateBy(PmcPortalLogin.getLoginAccount());\n            }\n            pmcFinanceSupplierApply.setCreateDate(new Date());\n            pmcFinanceSupplierApply.setLastUpdateBy(pmcFinanceSupplierApply.getCreateBy());\n            pmcFinanceSupplierApply.setLastUpdateDate(new Date());\n            if (StringUtils.isBlank(pmcFinanceSupplierApply.getApplySubmit())) {\n                pmcFinanceSupplierApply.setApplySubmit(pmcFinanceSupplierApply.getCreateBy());\n            }\n            if (StringUtils.isBlank(pmcFinanceSupplierApply.getStatus())) {\n                pmcFinanceSupplierApply.setStatus(SupplierFinancingApplyStatus.SAVED.name());\n            }\n            pmcFinanceSupplierApplyMapper.insert(pmcFinanceSupplierApply);\n            log.info(\"成功创建融资申请单，申请单号: {},付款单号:{}\", pmcFinanceSupplierApply.getApplyNumber(), pmcFinanceSupplierApply.getPayCheckNum());\n        }\n\n        PmcFinanceSupplierApplyHis his = new PmcFinanceSupplierApplyHis();\n        // 保存不增加操作步骤的记录，从提交开始增加\n        if (SupplierFinancingApplyStatus.SAVED.name().equals(pmcFinanceSupplierApplyDto.getStatus())) {\n            return pmcFinanceSupplierApply.getApplyId();\n        }\n        BeanUtils.copyProperties(pmcFinanceSupplierApplyDto, his);\n        // 操作人 供应商或者银行\n        his.setCreateDate(new Date());\n        his.setLastUpdateDate(new Date());\n        // SUBMITTED:提交申请\n        // BANK_CONFIRMED:网银确认\n        // BANK_REVIEWING:银行审核\n        // BANK_FUNDED:银行放款\n        if (!StringUtils.isBlank(his.getOperationNode()) && FinancingStatus.getNextStatus(his.getOperationNode()) != null) {\n            // 设置下一个操作步骤\n            his.setAttribute1(FinancingStatus.getNextStatus(his.getOperationNode()).getDescription());\n        }\n        pmcFinanceSupplierApplyHisMapper.insert(his);\n        log.info(\"成功创建融资申请历史记录，申请单号: {} ,付款单号:{}\", his.getApplyNumber(), his.getPayCheckNum());\n\n        return pmcFinanceSupplierApply.getApplyId();\n    }\n\n    /**\n    *  根据付款单号查询对应的付款数据\n    * */\n    @Override\n    public PmcPayChecksSupplierCodeDTO selectPmcPayCheckByPayCheckNum(PayChecksQO payChecksQO) {\n        // 1. 参数校验\n        if (payChecksQO == null || StringUtils.isBlank(payChecksQO.getPayCheckNum())) {\n            throw new IllegalArgumentException(\"付款单号不能为空\");\n        }\n\n        // 2. 查询付款记录\n        List<PayChecksDTO> pmcPayCheck = pmcPayChecksMapper.selectAllPayChecks(payChecksQO);\n\n        PmcPayChecksSupplierCodeDTO dto = new PmcPayChecksSupplierCodeDTO();\n        if (pmcPayCheck == null) {\n            return dto;  // 返回空DTO\n        }\n\n        // 3. 属性拷贝\n        BeanUtils.copyProperties(pmcPayCheck.get(0), dto);\n\n        // 4. 计算日期差\n        if (dto.getPayPlanDate() != null) {\n            dto.setFinanceDays(DateUtils.daysBetween(DateUtils.getCurrentDate(), dto.getPayPlanDate()));\n        }\n\n        // 5. 补全供应商信息\n        if (StringUtils.isBlank(dto.getSupplierCode())) {\n            String supId = PmcPortalLogin.getSupId();\n            PmcDataP2pSupplier supplier = pmcDataP2pSupplierMapper.selectBySupplierCode(supId);\n            if (supplier == null) {\n                throw new ServiceException(\"供应商信息不存在: supId=\" + supId);\n            }\n            dto.setSupplierCode(supplier.getSupplierCode());\n            dto.setSupplierName(supplier.getSupplierName());\n        }\n\n        return dto;\n    }\n\n    @Override\n    public PageInfo<PmcFinanceCompQuotaSetDTO> selectQuotaSet(PmcFinanceCompQuotaSetQO query) {\n        // 判断是否分页\n        if (query.getPageNum() > 0\n                && query.getPageSize() > 0) {\n            PageHelper.startPage(\n                    query.getPageNum(),\n                    query.getPageSize()\n            );\n        }\n        return new PageInfo<>(getQuotaSetList(query));\n    }\n\n    @Override\n    public List<PmcFinanceCompQuotaSetDTO> exportQuotaSet(PmcFinanceCompQuotaSetQO query) {\n        return getQuotaSetList(query);\n    }\n\n    @Override\n    public Long saveOrUpdateCompQuotaSet(PmcFinanceCompQuotaSetDTO dto) {\n        PmcFinanceCompQuotaSet pmcFinanceCompQuotaSet = new PmcFinanceCompQuotaSet();\n        BeanUtils.copyProperties(dto, pmcFinanceCompQuotaSet);\n        // 插入数据\n        if (pmcFinanceCompQuotaSetMapper.selectCount(pmcFinanceCompQuotaSet) > 0) {\n            pmcFinanceCompQuotaSet.setLastUpdateDate(new Date());\n            pmcFinanceCompQuotaSetMapper.updateByPrimaryKey(pmcFinanceCompQuotaSet);\n            return pmcFinanceCompQuotaSet.getId();\n        } else {\n            pmcFinanceCompQuotaSet.setCreateDate(new Date());\n            pmcFinanceCompQuotaSetMapper.insert(pmcFinanceCompQuotaSet);\n        }\n        return 0L;\n    }\n\n    @Override\n    public PageInfo<PmcFinanceSupplierQuotaSet> selectSupplierQuotaSet(PmcFinanceSupplierQuotaSetQO query) {\n        // 判断是否分页\n        if (query.getPageNum() > 0 && query.getPageSize() > 0) {\n            PageHelper.startPage(query.getPageNum(), query.getPageSize());\n        }\n        return new PageInfo<>(getSupplierQuotaSetList(query));\n    }\n\n    @Override\n    public List<SupplierFinancingUsageDTO> queryFinancingUsage(SupplierFinancingUsageQO qo) {\n        return List.of();\n    }\n\n    @Override\n    public List<PmcFinanceSupplierQuotaSet> exportSupplierQuotaSet(PmcFinanceSupplierQuotaSetQO query) {\n        return getSupplierQuotaSetList(query);\n    }\n\n\n    @Override\n    public Long saveOrUpdateSupplierQuotaSet(PmcFinanceSupplierQuotaSet dto) {\n        PmcFinanceSupplierQuotaSet pmcFinanceSupplierQuotaSet = new PmcFinanceSupplierQuotaSet();\n        BeanUtils.copyProperties(dto, pmcFinanceSupplierQuotaSet);\n        // 插入数据\n        if (pmcFinanceSupplierQuotaSetMapper.selectCount(pmcFinanceSupplierQuotaSet) > 0) {\n            pmcFinanceSupplierQuotaSet.setLastUpdateDate(new Date());\n            pmcFinanceSupplierQuotaSetMapper.updateByPrimaryKey(pmcFinanceSupplierQuotaSet);\n        } else {\n            pmcFinanceSupplierQuotaSet.setCreateDate(new Date());\n            pmcFinanceSupplierQuotaSetMapper.insert(pmcFinanceSupplierQuotaSet);\n        }\n        return pmcFinanceSupplierQuotaSet.getId();\n    }\n\n\n    private List<PmcFinanceSupplierQuotaSet> getSupplierQuotaSetList(PmcFinanceSupplierQuotaSetQO query) {\n        Example example = new Example(PmcFinanceSupplierQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n        String supId = PmcPortalLogin.getSupId();\n        PmcDataP2pSupplier supplier  = null;\n        if (StringUtils.isNotBlank(supId)) {\n            supplier = pmcDataP2pSupplierMapper.selectBySupplierCode(supId);\n            if (supplier == null) {\n                throw new ServiceException(\"供应商信息不存在: supId=\" + supId);\n            }\n        }\n        if (StringUtils.isBlank(query.getSupplierName()) && supplier != null) {\n            query.setSupplierName(supplier.getSupplierName());\n        }\n        if (StringUtils.isBlank(query.getSupplierCode()) && supplier != null) {\n            query.setSupplierCode(supplier.getSupplierCode());\n        }\n        criteria.andEqualTo(\"supplierName\", query.getSupplierName())\n                .andEqualTo(\"supplierCode\", query.getSupplierCode());\n\n        if (StringUtils.isNotBlank(query.getRegistrationCode())) {\n            criteria.andEqualTo(\"registrationCode\", query.getRegistrationCode());\n        }\n        if (StringUtils.isNotBlank(query.getFinanceFlag())) {\n            criteria.andEqualTo(\"financeFlag\", query.getFinanceFlag());\n        }\n        List<PmcFinanceSupplierQuotaSet> list = pmcFinanceSupplierQuotaSetMapper.selectByExample(example);\n        return list;\n    }\n\n\n    private List<PmcFinanceCompQuotaSetDTO> getQuotaSetList(PmcFinanceCompQuotaSetQO query) {\n        Example example = new Example(PmcFinanceCompQuotaSet.class);\n\n        Example.Criteria criteria = example.createCriteria();\n        if (StringUtils.isNotBlank(query.getBankCode())) {\n            criteria.andEqualTo(\"bankCode\", query.getBankCode());\n        }\n        if (StringUtils.isNotBlank(query.getCreditCompCode())) {\n            criteria.andEqualTo(\"creditCompCode\", query.getCreditCompCode());\n        }\n        if (StringUtils.isNotBlank(query.getEnableFlag())) {\n            criteria.andEqualTo(\"enableFlag\", query.getEnableFlag());\n        }\n        if (StringUtils.isNotBlank(query.getPayAccount())) {\n            criteria.andEqualTo(\"payAccount\", query.getPayAccount());\n        }\n        List<PmcFinanceCompQuotaSet> list = pmcFinanceCompQuotaSetMapper.selectByExample(example);\n\n\n        List<PmcFinanceCompQuotaSetDTO> dtoList = list.stream().map(his -> {\n            PmcFinanceCompQuotaSetDTO dto = new PmcFinanceCompQuotaSetDTO();\n            BeanUtils.copyProperties(his, dto);\n            dto.setCompanyName(operateByJDBC.translate(BD_COMPANY, StringUtils.toString(dto.getCompanyCode())));\n            dto.setCreditCompName(operateByJDBC.translate(BD_COMPANY, StringUtils.toString(dto.getCreditCompCode())));\n            dto.setBankName(operateByJDBC.translate(BANK, StringUtils.toString(dto.getBankCode())));\n            return dto;\n        }).collect(Collectors.toList());\n        setPayAccountNames(dtoList);\n        return dtoList;\n    }\n\n\n    private void setPayAccountNames(List<PmcFinanceCompQuotaSetDTO> list) {\n        if (CollectionUtils.isEmpty(list)) {\n            return;\n        }\n        // 收集所有accountNo\n        List<String> accountNos = list.stream()\n                .map(PmcFinanceCompQuotaSet::getPayAccount)\n                .filter(StringUtils::isNotBlank)\n                .distinct()\n                .collect(Collectors.toList());\n\n        if (CollectionUtils.isEmpty(accountNos)) {\n            return;\n        }\n        // 批量查询accountName\n        Map<String, String> accountNameMap = accountMapper.batchSelectAccountNames(accountNos);\n\n        // 为每条记录设置PayAccountName\n        list.forEach(dto -> {\n            if (StringUtils.isNotBlank(dto.getPayAccount())) {\n                dto.setPayAccountName(accountNameMap.get(dto.getPayAccount()));\n                String currencyName = (operateByJDBC.translate(CURRENCY, \"CNY\"));\n                dto.setPayAccountInfo(dto.getPayAccount() + \"-\"+ currencyName+ \"-\"\n                        + dto.getBankName()+ \"-\"+dto.getPayAccountName());\n            }\n        });\n    }\n    @Override\n    public Map<String, Object> getSelectInit() {\n        Map<String, Object> result = new HashMap<>();\n        // 获取所有状态及描述\n        List<CodeDesc> statusList = SupplierFinancingApplyStatus.getAllStatuses();\n\n        // 获取融资机构列表\n        List<CodeDesc> bankList = operateByJDBC.selectByCon(BANK_FINANCING_RATES)\n                .stream()\n                .map(info -> new CodeDesc(info.getFlexValue(), info.getDescription()))\n                .collect(Collectors.toList());\n\n        List<FndFlexValueDTO> enbleFlagList = fndFlexValueApi.selectByType(Constants.PmcLookupInfoCode.YES_NO);\n\n\n        // 获取公司列表\n        List<CodeDesc> cnmpanyList = operateByJDBC.selectByCon(BD_COMPANY)\n                .stream()\n                .map(info -> new CodeDesc(info.getFlexValue(), info.getDescription()))\n                .collect(Collectors.toList());\n\n        // 处理步骤列表\n        List<CodeDesc> dealList = FinancingStatus.getAllStatuses();\n\n        result.put(\"yesNo\", fndFlexValueApi.convertToCodedLabelDTO(enbleFlagList));\n        result.put(\"statusList\", statusList);\n        result.put(\"bankList\", bankList);\n        result.put(\"companyList\", cnmpanyList);\n        result.put(\"dealList\", dealList);\n\n        return result;\n    }\n\n    @Override\n    public BigDecimal calculateAvailableQuota(PmcPortalRemainQuotaQO qo){\n        BigDecimal availableQuota;\n        // 1. 获取供应商额度\n        Example example = new Example(PmcFinanceSupplierQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n        criteria.andEqualTo(\"supplierCode\", qo.getSupplierCode());\n        criteria.andEqualTo(\"financeFlag\", \"1\");\n        List<PmcFinanceSupplierQuotaSet> pmcFinanceSupplierQuotaSet\n                = pmcFinanceSupplierQuotaSetMapper.selectByExample(criteria);\n        availableQuota = pmcFinanceSupplierQuotaSet.get(0).getCreditQuota();\n\n        // 2. 获取已占用金额\n        List<String> targetStatuses = Arrays.asList(\n                SupplierFinancingApplyStatus.SUBMITTED.name(),\n                SupplierFinancingApplyStatus.BANK_PROCESSING.name(),\n                SupplierFinancingApplyStatus.PENDING_DISBURSEMEN.name(),\n                SupplierFinancingApplyStatus.DISBURSED.name(),\n                SupplierFinancingApplyStatus.SETTLED.name());\n\n        Map<String, Object> resultMap = pmcFinanceSupplierApplyMapper.selectSummaryByStatus(targetStatuses,\n                qo.getSupplierCode());\n        BigDecimal usedQuota = (BigDecimal) resultMap.get(\"totalAmount\");\n\n        return availableQuota.subtract(usedQuota);\n    }\n\n    @Override\n    public List<CodeDesc> selectSuggest(SuggestParameter parameter) {\n        if (parameter == null || StringUtils.isBlank(parameter.getInputVal())) {\n            throw new IllegalArgumentException(\"查询关键字不能为空\");\n        }\n\n        Example example = new Example(PmcDataP2pSupplier.class);\n        Example.Criteria criteria = example.createCriteria();\n\n        // 构建模糊查询条件\n        String keyword = \"%\" + parameter.getInputVal() + \"%\";\n        criteria.orLike(\"supplierName\", keyword)\n               .orLike(\"registrationCode\", keyword)\n               .orLike(\"supplierId\", keyword);\n\n        // 执行查询\n        List<PmcDataP2pSupplier> suppliers = pmcDataP2pSupplierMapper.selectByExample(example);\n\n        // 转换为CodeDesc列表\n        return suppliers.stream()\n                .map(supplier -> new CodeDesc(\n                    String.valueOf(supplier.getSupplierId()),\n                    supplier.getSupplierName() + \"~\" + supplier.getRegistrationCode() + \"\"\n                ))\n                .collect(Collectors.toList());\n    }\n    @Override\n    public String generateFinancingApplicationNo() {\n        return FinancingApplicationNoUtil.generate();\n    }\n\n    @Override\n    public String commonCheckData(PmcFinanceBankBaseQO query, String methodName) {\n        try {\n            log.info(\"执行通用数据校验，方法名：{}，参数类型：{}\", methodName,\n                    query != null ? query.getClass().getSimpleName() : \"null\");\n            switch (methodName) {\n                case \"calculateFinancing\":\n                    return validateCalculateFinancing(query);\n                case \"submitFinancingApply\":\n                    return validateSubmitFinancingApply(query);\n                case \"queryFinancingResult\":\n                    return validateQueryFinancingResult(query);\n                case \"queryFinancingQuota\":\n                    return validateQueryFinancingQuota(query);\n                case \"uploadFinancingAttachment\":\n                case \"supplementFinancingAttachment\":\n                    return validateFileOperation(query);\n                default:\n                    log.warn(\"未知的方法名：{}，执行默认校验\", methodName);\n                    return validateDefault(query);\n            }\n\n        } catch (Exception e) {\n            log.error(\"通用数据校验异常，方法名：{}\", methodName, e);\n            return \"数据校验异常：\" + e.getMessage();\n        }\n    }\n\n    /**\n     * 融资测算校验\n     */\n    private String validateCalculateFinancing(PmcFinanceBankBaseQO query) {\n        return \"ok\";\n    }\n\n    /**\n     * 融资申请提交校验\n     */\n    private String validateSu