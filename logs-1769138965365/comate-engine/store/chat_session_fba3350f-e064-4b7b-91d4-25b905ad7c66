tructQO payInstructQO) {\n        if (payInstructQO.getPayDateEnd() != null) {\n            payInstructQO.setPayDateEnd(DateUtils.addDays(payInstructQO.getPayDateEnd(), 1));\n        }\n        return cmbClient.getSummaryInstruct(payInstructQO);\n    }\n\n    /**\n     * 导出支付指令列表文件的方法。\n     *\n     * @param payInstructQO 请求参数对象，包含了需要查询的参数和过滤条件等信息。\n     * @param request       HTTP 请求对象，用于获取客户端相关信息（例如：IP、端口）。\n     * @param response      HTTP 返回响应对象，用于返回数据或者响应头等内容给客户端。\n     */\n    @ApiOperation(value = \"付款指令监控列表导出\", httpMethod = \"POST\", notes = \"付款指令监控列表导出\")\n    @PostMapping(\"/export_instruct_list\")\n    @ExportRepeatCheckLock\n    public void exportInstructList(PayInstructQO payInstructQO, HttpServletRequest request,\n                                   HttpServletResponse response) {\n        List<PayInstructDTO> list;\n        if (PayBankConstants.BOC_BANK_CODE.equals(payInstructQO.getBank())) {\n            list = bocClient.exportBocInstruct(payInstructQO);\n        } else if (PayBankConstants.CCB_BANK_CODE.equals(payInstructQO.getBank())) {\n            list = ccbClient.exportCcbInstruct(payInstructQO);\n        } else if (PayBankConstants.CMBC_BANK_CODE.equals(payInstructQO.getBank())) {\n            list = cmbcClient.exportCmbcInstruct(payInstructQO);\n        } else if (PayBankConstants.CIB_BANK_CODE.equals(payInstructQO.getBank())) {\n            list = cibClient.exportCibInstruct(payInstructQO);\n        } else if (PayBankConstants.ABC_BANK_CODE.equals(payInstructQO.getBank())) {\n            list = abcClient.exportAbcInstruct(payInstructQO);\n        } else if (PayBankConstants.CEB_BANK_CODE.equals(payInstructQO.getBank())) {\n            list = cebClient.exportCebInstruct(payInstructQO);\n        } else if (PayBankConstants.CITIC_BANK_CODE.equals(payInstructQO.getBank())) {\n            list = citicClient.exportCiticInstruct(payInstructQO);\n        } else if (PayBankConstants.ICBC_BANK_CODE.equals(payInstructQO.getBank())) {\n            list 