cFinanceSupplierApply apply = applyMapper.selectByPrimaryKey(applyId);\n        if (apply == null) {\n            return ResponseMessage.fail(\"未找到该融资申请\");\n        }\n        \n        // 3. 上传文件\n        String filePath;\n        try {\n            filePath = fileUploadUtils.upload(file);\n        } catch (Exception e) {\n            throw new ServiceException(\"文件上传失败\", e);\n        }\n        \n        // 4. 更新申请附件信息\n        apply.setAttachmentPath(filePath);\n        applyMapper.updateByPrimaryKeySelective(apply);\n        \n        // 5. 返回上传结果\n        return ResponseMessage.success(\"文件上传成功\", filePath);\n    }\n\n    @Override\n    @Transactional\n    public ResponseMessage supplementFinancingAttachment(MultipartFile file, Long applyId) {\n        // 1. 参数校验\n        if (file == null || file.isEmpty() || applyId == null) {\n            return ResponseMessage.fail(\"参数错误：文件或申请ID不能为空\");\n        }\n        \n        // 2. 检查申请是否存在\n        PmcFinanceSupplierApply apply = applyMapper.selectByPrimaryKey(applyId);\n        if (apply == null) {\n            return ResponseMessage.fail(\"未找到该融资申请\");\n        }\n        \n        // 3. 上传补充文件\n        String supplementPath;\n        try {\n            supplementPath = fileUploadUtils.upload(file);\n        } catch (Exception e) {\n            throw new ServiceException(\"文件上传失败\", e);\n        }\n        \n        // 4. 更新申请补充附件信息\n        apply.setSupplementPath(supplementPath);\n        applyMapper.updateByPrimaryKeySelective(apply);\n        \n        // 5. 返回补充结果\n        return ResponseMessage.success(\"文件补充成功\", supplementPath);\n    }\n}",
