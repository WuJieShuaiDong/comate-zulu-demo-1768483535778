Quota().subtract(quota.getUsedQuota());\n        \n        // 4. 构建返回结果\n        Map<String, Object> result = new HashMap<>();\n        result.put(\"totalQuota\", quota.getTotalQuota());\n        result.put(\"usedQuota\", quota.getUsedQuota());\n        result.put(\"availableQuota\", availableQuota);\n        result.put(\"interestRate\", quota.getInterestRate());\n        \n        return ResponseMessage.success(\"测算成功\", result);\n    }\n\n    @Override\n    @Transactional\n    public ResponseMessage submitFinancingApply(PmcFinanceSupplierApplyDTO applyDTO) {\n        // 1. 参数校验\n        if (applyDTO == null || applyDTO.getSupplierCode() == null || applyDTO.getAmount() == null) {\n            return ResponseMessage.fail(\"参数错误：申请信息不完整\");\n        }\n        \n        // 2. 检查额度是否充足\n        PmcFinanceSupplierQuotaSet quota = quotaSetMapper.selectBySupplierCode(applyDTO.getSupplierCode());\n        if (quota == null) {\n            return ResponseMessage.fail(\"未找到该供应商的额度信息\");\n        }\n        \n        BigDecimal availableQuota = quota.getTotalQuota().subtract(quota.getUsedQuota());\n        if (applyDTO.getAmount().compareTo(availableQuota) > 0) {\n            return ResponseMessage.fail(\"额度不足，可用额度：\" + availableQuota);\n        }\n        \n        // 3. 保存申请信息\n        PmcFinanceSupplierApply apply = new PmcFinanceSupplierApply();\n        BeanUtils.copyProperties(applyDTO, apply);\n        apply.setCreateTime(new Date());\n        apply.setStatus(\"PENDING\"); // 待审批状态\n        applyMapper.insertSelective(apply);\n        \n        // 4. 返回申请结果\n        return ResponseMessage.success(\"申请提交成功\", apply.getApplyId());\n    }\n\n    @Override\n    @Transactional(readOnly = true)\n    public ResponseMessage queryFinancingResult(PmcFinanceSupplierApplyQO query) {\n        // 1. 参数校验\n        if (query == null || query.getApplyId() == null) {\n            return ResponseMessage.fail(\"参数错误：申请ID不能为空\");\n        }\n        \n        // 2. 查询融资申请\n        PmcFina