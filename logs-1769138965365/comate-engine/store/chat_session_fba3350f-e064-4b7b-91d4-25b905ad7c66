                "content": "package com.baidu.pmc.core.service.impl;\n\nimport com.baidu.pmc.common.ResponseMessage;\nimport com.baidu.pmc.common.exception.ServiceException;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcFinanceSupplierApplyMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcFinanceSupplierQuotaSetMapper;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyDTO;\nimport com.baidu.pmc.pojo.model.pmc.PmcFinanceSupplierApply;\nimport com.baidu.pmc.pojo.model.pmc.PmcFinanceSupplierQuotaSet;\nimport com.baidu.pmc.pojo.qo.PmcFinanceSupplierApplyQO;\nimport com.baidu.pmc.core.service.PmcFinancingBankService;\nimport com.baidu.pmc.core.utils.FileUploadUtils;\nimport org.springframework.beans.BeanUtils;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\nimport org.springframework.transaction.annotation.Transactional;\nimport org.springframework.web.multipart.MultipartFile;\n\nimport java.math.BigDecimal;\nimport java.util.Date;\nimport java.util.HashMap;\nimport java.util.Map;\n\n@Service\npublic class PmcFinancingBankServiceImpl implements PmcFinancingBankService {\n\n    @Autowired\n    private PmcFinanceSupplierApplyMapper applyMapper;\n    \n    @Autowired\n    private PmcFinanceSupplierQuotaSetMapper quotaSetMapper;\n    \n    @Autowired\n    private FileUploadUtils fileUploadUtils;\n\n    @Override\n    @Transactional(readOnly = true)\n    public ResponseMessage calculateFinancing(PmcFinanceSupplierApplyQO query) {\n        // 1. 参数校验\n        if (query == null || query.getSupplierCode() == null) {\n            return ResponseMessage.fail(\"参数错误：供应商编码不能为空\");\n        }\n        \n        // 2. 查询供应商额度信息\n        PmcFinanceSupplierQuotaSet quota = quotaSetMapper.selectBySupplierCode(query.getSupplierCode());\n        if (quota == null) {\n            return ResponseMessage.fail(\"未找到该供应商的额度信息\");\n        }\n        \n        // 3. 计算可用额度\n        BigDecimal availableQuota = quota.getTotalQuota().subtract(quota.getUsedQuota());\n        \n        // 4. 构建返回结果\n        Map<String, Object> result = new HashMap<>();\n        result.put(\"totalQuota\", quota.getTotalQuota());\n        result.put(\"usedQuota\", quota.getUsedQuota());\n        result.put(\"availableQuota\", availableQuota);\n        result.put(\"interestRate\", quota.getInterestRate());\n        \n        return ResponseMessage.success(\"测算成功\", result);\n    }\n\n    @Override\n    @Transactional\n    public ResponseMessage submitFinancingApply(PmcFinanceSupplierApplyDTO applyDTO) {\n        // 1. 参数校验\n        if (applyDTO == null || applyDTO.getSupplierCode() == null || applyDTO.getAmount() == null) {\n            return ResponseMessage.fail(\"参数错误：申请信息不完整\");\n        }\n        \n        // 2. 检查额度是否充足\n        PmcFinanceSupplierQuotaSet quota = quotaSetMapper.selectBySupplierCode(applyDTO.getSupplierCode());\n        if (quota == null) {\n            return ResponseMessage.fail(\"未找到该供应商的额度信息\");\n        }\n        \n        BigDecimal availableQuota = quota.getTotalQuota().subtract(quota.getUsedQuota());\n        if (applyDTO.getAmount().compareTo(availableQuota) > 0) {\n            return ResponseMessage.fail(\"额度不足，可用额度：\" + availableQuota);\n        }\n        \n        // 3. 保存申请信息\n        PmcFinanceSupplierApply apply = new PmcFinanceSupplierApply();\n        BeanUtils.copyProperties(applyDTO, apply);\n        apply.setCreateTime(new Date());\n        apply.setStatus(\"PENDING\"); // 待审批状态\n        applyMapper.insertSelective(apply);\n        \n        // 4. 返回申请结果\n        return ResponseMessage.success(\"申请提交成功\", apply.getApplyId());\n    }\n\n    @Override\n    @Transactional(readOnly = true)\n    public ResponseMessage queryFinancingResult(PmcFinanceSupplierApplyQO query) {\n        // 1. 参数校验\n        if (query == null || query.getApplyId() == null) {\n            return ResponseMessage.fail(\"参数错误：申请ID不能为空\");\n        }\n        \n        // 2. 查询融资申请\n        Pmc