s(payQO);\n            }\n            if (PayBankConstants.BOCOMHK_BANK_CODE.equals(accountList.get(0).getBank())) {\n                // 行交行\n                return bocomhkClient.selectBocomhkTrans(payQO);\n            }\n            if (PayBankConstants.ICBC_BANK_CODE.equals(accountList.get(0).getBank())) {\n                // 工商\n                return icbcClient.selectIcbcTrans(payQO);\n            }\n            // 银企标准化通用银行\n            if (bankToPayClient.getTransferBankCodeList().contains(accountList.get(0).getBank())) {\n                payQO.setBank(accountList.get(0).getBank());\n                return bankCommonClient.selectBankcommonTrans(payQO);\n            }\n\n        }\n        return ResponseMessage.fail(\"无效的账户\");\n    }\n\n    /**\n     * 从银行接口中获取余额信息\n     */\n    @PostMapping(\"/select_balance\")\n    @ResponseBody\n    public ResponseMessage selectBalance(@RequestBody List<PayQO> payQOS) {\n        log.info(\"银行余额实时查询selectBalance 入参:{}\", JSON.toJSONString(payQOS));\n        ResponseMessage balanceInfos;\n        List<String> transferBankCodeList = bankToPayClient.getTransferBankCodeList();\n        if (PayBankConstants.BOC_BANK_CODE.equals(payQOS.get(0).getBank())) {\n            balanceInfos = bocClient.selectBocBalance(payQOS.get(0));\n            this.sumAmount(balanceInfos, CALCULATE_SUBTOTAL);\n        } else if (PayBankConstants.CCB_BANK_CODE.equals(payQOS.get(0).getBank())) {\n            balanceInfos = ccbClient.selectCcbBalance(payQOS.get(0));\n            this.sumAmount(balanceInfos, CALCULATE_SUBTOTAL);\n        } else if (PayBankConstants.CMB_BANK_CODE.equals(payQOS.get(0).getBank())) {\n            balanceInfos = cmbClient.selectBalance(payQOS);\n            this.sumAmount(balanceInfos, CALCULATE_SUBTOTAL);\n        } else if (PayBankConstants.CMBC_BANK_CODE.equals(payQOS.get(0).getBank())) {\n            balanceInfos = cmbcClient.selectCmbcBalance(payQOS.get(0));\n            this.sumAmount(balanceInfos, CALCULATE_SUBTOTAL);\n        } else if (PayBankConstants.CIB_BANK_CODE.equals(payQOS.get(0).getBank())) {\n            balanceInfos = cibClient.selectCibBalance(payQOS.get(0));\n            this.sumAmount(balanceInfos, CALCULATE_SUBTOTAL);\n        } else if (PayBankConstants.ABC_BANK_CODE.equals(payQOS.get(0).getBank())) {\n            balanceInfos = abcClient.selectAbcBalance(payQOS.get(0));\n            this.sumAmount(balanceInfos, CALCULATE_SUBTOTAL);\n        } else if (PayBankConstants.CEB_BANK_CODE.equals(payQOS.get(0).getBank())) {\n            balanceInfos = cebClient.selectCebBalance(payQOS.get(0));\n            this.sumAmount(balanceInfos, CALCULATE_SUBTOTAL);\n        } else if (PayBankConstants.CITIC_BANK_CODE.equals(payQOS.get(0).getBank())) {\n            balanceInfos = citicClient.selectCiticBalance(payQOS.get(0));\n            this.sumAmount(balanceInfos, CALCULATE_SUBTOTAL);\n        } else if (PayBankConstants.ICBC_BANK_CODE.equals(payQOS.get(0).getBank())) {\n            balanceInfos = icbcClient.selectIcbcBalance(payQOS.get(0));\n            this.sumAmount(balanceInfos, CALCULATE_SUBTOTAL);\n        } else if (PayBankConstants.BOCOMHK_BANK_CODE.equals(payQOS.get(0).getBank())) {\n            balanceInfos = bocomhkClient.selectBocomhkBalance(payQOS.get(0));\n            this.sumAmount(balanceInfos, CALCULATE_SUBTOTAL);\n        } else if (transferBankCodeList.contains(payQOS.get(0).getBank())) {\n            balanceInfos = bankCommonClient.selectbankcommonBalance(payQOS.get(0));\n            this.sumAmount(balanceInfos, CALCULATE_SUBTOTAL);\n        } else {\n            // 招行\n            payQOS.get(0).setBank(PayBankConstants.CMB_BANK_CODE);\n            ResponseMessage cmbBalance = cmbClient.selectBalance(payQOS);\n            this.sumAmount(cmbBalance, CALCULATE_SUBTOTAL);\n            // 中行\n            payQOS.get(0).setBank(PayBankConstants.BOC_BANK_CODE);\n            ResponseMessage bocBalance = bocClient.selectBocBalance(payQOS.get(0));\n            this.sum