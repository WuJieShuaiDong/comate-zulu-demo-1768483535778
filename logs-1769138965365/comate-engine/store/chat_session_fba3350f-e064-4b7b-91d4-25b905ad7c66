ist<ResponseMessage> bankCommonBalanceInfos = new ArrayList<>();\n            transferBankCodeList.forEach(bankCode -> {\n                payQOS.get(0).setBank(bankCode);\n                ResponseMessage bankCommonBalance;\n                bankCommonBalance = bankCommonClient.selectbankcommonBalance(payQOS.get(0));\n                this.sumAmount(bankCommonBalance, CALCULATE_SUBTOTAL);\n                bankCommonBalanceInfos.add(bankCommonBalance);\n            });\n            // 合计\n            balanceInfos = this.mergeBalance(cmbBalance, bocBalance, ccbBalance, cmbcBalance, cibBalance,\n                    abcBalance, cebBalance, citicBalance, iccbcBalance, bankCommonBalanceInfos);\n            this.sumAmount(balanceInfos, CALCULATE_TOTAL);\n        }\n        return balanceInfos;\n    }\n\n    /**\n     * 根据业务参数查询交易指令列表\n     *\n     * @param payInstructQO 查询条件对象，可以为空\n     * @return 返回业务操作结果：成功或失败及其相关信息\n     */\n    @PostMapping(\"/instruct_list\")\n    @ResponseBody\n    public ResponseMessage instructList(@RequestBody PayInstructQO payInstructQO) {\n        ResponseMessage instructList;\n        if (PayBankConstants.BOC_BANK_CODE.equals(payInstructQO.getBank())) {\n            instructList = bocClient.bocInstructList(payInstructQO);\n        } else if (PayBankConstants.CCB_BANK_CODE.equals(payInstructQO.getBank())) {\n            instructList = ccbClient.ccbInstructList(payInstructQO);\n        } else if (PayBankConstants.CMBC_BANK_CODE.equals(payInstructQO.getBank())) {\n            instructList = cmbcClient.cmbcInstructList(payInstructQO);\n        } else if (PayBankConstants.CIB_BANK_CODE.equals(payInstructQO.getBank())) {\n            instructList = cibClient.cibInstructList(payInstructQO);\n        } else if (PayBankConstants.ABC_BANK_CODE.equals(payInstructQO.getBank())) {\n            instructList = abcClient.abcInstructList(payInstructQO);\n        } else if (PayBankConstants.CEB_BANK_CODE.equals(payInstructQO.getBank())) {\n            instructList = cebClient.cebInstructList(payInstructQO);\n        } else if (PayBankConstants.CITIC_BANK_CODE.equals(payInstructQO.getBank())) {\n            instructList = citicClient.citicInstructList(payInstructQO);\n        } else if (PayBankConstants.ICBC_BANK_CODE.equals(payInstructQO.getBank())) {\n            instructList = icbcClient.icbcInstructList(payInstructQO);\n        } else if (PayBankConstants.BOCOMHK_BANK_CODE.equals(payInstructQO.getBank())) {\n            instructList = bocomhkClient.bocomhkInstructList(payInstructQO);\n        } else if (bankToPayClient.getTransferBankCodeList().contains(payInstructQO.getBank())) {\n            instructList = bankCommonClient.bankcommonInstructList(payInstructQO);\n        } else {\n            instructList = cmbClient.instructList(payInstructQO);\n        }\n        return instructList;\n    }\n\n    @ApiOperation(value = \"明细数据页签\", httpMethod = \"POST\", notes = \"查询\")\n    @PostMapping(\"/instruct_detail_list\")\n    public ResponseMessageT<?> detailList(@RequestBody PayInstructQO payInstructQO) {\n\n        return cmbClient.detailList(payInstructQO);\n    }\n\n    @ApiOperation(value = \"银企付款指标统计列表导出\", httpMethod = \"POST\", notes = \"银企付款指标统计列表导出\")\n    @PostMapping(\"/export_instruct_detail_list\")\n    @ExportRepeatCheckLock\n    public void exportDetailList(PayInstructQO payInstructQO, HttpServletRequest request,\n                                 HttpServletResponse response) {\n        List<PayInstructDTODetail> list = cmbClient.exportDetailList(payInstructQO);\n\n        List<List<List<List<String>>>> detailsList = new ArrayList<>();\n        List<List<List<String>>> details = new ArrayList<>();\n        List<List<String>> resultIn = new ArrayList<>();\n        SimpleDateFormat sdf = new SimpleDateFormat(\"yyyy-MM-dd\", Locale.getDefault());\n        SimpleDateFormat sdf2 = new SimpleDateFormat(\"yyyy-MM-dd HH:mm:ss\", Locale.getDefault());\n        list.forEach(data -> {\n            List<String> values = new