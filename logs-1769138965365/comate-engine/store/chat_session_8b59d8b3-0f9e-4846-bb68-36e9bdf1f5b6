upplierAdm\")\n@Slf4j\n@Controller\npublic class PmcSupplierAdmController {\n\n\n    @Autowired\n    private PmcSupplierAdmClient pmcSupplierAdmClient;\n\n    @Autowired\n    private ExportExcelUtil exportExcelUtil;\n\n    private static final String FILE_NAME_PREFIX = \"主体额度查询\";\n\n\n    @PostMapping(\"/selectList\")\n    @ResponseBody\n    public ResponseEntity<?> selectList(@RequestBody PmcFinanceSupplierApplyQO pmcFinanceSupplierApplyQO) {\n        PageInfo<PmcFinanceSupplierApplyDTO> data = pmcSupplierAdmClient.selectList(pmcFinanceSupplierApplyQO);\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", data), HttpStatus.OK);\n    }\n\n    /**\n     * 管理员导出融资申请列表\n     */\n    @PostMapping(\"/export\")\n    @ResponseBody\n    @ExportRepeatCheckLock\n    public ResponseMessage export(@RequestBody PmcFinanceSupplierApplyQO query,\n                                                  HttpServletRequest request, HttpServletResponse response) {\n        log.info(\"管理员点击导出融资申请列表\");\n        List<PmcFinanceSupplierApplyDTO> result = pmcSupplierAdmClient.export(query);\n        List<List<List<List<String>>>> detailsList = new ArrayList<>();\n        List<List<List<String>>> detailsNew = new ArrayList<>();\n        List<List<String>> resultIn = new ArrayList<>();\n        result.forEach(data -> {\n            List<String> values = new ArrayList<>();\n            // 序号\n            values.add(String.valueOf(result.indexOf(data) + 1));\n            values.add(String.valueOf(data.getSupplierName()));\n            values.add(String.valueOf(data.getApplyNumber()));\n            values.add(String.valueOf(data.getPayCheckNum()));\n            values.add(String.valueOf(data.getPayAmount()));\n            values.add(String.valueOf(data.getFinanceAmount()));\n            values.add(String.valueOf(data.getCurrencyName()));\n            values.add(String.valueOf(data.getBankCodeName()));\n            values.add(String.valueOf(data.getFinanceDay()));\n            values.add(String.valueOf(data.getApplySubmit()));\n            values.add(String.valueOf(data.getStatusDesc()));\n            values.add(String.valueOf(data.getNextOperationNode()));\n            resultIn.add(values);\n        });\n        detailsNew.add(resultIn);\n        detailsList.add(detailsNew);\n        String[] sheetName = {\"供应商融资列表导出\"};\n        String[] headerIn = {\"序号\", \"供应商名称\", \"融资申请单号\", \"付款单号\", \"可融资金额\",\n                \"融资申请金额\", \"币种\", \"融资机构\", \"融资天数\",\"申请人\",\"融资申请状态\",\"后续处理节点\"};\n        List<String[]> headers = new ArrayList<>();\n        headers.add(headerIn);\n        try {\n            ResponseStream.setHeader(\"供应商融资列表导出\".concat(DateUtils.getDate(\"yyyyMMddHHmmss\")).concat(\".xlsx\"),\n                    ResponseStream.ContentType.EXCEL, request, response);\n            exportExcelUtil.exportMoreDifferentSheetExcel(sheetName, headers, detailsList, response);\n        } catch (Exception e) {\n            throw new WebException(\"导出异常\");\n        }\n        return ResponseMessage.success(\"导出成功\");\n    }\n\n\n    /**\n     * 查询主体额度\n     */\n    @PostMapping(\"/getQuotaSet\")\n    @ResponseBody\n    public ResponseEntity<?> selectQuotaSet(@RequestBody PmcFinanceCompQuotaSetQO query) {\n        try {\n            PageInfo<PmcFinanceCompQuotaSetDTO> result = pmcSupplierAdmClient.selectQuotaSet(query);\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\", result), HttpStatus.OK);\n        } catch (Exception e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 导出主体额度\n     */\n    @PostMapping(\"/exportQuotaSet\")\n    @ResponseBody\n    @ExportRepeatCheckLock\n    public ResponseMessage exportQuotaSet(@RequestBody PmcFinanceCompQuotaSetQO query,\n                                                                          HttpServletRequest request, HttpServletResponse response) {\n        log.info(\"web用户点击导出主体额度\");\n        List