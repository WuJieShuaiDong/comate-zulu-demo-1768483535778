nk(request.getInvoiceCode(), \"发票代码(invoiceCode)不能为空\");\n        Validate.notNull(request.getInvoiceDate(), \"发票日期(invoiceDate)不能为空\");\n\n\n        Validate.notNull(request.getTaxExcludedAmount(), \"不含税金额(taxExcludedAmount)不能为空\");\n        Validate.notNull(request.getDocumentAmount(), \"单据金额(documentAmount)不能为空\");\n\n        Validate.notBlank(request.getContractId(), \"合同ID(contractId)不能为空\");\n        Validate.notBlank(request.getContractName(), \"合同名称(contractName)不能为空\");\n        Validate.notBlank(request.getBuyerAccount(), \"还款账户(buyerAccount)不能为空\");\n\n    }\n\n    /**\n     * 管理员拒绝发送中的融资\n     * @param query 融资申请信息\n     * @return 操作结果\n     */\n    @Override\n    public ResponseMessage admRejectSendBank(PmcFinanceSupplierApplyDTO query) {\n        try {\n            log.info(\"管理员拒绝发送中的融资，申请单号：{}\", query.getApplyNumber());\n\n            // 校验参数\n            if (StringUtils.isBlank(query.getApplyNumber())) {\n                return ResponseMessage.fail(\"融资申请单号不能为空\");\n            }\n\n            // 查询融资申请信息\n            PmcFinanceSupplierApply apply = pmcFinanceSupplierApplyMapper.selectByApplyNumber(query.getApplyNumber());\n            if (apply == null) {\n                return ResponseMessage.fail(\"未找到对应的融资申请信息\");\n            }\n\n            // 校验状态：只有发送中的融资才能被拒绝\n            if (!FinancingStatus.SENDING.equals(apply.getStatus())) {\n                return ResponseMessage.fail(\"只有发送中的融资申请才能被拒绝\");\n            }\n\n            // 更新融资申请状态为\"拒绝\"\n            apply.setStatus(FinancingStatus.REJECTED);\n            apply.setLastUpdateDate(new Date());\n            apply.setLastUpdatedBy(PmcPortalLogin.getCurrentUser());\n            pmcFinanceSupplierApplyMapper.updateByPrimaryKeySelective(apply);\n\n            // 记录操作历史\n            PmcFinanceSupplierApplyHis applyHis = new PmcFinanceSupplierApplyHis();\n            applyHis.setApplyNumber(apply.getApplyNumber());\n            applyHis.setOperationType(\"ADMIN_REJECT\");\n            apply