quest, response);\n            exportExcelUtil.exportMoreDifferentSheetExcel(sheetName, headers, detailsList, response);\n        } catch (Exception e) {\n            throw new WebException(\"导出异常\");\n        }\n        return ResponseMessage.success(\"导出成功\");\n    }\n\n\n    /**\n     * 保存主体额度\n     */\n    @PostMapping(\"/saveOrUpdate\")\n    @ResponseBody\n    public ResponseMessage saveOrUpdate(@RequestBody PmcFinanceCompQuotaSetDTO dto) {\n        return pmcSupplierAdmClient.saveOrUpdate(dto);\n    }\n\n\n    /**\n     * 查询供应商额度\n     */\n    @PostMapping(\"/getSupplierQuota\")\n    @ResponseBody\n    public ResponseEntity<?> selectSupplierQuotaSet(@RequestBody PmcFinanceSupplierQuotaSetQO query) {\n        try {\n            PageInfo<PmcFinanceSupplierQuotaSetDTO> result = pmcSupplierAdmClient.selectSupplierQuotaSet(query);\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\", result), HttpStatus.OK);\n        } catch (Exception e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n\n    /**\n     * 查询供应商额度使用情况\n     */\n    @PostMapping(\"/getSupplierQuotaUse\")\n    @ResponseBody\n    public ResponseEntity<?> selectSupplierQuotaUse(@RequestBody SupplierFinancingUsageQO query) {\n        try {\n            PageInfo<SupplierFinancingUsageDTO> result = pmcSupplierAdmClient.selectSupplierQuotaUse(query);\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\", result), HttpStatus.OK);\n        } catch (Exception e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n\n    /**\n     * 导出供应商额度\n     */\n    @PostMapping(\"/exportSupplierQuota\")\n    @ResponseBody\n    @ExportRepeatCheckLock\n    public ResponseMessage exportSupplierQuotaSet(@RequestBody PmcFinanceSupplierQuotaSetQO query,\n                                                  HttpServletRequest request, HttpServletResponse response) {\n        log.info(\"web用户点击导出供应商额度\");\n        List<PmcFinanceSupplierQuotaSetDTO> result = pmcSupplierAdmClient.exportSupplierQuotaSet(query);\n        List<List<List<List<String>>>> detailsList = new ArrayList<>();\n        List<List<List<String>>> detailsNew = new ArrayList<>();\n        List<List<String>> resultIn = new ArrayList<>();\n        int index = 1;\n        for (PmcFinanceSupplierQuotaSetDTO data : result) {\n            List<String> values = new ArrayList<>();\n            // 序号\n            values.add(String.valueOf(index++));\n            values.add(String.valueOf(data.getSupplierName()));\n            values.add(String.valueOf(data.getRegistrationCode()));\n            values.add(String.valueOf(data.getSupplierCode()));\n            values.add(\"Y\".equals(data.getFinanceFlag()) ? \"是\" : \"否\");\n            values.add(String.valueOf(data.getCreditQuota()));\n            values.add(DateUtils.formatDate(data.getEffectiveStartDate()));\n            values.add(DateUtils.formatDate(data.getEffectiveEndDate()));\n            resultIn.add(values);\n        }\n        detailsNew.add(resultIn);\n        detailsList.add(detailsNew);\n        String[] sheetName = {\"供应商额度查询\"};\n        String[] headerIn = {\"序号\", \"供应商名称\", \"统一社会信用代码\",  \"供应商编码\", \"是否开通融资业务\",\n                \"授信额度\", \"生效开始日期\", \"生效结束日期\"};\n        List<String[]> headers = new ArrayList<>();\n        headers.add(headerIn);\n        try {\n            ResponseStream.setHeader(\"供应商额度查询\".concat(DateUtils.getDate(\"yyyyMMddHHmmss\")).concat(\".xlsx\"),\n                    ResponseStream.ContentType.EXCEL, request, response);\n            exportExcelUtil.exportMoreDifferentSheetExcel(sheetName, headers, detailsList, response);\n        } catch (Exception e) {\n            throw new WebException(\"导出异常\");\n        }\n        return ResponseMessage.success(\"导出成功\");\n    }\n\n    /**\n     * 保存供应商额度\n     */\n    @PostMapping(\"/saveOrUpdateSupplierQuota\")\n    @ResponseBody\n  