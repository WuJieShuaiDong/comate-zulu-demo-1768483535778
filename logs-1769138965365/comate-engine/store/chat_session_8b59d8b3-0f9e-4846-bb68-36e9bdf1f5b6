rayList<>();\n        List<List<String>> resultIn = new ArrayList<>();\n        result.forEach(data -> {\n            List<String> values = new ArrayList<>();\n            // 序号\n            values.add(String.valueOf(result.indexOf(data) + 1));\n            values.add(String.valueOf(data.getSupplierName()));\n            values.add(String.valueOf(data.getRegistrationCode()));\n            values.add(String.valueOf(data.getSupplierCode()));\n            values.add(\"Y\".equals(data.getFinanceFlag()) ? \"是\" : \"否\");\n            values.add(String.valueOf(data.getCreditQuota()));\n            values.add(DateUtils.formatDate(data.getEffectiveStartDate()));\n            values.add(DateUtils.formatDate(data.getEffectiveEndDate()));\n            resultIn.add(values);\n        });\n        detailsNew.add(resultIn);\n        detailsList.add(detailsNew);\n        String[] sheetName = {\"供应商额度查询\"};\n        String[] headerIn = {\"序号\", \"供应商名称\", \"统一社会信用代码\", \"是否开通融资业务\", \"供应商名称\",\n                \"授信额度\"};\n        List<String[]> headers = new ArrayList<>();\n        headers.add(headerIn);\n        try {\n            ResponseStream.setHeader(\"供应商额度查询\".concat(DateUtils.getDate(\"yyyyMMddHHmmss\")).concat(\".xlsx\"),\n                    ResponseStream.ContentType.EXCEL, request, response);\n            exportExcelUtil.exportMoreDifferentSheetExcel(sheetName, headers, detailsList, response);\n        } catch (Exception e) {\n            throw new WebException(\"导出异常\");\n        }\n        return ResponseMessage.success(\"导出成功\");\n    }\n\n    /**\n     * 保存供应商额度\n     */\n    @PostMapping(\"/saveOrUpdateSupplierQuota\")\n    @ResponseBody\n    public ResponseMessage saveOrUpdateSupplierQuotaSet(@RequestBody PmcFinanceSupplierQuotaSetDTO dto) {\n        return pmcSupplierAdmClient.saveOrUpdateSupplierQuotaSet(dto);\n    }\n\n\n    @PostMapping(\"/selectInit\")\n    public ResponseEntity<Object> selectInit() {\n        Map<String, Object> selectMap = pmcSupplierAdmClient.selectInit();\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", selectMap), HttpStatus.OK);\n    }\n\n    /**\n     * 根据输入值模糊检索交易类型code和名称\n     * @param parameter\n     * @return\n     */\n    @PostMapping(value = \"/selectSuggest\")\n    public ResponseEntity<Object> selectSuggest(@RequestBody PmcPortalSuggestQO parameter) {\n        List<PmcDataP2pSupplier> codeDescs = pmcSupplierAdmClient.selectSuggest(parameter);\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", codeDescs), HttpStatus.OK);\n    }\n\n    @PostMapping(\"/selectSuggestAccount\")\n    @ResponseBody\n    public ResponseEntity selectAccount(@RequestBody PmcAccountSearchQO pmcAccountSearchQO) {\n        PageInfo<PmcAccountDTO> data = pmcSupplierAdmClient.getAccountViewPage(pmcAccountSearchQO);\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", data), HttpStatus.OK);\n    }\n\n    /**\n     * 计算两个精度数据的差值(前端丢精度)\n     * @return 两个数值的差值\n     */\n    @PostMapping(\"/calculateDifference\")\n    @ResponseBody\n    public ResponseEntity calculateDifference(@RequestBody PmcFinanceCompQuotaSet quotaSet) {\n        if (quotaSet.getBankCreditQuota() == null || quotaSet.getCompanyCreditQuota() == null) {\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\", 0.00), HttpStatus.OK);\n        }\n        BigDecimal remainQuota = quotaSet.getBankCreditQuota().subtract(quotaSet.getCompanyCreditQuota());\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", remainQuota), HttpStatus.OK);\n    }\n\n    /**\n     * 管理员拒绝发送中的融资\n     *\n     * @return 管理员拒绝融资\n     */\n    @PostMapping(\"/admRejectSendBank\")\n    @ResponseBody\n    public ResponseEntity admReject(@RequestBody PmcFinanceSupplierApplyQO query) {\n        try {\n            log.info(\"管理员拒绝发送中的融资申请，申请单号：{}\", query.getApplyNumber());\n            \n            // 检查申请单号是否为空\n            if (StringUtils.isBlank(query.getApplyNumber())) {\n                return new ResponseEntity<>(ResponseMessage.fail(\"融资申请单号不能为空\"), HttpStatus.OK);\n            }\n            \n            // 调用服务端接口拒绝融资申请\n            ResponseMessage result = pmcSupplierAdmClient.commonCheckData(convertToBankBaseQO(query), \"admRejectSendBank\");\n            \n            if (ResponseMessage.FAIL.equals(result.getStatus())) {\n                return new ResponseEntity<>(result, HttpStatus.OK);\n            }\n            \n            return new ResponseEntity<>(ResponseMessage.success(\"融资申请拒绝成功\"), HttpStatus.OK);\n        } catch (Exception e) {\n            log.error(\"管理员拒绝融资申请异常，申请单号：{}\", query.getApplyNumber(), e);\n            return new ResponseEntity<>(ResponseMessage.fail(\"拒绝融资申请失败：\" + e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 管理员再次提交发送中的融资到银行\n     * 包含重复发送检查逻辑：如果sendSeq > 1，则直接拒绝\n     *\n     * @return 管理员再次提交发送中的融资到银行\n     */\n    @PostMapping(\"/admSendToBank\")\n    @ResponseBody\n    public ResponseEntity admSendToBank(@RequestBody PmcFinanceSupplierApplyQO query) {\n        try {\n            log.info(\"管理员再次提交融资申请到银行，申请单号：{}\", query.getApplyNumber());\n            \n            // 检查申请单号是否为空\n            if (StringUtils.isBlank(query.getApplyNumber())) {\n                return new ResponseEntity<>(ResponseMessage.fail(\"融资申请单号不能为空\"), HttpStatus.OK);\n            }\n            \n            // 调用服务端接口检查重复发送\n            ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(convertToBankBaseQO(query), \"admSendToBank\");\n            \n            if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n                return new ResponseEntity<>(checkResult, HttpStatus.OK);\n            }\n            \n            // 调用服务端接口提交到银行\n            ResponseMessage result = pmcSupplierAdmClient.commonCheckData(convertToBankBaseQO(query), \"submitFinancingApply\");\n            \n            if (ResponseMessage.FAIL.equals(result.getStatus())) {\n                return new ResponseEntity<>(result, HttpStatus.OK);\n            }\n            \n            return new ResponseEntity<>(ResponseMessage.success(\"融资申请提交到银行成功\"), HttpStatus.OK);\n        } catch (Exception e) {\n            log.error(\"管理员提交融资申请到银行异常，申请单号：{}\", query.getApplyNumber(), e);\n            return new ResponseEntity<>(ResponseMessage.fail(\"提交融资申请到银行失败：\" + e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 将PmcFinanceSupplierApplyQO转换为PmcFinanceBankBaseQO\n     */\n    private PmcFinanceBankBaseQO convertToBankBaseQO(PmcFinanceSupplierApplyQO query) {\n        PmcFinanceBankBaseQO bankBaseQO = new PmcFinanceBankBaseQO();\n        bankBaseQO.setApplyNumber(query.getApplyNumber());\n        bankBaseQO.setPayCheckNum(query.getPayCheckNum());\n        bankBaseQO.setBankCode(query.getBankCode());\n        return bankBaseQO;\n    }\n\n}\n"
