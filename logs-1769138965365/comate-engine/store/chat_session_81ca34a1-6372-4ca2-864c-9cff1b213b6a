e.df.empty:\n        current_data = st.session_state.df\n        # 确保列顺序和多余列不影响\n        valid_cols = list(column_config.keys())\n        # 有些列可能不在 config 里但需要显示（如类型、长度）\n        # 这里为了简化，我们只显示 config 里定义的，或者如果 session 有数据就让 data_editor 自动处理额外列\n    else:\n        # 如果列不匹配（比如从\"新建表\"切换到\"删除索引\"），则重置或使用模板\n        # 优化体验：只有当数据为空或者结构完全不搭时才重置\n        if action_type in [\"新建表\", \"添加字段\", \"修改字段\"] and \"字段名\" in st.session_state.df.columns:\n            # 尝试保留\n            current_data = st.session_state.df\n        else:\n            current_data = pd.DataFrame(default_data)\n\n    edited_df = st.data_editor(\n        current_data,\n        column_config=column_config,\n        num_rows=\"dynamic\",\n        use_container_width=True,\n        hide_index=True,\n        key=f\"editor_{action_type}\" # 强制刷新 key 以避免列配置冲突\n    )\n\nst.markdown(\"---\")\nif st.button(\"生成 SQL\", type=\"primary\", use_container_width=True):\n    try:\n        sql = generate_sql(action_type, db_type, table_name, edited_df, extra_options)\n        \n        st.subheader(\"生成结果\")\n        st.code(sql, language=\"sql\")\n        st.download_button(\"📥 下载 SQL\", sql, f\"{table_name}_{action_type}.sql\")\n    except Exception as e:\n        st.error(f\"生成出错: {e}\")\n\n",
