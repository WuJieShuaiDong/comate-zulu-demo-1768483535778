b_lower'], 'bb_upper': latest['bb_upper'], 'vol_ratio': vol_ratio}\n    except Exception as e:\n        logging.error(f\"计算失败 {symbol}: {e}\")\n        return None\n\ndef check_market_sentiment():\n    \"\"\"\n    判断市场情绪：主升浪 vs 退潮期\n    返回: 'BULLISH' (可以做多), 'BEARISH' (空仓观望), 'NEUTRAL' (谨慎)\n    \"\"\"\n    try:\n        # 1. 获取涨跌停数据 (A股情绪最直观的指标)\n        zt_df = ak.stock_zt_pool_em(date=datetime.date.today().strftime(\"%Y%m%d\"))\n        dt_df = ak.stock_zt_pool_dtgc_em(date=datetime.date.today().strftime(\"%Y%m%d\"))\n        \n        zt_count = len(zt_df) if not zt_df.empty else 0\n        dt_count = len(dt_df) if not dt_df.empty else 0\n        \n        logging.info(f\"市场情绪: 涨停 {zt_count} 只, 跌停 {dt_count} 只\")\n        \n        # 2. 获取上证指数走势 (代表大盘)\n        index_df = ak.stock_zh_index_daily(symbol=\"sh000001\")\n        if not index_df.empty:\n            index_df['date'] = pd.to_datetime(index_df['date'])\n            index_df = index_df.sort_values('date').tail(30)\n            \n            # 计算上证 RSI\n            delta = index_df['close'].diff()\n            gain = (delta.where(delta > 0, 0)).rolling(window=14).mean()\n            loss = (-delta.where(delta < 0, 0)).rolling(window=14).mean()\n            rs = gain / loss\n            index_rsi = (100 - (100 / (1 + rs))).iloc[-1]\n            \n            logging.info(f\"上证指数 RSI: {index_rsi:.1f}\")\n        else:\n            index_rsi = 50 # 默认中性\n        \n        # 3. 判断逻辑\n        # 主升浪: 涨停数量显著多于跌停 (2倍以上) AND 大盘 RSI > 50\n        if zt_count > dt_count * 2 and index_rsi > 50:\n            return 'BULLISH'\n        \n        # 退潮期: 跌停数量多于涨停 OR 大盘 RSI < 40\n        elif dt_count > zt_count or index_rsi < 40:\n            return 'BEARISH'\n        \n        else:\n            return 'NEUTRAL'\n            \n    except Exception as e:\n        logging.error(f\"市场情绪判断失败: {e}\")\n        return 'NEUTRAL' # 异常时保持中性\n\ndef is_trading_time():\n    \"\"\"判断当前是否为 A 股连续竞价交易时间 (9:30-11:30, 13:00-14:57)\"\"\"\n 