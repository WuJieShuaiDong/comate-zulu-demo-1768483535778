                "originalContent": "import pandas as pd\nimport akshare as ak\nimport time\nimport datetime\nimport os\nimport json\nimport logging\n\n# --- 配置区 ---\nDATA_DIR = \"data\"\nACCOUNT_FILE = os.path.join(DATA_DIR, \"account.json\")\nTRADES_FILE = os.path.join(DATA_DIR, \"trades.csv\")\nLOG_FILE = os.path.join(DATA_DIR, \"bot.log\")\n\n# 确保数据目录存在 (修复 FileNotFoundError)\nif not os.path.exists(DATA_DIR):\n    os.makedirs(DATA_DIR)\n\n# 策略参数\nRSI_BUY = 30\nVOL_RATIO_MIN = 1.2\nSTOP_LOSS_PCT = 0.05\nTAKE_PROFIT_PCT = 0.10\nMAX_POSITIONS = 5 # 最大持仓只数\nSINGLE_POS_CASH = 20000 # 单只股票分配资金\n\n# 初始化日志\nlogging.basicConfig(\n    level=logging.INFO,\n    format='%(asctime)s - %(levelname)s - %(message)s',\n    handlers=[\n        logging.FileHandler(LOG_FILE, encoding='utf-8'),\n        logging.StreamHandler()\n    ]\n)\n\n# --- 账户管理类 ---\nclass VirtualAccount:\n    def __init__(self):\n        self.load()\n        # 启动时先更新一次市值，确保日切计算基于最新数据\n        self.update_market_value()\n        self.check_daily_roll()\n\n    def load(self):\n        if os.path.exists(ACCOUNT_FILE):\n            with open(ACCOUNT_FILE, 'r', encoding='utf-8') as f:\n                data = json.load(f)\n                self.cash = data.get('cash', 100000.0)\n                self.positions = data.get('positions', {}) # {symbol: {cost: x, shares: y, name: z}}\n                self.total_value = data.get('total_value', 100000.0)\n                self.initial_capital = data.get('initial_capital', 100000.0)\n                self.last_day_value = data.get('last_day_value', 100000.0) # 昨日净值(用于算单日盈亏)\n                self.yesterday_pnl = data.get('yesterday_pnl', 0.0) # 新增：昨日具体盈亏额\n                self.nav_history = data.get('nav_history', []) # 新增：净值历史 [{'date':..., 'value':...}]\n                self.last_update_date = data.get('last_update_date', datetime.date.today().strftime(\"%Y-%m-%d\"))\n        else:\n            self.cash = 100000.0\n            self.positions = {}\n            self.total_value = 100000.0\n            self.initial_capital = 100000.0\n            self.last_day_value = 100000.0\n            self.yesterday_pnl = 0.0\n            self.nav_history = []\n            self.last_update_date = datetime.date.today().strftime(\"%Y-%m-%d\")\n            self.save()\n\n    def update_market_value(self):\n        \"\"\"实时更新持仓市值 (调用行情接口)\"\"\"\n        if not self.positions:\n            self.total_value = self.cash\n            return\n\n        try:\n            # 获取全市场实时行情 (一次性拉取比循环快)\n            df = ak.stock_zh_a_spot_em()\n            # 建立映射: 代码 -> 最新价\n            price_map = df.set_index('代码')['最新价'].to_dict()\n            \n            holdings_value = 0.0\n            for symbol, pos in self.positions.items():\n                # 如果获取不到现价，暂时用成本价兜底，避免归零\n                current_price = price_map.get(symbol, pos['cost'])\n                holdings_value += current_price * pos['shares']\n            \n            # 更新总资产\n            self.total_value = self.cash + holdings_value\n            # 不一定要每次都 save，但为了前端实时性，这里 save 一下\n            self.save()\n            logging.info(f\"市值已更新: ￥{self.total_value:.2f}\")\n            \n        except Exception as e:\n            logging.error(f\"更新市值失败: {e}\")\n\n    def check_daily_roll(self):\n        \"\"\"检查是否跨天，如果是，更新昨日净值\"\"\"\n        today = datetime.date.today().strftime(\"%Y-%m-%d\")\n        if today != self.last_update_date:\n            logging.info(f\"执行日切: 日期从 {self.last_update_date} 变为 {today}\")\n            \n            # 1. 计算昨天的盈亏 (昨天的最终资产 - 昨天的起始资产)\n            daily_pnl = self.total_value - self.last_day_value\n            self.yesterday_pnl = daily_pnl\n            \n            # 2. 记录历史净值 (归档昨天的数据)\n            self.nav_history.append({\n                \"date\": self.last_update_date,\n                \"total_value\": self.total_value,\n                \"daily_pnl\": daily_pnl\n            })\n            \n            # 3. 更新基准\n            self.last_day_value = self.total_value # 昨天的最终净值变成今天的基准\n            self.last_update_date = today\n            self.save()\n\n    def save(self):\n        if not os.path.exists(DATA_DIR):\n            os.makedirs(DATA_DIR)\n        \n        data = {\n            'cash': self.cash,\n            'positions': self.positions,\n            'total_value': self.total_value,\n            'initial_capital': getattr(self, 'initial_capital', 100000.0),\n            'last_day_value': getattr(self, 'last_day_value', 100000.0),\n            'yesterday_pnl': getattr(self, 'yesterday_pnl', 0.0),\n            'nav_history': getattr(self, 'nav_history', []),\n            'last_update_date': getattr(self, 'last_update_date', datetime.date.today().strftime(\"%Y-%m-%d\")),\n            'update_time': datetime.datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n        }\n        with open(ACCOUNT_FILE, 'w', encoding='utf-8') as f:\n            json.dump(data, f, ensure_ascii=False, indent=2)\n\n    def buy(self, symbol, name, price, shares, reason):\n        # 交易前再次重载最新的资金状态，防止内存数据过时\n        self.load()\n        \n        cost = price * shares\n        # 预留 100 元作为手续费缓冲\n        if self.cash >= (cost + 100):\n            self.cash -= cost\n            if symbol not in self.positions:\n                self.positions[symbol] = {'cost': price, 'shares': 0, 'name': name}\n            \n            # 更新持仓均价和数量\n            old_shares = self.positions[symbol]['shares']\n            old_cost = self.positions[symbol]['cost']\n            new_shares = old_shares + shares\n            new_cost = (old_cost * old_shares + cost) / new_shares\n            \n            self.positions[symbol]['shares'] = new_shares\n            self.positions[symbol]['cost'] = new_cost\n            \n            self.log_trade(\"BUY\", symbol, name, price, shares, reason)\n            self.save()\n            return True\n        else:\n            logging.warning(f\"资金不足，放弃买入 {symbol}: 需要 {cost:.2f}, 当前 {self.cash:.2f}\")\n            return False\n\n    def sell(self, symbol, price, reason):\n        # 交易前重载状态\n        self.load()\n        if symbol in self.positions:\n            shares = self.positions[symbol]['shares']\n            income = price * shares\n            self.cash += income\n            name = self.positions[symbol]['name']\n            del self.positions[symbol]\n            \n            self.log_trade(\"SELL\", symbol, name, price, shares, reason)\n            self.save()\n            return True\n        return False\n\n    def log_trade(self, action, symbol, name, price, shares, reason):\n        record = {\n            'time': datetime.datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n            'action': action,\n            'symbol': symbol,\n            'name': name,\n            'price': price,\n            'shares': shares,\n            'amount': price * shares,\n            'reason': reason\n        }\n        \n        file_exists = os.path.exists(TRADES_FILE)\n        df = pd.DataFrame([record])\n        df.to_csv(TRADES_FILE, mode='a', header=not file_exists, index=False, encoding='utf-8-sig')\n        logging.info(f\"交易执行: {action} {symbol} {name} @ {price}, 原因: {reason}\")\n\n# --- 策略核心 ---\ndef calculate_signals(symbol):\n    \"\"\"对单只股票拉取K线计算 RSI + 布林带\"\"\"\n    try:\n        # 获取最近60天的日线数据\n        end_date = datetime.date.today().strftime(\"%Y%m%d\")\n        start_date = (datetime.date.today() - datetime.timedelta(days=100)).strftime(\"%Y%m%d\")\n        \n        df = ak.stock_zh_a_hist(symbol=symbol, period=\"daily\", start_date=start_date, end_date=end_date, adjust=\"qfq\")\n        if df.empty or len(df) < 30:\n            return None\n            \n        df.rename(columns={\"日期\": \"date\", \"开盘\": \"open\", \"收盘\": \"close\", \"最高\": \"high\", \"最低\": \"low\", \"成交量\": \"volume\"}, inplace=True)\n        \n        # 计算 RSI (14)\n        delta = df['close'].diff()\n        gain = (delta.where(delta > 0, 0)).rolling(window=14).mean()\n        loss = (-delta.where(delta < 0, 0)).rolling(window=14).mean()\n        rs = gain / loss\n        df['rsi'] = 100 - (100 / (1 + rs))\n        \n        # 计算布林带 (20, 2)\n        df['bb_middle'] = df['close'].rolling(window=20).mean()\n        df['bb_std'] = df['close'].rolling(window=20).std()\n        df['bb_upper'] = df['bb_middle'] + 2 * df['bb_std']\n        df['bb_lower'] = df['bb_middle'] - 2 * df['bb_std']\n        \n        # 计算量比 (MA5)\n        df['vol_ma5'] = df['volume'].rolling(window=5).mean()\n        \n        latest = df.iloc[-1]\n        \n        # 量比处理: 如果 MA5 为0或空，设为 1.0\n        vol_ratio = 1.0\n        if latest['vol_ma5'] > 0:\n            vol_ratio = latest['volume'] / latest['vol_ma5']\n            \n        return {\n            'price': latest['close'],\n            'rsi': latest['rsi'],\n            'bb_lower': latest['bb_lower'],\n            'bb_upper': latest['bb_upper'],\n            'vol_ratio': vol_ratio,\n            'date': latest['date']\n        }\n    except Exception as e:\n        logging.error(f\"计算指标失败 {symbol}: {e}\")\n        return None\n\ndef run_bot():\n    account = VirtualAccount()\n    logging.info(\"=== 自动交易机器人启动 ===\")\n    logging.info(f\"当前资金: {account.cash}, 持仓数: {len(account.positions)}\")\n    \n    while True:\n        try:\n            now = datetime.datetime.now()\n            # 简单判断交易时间 (9:00 - 15:00), 实际应用可更精确\n            if 9 <= now.hour <= 15:\n                logging.info(f\"--- 开始新一轮扫描 {now.strftime('%H:%M:%S')} ---\")\n                \n                # 1. 检查持仓 (止盈/止损)\n                account.load() # 刷新状态\n                for symbol in list(account.positions.keys()):\n                    pos = account.positions[symbol]\n                    res = calculate_signals(symbol)\n                    \n                    if res:\n                        current_price = res['price']\n                        cost_price = pos['cost']\n                        pct_change = (current_price - cost_price) / cost_price\n                        \n                        sell_reason = None\n                        if pct_change <= -STOP_LOSS_PCT:\n                            sell_reason = f\"止损 (当前 {pct_change*100:.2f}%)\"\n                        elif pct_change >= TAKE_PROFIT_PCT:\n                            sell_reason = f\"止盈 (当前 {pct_change*100:.2f}%)\"\n                        elif res['price'] > res['bb_upper'] and res['rsi'] > 70:\n                            sell_reason = \"技术指标逃顶 (突破布林上轨+RSI超买)\"\n                            \n                        if sell_reason:\n                            account.sell(symbol, current_price, sell_reason)\n                \n                # 2. 扫描机会 (买入)\n                if len(account.positions) < MAX_POSITIONS:\n                    # 获取全市场实时数据 (极快)\n                    logging.info(\"正在拉取全市场实时行情...\")\n                    spot_df = ak.stock_zh_a_spot_em()\n                    \n                    # 字段标准化\n                    spot_df.rename(columns={'涨跌幅': 'change_pct', '量比': 'vol_ratio', '最新价': 'price', '总市值': 'market_cap'}, inplace=True)\n                    \n                    # --- 全市场漏斗筛选 ---\n                    # 1. 基础过滤: 剔除停牌(无最新价)、剔除微盘股(<30亿)、剔除涨停/跌停(无法交易)\n                    # 2. 策略初筛: 既然要抄底，必须是绿盘(change_pct < -1.0)，且有量(vol_ratio > 1.0)\n                    mask = (\n                        (spot_df['price'] > 0) & \n                        (spot_df['market_cap'] > 3000000000) & # 30亿以上，避免流动性陷阱\n                        (spot_df['change_pct'] < -1.0) &  # 至少跌1个点，才值得看是否超跌\n                        (spot_df['vol_ratio'] > 1.0)      # 必须放量\n                    )\n                    candidates = spot_df[mask]\n                    \n                    # 3. 排序: 优先看量比大(主力活跃) 或 跌幅深(超跌可能性大) 的\n                    # 这里混合排序：按量比倒序\n                    candidates = candidates.sort_values(by='vol_ratio', ascending=False)\n                    \n                    logging.info(f\"全市场初筛命中: {len(candidates)} 只 (条件: 市值>30亿 & 跌幅>1% & 量比>1)\")\n                    \n                    # 4. 深度扫描 (逐个拉K线)\n                    # 限制每轮最多扫描 50 只，防止一轮耗时太久导致数据过时\n                    scan_count = 0\n                    max_scan = 50 \n                    \n                    for _, row in candidates.iterrows():\n                        if len(account.positions) >= MAX_POSITIONS:\n                            break\n                        if scan_count >= max_scan:\n                            logging.info(f\"本轮扫描已达上限 ({max_scan}只)，暂停进入下一轮...\")\n                            break\n                            \n                        symbol = str(row['代码'])\n                        name = str(row['名称'])\n                        \n                        # 跳过已持仓\n                        if symbol in account.positions:\n                            continue\n                            \n                        # logging.info(f\"正在深度分析: {symbol} {name} ...\")\n                        # 深度计算指标 (耗时操作)\n                        signals = calculate_signals(symbol)\n                        scan_count += 1\n                        \n                        if signals:\n                            # 策略逻辑: 价格 < 布林下轨 AND RSI < 30\n                            if (signals['price'] < signals['bb_lower']) and (signals['rsi'] < RSI_BUY):\n                                logging.info(f\"🎯 发现目标! {name} RSI={signals['rsi']:.1f}\")\n                                # 执行买入\n                                buy_price = signals['price']\n                                shares = int(SINGLE_POS_CASH / buy_price / 100) * 100 \n                                if shares >= 100:\n                                    reason = f\"量价超跌 (RSI={signals['rsi']:.1f}, 量比={row['vol_ratio']:.1f})\"\n                                    account.buy(symbol, name, buy_price, shares, reason)\n                        \n                        time.sleep(0.5) # 稍微加快一点频次，0.5s一次\n            \n            else:\n                logging.info(\"休市时间，等待中...\")\n            \n            # 每轮间隔 5 分钟\n            time.sleep(300)\n            \n        except Exception as e:\n            logging.error(f\"主循环异常: {e}\")\n            time.sleep(60)\n\nif __name__ == \"__main__\":\n    if not os.path.exists(DATA_DIR):\n        os.makedirs(DATA_DIR)\n    run_bot()",
                "content": "import pandas as pd\nimport akshare as ak\nimport time\nimport datetime\nimport os\nimport json\nimport logging\nfrom abc import ABC, abstractmethod\n\n# --- 配置区 ---\n# 切换模式: \"SIMULATION\" (模拟盘) / \"REAL\" (实盘)\nTRADING_MODE = \"SIMULATION\" \n\nDATA_DIR = \"data\"\nACCOUNT_FILE = os.path.join(DATA_DIR, \"account.json\")\nTRADES_FILE = os.path.join(DATA_DIR, \"trades.csv\")\nLOG_FILE = os.path.join(DATA_DIR, \"bot.log\")\n\n# 确保数据目录存在\nif not os.path.exists(DATA_DIR):\n    os.makedirs(DATA_DIR)\n\n# 策略参数\nRSI_BUY = 30\nVOL_RATIO_MIN = 1.2\nSTOP_LOSS_PCT = 0.05\nTAKE_PROFIT_PCT = 0.10\nMAX_POSITIONS = 5\nSINGLE_POS_CASH = 20000\n\n# 初始化日志\nlogging.basicConfig(\n    level=logging.INFO,\n    format='%(asctime)s - %(levelname)s - %(message)s',\n    handlers=[\n        logging.FileHandler(LOG_FILE, encoding='utf-8'),\n        logging.StreamHandler()\n    ]\n)\n\n# ==============================================================================\n# 交易接口基类 (定义标准)\n# ==============================================================================\nclass BaseTrader(ABC):\n    @abstractmethod\n    def buy(self, symbol, name, price, shares, reason):\n        pass\n\n    @abstractmethod\n    def sell(self, symbol, price, reason):\n        pass\n    \n    @abstractmethod\n    def sync_assets(self):\n        \"\"\"同步资产状态（更新 account.json 供前端展示）\"\"\"\n        pass\n    \n    @property\n    @abstractmethod\n    def positions(self):\n        pass\n\n    def log_trade(self, action, symbol, name, price, shares, reason):\n        \"\"\"通用日志记录\"\"\"\n        record = {\n            'time': datetime.datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n            'action': action,\n            'symbol': symbol,\n            'name': name,\n            'price': price,\n            'shares': shares,\n            'amount': price * shares,\n            'reason': reason\n        }\n        file_exists = os.path.exists(TRADES_FILE)\n        df = pd.DataFrame([record])\n        df.to_csv(TRADES_FILE, mode='a', header=not file_exists, index=False, encoding='utf-8-sig')\n        logging.info(f\"交易执行[{TRADING_MODE}]: {action} {symbol} {name} @ {price}, 原因: {reason}\")\n\n# ==============================================================================\n# 1. 模拟交易实现 (原 VirtualAccount)\n# ==============================================================================\nclass VirtualTrader(BaseTrader):\n    def __init__(self):\n        self.load()\n        self.update_market_value()\n        self.check_daily_roll()\n\n    def load(self):\n        if os.path.exists(ACCOUNT_FILE):\n            with open(ACCOUNT_FILE, 'r', encoding='utf-8') as f:\n                data = json.load(f)\n                self.cash = data.get('cash', 100000.0)\n                self._positions = data.get('positions', {}) \n                self.total_value = data.get('total_value', 100000.0)\n                self.initial_capital = data.get('initial_capital', 100000.0)\n                self.last_day_value = data.get('last_day_value', 100000.0)\n                self.yesterday_pnl = data.get('yesterday_pnl', 0.0)\n                self.nav_history = data.get('nav_history', [])\n                self.last_update_date = data.get('last_update_date', datetime.date.today().strftime(\"%Y-%m-%d\"))\n        else:\n            self.cash = 100000.0\n            self._positions = {}\n            self.total_value = 100000.0\n            self.initial_capital = 100000.0\n            self.last_day_value = 100000.0\n            self.yesterday_pnl = 0.0\n            self.nav_history = []\n            self.last_update_date = datetime.date.today().strftime(\"%Y-%m-%d\")\n            self.sync_assets() # save\n\n    @property\n    def positions(self):\n        return self._positions\n\n    def update_market_value(self):\n        if not self._positions:\n            self.total_value = self.cash\n            return\n        try:\n            df = ak.stock_zh_a_spot_em()\n            price_map = df.s