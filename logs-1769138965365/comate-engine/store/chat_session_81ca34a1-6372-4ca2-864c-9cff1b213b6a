.0\n            self.initial_capital = 100000.0\n            self.last_day_value = 100000.0\n            self.yesterday_pnl = 0.0\n            self.nav_history = []\n            self.last_update_date = datetime.date.today().strftime(\"%Y-%m-%d\")\n            self.save()\n\n    def update_market_value(self):\n        \"\"\"实时更新持仓市值 (调用行情接口)\"\"\"\n        if not self.positions:\n            self.total_value = self.cash\n            return\n\n        try:\n            # 获取全市场实时行情 (一次性拉取比循环快)\n            df = ak.stock_zh_a_spot_em()\n            # 建立映射: 代码 -> 最新价\n            price_map = df.set_index('代码')['最新价'].to_dict()\n            \n            holdings_value = 0.0\n            for symbol, pos in self.positions.items():\n                # 如果获取不到现价，暂时用成本价兜底，避免归零\n                current_price = price_map.get(symbol, pos['cost'])\n                holdings_value += current_price * pos['shares']\n            \n            # 更新总资产\n            self.total_value = self.cash + holdings_value\n            # 不一定要每次都 save，但为了前端实时性，这里 save 一下\n            self.save()\n            logging.info(f\"市值已更新: ￥{self.total_value:.2f}\")\n            \n        except Exception as e:\n            logging.error(f\"更新市值失败: {e}\")\n\n    def check_daily_roll(self):\n        \"\"\"检查是否跨天，如果是，更新昨日净值\"\"\"\n        today = datetime.date.today().strftime(\"%Y-%m-%d\")\n        if today != self.last_update_date:\n            logging.info(f\"执行日切: 日期从 {self.last_update_date} 变为 {today}\")\n            \n            # 1. 计算昨天的盈亏 (昨天的最终资产 - 昨天的起始资产)\n            daily_pnl = self.total_value - self.last_day_value\n            self.yesterday_pnl = daily_pnl\n            \n            # 2. 记录历史净值 (归档昨天的数据)\n            self.nav_history.append({\n                \"date\": self.last_update_date,\n                \"total_value\": self.total_value,\n                \"daily_pnl\": daily_pnl\n            })\n            \n            # 3. 更新基准\n            self.last_day_value = self.total_value # 昨天的最终净