      # 计算布林带 (20, 2)\n        df['bb_middle'] = df['close'].rolling(window=20).mean()\n        df['bb_std'] = df['close'].rolling(window=20).std()\n        df['bb_upper'] = df['bb_middle'] + 2 * df['bb_std']\n        df['bb_lower'] = df['bb_middle'] - 2 * df['bb_std']\n        \n        # 计算量比 (MA5)\n        df['vol_ma5'] = df['volume'].rolling(window=5).mean()\n        \n        latest = df.iloc[-1]\n        \n        # 量比处理: 如果 MA5 为0或空，设为 1.0\n        vol_ratio = 1.0\n        if latest['vol_ma5'] > 0:\n            vol_ratio = latest['volume'] / latest['vol_ma5']\n            \n        return {\n            'price': latest['close'],\n            'rsi': latest['rsi'],\n            'bb_lower': latest['bb_lower'],\n            'bb_upper': latest['bb_upper'],\n            'vol_ratio': vol_ratio,\n            'date': latest['date']\n        }\n    except Exception as e:\n        logging.error(f\"计算指标失败 {symbol}: {e}\")\n        return None\n\ndef run_bot():\n    account = VirtualAccount()\n    logging.info(\"=== 自动交易机器人启动 ===\")\n    logging.info(f\"当前资金: {account.cash}, 持仓数: {len(account.positions)}\")\n    \n    while True:\n        try:\n            now = datetime.datetime.now()\n            # 简单判断交易时间 (9:00 - 15:00), 实际应用可更精确\n            if 9 <= now.hour <= 15:\n                logging.info(f\"--- 开始新一轮扫描 {now.strftime('%H:%M:%S')} ---\")\n                \n                # 1. 检查持仓 (止盈/止损)\n                account.load() # 刷新状态\n                for symbol in list(account.positions.keys()):\n                    pos = account.positions[symbol]\n                    res = calculate_signals(symbol)\n                    \n                    if res:\n                        current_price = res['price']\n                        cost_price = pos['cost']\n                        pct_change = (current_price - cost_price) / cost_price\n                        \n                        sell_reason = None\n                        if pct_change <= -STOP_LOSS_PCT:\n                            sell_reason = f\"止损 (当前 {pct_change*100:.2f}%)\"\n                        elif pct_change >= TAKE_PROFIT_PCT:\n                            sell_reason = f\"止盈 (当前 {pct_change*100:.2f}%)\"\n                        elif res['price'] > res['bb_upper'] and res['rsi'] > 70:\n                            sell_reason = \"技术指标逃顶 (突破布林上轨+RSI超买)\"\n                            \n                        if sell_reason:\n                            account.sell(symbol, current_price, sell_reason)\n                \n                # 2. 扫描机会 (买入)\n                if len(account.positions) < MAX_POSITIONS:\n                    # 获取全市场实时数据 (极快)\n                    spot_df = ak.stock_zh_a_spot_em()\n                    \n                    # 粗筛: 跌幅在 2%~6% 之间 (寻找超跌但不是跌停), 且量比大于1\n                    # 注意: spot_df 字段: 代码,名称,最新价,涨跌幅,量比...\n                    # 字段名可能变化，需防御性编程\n                    spot_df.rename(columns={'涨跌幅': 'change_pct', '量比': 'vol_ratio', '最新价': 'price'}, inplace=True)\n                    \n                    # 筛选候选池 (只看前50个符合条件的，避免计算量太大)\n                    candidates = spot_df[\n                        (spot_df['change_pct'] < -2.0) & \n                        (spot_df['change_pct'] > -7.0) & \n                        (spot_df['vol_ratio'] > 1.1)\n                    ].head(20)\n                    \n                    logging.info(f\"初筛候选股数量: {len(candidates)}\")\n                    \n                    for _, row in candidates.iterrows():\n                        if len(account.positions) >= MAX_POSITIONS:\n                            break\n                            \n                        symbol = str(row['代码'])\n                        name = str(row['名称'])\n                        \n                        # 跳过已持仓\n                        if symbol in account.positions:\n                            continue\n                            \n                        logging.info(f\"正在分析: {symbol} {name} ...\")\n                       