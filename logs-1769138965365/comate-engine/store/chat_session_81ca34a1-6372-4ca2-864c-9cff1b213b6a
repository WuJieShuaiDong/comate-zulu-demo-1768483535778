wer'], 'bb_upper': latest['bb_upper'], 'vol_ratio': vol_ratio}\n    except Exception as e:\n        logging.error(f\"计算失败 {symbol}: {e}\")\n        return None\n\ndef run_bot():\n    if TRADING_MODE == \"REAL_QMT\":\n        trader = RealQMTTrader()\n    else:\n        trader = VirtualTrader()\n        \n    logging.info(f\"=== 自动交易机器人启动 (模式: {TRADING_MODE}) ===\")\n    \n    while True:\n        try:\n            now = datetime.datetime.now()\n            if 9 <= now.hour <= 15:\n                # 每一轮都同步最新资产\n                trader.sync_assets()\n                logging.info(f\"--- 扫描开始 {now.strftime('%H:%M:%S')} ---\")\n                \n                # 1. 卖出检查\n                current_positions = list(trader.positions.keys())\n                for symbol in current_positions:\n                    pos = trader.positions[symbol]\n                    res = calculate_signals(symbol)\n                    if res:\n                        current_price = res['price']\n                        cost_price = pos['cost']\n                        pct_change = (current_price - cost_price) / cost_price if cost_price > 0 else 0\n                        \n                        sell_reason = None\n                        if pct_change <= -STOP_LOSS_PCT: sell_reason = f\"止损 ({pct_change*100:.2f}%)\"\n                        elif pct_change >= TAKE_PROFIT_PCT: sell_reason = f\"止盈 ({pct_change*100:.2f}%)\"\n                        elif res['price'] > res['bb_upper'] and res['rsi'] > 70: sell_reason = \"技术逃顶\"\n                            \n                        if sell_reason:\n                            trader.sell(symbol, current_price, sell_reason)\n                \n                # 2. 买入扫描\n                if len(trader.positions) < MAX_POSITIONS:\n                    logging.info(\"拉取行情中...\")\n                    spot_df = ak.stock_zh_a_spot_em()\n                    spot_df.rename(columns={'涨跌幅': 'change_pct', '量比': 'vol_ratio', '最新价': 'price', '总市值': 'market_cap'}, in