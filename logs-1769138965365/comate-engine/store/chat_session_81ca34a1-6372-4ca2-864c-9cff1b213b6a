in_vol_ratio = st.sidebar.slider(\"买入量比阈值\", 0.5, 3.0, 1.0, step=0.1, help=\"今日成交量 / 5日均量。1.0表示只要大于均量即可，1.5表示明显放量\")\n\n    st.sidebar.subheader(\"3. 风控设置 (滚雪球关键)\")\n    take_profit_pct = st.sidebar.number_input(\"止盈比例 (%)\", value=15.0) / 100\n    stop_loss_pct = st.sidebar.number_input(\"止损比例 (%)\", value=5.0) / 100\n    \n    if st.sidebar.button(\"启动波段狙击\"):\n        with st.spinner(\"正在计算量价指标...\"):\n            raw_df = get_stock_data(symbol, start_date, end_date)\n            if raw_df is not None:\n                df = calculate_indicators(raw_df)\n                \n                # --- 交易逻辑 ---\n                df['position_signal'] = 0 # 1:买入, -1:卖出\n                \n                # 状态变量\n                holding = False\n                entry_price = 0.0\n                capital = 100000.0\n                initial_capital = capital\n                portfolio_history = []\n                trades = []\n                \n                for date, row in df.iterrows():\n                    current_price = row['close']\n                    action = 0 # 记录当日动作\n                    \n                    if not holding:\n                        # === 抄底信号 ===\n                        # 1. 价格条件: 跌破布林下轨 AND RSI低位\n                        price_condition = (row['close'] < row['bb_lower']) and (row['rsi'] < rsi_buy_threshold)\n                        \n                        # 2. 量能条件: 成交量放大 (如果有要求)\n                        vol_condition = True\n                        if enable_vol_filter:\n                            # 确保 volume_ratio 不是 NaN (前5天没有均线)\n                            if pd.notna(row['vol_ratio']):\n                                vol_condition = row['vol_ratio'] > min_vol_ratio\n                            else:\n                                vol_condition = False\n                        \n                        if price_condition and vol_condition:\n                            holding = True\n                            entry_price = current_price\n                            capital -= current_price * 100 # 假设买1手(100股) - 简化模型仅演示逻辑\n                            # 实际应该全仓或按比例，这里简化为模拟单位净值\n                            action = 1\n                            trades.append({'date': date, 'type': 'buy', 'price': current_price, 'vol_ratio': row['vol_ratio']})\n                    \n                    else:\n                        # === 逃顶/止盈/止损信号 ===\n                        \n                        # 1. 止损 (保命)\n                        if current_price <= entry_price * (1 - stop_loss_pct):\n                            holding = False\n                            capital += current_price * 100\n                            action = -1\n                            trades.append({'date': date, 'type': 'stop_loss', 'price': current_price})\n                            \n                        # 2. 止盈 (落袋为安)\n                        elif current_price >= entry_price * (1 + take_profit_pct):\n                            holding = False\n                            capital += current_price * 100\n                            action = -1\n                            trades.append({'date': date, 'type': 'take_profit', 'price': current_price})\n                            \n                        # 3. 技术面逃顶: 突破布林上轨 AND RSI高位\n                        elif (row['close'] > row['bb_upper']) and (row['rsi'] > rsi_sell_threshold):\n                            holding = False\n                            capital += current_price * 100\n                            action = -1\n                            trades.append({'date': date, 'type': 'sell_signal', 'price': current_price})\n                    \n                    # 记录净值 (现金 + 持仓市值)\n                    current_value = capital + (current_price * 100 if holding else 0)\n                    portfolio_history.append(current_value)\n                \n                df['portfolio_value'] = portfolio_history\n                \n                # --- 结果展示 ---\n                total_ret = (df['portfolio_value'].iloc[-1] - initial_capital) / initial_capital * 100\n                st.metric(\"策略总收益率 (模拟)\", f\"{total_ret:.2f}%\", \n                          delta=f\"交易次数: {len(trades)}\")\n                \n                # 绘图\n                fig = make_subplots(rows=3, cols=1, shared_xaxes=True, \n                                    row_heights=[0.5, 0.25, 0.25],\n                                    subplot_titles=(\"K线与布林带 (买卖点)\", \"资金曲线\", \"RSI 指标\"))\n                \n                # 1. K线 + 布林带\n                fig.add_trace(go.Candlestick(x=df.index, open=df['open'], high=df['high'], low=df['low'], close=df['close'], name='K线'), row=1, col=1)\n                fig.add_trace(go.Scatter(x=df.index, y=df['bb_upper'], line=dict(color='rgba(0,0,255,0.3)'), name='布林上轨'), row=1, col=1)\n                fig.add_trace(go.Scatter(x=df.index, y=df['bb_lower'], line=dict(color='rgba(0,0,255,0.3)'), name='布林下轨'), row=1, col=1)\n                \n                # 标记交易点\n                buy_dates = [t['date'] for t in trades if t['type'] == 'buy']\n                buy_prices = [t['price'] for t in trades if t['type'] == 'buy']\n                sell_dates = [t['date'] for t in trades if t['type'] != 'buy']\n                sell_prices = [t['price'] for t in trades if t['type'] != 'buy']\n                \n                fig.add_trace(go.Scatter(x=buy_dates, y=buy_prices, mode='markers', marker=dict(symbol='triangle-up', color='red', size=12), name='抄底买入'), row=1, col=1)\n                fig.add_trace(go.Scatter(x=sell_dates, y=sell_prices, mode='markers', marker=dict(symbol='triangle-down', color='green', size=12), name='逃顶卖出'), row=1, col=1)\n\n                # 2. 资金曲线\n                fig.add_trace(go.Scatter(x=df.index, y=df['portfolio_value'], line=dict(color='orange'), name='账户净值'), row=2, col=1)\n                \n                # 3. RSI\n                fig.add_trace(go.Scatter(x=df.index, y=df['rsi'], line=dict(color='purple'), name='RSI'), row=3, col=1)\n                fig.add_hline(y=rsi_buy_threshold, line_dash=\"dash\", line_color=\"green\", row=3, col=1)\n                fig.add_hline(y=rsi_sell_threshold, line_dash=\"dash\", line_color=\"red\", row=3, col=1)\n                \n                fig.update_layout(height=900, hovermode=\"x unified\")\n                st.plotly_chart(fig, use_container_width=True)\n                \n                st.write(\"### 交易明细\")\n                st.table(pd.DataFrame(trades))\n\n# ==============================================================================\n# 模式 2: 智能选股 (全市场) - 保持原样\n# ==============================================================================\nelif mode == \"🔍 智能选股 (全市场)\":\n    st.header(\"1. 设定选股条件\")\n    col_a, col_b, col_c = st.columns(3)\n    with col_a:\n        min_pe = st.number_input(\"最小市盈率 (PE)\", value=0.0)\n        max_pe = st.number_input(\"最大市盈率 (PE)\", value=50.0)\n    with col_b:\n        min_cap = st.number_input(\"最小总市值 (亿)\", value=50.0)\n        max_cap = st.number_input(\"最大总市值 (亿)\", value=5000.0)\n    with col_c:\n        min_change = st.number_input(\"今日涨幅下限 (%)\", value=0.0)\n        max_change = st.number_input(\"今日涨幅上限 (%)\", value=9.9)\n    \n    sort_key = st.selectbox(\"排序依据\", [\"总市值\", \"市盈率-动态\", \"涨跌幅\", \"换手率\", \"量比\"], index=2)\n    top_n = st.slider(\"选出 Top N 只股票\", 5, 50, 10)\n    \n    # 选股函数\n    @st.cache_data(ttl=300) # 5分钟缓存\n    def scan_market():\n        try:\n            # 获取东财实时行情\n            df = ak.stock_zh_a_spot_em()\n            # 字段映射\n            # 代码,名称,最新价,涨跌幅,涨跌额,成交量,成交额,振幅,最高,最低,今开,昨收,量比,换手率,市盈率-动态,市净率,总市值\n            \n            # 数据清洗\n            df['总市值'] = df['总市值'] / 100000000.0 # 转为亿\n            return df\n        except Exception as e:\n            st.error(f\"获取全市场数据失败: {e}\")\n            return pd.DataFrame()\n\n    if st.button(\"开始全市场扫描选股\"):\n        with st.spinner(\"正在拉取全市场 5000+ 只股票数据...\"):\n            market_df = scan_market()\n            \n            if not market_df.empty:\n                # 执行筛选\n                mask = (\n                    (market_df['市盈率-动态'] >= min_pe) & \n                    (market_df['市盈率-动态'] <= max_pe) &\n                    (market_df['总市值'] >= min_cap) & \n                    (market_df['总市值'] <= max_cap) &\n                    (market_df['涨跌幅'] >= min_change) &\n                    (market_df['涨跌幅'] <= max_change)\n                )\n                filtered_df = market_df[mask]\n                \n                # 排序\n                ascending = True if \"市盈率\" in sort_key else False # PE越低越好，其他的通常越高越好(作为动量)\n                filtered_df = filtered_df.sort_values(by=sort_key, ascending=ascending)\n                \n                # 取 Top N\n                final_selection = filtered_df.head(top_n)\n                \n                st.success(f\"筛选完成！符合条件的股票共 {len(filtered_df)} 只，展示前 {top_n} 只。\")\n                st.dataframe(final_selection[['代码', '名称', '最新价', '涨跌幅', '市盈率-动态', '总市值', '换手率']])\n                \n                # --- 自动交易回测 (Portfolio Backtest) ---\n                st.markdown(\"---\")\n                st.header(\"2. 自动交易回测 (投资组合)\")\n                st.info(f\"将对选出的这 {len(final_selection)} 只股票进行组合回测。策略：等权买入并持有。\")\n                \n                bt_start = st.date_input(\"回测开始日期\", value=datetime.date.today() - datetime.timedelta(days=365))\n                bt_end = st.date_input(\"回测结束日期\", value=datetime.date.today())\n                \n                if st.button(\"运行组合回测\"):\n                    progress_bar = st.progress(0)\n                    status_text = st.empty()\n                    \n                    # 准备容器\n                    portfolio_value = pd.Series(dtype='float64')\n                    valid_stocks_count = 0\n                    \n                    codes = final_selection['代码'].tolist()\n                    \n                    for i, code in enumerate(codes):\n                        status_text.text(f\"正在拉取 {code} ({i+1}/{len(codes)})...\")\n                        try:\n                            # 获取个股数据\n                            stock_df = ak.stock_zh_a_hist(symbol=code, period=\"daily\", \n                                                        start_date=bt_start.strftime(\"%Y%m%d\"), \n                                                        end_date=bt_end.strftime(\"%Y%m%d\"), \n                                                        adjust=\"qfq\")\n                            \n                            if not stock_df.empty:\n                                stock_df['日期'] = pd.to_datetime(stock_df['日期'])\n                                stock_df.set_index('日期', inplace=True)\n                                \n                                # 计算归一化净值 (从1开始)\n                                # 假设第一天买入\n                                first_price = stock_df['收盘'].iloc[0]\n                                stock_df['norm_value'] = stock_df['收盘'] / first_price\n                                \n                                if valid_stocks_count == 0:\n                                    portfolio_value = stock_df['norm_value']\n                                else:\n                                    # 对齐索引相加 (自动处理停牌日，缺失值需填充)\n                                    portfolio_value = portfolio_value.add(stock_df['norm_value'], fill_value=0)\n                                \n                                valid_stocks_count += 1\n                                \n                        except Exception as e:\n                            # 某些股票可能拉取失败，跳过\n                            continue\n                        \n                        # 更新进度条\n                        progress_bar.progress((i + 1) / len(codes))\n                    \n                    if valid_stocks_count > 0:\n                        # 计算平均净值 (等权组合)\n                        portfolio_value = portfolio_value / valid_stocks_count\n                        portfolio_value = portfolio_value.dropna()\n                        \n                        st.success(\"组合回测完成！\")\n                        \n                        # 绘制组合曲线\n                        fig_port = go.Figure()\n                        fig_port.add_trace(go.Scatter(x=portfolio_value.index, y=portfolio_value, \n                                                    mode='lines', name='智能选股组合净值',\n                                                    line=dict(color='firebrick', width=2)))\n                        fig_port.update_layout(title=\"投资组合收益曲线 (等权持有)\", \n                                             xaxis_title=\"日期\", yaxis_title=\"净值 (初始=1)\")\n                        st.plotly_chart(fig_port, use_container_width=True)\n                        \n                        # 计算指标\n                        total_ret = (portfolio_value.iloc[-1] - 1) * 100\n                        st.metric(\"组合累计收益率\", f\"{total_ret:.2f}%\")\n                    else:\n                        st.error(\"未能获取到有效数据，请检查网络或日期范围。\")\n\n# ==============================================================================\n# 模块 3: 基础趋势回测\n# ==============================================================================\nelif mode == \"📈 基础趋势回测 (双均线)\":\n    # 简化版保留，代码略（为节省篇幅，实际应用中保留原有逻辑即可，此处略微简化）\n    st.info(\"请使用侧边栏参数进行标准双均线策略回测。\")\n    symbol = st.sidebar.text_input(\"股票代码\", value=\"600519\")\n    s_date = st.sidebar.date_input(\"开始\", datetime.date(2023,1,1))\n    e_date = st.sidebar.date_input(\"结束\", datetime.date.today())\n    short_w = st.sidebar.number_input(\"短均线\", 5)\n    long_w = st.sidebar.number_input(\"长均线\", 20)\n    \n    if st.sidebar.button(\"开始回测\"):\n        with st.spinner(\"正在获取数据并进行计算...\"):\n            df = get_stock_data(symbol, s_date, e_date)\n            if df is not None:\n                df['s'] = df['close'].rolling(short_w).mean()\n                df['l'] = df['close'].rolling(long_w).mean()\n                df['sig'] = (df['s'] > df['l']).astype(int)\n                df['ret'] = df['close'].pct_change() * df['sig'].shift(1)\n                df['cum'] = (1+df['ret']).cumprod()\n                \n                st.line_chart(df['cum'])\n                st.write(\"此模式为简化版，请使用上方进阶模式体验更强功能。\")",
                "afterChangeFileContent": "import streamlit as st\nimport pandas as pd\nimport akshare as ak\nimport plotly.graph_objects as go\nfrom plotly.subplots import make_subplots\nimport datetime\nimport numpy as np\nimport os\nimport json\nimport time\n\n# --- 页面配置 ---\nst.set_page_config(page_title=\"高阶量化交易系统\", layout=\"wide\", page_icon=\"🚀\")\nst.title(\"🚀 A股高阶量化交易系统 (波段狙击版)\")\n\n# 自动刷新 (为了监控面板)\nif 'auto_refresh' not in st.session_state:\n    st.session_state.auto_refresh = False\n\n# --- 功能模式选择 ---\nmode = st.sidebar.radio(\"选择功能模块\", [\n    \"🤖 自动化实盘监控 (AutoBot)\",\n    \"🔥 进阶波段策略 (回测)\", \n    \"🔍 智能选股 (全市场)\", \n    \"📈 基础趋势回测 (双均线)\"\n])\n\n# --- 侧边栏：高级数据校准 (用于修正历史数据) ---\nwith st.sidebar.expander(\"🛠️ 账户数据校准 (高级)\"):\n    st.caption(\"如果数据不准，可在此手动修正基准值\")\n    data_dir = \"data\"\n    account_file = os.path.join(data_dir, \"account.json\")\n    \n    if os.path.exists(account_file):\n        try:\n            with open(account_file, 'r', encoding='utf-8') as f:\n                acc_calib = json.load(f)\n                \n            new_init = st.number_input(\"修正初始资金\", value=acc_calib.get('initial_capital', 100000.0))\n            new_last = st.number_input(\"修正昨日净值 (影响今日盈亏)\", value=acc_calib.get('last_day_value', 100000.0))\n            new_yest_pnl = st.number_input(\"修正昨日盈亏 (仅展示)\", value=acc_calib.get('yesterday_pnl', 0.0))\n            \n            st.markdown(\"---\")\n            st.caption(\"持仓成本修正 (慎用)\")\n            \n            # 动态生成持仓修正输入框\n            positions_calib = acc_calib.get('positions', {})\n            new_costs = {}\n            for sym, pos in positions_calib.items():\n                cost_val = float(pos.get('cost', 0.0))\n                # 使用两列布局，左边显示股票名，右边输入新成本\n                c1, c2 = st.columns([1, 2])\n                c1.text(f\"{pos.get('name', sym)}\")\n                new_c = c2.number_input(f\"修正成本 ({sym})\", value=cost_val, key=f\"cost_{sym}\")\n                new_costs[sym] = new_c\n\n            if st.button(\"💾 保存全部修正\"):\n                # --- 关键修复：防止并发覆盖 ---\n                try:\n                    with open(account_file, 'r', encoding='utf-8') as f:\n                        latest_acc = json.load(f)\n                    \n                    # 1. 更新账户基准\n                    latest_acc['initial_capital'] = new_init\n                    latest_acc['last_day_value'] = new_last\n                    latest_acc['yesterday_pnl'] = new_yest_pnl\n                    \n                    # 2. 更新持仓成本\n                    for sym, new_c in new_costs.items():\n                        if sym in latest_acc.get('positions', {}):\n                            latest_acc['positions'][sym]['cost'] = new_c\n                            \n                    with open(account_file, 'w', encoding='utf-8') as f:\n                        json.dump(latest_acc, f, ensure_ascii=False, indent=2)\n                    st.success(\"数据已修正！请刷新页面。\")\n                except Exception as ex:\n                    st.error(f\"保存失败: {ex}\")\n        except Exception as e:\n            st.error(f\"读取失败: {e}\")\n    else:\n        st.warning(\"未找到账户文件\")\n\n# --- 通用工具函数 ---\n@st.cache_data(ttl=3600)\ndef get_stock_data(symbol, start_date, end_date):\n    \"\"\"获取数据并计算核心指标\"\"\"\n    start_str = start_date.strftime(\"%Y%m%d\")\n    end_str = end_date.strftime(\"%Y%m%d\")\n    try:\n        df = ak.stock_zh_a_hist(symbol=symbol, period=\"daily\", start_date=start_str, end_date=end_str, adjust=\"qfq\")\n        if df.empty: return None\n        df.rename(columns={\"日期\": \"date\", \"开盘\": \"open\", \"收盘\": \"close\", \"最高\": \"high\", \"最低\": \"low\", \"成交量\": \"volume\"}, inplace=True)\n        df['date'] = pd.to_datetime(df['date'])\n        df.set_index('date', inplace=True)\n        return df\n    except Exception as e:\n        st.error(f\"数据异常: {e}\")\n        return None\n\nimport requests\n\n@st.cache_data(ttl=5) # 极短缓存，保证数据新鲜\ndef get_realtime_quotes(stock_list):\n    \"\"\"仅获取持仓股票的实时行情 (直连东财API，最稳)\"\"\"\n    if not stock_list:\n        return {}\n    \n    price_map = {}\n    \n    # 将股票代码转换为东财 SECID 格式 (6开头:1.xxxxxx, 0/3开头:0.xxxxxx)\n    secids = []\n    for code in stock_list:\n        if str(code).startswith('6'):\n            secids.append(f\"1.{code}\")\n        else:\n            secids.append(f\"0.{code}\")\n            \n    if not secids:\n        return {}\n        \n    try:\n        # 批量获取行情接口 (比 akshare 更轻量，不易超时)\n        # 字段: f12=代码, f14=名称, f2=最新价, f3=涨跌幅, f4=涨跌额\n        url = \"http://push2.eastmoney.com/api/qt/ulist/get\"\n        params = {\n            \"fltt\": \"2\",\n            \"secids\": \",\".join(secids),\n            \"fields\": \"f12,f14,f2,f3\",\n            \"pn\": \"1\",\n            \"pz\": \"100\" # 最多一次查100个\n        }\n        \n        # 设置超时时间，避免卡死\n        resp = requests.get(url, params=params, timeout=3)\n        if resp.status_code == 200:\n            data = resp.json()\n            if data and 'data' in data and data['data'] and 'diff' in data['data']:\n                for item in data['data']['diff']:\n                    code = item['f12']\n                    price = item['f2']\n                    # 东财接口有时返回 \"-\" 代表停牌或无效\n                    if price != \"-\":\n                        price_map[code] = float(price)\n                    \n    except Exception as e:\n        # 如果直连失败，可以在界面上短暂提示一下，方便调试\n        # st.toast(f\"行情接口报错: {e}\")\n        pass\n            \n    return price_map\n\ndef calculate_indicators(df):\n    \"\"\"计算技术指标: RSI, MACD, Bollinger Bands\"\"\"\n    data = df.copy()\n    \n    # 1. RSI (14日)\n    delta = data['close'].diff()\n    gain = (delta.where(delta > 0, 0)).rolling(window=14).mean()\n    loss = (-delta.where(delta < 0, 0)).rolling(window=14).mean()\n    rs = gain / loss\n    data['rsi'] = 100 - (100 / (1 + rs))\n    \n    # 2. MACD (12, 26, 9)\n    exp1 = data['close'].ewm(span=12, adjust=False).mean()\n    exp2 = data['close'].ewm(span=26, adjust=False).mean()\n    data['macd'] = exp1 - exp2\n    data['signal_line'] = data['macd'].ewm(span=9, adjust=False).mean()\n    data['macd_hist'] = data['macd'] - data['signal_line']\n    \n    # 3. Bollinger Bands (20, 2)\n    data['bb_middle'] = data['close'].rolling(window=20).mean()\n    data['bb_std'] = data['close'].rolling(window=20).std()\n    data['bb_upper'] = data['bb_middle'] + 2 * data['bb_std']\n    data['bb_lower'] = data['bb_middle'] - 2 * data['bb_std']\n    \n    # 4. Volume Indicators\n    data['vol_ma5'] = data['volume'].rolling(window=5).mean()\n    data['vol_ratio'] = data['volume'] / data['vol_ma5'] # 简单量比 (今日量/5日均量)\n    \n    return data\n\n# ==============================================================================\n# 模式 0: 自动化实盘监控 (AutoBot)\n# ==============================================================================\nif mode == \"🤖 自动化实盘监控 (AutoBot)\":\n    st.header(\"🤖 自动交易机器人监控面板\")\n    \n    # 自动刷新逻辑\n    auto_refresh = st.sidebar.checkbox(\"开启自动刷新 (5s)\", value=False)\n    enable_realtime = st.sidebar.checkbox(\"开启实时行情\", value=True, help=\"关闭以解决卡顿\")\n\n    if auto_refresh:\n        time.sleep(5)\n        st.rerun()\n\n    # 1. 账户概览\n    data_dir = \"data\"\n    account_file = os.path.join(data_dir, \"account.json\")\n    trades_file = os.path.join(data_dir, \"trades.csv\")\n    log_file = os.path.join(data_dir, \"bot.log\")\n    \n    if os.path.exists(account_file):\n        try:\n            with open(account_file, 'r', encoding='utf-8') as f:\n                acc = json.load(f)\n            \n            # --- 实时动态资产计算 ---\n            positions = acc.get('positions', {})\n            current_market_value = 0.0\n            \n            # 准备持仓表格数据\n            pos_data = []\n            \n            if positions:\n                # 尝试批量获取行情\n                spot_map = {}\n                if enable_realtime:\n                    with st.spinner(\"正在同步行情...\"):\n                        # 传入当前持仓的所有股票代码列表\n                        stock_list = list(positions.keys())\n                        spot_map = get_realtime_quotes(stock_list)\n                    \n                for symbol, pos in positions.items():\n                    try:\n                        cost = float(pos.get('cost', 0.0))\n                        shares = int(pos.get('shares', 0))\n                        \n                        # 获取现价 (强力兜底逻辑)\n                        # 如果 spot_map 里没有，或者取出来是 None/NaN，强制使用 cost\n                        live_price = spot_map.get(symbol)\n                        if live_price is None or pd.isna(live_price):\n                            current_price = cost\n                        else:\n                            current_price = float(live_price)\n                        \n                        # 计算单只股票市值\n                        mkt_val = current_price * shares\n                        current_market_value += mkt_val\n                        \n                        # 计算浮动盈亏\n                        profit = (current_price - cost) * shares\n                        if cost > 0:\n                            profit_pct = (current_price - cost) / cost * 100\n                        else:\n                            profit_pct = 0.0\n                        \n                        pos_data.append({\n                            \"代码\": symbol,\n                            \"名称\": pos.get('name', symbol),\n                            \"持仓数量\": shares,\n                            \"成本价\": f\"{cost:.2f}\",\n                            \"最新价\": f\"{current_price:.2f}\",\n                            \"持仓市值\": f\"{mkt_val:.2f}\",\n                            \"浮动盈亏\": f\"{profit:+.2f}\",\n                            \"盈亏比例\": f\"{profit_pct:+.2f}%\"\n                        })\n                    except Exception as ex:\n                        st.error(f\"处理持仓 {symbol} 出错: {ex}\")\n            \n            # 核心指标计算 (增加默认值和异常处理)\n            cash = float(acc.get('cash', 0.0))\n            total_assets = cash + current_market_value\n            initial_capital = float(acc.get('initial_capital', 100000.0))\n            last_day_value = float(acc.get('last_day_value', 100000.0))\n            yesterday_pnl = float(acc.get('yesterday_pnl', 0.0)) \n            \n            total_pnl = total_assets - initial_capital\n            total_pnl_pct = total_pnl / initial_capital * 100 if initial_capital != 0 else 0.0\n            \n            daily_pnl = total_assets - last_day_value\n            daily_pnl_pct = daily_pnl / last_day_value * 100 if last_day_value != 0 else 0.0\n            \n            # --- 核心指标展示区 ---\n            st.subheader(\"📊 资产全景\")\n            kpi1, kpi2, kpi3, kpi4, kpi5 = st.columns(5)\n            \n            kpi1.metric(\"总资产\", f\"¥{total_assets:,.2f}\")\n            kpi2.metric(\"累计盈亏\", f\"¥{total_pnl:+,.2f}\", delta=f\"{total_pnl_pct:+.2f}%\")\n            kpi3.metric(\"今日盈亏\", f\"¥{daily_pnl:+,.2f}\", delta=f\"{daily_pnl_pct:+.2f}%\")\n            kpi4.metric(\"昨日盈亏\", f\"¥{yesterday_pnl:+,.2f}\")\n            kpi5.metric(\"可用现金\", f\"¥{cash:,.2f}\")\n\n            # --- 账户成长曲线 (如有历史数据) ---\n            nav_history = acc.get('nav_history', [])\n            if nav_history:\n                st.caption(\"📈 账户净值成长曲线\")\n                hist_df = pd.DataFrame(nav_history)\n                # 补充当天的实时净值点，让曲线连贯到最新一刻\n                current_point = pd.DataFrame([{\n                    \"date\": datetime.datetime.now().strftime(\"%Y-%m-%d %H:%M\"), \n                    \"total_value\": total_assets\n                }])\n                chart_df = pd.concat([hist_df, current_point], ignore_index=True)\n                \n                st.line_chart(chart_df.set_index('date')['total_value'])\n\n            # --- 持仓详情表格 ---\n            st.subheader(\"💼 持仓详情\")\n            if pos_data:\n                df_pos = pd.DataFrame(pos_data)\n                st.dataframe(df_pos)\n            else:\n                st.info(\"当前空仓，正在扫描市场机会...\")\n        except Exception as e:\n            st.error(f\"解析账户文件失败: {e}\")\n            \n    else:\n        st.warning(f\"未找到账户文件: {os.path.abspath(account_file)}\")\n        st.info(\"💡 请先在终端运行后台机器人: `python quant_trading/auto_trader.py`\")\n\n    # 2. 交易记录\n    st.subheader(\"📝 历史交易日志\")\n    if os.path.exists(trades_file):\n        try:\n            trades_df = pd.read_csv(trades_file)\n            if not trades_df.empty:\n                st.dataframe(trades_df.sort_values(by='time', ascending=False))\n            else:\n                st.info(\"暂无交易记录 (文件为空)\")\n        except Exception as e:\n            st.error(f\"读取交易记录失败: {e}\")\n    else:\n        st.info(\"暂无交易记录文件\")\n        \n    # 3. 运行日志 (Bot Status)\n    with st.expander(\"查看机器人运行日志 (Tail 50 lines)\"):\n        if os.path.exists(log_file):\n            try:\n                with open(log_file, 'r', encoding='utf-8') as f:\n                    lines = f.readlines()\n                    st.text(\"\".join(lines[-50:]))\n            except Exception as e:\n                st.error(f\"读取日志失败: {e}\")\n        else:\n            st.text(f\"日志文件不存在: {os.path.abspath(log_file)}\")\n\n# ==============================================================================\n# 模式 1: 进阶波段策略 (RSI + 布林带 + 止盈止损)\n# ==============================================================================\nelif mode == \"🔥 进阶波段策略 (RSI+布林+MACD)\":\n    st.sidebar.header(\"🛠️ 波段策略参数\")\n    \n    symbol = st.sidebar.text_input(\"股票代码\", value=\"600519\")\n    start_date = st.sidebar.date_input(\"开始日期\", value=datetime.date(2023, 1, 1))\n    end_date = st.sidebar.date_input(\"结束日期\", value=datetime.date.today())\n    \n    st.sidebar.subheader(\"1. 价格信号 (RSI & 布林)\")\n    rsi_buy_threshold = st.sidebar.slider(\"RSI 超卖阈值 (抄底)\", 10, 40, 30, help=\"RSI低于此值视为超卖\")\n    rsi_sell_threshold = st.sidebar.slider(\"RSI 超买阈值 (逃顶)\", 60, 90, 70, help=\"RSI高于此值视为超买\")\n    \n    st.sidebar.subheader(\"2. 量能信号 (量价配合)\")\n    enable_vol_filter = st.sidebar.checkbox(\"开启放量确认\", value=True, help=\"买入时要求成交量放大，过滤无量阴跌\")\n    min_vol_ratio = st.sidebar.slider(\"买入量比阈值\", 0.5, 3.0, 1.0, step=0.1, help=\"今日成交量 / 5日均量。1.0表示只要大于均量即可，1.5表示明显放量\")\n\n    st.sidebar.subheader(\"3. 风控设置 (滚雪球关键)\")\n    take_profit_pct = st.sidebar.number_input(\"止盈比例 (%)\", value=15.0) / 100\n    stop_loss_pct = st.sidebar.number_input(\"止损比例 (%)\", value=5.0) / 100\n    \n    if st.sidebar.button(\"启动波段狙击\"):\n        with st.spinner(\"正在计算量价指标...\"):\n            raw_df = get_stock_data(symbol, start_date, end_date)\n            if raw_df is not None:\n                df = calculate_indicators(raw_df)\n                \n                # --- 交易逻辑 ---\n                df['position_signal'] = 0 # 1:买入, -1:卖出\n                \n                # 状态变量\n                holding = False\n                entry_price = 0.0\n                capital = 100000.0\n                initial_capital = capital\n                portfolio_history = []\n                trades = []\n                \n                for date, row in df.iterrows():\n                    current_price = row['close']\n                    action = 0 # 记录当日动作\n                    \n                    if not holding:\n                        # === 抄底信号 ===\n                        # 1. 价格条件: 跌破布林下轨 AND RSI低位\n                        price_condition = (row['close'] < row['bb_lower']) and (row['rsi'] < rsi_buy_threshold)\n                        \n                        # 2. 量能条件: 成交量放大 (如果有要求)\n                        vol_condition = True\n                        if enable_vol_filter:\n                            # 确保 volume_ratio 不是 NaN (前5天没有均线)\n                            if pd.notna(row['vol_ratio']):\n                                vol_condition = row['vol_ratio'] > min_vol_ratio\n                            else:\n                                vol_condition = False\n                        \n                        if price_condition and vol_condition:\n                            holding = True\n                            entry_price = current_price\n                            capital -= current_price * 100 # 假设买1手(100股) - 简化模型仅演示逻辑\n                            # 实际应该全仓或按比例，这里简化为模拟单位净值\n                            action = 1\n                            trades.append({'date': date, 'type': 'buy', 'price': current_price, 'vol_ratio': row['vol_ratio']})\n                    \n                    else:\n                        # === 逃顶/止盈/止损信号 ===\n                        \n                        # 1. 止损 (保命)\n                        if current_price <= entry_price * (1 - stop_loss_pct):\n                            holding = False\n                            capital += current_price * 100\n                            action = -1\n                            trades.append({'date': date, 'type': 'stop_loss', 'price': current_price})\n                            \n                        # 2. 止盈 (落袋为安)\n                        elif current_price >= entry_price * (1 + take_profit_pct):\n                            holding = False\n                            capital += current_price * 100\n                            action = -1\n                            trades.append({'date': date, 'type': 'take_profit', 'price': current_price})\n                            \n                        # 3. 技术面逃顶: 突破布林上轨 AND RSI高位\n                        elif (row['close'] > row['bb_upper']) and (row['rsi'] > rsi_sell_threshold):\n                            holding = False\n                            capital += current_price * 100\n                            action = -1\n                            trades.append({'date': date, 'type': 'sell_signal', 'price': current_price})\n                    \n                    # 记录净值 (现金 + 持仓市值)\n                    current_value = capital + (current_price * 100 if holding else 0)\n                    portfolio_history.append(current_value)\n                \n                df['portfolio_value'] = portfolio_history\n                \n                # --- 结果展示 ---\n                total_ret = (df['portfolio_value'].iloc[-1] - initial_capital) / initial_capital * 100\n                st.metric(\"策略总收益率 (模拟)\", f\"{total_ret:.2f}%\", \n                          delta=f\"交易次数: {len(trades)}\")\n                \n                # 绘图\n                fig = make_subplots(rows=3, cols=1, shared_xaxes=True, \n                                    row_heights=[0.5, 0.25, 0.25],\n                                    subplot_titles=(\"K线与布林带 (买卖点)\", \"资金曲线\", \"RSI 指标\"))\n                \n                # 1. K线 + 布林带\n                fig.add_trace(go.Candlestick(x=df.index, open=df['open'], high=df['high'], low=df['low'], close=df['close'], name='K线'), row=1, col=1)\n                fig.add_trace(go.Scatter(x=df.index, y=df['bb_upper'], line=dict(color='rgba(0,0,255,0.3)'), name='布林上轨'), row=1, col=1)\n                fig.add_trace(go.Scatter(x=df.index, y=df['bb_lower'], line=dict(color='rgba(0,0,255,0.3)'), name='布林下轨'), row=1, col=1)\n                \n                # 标记交易点\n                buy_dates = [t['date'] for t in trades if t['type'] == 'buy']\n                buy_prices = [t['price'] for t in trades if t['type'] == 'buy']\n                sell_dates = [t['date'] for t in trades if t['type'] != 'buy']\n                sell_prices = [t['price'] for t in trades if t['type'] != 'buy']\n                \n                fig.add_trace(go.Scatter(x=buy_dates, y=buy_prices, mode='markers', marker=dict(symbol='triangle-up', color='red', size=12), name='抄底买入'), row=1, col=1)\n                fig.add_trace(go.Scatter(x=sell_dates, y=sell_prices, mode='markers', marker=dict(symbol='triangle-down', color='green', size=12), name='逃顶卖出'), row=1, col=1)\n\n                # 2. 资金曲线\n                fig.add_trace(go.Scatter(x=df.index, y=df['portfolio_value'], line=dict(color='orange'), name='账户净值'), row=2, col=1)\n                \n                # 3. RSI\n                fig.add_trace(go.Scatter(x=df.index, y=df['rsi'], line=dict(color='purple'), name='RSI'), row=3, col=1)\n                fig.add_hline(y=rsi_buy_threshold, line_dash=\"dash\", line_color=\"green\", row=3, col=1)\n                fig.add_hline(y=rsi_sell_threshold, line_dash=\"dash\", line_color=\"red\", row=3, col=1)\n                \n                fig.update_layout(height=900, hovermode=\"x unified\")\n                st.plotly_chart(fig, use_container_width=True)\n                \n                st.write(\"### 交易明细\")\n                st.table(pd.DataFrame(trades))\n\n# ==============================================================================\n# 模式 2: 智能选股 (全市场) - 保持原样\n# ==============================================================================\nelif mode == \"🔍 智能选股 (全市场)\":\n    st.header(\"1. 设定选股条件\")\n    col_a, col_b, col_c = st.columns(3)\n    with col_a:\n        min_pe = st.number_input(\"最小市盈率 (PE)\", value=0.0)\n        max_pe = st.number_input(\"最大市盈率 (PE)\", value=50.0)\n    with col_b:\n        min_cap = st.number_input(\"最小总市值 (亿)\", value=50.0)\n        max_cap = st.number_input(\"最大总市值 (亿)\", value=5000.0)\n    with col_c:\n        min_change = st.number_input(\"今日涨幅下限 (%)\", value=0.0)\n        max_change = st.number_input(\"今日涨幅上限 (%)\", value=9.9)\n    \n    sort_key = st.selectbox(\"排序依据\", [\"总市值\", \"市盈率-动态\", \"涨跌幅\", \"换手率\", \"量比\"], index=2)\n    top_n = st.slider(\"选出 Top N 只股票\", 5, 50, 10)\n    \n    # 选股函数\n    @st.cache_data(ttl=300) # 5分钟缓存\n    def scan_market():\n        try:\n            # 获取东财实时行情\n            df = ak.stock_zh_a_spot_em()\n            # 字段映射\n            # 代码,名称,最新价,涨跌幅,涨跌额,成交量,成交额,振幅,最高,最低,今开,昨收,量比,换手率,市盈率-动态,市净率,总市值\n            \n            # 数据清洗\n            df['总市值'] = df['总市值'] / 100000000.0 # 转为亿\n            return df\n        except Exception as e:\n            st.error(f\"获取全市场数据失败: {e}\")\n            return pd.DataFrame()\n\n    if st.button(\"开始全市场扫描选股\"):\n        with st.spinner(\"正在拉取全市场 5000+