    try {\n                        throw new RuntimeException(\"测试异常\");\n                    } finally {\n                        ERROR_COUNT.incrementAndGet();\n                        latch.countDown();\n                    }\n                }, \"exception-task-\" + taskId);\n            } else {\n                // 抛出Error\n                NewThreadPoolExecutorUtil.execute(newExecutor, () -> {\n                    try {\n                        recursiveCall(0);\n                    } finally {\n                        ERROR_COUNT.incrementAndGet();\n                        latch.countDown();\n                    }\n                }, \"error-task-\" + taskId);\n            }\n        }\n\n        latch.await(TIMEOUT_MINUTES, TimeUnit.MINUTES);\n        int total = SUCCESS_COUNT.get() + ERROR_COUNT.get();\n        log.info(\"===== 异常处理测试结果 =====\\n正常: %d, 异常: %d, 总处理: %d, 预期: %d\\n\",\n                SUCCESS_COUNT.get(), ERROR_COUNT.get(), total, taskNum);\n        assertEquals(\"异常任务未被捕获\", taskNum, total);\n    }\n\n    private void recursiveCall(int i) {\n       int j = i/0; // 触发StackOverflowError\n    }\n\n    /**\n     * 场景5：动态参数调整测试\n     */\n    @Test\n    public void testDynamicParameterAdjustment() {\n        ThreadPoolExecutor customPool = NewThreadPoolExecutorUtil.createExecutorService(2, 5, 20, \"dynamic-pool-\");\n\n        // 初始参数验证\n        assertEquals(2, customPool.getCorePoolSize());\n        assertEquals(5, customPool.getMaximumPoolSize());\n\n        // 调整参数\n        NewThreadPoolExecutorUtil.setCorePoolSize(customPool, 3);\n        NewThreadPoolExecutorUtil.setMaximumPoolSize(customPool, 8);\n\n        // 验证调整结果\n        assertEquals(\"核心线程数调整失败\", 3, customPool.getCorePoolSize());\n        assertEquals(\"最大线程数调整失败\", 8, customPool.getMaximumPoolSize());\n\n        log.info(\"===== 动态参数调整测试通过 =====\");\n    }\n\n    /**\n     * 场景6：批量任务与MDC日志测试\n     */\n    @Test\n    public void testBatchTasksWithMdc() throws InterruptedException, ExecutionException {\n        int batchSize = 100;\n        Collection<Callable<Integer>> tasks = new ArrayList<>();\n\n        for (int i = 0; i < batchSize; i++) {\n            final int taskId = i;\n            tasks.add(() -> {\n                // 验证MDC是否包含任务名\n                String taskName = MDC.get(NewThreadPoolExecutorUtil.MDC_TASK_NAME_KEY);\n                assertNotNull(\"MDC任务名未注入\", taskName);\n                assertTrue(\"MDC任务名格式错误\", taskName.startsWith(\"batch-task-\"));\n\n                Thread.sleep(TASK_DELAY_MS);\n                return taskId;\n            });\n        }\n\n        // 执行批量任务\n        List<Future<Integer>> futures = NewThreadPoolExecutorUtil.wrapExecutor(\n                (ThreadPoolExecutor) NewThreadPoolExecutorUtil.unwrapExecutor(newExecutor)).invokeAll(tasks);\n\n        // 验证结果\n        int completed = 0;\n        for (Future<Integer> future : futures) {\n            if (future.isDone()) {\n                completed++;\n            }\n        }\n        assertEquals(\"批量任务未全部完成\", batchSize, completed);\n        log.info(\"===== 批量任务与MDC测试通过 =====\");\n    }\n\n    /**\n     * 场景7：优雅关闭测试\n     */\n    @Test\n    public void testGracefulShutdown() throws InterruptedException {\n        ThreadPoolExecutor testPool = NewThreadPoolExecutorUtil.createExecutorService(2, 5, 10, \"shutdown-test-\");\n        ExecutorService wrappedPool = NewThreadPoolExecutorUtil.wrapExecutor(testPool);\n\n        // 提交任务\n        int taskNum = 50;\n        CountDownLatch latch = new CountDownLatch(taskNum);\n        for (int i = 0; i < taskNum; i++) {\n            NewThreadPoolExecutorUtil.execute(wrappedPool, () -> {\n                try {\n                    Thread.sleep(100);\n                    SUCCESS_COUNT.incrementAndGet();\n                } catch (InterruptedException e) {\n                    Thread.currentThread().interrupt();\n                    ERROR_COUNT.incrementAndGet();\n                } finally {\n                    latch.countDown();\n                }\n            }, \"shutdown-task-\" + i);\n        }\n\n        // 立即关闭\n        NewThreadPoolExecutorUtil.shutdownExecutor(wrappedPool, 3, TimeUnit.SECONDS);\n\n        // 验证状态\n        Thread.sleep(4000);\n        assertTrue(\"线程池未正常终止\", testPool.isTerminated() || testPool.isTerminating());\n        log.info(\"===== 优雅关闭测试结果 =====\\n完成任务: %d, 中断任务: %d\\n\",\n                SUCCESS_COUNT.get(), ERROR_COUNT.get());\n    }\n\n\n    @Test\n    public void testPrintThreadPoolStatusWithFullQueue() throws InterruptedException {\n        ThreadPoolExecutor executor = NewThreadPoolExecutorUtil.createExecutorService(2, 4, 10, \"test-pool-\");\n\n        // Fill the queue\n        for (int i = 0; i < 10; i++) {\n            executor.execute(() -> {\n                try {\n                    Thread.sleep(1000);\n                } catch (InterruptedException e) {\n                    Thread.currentThread().interrupt();\n                }\n            });\n        }\n\n        // Wait for tasks to be queued\n        Thread.sleep(100);\n\n        NewThreadPoolExecutorUtil.printThreadPoolStatus(executor, \"full-pool\");\n        assertEquals(10, executor.getQueue().size());\n\n        executor.shutdown();\n        try {\n            if (!executor.awaitTermination(5, TimeUnit.SECONDS)) {\n                executor.shutdownNow();\n            }\n        } catch (InterruptedException e) {\n            executor.shutdownNow();\n            Thread.currentThread().interrupt();\n        }\n    }\n}",
