                "content": "package com.baidu.p2p.core.utils;\n\nimport lombok.extern.slf4j.Slf4j;\n\nimport java.util.Collection;\nimport java.util.List;\nimport java.util.concurrent.ArrayBlockingQueue;\nimport java.util.concurrent.BlockingQueue;\nimport java.util.concurrent.Callable;\nimport java.util.concurrent.ExecutorService;\nimport java.util.concurrent.ExecutionException;\nimport java.util.concurrent.Future;\nimport java.util.concurrent.RejectedExecutionHandler;\nimport java.util.concurrent.ThreadFactory;\nimport java.util.concurrent.ThreadPoolExecutor;\nimport java.util.concurrent.TimeUnit;\nimport java.util.concurrent.TimeoutException;\nimport java.util.concurrent.atomic.AtomicBoolean;\nimport java.util.concurrent.atomic.AtomicInteger;\nimport java.util.concurrent.atomic.AtomicLong;\nimport java.util.stream.Collectors;\n\nimport static java.util.concurrent.ThreadPoolExecutor.CallerRunsPolicy;\n\n/**\n * 公用的线程池工具类\n * 功能：\n * 1. 全链路异常捕获（含Error），解决线程丢失问题\n * 2. 完善的线程池关闭机制（优雅关闭+超时控制）\n * 3. 支持线程池状态监控与队列饱和预警\n * 4. 核心与非核心线程分离，支持动态参数调整\n * 5. 可配置的拒绝策略与线程参数，兼顾灵活性与安全性\n *\n * Created by liumandong on 2025/09/17\n */\n@Slf4j\npublic class NewThreadPoolExecutorUtil {\n\n    private static final AtomicLong TASK_ID_GENERATOR = new AtomicLong(1); // 全局任务ID生成器\n    private static final double QUEUE_WARN_THRESHOLD = 0.8; // 队列预警阈值（80%）\n\n\n    private static final int DEFAULT_CORE_POOL_SIZE = 10;\n    private static final int DEFAULT_MAX_POOL_SIZE = 20;\n    private static final int DEFAULT_QUEUE_SIZE = 1000;\n    private static final long KEEP_ALIVE_TIME = 5;\n    private static final TimeUnit KEEP_ALIVE_TIME_UNIT = TimeUnit.MINUTES;\n    private static final RejectedExecutionHandler DEFAULT_REJECTED_HANDLER = new LoggingCallerRunsPolicy();\n\n    private static ExecutorService wrappedDefaultExecutor;\n\n    static {\n        // 初始化默认线程池并包装\n        ThreadPoolExecutor rawExecutor = initRawDefaultExecutor();\n        wrappedDefaultExecutor = new WrappedExecutorService(r