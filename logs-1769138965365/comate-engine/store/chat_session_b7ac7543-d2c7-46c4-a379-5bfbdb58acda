    } finally {\n                    latch.countDown();\n                }\n            }, \"order-task-\" + taskId);\n        }\n\n        // 4. 模拟支付业务（长时任务）\n        for (int i = 0; i < PAYMENT_TASKS; i++) {\n            int taskId = i;\n            NewThreadPoolExecutorUtil.execute(executor, () -> {\n                try {\n                    Thread.sleep(100 + (long)(Math.random() * 200)); // 100-300ms\n                    paymentSuccess.incrementAndGet();\n                } catch (InterruptedException e) {\n                    Thread.currentThread().interrupt();\n                } finally {\n                    latch.countDown();\n                }\n            }, \"payment-task-\" + taskId);\n        }\n\n        // 5. 模拟库存业务（中等时长任务）\n        for (int i = 0; i < INVENTORY_TASKS; i++) {\n            int taskId = i;\n            NewThreadPoolExecutorUtil.execute(executor, () -> {\n                try {\n                    Thread.sleep(50 + (long)(Math.random() * 100)); // 50-150ms\n                    inventorySuccess.incrementAndGet();\n                } catch (InterruptedException e) {\n                    Thread.currentThread().interrupt();\n                } finally {\n                    latch.countDown();\n                }\n            }, \"inventory-task-\" + taskId);\n        }\n\n        // 6. 等待所有任务完成（超时60秒）\n        assertTrue(\"Tasks did not complete in time\", latch.await(60, TimeUnit.SECONDS));\n        \n        // 7. 打印线程池状态\n        NewThreadPoolExecutorUtil.printThreadPoolStatus(executor, \"FinalStatus\");\n        \n        // 8. 验证结果\n        logger.info(\"Stress test results - Orders: {}/{}, Payments: {}/{}, Inventory: {}/{}\",\n            orderSuccess.get(), ORDER_TASKS,\n            paymentSuccess.get(), PAYMENT_TASKS,\n            inventorySuccess.get(), INVENTORY_TASKS);\n\n        assertTrue(\"Too many order failures\", orderSuccess.get() >= ORDER_TASKS * 0.9);\n        assertEquals(\"Payment tasks should not fail\", PAYMENT_TASKS, p