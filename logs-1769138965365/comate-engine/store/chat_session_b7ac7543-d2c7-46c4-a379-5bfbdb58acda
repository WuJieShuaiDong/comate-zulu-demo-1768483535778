ecutor.setKeepAliveTime(30, TimeUnit.SECONDS);\n        assertEquals(4, sharedExecutor.getCorePoolSize());\n        assertEquals(8, sharedExecutor.getMaximumPoolSize());\n\n        // 提交下午任务\n        for (int i = 0; i < 150; i++) {\n            int taskId = i;\n            NewThreadPoolExecutorUtil.execute(wrappedSharedExecutor, () -> {\n                try {\n                    Thread.sleep(100);\n                } catch (InterruptedException e) {\n                    Thread.currentThread().interrupt();\n                } finally {\n                    afternoonLatch.countDown();\n                }\n            }, \"afternoon-stock-task-\" + taskId);\n        }\n        afternoonLatch.await(60, TimeUnit.SECONDS);\n        NewThreadPoolExecutorUtil.printThreadPoolStatus(sharedExecutor, \"AfternoonLoad\");\n\n        assertTrue(\"Max pool size not respected after adjustment\", sharedExecutor.getLargestPoolSize() <= 8);\n    }\n\n    /**\n     * 场景4：多线程池资源隔离\n     */\n    @Test\n    public void testMultiPoolResourceIsolation() throws InterruptedException {\n        ThreadPoolExecutor poolA = NewThreadPoolExecutorUtil.createExecutorService(3, 5, 20, \"payment-pool-\");\n        ExecutorService wrappedA = NewThreadPoolExecutorUtil.wrapExecutor(poolA);\n        ThreadPoolExecutor poolB = NewThreadPoolExecutorUtil.createExecutorService(2, 4, 10, \"log-pool-\");\n        ExecutorService wrappedB = NewThreadPoolExecutorUtil.wrapExecutor(poolB);\n\n        // 线程池A提交异常任务\n        CountDownLatch errorLatch = new CountDownLatch(10);\n        for (int i = 0; i < 10; i++) {\n            NewThreadPoolExecutorUtil.execute(wrappedA, () -> {\n                try {\n                    throw new RuntimeException(\"Payment system error (simulated)\");\n                } finally {\n                    errorLatch.countDown();\n                }\n            }, \"payment-error-task-\" + i);\n        }\n        errorLatch.await(10, TimeUnit.SECONDS);\n        testLogger.info(\"Pool A afte