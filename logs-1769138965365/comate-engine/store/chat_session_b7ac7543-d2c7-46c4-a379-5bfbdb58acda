不同场景使用差异化配置（核心线程数、队列大小）\n            int corePoolSize = 5 + (i * 3);\n            int maxPoolSize = 10 + (i * 5);\n            int queueSize = 500 + (i * 200);\n\n            ThreadPoolExecutor rawPool = NewThreadPoolExecutorUtil.createExecutorService(\n                    corePoolSize, maxPoolSize, queueSize, scenario + \"-pool-\"\n            );\n            ExecutorService wrappedPool = NewThreadPoolExecutorUtil.wrapExecutor(rawPool);\n\n            threadPools.add(wrappedPool);\n            scenarioStatsList.add(new ScenarioStats(scenario, TASKS_PER_POOL));\n\n            log.info(\"初始化业务线程池: {} (core={}, max={}, queue={})\",\n                    scenario, corePoolSize, maxPoolSize, queueSize);\n        }\n    }\n\n    @After\n    public void cleanUp() {\n        // 优雅关闭所有线程池\n        for (int i = 0; i < threadPools.size(); i++) {\n            ExecutorService pool = threadPools.get(i);\n            String scenario = BUSINESS_SCENARIOS[i];\n            NewThreadPoolExecutorUtil.shutdownExecutor(pool, 5, TimeUnit.MINUTES);\n            log.info(\"关闭业务线程池: {} (是否已终止: {})\",\n                    scenario, pool.isTerminated() ? \"是\" : \"否\");\n        }\n    }\n\n    /**\n     * 多线程池并发压测核心场景\n     */\n    @Test\n    public void testMultiPoolConcurrentExecution() throws InterruptedException {\n        // 1. 并发向所有线程池提交任务\n        for (int poolIdx = 0; poolIdx < threadPools.size(); poolIdx++) {\n            ExecutorService pool = threadPools.get(poolIdx);\n            ScenarioStats stats = scenarioStatsList.get(poolIdx);\n            String scenario = stats.scenario;\n\n            // 启动独立线程向当前场景线程池提交任务（模拟业务异步提交）\n            new Thread(() -> {\n                for (int taskIdx = 0; taskIdx < TASKS_PER_POOL; taskIdx++) {\n                    String taskName = scenario + \"-task-\" + taskIdx;\n                    try {\n                        NewThreadPoolExecutorUtil.execute(pool, () -> {\n                            try {\n                                // 模拟业务处理耗时\n                                Thread.sleep(TASK_DELAY_MS);\n                                stats.success.incrementAndGet();\n                            } catch (Exception e) {\n                                stats.error.incrementAndGet();\n                            } finally {\n                                stats.latch.countDown();\n                            }\n                        }, taskName);\n                    } catch (RejectedExecutionException e) {\n                        stats.reject.incrementAndGet();\n                        stats.latch.countDown();\n                    }\n                }\n            }, \"submitter-\" + scenario).start();\n        }\n\n        // 2. 等待所有场景任务完成\n        CountDownLatch allDoneLatch = new CountDownLatch(SCENARIO_THREAD_POOL_COUNT);\n        for (ScenarioStats stats : scenarioStatsList) {\n            new Thread(() -> {\n                try {\n                    stats.latch.await(TIMEOUT_MINUTES, TimeUnit.MINUTES);\n                } catch (InterruptedException e) {\n                    Thread.currentThread().interrupt();\n                } finally {\n                    allDoneLatch.countDown();\n                }\n            }).start();\n        }\n\n        boolean allCompleted = allDoneLatch.await(TIMEOUT_MINUTES, TimeUnit.MINUTES);\n        assertTrue(\"多线程池任务执行超时\", allCompleted);\n\n        // 3. 验证各场景任务完整性\n        for (ScenarioStats stats : scenarioStatsList) {\n            int total = stats.success.get() + stats.error.get() + stats.reject.get();\n            log.info(\"场景 [{}] 统计: 成功={}, 异常={}, 拒绝={}, 总任务数={}\",\n                    stats.scenario, stats.success.get(), stats.error.get(), stats.reject.get(), total);\n            assertEquals(\"场景 \" + stats.scenario + \" 任务丢失\", TASKS_PER_POOL, total);\n        }\n\n        // 4. 验证线程池状态（无资源泄露）\n        for (int i = 0; i < threadPools.size(); i++) {\n            ExecutorService pool = threadPools.get(i);\n            ThreadPoolExecutor rawPool = (ThreadPoolExecutor) NewThreadPoolExecutorUtil.unwrapExecutor(pool);\n            NewThreadPoolExecutorUtil.printThreadPoolStatus(rawPool, BUSINESS_SCENARIOS[i]);\n            assertFalse(\"线程池 \" + BUSINESS_SCENARIOS[i] + \" 已异常终止\", rawPool.isTerminated());\n        }\n    }\n\n    /**\n     * 多线程池动态调整参数测试\n     */\n    @Test\n    public void testMultiPoolDynamicAdjustment() {\n        // 1. 记录初始参数\n        List<int[]> originalParams = new ArrayList<>();\n        for (ExecutorService pool : threadPools) {\n            ThreadPoolExecutor rawPool = (ThreadPoolExecutor) NewThreadPoolExecutorUtil.unwrapExecutor(pool);\n            originalParams.add(new int[]{rawPool.getCorePoolSize(), rawPool.getMaximumPoolSize()});\n        }\n\n        // 2. 并发调整所有线程池参数\n        ExecutorService adjuster = Executors.newFixedThreadPool(SCENARIO_THREAD_POOL_COUNT);\n        for (int i = 0; i < threadPools.size(); i++) {\n            int poolIdx = i;\n            adjuster.submit(() -> {\n                ThreadPoolExecutor rawPool = (ThreadPoolExecutor) NewThreadPoolExecutorUtil.unwrapExecutor(threadPools.get(poolIdx));\n                String scenario = BUSINESS_SCENARIOS[poolIdx];\n                // 动态调整为原参数的1.5倍（确保为正数）\n                int newCore = Math.max(1, (int) (rawPool.getCorePoolSize() * 1.5));\n                int newMax = Math.max(newCore, (int) (rawPool.getMaximumPoolSize() * 1.5));\n                NewThreadPoolExecutorUtil.setCorePoolSize(rawPool, newCore);\n                NewThreadPoolExecutorUtil.setMaximumPoolSize(rawPool, newMax);\n                return scenario;\n            });\n        }\n        NewThreadPoolExecutorUtil.shutdownExecutor(adjuster, 1, TimeUnit.MINUTES);\n\n        // 3. 验证参数调整结果\n        for (int i = 0; i < threadPools.size(); i++) {\n            ThreadPoolExecutor rawPool = (ThreadPoolExecutor) NewThreadPoolExecutorUtil.unwrapExecutor(threadPools.get(i));\n            String scenario = BUSINESS_SCENARIOS[i];\n            int expectedCore = Math.max(1, (int) (originalParams.get(i)[0] * 1.5));\n            int expectedMax = Math.max(expectedCore, (int) (originalParams.get(i)[1] * 1.5));\n            assertEquals(\"场景 \" + scenario + \" 核心线程数调整失败\", expectedCore, rawPool.getCorePoolSize());\n            assertEquals(\"场景 \" + scenario + \" 最大线程数调整失败\", expectedMax, rawPool.getMaximumPoolSize());\n        }\n        log.info(\"多线程池动态参数调整验证通过\");\n    }\n\n    /**\n     * 多线程池资源隔离性测试（部分线程池饱和不影响其他）\n     */\n    @Test\n    public void testMultiPoolResourceIsolation() throws InterruptedException {\n        // 1. 找到一个小队列线程池使其饱和\n        int smallPoolIdx = 0; // 假设第一个场景队列最小\n        ExecutorService smallPool = threadPools.get(smallPoolIdx);\n        ScenarioStats smallPoolStats = scenarioStatsList.get(smallPoolIdx);\n        String smallScenario = smallPoolStats.scenario;\n\n        // 2. 向小队列线程池提交超量任务使其饱和\n        int overloadTasks = TASKS_PER_POOL * 3; // 3倍于正常任务数\n        CountDownLatch overloadLatch = new CountDownLatch(overloadTasks);\n        for (int i = 0; i < overloadTasks; i++) {\n            String taskName = smallScenario + \"-overload-task-\" + i;\n            try {\n                NewThreadPoolExecutorUtil.execute(smallPool, () -> {\n                    try {\n                        Thread.sleep(TASK_DELAY_MS * 10); // 延长任务耗时，加剧饱和\n                        smallPoolStats.success.incrementAndGet();\n                    } catch (Exception e) {\n                        smallPoolStats.error.incrementAndGet();\n                    } finally {\n                        overloadLatch.countDown();\n                    }\n                }, taskName);\n            } catch (RejectedExecutionException e) {\n                smallPoolStats.reject.incrementAndGet();\n                overloadLatch.countDown();\n            }\n        }\n\n        // 3. 同时向其他线程池提交正常任务\n        int normalPoolIdx = 1; // 选择另一个场景线程池\n        ExecutorService normalPool = threadPools.get(normalPoolIdx);\n        ScenarioStats normalStats = scenarioStatsList.get(normalPoolIdx);\n        String normalScenario = normalStats.scenario;\n\n        for (int i = 0; i < TASKS_PER_POOL; i++) {\n            String taskName = normalScenario + \"-normal-task-\" + i;\n            try {\n                NewThreadPoolExecutorUtil.execute(normalPool, () -> {\n                    try {\n                        Thread.sleep(TASK_DELAY_MS);\n                        normalStats.success.incrementAndGet();\n                    } catch (Exception e) {\n                        normalStats.error.incrementAndGet();\n                    } finally {\n                        normalStats.latch.countDown();\n                    }\n                }, taskName);\n            } catch (RejectedExecutionException e) {\n                normalStats.reject.incrementAndGet();\n                normalStats.latch.countDown();\n            }\n        }\n\n        // 4. 等待所有任务完成\n        assertTrue(\"过载任务超时\", overloadLatch.await(TIMEOUT_MINUTES, TimeUnit.MINUTES));\n        assertTrue(\"正常任务超时\", normalStats.latch.await(TIMEOUT_MINUTES, TimeUnit.MINUTES));\n\n        // 5. 验证隔离性：正常线程池应无拒绝，过载线程池应有拒绝\n        log.info(\"隔离性测试 - 过载场景 [{}]: 拒绝数={}\",\n                smallScenario, smallPoolStats.reject.get());\n        log.info(\"隔离性测试 - 正常场景 [{}]: 拒绝数={}\",\n                normalScenario, normalStats.reject.get());\n\n\n        assertTrue(\"过载场景未产生预期拒绝\", smallPoolStats.reject.get() > 0);\n        assertEquals(\"正常场景不应被影响（出现拒绝）\", 0, normalStats.reject.get());\n        assertEquals(\"正常场景任务应全部完成\", TASKS_PER_POOL,\n                normalStats.success.get() + normalStats.error.get());\n    }\n\n\n    // 模拟三种业务场景\n    private static final int ORDER_TASKS = 200;    // 订单处理业务\n    private static final int PAYMENT_TASKS = 150;  // 支付业务\n    private static final int INVENTORY_TASKS = 100; // 库存业务\n\n\n    /**\n    * 混合业务负载：\n     *\n     * 订单业务：短时任务（10-50ms），5%的模拟失败率\n     * 支付业务：长时任务（100-300ms）\n     * 库存业务：中等任务（50-150ms）\n     * 关键验证点：\n     * 线程池在混合负载下的稳定性\n     * 任务失败不影响其他业务\n     * 线程池参数动态调整效果\n    * */\n    @Test\n    public void testMultiBusinessUnderStress() throws InterruptedException {\n        // 1. 创建共享线程池（核心10，最大20，队列100）\n        ThreadPoolExecutor executor = NewThreadPoolExecutorUtil.createExecutorService(\n                10, 20, 100, \"stress-pool-\");\n\n        // 2. 初始化业务计数器\n        CountDownLatch latch = new CountDownLatch(ORDER_TASKS + PAYMENT_TASKS + INVENTORY_TASKS);\n        AtomicInteger orderSuccess = new AtomicInteger(0);\n        AtomicInteger paymentSuccess = new AtomicInteger(0);\n        AtomicInteger inventorySuccess = new AtomicInteger(0);\n\n        // 3. 模拟订单业务（短时任务，部分会失败）\n        for (int i = 0; i < ORDER_TASKS; i++) {\n            int taskId = i;\n            NewThreadPoolExecutorUtil.execute(executor, () -> {\n                try {\n                    Thread.sleep(10 + (long)(Math.random() * 40)); // 10-50ms\n                    if (Math.random() < 0.05) { // 5%失败率\n                        throw new RuntimeException(\"Order failed\");\n                    }\n                    orderSuccess.incrementAndGet();\n                } catch (Exception e) {\n                    log.error(\"Order task {} failed\", taskId, e);\n                } finally {\n                    latch.countDown();\n                }\n            }, \"order-task-\" + taskId);\n        }\n\n        // 4. 模拟支付业务（长时任务）\n        for (int i = 0; i < PAYMENT_TASKS; i++) {\n            int taskId = i;\n            NewThreadPoolExecutorUtil.execute(executor, () -> {\n                try {\n                    Thread.sleep(100 + (long)(Math.random() * 200)); // 100-300ms\n                    paymentSuccess.incrementAndGet();\n                } catch (InterruptedException e) {\n                    Thread.currentThread().interrupt();\n                } finally {\n                    latch.countDown();\n                }\n            }, \"payment-task-\" + taskId);\n        }\n\n        // 5. 模拟库存业务（中等时长任务）\n 