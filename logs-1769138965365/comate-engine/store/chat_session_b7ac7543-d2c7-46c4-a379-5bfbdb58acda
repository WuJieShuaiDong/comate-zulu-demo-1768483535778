                "content": "package com.baidu.p2p.test.core;\n\n\nimport com.baidu.p2p.core.utils.NewThreadPoolExecutorUtil;\nimport com.baidu.p2p.core.utils.ThreadPoolExecutorUtil;\nimport lombok.extern.slf4j.Slf4j;\nimport org.junit.After;\nimport org.junit.Before;\nimport org.junit.Test;\nimport org.slf4j.MDC;\n\nimport java.util.ArrayList;\nimport java.util.Collection;\nimport java.util.List;\nimport java.util.concurrent.*;\nimport java.util.concurrent.atomic.AtomicInteger;\nimport static org.junit.Assert.*;\n\n@Slf4j\npublic class ThreadPoolExecutorUtilTest {\n\n    // 任务计数器\n    private static final AtomicInteger SUCCESS_COUNT = new AtomicInteger(0);\n    private static final AtomicInteger ERROR_COUNT = new AtomicInteger(0);\n    private static final AtomicInteger REJECT_COUNT = new AtomicInteger(0);\n\n    // 测试配置参数\n    private static final int NORMAL_TASK_NUM = 10000;\n    private static final int OVERLOAD_TASK_NUM = 1000;\n    private static final long TASK_DELAY_MS = 10;\n    private static final long TIMEOUT_MINUTES = 5;\n\n    // 新旧线程池实例\n    private ExecutorService oldExecutor;\n    private ExecutorService newExecutor;\n\n    @Before\n    public void init() {\n        // 初始化线程池\n        oldExecutor = ThreadPoolExecutorUtil.getExecutorService();\n        newExecutor = NewThreadPoolExecutorUtil.getExecutorService();\n        // 重置计数器\n        resetCounters();\n    }\n\n    @After\n    public void cleanUp() {\n        // 关闭自定义创建的线程池（默认线程池由JVM钩子处理）\n        final ExecutorService defaultExecutor = NewThreadPoolExecutorUtil.getExecutorService();\n\n        // 处理旧线程池\n        if (oldExecutor != null) {\n            try {\n                if (oldExecutor instanceof ThreadPoolExecutor\n                        && !defaultExecutor.equals(oldExecutor)) {\n                    // 使用公共关闭方法替代私有方法调用\n                    defaultExecutor.shutdown();  // 或其他公共方法\n                }\n            } catch (Exception e) {\n                log.warn(\"Failed to cleanup old executor: \" + e.getMessage());\n            } finally {\n                oldExecutor = null;\n            }\n        }\n        ExecutorService target = NewThreadPoolExecutorUtil.unwrapExecutor(newExecutor);\n        if (!NewThreadPoolExecutorUtil.getExecutorService().equals(target)) {\n            NewThreadPoolExecutorUtil.shutdownExecutor(newExecutor, 1, TimeUnit.MINUTES);\n        }\n\n        // 清理引用\n        oldExecutor = null;\n        newExecutor = null;\n    }\n\n    private void resetCounters() {\n        SUCCESS_COUNT.set(0);\n        ERROR_COUNT.set(0);\n        REJECT_COUNT.set(0);\n    }\n\n    /**\n     * 场景1：新旧线程池同时高负载运行\n     */\n    @Test\n    public void testOldAndNewPoolCoexist() throws InterruptedException {\n        CountDownLatch latch = new CountDownLatch(NORMAL_TASK_NUM * 2);\n\n        // 旧线程池提交任务\n        for (int i = 0; i < NORMAL_TASK_NUM; i++) {\n            final int taskId = i;\n            oldExecutor.execute(() -> {\n                try {\n                    Thread.sleep(TASK_DELAY_MS);\n                    SUCCESS_COUNT.incrementAndGet();\n                } catch (Exception e) {\n                    ERROR_COUNT.incrementAndGet();\n                } finally {\n                    latch.countDown();\n                }\n            });\n        }\n\n        // 新线程池提交任务\n        for (int i = 0; i < NORMAL_TASK_NUM; i++) {\n            final int taskId = i;\n            NewThreadPoolExecutorUtil.execute(newExecutor, () -> {\n                try {\n                    Thread.sleep(TASK_DELAY_MS);\n                    SUCCESS_COUNT.incrementAndGet();\n                } catch (Exception e) {\n                    ERROR_COUNT.incrementAndGet();\n                } finally {\n                    latch.countDown();\n                }\n            }, \"coexist-new-task-\" + taskId);\n        }\n\n        // 等待完成\n        boolean completed = latch.await(TIMEOUT_MINUTES, TimeUnit.MINUTES);\n        assertTrue(\"任务超时未完成\", completed);\n\n        // 验证结果\n        int total = SUCCESS_COUNT.get() + ERROR_COUNT.get();\n        log.info(\"===== 新旧共存测试结果 =====\\n成功: %d, 异常: %d, 总处理: %d, 预期: %d\\n\",\n                SUCCESS_COUNT.get(), ERROR_COUNT.get(), total, NORMAL_TASK_NUM * 2);\n        assertEquals(\"任务丢失\", NORMAL_TASK_NUM * 2, total);\n    }\n\n    /**\n     * 场景2：新线程池打满测试（队列+最大线程饱和）\n     */\n    @Test\n    public void testNewPoolFullScenario() throws InterruptedException {\n        // 创建小容量线程池（核心2，最大5，队列10）\n        ThreadPoolExecutor smallPool = NewThreadPoolExecutorUtil.createExecutorService(2, 5, 10, \"small-pool-\");\n        ExecutorService wrappedPool = NewThreadPoolExecutorUtil.wrapExecutor(smallPool);\n\n        CountDownLatch latch = new CountDownLatch(OVERLOAD_TASK_NUM);\n\n        for (int i = 0; i < OVERLOAD_TASK_NUM; i++) {\n            final int taskId = i;\n            try {\n                NewThreadPoolExecutorUtil.execute(wrappedPool, () -> {\n                    try {\n                        Thread.sleep(TASK_DELAY_MS * 10); // 延长任务耗时\n                        SUCCESS_COUNT.incrementAndGet();\n                    } catch (Exception e) {\n                        ERROR_COUNT.incrementAndGet();\n                    } finally {\n                        latch.countDown();\n                    }\n                }, \"overload-task-\" + taskId);\n            } catch (RejectedExecutionException e) {\n                REJECT_COUNT.incrementAndGet();\n                latch.countDown();\n            }\n        }\n\n        latch.await(TIMEOUT_MINUTES, TimeUnit.MINUTES);\n        NewThreadPoolExecutorUtil.printThreadPoolStatus(smallPool, \"overload-test-pool\");\n\n        // 验证结果\n        int total = SUCCESS_COUNT.get() + ERROR_COUNT.get() + REJECT_COUNT.get();\n        log.info(\"===== 线程池打满测试结果 =====\\n成功: %d, 异常: %d, 拒绝: %d, 总处理: %d, 预期: %d\\n\",\n                SUCCESS_COUNT.get(), ERROR_COUNT.get(), REJECT_COUNT.get(), total, OVERLOAD_TASK_NUM);\n        assertEquals(\"任务丢失\", OVERLOAD_TASK_NUM,