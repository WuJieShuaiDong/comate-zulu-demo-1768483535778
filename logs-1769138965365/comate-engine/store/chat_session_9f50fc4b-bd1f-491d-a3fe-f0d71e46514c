onstants.BANK_POST_EXCEPTION.equals(response)) {\n                log.error(\"同步联行号查询请求异常\");\n                return;\n            }\n            ResponseHeaderDTO responseHeaderDto =\n                    ResponseXmlParser.parseResponseXml(response, Constants.AbcTranscodeEnum.BANK_NUMBER);\n            log.info(\"sycBankNumber 处理农业银行请求结果 resDto={}\", JSON.toJSONString(responseHeaderDto));\n            // 处理成功\n            if (responseHeaderDto != null && Constants.RESPONSE_0.equals(responseHeaderDto.getRespSource())) {\n                ResponseBodyDTO bodyDto = responseHeaderDto.getBodyDto();\n                if (bodyDto != null) {\n                    // 处理流水数据\n                    if (StringUtils.isNotBlank(bodyDto.getRecordNum())\n                            && Integer.parseInt(bodyDto.getRecordNum()) > 0) {\n                        List<BankNumber> abcTransList = fileService.fetchBankNumberData(ipPort[0],\n                                bodyDto.getBatchFileName());\n                        this.insertBankNumberData(abcTransList);\n                    }\n                } else {\n                    log.error(\"sycBankNumber 农业银行同步联行号报文解析发生错误\");\n                }\n            }\n        } catch (Exception e) {\n            log.error(\"sycBankNumber 同步联行号处理失败\", e);\n        } finally {\n            redisLock.unlock();\n        }\n        log.info(\"sycBankNumber 农行同步联行号同步结束\");\n    }\n\n    /**\n     * 处理流水响应结果\n     */\n    @Override\n    public void insertBankNumberData(List<BankNumber> numberList) {\n\n        // 处理成功\n        if (CollectionUtils.isNotEmpty(numberList)) {\n            log.info(\"insertBankNumberData 开始处理银行返回的联行号数据\");\n            List<List<BankNumber>> insertLists = Lists.partition(numberList, 1000);\n            int count = 0;\n            for (List<BankNumber> list : insertLists) {\n                int temp = bankNumberMapper.batchSaveUpdateByLists(list);\n                count = count + temp;\n            }\n            log.info(\"银行联