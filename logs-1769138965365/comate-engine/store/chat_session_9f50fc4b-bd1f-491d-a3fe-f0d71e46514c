                "content": "package com.baidu.pmc.abc.core.service.impl;\n\nimport com.alibaba.fastjson.JSON;\nimport com.baidu.pmc.abc.core.constants.Constants;\nimport com.baidu.pmc.abc.core.dto.AbcPayInstructDTO;\nimport com.baidu.pmc.abc.core.service.AbcPayInstructService;\nimport com.baidu.pmc.abc.core.service.OperateByJDBC;\nimport com.baidu.pmc.abc.core.service.PayChecksHisService;\nimport com.baidu.pmc.abc.core.service.PayChecksService;\nimport com.baidu.pmc.abc.core.service.PayChecksWriteBackService;\nimport com.baidu.pmc.abc.persistence.dao.AbcPayInstructHisMapper;\nimport com.baidu.pmc.abc.persistence.dao.AbcPayInstructMapper;\nimport com.baidu.pmc.abc.persistence.domain.AbcPayInstruct;\nimport com.baidu.pmc.abc.persistence.domain.AbcPayInstructHis;\nimport com.baidu.pmc.common.exception.ServiceException;\nimport com.baidu.pmc.common.exception.WebException;\nimport com.baidu.pmc.common.utils.RedisLock;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.pojo.constants.PayNode;\nimport com.baidu.pmc.pojo.constants.PayOperation;\nimport com.baidu.pmc.pojo.constants.PayStatus;\nimport com.baidu.pmc.pojo.constants.ValueSetTransEnum;\nimport com.baidu.pmc.pojo.dto.PayChecksDTO;\nimport com.baidu.pmc.pojo.dto.cmb.PayInstructDTO;\nimport com.baidu.pmc.pojo.model.PmcPayChecks;\nimport com.baidu.pmc.pojo.model.PmcPayChecksAuditHis;\nimport com.baidu.pmc.pojo.model.fnd.FndFlexValue;\nimport com.baidu.pmc.pojo.model.fnd.FndFlexValueB;\nimport com.baidu.pmc.pojo.qo.cmb.PayInstructQO;\nimport com.github.pagehelper.Page;\nimport com.github.pagehelper.PageHelper;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections.CollectionUtils;\nimport org.springframework.beans.BeanUtils;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\nimport org.springframework.transaction.annotation.Isolation;\nimport org.springframework.transaction.annotation.Propagation;\nimport org.springframework.transaction.annotation.Transactional;\n\nimport java.math.BigDecimal;\nimport java.util.ArrayList;\nimport java.util.Date;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.function.Function;\nimport java.util.stream.Collectors;\n\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.BANK;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.BANK_INSTRUCTION_STATUS;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.BANK_INSTRUCTION_TYPE;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.CURRENCY;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.TMS_DIRECT_BANK;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.XML_ILLEGAL_CHARACTER;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.YES_NO;\nimport static java.util.stream.Collectors.toList;\n\n/**\n * 农行指令服务\n *\n * @author liuyanzhong\n * @date 2023/5/11\n */\n@Slf4j\n@Service\npublic class AbcPayInstructServiceImpl implements AbcPayInstructService {\n\n    @Autowired\n    PayChecksService payChecksService;\n\n    @Autowired\n    PayChecksHisService payChecksHisService;\n\n    @Autowired\n    private OperateByJDBC operateByJDBC;\n\n    @Autowired\n    private PayChecksWriteBackService payChecksWriteBackService;\n\n    @Autowired\n    private SendMailService mailService;\n\n    @Autowired\n    AbcPayInstructMapper abcPayInstructMapper;\n\n    @Autowired\n    AbcPayInstructHisMapper abcPayInstructHisMapper;\n\n    /**\n     * 10 毫秒重试\n     */\n    private static final long REDIS_LOCK_TIMEOUT = 10;\n    /**\n     * 10 分钟超时\n     */\n    private static final int REDIS_LOCK_EXPIRE = 10 * 60;\n\n    @Override\n    @Transactional(propagation = Propagation.REQUIRED, isolation = Isolation.DEFAULT, rollbackFor = Exception.class)\n    public Integer genAbcUnUrgentPay() {\n\n        RedisLock redisLock = new RedisLock(\"genAbcUnUrgentPay\");\n        try {\n            if (!redisLock.lock(REDIS_LOCK_TIMEOUT, REDIS_LOCK_EXPIRE)) {\n                log.info(\"===========生成农业银行指令任务执行中，请稍后再试===========\");\n                throw new ServiceException(\"生成农业银行指令任务执行中，请稍后再试\");\n            }\n            List<PayChecksDTO> payChecksDTOS = payChecksService.genAbcUnUrgentPayList();\n            log.info(\"genAbcUnUrgentPay 待生成指令付款单数量size={}\", payChecksDTOS.size());\n            if (CollectionUtils.isNotEmpty(payChecksDTOS)) {\n                List<Long> checkIds = payChecksDTOS.stream().map(PayChecksDTO::getCheckId).collect(Collectors.toList());\n                // 用于存储his信息\n                List<PmcPayChecks> payChecksList = payChecksService.selectAllByCheckIds(checkIds);\n\n                // 订单状态更新\n                payChecksService.updateStatusBatch(checkIds, PayStatus.SENDING.name());\n                payChecksHisService.batchSavePayChecksHisByStatus(payChecksList, PayStatus.SENDING.name());\n                // 值集翻译\n                operateByJDBC.translate(payChecksDTOS,\n                        ValueSetTransEnum.TRANS_BANK.getColumn(), ValueSetTransEnum.TRANS_BANK.getCode(),\n                        ValueSetTransEnum.TRANS_PROVINCE.getColumn(), ValueSetTransEnum.TRANS_PROVINCE.getCode(),\n                        ValueSetTransEnum.TRANS_CITY.getColumn(), ValueSetTransEnum.TRANS_CITY.getCode(),\n                        ValueSetTransEnum.TRANS_TMS_DIRECT_BANK.getColumn(),\n                        ValueSetTransEnum.TRANS_TMS_DIRECT_BANK.getCode(),\n                        ValueSetTransEnum.TRANS_ACC_CITY.getColumn(), ValueSetTransEnum.TRANS_ACC_CITY.getCode());\n\n                // 校验失败数据容器\n                Map<String, List<PmcPayChecks>> errorMap = new HashMap<>();\n                // 校验付款单\n                List<PayChecksDTO> payCheckList = verityPayChecks(payChecksDTOS, errorMap);\n\n                // 校验未通过，需反馈到业务线的数据\n                this.dealReceiveFailed(errorMap.get(PayStatus.FAILED.name()), payChecksList);\n                // 校验未通过，可在资金中心修改的数据\n                this.dealPayFailed(errorMap.get(PayStatus.VERITY_FAILED.name()), payChecksList);\n                // 为校验通过的数据生成指令\n                return this.dealSuccessChecks(payCheckList, payChecksList);\n            }\n        } finally {\n            redisLock.unlock();\n        }\n        return 0;\n    }\n\n    /**\n     * 为校验通过的数据生成指令\n     */\n    public int dealSuccessChecks(List<PayChecksDTO> payCheckList, List<PmcPayChecks> payChecksList) {\n        if (CollectionUtils.isEmpty(payCheckList)) {\n            return 0;\n        }\n        log.info(\"dealSuccessChecks 为校验通过的数据生成指令 size={}\", payCheckList.size());\n        // 获取生成过付款指令的付款单所对应的指令\n        List<String> payCheckNums = payCheckList.stream().map(PayChecksDTO::getPayCheckNum).collect(toList());\n        List<AbcPayInstruct> instructs = abcPayInstructMapper.selectByCheckNums(payCheckNums);\n        Map<String, AbcPayInstruct> checkNumMap = new HashMap<>();\n        if (CollectionUtils.isNotEmpty(instructs)) {\n            checkNumMap = instructs.stream()\n                    .collect(Collectors.toMap(AbcPayInstruct::getPayCheckNum, Function.identity(), (k1, k2) -> k1));\n        }\n\n        // 生成指令\n        List<AbcPayInstruct> payInstructs = this.assembleAbcInstructList(payCheckList);\n        // 插入指令表\n        List<AbcPayInstructDTO> errorInstructs = this.saveOrUpdateInstruct(payInstructs, checkNumMap);\n\n        // 错误指令处理\n        if (CollectionUtils.isNotEmpty(errorInstructs)) {\n            log.info(\"dealSuccessChecks 指令入库失败 errorInstructs={}\", JSON.toJSONString(errorInstructs));\n            // 指令生成失败 更新付款单\n            Map<Long, PmcPayChecks> map = payChecksList.stream()\n                    .collect(Collectors.toMap(PmcPayChecks::getCheckId, Function.identity(), (k1, k2) -> k1));\n\n            for (AbcPayInstructDTO item : errorInstructs) {\n                PmcPayChecks payChecks = map.get(item.getCheckId());\n                payChecks.setStatus(PayStatus.FAILED_UNCOMFIRM.name());\n                payChecks.setFailureReasons(item.getErrorMessage());\n                payChecksService.updatePayCheckAndHis(payChecks);\n            }\n            // 移除错误指令\n            List<String> checkNums = errorInstructs.stream().map(AbcPayInstructDTO::getPayCheckNum).collect(toList());\n            payInstructs = payInstructs.stream()\n                    .filter(t -> !checkNums.contains(t.getPayCheckNum())).collect(Collectors.toList());\n        }\n        if (CollectionUtils.isEmpty(payInstructs)) {\n            log.info(\"dealSuccessChecks 没有处理成功的指令数据 \");\n            return 0;\n        }\n        // 指令生成成功 更新付款单\n        List<Long> okCheckIds = payInstructs.stream().map(AbcPayInstruct::getCheckId).collect(Collectors.toList());\n        List<PmcPayChecks> okPayCheckList = payChecksList.stream()\n                .filter(t -> okCheckIds.contains(t.getCheckId())).collect(Collectors.toList());\n        payChecksService.updateStatusBatch(okCheckIds, PayStatus.PAY_ORDER_GEN.name());\n        payChecksHisService.batchSavePayChecksHisByStatus(okPayCheckList, PayStatus.PAY_ORDER_GEN.name());\n\n        return CollectionUtils.isEmpty(payInstructs) ? 0 : payInstructs.size();\n    }\n\n    /**\n     * 保存/更新指令 并插入历史记录，指令操作统一单条操作\n     *\n     * @param payInstructs 待操作指令\n     * @param checkNumMap  生成过指令的单据 和对应的指令信息\n     * @return 返回指令生成失败的数据\n     */\n    private List<AbcPayInstructDTO> saveOrUpdateInstruct(List<AbcPayInstruct> payInstructs,\n                                                         Map<String, AbcPayInstruct> checkNumMap) {\n        if (CollectionUtils.isEmpty(payInstructs)) {\n            log.info(\"saveOrUpdateInstruct 保存/更新指令 size={}\", 0);\n            return null;\n        }\n        log.info(\"saveOrUpdateInstruct 保存/更新指令 size={}\", payInstructs.size());\n\n        // 指令入库发生错误或指令不符合入库要求\n        List<AbcPayInstructDTO> errorInstruct = new ArrayList<>(payInstructs.size());\n\n        // 保存/更新指令 并插入指令记录\n        for (AbcPayInstruct payInstruct : payInstructs) {\n            AbcPayInstruct oldInstruct = checkNumMap.get(payInstruct.getPayCheckNum());\n            payInstruct.setLastUpdateBy(Constants.SYSTEM_INSTRUCT_USER);\n            payInstruct.setLastUpdateDate(new Date());\n            try {\n                // 付款失败、余额不足、新增付款单 才新增付款指令trnUid\n                if (oldInstruct == null) {\n                    payInstruct.setCreateBy(Constants.SYSTEM_INSTRUCT_USER);\n                    payInstruct.setCreateDate(new Date());\n                    abcPayInstructMapper.insertSelective(payInstruct);\n                    insertInstructHis(payInstruct);\n                } else {\n                    // 此处状态条件与sql中保持一致,若修改请注意修改mapper.xml\n                    if (StringUtils.equals(oldInstruct.getStatus(), PayStatus.FAILED.name())\n                            || StringUtils.equals(oldInstruct.getStatus(), PayStatus.FAILED_BALANCE.name())\n                            || StringUtils.equals(oldInstruct.getStatus(), PayStatus.REFUND.name())) {\n                        payInstruct.setPayId(oldInstruct.getPayId());\n                        payInstruct.setCreateBy(oldInstruct.getCreateBy());\n                        payInstruct.setCreateDate(oldInstruct.getCreateDate());\n                        int count = abcPayInstructMapper.updateByPk(payInstruct);\n                        if (count == 1) {\n                            insertInstructHis(payInstruct);\n                        } else {\n                            // 状态已经被更新\n                            log.error(\"付款指令状态已经被更新 入库失败\");\n                            AbcPayInstructDTO dto = new AbcPayInstructDTO();\n                            BeanUtils.copyProperties(payInstruct, dto);\n                            dto.setErrorMessage(\"指令已被更新\");\n                            errorInstruct.add(dto);\n                        }\n                    } else {\n                        AbcPayInstructDTO dto = new AbcPayInstructDTO();\n                        BeanUtils.copyProperties(payInstruct, dto);\n                        dto.setErrorMessage(\"该付款单存在正在支付中的指令，无法再次生成指令\");\n                        errorInstruct.add(dto);\n                    }\n                }\n            } catch (Exception e) {\n                AbcPayInstructDTO dto = new AbcPayInstructDTO();\n                BeanUtils.copyProperties(payInstruct, dto);\n                dto.setErrorMessage(\"指令入库发生错误\");\n                errorInstruct.add(dto);\n                log.error(\"指令入库发生错误 saveOrUpdateInstruct, 付款单编号{} \", payInstruct.getPayCheckNum(), e);\n            }\n        }\n        return errorInstruct;\n    }\n\n    /**\n     * 插入指令历史记录\n     */\n    private void insertInstructHis(AbcPayInstruct payInstruct) {\n        AbcPayInstructHis payInstructHis = new AbcPayInstructHis();\n        BeanUtils.copyProperties(payInstruct, payInstructHis);\n        payInstructHis.setLastUpdateDate(new Date());\n        payInstructHis.setLastUpdateBy(Constants.SYSTEM_INSTRUCT_USER);\n        abcPayInstructHisMapper.insert(payInstructHis);\n    }\n\n    /**\n     * 根据付款单生成农业银行付款指令\n     *\n     * @param payCheckList 付款单\n     * @return 指令\n     */\n    private List<AbcPayInstruct> assembleAbcInstructList(List<PayChecksDTO> payCheckList) {\n        List<AbcPayInstruct> payInstructs = new ArrayList<>();\n        payCheckList.forEach(payCheck -> {\n\n            AbcPayInstruct payInstruct = new AbcPayInstruct();\n            BeanUtils.copyProperties(payCheck, payInstruct);\n            payInstruct.setAcAccountId(payCheck.getAcAccountId());\n            payInstruct.setPayDate(new Date());        // 付款日期设置成指令生成日期\n            payInstruct.setAccount(payCheck.getAccount());\n            payInstruct.setActnam(payCheck.getAccountName());\n            payInstruct.setAmount(payCheck.getAmount());\n            payInstruct.setAmountCurrency(payCheck.getAmountCurrency());\n            payInstruct.setBankCode(Constants.BANK_CODE_ABC);\n            // 付款指令uid\n            payInstruct.setReqSeqNo(this.genAbcInstructTrnUid(payCheck.getPayCheckNum()));\n            payInstruct.setAccountProv(payCheck.getAccount().substring(0, 2));\n            payInstruct.setCheckId(payCheck.getCheckId());\n            payInstruct.setCompanyCode(payCheck.getCompanyCode());\n            // 付款账户联行号\n            payInstruct.setBankNumber(payCheck.getAttribute7());\n            payInstruct.setFunName(Constants.ABC_PAY);\n            payInstruct.setPayCheckNum(payCheck.getPayCheckNum());\n            payInstruct.setStatus(PayStatus.PAY_ORDER_GEN.name());\n\n            if (StringUtils.equals(payCheck.getAttributeCategory(), Constants.WIRE_CN)\n                    || StringUtils.equals(payCheck.getAttributeCategory(), Constants.PAYCARD_CN)) {\n                payInstruct.setPayee(payCheck.getAttribute1());\n                payInstruct.setPayeeAccount(payCheck.getAttribute2());\n                payInstruct.setPayeeBank(payCheck.getAttribute3Name());\n                payInstruct.setPayeeBanch(payCheck.getAttribute4());\n                payInstruct.setPayeeProv(payCheck.getAttribute5Name());\n                payInstruct.setPayeeCity(payCheck.getAttribute6Name());\n                payInstruct.setPayeeBanchNumber(payCheck.getAttribute7());\n            }\n\n            // 是否跨行(用于指令表页面查询,生成指令时接口所需字段为是否同行,即该字段取反)\n            if (StringUtils.equals(payCheck.getAttribute3(), payCheck.getBankCode())\n                    && StringUtils.equals(payInstruct.getBankCode(), Constants.BANK_CODE_ABC)) {\n                payInstruct.setInterBankFlag(Constants.ENABLED_N);\n            } else {\n                payInstruct.setInterBankFlag(Constants.ENABLED_Y);\n            }\n            payInstruct.setProtocolNumber(payCheck.getProtocolNumber());\n            payInstruct.setRemark(this.filterCharacter(payCheck.getRemark()));\n            payInstructs.add(payInstruct);\n        });\n        return payInstructs;\n    }\n\n\n    /**\n     * 过滤特殊字符\n     *\n     * @param filterString 待过滤的数据\n     * @return 过滤后的数据\n     */\n    private String filterCharacter(String filterString) {\n        if (StringUtils.isNotBlank(filterString)) {\n            List<FndFlexValue> fndFlexValues = operateByJDBC.selectByConTwo(XML_ILLEGAL_CHARACTER);\n            String replace = \"\";\n            for (int i = 0; i < fndFlexValues.size(); i++) {\n                if (filterString.contains(fndFlexValues.get(i).getFlexValue())) {\n                    replace = filterString.replace(fndFlexValues.get(i).getFlexValue(),\n                            fndFlexValues.get(i).getDescription());\n                    filterString = replace;\n                }\n            }\n        }\n        return filterString.trim();\n    }\n\n    /**\n     * 校验未通过，需反馈到业务线的数据\n     */\n    public void dealReceiveFailed(List<PmcPayChecks> payErrors, List<PmcPayChecks> payChecksList) {\n        if (CollectionUtils.isEmpty(payErrors)) {\n            return;\n        }\n        log.info(\"dealReceiveFailed 校验未通过，需反馈到业务线的数据 size={}\", payErrors.size());\n        Map<Long, PmcPayChecks> map = payChecksList.stream()\n                .collect(Collectors.toMap(PmcPayChecks::getCheckId, Function.identity(), (k1, k2) -> k1));\n\n        payErrors.forEach(item -> {\n            PmcPayChecks payChecks = map.get(item.getCheckId());\n            payChecks.setStatus(PayStatus.FAILED.name());\n            payChecks.setFailureReasons(item.getFailureReasons());\n            payChecksService.updatePayCheckAndHis(payChecks);\n        });\n\n        // 反馈业务线\n        for (PmcPayChecks payCheck : payErrors) {\n            try {\n                // 回写前端系统\n                payChecksWriteBackService.writeBack(payCheck.getCheckId());\n                // 发送邮件\n                mailService.sendFailedMail(payCheck.getPayCheckNum(), payCheck.getFailureReasons());\n            } catch (Exception e) {\n                log.error(\"反馈业务线异常\", e);\n            }\n        }\n    }\n\n    /**\n     * 校验未通过，可在资金中心修改的数据\n     */\n    public void dealPayFailed(List<PmcPayChecks> receiveErrors, List<PmcPayChecks> payChecksList) {\n        if (CollectionUtils.isEmpty(receiveErrors)) {\n            return;\n        }\n        log.info(\"dealPayFailed 校验未通过，可在资金中心修改的数据 size={}\", receiveErrors.size());\n        Map<Long, PmcPayChecks> map = payChecksList.stream()\n                .collect(Collectors.toMap(PmcPayChecks::getCheckId, Function.identity(), (k1, k2) -> k1));\n\n        List<PmcPayChecks> paycheckForMail = new ArrayList<>();\n        receiveErrors.forEach(item -> {\n            PmcPayChecks payChecks = map.get(item.getCheckId());\n            payChecks.setStatus(PayStatus.VERITY_FAILED.name());\n            payChecks.setFailureReasons(item.getFailureReasons());\n            paycheckForMail.add(payChecks);\n            payChecksService.updatePayCheckAndHis(payChecks);\n        });\n\n        // 发送邮件\n        for (PmcPayChecks payCheck : paycheckForMail) {\n            PayChecksDTO payChecksDTO = new PayChecksDTO();\n            BeanUtils.copyProperties(payCheck, payChecksDTO);\n            mailService.sendCheckFailedMail(payChecksDTO, payChecksDTO.getFailureReasons());\n        }\n    }\n\n\n    /**\n     * 校验付款单\n     *\n     * @param payChecksDTOS 付款单数据\n     * @return 校验通过的数据\n     */\n    private List<PayChecksDTO> verityPayChecks(List<PayChecksDTO> payChecksDTOS, Map<String,\n            List<PmcPayChecks>> errorMap) {\n        log.info(\"verityPayChecks 校验付款单 size={}\", payChecksDTOS.size());\n        // 校验通过的付款单\n        List<PayChecksDTO> payChecks = new ArrayList<>();\n        // 付款方信息校验失败\n        List<PmcPayChecks> payErrors = new ArrayList<>();\n        // 收款方信息校验失败\n        List<PmcPayChecks> receiveErrors = new ArrayList<>();\n        errorMap.put(PayStatus.VERITY_FAILED.name(), payErrors);\n        errorMap.put(PayStatus.FAILED.name(), receiveErrors);\n\n        // 获取启用银企直联的银行\n        List<FndFlexValue> fndFlexValues = operateByJDBC.selectByConNoRedis(TMS_DIRECT_BANK);\n        List<String> bankCodes = fndFlexValues.stream().map(FndFlexValueB::getFlexValue).collect(toList());\n\n        for (PayChecksDTO payChecksDTO : payChecksDTOS) {\n            PmcPayChecks payCheck = new PmcPayChecks();\n            try {\n                if (Constants.BANK_CODE_ABC.equals(payChecksDTO.getBankCode())) {\n                    payCheck.setCheckId(payChecksDTO.getCheckId());\n                    payCheck.setPayCheckNum(payChecksDTO.getPayCheckNum());\n                    // 收款方信息校验\n                    String failed = this.verityReceive(payChecksDTO, payCheck);\n                    if (!StringUtils.isEmpty(failed)) {\n                        payCheck.setStatus(PayStatus.FAILED.name());\n                        receiveErrors.add(payCheck);\n                        continue;\n                    }\n                    // 付款方信息校验\n                    String verityFailed = this.verityPay(bankCodes, payChecksDTO, payCheck);\n                    if (!StringUtils.isEmpty(verityFailed)) {\n                        payCheck.setStatus(PayStatus.VERITY_FAILED.name());\n                        payErrors.add(payCheck);\n                        continue;\n                    }\n                    // 校验通过的数据\n                    payChecks.add(payChecksDTO);\n                }\n            } catch (Exception e) {\n                payCheck.setStatus(PayStatus.VERITY_FAILED.name());\n                receiveErrors.add(payCheck);\n                log.error(\"付款单号:{} 生成付款指令时, 指令校验失败！\", payChecksDTO.getPayCheckNum(), e);\n            }\n        }\n        return payChecks;\n    }\n\n    /**\n     * 需退回上游的错误校验\n     *\n     * @return 错误信息\n     */\n    private String verityReceive(PayChecksDTO payChecksDTO, PmcPayChecks payCheck) {\n        // 收款方信息校验\n        StringBuilder failedStringBuilder = new StringBuilder();\n        if (StringUtils.isBlank(payChecksDTO.getAttributeCategory())) {\n            failedStringBuilder.append(\"收款人信息弹性域字段为空！\");\n        } else if (!Constants.WIRE_CN.equals(payChecksDTO.getAttributeCategory())\n                && !Constants.PAYCARD_CN.equals(payChecksDTO.getAttributeCategory())) {\n            failedStringBuilder.append(\"收款人信息弹性域非工资卡中国或电汇中国! \");\n        }\n        if (StringUtils.isBlank(payChecksDTO.getAttribute1())) {\n            failedStringBuilder.append(\"收款人名称为空! \");\n        } else if (StringUtils.length(payChecksDTO.getAttribute1()) > 60) {\n            failedStringBuilder.append(\"收款人名称长度大于60! \");\n        }\n        if (StringUtils.isBlank(payChecksDTO.getAttribute2())) {\n            failedStringBuilder.append(\"收款方帐号为空！\");\n        } else if (payChecksDTO.getAttribute2().length() > 35) {\n            failedStringBuilder.append(\"收款方帐号长度大于35！\");\n        } else if (payChecksDTO.getAttribute2().contains(\"/\") || payChecksDTO.getAttribute2().contains(\"\\\\\")) {\n            failedStringBuilder.append(\"收款账号字段格式错误！ \");\n        }\n        if (StringUtils.isBlank(payChecksDTO.getAttribute3())) {\n            failedStringBuilder.append(\"收款账号开户行为空！ \");\n        }\n        // 收款方值集翻译失败\n        if (StringUtils.isBlank(payChecksDTO.getAttribute3Name())) {\n            failedStringBuilder.append(\"银行code:\").append(payChecksDTO.getAttribute3()).append(\"值集翻译失败\");\n        }\n\n        if (StringUtils.isBlank(payChecksDTO.getAttribute4())) {\n            failedStringBuilder.append(\"收款账号开户行支行为空！ \");\n        } else {\n            String bankBranch = payChecksDTO.getAttribute3Name() + payChecksDTO.getAttribute4();\n            if (bankBranch.length() > 70) {\n                failedStringBuilder.append(\"收款人开户行+开户支行名称长度大于70！\");\n            }\n        }\n\n        if (StringUtils.isBlank(payChecksDTO.getAttribute7())) {\n            failedStringBuilder.append(\"收款人联行号为空！ \");\n        } else if (StringUtils.length(payChecksDTO.getAttribute7()) != 5\n                && StringUtils.length(payChecksDTO.getAttribute7()) != 12) {\n            failedStringBuilder.append(\"收款人联行号长度必须为5或12！ \");\n        }\n\n        if (StringUtils.isNotBlank(payChecksDTO.getRemark())\n                && StringUtils.length(payChecksDTO.getRemark()) > 70) {\n            failedStringBuilder.append(\"用途字段长度大于70！\");\n        } else if (StringUtils.isNotBlank(payChecksDTO.getRemark())\n                && payChecksDTO.getRemark().contains(\"|\")) {\n            failedStringBuilder.append(\"用途字段格式错误！\");\n        }\n\n        payCheck.setFailureReasons(failedStringBuilder.toString());\n        return payCheck.getFailureReasons();\n    }\n\n    /**\n     * 资金中心可维护的信息\n     *\n     * @return 错误信息\n     */\n    private String verityPay(List<String> bankCodes, PayChecksDTO payChecksDTO, PmcPayChecks payCheck) {\n        StringBuilder verityFailedStringBuilder = new StringBuilder();\n        // 付款方信息校验\n        if (!Constants.TYPE_HOME.equals(payChecksDTO.getAccountType())) {\n            verityFailedStringBuilder.append(\"付款账户非国内账户！\");\n        }\n        if (!bankCodes.contains(payChecksDTO.getBankCode())) {\n            verityFailedStringBuilder.append(\"付款银行没有开通银企直连！\");\n        }\n        if (StringUtils.isBlank(payChecksDTO.getReferenceNumber())) {\n            verityFailedStringBuilder.append(\"业务参考号为空！\");\n        }\n        if (StringUtils.isBlank(payChecksDTO.getAccount())) {\n            verityFailedStringBuilder.append(\"付款账户为空！\");\n        } else if (payChecksDTO.getAccount().length() > 35) {\n            verityFailedStringBuilder.append(\"付款账户长度大于35！\");\n        }\n        if (StringUtils.isNotBlank(payChecksDTO.getAccountName())\n                && StringUtils.length(payChecksDTO.getAccountName()) > 50) {\n            verityFailedStringBuilder.append(\"付款账户名称长度大于50！\");\n        }\n        if (!StringUtils.equals(payChecksDTO.getCurrency(), payChecksDTO.getAmountCurrency())) {\n            verityFailedStringBuilder.append(\"付款币种和账户币种不一致！\");\n        }\n        if (!Constants.CNY.equals(payChecksDTO.getAmountCurrency())) {\n            verityFailedStringBuilder.append(\"币种不是人民币！\");\n        }\n        if (payChecksDTO.getAmount() == null || payChecksDTO.getAmount().compareTo(BigDecimal.ZERO) <= 0) {\n            verityFailedStringBuilder.append(\"金额小于等于0！\");\n        }\n        if (!Constants.ENABLED_Y.equals(payChecksDTO.getDirectFlag())) {\n            verityFailedStringBuilder.append(\"没有启用银企支付！\");\n        }\n\n        if (StringUtils.isNotBlank(payChecksDTO.getAccountName())\n                && StringUtils.length(payChecksDTO.getAccountName()) > 70) {\n            verityFailedStringBuilder.append(\"付款账户名称长度大于70！\");\n        }\n        payCheck.setFailureReasons(verityFailedStringBuilder.toString());\n        return payCheck.getFailureReasons();\n    }\n\n    @Override\n    public void updateOneInstructAndHis(AbcPayInstruct payInstruct) {\n        if (payInstruct.getPayId() == null) {\n            abcPayInstructMapper.updateByPayCheckNumber(payInstruct);\n        } else {\n            payInstruct.setLastUpdateBy(Constants.SYSTEM_INSTRUCT_USER);\n            payInstruct.setLastUpdateDate(new Date());\n            // 更新指令\n            abcPayInstructMapper.updateByPrimaryKey(payInstruct);\n\n        }\n        AbcPayInstruct payInstructOne = abcPayInstructMapper.findByPayCheckNumber(payInstruct.getPayCheckNum(), null);\n        if (payInstructOne != null) {\n            AbcPayInstructHis payInstructHis = new AbcPayInstructHis();\n            BeanUtils.copyProperties(payInstructOne, payInstructHis);\n            payInstructHis.setCreateDate(new Date());\n            payInstructHis.setLastUpdateDate(new Date());\n            abcPayInstructHisMapper.insert(payInstructHis);\n        }\n    }\n\n    /**\n     * 根据付款单号生成付款唯一id\n     */\n    private String genAbcInstructTrnUid(String payCheckNum) {\n        int queueNum = 1;\n        String oldTrnUid = abcPayInstructMapper.selectTrnUidByCheckNum(payCheckNum);\n        if (StringUtils.isNotBlank(oldTrnUid)) {\n            String number = oldTrnUid.replace(payCheckNum, StringUtils.EMPTY);\n            queueNum = Integer.parseInt(number) + 1;\n        }\n        return payCheckNum.concat(String.format(Constants.ABC_INSTRUCT_TRN_UID, queueNum));\n    }\n\n    @Override\n    public Page<PayInstructDTO> abcInstructList(PayInstructQO payInstructQO) {\n        if (payInstructQO.getPageNum() > 0 && payInstructQO.getPageSize() > 0) {\n            PageHelper.startPage(payInstructQO.getPageNum(), payInstructQO.getPageSize());\n        } else {\n            return new Page<>(0, 0);\n        }\n        payInstructQO.setTenantId(1L);\n        Page<PayInstructDTO> payInstructs = abcPayInstructMapper.selectByCondition(payInstructQO);\n        operateByJDBC.translate(payInstructs, \"bankCode\", BANK, \"status\", BANK_INSTRUCTION_STATUS, \"funName\",\n                BANK_INSTRUCTION_TYPE, \"interBankFlag\", YES_NO, \"amountCurrency\", CURRENCY);\n        payInstructs.forEach(this::translateInstruct);\n        return payInstructs;\n    }\n\n    /**\n     * 指令数据转换\n     */\n    private void translateInstruct(PayInstructDTO payInstructs) {\n        payInstructs.setCurrencyName(payInstructs.getAmountCurrencyName());\n        payInstructs.setPayeeBankName(payInstructs.getPayeeBank());\n        payInstructs.setPayeeProvName(payInstructs.getPayeeProv());\n        payInstructs.setPayeeCityName(payInstructs.getPayeeCity());\n        payInstructs.setFunCodeName(payInstructs.getFunNameName());\n        payInstructs.setBusinessResultCode(payInstructs.getProcessCode());\n    }\n\n    @Override\n    public Page<PayInstructDTO> abcSuspectList(PayInstructQO payInstructQO) {\n        if (StringUtils.isBlank(payInstructQO.getStatus())) {\n            List<String> suspectStatus = new ArrayList<>();\n            suspectStatus.add(PayStatus.ORDER_SEND.name());\n            suspectStatus.add(PayStatus.BANK_PROCESSING.name());\n            suspectStatus.add(PayStatus.ORDER_UNKNOW.name());\n            payInstructQO.setSuspectStatus(suspectStatus);\n        }\n        return this.abcInstructList(payInstructQO);\n    }\n\n    @Override\n    @Transactional(rollbackFor = Exception.class)\n    public String updateAbcInstruct(PayInstructQO payInstructQO) {\n        AbcPayInstruct payInstruct = abcPayInstructMapper.selectByPrimaryKey(payInstructQO.getPayId());\n        log.info(\"异常指令处理 payId={}, status={}\", payInstructQO.getPayId(), payInstructQO.getStatus());\n        if (payInstruct == null) {\n            return \"未获取到付款指令\";\n        }\n        if (!PayStatus.ORDER_UNKNOW.name().equals(payInstruct.getStatus())) {\n            return \"只有状态不明指令才能处理\";\n        }\n        if (StringUtils.equals(PayStatus.PAYED.name(), payInstructQO.getStatus())\n                || StringUtils.equals(PayStatus.FAILED.name(), payInstructQO.getStatus())\n                || StringUtils.equals(PayStatus.ORDER_FAILED.name(), payInstructQO.getStatus())) {\n            if (StringUtils.equals(payInstruct.getAttribute1(), Constants.ENABLED_Y)) {\n                if (PayStatus.PAYED.name().equals(payInstructQO.getStatus())) {\n                    if (payInstructQO.getPayDate().after(new Date())) {\n                        return \"实际付款日期不能在今天之后\";\n                    }\n                    payInstruct.setHandleDate(payInstructQO.getPayDate());\n                }\n                // 更新状态\n                payInstruct.setStatus(payInstructQO.getStatus());\n                this.updateInstructAndCheck(payInstruct);\n            } else {\n                return \"请先析疑再修改单据状态！\";\n            }\n        }\n        return null;\n    }\n\n    /**\n     * 更新指令和付款单，并插入操作记录\n     */\n    private void updateInstructAndCheck(AbcPayInstruct payInstruct) {\n        if (payInstruct == null) {\n            log.error(\"updateInstructAndCheck payInstruct=null\");\n            return;\n        }\n        log.info(\"updateInstructAndCheck 更新指令和付款单 payCheckNum={}\", payInstruct.getPayCheckNum());\n        this.updateOneInstructAndHis(payInstruct);\n\n        PmcPayChecks payChecks = new PmcPayChecks();\n        payChecks.setPayCheckNum(payInstruct.getPayCheckNum());\n        payChecks.setStatus(payInstruct.getStatus());\n        if (PayStatus.PAYED.name().equals(payInstruct.getStatus()) && payInstruct.getHandleDate() != null) {\n            payChecks.setActualPayDate(payInstruct.getHandleDate());\n        }\n\n        if (PayStatus.ORDER_FAILED.name().equals(payInstruct.getStatus())) {\n            payChecks.setFailureReasons(\"\");\n        }\n        payChecksService.updateByCheckNum(payChecks);\n        PmcPayChecks pmcPayChecks = payChecksService.selectPayChecksByPayCheckNum(payChecks.getPayCheckNum());\n        // 付款单更新记录\n        PmcPayChecksAuditHis pmcPayChecksAuditHis = new PmcPayChecksAuditHis();\n        BeanUtils.copyProperties(pmcPayChecks, pmcPayChecksAuditHis);\n        pmcPayChecksAuditHis.setPayNode(PayNode.PAY_BANK_INTERFACES.name());\n        if (StringUtils.equals(PayStatus.DUPLICATED_REJECT.name(), payInstruct.getStatus())) {\n            pmcPayChecksAuditHis.setPayOperation(PayOperation.DUPLICATED_REJECT.name());\n        }\n        if (StringUtils.equals(PayStatus.PAY_ORDER_GEN.name(), payInstruct.getStatus())) {\n            pmcPayChecksAuditHis.setPayOperation(PayOperation.PAY_ORDER_GENERATED.name());\n        }\n        if (StringUtils.equals(PayStatus.FAILED.name(), payInstruct.getStatus())) {\n            pmcPayChecksAuditHis.setPayOperation(PayOperation.EBANK_STATUS_UPDATE_FAILED.name());\n        }\n        payChecksHisService.savePayChecksHis(pmcPayChecksAuditHis);\n    }\n\n    @Override\n    public void updateAbcInstructFailedBatch(List<Long> payIds) {\n        payIds.forEach(detail -> {\n            AbcPayInstruct instruct = abcPayInstructMapper.selectByPrimaryKey(detail);\n            // 更新状态\n            if (StringUtils.equals(PayStatus.ORDER_UNKNOW.name(), instruct.getStatus())) {\n                instruct.setStatus(PayStatus.ORDER_FAILED.name());\n                instruct.setAttribute1(\"\");\n                instruct.setRelCode(\"\");\n                instruct.setRelMessage(\"\");\n                instruct.setProcessCode(\"\");\n                instruct.setProcessMessage(\"\");\n                instruct.setProcessInstanceNumber(\"\");\n                this.updateInstructAndCheck(instruct);\n            }\n        });\n    }\n\n}\n",
