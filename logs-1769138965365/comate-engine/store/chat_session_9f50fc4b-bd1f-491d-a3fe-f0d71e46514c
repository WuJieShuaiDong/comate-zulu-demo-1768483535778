                "content": "package com.baidu.pmc.abc.core.service.impl;\n\nimport com.alibaba.fastjson.JSON;\nimport com.baidu.pmc.abc.core.constants.Constants;\nimport com.baidu.pmc.abc.core.dto.AbcPayInstructDTO;\nimport com.baidu.pmc.abc.core.dto.AbcTransactionsDTO;\nimport com.baidu.pmc.abc.core.dto.ResponseBodyDTO;\nimport com.baidu.pmc.abc.core.dto.ResponseHeaderDTO;\nimport com.baidu.pmc.abc.core.service.AbcPayInstructService;\nimport com.baidu.pmc.abc.core.service.AbcService;\nimport com.baidu.pmc.abc.core.service.AccountService;\nimport com.baidu.pmc.abc.core.service.FileService;\nimport com.baidu.pmc.abc.core.service.MachineService;\nimport com.baidu.pmc.abc.core.service.OperateByJDBC;\nimport com.baidu.pmc.abc.core.service.PayChecksHisService;\nimport com.baidu.pmc.abc.core.service.PayChecksService;\nimport com.baidu.pmc.abc.core.service.PayChecksWriteBackService;\nimport com.baidu.pmc.abc.core.utils.DateTool;\nimport com.baidu.pmc.abc.core.utils.MessageBuilder;\nimport com.baidu.pmc.abc.core.utils.NodeDistributeUtil;\nimport com.baidu.pmc.abc.core.utils.ResponseXmlParser;\nimport com.baidu.pmc.abc.core.utils.SocketUtils;\nimport com.baidu.pmc.abc.core.utils.WkContextHolder;\nimport com.baidu.pmc.abc.persistence.dao.AbcPayInstructMapper;\nimport com.baidu.pmc.abc.persistence.dao.BankNumberMapper;\nimport com.baidu.pmc.abc.persistence.domain.AbcPayInstruct;\nimport com.baidu.pmc.abc.persistence.domain.BankNumber;\nimport com.baidu.pmc.common.exception.ServiceException;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.common.utils.RedisLock;\nimport com.baidu.pmc.pojo.constants.PayNode;\nimport com.baidu.pmc.pojo.constants.PayOperation;\nimport com.baidu.pmc.pojo.constants.PayStatus;\nimport com.baidu.pmc.pojo.dto.cmb.BalanceInfo;\nimport com.baidu.pmc.pojo.dto.cmb.PmcCmbMachineDTO;\nimport com.baidu.pmc.pojo.dto.cmb.TransInfo;\nimport com.baidu.pmc.pojo.model.PmcAccount;\nimport com.baidu.pmc.pojo.model.PmcPayChecks;\nimport com.baidu.pmc.pojo.model.PmcPayChecksAuditHis;\nimport com.baidu.pmc.pojo.model.cmb.PayQO;\nimport com.baidu.pmc.pojo.model.cmb.PmcCmbMachine;\nimport com.baidu.pmc.pojo.qo.cmb.PayInstructQO;\nimport com.google.common.collect.Lists;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections.CollectionUtils;\nimport org.apache.commons.lang.StringUtils;\nimport org.jdom2.Document;\nimport org.springframework.beans.BeanUtils;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\nimport tk.mybatis.mapper.entity.Example;\n\nimport java.math.BigDecimal;\nimport java.util.ArrayList;\nimport java.util.Date;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.function.Function;\nimport java.util.stream.Collectors;\n\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.BANK;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.BD_COMPANY;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.CURRENCY;\n\n\n@Slf4j\n@Service\npublic class AbcServiceImpl implements AbcService {\n\n    @Autowired\n    private AccountService accountService;\n    @Autowired\n    private SendMailService mailService;\n    @Autowired\n    private MachineService machineService;\n    @Autowired\n    private AbcPayInstructMapper abcPayInstructMapper;\n    @Autowired\n    private AbcPayInstructService abcPayInstructService;\n    @Autowired\n    private OperateByJDBC operateByJDBC;\n    @Autowired\n    private PayChecksService payChecksService;\n    @Autowired\n    private PayChecksHisService payChecksHisService;\n    @Autowired\n    private PayChecksWriteBackService payChecksWriteBackService;\n    @Autowired\n    private FileService fileService;\n    @Autowired\n    private BankNumberMapper bankNumberMapper;\n\n    /**\n     * 10 毫秒重试\n     */\n    private static final long REDIS_LOCK_TIMEOUT = 10;\n    /**\n     * 10 分钟超时\n     */\n    private static final int REDIS_LOCK_EXPIRE = 10 * 60;\n\n    @Override\n    public List<BalanceInfo> selectAbcBalance(PayQO payQO) {\n        log.info(\"查询农行当日余额 selectAbcBalance accountNo={}\", payQO.getBankAccount());\n        List<BalanceInfo> result = new ArrayList<>();\n        List<PmcAccount> pmcAccounts = accountService.queryAbcAccount(payQO);\n        if (CollectionUtils.isEmpty(pmcAccounts)) {\n            log.info(\"没有启用中的农行账户\");\n            return null;\n        }\n        Map<String, PmcAccount> map = pmcAccounts.stream()\n                .collect(Collectors.toMap(PmcAccount::getAccountNo, Function.identity(), (k1, k2) -> k1));\n        log.info(\"待查询的农行账户数量 size={}\", pmcAccounts.size());\n\n        if (CollectionUtils.isNotEmpty(pmcAccounts)) {\n            for (PmcAccount pmcAccount : pmcAccounts) {\n                AbcPayInstructDTO dto = new AbcPayInstructDTO();\n                dto.setAccount(pmcAccount.getAccountNo());\n                // 生成请求报文\n                Document document = MessageBuilder.queryBalanceNowMessage(dto);\n                // 发送农业银行前置机\n                String response = this.postABC(document, pmcAccount.getAccountNo(),\n                        WkContextHolder.getTenantId(), null);\n                // 处理农业银行余额响应结果\n                this.abcBalanceDeal(response, map, result);\n            }\n        }\n        return result;\n    }\n\n    /**\n     * 处理农行银行余额响应结果\n     */\n    public void abcBalanceDeal(String response, Map<String, PmcAccount> map, List<BalanceInfo> result) {\n        log.info(\"abcBalanceDeal 处理农行银行响应结果开始\");\n        if (Constants.NO_ENABLED_MACHINE.equals(response) || Constants.BANK_POST_EXCEPTION.equals(response)) {\n            log.error(\"余额查询时 无可用前置机异常 或网络错误\");\n            return;\n        }\n        ResponseHeaderDTO responseHeaderDto =\n                ResponseXmlParser.parseResponseXml(response, Constants.AbcTranscodeEnum.BALANCE_NOW);\n        log.info(\"queryAbcBalance 处理农行银行余额请求结果 resDto={}\", JSON.toJSONString(responseHeaderDto));\n        // 处理成功\n        if (responseHeaderDto != null && Constants.RESPONSE_0.equals(responseHeaderDto.getRespSource())\n                && Constants.RESPONSE_0000.equals(responseHeaderDto.getRespCode())) {\n            ResponseBodyDTO bodyDto = responseHeaderDto.getBodyDto();\n            if (bodyDto != null) {\n                log.info(\"queryAbcBalance 开始处理银行返回的余额数据\");\n                BalanceInfo balanceInfo = new BalanceInfo();\n                balanceInfo.setAvailableBalance(bodyDto.getAvailBal());\n                balanceInfo.setOnlineBalance(bodyDto.getBal());\n                balanceInfo.setCurrency(Constants.CNY);\n                balanceInfo.setAccount(bodyDto.getDbProv() + bodyDto.getDbAcc());\n                balanceInfo.setAnnotation(bodyDto.getDbAccName());\n                balanceInfo.setCurrentDate(new Date());\n                balanceInfo.setCurrencyName(operateByJDBC.translate(CURRENCY, Constants.CNY));\n                balanceInfo.setBank(Constants.BANK_CODE_ABC);\n                balanceInfo.setBankName(operateByJDBC.translate(BANK, Constants.BANK_CODE_ABC));\n                PmcAccount account;\n                if (map != null && (account = map.get(bodyDto.getDbAccName())) != null) {\n                    balanceInfo.setBranchBank(account.getBranchName());\n                    balanceInfo.setBranchBankName(account.getBranchName());\n                }\n                // 银行返回的账户余额才做记录\n                if (StringUtils.isNotBlank(bodyDto.getDbAccName())) {\n                    result.add(balanceInfo);\n                }\n            } else {\n                log.error(\"queryAbcBalance 农行银行余额报文解析发生错误\");\n            }\n        }\n    }\n\n\n    /**\n     * 请求农行前置机\n     *\n     * @param document\n     * @param hashValue\n     * @param tenantId\n     * @return\n     */\n    @Override\n    public String postABC(Document document, String hashValue, Long tenantId, String[] ipArr) {\n        PmcCmbMachineDTO cmbMachineDTO = new PmcCmbMachineDTO();\n        cmbMachineDTO.setTenantId(tenantId);\n        cmbMachineDTO.setStatus(Constants.UP);\n        cmbMachineDTO.setMachineBank(Constants.BANK_CODE_ABC);\n        List<PmcCmbMachine> pmcCmbMachines = machineService.selectMachine(cmbMachineDTO);\n        if (CollectionUtils.isEmpty(pmcCmbMachines)) {\n            log.error(\"无可用前置机 postABC\");\n            // 无可用前置机\n            mailService.sendMachineFailedMail(\"农行无可用前置机\", new ArrayList<>(), \"\");\n            return Constants.NO_ENABLED_MACHINE;\n        }\n        pmcCmbMachines.forEach(detail -> log.info(\"可用前置机：\" + detail.getName() + \" \" + detail.getIp()));\n        log.info(\"租户：\" + tenantId);\n        // 一致性哈希算法 获取分配机器\n        Map<String, PmcCmbMachine> map = pmcCmbMachines.stream()\n                .collect(Collectors.toMap(PmcCmbMachine::getIp, Function.identity(), (k1, k2) -> k1));\n        String[] currentServers = map.keySet().toArray(new String[0]);\n        String server = new NodeDistributeUtil().getServer(hashValue, currentServers);\n        log.info(\"request server : \" + server);\n        PmcCmbMachine machine = map.get(server);\n        log.info(\"请求前置机ip地址: {}\", machine.getIp());\n        String[] ipPort;\n        if (server.split(\"//\").length != 2\n                || (ipPort = server.split(\"//\")[1].split(\":\")).length != 2) {\n            log.error(\"ip = {}, 格式不正确\", server);\n            return Constants.NO_ENABLED_MACHINE;\n        }\n        if (null != ipArr) {\n            ipArr[0] = ipPort[0];\n        }\n        String funNam = document.getRootElement().getChild(\"CCTransCode\").getText();\n        log.info(\"访问农行接口名：\" + funNam);\n        try {\n            // 请求报文\n            String request = MessageBuilder.generateXML(document);\n            log.info(\"请求报文 request={}\", request);\n\n            String response = SocketUtils.sendSocketRequest(ipPort[0], Integer.parseInt(ipPort[1]), request);\n            log.info(\"response :\" + response);\n            return response;\n        } catch (Exception e) {\n            log.error(\"网络出错，请检查网络！\", e);\n        }\n        return Constants.BANK_POST_EXCEPTION;\n    }\n\n    @Override\n    public int abcUnUrgentPay() {\n        RedisLock redisLock = new RedisLock(\"abcUnUrgentPay\");\n        int count = 0;\n        try {\n            if (!redisLock.lock(REDIS_LOCK_TIMEOUT, REDIS_LOCK_EXPIRE)) {\n                log.info(\"===========农业银行支付任务执行中，请稍后再试===========\");\n                throw new ServiceException(\"农业银行支付任务执行中，请稍后再试\");\n            }\n            Example example = new Example(AbcPayInstruct.class);\n            List<String> status = new ArrayList<>();\n            status.add(PayStatus.PAY_ORDER_GEN.name());\n            status.add(PayStatus.ORDER_FAILED.name());\n            example.createCriteria().andIn(\"status\", status)\n                    .andEqualTo(\"funName\", Constants.ABC_PAY);\n            List<AbcPayInstruct> payInstructs = abcPayInstructMapper.selectByExample(example);\n\n            if (CollectionUtils.isEmpty(payInstructs)) {\n                log.info(\"没有待支付的付款指令 abcUnUrgentPay resultSize={}\", 0);\n                return 0;\n            }\n\n            // 指令信息改为发送中\n            payInstructs.forEach(detail -> detail.setStatus(PayStatus.ORDER_SEND.name()));\n            // 批量更新指令 并插入历史记录表\n            this.batchUpdateAbcInstructAndHis(payInstructs);\n\n            // 支付\n            List<AbcPayInstructDTO> dtoList = this.batchPay(payInstructs);\n            count = dtoList.size();\n        } finally {\n            redisLock.unlock();\n        }\n        return count;\n    }\n\n    /**\n     * 批量更新指令数据并插入历史记录\n     */\n    public void batchUpdateAbcInstructAndHis(List<AbcPayInstruct> payInstructs) {\n        if (CollectionUtils.isNotEmpty(payInstructs)) {\n            payInstructs.forEach(\n                    instruct -> this.updateInstructAndHis(instruct, instruct.getStatus(), null, null, null, null,\n                            null));\n        }\n    }\n\n    /**\n     * 更新指令状态\n     */\n    private void updateInstructAndHis(AbcPayInstruct payInstruct, String status, String relCode, String relMsg,\n                                      String detailCode, String detailMsg, String processInstanceNumber) {\n        payInstruct.setStatus(status);\n        payInstruct.setRelCode(relCode);\n        payInstruct.setRelMessage(relMsg);\n        payInstruct.setProcessCode(detailCode);\n        payInstruct.setProcessMessage(detailMsg);\n        payInstruct.setProcessInstanceNumber(processInstanceNumber);\n        log.info(\"updateInstructAndHis payInstruct={}\", JSON.toJSONString(payInstruct));\n        abcPayInstructService.updateOneInstructAndHis(payInstruct);\n    }\n\n    /**\n     * 发起支付\n     */\n    private List<AbcPayInstructDTO> batchPay(List<AbcPayInstruct> payInstructs) {\n        log.info(\"batchPay 发起支付 size={}\", payInstructs.size());\n        List<AbcPayInstructDTO> result = new ArrayList<>(payInstructs.size());\n        Long tenantId = payInstructs.get(0).getTenantId();\n        List<AbcPayInstructDTO> errorInstructList = new ArrayList<>();\n        for (AbcPayInstruct item : payInstructs) {\n            List<AbcPayInstructDTO> dtoList = new ArrayList<>();\n            AbcPayInstructDTO dto = new AbcPayInstructDTO();\n            BeanUtils.copyProperties(item, dto);\n            dtoList.add(dto);\n            // 保证每个批次数据正常处理不影响\n            try {\n                // 组装发送报文\n                Document document = MessageBuilder.queryBankPayMessage(dto);\n                if (StringUtils.isNotBlank(dto.getErrorMessage())) {\n                    log.error(\"报文组装失败 payCheckNum={}\", dto.getPayCheckNum());\n                    // 报文组装失败\n                    errorInstructList.add(dto);\n                    continue;\n                }\n\n                // 发送农业银行前置机\n                String response = null;\n                response = this.postABC(document, dto.getAccount(), tenantId, null);\n                if (Constants.NO_ENABLED_MACHINE.equals(response)) {\n                    log.error(\"付款时 无可用前置机异常, payCheckNum={}\", dto.getPayCheckNum());\n                    this.batchUpdateInstructAndHis(dtoList, PayStatus.ORDER_FAILED.name(),\n                            Constants.NO_ENABLED_MACHINE_MSG, Constants.NO_ENABLED_MACHINE_MSG);\n                    continue;\n                } else if (Constants.BANK_POST_EXCEPTION.equals(response)) {\n                    log.error(\"发起支付请求异常, payCheckNum={}\", dto.getPayCheckNum());\n                    this.batchUpdateInstructAndHis(dtoList, PayStatus.ORDER_UNKNOW.name(),\n                            Constants.REQUEST_ERROR, Constants.REQUEST_ERROR);\n                    // 预警邮件\n                    mailService.sendOrderUnknownMail(dtoList.stream()\n                            .map(AbcPayInstruct::getPayCheckNum).collect(Collectors.toList()));\n                    continue;\n                }\n                // 处理农业银行请求结果\n                this.dealPayResponseResult(response, dtoList);\n                this.batchPayChecksDeal(dtoList);\n                result.add(dto);\n            } catch (Exception e) {\n                log.error(\"batchPay 支付结果处理过程中发生异常\", e);\n                // 暂时发送邮件人工干预处理\n                mailService.sendBankResultDealErrorMail(payInstructs.stream()\n                        .map(AbcPayInstruct::getPayCheckNum).collect(Collectors.toList()));\n            }\n        }\n        // 处理报文组装失败的指令\n        this.batchDocumentFailDeal(errorInstructList);\n        return result;\n    }\n\n    /**\n     * 处理报文组装失败指令\n     */\n    private void batchDocumentFailDeal(List<AbcPayInstructDTO> errorInstruct) {\n        if (CollectionUtils.isEmpty(errorInstruct)) {\n            return;\n        }\n        try {\n            log.info(\"batchDocumentFailDeal 存在报文组装失败的指令\");\n            // 更新指令状态并插入记录\n            this.batchUpdateInstructAndHis(errorInstruct, PayStatus.FAILED.name(),\n                    \"组装报文异常\", \"组装报文异常如异常字符\");\n            // 更新付款单并插入记录\n            for (AbcPayInstructDTO instruct : errorInstruct) {\n                PmcPayChecks payChecks = new PmcPayChecks();\n                payChecks.setPayCheckNum(instruct.getPayCheckNum());\n                payChecks.setStatus(PayStatus.FAILED.name());\n                payChecks.setFailureReasons(\"组装报文异常如异常字符\");\n                this.updatePayChecksAndInsertHis(payChecks);\n                try {\n                    // 反馈业务线\n                    payChecksWriteBackService.writeBack(instruct.getCheckId());\n                } catch (Exception e) {\n                    log.error(\"batchDocumentFailDeal 反馈业务线异常\", e);\n                }\n            }\n            // 发送异常邮件\n            mailService.paymentMessageFailed(errorInstruct.stream()\n                    .map(AbcPayInstructDTO::getPayCheckNum).collect(Collectors.toList()));\n        } catch (Exception e) {\n            log.error(\"batchDocumentFailDeal error\", e);\n        }\n    }\n\n    /**\n     * 响应到农业银行结果，对付款单进行状态变更，并发送指令邮件\n     */\n    private void batchPayChecksDeal(List<AbcPayInstructDTO> resultInstructs) {\n        if (CollectionUtils.isEmpty(resultInstructs)) {\n            return;\n        }\n        log.info(\"batchPayChecksDeal result={}\", JSON.toJSONString(resultInstructs));\n        // 指令不明的需要发送邮件\n        List<AbcPayInstructDTO> orderUnknown = resultInstructs.stream()\n                .filter(t -> PayStatus.ORDER_UNKNOW.name().equals(t.getStatus())).collect(Collectors.toList());\n        if (!CollectionUtils.isEmpty(orderUnknown)) {\n            // 预警邮件\n            mailService.sendOrderUnknownMail(orderUnknown.stream()\n                    .map(AbcPayInstructDTO::getPayCheckNum).collect(Collectors.toList()));\n        }\n\n        // 银行处理中数据\n        List<AbcPayInstructDTO> processing = resultInstructs.stream()\n                .filter(t -> PayStatus.BANK_PROCESSING.name().equals(t.getStatus())).collect(Collectors.toList());\n        if (!CollectionUtils.isEmpty(processing)) {\n            processing.forEach(instruct -> {\n                PmcPayChecks payChecks = new PmcPayChecks();\n                payChecks.setPayCheckNum(instruct.getPayCheckNum());\n                payChecks.setStatus(PayStatus.BANK_PROCESSING.name());\n                this.updatePayChecksAndInsertHis(payChecks);\n            });\n        }\n\n        // 余额不足数据\n        List<AbcPayInstructDTO> failedBalance = resultInstructs.stream()\n                .filter(t -> PayStatus.FAILED_BALANCE.name().equals(t.getStatus())).collect(Collectors.toList());\n        if (!CollectionUtils.isEmpty(failedBalance)) {\n            failedBalance.forEach(instruct -> {\n                PmcPayChecks payChecks = new PmcPayChecks();\n                payChecks.setPayCheckNum(instruct.getPayCheckNum());\n                payChecks.setStatus(PayStatus.FAILED_BALANCE.name());\n                this.updatePayChecksAndInsertHis(payChecks);\n                // 余额不足邮件\n                mailService.sendBalanceNotEnoughMail(instruct.getPayCheckNum(), \"余额不足\");\n            });\n        }\n\n        // 银行处理失败数据\n        List<AbcPayInstructDTO> failed = resultInstructs.stream()\n                .filter(t -> PayStatus.FAILED.name().equals(t.getStatus())).collect(Collectors.toList());\n        if (!CollectionUtils.isEmpty(failed)) {\n            failed.forEach(instruct -> {\n                PmcPayChecks payChecks = new PmcPayChecks();\n                payChecks.setPayCheckNum(instruct.getPayCheckNum());\n                payChecks.setStatus(PayStatus.FAILED.name());\n                this.updatePayChecksAndInsertHis(payChecks);\n                // 反馈业务线\n                payChecksWriteBackService.writeBack(instruct.getCheckId());\n                // 邮件提醒\n                mailService.sendFailedMail(instruct.getPayCheckNum(), payChecks.getFailureReasons());\n            });\n        }\n\n        // 付款成功数据\n        List<AbcPayInstructDTO> payed = resultInstructs.stream()\n                .filter(t -> PayStatus.PAYED.name().equals(t.getStatus())).collect(Collectors.toList());\n        if (!CollectionUtils.isEmpty(payed)) {\n            payed.forEach(instruct -> {\n                PmcPayChecks payChecks = new PmcPayChecks();\n                payChecks.setPayCheckNum(instruct.getPayCheckNum());\n                payChecks.setStatus(PayStatus.PAYED.name());\n                payChecks.setActualPayDate(new Date());\n                this.updatePayChecksAndInsertHis(payChecks);\n                // 反馈业务线\n                payChecksWriteBackService.writeBack(instruct.getCheckId());\n            });\n        }\n    }\n\n    /**\n     * 更新付款单并插入历史记录\n     *\n     * @param payChecks 付款单\n     */\n    @Override\n    public void updatePayChecksAndInsertHis(PmcPayChecks payChecks) {\n        log.info(\"updatePayChecksAndInsertHis 更新付款单并插入历史记录 checkId={}\", payChecks.getCheckId());\n        payChecksService.updateByCheckNum(payChecks);\n        PmcPayChecks pmcPayChecks = payChecksService.selectPayChecksByPayCheckNum(payChecks.getPayCheckNum());\n        // 付款单更新记录\n        PmcPayChecksAuditHis pmcPayChecksAuditHis = new PmcPayChecksAuditHis();\n        BeanUtils.copyProperties(pmcPayChecks, pmcPayChecksAuditHis);\n        pmcPayChecksAuditHis.setPayNode(PayNode.PAY_BANK_INTERFACES.name());\n        pmcPayChecksAuditHis.setLastUpdateBy(Constants.SYSTEM_USER);\n        pmcPayChecksAuditHis.setOperationNote(pmcPayChecks.getFailureReasons());\n        if (StringUtils.equals(PayStatus.PAYED.name(), pmcPayChecks.getStatus())) {\n            pmcPayChecksAuditHis.setPayOperation(PayOperation.EPAYMENT_UPDATE_PAI.name());\n        }\n        if (StringUtils.equals(PayStatus.FAILED.name(), pmcPayChecks.getStatus())) {\n            pmcPayChecksAuditHis.setPayOperation(PayOperation.EPAYMENT_UPDATE_FAILED.name());\n        }\n        if (StringUtils.equals(PayStatus.FAILED_BALANCE.name(), pmcPayChecks.getStatus())) {\n            pmcPayChecksAuditHis.setPayNode(PayNode.PAY_OVERDRAFT_FAIL.name());\n            pmcPayChecksAuditHis.setPayOperation(PayOperation.EPAYMENT_UPDATE_OVERDRAFT_FAILED.name());\n        }\n        if (StringUtils.equals(PayStatus.BANK_PROCESSING.name(), pmcPayChecks.getStatus())) {\n            pmcPayChecksAuditHis.setPayOperation(PayOperation.BANK_PROCESSING.name());\n        }\n        if (StringUtils.equals(PayStatus.REFUND.name(), pmcPayChecks.getStatus())) {\n            pmcPayChecksAuditHis.setPayOperation(PayOperation.EPAYMENT_UPDATE_REFUND.name());\n        }\n        payChecksHisService.savePayChecksHis(pmcPayChecksAuditHis);\n    }\n\n    /**\n     * 处理农业银行支付请求结果\n     */\n    public void dealPayResponseResult(String response, List<AbcPayInstructDTO> successInstruct) {\n        ResponseHeaderDTO responseHeaderDto =\n                ResponseXmlParser.parseResponseXml(response, Constants.AbcTranscodeEnum.BANK_PAY);\n        log.info(\"dealResponseResult 处理农业银行请求结果 resDto={}\", JSON.toJSONString(responseHeaderDto));\n        // 处理成功\n        if (responseHeaderDto != null) {\n            for (AbcPayInstructDTO dto : successInstruct) {\n                String status;\n                if (Constants.RESPONSE_0.equals(responseHeaderDto.getRespSource())) {\n                    status = PayStatus.BANK_PROCESSING.name();\n                } else if (responseHeaderDto.getRespInfo().contains(\"余额不足\")) {\n                    status = PayStatus.FAILED_BALANCE.name();\n                } else {\n                    status = PayStatus.ORDER_UNKNOW.name();\n                }\n                this.updateInstructAndHis(dto, status,\n                        responseHeaderDto.getRespSource(), responseHeaderDto.getRespInfo(),\n                        responseHeaderDto.getRespSource(), responseHeaderDto.getRespInfo(), null);\n            }\n        } else {\n            // 可疑指令\n            this.batchUpdateInstructAndHis(successInstruct, PayStatus.ORDER_UNKNOW.name(), null, null);\n        }\n    }\n\n    /**\n     * 批量更新指令状态\n     */\n    private void batchUpdateInstructAndHis(List<AbcPayInstructDTO> payList,\n                                           String status, String relCode, String relMsg) {\n        payList.forEach(detail ->\n                this.updateInstructAndHis(detail, status, relCode, relMsg, null, null, null));\n    }\n\n    @Override\n    public String abcQueryPayResultJob() {\n        RedisLock redisLock = new RedisLock(\"abcQueryPayResultJob\");\n        try {\n            if (!redisLock.lock(REDIS_LOCK_TIMEOUT, REDIS_LOCK_EXPIRE)) {\n                log.info(\"===========农业银行支付结果查询任务执行中，请稍后再试===========\");\n                throw new ServiceException(\"农业银行支付结果查询任务执行中，请稍后再试\");\n            }\n            Example example = new Example(AbcPayInstruct.class);\n            List<String> status = new ArrayList<>();\n            // 银行处理中\n            status.add(PayStatus.BANK_PROCESSING.name());\n            // 可疑指令\n            status.add(PayStatus.ORDER_UNKNOW.name());\n            example.createCriteria().andIn(\"status\", status);\n            List<AbcPayInstruct> payInstructs = abcPayInstructMapper.selectByExample(example);\n\n            if (CollectionUtils.isEmpty(payInstructs)) {\n                log.info(\"没有待查询的付款指令 abcQueryPayResultJob resultSize={}\", 0);\n                return \"没有待查询的付款指令\";\n            }\n            this.queryPayResult(payInstructs);\n        } finally {\n            redisLock.unlock();\n        }\n        return \"结果查询完成\";\n    }\n\n    @Override\n    public List<AbcPayInstructDTO> queryPayResult(List<AbcPayInstruct> instructs) {\n        List<AbcPayInstructDTO> dtoList = new ArrayList<>();\n\n        for (AbcPayInstruct payInstruct : instructs) {\n            AbcPayInstructDTO dto = new AbcPayInstructDTO();\n            BeanUtils.copyProperties(payInstruct, dto);\n            // 组装支付结果查询报文\n            Document document = MessageBuilder.queryPayStatusMessage(dto);\n\n            // 发送兴业银行前置机\n            String response = this.postABC(document, dto.getAccount(), WkContextHolder.getTenantId(), null);\n            if (Constants.NO_ENABLED_MACHINE.equals(response) || Constants.BANK_POST_EXCEPTION.equals(response)) {\n                log.error(\"付款结果查询时 无可用前置机异常 或网络错误\");\n                continue;\n            }\n            ResponseHeaderDTO resDto = ResponseXmlParser.parseResponseXml(response,\n                    Constants.AbcTranscodeEnum.PAY_STATUS);\n            if (resDto == null) {\n                log.error(\"付款结果查询时 农业银行反馈结果为空\");\n            } else if (!Constants.RESPONSE_0.equals(resDto.getRespSource())) {\n                log.error(\"付款结果查询时 农业银行反馈结果 relCode={}, resMeg={}\",\n                        resDto.getRespCode(), resDto.getRespInfo());\n            } else if (resDto.getBodyDto() == null) {\n                log.error(\"付款结果查询时 农业银行反馈成功，子节点为空\");\n            } else {\n                this.dealBackStatus(dto, resDto);\n            }\n            dtoList.add(dto);\n        }\n        return dtoList;\n    }\n\n    /**\n     * 处理状态反馈的数据结果\n     */\n    @Override\n    public void dealBackStatus(AbcPayInstructDTO dto, ResponseHeaderDTO resDto) {\n        List<AbcPayInstructDTO> successBackDto = new ArrayList<>();\n        ResponseBodyDTO bodyDto = resDto.getBodyDto();\n        log.info(\"dealBackStatus dto={}\", JSON.toJSONString(dto));\n        String status = null;\n\n        switch (bodyDto.getTransSta()) {\n            case Constants.RESPONSE_1:\n            case Constants.RESPONSE_2:\n            case Constants.RESPONSE_3:\n            case Constants.RESPONSE_6:\n            case Constants.RESPONSE_7:\n                status = PayStatus.BANK_PROCESSING.name();\n                break;\n            case Constants.RESPONSE_4:\n                status = PayStatus.PAYED.name();\n                break;\n            case Constants.RESPONSE_5:\n            case Constants.RESPONSE_8:\n                status = PayStatus.FAILED.name();\n                dto.setRelCode(resDto.getRespSource());\n                dto.setRelMessage(resDto.getRespInfo());\n                dto.setProcessCode(bodyDto.getTransSta());\n                dto.setProcessMessage(bodyDto.getRespPrvData());\n                break;\n            case Constants.RESPONSE_9:\n                status = PayStatus.ORDER_UNKNOW.name();\n                break;\n            default:\n                // 将银行返回信息记录给前端\n                status = PayStatus.ORDER_UNKNOW.name();\n                dto.setRelCode(resDto.getRespSource());\n                dto.setRelMessage(resDto.getRespInfo());\n                dto.setProcessCode(bodyDto.getTransSta());\n                dto.setProcessMessage(bodyDto.getRespPrvData());\n                break;\n        }\n        log.info(\"dealBackStatus final status is status={}\", status);\n        if (StringUtils.isNotBlank(status)) {\n            this.updateInstructAndHis(dto, status,\n                    resDto.getRespSource(), resDto.getRespInfo(),\n                    bodyDto.getTransSta(), bodyDto.getRespPrvData(), null);\n            successBackDto.add(dto);\n        }\n        this.batchPayChecksDeal(successBackDto);\n    }\n\n    @Override\n    public List<TransInfo> selectAbcTrans(PayQO payQO) {\n        List<TransInfo> result = new ArrayList<>();\n        PmcAccount account = accountService.queryAbcAccountByAccountNo(payQO.getAccountNumber());\n        if (account == null || payQO.getStartDate() == null || payQO.getEndDate() == null) {\n            return result;\n        }\n\n        AbcPayInstructDTO dto = new AbcPayInstructDTO();\n        dto.setTenantId(account.getTenantId());\n        dto.setAccount(account.getAccountNo());\n\n        dto.setBeginDate(DateUtils.formatDate(payQO.getStartDate(), DateTool.DAY_PARTTEN_YYYYMMDD));\n        dto.setEndDate(DateUtils.formatDate(payQO.getEndDate(), DateTool.DAY_PARTTEN_YYYYMMDD));\n        this.homeTransactionsDeal(dto);\n\n\n        if (CollectionUtils.isNotEmpty(dto.getTransInfoList())) {\n            String company = operateByJDBC.translate(BD_COMPANY, account.getCompanyCode());\n            for (TransInfo trans : dto.getTransInfoList()) {\n                trans.setBankAccount(account.getAccountNo());\n                trans.setCompanyName(company);\n                trans.setCurrencyName(operateByJDBC.translate(CURRENCY, trans.getCurrency()));\n                result.add(trans);\n            }\n        }\n\n        return result;\n    }\n\n    /**\n     * 调起农业银行流水接口并处理退票数据\n     */\n    private void homeTransactionsDeal(AbcPayInstructDTO dto) {\n        try {\n            Document document = MessageBuilder.queryTransactionsMessage(dto);\n\n            // 发送农业银行前置机\n            String[] ipArr = new String[1];\n            String response = this.postABC(document, dto.getAccount(), WkContextHolder.getTenantId(), ipArr);\n            if (Constants.NO_ENABLED_MACHINE.equals(response)) {\n                log.error(\"流水查询时 无可用前置机异常, accountNo={}\", dto.getAccount());\n                return;\n            } else if (Constants.BANK_POST_EXCEPTION.equals(response)) {\n                log.error(\"流水查询请求异常, accountNo={}\", dto.getAccount());\n                return;\n            }\n            ResponseHeaderDTO responseHeaderDto =\n                    ResponseXmlParser.parseResponseXml(response, Constants.AbcTranscodeEnum.TRANSACTIONS);\n            log.info(\"homeTransactionsDeal 处理农业银行请求结果 resDto={}\", JSON.toJSONString(responseHeaderDto));\n            // 处理成功\n            if (responseHeaderDto != null && Constants.RESPONSE_0.equals(responseHeaderDto.getRespSource())) {\n                ResponseBodyDTO bodyDto = responseHeaderDto.getBodyDto();\n                if (bodyDto != null) {\n                    // 处理流水数据\n                    if (StringUtils.isNotBlank(bodyDto.getRecordNum())\n                            && Integer.parseInt(bodyDto.getRecordNum()) > 0) {\n                        List<AbcTransactionsDTO> abcTransList = fileService.fetchTransactionsData(ipArr[0],\n                                bodyDto.getBatchFileName());\n                        this.dealTransData(abcTransList, dto);\n                    }\n                } else {\n                    log.error(\"homeTransactionsDeal 农业银行报文解析发生错误\");\n                }\n            }\n        } catch (Exception e) {\n            log.error(\"homeTransactionsDeal 境内账户流水处理失败\", e);\n        }\n    }\n\n    /**\n     * 处理流水响应结果\n     */\n    @Override\n    public void dealTransData(List<AbcTransactionsDTO> abcTransList, AbcPayInstructDTO dto) {\n\n        log.info(\"homeTransactionsDeal 处理农业银行请求结果 abcTransList={}\", JSON.toJSONString(abcTransList));\n        // 处理成功\n\n        if (CollectionUtils.isNotEmpty(abcTransList)) {\n            log.info(\"homeTransactionsDeal 开始处理银行返回的流水数据\");\n            List<TransInfo> transInfoList = this.transTransactions(abcTransList);\n            if (CollectionUtils.isEmpty(dto.getTransInfoList())) {\n                dto.setTransInfoList(transInfoList);\n            } else {\n                dto.getTransInfoList().addAll(transInfoList);\n            }\n        }\n    }\n\n    /**\n     * 封装流水数据\n     */\n    private List<TransInfo> transTransactions(List<AbcTransactionsDTO> abcTransList) {\n        List<TransInfo> transInfoList = new ArrayList<>();\n        for (AbcTransactionsDTO dto : abcTransList) {\n            try {\n                TransInfo trans = new TransInfo();\n                trans.setDealDay(dto.getEtydat());\n                // 看情况根据timestamp进行替换\n                trans.setDealTime(dto.getEtytim());\n                // 摘要\n                trans.setNaryur(dto.getNaryur());\n                trans.setBalance(dto.getAccountBalance());\n                trans.setSerialNumber(dto.getCustomerRefNo());\n\n                trans.setRemark(dto.getPostscript());\n                // 对方账号\n                trans.setAccountName(dto.getCorrelateAccountName());\n                trans.setAccount(dto.getCorrelateAccountProv() + dto.getCorrelateAccount());\n                trans.setBankName(dto.getCorrelateAccountBank());\n                // trans.setBankNumber();\n                trans.setReferenceNumber(dto.getCustomerRefNo());\n                trans.setCurrency(Constants.CNY);\n\n                if (StringUtils.isNotBlank(dto.getAmt())) {\n                    BigDecimal amt = new BigDecimal(dto.getAmt());\n                    // 借贷\n                    if (BigDecimal.ZERO.compareTo(amt) < 0) {\n                        trans.setLoanMark(Constants.DIRECTION_C);\n                        trans.setLoanMarkName(Constants.DIRECTION_C_NAME);\n                        trans.setCreditAmount(String.valueOf(amt.abs()));\n                    } else {\n                        trans.setLoanMark(Constants.DIRECTION_D);\n                        trans.setLoanMarkName(Constants.DIRECTION_D_NAME);\n                        trans.setDebitAmount(String.valueOf(amt.abs()));\n                    }\n                }\n\n                // 交易日\n                StringBuilder day = null;\n                if (StringUtils.isNotBlank(trans.getDealDay())) {\n                    day = new StringBuilder(trans.getDealDay());\n                    if (day.length() == 8) {\n                        day.insert(4, \"-\");\n                        day.insert(7, \"-\");\n                    }\n                }\n                StringBuilder time = null;\n                if (StringUtils.isNotBlank(trans.getDealTime())) {\n                    time = new StringBuilder(trans.getDealTime());\n                    if (time.length() == 6) {\n                        time.insert(2, \":\");\n                        time.insert(5, \":\");\n                    }\n                }\n                trans.setDealDate(day + \" \" + time);\n                transInfoList.add(trans);\n            } catch (Exception e) {\n                log.error(\"transTransactions 处理流水数据时发生异常\", e);\n            }\n        }\n        return transInfoList;\n    }\n\n    @Override\n    public String abcAnalysisSuspect(P