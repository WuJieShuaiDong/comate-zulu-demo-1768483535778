      "absolutePath": "/Users/xiaoliu/baidu/bpit-proc-apps/pmc/pmc-basic-cmbc/src/main/java/com/baidu/pmc/cmbc/core/utils/financing/OutBoundServiceUtils.java",
      "content": "package com.baidu.pmc.cmbc.core.utils.financing;\n\nimport com.baidu.pmc.cmbc.core.constants.FinancingSdkConstants;\nimport com.baidu.pmc.cmbc.core.dto.financing.ClientConfig;\nimport com.baidu.pmc.cmbc.core.dto.financing.EcpSecurityResult;\nimport com.baidu.pmc.cmbc.core.dto.financing.Response;\nimport com.google.gson.Gson;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.http.NameValuePair;\nimport org.apache.http.message.BasicNameValuePair;\n\nimport java.net.ConnectException;\nimport java.net.SocketTimeoutException;\nimport java.net.UnknownHostException;\nimport java.text.SimpleDateFormat;\nimport java.util.ArrayList;\nimport java.util.Date;\nimport java.util.List;\n\n/**\n * 客户端发送报文头和请求报文，工具类\n *\n * @author adt-huangyh\n */\n@Slf4j\npublic class OutBoundServiceUtils {\n    /**\n     * 发送请求报文。传入配置对象\n     *\n     * @param clientConfig 请求报文头相关信息的bean封装\n     * @param input        请求的业务报文对象\n     * @return\n     * @throws Exception\n     */\n    public static Response execute(ClientConfig clientConfig, Object input)\n            throws Exception {\n        log.info(\"请求民生银行，transCode：{}, 请求报文：{}\" , clientConfig.getTransCode(), new Gson().toJson(input));\n        String transCode = clientConfig.getTransCode();\n        if (transCode == null) {\n            String errMsg = \"交易代码不能为空\";\n            log.error(errMsg);\n            throw new RuntimeException(errMsg);\n        }\n        // 发送请求并得到响应\n        String respStr = sendRequest(input, clientConfig);\n        log.info(\"获取的响应报文：\" + respStr);\n        // 解析响应\n        Response resp = null;\n        // json报文请求\n        resp = ParserResponseHelper.parserTxResponse(respStr, clientConfig);\n        return resp;\n    }\n\n    private static String sendRequest(Object request, ClientConfig clientConfig) throws Exception {\n        List<String> urls = clientConfig.getPostUrl();\n        if (urls.isEmpty()) {\n            throw new Exception(\"未配置有效地址!\");\n        }\n        List<NameValuePair> params = null;\n        boolean securitySwitch = clientConfig.getSecuritySwitch() == null || clientConfig.getSecuritySwitch();\n        // 加密和加签\n        if (securitySwitch) {\n            EcpSecurityResult sr = null;\n            if (request != null) {\n                String srcRequest = null;\n                if (request instanceof String) {\n                    srcRequest = (String) request;\n                } else {\n                    srcRequest = new Gson().toJson(request);\n                }\n                log.debug(\"开始签名加密\");\n                sr = EcpSecurityUtil.encryptAndSign(srcRequest, clientConfig.getOwnSm2Path(), clientConfig.getOwnSm2Pwd(),\n                        clientConfig.getBankCertPath());\n            }\n            if (sr != null) {\n                // 组装form表单数据\n                params = getRequestForm(sr.getSignature(), sr.getCipherText(), clientConfig);\n            }\n        } else {\n            String bodyJson = null;\n            if (isJsonString(request)) {\n                bodyJson = (String) request;\n            } else {\n                bodyJson = new Gson().toJson(request);\n            }\n            params = getRequestForm(null, bodyJson, clientConfig);\n        }\n        int i = 0;\n        int max = urls.size();\n        Exception exception = null;\n        while (i < max) {\n            try {\n                String url = urls.get(i++);\n                log.info(\"请求地址是: {}\", url);\n                return HttpUtil.doPost(url, params, clientConfig);\n            } catch (ConnectException | SocketTimeoutException | UnknownHostException e) {\n                if (log.isErrorEnabled()) {\n                    log.error(\"尝试使用下一地址\", exception = e);\n                }\n            }\n        }\n        if (null == exception) {\n            exception = new Exception(\"发送失败\");\n        }\n        throw exception;\n    }\n\n    /**\n     * 封装请求的form表单\n     *\n     * @param sgntr\n     * @param body\n     * @param clientConfig\n     * @return\n     */\n    private static List<NameValuePair> getRequestForm(\n            String sgntr, String body, ClientConfig clientConfig) {\n        List<NameValuePair> form = new ArrayList<NameValuePair>();\n        form.add(new BasicNameValuePair(FinancingSdkConstants.TRANSCODE, clientConfig.getTransCode()));\n        form.add(new BasicNameValuePair(FinancingSdkConstants.PRODUCT_CODE, clientConfig.getProductCode()));\n        form.add(new BasicNameValuePair(FinancingSdkConstants.MERCHANT_NUM, clientConfig.getMerchantNum()));\n        form.add(new BasicNameValuePair(FinancingSdkConstants.SYSTEM_CODE, clientConfig.getSystemCode()));\n        form.add(new BasicNameValuePair(FinancingSdkConstants.TRANSTYPE, FinancingSdkConstants.TRANSL_TYPE));\n        form.add(new BasicNameValuePair(FinancingSdkConstants.VERSION, FinancingSdkConstants.VERSION_02));\n        form.add(new BasicNameValuePair(FinancingSdkConstants.REQ_SEQ, clientConfig.getReqSeq()));\n        String reqTime = new SimpleDateFormat(\"yyyyMMddHHmmssSSS\")\n                .format(new Date(System.currentTimeMillis()));\n        form.add(new BasicNameValuePair(FinancingSdkConstants.REQ_TIME, reqTime));\n        form.add(new BasicNameValuePair(FinancingSdkConstants.TRANS_DATE, reqTime.substring(0, 8)));\n        form.add(new BasicNameValuePair(FinancingSdkConstants.TRANS_TIME, reqTime.substring(8, 17)));\n        form.add(new BasicNameValuePair(FinancingSdkConstants.CHARSET, FinancingSdkConstants.DEFAULT_CHARSET));\n\n        form.add(new BasicNameValuePair(FinancingSdkConstants.REMARK, clientConfig.getRemark()));\n        form.add(new BasicNameValuePair(FinancingSdkConstants.RESERVE, clientConfig.getReserve()));\n        form.add(new BasicNameValuePair(FinancingSdkConstants.RESERVE2, clientConfig.getReserve2()));\n\n        form.add(new BasicNameValuePair(FinancingSdkConstants.SGNTR, sgntr));\n        form.add(new BasicNameValuePair(FinancingSdkConstants.BODY, body));\n        return form;\n    }\n\n    /**\n     * 判断当前对象是否为JsonString\n     */\n    private static boolean isJsonString(Object body) {\n        if (body instanceof String) {\n            String str = (String) body;\n            str = str.trim();\n            if (str.startsWith(\"{\") && str.endsWith(\"}\")) {\n                return true;\n            } else {\n                return false;\n            }\n        } else {\n            return false;\n        }\n    }\n}\n\n",
