      "content": "package com.baidu.pmc.cmbc.core.utils.financing;\n\nimport com.baidu.pmc.cmbc.core.dto.financing.ClientConfig;\nimport com.baidu.pmc.cmbc.core.dto.financing.EcpSecurityResult;\nimport com.baidu.pmc.cmbc.core.dto.financing.RespHeader;\nimport com.baidu.pmc.cmbc.core.dto.financing.Response;\nimport com.google.gson.Gson;\nimport com.google.gson.GsonBuilder;\nimport lombok.extern.slf4j.Slf4j;\n\nimport java.util.Map;\n\n/**\n * 解析响应报文内容\n *\n * @author adt-huangyh\n */\n@Slf4j\npublic class ParserResponseHelper {\n    /**\n     * 解密和解析响应报文\n     *\n     * @param respStr      响应\n     * @param clientConfig\n     * @return\n     * @throws Exception\n     */\n    @SuppressWarnings(\"unchecked\")\n    public static Response parserTxResponse(String respStr, ClientConfig clientConfig)\n            throws Exception {\n        if (\"\".equals(respStr) || respStr == null) {\n            return null;\n        }\n\n        // 解析出响应报文头和报文体\n\n        Gson gson = new GsonBuilder().create();\n        Map<String, String> headMap = gson.fromJson(respStr, Map.class);\n        String body = null;\n        if (headMap != null) {\n            body = headMap.get(\"body\");\n        }\n        // 组装响应对象\n        RespHeader responseHeader = getResponseHeaderFromMap(headMap);\n        Response result = new Response();\n        result.setRespHeader(responseHeader);\n        Class<?> responseClass = clientConfig.getResponseClass();\n        if (body != null && !\"\".equals(body)) {\n            if (clientConfig.getResponseClass() == null) {\n                responseClass = Map.class;\n            }\n\n            // 根据配置是否进行安全处理\n            String bodyJson = body;\n            if (clientConfig.getSecuritySwitch()) {\n                log.debug(\"开始解密验签。密文：\" + body);\n                // 新增密文有效性检查\n                if (bodyJson == null || bodyJson.trim().isEmpty()) {\n                    throw new RuntimeException(\"密文为空\");\n                }\n                try {\n                    EcpSecurityResult sr = EcpSecurityUtil.decryptAndVerify(bodyJson, responseHeader.getSgntr(),\n                        clientConfig.getOwnSm2Path(), clientConfig.getOwnSm2Pwd(), clientConfig.getBankCertPath());\n                if (sr.getCipherText() != null && !\"\".equals(sr.getCipherText())) {\n                    log.info(\"解密成功。明文：\" + sr.getPlainText());\n                } else {\n                    String errMsg = \"解密失败\";\n                    log.error(errMsg);\n                    throw new RuntimeException(errMsg);\n                }\n                if (!sr.isVerifyPass()) {\n                    String errMsg = \"验签失败\";\n                    log.error(errMsg);\n                    throw new RuntimeException(errMsg);\n                } else {\n                    log.debug(\"验签成功\");\n                }\n                bodyJson = sr.getPlainText();\n            }\n\n            Object obody = gson.fromJson(bodyJson, responseClass);\n            result.setBody(obody);\n        }\n\n        return result;\n    }\n\n    /**\n     * 从参数Map中获取ResponseHeader\n     *\n     * @param headMap\n     * @return\n     * @function\n     */\n    private static RespHeader getResponseHeaderFromMap(\n            Map<String, String> headMap) {\n\n        RespHeader responseHeader = new RespHeader();\n        responseHeader.setTransCode(headMap.get(\"transCode\"));\n        responseHeader.setReqSeq(headMap.get(\"reqSeq\"));\n        responseHeader.setRespSeq(headMap.get(\"respSeq\"));\n        responseHeader.setMerchantNum(headMap.get(\"merchantNum\"));\n        responseHeader.setTxTime(headMap.get(\"txTime\"));\n        responseHeader.setRespDate(headMap.get(\"respDate\"));\n        responseHeader.setRespTime(headMap.get(\"respTime\"));\n        responseHeader.setRespStatus(headMap.get(\"respStatus\"));\n        responseHeader.setRespDesc(headMap.get(\"respDesc\"));\n        responseHeader.setRespCode(headMap.get(\"respCode\"));\n\n        responseHeader.setCharset(headMap.get(\"charset\"));\n\n        responseHeader.setRemark(headMap.get(\"remark\"));\n        responseHeader.setReserve(headMap.get(\"reserve\"));\n        responseHeader.setReserve2(headMap.get(\"reserve2\"));\n        responseHeader.setSgntr(headMap.get(\"sgntr\"));\n\n        return responseHeader;\n    }\n\n}\n",
