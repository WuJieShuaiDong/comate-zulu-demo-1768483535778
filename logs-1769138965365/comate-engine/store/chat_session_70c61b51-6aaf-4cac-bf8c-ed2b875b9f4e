     int length = split.length;\n                Element element = root;\n                List<Element> transInfoElements = new ArrayList<>();\n                List<TransInfo> transInfos = new ArrayList<>();\n                for (int i = 0; i < length; i++) {\n                    String s = split[i];\n                    if (i == length - 1) {\n                        transInfoElements = element.getChildren(s);\n                    } else {\n                        element = element.getChildren(s).get(0);\n                    }\n                }\n                // 动态映射流水字段\n                for (Element transInfoElement : transInfoElements) {\n                    TransInfo transInfo = new TransInfo();\n                    parseBodyCoomon(transInfo, transInfoElement, dto);\n                    String direction = transInfo.getDirection();\n                    String amtStr = transInfo.getTransAmount();\n                    if (StringUtils.isNotBlank(direction) && StringUtils.isNotBlank(amtStr)) {\n                        BigDecimal amt = new BigDecimal(amtStr);\n                        // 借贷\n                        if (StringUtils.equals(direction, Constants.DIRECTION_C)) {\n                            transInfo.setLoanMark(Constants.DIRECTION_C);\n                            transInfo.setLoanMarkName(Constants.DIRECTION_C_NAME);\n                            transInfo.setCreditAmount(String.valueOf(amt.abs()));\n                        } else if (StringUtils.equals(direction, Constants.DIRECTION_D)) {\n                            transInfo.setLoanMark(Constants.DIRECTION_D);\n                            transInfo.setLoanMarkName(Constants.DIRECTION_D_NAME);\n                            transInfo.setDebitAmount(String.valueOf(amt.abs()));\n                        }\n                    }\n\n                    // 交易日\n                    StringBuilder day = null;\n                    if (StringUtils.isNotBlank(transInfo.getDealDay())) {\n                        day =