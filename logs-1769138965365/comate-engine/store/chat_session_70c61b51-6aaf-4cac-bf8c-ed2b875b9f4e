      "content": "package com.baidu.pmc.bankcommon.core.service.impl;\n\nimport com.baidu.pmc.bankcommon.core.constants.Constants;\nimport com.baidu.pmc.bankcommon.core.service.PayChecksHisService;\nimport com.baidu.pmc.bankcommon.core.service.PayChecksService;\nimport com.baidu.pmc.bankcommon.core.service.PmcPayCommonBankColSetService;\nimport com.baidu.pmc.bankcommon.persistence.dao.PmcPayChecksMapper;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.pojo.constants.PayNode;\nimport com.baidu.pmc.pojo.constants.PayOperation;\nimport com.baidu.pmc.pojo.constants.PayStatus;\nimport com.baidu.pmc.pojo.dto.PayChecksDTO;\nimport com.baidu.pmc.pojo.model.PmcPayChecks;\nimport com.baidu.pmc.pojo.model.PmcPayChecksAuditHis;\nimport com.baidu.pmc.pojo.qo.PayChecksQO;\nimport com.github.pagehelper.PageHelper;\nimport lombok.extern.slf4j.Slf4j;\nimport org.springframework.beans.BeanUtils;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\nimport org.springframework.transaction.annotation.Isolation;\nimport org.springframework.transaction.annotation.Propagation;\nimport org.springframework.transaction.annotation.Transactional;\nimport org.springframework.util.CollectionUtils;\n\nimport java.util.List;\n\n@Slf4j\n@Service\npublic class PayChecksServiceImpl implements PayChecksService {\n\n    @Autowired\n    private PmcPayChecksMapper pmcPayChecksMapper;\n    @Autowired\n    private PayChecksHisService payChecksHisService;\n\n    @Autowired\n    private PmcPayCommonBankColSetService pmcPayCommonBankColSetService;\n    @Override\n    public List<PayChecksDTO> selectAllPayChecks(PayChecksQO payChecksQO) {\n        PageHelper.startPage(1, 10);\n        return pmcPayChecksMapper.selectAllPayChecks(payChecksQO);\n    }\n\n    @Override\n    public List<PayChecksDTO> genBankcommonUnUrgentPayList(String bankCode) {\n        PayChecksQO payChecksQO = new PayChecksQO();\n        payChecksQO.setStatus(PayStatus.PENDING_SENT.name());\n        payChecksQO.setHangupFlag(Constants.ENABLED_N);\n        payChecksQO.setBankCode(bankCode);\n        return pmcPayChecksMapper.selectAllPayChecks(payChecksQO);\n    }\n\n    @Override\n    @Transactional(propagation = Propagation.REQUIRED, isolation = Isolation.DEFAULT, timeout = 36000,\n            rollbackFor = Exception.class)\n    public int updateStatusBatch(List<Long> checkIds, String status) {\n        if (CollectionUtils.isEmpty(checkIds)) {\n            log.info(\"updateStatusBatch size={} status={}\", 0, status);\n            return 0;\n        }\n        log.info(\"updateStatusBatch size={} status={}\", checkIds.size(), status);\n        return pmcPayChecksMapper.updateStatusBatch(checkIds, status, Constants.SYSTEM_USER);\n    }\n\n    @Override\n    public List<PmcPayChecks> selectAllByCheckIds(List<Long> checkIds) {\n        return pmcPayChecksMapper.selectAllByCheckIds(checkIds);\n    }\n\n    @Override\n    public int updateByCheckNum(PmcPayChecks payChecks) {\n        return pmcPayChecksMapper.updateByCheckNum(payChecks);\n    }\n\n    @Override\n    public PmcPayChecks selectPayChecksByPayCheckNum(String payCheckNum) {\n        return pmcPayChecksMapper.selectByPayCheckNum(payCheckNum);\n    }\n\n    @Override\n    public PmcPayChecks findOne(Long checkId) {\n        return pmcPayChecksMapper.selectByCheckId(checkId);\n    }\n\n    @Override\n    public int updateByPk(PmcPayChecks payChecks) {\n        return pmcPayChecksMapper.updateByPk(payChecks);\n    }\n\n    @Override\n    @Transactional(propagation = Propagation.REQUIRED, isolation = Isolation.DEFAULT, timeout = 36000,\n            rollbackFor = Exception.class)\n    public int updatePayCheckAndHis(PmcPayChecks payCheck) {\n        // 更新付款单\n        pmcPayChecksMapper.updateByPk(payCheck);\n        // 付款单历史记录\n        PmcPayChecksAuditHis pmcPayChecksAuditHis = new PmcPayChecksAuditHis();\n        BeanUtils.copyProperties(payCheck, pmcPayChecksAuditHis);\n        pmcPayChecksAuditHis.setPayNode(PayNode.PAY_BANK_INTERFACES.name());\n        pmcPayChecksAuditHis.setOperationNote(payCheck.getFailureReasons());\n        pmcPayChecksAuditHis.setLastUpdateBy(Constants.SYSTEM_USER);\n        if (StringUtils.equals(PayStatus.SENDING.name(), payCheck.getStatus())) {\n            pmcPayChecksAuditHis.setPayOperation(PayOperation.SENDING_TO_INTERFACE.name());\n        }\n        if (StringUtils.equals(PayStatus.PAY_ORDER_GEN.name(), payCheck.getStatus())\n                || StringUtils.equals(PayStatus.FAILED_UNCOMFIRM.name(), payCheck.getStatus())) {\n            pmcPayChecksAuditHis.setPayOperation(PayOperation.PAY_ORDER_GENERATED.name());\n        }\n        if (StringUtils.equals(PayStatus.FAILED.name(), payCheck.getStatus())) {\n            pmcPayChecksAuditHis.setPayOperation(PayOperation.EPAYMENT_UPDATE_FAILED.name());\n        }\n        if (StringUtils.equals(PayStatus.VERITY_FAILED.name(), payCheck.getStatus())) {\n            pmcPayChecksAuditHis.setPayOperation(PayOperation.VERITY_FAILED.name());\n        }\n        return payChecksHisService.savePayChecksHis(pmcPayChecksAuditHis);\n    }\n\n}\n",
