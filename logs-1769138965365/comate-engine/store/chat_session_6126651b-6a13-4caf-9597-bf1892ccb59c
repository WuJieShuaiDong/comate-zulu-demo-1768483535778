            "new_string": "        return balanceInfos;\n    }\n\n    /**\n     * 从银行序列记录中解析可用余额\n     * <serial_record>\n     * 户名|账号|币种|余额|可用余额|开户日期|账户类型|开户行|错误信息|成功标志|\n     * XXX公司|310066661010121088868|CNY|85317882.08|85317882.08|19951117|1|310999||0|\n     * </serial_record>\n     * 获取余额字段对应的值,则需要对拼接格式进行拆分,获取第14个字段\n     * \n     * @param balanceInfo 余额信息对象\n     * @param serialRecord 银行序列记录字符串\n     */\n    private void parseAvailableBalanceFromSerialRecord(BalanceInfo balanceInfo, String serialRecord) {\n        if (StringUtils.isBlank(serialRecord)) {\n            log.warn(\"serialRecord为空，账号: {}\", balanceInfo.getAccount());\n            return;\n        }\n        String[] split1 = serialRecord.split(\"\\\\|\");\n        if (split1.length >= 14) {\n            try {\n                String balanceStr = split1[13].trim();\n                if (StringUtils.isNotBlank(balanceStr)) {\n                    balanceInfo.setAvailableBalance(String.valueOf(new BigDecimal(balanceStr)));\n                } else {\n                    log.warn(\"余额字段为空，账号: {}\", balanceInfo.getAccount());\n                }\n            } catch (NumberFormatException e) {\n                log.error(\"余额格式转换失败，账号: {}, 余额字符串: {}\", balanceInfo.getAccount(), split1[13], e);\n            }\n        } else {\n            log.warn(\"serialRecord格式不正确，字段数量不足14个，实际: {}，账号: {}\", split1.length, balanceInfo.getAccount());\n        }\n    }\n\n    @Override\n    public List<BalanceInfo> queryBalanceForCheck(List<PayQO> qos) {"
