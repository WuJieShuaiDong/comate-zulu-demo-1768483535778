tring, Object> dto, String bankCode) {\n        return \"\";\n    }\n\n    @Override\n    public String postMACHINE(String request, String hashValue, Long tenantId, String[] ipArr, String bankCode) {\n        // request = bcmSign(request);\n        String requestLength = StringUtils.leftPad(String.valueOf(request.length() + 6), 6, '0');\n        request = requestLength + request;\n        PmcCmbMachineDTO cmbMachineDTO = new PmcCmbMachineDTO();\n        cmbMachineDTO.setTenantId(tenantId);\n        cmbMachineDTO.setStatus(Constants.UP);\n        cmbMachineDTO.setMachineBank(bankCode);\n        List<PmcCmbMachine> pmcCmbMachines = machineService.selectMachine(cmbMachineDTO);\n        if (CollectionUtils.isEmpty(pmcCmbMachines)) {\n            log.error(\"无可用前置机 postMACHINE\");\n            // 无可用前置机\n            mailService.sendMachineFailedMail(\"无可用前置机\", new ArrayList<>(), \"\");\n            return Constants.NO_ENABLED_MACHINE;\n        }\n        pmcCmbMachines.forEach(detail -> log.info(\"可用前置机：\" + detail.getName() + \" \" + detail.getIp()));\n        log.info(\"租户：\" + tenantId);\n        // 一致性哈希算法 获取分配机器\n        Map<String, PmcCmbMachine> map = pmcCmbMachines.stream()\n                .collect(Collectors.toMap(PmcCmbMachine::getIp, Function.identity(), (k1, k2) -> k1));\n        String[] currentServers = map.keySet().toArray(new String[0]);\n        String server = new NodeDistributeUtil().getServer(hashValue, currentServers);\n        log.info(\"request server : \" + server);\n        PmcCmbMachine machine = map.get(server);\n        log.info(\"请求前置机ip地址: {}\", machine.getIp());\n        String[] ipPort;\n        if (server.split(\"//\").length != 2\n                || (ipPort = server.split(\"//\")[1].split(\":\")).length != 2) {\n            log.error(\"ip = {}, 格式不正确\", server);\n            return Constants.NO_ENABLED_MACHINE;\n        }\n        if (null != ipArr) {\n            ipArr[0] = ipPort[0];\n        }\n        try {\n            // 请求报文\n            log.info(\"请求报文 request={}\", request);\n            Example example = new Example(PmcPayCommonBankSet.class);\n            example.createCriteria().\n                    andEqualTo(\"bankCode\", bankCode)\n                    .andEqualTo(\"transferFlag\", Constants.ENABLED_Y);\n            List<PmcPayCommonBankSet> pmcPayCommonBankSets = pmcPayCommonBankSetMapper.selectByExample(example);\n            String requestType = Constants.RequestTypeEnum.XML;\n            if (CollectionUtils.isNotEmpty(pmcPayCommonBankSets)) {\n                requestType = pmcPayCommonBankSets.get(0).getRequestType();\n            }\n            String response = null;\n            if (Constants.RequestTypeEnum.XML.equals(requestType)) {\n                response = OkHttpUtils.sendHttpRequest(machine.getIp(), request);\n            } else {\n                response = OkHttpUtils.sendHttpRequestJson(machine.getIp(), request);\n            }\n            log.info(\"response :\" + response);\n            return response;\n            // return bcmVerifySign(response);\n        } catch (Exception e) {\n            log.error(\"网络出错，请检查网络！\", e);\n        }\n        return Constants.BANK_POST_EXCEPTION;\n    }\n\n\n    /**\n     * 请求前置机-文件下载\n     * @param request\n     * @return\n     */\n    public String postMACHINEFile(String request) {\n        // request = bcmSign(request);\n        String requestLength = StringUtils.leftPad(String.valueOf(request.length() + 6), 6, '0') ;\n        request = requestLength + request;\n        log.info(\"请求前置机ip地址: {}\", fileUrl);\n        try {\n            // 请求报文\n            log.info(\"请求报文 request={}\", request);\n            String response = OkHttpUtils.sendHttpRequestStream(fileUrl, request);\n            log.info(\"response :\" + response);\n            // 文件流特殊处理\n            String lengthString = response.substring(0, 6).trim();\n            Integer responseLength = Integer.valueOf(lengthString);\n            String responseInfo = response.substring(0, responseLength);\n            String fileStream = response.substring(responseLength);\n            String verifySignResponse = bcmVerifySign(responseInfo);\n            StringReader reader = new StringReader(verifySignResponse);\n            InputSource source = new InputSource(reader);\n            SafeXml safeXml = new SafeXml(SafeXml.Level.NONE);\n            SAXBuilder sax = safeXml.getSAXBuilder();\n            Document doc = sax.build(source);\n            Element rootElement = doc.getRootElement();\n            Element body = rootElement.getChild(\"body\");\n            // 将文件字节流流转成base64编码，存入body报文\n            byte[] pdfBytes = fileStream.getBytes(StandardCharsets.ISO_8859_1);\n            String base64String = Base64.getEncoder().encodeToString(pdfBytes);\n            Element fileContent = new Element(\"fileContent\");\n            fileContent.setText(base64String);\n            body.addContent(fileContent);\n            return generateXML(doc);\n        } catch (Exception e) {\n            log.error(\"网络出错，请检查网络！\", e);\n        }\n        return Constants.BANK_POST_EXCEPTION;\n    }\n\n    private String bcmSign(String request) {\n        log.info(\"bcmSign request before sign:\" + request);\n        try {\n            StringReader reader = new StringReader(request);\n            InputSource source = new InputSource(reader);\n            SafeXml safeXml = new SafeXml(SafeXml.Level.NONE);\n            SAXBuilder sax = safeXml.getSAXBuilder();\n            Document doc = sax.build(source);\n            Element rootElement = doc.getRootElement();\n            Element body = rootElement.getChild(\"body\");\n            Format format = Format.getPrettyFormat();\n            format.setExpandEmptyElements(true);\n            XMLOutputter outputter = new XMLOutputter(format);\n\n            String bodyString = outputter.outputString(body);\n            log.info(\"bodyString: \" + bodyString);\n            String signResult = OkHttpUtils.sendHttpRequestContentType(signUrl, bodyString, SpdbConstants.ContentType.SIGN);\n\n            Element signElement = parseRequestSign(signResult);\n            // 替换body元素\n            int index = rootElement.indexOf(body);\n            rootElement.removeContent(body);\n            rootElement.addContent(index, signElement.clone());\n            String signRequest = generateXML(doc);\n            log.info(\"bcmSign request after sign:\" + signRequest);\n            return signRequest;\n        }catch (Exception e) {\n            log.error(\"bcmSign request error\", e);\n            return \"\";\n        }\n    }\n\n    /**\n     * 拼装签名结果\n     * @param signResult\n     * @return\n     */\n    private Element parseRequestSign(String signResult) {\n        log.info(\"解析交通银行请求签名开始: {}\", signResult);\n        try {\n            StringReader reader = new StringReader(signResult);\n            InputSource source = new InputSource(reader);\n            SafeXml safeXml = new SafeXml(SafeXml.Level.NONE);\n            SAXBuilder sax = safeXml.getSAXBuilder();\n            Document doc = sax.build(source);\n            Element rootElement = doc.getRootElement();\n            String result = rootElement.getChild(\"head\").getChildTextTrim(\"result\");\n            if (\"0\".equals(result)) {\n                Element body = rootElement.getChild(\"body\");\n                body.getChild(\"sign\").setName(\"signature\");\n                return body;\n            } else {\n                return null;\n            }\n        }catch (Exception e) {\n            log.error(\"解析请求签名结果异常\", e);\n            return null;\n        }\n    }\n\n    private String bcmVerifySign(String response) {\n        log.info(\"bcmVerifySign response before sign:\" + response);\n        try {\n            StringReader reader = new StringReader(response.substring(6));\n            InputSource source = new InputSource(reader);\n            SafeXml safeXml = new SafeXml(SafeXml.Level.NONE);\n            SAXBuilder sax = safeXml.getSAXBuilder();\n            Document doc = sax.build(source);\n            Element rootElement = doc.getRootElement();\n            Element body = rootElement.getChild(\"body\");\n            String signature = body.getChildText(\"signature\");\n            // 失败情况无需校验签名，直接返回\n            if (StringUtils.isBlank(signature)){\n                return response.substring(6);\n            }\n            String signResult = OkHttpUtils.sendHttpRequestContentType(signUrl, signature, SpdbConstants.ContentType.VERIFY_SIGN);\n            Element signElement = parseResponseSign(signResult);\n            // 替换body元素\n            int index = rootElement.indexOf(body);\n            rootElement.removeContent(body);\n            rootElement.addContent(index, signElement.clone());\n            String signResponse = generateXML(doc);\n            log.info(\"bcmVerifySign response after sign:\" + signResponse);\n            return signResponse;\n        }catch (Exception e) {\n            log.error(\"bcmVerifySign request error\", e);\n            return \"\";\n        }\n    }\n\n    /**\n     * 解析响应签名\n     * @param signResult\n     * @return\n     */\n    private Element parseResponseSign(String signResult) {\n        log.info(\"解析交通银行响应签名开始: {}\", signResult);\n        try {\n            StringReader reader = new StringReader(signResult);\n            InputSource source = new InputSource(reader);\n            SafeXml safeXml = new SafeXml(SafeXml.Level.NONE);\n            SAXBuilder sax = safeXml.getSAXBuilder();\n            Document doc = sax.build(source);\n            Element rootElement = doc.getRootElement();\n            String result = rootElement.getChild(\"head\").getChildTextTrim(\"result\");\n            if (\"0\".equals(result)) {\n                Element body = rootElement.getChild(\"body\").getChild(\"sic\").getChild(\"body\");\n                return body;\n            } else {\n                return null;\n            }\n        }catch (Exception e) {\n            log.error(\"解析响应签名结果异常\", e);\n            return null;\n        }\n    }\n    /**\n     * 获取xml报文字符串\n     *\n     * @param document dom\n     * @return xml\n     */\n    private String generateXML(Document document) {\n        XMLOutputter xmlOutputter = new XMLOutputter();\n        Format format = Format.getPrettyFormat();\n        format.setExpandEmptyElements(true);\n        format.setEncoding(Constants.ENCODING_GBK);\n        xmlOutputter.setFormat(format);\n        return xmlOutputter.outputString(document);\n\n    }\n}\n",
