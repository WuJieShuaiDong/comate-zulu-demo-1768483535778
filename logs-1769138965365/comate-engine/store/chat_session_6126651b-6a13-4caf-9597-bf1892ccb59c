mockito.ArgumentMatchers.anyString;\nimport static org.mockito.ArgumentMatchers.eq;\nimport static org.mockito.Mockito.verify;\nimport static org.mockito.Mockito.when;\n\npublic class BcmBankStrategyTest extends AbstractServiceTest {\n\n    @Autowired\n    private BcmBankStrategy bcmBankStrategy;\n\n    @MockBean\n    private CommonBankStrategy commonBankStrategy;\n\n    @MockBean\n    private BankcommonService bankcommonService;\n\n    @MockBean\n    private BankcommonReceiptService bankcommonReceiptService;\n\n    @MockBean\n    private MachineService machineService;\n\n    @MockBean\n    private SendMailService mailService;\n\n    @MockBean\n    private PmcPayCommonBankSetMapper pmcPayCommonBankSetMapper;\n\n    @MockBean\n    private AccountService accountService;\n\n    @Test\n    public void testGetBankStrategy() {\n        // 测试银行策略代码返回\n        String result = bcmBankStrategy.getBankStrategy();\n        assertEquals(Constants.BankStrategyCode.BCM, result);\n    }\n\n    @Test\n    public void testGetPayInstructList() {\n        // 测试获取支付指令列表（委托给通用策略）\n        PayInstructQO qo = new PayInstructQO();\n        Page<PayInstructDTO> expectedPage = new Page<>();\n        when(commonBankStrategy.getPayInstructList(qo)).thenReturn(expectedPage);\n\n        Page<PayInstructDTO> result = bcmBankStrategy.getPayInstructList(qo);\n        assertEquals(expectedPage, result);\n        verify(commonBankStrategy).getPayInstructList(qo);\n    }\n\n    @Test\n    public void testGenBankUnUrgentPay() {\n        // 测试生成非紧急支付（委托给通用策略）\n        String bankCode = \"B033\";\n        Integer expectedResult = 10;\n        when(commonBankStrategy.genBankUnUrgentPay(bankCode)).thenReturn(expectedResult);\n\n        Integer result = bcmBankStrategy.genBankUnUrgentPay(bankCode);\n        assertEquals(expectedResult, result);\n        verify(commonBankStrategy).genBankUnUrgentPay(bankCode);\n    }\n\n    @Test\n    public void testSelectBankTrans() {\n        // 测试查询银行交易流水\n        PayQO qo = new PayQO();\n        qo.setBank(\"B033\");\n        qo.setAccount(\"123456789\");\n\n        Map<String, String> extentionParams = new HashMap<>();\n        extentionParams.put(\"beginNumber\", \"1\");\n\n        List<TransInfo> expectedTransInfos = new ArrayList<>();\n        TransInfo transInfo1 = new TransInfo();\n        transInfo1.setReferenceNumber(\"T123456789\");\n        expectedTransInfos.add(transInfo1);\n\n        when(bankcommonService.selectBankcommonTrans(eq(qo), eq(extentionParams))).thenReturn(expectedTransInfos);\n\n        List<TransInfo> result = bcmBankStrategy.selectBankTrans(qo);\n        assertNotNull(result);\n        assertEquals(1, result.size());\n        verify(bankcommonService).selectBankcommonTrans(eq(qo), eq(extentionParams));\n    }\n\n    @Test\n    public void testSelectBankTransWithNullReferenceNumber() {\n        // 测试查询银行交易流水（参考号为null的情况）\n        PayQO qo = new PayQO();\n        qo.setBank(\"B033\");\n        qo.setAccount(\"123456789\");\n\n        Map<String, String> extentionParams = new HashMap<>();\n        extentionParams.put(\"beginNumber\", \"1\");\n\n        List<TransInfo> expectedTransInfos = new ArrayList<>();\n        TransInfo transInfo1 = new TransInfo();\n        transInfo1.setReferenceNumber(null); // 测试null值处理\n        expectedTransInfos.add(transInfo1);\n\n        when(bankcommonService.selectBankcommonTrans(eq(qo), eq(extentionParams))).thenReturn(expectedTransInfos);\n\n        List<TransInfo> result = bcmBankStrategy.selectBankTrans(qo);\n        assertNotNull(result);\n        assertEquals(1, result.size());\n        assertNull(result.get(0).getReferenceNumber()); // 应该是null\n    }\n\n    @Test\n    public void testSelectBankBalance() {\n        // 测试查询银行余额\n        PayQO qo = new PayQO();\n        qo.setBank(\"B033\");\n        qo.setAccount(\"123456789\");\n\n        List<BalanceInfo> expectedBalanceInfos = new ArrayList<>();\n        BalanceInfo balanceInfo = new BalanceInfo();\n        balanceInfo.setAccount(\"123456789\");\n        balanceInfo.setBalance(new BigDecimal(\"1000.00\"));\n        expectedBalanceInfos.add(balanceInfo);\n\n        PmcAccount pmcAccount = new PmcAccount();\n        pmcAccount.setAccountName(\"测试账户\");\n\n        when(bankcommonService.selectBankcommonBalance(eq(qo), any())).thenReturn(expectedBalanceInfos);\n        when(accountService.queryBankcommonAccountByAccountNo(any(PayQO.class))).thenReturn(pmcAccount);\n\n        List<BalanceInfo> result = bcmBankStrategy.selectBankBalance(qo);\n        assertNotNull(result);\n        assertEquals(1, result.size());\n        assertEquals(\"测试账户\", result.get(0).getAnnotation());\n        verify(bankcommonService).selectBankcommonBalance(eq(qo), any());\n        verify(accountService).queryBankcommonAccountByAccountNo(any(PayQO.class));\n    }\n\n    @Test\n    public void testSelectBankBalanceWithException() {\n        // 测试查询银行余额（发生异常的情况）\n        PayQO qo = new PayQO();\n        qo.setBank(\"B033\");\n        qo.setAccount(\"123456789\");\n\n        List<BalanceInfo> expectedBalanceInfos = new ArrayList<>();\n        BalanceInfo balanceInfo = new BalanceInfo();\n        balanceInfo.setAccount(\"123456789\");\n        expectedBalanceInfos.add(balanceInfo);\n\n        when(bankcommonService.selectBankcommonBalance(eq(qo), any())).thenReturn(expectedBalanceInfos);\n        when(accountService.queryBankcommonAccountByAccountNo(any(PayQO.class))).thenThrow(new RuntimeException(\"数据库连接失败\"));\n\n        List<BalanceInfo> result = bcmBankStrategy.selectBankBalance(qo);\n        assertNotNull(result);\n        assertEquals(1, result.size());\n        assertNull(result.get(0).getAnnotation()); // 异常时annotation应该为null\n    }\n\n    @Test\n    public void testQueryBalanceForCheck() {\n        // 测试查询余额用于检查\n        List<PayQO> qos = Arrays.asList(new PayQO());\n        List<BalanceInfo> expectedBalanceInfos = new ArrayList<>();\n\n        when(bankcommonService.queryBankcommonBalanceForCheck(eq(qos), any())).thenReturn(expectedBalanceInfos);\n\n        List<BalanceInfo> result = bcmBankStrategy.queryBalanceForCheck(qos);\n        assertEquals(expectedBalanceInfos, result);\n        verify(bankcommonService).queryBankcommonBalanceForCheck(eq(qos), any());\n    }\n\n    @Test\n    public void testBankSuspectList() {\n        // 测试银行可疑交易列表\n        PayInstructQO qo = new PayInstructQO();\n        Page<PayInstructDTO> expectedPage = new Page<>();\n        when(commonBankStrategy.bankSuspectList(qo)).thenReturn(expectedPage);\n\n        Page<PayInstructDTO> result = bcmBankStrategy.bankSuspectList(qo);\n        assertEquals(expectedPage, result);\n        verify(commonBankStrategy).bankSuspectList(qo);\n    }\n\n    @Test\n    public void testBankAnalysisSuspect() {\n        // 测试银行可疑交易分析\n        PayInstructQO payInstructQO = new PayInstructQO();\n        String expectedResult = \"分析完成\";\n\n        Map<String, String> extentionParams = new HashMap<>();\n        extentionParams.put(\"beginDate\", DateUtils.formatDate(DateUtils.addDays(new Date(), -25), \"yyyyMMdd\"));\n\n        when(bankcommonService.bankcommonAnalysisSuspect(eq(payInstructQO), eq(extentionParams))).thenReturn(expectedResult);\n\n        String result = bcmBankStrategy.bankAnalysisSuspect(payInstructQO);\n        assertEquals(expectedResult, result);\n        verify(bankcommonService).bankcommonAnalysisSuspect(eq(payInstructQO), eq(extentionParams));\n    }\n\n    @Test\n    public void testUpdateInstruct() {\n        // 测试更新指令（委托给通用策略）\n        PayInstructQO payInstructQO = new PayInstructQO();\n        String expectedResult = \"更新成功\";\n        when(commonBankStrategy.updateInstruct(payInstructQO)).thenReturn(expectedResult);\n\n        String result = bcmBankStrategy.updateInstruct(payInstructQO);\n        assertEquals(expectedResult, result);\n        verify(commonBankStrategy).updateInstruct(payInstructQO);\n    }\n\n    @Test\n    public void testUpdateInstructFailedBatch() {\n        // 测试批量更新失败指令（委托给通用策略）\n        String bankCode = \"B033\";\n        List<Long> payIds = Arrays.asList(1L, 2L, 3L);\n\n        bcmBankStrategy.updateInstructFailedBatch(bankCode, payIds);\n\n        // 验证没有抛出异常\n        verify(commonBankStrategy).updateInstructFailedBatch(bankCode, payIds);\n    }\n\n    @Test\n    public void testBankDirectBankPay() {\n        // 测试银行直连支付\n        String bankCode = \"B033\";\n        int expectedResult = 5;\n        when(bankcommonService.bankcommonDirectBankPay(eq(bankCode), any())).thenReturn(expectedResult);\n\n        int result = bcmBankStrategy.bankDirectBankPay(bankCode);\n        assertEquals(expectedResult, result);\n        verify(bankcommonService).bankcommonDirectBankPay(eq(bankCode), any());\n    }\n\n    @Test\n    public void testQueryPayResult() {\n        // 测试查询支付结果\n        List<Map<String, Object>> instructs = new ArrayList<>();\n        Map<String, Object> instruct = new HashMap<>();\n        instruct.put(\"payCheckNum\", \"PC001\");\n        instructs.add(instruct);\n\n        String bankCode = \"B033\";\n\n        Map<String, String> extentionParams = new HashMap<>();\n        extentionParams.put(\"beginDate\", DateUtils.formatDate(DateUtils.addDays(new Date(), -25), \"yyyyMMdd\"));\n\n        List<Map<String, Object>> expectedResult = new ArrayList<>();\n        when(bankcommonService.queryPayResult(eq(instructs), eq(bankCode), eq(extentionParams))).thenReturn(expectedResult);\n\n        List<Map<String, Object>> result = bcmBankStrategy.queryPayResult(instructs, bankCode);\n        assertEquals(expectedResult, result);\n        verify(bankcommonService).queryPayResult(eq(instructs), eq(bankCode), eq(extentionParams));\n    }\n\n    @Test\n    public void testSelectElectReceipt() {\n        // 测试查询电子回单\n        PayQO payQO = new PayQO();\n        payQO.setBank(\"B033\");\n        String expectedResult = \"电子回单内容\";\n        when(bankcommonReceiptService.selectElectReceipt(eq(payQO), any())).thenReturn(expectedResult);\n\n        String result = bcmBankStrategy.selectElectReceipt(payQO);\n        assertEquals(expectedResult, result);\n        verify(bankcommonReceiptService).selectElectReceipt(eq(payQO), any());\n    }\n\n    @Test\n    public void testSelectBankcommonRefund() {\n        // 测试查询银行退款\n        PayQO payQO = new PayQO();\n        payQO.setBank(\"B033\");\n        String expectedResult = \"退款查询结果\";\n        when(bankcommonService.selectBankcommonRefund(eq(payQO), any())).thenReturn(expectedResult);\n\n        String result = bcmBankStrategy.selectBankcommonRefund(payQO);\n        assertEquals(expectedResult, result);\n        verify(bankcommonService).selectBankcommonRefund(eq(payQO), any());\n    }\n\n    @Test\n    public void testSelectBankBalanceOld() {\n        // 测试查询银行历史余额\n        BankcommonBalanceOldQO bankcommonBalanceOldQO = new BankcommonBalanceOldQO();\n        List<TmsAccountBalanceCmb> expectedResult = new ArrayList<>();\n        when(bankcommonService.selectBankcommonBalanceOld(eq(bankcommonBalanceOldQO), any())).thenReturn(expectedResult);\n\n        List<TmsAccountBalanceCmb> result = bcmBankStrategy.selectBankBalanceOld(bankcommonBalanceOldQO);\n        assertEquals(expectedResult, result);\n        verify(bankcommonService).selectBankcommonBalanceOld(eq(bankcommonBalanceOldQO), any());\n    }\n\n    @Test\n    public void testGenerateBankPayInstructs() {\n        // 测试生成银行支付指令\n        String bankCode = \"B033\";\n        List<PayChecksDTO> checks = new ArrayList<>();\n\n        PayChecksDTO check1 = new PayChecksDTO();\n        check1.setPayCheckNum(\"PC001\");\n        check1.setInterBankFlag(Constants.ENABLED_Y);\n        check1.setBeneficiaryTypeFlag(\"PERSONAL\");\n        check1.setAttribute3Name(\"招商银行\");\n        check1.setAttribute4(\"北京分行\");\n        check1.setAttribute5Name(\"北京市\");\n        check1.setAttribute6Name(\"海淀区\");\n        checks.add(check1);\n\n        List<Map<String, Object>> expectedInstructs = new ArrayList<>();\n        Map<String, Object> expectedInstruct = new HashMap<>();\n        expectedInstruct.put(\"trnUid\", \"TRN123456\");\n        expectedInstruct.put(\"interBankFlag\", Constants.ENABLED_Y);\n        expectedInstruct.put(\"payCheckNum\", \"PC001\");\n        expectedInstructs.add(expectedInstruct);\n\n        when(commonBankStrategy.generateBankPayInstructs(bankCode, checks)).thenReturn(expectedInstructs);\n\n        List<Map<String, Object>> result = bcmBankStrategy.generateBankPayInstructs(bankCode, checks);\n        assertNotNull(result);\n        assertEquals(1, result.size());\n        assertEquals(\"招商银行北京分行\", result.get(0).get(\"payeeBankName\"));\n        assertEquals(\"北京市海淀区\", result.get(0).get(\"payeeAddress\"));\n        assertEquals(\"B\", result.get(0).get(\"remitPurpose\"));\n    }\n\n    @Test\n    public void testGenerateBankPayInstructsWithInterBankFlagN() {\n        // 测试生成银行支付指令（行内标志为N）\n        String bankCode = \"B033\";\n        List<PayChecksDTO> checks = new ArrayList<>();\n\n        PayChecksDTO check1 = new PayChecksDTO();\n        check1.setPayCheckNum(\"PC001\");\n        check1.setInterBankFlag(Constants.ENABLED_N); // 行内标志为N\n        checks.add(check1);\n\n        List<Map<String, Object>> expectedInstructs = new ArrayList<>();\n        Map<String, Object> expectedInstruct = new HashMap<>();\n        expectedInstruct.put(\"trnUid\", \"TRN123456\");\n        expectedInstruct.put(\"interBankFlag\", Constants.ENABLED_N);\n        expectedInstruct.put(\"payCheckNum\", \"PC001\");\n        expectedInstructs.add(expectedInstruct);\n\n        when(commonBankStrategy.generateBankPayInstructs(bankCode, checks)).thenReturn(expectedInstructs);\n\n        List<Map<String, Object>> result = bcmBankStrategy.generateBankPayInstructs(bankCode, checks);\n        assertNotNull(result);\n        assertEquals(1, result.size());\n        assertEquals(\"\", result.get(0).get(\"payeeBanchNumber\")); // 应该为空字符串\n    }\n\n    @Test\n    public void testBankQueryPayResultJob() {\n        // 测试银行查询支付结果任务\n        String bankCode = \"B033\";\n        String expectedResult = \"查询完成\";\n\n        Map<String, String> extentionParams = new HashMap<>();\n        extentionParams.put(\"beginDate\", DateUtils.formatDate(DateUtils.addDays(new Date(), -25), \"yyyyMMdd\"));\n\n        when(bankcommonService.bankcommonQueryPayResultJob(eq(bankCode), eq(extentionParams))).thenReturn(expectedResult);\n\n        String result = bcmBankStrategy.bankQueryPayResultJob(bankCode);\n        assertEquals(expectedResult, result);\n        verify(bankcommonService).bankcommonQueryPayResultJob(eq(bankCode), eq(extentionParams));\n    }\n\n    @Test\n    public void testGetBankUnUrgentPayTask() {\n        // 测试获取非紧急支付任务\n        Integer result = bcmBankStrategy.getBankUnUrgentPayTask();\n        assertEquals(Integer.valueOf(0), result);\n    }\n\n    @Test\n    public void testBankUnUrgentPayTask() {\n        // 测试银行非紧急支付任务\n        Integer result = bcmBankStrategy.bankUnUrgentPayTask();\n        assertEquals(Integer.valueOf(0), result);\n    }\n\n    @Test\n    public void testBankQueryPayResultTask() {\n        // 测试银行查询支付结果任务\n        Integer result = bcmBankStrategy.bankQueryPayResultTask();\n        assertEquals(Integer.valueOf(0), result);\n    }\n\n    @Test\n    public void testSelectBankElectReceiptTask() {\n        // 测试选择银行电子回单任务\n        Integer result = bcmBankStrategy.selectBankElectReceiptTask();\n        assertEquals(Integer.valueOf(0), result);\n    }\n\n    @Test\n    public void testVerityReceiveAllFieldsValid() {\n        // 测试验证收款方信息（所有字段都有效）\n        PayChecksDTO payChecksDTO = new PayChecksDTO();\n        payChecksDTO.setAttributeCategory(Constants.WIRE_CN);\n        payChecksDTO.setAttribute1(\"收款人名称\");\n        payChecksDTO.setAttribute2(\"123456789012345678901234567890\");\n        payChecksDTO.setAttribute3(\"B033\");\n        payChecksDTO.setAttribute3Name(\"交通银行\");\n        payChecksDTO.setAttribute4(\"北京分行\