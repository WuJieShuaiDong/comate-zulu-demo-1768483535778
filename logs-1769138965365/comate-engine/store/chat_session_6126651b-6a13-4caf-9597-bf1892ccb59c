      "content": "package com.baidu.pmc.bankcommon.core.service.strategy;\n\nimport com.baidu.pmc.bankcommon.core.base.AbstractServiceTest;\nimport com.baidu.pmc.bankcommon.core.constants.Constants;\nimport com.baidu.pmc.bankcommon.core.service.AccountService;\nimport com.baidu.pmc.bankcommon.core.service.BankcommonReceiptService;\nimport com.baidu.pmc.bankcommon.core.service.BankcommonService;\nimport com.baidu.pmc.bankcommon.core.service.MachineService;\nimport com.baidu.pmc.bankcommon.core.service.impl.SendMailService;\nimport com.baidu.pmc.bankcommon.persistence.dao.PmcPayCommonBankSetMapper;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.pojo.dto.PayChecksDTO;\nimport com.baidu.pmc.pojo.dto.cmb.BalanceInfo;\nimport com.baidu.pmc.pojo.dto.cmb.PayInstructDTO;\nimport com.baidu.pmc.pojo.dto.cmb.PmcCmbMachine;\nimport com.baidu.pmc.pojo.dto.cmb.PmcCmbMachineDTO;\nimport com.baidu.pmc.pojo.dto.cmb.TmsAccountBalanceCmb;\nimport com.baidu.pmc.pojo.dto.cmb.TransInfo;\nimport com.baidu.pmc.pojo.model.PmcAccount;\nimport com.baidu.pmc.pojo.model.PmcPayChecks;\nimport com.baidu.pmc.pojo.model.PmcPayCommonBankSet;\nimport com.baidu.pmc.pojo.model.cmb.PayQO;\nimport com.baidu.pmc.pojo.qo.BankcommonBalanceOldQO;\nimport com.baidu.pmc.pojo.qo.cmb.PayInstructQO;\nimport com.github.pagehelper.Page;\nimport org.junit.Test;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.boot.test.mock.mockito.MockBean;\n\nimport java.math.BigDecimal;\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\nimport static org.junit.Assert.assertEquals;\nimport static org.junit.Assert.assertNotNull;\nimport static org.junit.Assert.assertNull;\nimport static org.junit.Assert.assertTrue;\nimport static org.mockito.ArgumentMatchers.any;\nimport static org.mockito.ArgumentMatchers.anyMap;\nimport static org.mockito.ArgumentMatchers.anyString;\nimport static org.mockito.ArgumentMatchers.eq;\nimport static org.mockito.Mockito.verify;\nimport static org.mockito.Mockito.when;\n\npublic class BcmBankStrategyTest extends AbstractServiceTest {\n\n    @Autowired\n    private BcmBankStrategy bcmBankStrategy;\n\n    @MockBean\n    private CommonBankStrategy commonBankStrategy;\n\n    @MockBean\n    private BankcommonService bankcommonService;\n\n    @MockBean\n    private BankcommonReceiptService bankcommonReceiptService;\n\n    @MockBean\n    private MachineService machineService;\n\n    @MockBean\n    private SendMailService mailService;\n\n    @MockBean\n    private PmcPayCommonBankSetMapper pmcPayCommonBankSetMapper;\n\n    @MockBean\n    private AccountService accountService;\n\n    @Test\n    public void testGetBankStrategy() {\n        // 测试银行策略代码返回\n        String result = bcmBankStrategy.getBankStrategy();\n        assertEquals(Constants.BankStrategyCode.BCM, result);\n    }\n\n    @Test\n    public void testGetPayInstructList() {\n        // 测试获取支付指令列表（委托给通用策略）\n        PayInstructQO qo = new PayInstructQO();\n        Page<PayInstructDTO> expectedPage = new Page<>();\n        when(commonBankStrategy.getPayInstructList(qo)).thenReturn(expectedPage);\n\n        Page<PayInstructDTO> result = bcmBankStrategy.getPayInstructList(qo);\n        assertEquals(expectedPage, result);\n        verify(commonBankStrategy).getPayInstructList(qo);\n    }\n\n    @Test\n    public void testGenBankUnUrgentPay() {\n        // 测试生成非紧急支付（委托给通用策略）\n        String bankCode = \"B033\";\n        Integer expectedResult = 10;\n        when(commonBankStrategy.genBankUnUrgentPay(bankCode)).thenReturn(expectedResult);\n\n        Integer result = bcmBankStrategy.genBankUnUrgentPay(bankCode);\n        assertEquals(expectedResult, result);\n        verify(commonBankStrategy).genBankUnUrgentPay(bankCode);\n    }\n\n    @Test\n    public void testSelectBankTrans() {\n        // 测试查询银行交易流水\n        PayQO qo = new PayQO();\n        qo.setBank(\"B033\");\n        qo.setAccount(\"123456789\");\n\n        Map<String, String> extentionParams = new HashMap<>();\n        extentionParams.put(\"beginNumber\", \"1\");\n\n        List<TransInfo> expectedTransInfos = new ArrayList<>();\n        TransInfo transInfo1 = new TransInfo();\n        transInfo1.setReferenceNumber(\"T123456789\");\n        expectedTransInfos.add(transInfo1);\n\n        when(bankcommonService.selectBankcommonTrans(eq(qo), eq(extentionParams))).thenReturn(expectedTransInfos);\n\n        List<TransInfo> result = bcmBankStrategy.selectBankTrans(qo);\n        assertNotNull(result);\n        assertEquals(1, result.size());\n        verify(bankcommonService).selectBankcommonTrans(eq(qo), eq(extentionParams));\n    }\n\n    @Test\n    public void testSelectBankTransWithNullReferenceNumber() {\n        // 测试查询银行交易流水（参考号为null的情况）\n        PayQO qo = new PayQO();\n        qo.setBank(\"B033\");\n        qo.setAccount(\"123456789\");\n\n        Map<String, String> extentionParams = new HashMap<>();\n        extentionParams.put(\"beginNumber\", \"1\");\n\n        List<TransInfo> expectedTransInfos = new ArrayList<>();\n        TransInfo transInfo1 = new TransInfo();\n        transInfo1.setReferenceNumber(null); // 测试null值处理\n        expectedTransInfos.add(transInfo1);\n\n        when(bankcommonService.selectBankcommonTrans(eq(qo), eq(extentionParams))).thenReturn(expectedTransInfos);\n\n        List<TransInfo> result = bcmBankStrategy.selectBankTrans(qo);\n        assertNotNull(result);\n        assertEquals(1, result.size());\n        assertNull(result.get(0).getReferenceNumber()); // 应该是null\n    }\n\n    @Test\n    public void testSelectBankBalance() {\n        // 测试查询银行余额\n        PayQO qo = new PayQO();\n        qo.setBank(\"B033\");\n        qo.setAccount(\"123456789\");\n\n        List<BalanceInfo> expectedBalanceInfos = new ArrayList<>();\n        BalanceInfo balanceInfo = new BalanceInfo();\n        balanceInfo.setAcco