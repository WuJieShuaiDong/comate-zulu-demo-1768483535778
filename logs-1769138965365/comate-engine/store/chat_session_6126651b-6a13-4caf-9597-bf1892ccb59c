 payQO\n     * @return\n     */\n    String selectBankcommonRefund(PayQO payQO);\n\n    /**\n     * 查询银行历史余额\n     *\n     * @param bankcommonBalanceOldQO 查询条件对象\n     * @return 银行余额列表\n     * @throws Exception 加密密码时可能抛出的异常\n     */\n    List<TmsAccountBalanceCmb> selectBankBalanceOld(BankcommonBalanceOldQO bankcommonBalanceOldQO);\n\n    /**\n     * 按照支付单生成支付指令\n     *\n     * @param bankCode\n     * @param checks\n     * @return\n     */\n    List<Map<String, Object>> generateBankPayInstructs(String bankCode, List<PayChecksDTO> checks);\n\n\n    /**\n     * 支付结果查询任务--调用queryPayResult进行查询\n     *\n     * @return\n     */\n    String bankQueryPayResultJob(String bankCode);\n\n\n    /**\n     * 定时任务-生成未紧急支付的指令\n     */\n    Integer getBankUnUrgentPayTask();\n\n    /**\n     * 定时任务-对公付款后台任务\n     */\n    Integer bankUnUrgentPayTask();\n\n\n    /**\n     * 定时任务 - 支付结果查询\n     */\n    Integer bankQueryPayResultTask();\n\n    /**\n     * 定时任务 - 电子回单查询\n     */\n    Integer selectBankElectReceiptTask();\n\n    /**\n     * 校验指令-收款方\n     */\n    String verityReceive(PayChecksDTO payChecksDTO, PmcPayChecks payCheck, String bankCode);\n\n    /**\n     * 校验指令-付款方\n     */\n    String verityPay(List<String> bankCodes, PayChecksDTO payChecksDTO, PmcPayChecks payCheck, String bankCode);\n\n    /**\n     * 请求HTTP ，不同银行HTTP请求方式报文各不同，个性化扩展\n     */\n    String postBankHttp(String request, String uri, Map<String, Object> dto, String bankCode);\n\n    /**\n     * 请求前置机，不同银行前置机请求方式报文各不同，个性化扩展\n     */\n    String postMACHINE(String request, String hashValue, Long tenantId, String[] ipArr, String bankCode);\n    /**\n     * 指令字段转换\n     *\n     * @param payInstructs\n     */\n    default void translateInstruct(PayInstructDTO payInstructs) {\n        payInstructs.setCurrencyName(payInstructs.getAmountCurrencyName());\n        payInstructs.setPayeeBankName(payInstructs.getPayeeBank());\n        payInstructs.setPayeeProvName(payInstructs.getPayeeProv());\n        payInstructs.setPayeeCity