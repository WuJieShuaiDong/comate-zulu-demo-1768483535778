st={}\", request);\n            Example example = new Example(PmcPayCommonBankSet.class);\n            example.createCriteria().\n                    andEqualTo(\"bankCode\", bankCode)\n                    .andEqualTo(\"transferFlag\", Constants.ENABLED_Y);\n            List<PmcPayCommonBankSet> pmcPayCommonBankSets = pmcPayCommonBankSetMapper.selectByExample(example);\n            String requestType = Constants.RequestTypeEnum.XML;\n            if (CollectionUtils.isNotEmpty(pmcPayCommonBankSets)) {\n                requestType = pmcPayCommonBankSets.get(0).getRequestType();\n            }\n            String response = null;\n            if (Constants.RequestTypeEnum.XML.equals(requestType)) {\n                response = OkHttpUtils.sendHttpRequest(machine.getIp(), request);\n            } else {\n                response = OkHttpUtils.sendHttpRequestJson(machine.getIp(), request);\n            }\n            log.info(\"response :\" + response);\n            return response;\n            // return bcmVerifySign(response);\n        } catch (Exception e) {\n            log.error(\"网络出错，请检查网络！\", e);\n        }\n        return Constants.BANK_POST_EXCEPTION;\n    }\n}\n",
