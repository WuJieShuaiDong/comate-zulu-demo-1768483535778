tAttribute3())) {\n            failedStringBuilder.append(\"收款账号开户行为空！ \");\n        }\n        // 收款方值集翻译失败\n        if (StringUtils.isBlank(payChecksDTO.getAttribute3Name())) {\n            failedStringBuilder.append(\"银行code:\").append(payChecksDTO.getAttribute3()).append(\"值集翻译失败\");\n        }\n\n        if (StringUtils.isBlank(payChecksDTO.getAttribute4())) {\n            failedStringBuilder.append(\"收款账号开户行支行为空！ \");\n        } else {\n            String bankBranch = payChecksDTO.getAttribute3Name() + payChecksDTO.getAttribute4();\n            if (bankBranch.length() > 100) {\n                failedStringBuilder.append(\"收款人开户行+开户支行名称长度大于100！\");\n            }\n        }\n        // 跨行对联行号进行校验，同行不校验\n        if (!StringUtils.equals(payChecksDTO.getAttribute3(), payChecksDTO.getBankCode())) {\n            // 鉴于银行名称不准确，因此采用收款行联行号非空形式，长度小于等于12\n            if (StringUtils.isBlank(payChecksDTO.getAttribute7())) {\n                failedStringBuilder.append(\"收款行联行号为空！\");\n            } else if (StringUtils.length(payChecksDTO.getAttribute7()) != 5\n                    && StringUtils.length(payChecksDTO.getAttribute7()) != 12) {\n                failedStringBuilder.append(\"收款行联行号长度为5位或12位！\");\n            }\n        }\n        if (StringUtils.isNotBlank(payChecksDTO.getRemark())\n                && StringUtils.length(payChecksDTO.getRemark()) > 60) {\n            failedStringBuilder.append(\"用途字段长度大于60！\");\n        } else if (StringUtils.isNotBlank(payChecksDTO.getRemark())\n                && payChecksDTO.getRemark().contains(\"|\")) {\n            failedStringBuilder.append(\"用途字段格式错误！\");\n        }\n\n        payCheck.setFailureReasons(failedStringBuilder.toString());\n        return payCheck.getFailureReasons();\n    }\n\n    @Override\n    public String verityPay(List<String> bankCodes, PayChecksDTO payChecksDTO, PmcPayChecks payCheck, String bankCode) {\n\n        StringBuilder verityFailedStringBuilder = new StringBuilder();\n        // 付款方信息校验\n     