ute1(Y);\n        }\n        if (header.getAccountHeaderId() == null) {\n            header.setCreationDate(new Date());\n            header.setCreatedBy(SessionUtils.getSessionUser().getUsername());\n            loanAccountHeaderDAO.insert(header);\n        } else {\n            loanAccountHeaderDAO.updateByPrimaryKey(header);\n        }\n        return header;\n    }\n\n    public TmsLoanAccountHeader saveLoanAccountHeader(LoanAccount la, BigDecimal accounted, Boolean isChange,\n                                                      String saveType) {\n        TmsLoanAccountHeader header = new TmsLoanAccountHeader();\n\n        if (StringUtils.isNotBlank(la.getAttribute3())) {\n            header = loanAccountHeaderDAO.selectByPrimaryKey(Long.valueOf(la.getAttribute3()));\n            if (header.getAccountHeaderId() == null) {\n                throw new ServiceException(\"未找到事件编号为：\" + la.getEventNumber() +\n                        \"头ID为：\" + la.getAttribute3() + \"的头信息\");\n            }\n        }\n        if (LoanConstants.DEAL_ACCRUAL.equals(saveType) || LoanConstants.COMPANY_ACCRUAL.equals(saveType)) {\n            header.setTrxCategory(la.getProcessType());\n        } else {\n            header.setTrxCategory(la.getTrxCategory());\n        }\n        if (LoanConstants.BILL_CATEGORY_NOTEREC.equals(saveType)) {\n            TmsBillManagement bill = tmsBillManagementDAO.selectByPrimaryKey(la.getSourceId());\n            header.setBgCode(bill.getBgCode());\n        }\n        header.setTrxType(la.getTrxType());\n        header.setAccountType(la.getAccountType());\n        header.setEventType(la.getEventType());\n        header.setAccrualId(la.getAccrualId()); // 兼容计提记账\n        header.setEventId(la.getEventId());\n        header.setSelId(la.getSelId());\n        header.setSourceId(la.getSourceId());\n        header.setRequestNumber(la.getRequestNumber());\n        header.setEventNumber(la.getEventNumber());\n        header.setSegment1(la.getSegment1());\n       