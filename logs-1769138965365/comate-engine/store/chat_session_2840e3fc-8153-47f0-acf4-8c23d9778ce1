          }\n        } else {\n            throw new ServiceException(\"计提类型错误\");\n        }\n        account.setEntered(rule.getEntered());\n        account.setAccounted(rule.getEntered());\n        if (LoanConstants.LOAN_GL_DIRECTION_CR.equals(direction)) {\n            account.setAccountedCr(rule.getEntered());\n        } else {\n            account.setAccountedDr(rule.getEntered());\n        }\n\n        account.setExchangeRate(BigDecimal.ONE);\n        account.setExchangeRateStr(BigDecimal.ONE.stripTrailingZeros().toPlainString());\n\n        // 默认值\n        if (StringUtils.isBlank(rule.getSegment2())) {\n            account.setSegment2(\"0\");\n        }\n        if (StringUtils.isBlank(rule.getSegment4())) {\n            account.setSegment4(\"000\");\n        }\n//        if (StringUtils.isBlank(rule.getSegment5())) {\n//            account.setSegment5(\"00\");\n//        }\n        if (StringUtils.isBlank(rule.getSegment6())) {\n            account.setSegment6(\"0\");\n        }\n        if (StringUtils.isBlank(rule.getSegment7())) {\n            account.setSegment7(\"0\");\n        }\n        if (StringUtils.isBlank(rule.getSegment8())) {\n            account.setSegment8(\"0\");\n        }\n        return account;\n    }\n\n    /**\n     * 公司间借款--计提利息--获取分录明细数据：2-生成借方和贷方分录\n     *\n     * @param rule\n     * @param direction\n     * @return\n     */\n    private LoanAccount getAccrualAccounts(LoanAccount rule, String direction, Date accountingDate) {\n        LoanAccount account = new LoanAccount();\n        BeanUtils.copyProperties(rule, account);\n        account.setDirection(direction);\n        account.setSegment1(rule.getCompanyCode());\n        account.setAccountingDate(accountingDate);\n        account.setTrxCategory(INTERCOMPANY_INTEREST_ACCRUAL);\n        account.setAccountType(LoanConstants.LOAN_ACCOUNT_TYPE_ACCT); // 计提记账(公司间借款计提)\n\n        if (LoanConstants.LOAN_GL_DIRECTION_DR.equals(direction)) {\n            account.setSegment3(rule.getDrSegment3());\n        } else if (LoanConstants.LOAN_GL_DIRECTION_CR.equals(direction)) {\n            account.setSegment3(rule.getCrSegment3());\n        }\n\n        // 如果属于集团内公司间借款，借贷科目的内往段取交易对手公司段，税科目内往段为0（默认值），如果属于外部借贷，所有科目的内往段都为0（默认值）\n        if (LoanConstants.CUNTERPARTY_TYPE_COMPANY.equals(rule.getCounterpartyType())) {\n            account.setSegment5(StringUtils.isNotBlank(rule.getCounterpartyCode()) ?\n                    rule.getCounterpartyCode() : \"00\");\n        } else {\n            account.setSegment5(\"00\");\n        }\n\n        account.setExchangeRate(BigDecimal.ONE);\n        account.setExchangeRateStr(BigDecimal.ONE.stripTrailingZeros().toPlainString());\n\n        // 默认值\n        account.setSegment2(\"0\");\n        account.setSegment4(\"000\");\n        account.setSegment6(\"0\");\n        account.setSegment7(\"0\");\n        account.setSegment8(\"0\");\n        return account;\n    }\n\n    /**\n     * 公允价值重估入账--获取分录明细数据：生成借方和贷方分录\n     *\n     * @param rule\n     * @param direction\n     * @return\n     */\n    private LoanAccount getIfrsFairvalueAccounts(LoanAccount rule, String direction, Date accountingDate) {\n        LoanAccount account = new LoanAccount();\n        BeanUtils.copyProperties(rule, account);\n        account.setDirection(direction);\n        account.setAccountingDate(accountingDate);\n        account.setTrxCategory(DEAL_IFRS_FAIRVALUE);\n        account.setEventType(LoanConstants.TMS_DEAL_ACCEVENTTYPE_A05);\n        if (rule.getExchangeRate() != null) {\n            account.setAccounted(account.getEntered().multiply(rule.getExchangeRate()).setScale(2,\n                    BigDecimal.ROUND_HALF_UP));\n        } else {\n            account.setAccounted(account.getEntered().multiply(BigDecimal.ONE));\n        }\n        if (LoanConstants.LOAN_GL_DIRECTION_DR.equals(direction)) {\n            account.setSegment3(rule.getIfrsDrSegment3());\n            account.setAccountedDr(account.getAccounted().abs());\n        } else if (LoanConstants.LOAN_GL_DIRECTION_CR.equals(direction)) {\n            account.setSegment3(rule.getIfrsCrSegment3());\n            account.setAccountedCr(account.getAccounted().abs());\n        }\n        if (rule.getExchangeRate() == null) {\n            account.setExchangeRate(BigDecimal.ONE);\n        }\n        if (StringUtils.isBlank(rule.getExchangeRateStr())) {\n            account.setExchangeRateStr(BigDecimal.ONE.stripTrailingZeros().toPlainString());\n        }\n        account.setNaryur(account.getTrxTypeName() + SYMBOL + account.getRequestNumber());\n        // 默认值\n        account.setSegment2(\"0\");\n        account.setSegment4(\"000\");\n        account.setSegment5(\"00\");\n        account.setSegment6(\"0\");\n        account.setSegment7(\"0\");\n        account.setSegment8(\"0\");\n        return account;\n    }\n\n    /**\n     * 公司间借款--计提利息--获取分录明细数据：3-生成增值税行分录\n     *\n     * @param laa\n     * @param debit\n     * @param credit\n     * @return\n     */\n    private LoanAccount getTaxAccount(LoanAccount laa, LoanAccount debit, LoanAccount credit, Date accountingDate) {\n\n        LoanAccount tax = new LoanAccount();\n        BeanUtils.copyProperties(laa, tax);\n        tax.setSegment1(laa.getCompanyCode());\n        tax.setSegment3(laa.getTaxSegment3());\n        tax.setAccountingDate(accountingDate);\n        tax.setTrxCategory(INTERCOMPANY_INTEREST_ACCRUAL);\n        tax.setAccountType(LoanConstants.LOAN_ACCOUNT_TYPE_ACCT); // 计提记账(公司间借款计提)\n\n        tax.setExchangeRate(BigDecimal.ONE);\n        tax.setExchangeRateStr(BigDecimal.ONE.stripTrailingZeros().toPlainString());\n\n        // 计提应收\n        // 借方科目金额:原币金额取计提时计算出的计提利息金额;本位币金额=计提利息金额*货币对汇率\n        // 贷方税科目金额生成:金额=计提利息金额*增值税税率/(1+增值税税率)；本位币金额=原币金额*货币对汇率\n        // 贷方科目金额生成:不含税计提利息金额=计提利息金额-不含税额;本位币金额=计提利息金额*货币对汇率-税行本位币金额\n        if (StringUtils.equals(LoanConstants.TMS_DEAL_ACCEVENTTYPE_A03, laa.getEventType())) {\n            // 20251020 公司间借款计提利息，增值税率取交易对手档案中交易对手对应的公司主体维护的税率\n            TmsLoanCompanyRule rule = loanCompanyRuleService.getCompanyRuleByTaxType(\n                    LoanConstants.LOAN_ACCOUNT_COMPANY_RULE_TYPE_VAT, laa.getCounterpartyCode());\n            if (Objects.isNull(rule) || Objects.isNull(rule.getTaxRate())) {\n                return null;\n            }\n            tax.setDirection(LoanConstants.LOAN_GL_DIRECTION_CR);\n            BigDecimal bg = new BigDecimal(1);\n            bg = bg.add(rule.getTaxRate());\n            BigDecimal entered = laa.getEntered().divide(bg, 2, BigDecimal.ROUND_HALF_UP).\n                    multiply(rule.getTaxRate()).setScale(2, BigDecimal.ROUND_HALF_UP);\n            if (BigDecimal.ZERO.compareTo(entered) == 0) {\n                return null;\n            }\n            tax.setEntered(entered);\n            // 贷方金额=A-税\n            credit.setEntered(credit.getEntered().subtract(tax.getEntered()));\n\n        } else if (StringUtils.equals(LoanConstants.TMS_DEAL_ACCEVENTTYPE_A01, laa.getEventType())) {\n            // 计提应付\n            // 所得税 借方:交易对手档案中交易对手对应的公司主体维护的税率\n            TmsLoanCompanyRule rule = loanCompanyRuleService.getCompanyRuleByTaxType(\n                    LoanConstants.LOAN_ACCOUNT_COMPANY_RULE_TYPE_VAT, laa.getCounterpartyCode());\n            if (Objects.isNull(rule) || Objects.isNull(rule.getTaxRate())) {\n                return null;\n            }\n            tax.setDirection(LoanConstants.LOAN_GL_DIRECTION_DR);\n            BigDecimal bg = new BigDecimal(1);\n            bg = bg.add(rule.getTaxRate());\n            BigDecimal entered = laa.getEntered().divide(bg, 2, BigDecimal.ROUND_HALF_UP)\n                    .multiply(rule.getTaxRate()).setScale(2, BigDecimal.ROUND_HALF_UP);\n            if (BigDecimal.ZERO.compareTo(entered) == 0) {\n                return null;\n            }\n            tax.setEntered(entered);\n            debit.setEntered(debit.getEntered().subtract(entered));\n        }\n\n        // 默认值\n        tax.setSegment2(\"0\");\n        tax.setSegment4(\"000\");\n        tax.setSegment5(\"00\");\n        tax.setSegment6(\"0\");\n        tax.setSegment7(\"0\");\n        tax.setSegment8(\"0\");\n        return tax;\n    }\n\n    /**\n     * 公司间借款--计提利息--获取分录明细数据：4-处理汇率&本位币金额\n     *\n     * @param debit\n     * @param credit\n     * @param tax\n     */\n    private void handleExchangeRate(LoanAccount debit, LoanAccount credit, LoanAccount tax) {\n        TmsExchangeRate rate = null;\n        Boolean rateFlag = StringUtils.equals(debit.getTrxCurrencyCode(), debit.getLedgerCurrencyCode());\n        if (!rateFlag) {\n            rate = this.selectExchangeRate(debit.getTrxCurrencyCode(), debit.getLedgerCurrencyCode(),\n                    debit.getAccountingDate());\n        }\n\n        if (StringUtils.equals(LoanConstants.TMS_DEAL_ACCEVENTTYPE_A03, debit.getEventType())) {\n            if (!rateFlag && !Objects.isNull(rate) && !Objects.isNull(rate.getRate())) {\n                debit.setAccounted(debit.getEntered().multiply(rate.getRate()).setScale(2, BigDecimal.ROUND_HALF_UP));\n                debit.setExchangeRate(rate.getRate());\n                debit.setExchangeRateStr(rate.getRate().stripTrailingZeros().toPlainString());\n                credit.setExchangeRate(rate.getRate());\n                credit.setExchangeRateStr(rate.getRate().stripTrailingZeros().toPlainString());\n                if (Objects.isNull(tax)) {\n                    credit.setAccounted(credit.getEntered().multiply(rate.getRate()).setScale(2,\n                            BigDecimal.ROUND_HALF_UP));\n\n                } else {\n                    tax.setAccounted(tax.getEntered().multiply(rate.getRate()).setScale(2, BigDecimal.ROUND_HALF_UP));\n                    credit.setAccounted(debit.getAccounted().subtract(tax.getAccounted()));\n                    tax.setExchangeRate(rate.getRate());\n                    tax.setExchangeRateStr(rate.getRate().stripTrailingZeros().toPlainString());\n                }\n            } else {\n                debit.setAccounted(debit.getEntered());\n                credit.setAccounted(credit.getEntered());\n                debit.setExchangeRate(BigDecimal.ONE);\n                debit.setExchangeRateStr(BigDecimal.ONE.stripTrailingZeros().toPlainString());\n                credit.setExchangeRate(BigDecimal.ONE);\n                credit.setExchangeRateStr(BigDecimal.ONE.stripTrailingZeros().toPlainString());\n                if (Objects.nonNull(tax)) {\n                    tax.setAccounted(tax.getEntered());\n                    tax.setExchangeRate(BigDecimal.ONE);\n                    tax.setExchangeRateStr(BigDecimal.ONE.stripTrailingZeros().toPlainString());\n                }\n\n            }\n        } else if (StringUtils.equals(LoanConstants.TMS_DEAL_ACCEVENTTYPE_A01, debit.getEventType())) {\n            if (!rateFlag && !Objects.isNull(rate) && !Objects.isNull(rate.getRate())) {\n                credit.setAccounted(credit.getEntered().multiply(rate.getRate()).setScale(2, BigDecimal.ROUND_HALF_UP));\n                debit.setExchangeRate(rate.getRate());\n                debit.setExchangeRateStr(rate.getRate().stripTrailingZeros().toPlainString());\n                credit.setExchangeRate(rate.getRate());\n                credit.setExchangeRateStr(rate.getRate().stripTrailingZeros().toPlainString());\n                if (Objects.isNull(tax)) {\n                    debit.setAccounted(debit.getEntered().multiply(rate.getRate()).setScale(2,\n                            BigDecimal.ROUND_HALF_UP));\n                } else {\n                    tax.setAccounted(tax.getEntered().multiply(rate.getRate()).setScale(2, BigDecimal.ROUND_HALF_UP));\n                    debit.setAccounted(credit.getAccounted().subtract(tax.getAccounted()));\n                    tax.setExchangeRate(rate.getRate());\n                    tax.setExchangeRateStr(rate.getRate().stripTrailingZeros().toPlainString());\n                }\n            } else {\n                debit.setAccounted(debit.getEntered());\n                credit.setAccounted(credit.getEntered());\n                debit.setExchangeRate(BigDecimal.ONE);\n                debit.setExchangeRateStr(BigDecimal.ONE.stripTrailingZeros().toPlainString());\n                credit.setExchangeRate(BigDecimal.ONE);\n                credit.setExchangeRateStr(BigDecimal.ONE.stripTrailingZeros().toPlainString());\n                if (Objects.nonNull(tax)) {\n                    tax.setAccounted(tax.getEntered());\n                    tax.setExchangeRate(BigDecimal.ONE);\n                    tax.setExchangeRateStr(BigDecimal.ONE.stripTrailingZeros().toPlainString());\n                }\n            }\n        }\n    }\n\n\n    private void findOtherAccounts(List<LoanAccount> accounts, LoanAccount account) {\n        // 同一交易编号下的a,b,c事件创建分录提交会生成一个批次，审批拒绝后，再次点击创建分录如果只勾选a事件，那么b,c事件的分录会一起展示\n        List<String> result = accounts.stream().map(LoanAccount::getAttribute3).collect(Collectors.toList())\n                .stream().distinct().collect(Collectors.toList());\n        List<String> headerIds = result.stream().filter(headerId -> StringUtils.isNotBlank(headerId))\n                .collect(Collectors.toList());\n        if (CollectionUtils.isNotEmpty(headerIds)) {\n            TmsLoanAccountExample example = new TmsLoanAccountExample();\n            TmsLoanAccountExample.Criteria criteria = example.createCriteria();\n            criteria.andEventIdNotIn(account.getEventIds());\n            criteria.andAttribute3In(headerIds);\n            List<TmsLoanAccount> las = this.dao.selectByExample(example);\n            if (las.size() > 0) {\n                List<LoanAccount> loanAccounts = las.stream().map(la -> {\n                    LoanAccount lat = new LoanAccount();\n                    BeanUtils.copyProperties(la, lat);\n                    String exchangeRateStr = la.getExchangeRate().stripTrailingZeros().toPlainString();\n                    lat.setExchangeRateStr(exchangeRateStr);\n                    return lat;\n                }).collect(Collectors.toList());\n                Map<Long, List<LoanAccount>> laMap = loanAccounts.stream()\n                        .collect(Collectors.groupingBy(LoanAccount::getEventId));\n                for (List<LoanAccount> accountList : laMap.values()) {\n                    sortAccouts(accountList);\n                    accounts.addAll(accountList);\n                }\n            }\n        }\n    }\n\n\n    @Override\n    public List<LoanAccount> getExportDealAccrualAccounts(LoanAccount account) {\n        List<LoanAccount> list = new ArrayList<>();\n        account.getEventIds().forEach(accrualId -> {\n            List<LoanAccount> accountAssembleds = assembleDealAccrualAccount(accrualId);\n            for (LoanAccount ac : accountAssembleds) {\n                list.add(ac);\n            }\n            sortAccouts(list);\n        });\n        for (int i = 0; i < list.size(); i++) {\n            list.get(i).setJeLineNum(1 + i);\n        }\n        return list;\n    }\n\n    @Override\n    public List<LoanAccount> getExportFinancialAccounts(LoanAccount account) {\n        List<LoanAccount> list = new ArrayList<>();\n        account.getEventIds().forEach(eventId -> {\n            List<LoanAccount> accountAssembleds = assembleFinancialAccount(eventId);\n            for (LoanAccount ac : accountAssembleds) {\n                list.add(ac);\n            }\n            sortAccouts(list);\n        });\n        this.findOtherAccounts(list, account);\n        for (int i = 0; i < list.size(); i++) {\n            list.get(i).setJeLineNum(1 + i);\n        }\n        return list;\n    }\n\n    @Override\n    public List<LoanAccount> getExportTransferAccounts(LoanAccount account) {\n        List<LoanAccount> list = new ArrayList<>();\n        account.getEventIds().forEach(eventId -> {\n            List<LoanAccount> accountAssembleds = assembleTransferAccount(eventId);\n            for (LoanAccount ac : accountAssembleds) {\n                list.add(ac);\n            }\n            sortAccouts(list);\n        });\n\n        for (int i = 0; i < list.size(); i++) {\n            list.get(i).setJeLineNum(1 + i);\n        }\n        return list;\n    }\n\n    @Override\n    public List<LoanAccount> getExportCompAccounts(LoanAccount account) {\n        List<LoanAccount> list = new ArrayList<>();\n        account.getEventIds().forEach(eventId -> {\n            List<LoanAccount> accountAssembleds = assembleNewAccount(eventId);\n            for (LoanAccount ac : accountAssembleds) {\n                if (\"CR\".equals(ac.getDirection())) {\n                    ac.setAccountedCr(ac.getAccounted());\n                }\n                if (\"DR\".equals(ac.getDirection())) {\n                    ac.setAccountedDr(ac.getAccounted());\n                }\n                list.add(ac);\n            }\n            sortAccouts(list);\n        });\n\n        for (int i = 0; i < list.size(); i++) {\n            list.get(i).setJeLineNum(1 + i);\n        }\n        return list;\n    }\n\n    @Override\n    public List getExportAccounts(LoanAccount account) {\n        List<LoanAccount> list = new ArrayList<>();\n        account.getEventIds().forEach(eventId -> {\n            List<LoanAccount> accountAssembleds = assembleAccount(eventId);\n            for (LoanAccount ac : accountAssembleds) {\n                if (\"CR\".equals(ac.getDirection())) {\n                    ac.setAccountedCr(ac.getAccounted());\n                }\n                if (\"DR\".equals(ac.getDirection())) {\n                    ac.setAccountedDr(ac.getAccounted());\n                }\n                list.add(ac);\n            }\n            sortAccouts(list);\n        });\n\n        for (int i = 0; i < list.size(); i++) {\n            list.get(i).setJeLineNum(1 + i);\n        }\n        return list;\n    }\n\n    /**\n     * 获取净值理财分录信息\n     *\n     * @param accrualId\n     * @return\n     */\n    private List<LoanAccount> assembleNetValueAccount(Long accrualId) {\n        List<LoanAccount> re = new ArrayList();\n        //  先查询已保存的事件记账\n        List<LoanAccount> saved = this.getSavedAccouts(null, Arrays.asList(DEAL_PRODUCT_NETVALUE), accrualId);\n        if (saved.size() > 0) {\n            return saved;\n        }\n        // 查询净值理财交易在对应会计期间生成的已审批通过的计提凭证\n        List<LoanAccount> loanAccountsByValueId = loanAccountDao.getLoanAccountsByValueId(accrualId);\n        if (CollectionUtils.isEmpty(loanAccountsByValueId)) {\n            throw new ServiceException(\"未查询到对应期间内审批通过的计提凭证信息\");\n        }\n        FndFlexValueDTO valueDTO = fndFlexValueApi.selectIfrsCompanyCode(loanAccountsByValueId.get(0).getSegment1());\n        if (Objects.isNull(valueDTO)) {\n            throw new ServiceException(\"未查询到公司段对应的IFRS公司段\");\n        }\n\n        List<LoanAccount> rules = this.getValueAccountWithRule(accrualId);\n        List<LoanAccount> reclassifyRules = rules.stream().filter(loanAccount -> StringUtils.equals(loanAccount\n                .getReclassifyFlag(), Y)).collect(Collectors.toList());\n        // 重分类计提记账规则信息必须是两条结果: 长期和短期科目信息，缺少任何一条都会报错\n        if (CollectionUtils.isEmpty(rules) || (CollectionUtils.isNotEmpty(reclassifyRules) && reclassifyRules\n                .size() != 2)) {\n            // 无匹配的会计事件记账规则或记账规则设置错误，请检查后重新提交。\n            String message = msgManageApi.getMsg(LoanConstants.TMS_NOACCOUNTRULE);\n            LOGGER.error(\"净值理财单据ID：\" + accrualId + \"无匹配的记账规则或记账规则设置错误！\");\n            throw new RuntimeException(message);\n        }\n        for (LoanAccount rule : rules) {\n            Date accountingDate = DateUtils.getLastDayOfMonthMMM(rule.getAccountPeriod());\n            rule.setAccountingDate(accountingDate);\n            if (!StringUtils.equals(rule.getTrxCurrencyCode(), rule.getLedgerCurrencyCode())) {\n                TmsExchangeRate rate = this.selectExchangeRate(rule.getTrxCurrencyCode(), rule.getLedgerCurrencyCode(),\n                        rule.getAccountingDate());\n                if (rate != null) {\n                    rule.setExchangeRate(rate.getRate());\n                    rule.setExchangeRateStr(rate.getRate().stripTrailingZeros().toPlainString());\n                }\n            }\n            rule.setSegment1(valueDTO.getAttribute2());\n            if (StringUtils.equals(rule.getReclassifyFlag(), Y) && StringUtils.equals(rule.getLstcod(), SHORT_TERM)) {\n                re.add(getValueAccounts(rule, LoanConstants.LOAN_GL_DIRECTION_DR, accountingDate));\n                re.add(getValueAccounts(rule, LoanConstants.LOAN_GL_DIRECTION_CR, accountingDate));\n            }\n            if (StringUtils.equals(rule.getReclassifyFlag(), Y) && StringUtils.equals(rule.getLstcod(), LONG_TERM)) {\n                re.add(getValueAccounts(rule, LoanConstants.LOAN_GL_DIRECTION_CR, accountingDate));\n            }\n            if (!StringUtils.equals(rule.getReclassifyFlag(), Y)) {\n                re.add(getValueAccounts(rule, LoanConstants.LOAN_GL_DIRECTION_DR, accountingDate));\n                re.add(getValueAccounts(rule, LoanConstants.LOAN_GL_DIRECTION_CR, accountingDate));\n            }\n        }\n\n        for (LoanAccount account : loanAccountsByValueId) {\n            account.setTrxCategory(DEAL_PRODUCT_NETVALUE);\n            account.setEventType(LoanConstants.TMS_DEAL_ACCEVENTTYPE_A06);\n            account.setAccounted(account.getAccounted().negate());\n            if (Objects.nonNull(account.getEntered())) {\n                account.setEntered(account.getEntered().negate());\n            }\n            if (account.getDirection().equals(LoanConstants.LOAN_GL_DIRECTION_CR)) {\n                account.setAccountedCr(account.getAccounted());\n            }\n            if (account.getDirection().equals(LoanConstants.LOAN_GL_DIRECTION_DR)) {\n                account.setAccountedDr(account.getAccounted());\n            }\n            if (account.getExchangeRate() != null) {\n                account.setExchangeRateStr(account.getExchangeRate().stripTrailingZeros().toString());\n            }\n            account.setSegment1(valueDTO.getAttribute2());\n            account.setAttribute4(IFRS);\n        }\n        re.addAll(loanAccountsByValueId);\n\n        return re;\n    }\n\n    // 根据事件ID 组装记账用数据\n    private List<LoanAccount> assembleNewAccount(Long evnentId) {\n        List<LoanAccount> re = new ArrayList();\n        //  先查询已保存的事件记账\n        List<LoanAccount> saved = this.getSavedAccouts(evnentId, Arrays.asList(BUSINESS_TYPE_INTERCOMPANY), null);\n        if (saved.size() > 0) {\n            return saved;\n        }\n        // 获取带记账规则的事 件信息\n        List<LoanAccount> rules = this.getAccountWithRuleXin(evnentId);\n        LoanAccount rulesYuan = this.getAccountWithRule(evnentId);\n        if (!StringUtils.equals(rulesYuan.getTrxCurrencyCode(), rulesYuan.getLedgerCurrencyCode())) {\n            TmsExchangeRate rate = this.selectExchangeRate(rulesYuan.getTrxCurrencyCode(),\n                    rulesYuan.getLedgerCurrencyCode(), rulesYuan.getAccountingDate());\n            if (rate != null) {\n                BigDecimal exchangeRate = rate.getRate();\n                String exchangeRateStr = exchangeRate.stripTrailingZeros().toPlainString();\n                rulesYuan.setExchangeRate(exchangeRate);\n                rulesYuan.setExchangeRateStr(exchangeRateStr);\n                rules.forEach(rule -> {\n                    rule.setExchangeRate(exchangeRate);\n                    rule.setExchangeRateStr(exchangeRateStr);\n                });\n            }\n        }\n        // 拆分借 收入\n        if (StringUtils.equals(rules.get(0).getEventType(), LoanConstants.EVENT_TYPE_SDJK)\n                || StringUtils.equals(rules.get(0).getEventType(), LoanConstants.EVENT_TYPE_SHBJ)) {\n            rules.forEach(rule -> {\n                re.addAll(getAccountsByRuleDR(rule));\n            });\n            re.addAll(getAccountsByRuleCR(rulesYuan));\n        }\n        // 收到利息\n        if (StringUtils.equals(ru