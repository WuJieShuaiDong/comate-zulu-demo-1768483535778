                  .distinct().collect(Collectors.toList());\n                    LOGGER.info(\"getVoucherApprovalAttach EventNumber={}, 外汇交易事件附件\", loanAccount.getEventNumber());\n                    break;\n                default:\n                    throw new WebException(\"附件查询失败，批次号:\" + account.getGlImpBatchNum() + \",交易类别有误\");\n            }\n        }\n        return uploadAttachService.selectPpsCommAttachmentListByBizPks(bizType, bizPkList);\n    }\n\n\n    /**\n     * 获取第三方流水记账信息\n     *\n     * @param account eventIdList\n     * @return 记账信息\n     */\n    @Override\n    public List<LoanAccount> getThirdTransactionsAccounts(LoanAccount account) {\n\n        // 批次号(每次创建只允许有一个批次号)\n        String approveBatchId = account.getApproveBatchId();\n        // 流水的分布式标识uid\n        List<String> uids = account.getUids();\n\n        List<LoanAccount> res = assembleThirdTransactionsAccount(uids, null, THIRD_ACCOUNT_TRANS, approveBatchId);\n        if (!CollectionUtils.isEmpty(res)) {\n            // 页面选择创建 用uids标识\n            res.get(0).setUids(uids);\n        }\n        return res;\n    }\n\n    /**\n     * 批量获取第三方流水记账信息\n     *\n     * @param requestDto\n     * @return 记账信息\n     */\n    @Override\n    public List<LoanAccount> getBatchThirdTransactionsAccounts(ThirdTransQueryDTO requestDto) {\n\n        if (null == requestDto) {\n            throw new WebException(\"批量创建流水分录的搜索条件缺失\");\n        }\n        if (BizConstants.THIRD_TRANS_TAX_TYPE.equals(requestDto.getTrscod())) {\n            throw new WebException(\"税记录暂不支持通过【全部创建分录】按钮操作\");\n        }\n\n        List<LoanAccount> res = batchAssembleThirdTransactionsAccount(requestDto, THIRD_ACCOUNT_TRANS);\n        if (!CollectionUtils.isEmpty(res)) {\n            // 页面批量创建 用搜索条件标识(包含合计信息)\n            res.get(0).setRequestPara(requestDto);\n        }\n        return res;\n    }\n\n    /**\n     * 根据流水请求条件 批量组装记账用数据\n     *\n     * @param requestDto\n     * @return\n     */\n    private List<LoanAccount> batchAssembleThirdTransactionsAccount(ThirdTransQueryDTO requestDto, String type) {\n        LOGGER.info(\"第三方流水批量创建获取分录,type:{}, requestDto: {} \", type, JSON.toJSONString(requestDto));\n\n        List<String> types = new ArrayList<>();\n        types.add(type);\n        //  先查询已保存的记账\n        List<LoanAccount> saved = this.getThirdTransactionsSavedAccouts(types, requestDto.getApproveBatchId());\n        if (!CollectionUtils.isEmpty(saved)) {\n            return saved;\n        }\n        if (!\"N\".equals(requestDto.getAccountStatus())) {\n            throw new WebException(\"全部创建流水分录状态需要为未创建\");\n        }\n        if (THIRD_ACCOUNT_TRANS.equals(type) && StringUtils.isBlank(requestDto.getTrscod())) {\n            throw new WebException(\"全部创建流水分录交易类型为必选项\");\n        }\n        this.checkIfSameMonth(DateUtils.parseDate(requestDto.getStartDate()),\n                DateUtils.parseDate(requestDto.getEndDate()));\n\n        String tableName = transactionsService.getTableName(DateUtils.parseDate(requestDto.getStartDate()));\n        requestDto.setUserName(thirdTransAccountingService.handleUserName(null));\n\n        // 查询百度收银台账户信息\n        TmsThirdAccount tmsAccount = new TmsThirdAccount();\n        if (StringUtils.isNotBlank(requestDto.getBusinessCode()) && StringUtils.isBlank(requestDto.getAcctNum())) {\n            tmsAccount.setBusinessCode(requestDto.getBusinessCode());\n            List<TmsThirdAccount> accInfo = thirdAccountDAO.getThirdAcctInfoByBusinessCode(tmsAccount);\n            if (CollectionUtils.isNotEmpty(accInfo)) {\n                String acctNo = accInfo.get(0).getAppId();\n                requestDto.setAcctNum(acctNo);\n                accInfo.forEach(acct -> {\n                    if (!acctNo.equals(acct.getAppId())) {\n                        throw new WebException(\"不支持跨账户创建会计分录\");\n                    }\n                });\n            }\n        }\n\n        Map<String, List<ThirdAccountRuleDto>> maps = this.selectTransTrsTypeByAccount(requestDto,\n                tableName, type);\n\n        // 获取带记账规则的事 件信息\n        LOGGER.info(\"assembleTransferAccount 重新生成借贷分录信息start...\");\n        List<LoanAccount> rules = new ArrayList<>();\n        if (THIRD_ACCOUNT_TRANS.equals(type)) {\n            ThirdTransQueryDTO queryCopy = new ThirdTransQueryDTO();\n            BeanUtils.copyProperties(requestDto, queryCopy);\n            maps.forEach((key1, value) -> {\n                if (\"one\".equals(key1)) {\n                    value.forEach(rule -> {\n                        queryCopy.setDirection(rule.getDirection());\n                        queryCopy.setTrscod(rule.getTransactionType());\n                        List<LoanAccount> ones = loanAccountDao.getThirdTransactionAccountsByOne(tableName, queryCopy);\n                        this.assembleThirdTransactionsRules(rule, ones);\n                        rules.addAll(ones);\n                    });\n                } else if (\"day\".equals(key1)) {\n                    value.forEach(rule -> {\n                        queryCopy.setDirection(rule.getDirection());\n                        queryCopy.setTrscod(rule.getTransactionType());\n                        List<LoanAccount> days = loanAccountDao.getThirdTransactionAccountsByDay(tableName, queryCopy);\n                        this.assembleThirdTransactionsRules(rule, days);\n                        rules.addAll(days);\n                    });\n                } else if (\"month\".equals(key1)) {\n                    value.forEach(rule -> {\n                        queryCopy.setDirection(rule.getDirection());\n                        queryCopy.setTrscod(rule.getTransactionType());\n                        List<LoanAccount> months =\n                                loanAccountDao.getThirdTransactionAccountsByMonth(tableName, queryCopy);\n                        this.assembleThirdTransactionsRules(rule, months);\n                        rules.addAll(months);\n                    });\n                }\n            });\n        } else if (THIRD_ACCOUNT_TRANS_SUMMARY.equals(type)) {\n            ThirdTransQueryDTO queryCopy = new ThirdTransQueryDTO();\n            BeanUtils.copyProperties(requestDto, queryCopy);\n            maps.forEach((key1, value) -> {\n                if (\"one\".equals(key1)) {\n                    value.forEach(rule -> {\n                        queryCopy.setDirection(rule.getDirection());\n                        queryCopy.setTrscod(rule.getTransactionType());\n                        List<LoanAccount> ones = thirdTransactionsSummaryDao.getBatchThirdTransSummaryByOne(queryCopy);\n                        this.assembleThirdTransactionsRules(rule, ones);\n                        rules.addAll(ones);\n                    });\n                } else if (\"day\".equals(key1)) {\n                    value.forEach(rule -> {\n                        queryCopy.setDirection(rule.getDirection());\n                        queryCopy.setTrscod(rule.getTransactionType());\n                        List<LoanAccount> days = thirdTransactionsSummaryDao.getBatchThirdTransSummaryByDay(queryCopy);\n                        this.assembleThirdTransactionsRules(rule, days);\n                        rules.addAll(days);\n                    });\n                } else if (\"month\".equals(key1)) {\n                    value.forEach(rule -> {\n                        queryCopy.setDirection(rule.getDirection());\n                        queryCopy.setTrscod(rule.getTransactionType());\n                        List<LoanAccount> months =\n                                thirdTransactionsSummaryDao.getBatchThirdTransSummaryByMonth(queryCopy);\n                        this.assembleThirdTransactionsRules(rule, months);\n                        rules.addAll(months);\n                    });\n                }\n            });\n        }\n\n        fndFlexValueApi.translate(rules, \"trxType\", BizConstants.FndFlexSet.TMS_TRANSACTION_TYPE);\n        fndLookupApi.translate(rules, \"direction\", BizConstants.FndLookupType.TMS_ACCRULE_CASH_DIREC);\n        this.checkNumAndAmount(requestDto, rules);\n        LOGGER.info(\"assembleTransferAccount 重新生成借贷分录信息end...\");\n        List<LoanAccount> res = new ArrayList<>();\n        String acctNum = rules.get(0).getAccountNo();\n        rules.forEach(rule -> {\n            if (THIRD_ACCOUNT_TRANS_SUMMARY.equals(type) && !rule.getAccountNo().equals(acctNum)) {\n                throw new WebException(\"不支持跨账户创建会计分录!\");\n            }\n            if (!StringUtils.equals(rule.getTrxCurrencyCode(), rule.getLedgerCurrencyCode())) {\n                TmsExchangeRate rate = this.selectExchangeRate(rule.getTrxCurrencyCode(), rule.getLedgerCurrencyCode(),\n                        rule.getAccountingDate());\n                if (rate != null) {\n                    BigDecimal exchangeRate = rate.getRate();\n                    String exchangeRateStr = exchangeRate.stripTrailingZeros().toPlainString();\n                    rule.setExchangeRate(exchangeRate);\n                    rule.setExchangeRate(exchangeRate);\n                    rule.setExchangeRateStr(exchangeRateStr);\n                    rule.setExchangeRateStr(exchangeRateStr);\n                }\n            }\n            rule.setUserName(SessionUtils.getSessionUser().getUsername());\n            List<LoanAccount> temp = new ArrayList<>();\n            temp.add(getThirdTransactionsAccountsByRule(rule, LoanConstants.LOAN_GL_DIRECTION_CR, type));\n            temp.add(getThirdTransactionsAccountsByRule(rule, LoanConstants.LOAN_GL_DIRECTION_DR, type));\n            sortAccouts(temp);\n            res.addAll(temp);\n        });\n        this.getLoanAccountApproveBatchId(res);\n        return res;\n    }\n\n    /**\n     * 如果已创建 加上批次号\n     *\n     * @param rules\n     */\n    private void getLoanAccountApproveBatchId(List<LoanAccount> rules) {\n        if (CollectionUtils.isEmpty(rules)) {\n            return;\n        }\n        // 关联方名称\n        Map<String, String> map = fndFlexValueApi.getFlexValueMap(BizConstants.FndFlexSet.TMS_AFFI_COM, true);\n        for (LoanAccount account : rules) {\n            String companyName = map.get(account.getBank());\n            if (StringUtils.isNotBlank(companyName)) {\n                account.setAttribute5(companyName);\n            }\n        }\n        Long accountHeaderId = rules.get(0).getAccountHeaderId();\n        if (null != accountHeaderId && StringUtils.isBlank(rules.get(0).getApproveBatchId())) {\n            TmsLoanAccountHeader header = tmsLoanAccountHeaderDAO.selectByPrimaryKey(accountHeaderId);\n            if (null != header) {\n                rules.forEach(o -> o.setApproveBatchId(header.getApproveBatchId()));\n            }\n        }\n    }\n\n    /**\n     * 验证数量和金额 总计\n     *\n     * @param requestDto\n     * @param rules\n     * @return\n     */\n    private void checkNumAndAmount(ThirdTransQueryDTO requestDto, List<LoanAccount> rules) {\n        // 按照条件计算未创建的是否与前端传的数量相同\n        int queryTotalNum = requestDto.getTotalNum();\n        BigDecimal queryTotalAmount = requestDto.getTotalAmount();\n        int afterTotalNum = rules.stream().mapToInt(LoanAccount::getCountNum).sum();\n        BigDecimal afterTotalAmount = rules.stream().map(LoanAccount::getEntered).filter(Objects::nonNull)\n                .reduce(BigDecimal.ZERO, BigDecimal::add);\n        if (!Objects.equals(queryTotalNum, afterTotalNum)) {\n            logger.error(\"全部创建分录合计笔数验证不一致,前端数目{} 后端数据: {}\", queryTotalNum, afterTotalNum);\n            throw new WebException(\"全部创建分录合计笔数验证不一致\");\n        }\n        if (afterTotalAmount.compareTo(queryTotalAmount) != 0) {\n            logger.error(\"全部创建分录合计金额验证不一致,前端数目{} 后端数据: {}\", queryTotalAmount, afterTotalAmount);\n            throw new WebException(\"全部创建分录合计金额验证不一致\");\n        }\n    }\n\n    /**\n     * 补上交易规则\n     *\n     * @param rule\n     * @param accounts\n     * @return\n     */\n    private void assembleThirdTransactionsRules(ThirdAccountRuleDto rule,\n                                                List<LoanAccount> accounts) {\n        accounts.forEach(o -> {\n            o.setTrxType(rule.getTransactionType());\n            o.setEventType(rule.getFinancialScene());\n            o.setCrSegment1(rule.getCrSegment1());\n            o.setCrSegment2(rule.getCrSegment2());\n            o.setCrSegment3(rule.getCrSegment3());\n            o.setCrSegment4(rule.getCrSegment4());\n            o.setCrSegment5(rule.getCrSegment5());\n            o.setCrSegment6(rule.getCrSegment6());\n            o.setCrSegment7(rule.getCrSegment7());\n            o.setCrSegment8(rule.getCrSegment8());\n\n            o.setDrSegment1(rule.getDrSegment1());\n            o.setDrSegment2(rule.getDrSegment2());\n            o.setDrSegment3(rule.getDrSegment3());\n            o.setDrSegment4(rule.getDrSegment4());\n            o.setDrSegment5(rule.getDrSegment5());\n            o.setDrSegment6(rule.getDrSegment6());\n            o.setDrSegment7(rule.getDrSegment7());\n            o.setDrSegment8(rule.getDrSegment8());\n\n            o.setAttribute1(rule.getSuperintend());\n            o.setAccountRule(rule.getAccountRule());\n        });\n    }\n\n    /**\n     * 获取交易规则\n     *\n     * @param requestDto\n     * @param tableName\n     */\n    private Map<String, List<ThirdAccountRuleDto>> selectTransTrsTypeByAccount(ThirdTransQueryDTO requestDto,\n                                                                               String tableName, String type) {\n        List<ThirdAccountRuleDto> tmsThirdTransactions = Lists.newArrayList();\n        if (THIRD_ACCOUNT_TRANS.equals(type)) {\n            tmsThirdTransactions = thirdTransactionsDao.selectTransTrsTypeByAccount(requestDto, tableName);\n        } else if (THIRD_ACCOUNT_TRANS_SUMMARY.equals(type)) {\n            tmsThirdTransactions = thirdTransactionsSummaryDao.selectTransTrsTypeByAccount(requestDto);\n        }\n        if (CollectionUtils.isEmpty(tmsThirdTransactions)) {\n            throw new WebException(\"未查到第三方流水的交易类型数据\");\n        }\n        Map<String, List<ThirdAccountRuleDto>> maps = new HashMap<>();\n        ThirdAccountRuleQueryDto dto = new ThirdAccountRuleQueryDto();\n        dto.setAccountNo(requestDto.getAcctNum());\n        List<ThirdAccountRuleDto> thirdAccountRules = accountRuleDao.selectThirdAccountRule(dto);\n\n        tmsThirdTransactions.forEach(o -> {\n            List<ThirdAccountRuleDto> temp = thirdAccountRules.stream().filter(m ->\n                            StringUtils.equals(o.getDirection(), m.getDirection())\n                                    && StringUtils.equals(o.getTransactionType(), m.getTransactionType()))\n                    .collect(Collectors.toList());\n            if (CollectionUtils.isEmpty(temp)) {\n                logger.info(\"账户:{} 交易类型:{} 方向:{} 未配置第三方交易规则\", requestDto.getAcctNum(), o.getTransactionType()\n                        , o.getDirection());\n                throw new WebException(\"未配置第三方交易规则\");\n            }\n            BeanUtils.copyProperties(temp.get(0), o);\n            if (maps.containsKey(o.getAccountRule())) {\n                List<ThirdAccountRuleDto> ruleDtos = maps.get(o.getAccountRule());\n                ruleDtos.add(o);\n            } else {\n                List<ThirdAccountRuleDto> ruleDtos = new ArrayList<>();\n                ruleDtos.add(o);\n                maps.put(o.getAccountRule(), ruleDtos);\n            }\n        });\n\n        return maps;\n    }\n\n    /**\n     * 检查是否跨月\n     *\n     * @param startDate\n     * @param endDate\n     */\n    private void checkIfSameMonth(Date startDate, Date endDate) {\n        if (null == startDate || null == endDate) {\n            throw new WebException(\"创建流水分录的交易日期起止时间缺失\");\n        }\n        String startStr = DateUtils.formatDate(startDate, \"yyyyMM\");\n        String endStr = DateUtils.formatDate(endDate, \"yyyyMM\");\n        if (!StringUtils.equals(startStr, endStr)) {\n            throw new WebException(\"第三方流水创建分录不可以跨月\");\n        }\n    }\n\n\n    /**\n     * 第三方流水获取、生成分录明细（第三方流水记账/第三方流水汇总入账）\n     *\n     * @param uids           第三方流水记账uid\n     * @param idList         第三方流水汇总入账 id\n     * @param type           区分流水还是汇总流水类别\n     * @param approveBatchId 分录批\n     * @return\n     */\n    private List<LoanAccount> assembleThirdTransactionsAccount(List<String> uids, List<Long> idList, String type,\n                                                               String approveBatchId) {\n        LOGGER.info(\"获取第三方流水分录:{},batchId:{},uids:{},idList:{}\", type, approveBatchId, uids, idList);\n        List<LoanAccount> re = new ArrayList<>();\n        List<String> types = new ArrayList<>();\n        types.add(type);\n        //  先查询已保存的记账\n        List<LoanAccount> saved = this.getThirdTransactionsSavedAccouts(types, approveBatchId);\n        if (!CollectionUtils.isEmpty(saved)) {\n            return saved;\n        }\n        List<LoanAccount> rules = Lists.newArrayList();\n        LOGGER.info(\"assembleTransferAccount 重新生成借贷分录信息start...\");\n        if (THIRD_ACCOUNT_TRANS.equals(type)) {\n            // 获取带记账规则的事 件信息\n            // 依据查询时间范围 获取table list 同时查询前需要校验下table是否存在\n            List<String> tableNameList = transactionsService.getTableNameByUidList(uids);\n            if (CollectionUtils.isEmpty(tableNameList) || tableNameList.size() > 1) {\n                throw new ServiceException(\"创建第三方流水分类交易日期不可以跨月\");\n            }\n            rules = this.getThirdTransactionsWithRule(tableNameList, uids);\n        } else if (THIRD_ACCOUNT_TRANS_SUMMARY.equals(type)) {\n            rules = this.getThirdTransSummaryWithRule(idList);\n        }\n        LOGGER.info(\"assembleTransferAccount 重新生成借贷分录信息end...\");\n        fndFlexValueApi.translate(rules, \"trxType\", BizConstants.FndFlexSet.TMS_TRANSACTION_TYPE);\n        fndLookupApi.translate(rules, \"direction\", BizConstants.FndLookupType.TMS_ACCRULE_CASH_DIREC);\n        // 取第一条流水的账号与其余账号进行比对\n        String acctNum = rules.get(0).getAccountNo();\n        rules.forEach(rule -> {\n            if (THIRD_ACCOUNT_TRANS_SUMMARY.equals(type) && !rule.getAccountNo().equals(acctNum)) {\n                throw new WebException(\"不支持跨账户创建会计分录!\");\n            }\n            if (!StringUtils.equals(rule.getTrxCurrencyCode(), rule.getLedgerCurrencyCode())) {\n                TmsExchangeRate rate = this.selectExchangeRate(rule.getTrxCurrencyCode(), rule.getLedgerCurrencyCode(),\n                        rule.getAccountingDate());\n                if (rate != null) {\n                    BigDecimal exchangeRate = rate.getRate();\n                    String exchangeRateStr = exchangeRate.stripTrailingZeros().toPlainString();\n                    rule.setExchangeRate(exchangeRate);\n                    rule.setExchangeRate(exchangeRate);\n                    rule.setExchangeRateStr(exchangeRateStr);\n                    rule.setExchangeRateStr(exchangeRateStr);\n                }\n            }\n            rule.setUserName(SessionUtils.getSessionUser().getUsername());\n            List<LoanAccount> temp = new ArrayList<>();\n            temp.add(getThirdTransactionsAccountsByRule(rule, LoanConstants.LOAN_GL_DIRECTION_CR, type));\n            temp.add(getThirdTransactionsAccountsByRule(rule, LoanConstants.LOAN_GL_DIRECTION_DR, type));\n            sortAccouts(temp);\n            re.addAll(temp);\n        });\n        this.getLoanAccountApproveBatchId(re);\n        return re;\n    }\n\n    /**\n     * 获取带记账规则的第三方流水信息\n     *\n     * @param tableNameList 分表名\n     * @param uids          分布式uid\n     * @return\n     */\n    private List<LoanAccount> getThirdTransactionsWithRule(List<String> tableNameList, List<String> uids) {\n\n        List<LoanAccount> rules = this.loanAccountDao.getThirdTransactionAccounts(tableNameList, uids);\n        if (CollectionUtils.isNotEmpty(rules)) {\n            rules.forEach(o -> {\n                if (uids.size() != rules.size()) {\n                    LOGGER.error(\"###第三方流水记账存在未匹配到记账规则的数据：{}\", uids);\n                    throw new RuntimeException(msgManageApi.getMsg(LoanConstants.TMS_NOACCOUNTRULE));\n                }\n            });\n            // 按照规则进行合并\n            return this.combineTransData(rules);\n        } else {\n            // 无匹配的会计事件记账规则或记账规则设置错误，请检查后重新提交。\n            String message = msgManageApi.getMsg(LoanConstants.TMS_NOACCOUNTRULE);\n            LOGGER.error(\"第三方流水未匹配记账规则或记账规则设置错误:{}\", uids);\n            throw new RuntimeException(message);\n        }\n    }\n\n    /**\n     * 获取带记账规则的第三方流水（汇总入账）信息\n     *\n     * @param idList 汇总表id\n     * @return\n     */\n    private List<LoanAccount> getThirdTransSummaryWithRule(List<Long> idList) {\n        String tradeChannel = thirdTransactionsSummaryDao.getTradeChannelById(idList);\n        String queryBank = ThirdSystemSourceEnum.getBankCodeByCode(tradeChannel);\n        List<LoanAccount> rules = thirdTransactionsSummaryDao.getThirdTransSummaryAccounts(idList, queryBank);\n        if (CollectionUtils.isNotEmpty(rules)) {\n            if (idList.size() != rules.size()) {\n                LOGGER.error(\"###第三方流水汇总记账存在未匹配到记账规则的数据：{},rules.size:{}\", idList, rules.size());\n                throw new WebException(msgManageApi.getMsg(LoanConstants.TMS_NOACCOUNTRULE));\n            }\n            // 按照规则进行合并\n            return this.combineTransData(rules);\n        } else {\n            // 无匹配的会计事件记账规则或记账规则设置错误，请检查后重新提交。\n            String message = msgManageApi.getMsg(LoanConstants.TMS_NOACCOUNTRULE);\n            LOGGER.error(\"###第三方流水汇总记账未匹配到记账规则：{}\", idList);\n            throw new WebException(message);\n        }\n    }\n\n\n    //  已保存的记账信息\n    private List<LoanAccount> combineTransData(List<LoanAccount> rules) {\n\n        List<LoanAccount> res = new ArrayList<>(rules.stream()\n                .filter(o -> \"one\".equals(o.getAccountRule())).collect(Collectors.toList()));\n        List<LoanAccount> distinct = rules.stream().collect(Collectors\n                .collectingAndThen(Collectors.toCollection(() -> new TreeSet<>(\n                        Comparator.comparing(o -> o.getDirection() + \";\" + o.getTrxType()))), ArrayList::new));\n        for (LoanAccount item : distinct) {\n            // 按照规则处理选择的流水数据\n            if (\"day\".equals(item.getAccountRule())) {\n                List<LoanAccount> temp = rules.stream().filter(o -> item.getDirection().equals(o.getDirection())\n                        && item.getTrxType().equals(o.getTrxType())).collect(Collectors.toList());\n                Map<String, List<LoanAccount>> maps = temp.stream()\n                        .collect(Collectors.groupingBy(LoanAccount::getEtydat));\n                for (String key : maps.keySet()) {\n                    List<LoanAccount> value = maps.get(key);\n                    BigDecimal tempTotal = value.stream().map(LoanAccount::getEntered)\n                            .reduce(BigDecimal.ZERO, BigDecimal::add);\n                    value.get(0).setEntered(tempTotal);\n                    res.add(value.get(0));\n                }\n            } else if (\"month\".equals(item.getAccountRule())) {\n                List<LoanAccount> temp = rules.stream().filter(o -> item.getDirection().equals(o.getDirection())\n                        && item.getTrxType().equals(o.getTrxType())).collect(Collectors.toList());\n                BigDecimal tempTotal = temp.stream().map(LoanAccount::getEntered)\n                        .reduce(BigDecimal.ZERO, BigDecimal::add);\n                temp.get(0).setEntered(tempTotal);\n                res.add(temp.get(0));\n            }\n\n        }\n\n        return res;\n    }\n\n    //  所有的的记账信息\n    @Override\n    public List<LoanAccount> getThirdTransactionsAllAccouts(List<String> trxCategory, String approveBatchId) {\n        if (StringUtils.isBlank(approveBatchId)) {\n            return new ArrayList<>();\n        }\n        TmsLoanAccountExample example = new TmsLoanAccountExample();\n        TmsLoanAccountExample.Criteria criteria = example.createCriteria();\n\n        criteria.andImpBatchNumEqualTo(approveBatchId);\n\n        criteria.andTrxCategoryIn(trxCategory);\n        List<TmsLoanAccount> las = this.dao.selectByExample(example);\n        return las.stream().map(la -> {\n            LoanAccount lat = new LoanAccount();\n            BeanUtils.copyProperties(la, lat);\n            String exchangeRateStr = la.getExchangeRate().stripTrailingZeros().toPlainString();\n            lat.setExchangeRateStr(exchangeRateStr);\n            lat.setAccountNo(lat.getNaryur().split(\"-\")[0]);\n            return lat;\n        }).collect(Collectors.toList());\n    }\n\n    //  已保存的记账信息\n    // 与上面的getThirdTransactionsAllAccouts 有什么区别呢，就差一个status！！\n    private List<LoanAccount> getThirdTransactionsSavedAccouts(List<String> trxCategory, String approveBatchId) {\n        if (StringUtils.isBlank(approveBatchId)) {\n            return new ArrayList<>();\n        }\n        TmsLoanAccountExample example = new TmsLoanAccountExample();\n        TmsLoanAccountExample.Criteria criteria = example.createCriteria();\n\n        criteria.andImpBatchNumEqualTo(approveBatchId);\n\n        criteria.andTrxCategoryIn(trxCategory);\n        criteria.andApproveStatusIn(Arrays.asList(LoanConstants.LOAN_GL_APPROVE_STATUS_N,\n                LoanConstants.LOAN_GL_APPROVE_STATUS_R)); // 已保存 已拒绝\n        List<TmsLoanAccount> las = this.dao.selectByExample(example);\n        return las.stream().map(la -> {\n            LoanAccount lat = new LoanAccount();\n            BeanUtils.copyProperties(la, lat);\n            String exchangeRateStr = la.getExchangeRate().stripTrailingZeros().toPlainString();\n            lat.setExchangeRateStr(exchangeRateStr);\n            lat.setAccountNo(lat.getNaryur().split(\"-\")[0]);\n            return lat;\n        }).collect(Collectors.toList());\n    }\n\n    // 根据记账规则 生成第三方流行记账数据\n    private LoanAccount getThirdTransactionsAccountsByRule(LoanAccount rule, String direction, String type) {\n        LoanAccount credit = new LoanAccount();\n        // 账期根据 实际付款时期（入账日期）生成\n        String accountPeriod = DateUtils.formatLocalDate(rule.getAccountingDate(), Locale.ENGLISH, \"MMM-yy\")\n                .toUpperCase();\n        rule.setAccountingDate(DateUtils.formatDateOfZero(rule.getAccountingDate()));\n        BeanUtils.copyProperties(rule, credit);\n        credit.setAccountPeriod(accountPeriod);\n        if (rule.getExchangeRate() != null) {\n            credit.setAccounted(credit.getEntered().multiply(rule.getExchangeRate())\n                    .setScale(2, BigDecimal.ROUND_HALF_UP));\n        } else {\n            credit.setAccounted(credit.getEntered().multiply(BigDecimal.ONE));\n        }\n        if (LoanConstants.LOAN_GL_DIRECTION_CR.equals(direction)) {\n            credit.setDirection(LoanConstants.LOAN_GL_DIRECTION_CR);\n            credit.setSegment1(rule.getCrSegment1());\n            credit.setSegment2(rule.getCrSegment2());\n            credit.setSegment3(rule.getCrSegment3());\n            credit.setSegment4(rule.getCrSegment4());\n            credit.setSegment5(rule.getCrSegment5());\n            credit.setSegment6(rule.getCrSegment6());\n            credit.setSegment7(rule.getCrSegment7());\n            credit.setSegment8(rule.getCrSegment8());\n            credit.setAccountedCr(credit.getAccounted());\n        } else {\n            credit.setDirection(LoanConstants.LOAN_GL_DIRECTION_DR);\n            credit.setSegment1(rule.getDrSegment1());\n            credit.setSegment2(rule.getDrSegment2());\n            credit.setSegment3(rule.getDrSegment3());\n            credit.setSegment4(rule.getDrSegment4());\n            credit.setSegment5(rule.getDrSegment5());\n            credit.setSegment6(rule.getDrSegment6());\n            credit.setSegment7(rule.getDrSegment7());\n            credit.setSegment8(rule.getDrSegment8());\n            credit.setAccountedDr(credit.getAccounted());\n        }\n        StringBuilder remark = new StringBuilder();\n        if (StringUtils.isNotBlank(rule.getRemark())) {\n            remark.append(SYMBOL).append(rule.getRemark());\n        }\n        if (\"one\".equals(rule.getAccountRule())) {\n            String temp = rule.getAccountNo() + SYMBOL + rule.getTrxTypeName()\n                    + SYMBOL + rule.getRefnbr();\n            if (StringUtils.isNotBlank(rule.getBankTradeRefnbr())) {\n                temp += SYMBOL + rule.getBankTradeRefnbr();\n            }\n            if ((THIRD_ACCOUNT_TRANS.equals(type) || THIRD_ACCOUNT_TRANS_SUMMARY.equals(type)) && StringUtils.isNotBlank(rule.getProductLineDesc())) {\n                temp += SYMBOL + rule.getProductLineDesc();\n            }\n            credit.setNaryur(temp);\n        } else if (\"day\".equals(rule.getAccountRule())) {\n            String temp = rule.getAccountNo() + SYMBOL + rule.getTrxTypeName()\n                    + SYMBOL + rule.getDirectionName() + SYMBOL +\n                    DateUtils.formatDate(rule.getAccountingDate(), \"yyyyMMdd\");\n            if ((THIRD_ACCOUNT_TRANS.equals(type) || THIRD_ACCOUNT_TRANS_SUMMARY.equals(type)) && StringUtils.isNotBlank(rule.getProductLineDesc())) {\n                temp += SYMBOL + rule.getProductLineDesc();\n            }\n            credit.setNaryur(temp);\n        } else if (\"month\".equals(rule.getAccountRule())) {\n            String temp = rule.getAccountNo() + SYMBOL + rule.getTrxTypeName()\n                    + SYMBOL + rule.getDirectionName() + SYMBOL +\n                    DateUtils.formatDate(rule.getAccountingDate(), \"yyyyMM\");\n            if ((THIRD_ACCOUNT_TRANS.equals(type) || THIRD_ACCOUNT_TRANS_SUMMARY.equals(type)) && StringUtils.isNotBlank(rule.getProductLineDesc())) {\n                temp += SYMBOL + rule.getProductLineDesc();\n            }\n            logger.info(\"行说明:\" + temp);\n            credit.setNaryur(temp);\n        }\n\n        credit.setTrxCategory(type);\n        String bankName = ThirdSystemSourceEnum.getNameByBankCode(rule.getBank());\n        bankName = StringUtils.isBlank(bankName) ? \"\" : bankName + SYMBOL;\n\n        String suffix = \"第三方流水记账\";\n        if (THIRD_ACCOUNT_TRANS_SUMMARY.equals(type)) {\n            suffix = \"第三方流水汇总记账\";\n        }\n\n        credit.setJeBatchName(rule.getSegment1() + SYMBOL + bankName + rule.getAccountNo() + SYMBOL\n                + DateUtils.formatDate(rule.getAccountingDate(), \"yyyyMM\") + SYMBOL\n                + rule.getUserName() + SYMBOL + suffix);\n        credit.setJeHeaderName(rule.getSegment1() + SYMBOL + bankName + rule.getAccountNo() + SYMBOL\n                + DateUtils.formatDate(rule.getAccountingDate(), \"yyyyMM\") + SYMBOL\n                + rule.getUserName() + SYMBOL + suffix);\n        return credit;\n    }\n\n    /**\n     * 根据批量操作还是选择操作 获取数据里的记账状态\n     *\n     * @param dto\n     * @return\n     */\n    private String checkThirdTransAccountStatusByType(LoanAccountDTO dto, String type) {\n        if (StringUtils.isNotBlank(dto.getLoanAccounts().get(0).getApproveBatchId())) {\n            // 有批次号，已生成日记账，不再查验流水信息\n            return null;\n        }\n\n        String tableName = null;\n        if (THIRD_ACCOUNT_TRANS.equals(type)) {\n            List<ThirdTransAccountDTO> tmsThirdTransactions = new ArrayList<>();\n            if (CollectionUtils.isNotEmpty(dto.getUids())) {\n                // 选择创建分录\n                List<String> tableNames = transactionsService.getTableNameByUidList(dto.getUids());\n                if (CollectionUtils.isEmpty(tableNames) || tableNames.size() > 1) {\n                    throw new ServiceException(\"创建第三方流水分类交易日期不可以跨月\");\n                }\n                tableName = tableNames.get(0);\n                List<TmsThirdTransactions> temp = this.thirdTransactionsDao.selectStatusByUids(tableName,\n                        dto.getUids());\n                for (TmsThirdTransactions o : temp) {\n                    ThirdTransAccountDTO item = new ThirdTransAccountDTO();\n                    if (null != o) {\n                        BeanUtils.copyProperties(o, item);\n                        tmsThirdTransactions.add(item);\n                    }\n                }\n\n            } else if (null != dto.getRequestPara()) {\n                // 批量创建分录\n                ThirdTransQueryDTO requestDto = dto.getRequestPara();\n                this.checkIfSameMonth(DateUtils.parseDate(requestDto.getStartDate()),\n                        DateUtils.parseDate(requestDto.getEndDate()));\n\n                tableName = transactionsService.getTableName(DateUtils.parseDate(requestDto.getStartDate()));\n                requestDto.setUserName(thirdTransAccountingService.handleUserName(null));\n                tmsThirdTransactions.addAll(thirdTransactionsDao.selectStatusByAccountPage(requestDto, tableName));\n            } else {\n                throw new ServiceException(\"无法区分是批量创建还是选择创建流水\");\n            }\n            tmsThirdTransactions.forEach(o -> {\n                if (null != o && LoanConstants.LOAN_GL_CREATED_STATUS_P.equals(o.getAccountStatus())) {\n                    throw new ServiceException(\"流水:{} 已被更新，请重新查询后操作!\", o.getRefnbr());\n                }\n            });\n        } else if (THIRD_ACCOUNT_TRANS_SUMMARY.equals(type)) {\n            List<String> accountStatusList = Lists.newArrayList();\n            if (CollectionUtils.isNotEmpty(dto.getEventIds())) {\n                accountStatusList = thirdTransactionsSummaryDao.getAccountStatusList(dto.getEventIds());\n            } else if (null != dto.getRequestPara()) {\n                // 全部创建分录按条件进行筛选\n                ThirdTransQueryDTO requestDto = dto.getRequestPara();\n                this.checkIfSameMonth(DateUtils.parseDate(requestDto.getStartDate()),\n                        DateUtils.parseDate(requestDto.getEndDate()));\n                accountStatusList = thirdTransactionsSummaryDao.getBatchAccountStatusList(requestDto);\n            } else {\n                throw new ServiceException(\"当前操作异常:无法区分是全部创建还是选择创建流水\");\n            }\n            accountStatusList.forEach(o -> {\n                if (LoanConstants.LOAN_GL_CREATED_STATUS_P.equals(o)) {\n                    throw new ServiceException(\"当前操作分录批状态已变化，请重新查询后操作!\");\n                }\n            });\n        }\n        return tableName;\n\n    }\n\n    @Override\n    @Transactional(rollbackFor = Exception.class)\n    public TmsLoanAccountHeader saveThirdTransactionsAccounts(LoanAccountDTO dto, String type) throws ParseException {\n\n        List<LoanAccount> las = dto.getLoanAccounts();\n        BigDecimal amountDR = new BigDecimal(0); // 借方金额\n        BigDecimal amountCR = new BigDecimal(0); // 贷方金额\n\n        // 检查记账状态\n        // 增加汇总判别规则THIRD_ACCOUNT_TRANS\n        String tableName = this.checkThirdTransAccountStatusByType(dto, type);\n        Date date = DateUtils.getLastDayOfMonthMMM(las.get(0).getAccountPeriod());\n        for (LoanAccount la : las) {\n            if (la.getAccountedDr() != null) {\n                amountDR = amountDR.add(la.getAccountedDr());\n            }\n            if (la.getAccountedCr() != null) {\n                amountCR = amountCR.add(la.getAccountedCr());\n            }\n            if (StringUtils.equals(la.getManCreated(), Y)) {\n                la.setAttribute4(Y);\n            }\n            la.setGlTransferDate(date);\n            la.setAccountingDate(date);\n        }\n        if (amountDR.compareTo(amountCR) != 0) {\n            throw new ServiceException(\"借方金额合计与贷方金额合计不等，请重新查询后操作!\");\n        }\n        // 保存时生成日记账批名和头名\n        String tempbatchid = las.get(0).getApproveBatchId();\n        String approveBatchId = \"\";\n        TmsLoanAccountHeader header = new TmsLoanAccountHeader();\n        if (StringUtils.isBlank(tempbatchid)) {\n            approveBatchId = getApproveBatchId();\n            LoanAccount loanAccount = las.get(0);\n            loanAccount.setJeBatchName(loanAccount.getJeBatchName() + SYMBOL + approveBatchId);\n            loanAccount.setApproveBatchId(approveBatchId);\n            loanAccount.setAccountType(LoanConstants.LOAN_ACCOUNT_TYPE_TRX);\n            loanAccount.setApproveStatus(LoanConstants.LOAN_GL_APPROVE_STATUS_N);\n            // 本位币金额合计\n            BigDecimal accounted = new BigDecimal(0);\n            for (LoanAccount account : las) {\n                if (account.getAccountedCr() != null) {\n                    accounted = accounted.add(account.getAccountedCr());\n                }\n            }\n            Boolean isChange = false;\n            List<LoanAccount> hasChangeAccount = las.stream()\n                    .filter(ac -> StringUtils.equals(ac.getAttribute4(), Y)).collect(Collectors.toList());\n            if (CollectionUtils.isNotEmpty(hasChangeAccount)) {\n                isChange = true;\n            }\n\n            if (THIRD_ACCOUNT_TRANS.equals(type)) {\n                this.linkingHeaderAndTrans(dto, loanAccount);\n                // 日记账头表\n                header = this.saveThirdAccountHeader(loanAccount, accounted, isChange);\n\n                if (CollectionUtils.isNotEmpty(dto.getUids())) {\n                    // 页面选择创建\n                    transactionsService.updateAccountingStatus(dto.getUids(), LoanConstants.LOAN_GL_CREATED_STATUS_Y,\n                            tableName, header.getAccountHeaderId());\n                } else if (null != dto.getRequestPara()) {\n                    // 批量更新，验数据在更新\n                    ThirdTransQueryDTO requestPara = dto.getRequestPara();\n                    int totalNum = requestPara.getTotalNum();\n                    int updateNum = transactionsService.batchUpdateAccountingStatusByQuery(dto.getRequestPara(),\n                            LoanConstants.LOAN_GL_CREATED_STATUS_Y, tableName, header.getAccountHeaderId());\n                    if (totalNum != updateNum) {\n                        logger.error(\"全部创建分录保存分录---合计笔数验证不一致,前端数目{} 后端数据: {}\", totalNum, updateNum);\n                        throw new WebException(\"全部创建分录合计笔数验证不一致\");\n                    }\n                }\n            } else if (THIRD_ACCOUNT_TRANS_SUMMARY.equals(type)) {\n                // 日记账头表\n                header = this.saveThirdAccountHeader(loanAccount, accounted, isChange);\n                summaryCommonService.updateAccountingStatus(dto, header.getAccountHeaderId());\n            }\n\n        } else {\n            approveBatchId = tempbatchid;\n            TmsLoanAccountHeaderExample headerExample = new TmsLoanAccountHeaderExample();\n            TmsLoanAccountHeaderExample.Criteria criteria1 =\n                    headerExample.createCriteria().andApproveBatchIdEqualTo(approveBatchId);\n            List<TmsLoanAccountHeader> headers = tmsLoanAccountHeaderDAO.selectByExample(headerExample);\n            if (CollectionUtils.isNotEmpty(headers)) {\n                header = headers.get(0);\n                header.setGlTransferDate(date);\n            }\n            if (THIRD_ACCOUNT_TRANS.equals(type)) {\n                thirdTransAccountingService.updateAccountingStatus(String.valueOf(header.getAccountHeaderId()),\n                        DateUtils.parseDate(header.getOriginAccountPerid(), \"yyyyMM\"),\n                        LoanConstants.LOAN_GL_CREATED_STATUS_Y);\n            } else if (THIRD_ACCOUNT_TRANS_SUMMARY.equals(type)) {\n                summaryCommonService.updateAccountingStatusByHeaderId(header.getAccountHeaderId(),\n                        LOAN_GL_CREATED_STATUS_Y);\n            }\n\n        }\n\n        for (int i = 0; i < las.size(); i++) {\n            LoanAccount la = las.get(i);\n            // 保存 loanAccout\n            TmsLoanAccount tmsLoanAccount = new TmsLoanAccount();\n            BeanUtils.copyProperties(la, tmsLoanAccount);\n            tmsLoanAccount.setApproveBatchId(approveBatchId);\n            tmsLoanAccount.setImpBatchNum(approveBatchId);\n            tmsLoanAccount.setGlTransferErrorMsg(approveBatchId);\n            tmsLoanAccount.setGlTransferDate(la.getGlTransferDate());\n            tmsLoanAccount.setApproveStatus(LoanConstants.LOAN_GL_APPROVE_STATUS_N);\n            tmsLoanAccount.setGlTransferStatusCode(LoanConstants.LOAN_GL_TRANSFER_STATUS_N); // 未传送\n            tmsLoanAccount.setAccountType(LoanConstants.LOAN_ACCOUNT_TYPE_TRX);\n            tmsLoanAccount.setAttribute3(String.valueOf(header.getAccountHeaderId()));\n            tmsLoanAccount.setJeBatchName(header.getJeBatchName());\n            tmsLoanAccount.setJeLineNum(i + 1);\n            if (la.getAccountId() == null) {\n                tmsLoanAccount.setCreatedBy(SessionUtils.getSessionUser().getUsername());\n                tmsLoanAccount.setCreationDate(new Date());\n            }\n            tmsLoanAccount.setLastUpdatedBy(SessionUtils.getSessionUser().getUsername());\n            tmsLoanAccount.setLastUpdateDate(new Date());\n            this.saveOrUpdateSelective(tmsLoanAccount);\n        }\n\n        // 关联公共附件\n        if (!CollectionUtils.isEmpty(dto.getAttachIds()) && StringUtils.isNotBlank(approveBatchId)) {\n            List<String> attachIds = dto.getAttachIds();\n            String currentUser = SessionUtils.getSessionUser().getUsername();\n            attachmentDAO.updateAttachBizpk(attachIds,\n                    CommonEnums.AttachmentBizType.THIRD_BALANCE_ACCOUNT_ATTACH.getValue(),\n                    approveBatchId, currentUser);\n        }\n        return header;\n    }\n\n    /**\n     * 关联日期账头表和流水表日期\n     *\n     * @param dto\n     * @return\n     */\n    private void linkingHeaderAndTrans(LoanAccountDTO dto, LoanAccount loanAccount) {\n        String month = null;\n        if (CollectionUtils.isNotEmpty(dto.getUids())) {\n            String uid = dto.getUids().get(0);\n            month = uid.substring(0, 6);\n        } else if (null != dto.getRequestPara()) {\n            String date = dto.getRequestPara().getStartDate();\n            month = date.replace(\"-\", \"\").substring(0, 6);\n        }\n        loanAccount.setOriginAccountPeriod(month);\n    }\n\n    @Override\n    public List<LoanAccount> exportThirdTransactionsAccountList(ThirdTransExcelRequest dto) {\n        List<LoanAccount> res = new ArrayList<>();\n        List<String> uids = dto.getUids();\n        // 用是否传uids 区分选择创建/条件创建\n        if (StringUtils.isNotBlank(dto.getApproveBatchId())) {\n            List<String> types = new ArrayList<>();\n            types.add(THIRD_ACCOUNT_TRANS);\n            //  先查询已保存的记账\n            res = this.getThirdTransactionsAllAccouts(types, dto.getApproveBatchId());\n        } else if (CollectionUtils.isEmpty(uids)) {\n            ThirdTransQueryDTO queryDTO = new ThirdTransQueryDTO();\n            BeanUtils.copyProperties(dto, queryDTO);\n            res = this.getBatchThirdTransactionsAccounts(queryDTO);\n        } else {\n            LoanAccount loanAccount = new LoanAccount();\n            BeanUtils.copyProperties(dto, loanAccount);\n            res = this.getThirdTransactionsAccounts(loanAccount);\n        }\n        return res;\n    }\n\n    @Override\n    public List<LoanAccount> getThirdTransSummaryAccounts(LoanAccount account) {\n        // 批次号(每次创建只允许有一个批次号)\n        String approveBatchId = account.getApproveBatchId();\n        // 汇总流水的id\n        List<Long> idList = account.getEventIds();\n        if (CollectionUtils.isEmpty(idList)) {\n            throw new WebException(\"请选择需要操作的数据\");\n        }\n        List<LoanAccount> res =\n                assembleThirdTransactionsAccount(null, idList, THIRD_ACCOUNT_TRANS_SUMMARY, approveBatchId);\n        if (!CollectionUtils.isEmpty(res)) {\n            res.get(0).setEventIds(idList);\n        }\n        return res;\n    }\n\n    @Override\n    public List<LoanAccount> getBatchThirdTransSummaryAccounts(ThirdTransQueryDTO requestDto) {\n        ThirdTransQueryDTO originalRequest = new ThirdTransQueryDTO();\n        BeanUtils.copyProperties(requestDto, originalRequest);\n        List<LoanAccount> res = batchAssembleThirdTransactionsAccount(requestDto, THIRD_ACCOUNT_TRANS_SUMMARY);\n        if (!CollectionUtils.isEmpty(res)) {\n            // 页面批量创建 用搜索条件标识(包含合计信息)\n            // 参考第三方流水页面操作，保持统一操作\n            res.get(0).setRequestPara(originalRequest);\n        }\n        return res;\n    }\n\n\n    public void resetLoanAccountSegment(String subjectStr, LoanAccount account) {\n        if (StringUtils.isEmpty(subjectStr)) {\n            return;\n        }\n        String[] subjects = subjectStr.split(\"\\\\.\");\n        if (subjects.length != 8) {\n            LOGGER.error(\"科目编码格式不正确，请检查 : {}\", subjectStr);\n        }\n        if (!StringUtils.equals(subjects[0], account.getCompanyCode())) {\n            LOGGER.error(\"科目公司段与公司主体不一致 {} 主体 {}\", subjectStr, account.getCompanyCode());\n        }\n        account.setSegment1(subjects[0]);\n        account.setSegment2(subjects[1]);\n        account.setSegment3(subjects[2]);\n        account.setSegment4(subjects[3]);\n        account.setSegment5(subjects[4]);\n        account.setSegment6(subjects[5]);\n        account.setSegment7(subjects[6]);\n        account.setSegment8(subjects[7]);\n    }\n}\n",
