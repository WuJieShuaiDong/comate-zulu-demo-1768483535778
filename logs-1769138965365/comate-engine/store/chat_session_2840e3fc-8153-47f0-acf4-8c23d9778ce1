nts.EVENT_TYPE_DISCOUNT.equals(rule.getEventType())) {\n            if (taxFlag) {\n                debit.setEntered(rule.getInterest().abs());\n                debit.setSegment3(rule.getTaxSegment3());\n            } else {\n                debit.setEntered(debit.getEntered().abs());\n                debit.setSegment3(rule.getFinAccount());\n                debit.setSegment7(\"0\");\n            }\n        } else {\n            debit.setEntered(debit.getEntered().abs());\n            // 贴现到期交易事件 背书到期交易事件 金额取票据金额\n            if (BillConstants.EVENT_TYPE_DISCOUNT_EXPIRED.equals(rule.getEventType())\n                    || BillConstants.EVENT_TYPE_ENDORSE_EXPIRED.equals(rule.getEventType())) {\n                debit.setEntered(rule.getBillAmount().abs());\n            } else if (BillConstants.EVENT_TYPE_INTEREST_SHARING.equals(rule.getEventType())) {\n                // 利息分摊会计事件：金额取利息分摊金额\n                debit.setEntered(rule.getInterestSharing().abs());\n            }\n            if (BillConstants.EVENT_TYPE_ACCEPTANCE.equals(rule.getEventType())\n                    && \"NOTEBANK\".equals(rule.getTrxType())) {\n                // 只有银承有以下逻辑\n                // 修改票据到期承兑交易事件生成会计分录处理逻辑。借方科目改为取我方银行账户科目（之前取记账规则中的科目）\n                debit.setSegment3(rule.getFinAccount());\n            } else {\n                debit.setSegment3(rule.getDrSegment3());\n            }\n        }\n        if (rule.getExchangeRate() != null) {\n            debit.setAccounted(debit.getEntered().multiply(rule.getExchangeRate()).setScale(2,\n                    BigDecimal.ROUND_HALF_UP));\n        } else {\n            debit.setAccounted(debit.getEntered().multiply(BigDecimal.ONE));\n        }\n        debit.setAccountedDr(debit.getAccounted().abs());\n        String naryur = null;\n        if (BillConstants.EVENT_TYPE_INVOICE.equals(rule.getEventType())) {\n            naryur = \"应收票据收票\" + SYMBOL + rule.getRequestNumber();\n        } else if (BillConstants.EVENT_TYPE_ACCEPTANCE.equals(rule.getEventType())) {\n            naryur = \"应收票据到期承兑\" + SYMBOL + rule.getRequestNumber();\n        } else if (BillConstants.EVENT_TYPE_ENDORSE.equals(rule.getEventType())) {\n            naryur = \"应收票据背书转让\" + SYMBOL + rule.getRequestNumber();\n        } else if (BillConstants.EVENT_TYPE_DISCOUNT.equals(rule.getEventType())) {\n            naryur = \"应收票据贴现\" + SYMBOL + rule.getRequestNumber();\n        } else if (BillConstants.EVENT_TYPE_DISCOUNT_EXPIRED.equals(rule.getEventType())) {\n            naryur = \"票据贴现到期\" + SYMBOL + rule.getRequestNumber();\n        } else if (BillConstants.EVENT_TYPE_ENDORSE_EXPIRED.equals(rule.getEventType())) {\n            naryur = \"票据背书到期\" + SYMBOL + rule.getRequestNumber();\n        } else if (BillConstants.EVENT_TYPE_INTEREST_SHARING.equals(rule.getEventType())) {\n            naryur = \"票据利息分摊\" + SYMBOL + rule.getRequestNumber();\n        }\n        debit.setNaryur(naryur);\n        debit.setSegment2(\"0\");\n        debit.setSegment4(\"000\");\n        debit.setSegment5(\"00\");\n        debit.setSegment6(\"0\");\n        if (StringUtils.isBlank(debit.getSegment7())) {\n            debit.setSegment7(\"0\");\n        }\n        debit.setSegment8(\"0\");\n        return debit;\n    }\n\n    // 处理记账的默认值\n    private void dealAccountDefaultValues(List<LoanAccount> accounts) {\n        accounts.forEach(account -> {\n            account.setSegment2(\"0\");\n            account.setSegment4(\"000\");\n            account.setSegment6(\"0\");\n            account.setSegment7(\"0\");\n            account.setSegment8(\"0\");\n        });\n    }\n\n    // 处理资金划拨记账的默认值\n    private void transAccountDefaultValues(LoanAccount account) {\n        if (StringUtils.isBlank(account.getSegment2())) {\n            account.setSegment2(\"0\");\n        }\n        if (StringUtils.isBlank(account.getSegment7())) {\n            account.setSegment7(\"0\");\n        }\n        account.setSegment4(\"000\");\n        account.setSegment6(\"0\");\n        account.setSegment8(\"0\");\n    }\n\n    /**\n     * 保存公司间借款交易事件的日记账（新）\n     * 校验ccid\n     *\n     * @param las LoanAccount\n     * @return 用于记账的交易事件列表 包含成功的信息和校验失败的信息\n     */\n    @Override\n    public void saveCompanyAccounts(List<LoanAccount> las) {\n        BigDecimal amountDR = new BigDecimal(0); // 借方金额\n        BigDecimal amountCR = new BigDecimal(0); // 贷方金额\n        for (LoanAccount la : las) {\n            TmsLoanTrxEvent event = this.loanTrxEventService.findOne(la.getEventId());\n            if (LoanConstants.LOAN_GL_CREATED_STATUS_P.equals(event.getAccountStatus())) {\n                throw new ServiceException(\"此单据已被更新，请重新查询后操作!\");\n            }\n            if (la.getAccountedDr() != null) {\n                amountDR = amountDR.add(la.getAccountedDr());\n            }\n            if (la.getAccountedCr() != null) {\n                amountCR = amountCR.add(la.getAccountedCr());\n            }\n            if (StringUtils.equals(la.getManCreated(), Y)) {\n                la.setAttribute4(Y);\n            }\n        }\n        if (amountDR.compareTo(amountCR) != 0) {\n            throw new ServiceException(\"借方金额合计与贷方金额合计不等，请重新查询后操作!\");\n        }\n        this.validateCompAccount(las);\n        las.forEach(la -> {\n            // 保存 loanAccout\n            TmsLoanAccount tmsLoanAccount = new TmsLoanAccount();\n            BeanUtils.copyProperties(la, tmsLoanAccount);\n            tmsLoanAccount.setApproveStatus(LoanConstants.LOAN_GL_APPROVE_STATUS_N);    // 未审批\n            tmsLoanAccount.setGlTransferStatusCode(LoanConstants.LOAN_GL_TRANSFER_STATUS_N);    // 未传送\n            tmsLoanAccount.setAccountType(LoanConstants.LOAN_ACCOUNT_TYPE_TRX);                 // 交易事件记账\n            tmsLoanAccount.setProcessType(la.getProcessType());\n            tmsLoanAccount.setTrxCategory(BUSINESS_TYPE_INTERCOMPANY);        // 交易类别\n            this.saveOrUpdate(tmsLoanAccount);\n            // 更新交易事件 已保存\n            this.loanTrxEventService.updateAccountStatus(la.getEventId(),\n                    LoanConstants.LOAN_GL_CREATED_STATUS_Y);\n        });\n    }\n\n    public void validateCompAccount(List<LoanAccount> las) {\n        List<Long> eventIds = las.stream().map(LoanAccount::getEventId).collect(Collectors.toList())\n                .stream().distinct().collect(Collectors.toList());\n        LoanAccount account = new LoanAccount();\n        account.setEventIds(eventIds);\n        // 获取修改前的分录\n        List<LoanAccount> oldAccounts = this.getCompanyAccounts(account);\n        for (LoanAccount newAccount : las) {\n            if (StringUtils.equals(newAccount.getManCreated(), Y)) {\n                newAccount.setAttribute4(Y);\n            } else {\n                for (LoanAccount oldAccount : oldAccounts) {\n                    if (!StringUtils.equals(oldAccount.getManCreated(), Y) &&\n                            StringUtils.equals(newAccount.getEventNumber(), oldAccount.getEventNumber()) &&\n                            StringUtils.equals(oldAccount.getDirection(), newAccount.getDirection())) {\n                        if (isChangeAccount(newAccount, oldAccount)) {\n                            newAccount.setAttribute4(Y);\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    /**\n     * 保存交易事件的日记账\n     * 校验ccid\n     *\n     * @param las LoanAccount\n     * @return 用于记账的交易事件列表 包含成功的信息和校验失败的信息\n     */\n    @Override\n    public void saveAccounts(List<LoanAccount> las) {\n        BigDecimal amountDR = new BigDecimal(0); // 借方金额\n        BigDecimal amountCR = new BigDecimal(0); // 贷方金额\n        for (LoanAccount la : las) {\n            // mingqinag add  增加控制多个用户或者tab页操作同一笔数出现异常数据\n            TmsLoanTrxEvent event = this.loanTrxEventService.findOne(la.getEventId());\n            if (LoanConstants.LOAN_GL_CREATED_STATUS_P.equals(event.getAccountStatus()) || (LoanConstants\n                    .LOAN_GL_CREATED_STATUS_Y\n                    .equals(event\n                            .getAccountStatus())\n                    && la.getAccountId()\n                    == null)) {\n                throw new ServiceException(\"此单据已被更新，请重新查询后操作!\");\n            }\n            if (la.getAccountedDr() != null) {\n                amountDR = amountDR.add(la.getAccountedDr());\n            }\n            if (la.getAccountedCr() != null) {\n                amountCR = amountCR.add(la.getAccountedCr());\n            }\n        }\n        if (amountDR.compareTo(amountCR) != 0) {\n            throw new ServiceException(\"借方金额合计与贷方金额合计不等，请重新查询后操作!\");\n        }\n\n        las.forEach(la -> {\n            // 保存 loanAccout\n            TmsLoanAccount tmsLoanAccount = new TmsLoanAccount();\n            BeanUtils.copyProperties(la, tmsLoanAccount);\n            tmsLoanAccount.setApproveStatus(LoanConstants.LOAN_GL_APPROVE_STATUS_N);    // 未审批\n            tmsLoanAccount.setGlTransferStatusCode(LoanConstants.LOAN_GL_TRANSFER_STATUS_N);    // 未传送\n            tmsLoanAccount.setAccountType(LoanConstants.LOAN_ACCOUNT_TYPE_TRX);                 // 交易事件记账\n            tmsLoanAccount.setProcessType(la.getProcessType());\n            tmsLoanAccount.setTrxCategory(BUSINESS_TYPE_INTERCOMPANY);        // 交易类别\n            this.saveOrUpdate(tmsLoanAccount);\n            //更新交易事件  已保存\n            this.loanTrxEventService.updateAccountStatus(la.getEventId(),\n                    LoanConstants.LOAN_GL_CREATED_STATUS_Y);\n        });\n    }\n\n    /**\n     * 删除手工增加的分录信息\n     *\n     * @param la\n     * @return\n     */\n    @Override\n    public void deleteManualAccounts(LoanAccount la) {\n        List<String> approveStatus = Arrays.asList(LoanConstants.LOAN_GL_APPROVE_STATUS_N,\n                LoanConstants.LOAN_GL_APPROVE_STATUS_R);\n        TmsLoanAccount loanAccount = this.tmsLoanAccountDAO.selectByPrimaryKey(la.getAccountId());\n        if (loanAccount == null) {\n            throw new ServiceException(\"没有找到要删除的分录!\");\n        }\n        if (!StringUtils.equals(Y, loanAccount.getManCreated())) {\n            throw new ServiceException(\"非手动新增的分录无法删除!\");\n        }\n        if (!approveStatus.contains(loanAccount.getApproveStatus())) {\n            throw new ServiceException(\"单据状态不允许删除分录，请重新查询后操作!\");\n        }\n        this.delete(loanAccount.getAccountId());\n    }\n\n    @Override\n    @Transactional(rollbackFor = Exception.class)\n    public TmsLoanAccountHeader saveThirdBalanceAccounts(LoanAccountDTO dto) {\n        List<LoanAccount> las = dto.getLoanAccounts();\n        BigDecimal amountDR = new BigDecimal(0); // 借方金额\n        BigDecimal amountCR = new BigDecimal(0); // 贷方金额\n        TmsAccountBalanceQianbao qianbao = balanceQianbaoDAO.selectByPrimaryKey(las.get(0).getEventId());\n        if (LoanConstants.LOAN_GL_CREATED_STATUS_P.equals(qianbao.getAccountingStatus())) {\n            throw new ServiceException(\"此单据已被更新，请重新查询后操作!\");\n        }\n        for (LoanAccount la : las) {\n            if (la.getAccountedDr() != null) {\n                amountDR = amountDR.add(la.getAccountedDr());\n            }\n            if (la.getAccountedCr() != null) {\n                amountCR = amountCR.add(la.getAccountedCr());\n            }\n            if (StringUtils.equals(la.getManCreated(), Y)) {\n                la.setAttribute4(Y);\n            }\n        }\n        if (amountDR.compareTo(amountCR) != 0) {\n            throw new ServiceException(\"借方金额合计与贷方金额合计不等，请重新查询后操作!\");\n        }\n        // 批上待关联附件获取及分组\n        List<PpsCommAttachment> attachmentList = new ArrayList<>();\n        if (CollectionUtils.isNotEmpty(dto.getAttachIds())) {\n            dto.getAttachIds().forEach(t -> attachmentList.add(uploadAttachService.getAttachPath(t)));\n        }\n        List<PpsCommAttachment> commonAttach = new ArrayList<>();\n        if (CollectionUtils.isNotEmpty(attachmentList)) {\n            // 记账页面新上传的附件\n            commonAttach.addAll(attachmentList.stream()\n                    .filter(t -> !HAS_UPLOADED.equals(t.getRemarks())).collect(Collectors.toList()));\n        }\n        // 保存时生成日记账批名和头名\n        String tempbatchid = las.get(0).getApproveBatchId();\n        String approveBatchId = \"\";\n        TmsLoanAccountHeader header = new TmsLoanAccountHeader();\n        if (StringUtils.isBlank(tempbatchid)) {\n            approveBatchId = getApproveBatchId();\n            LoanAccount loanAccount = las.get(0);\n            loanAccount.setApproveBatchId(approveBatchId);\n            loanAccount.setAccountType(LoanConstants.LOAN_ACCOUNT_TYPE_TRX);\n            loanAccount.setApproveStatus(LoanConstants.LOAN_GL_APPROVE_STATUS_N);\n            // 本位币金额合计\n            BigDecimal accounted = new BigDecimal(0);\n            for (LoanAccount account : las) {\n                if (account.getAccountedCr() != null) {\n                    accounted = accounted.add(account.getAccountedCr());\n                }\n            }\n            Boolean isChange = false;\n            List<LoanAccount> hasChangeAccount = las.stream()\n                    .filter(ac -> StringUtils.equals(ac.getAttribute4(), Y)).collect(Collectors.toList());\n            if (CollectionUtils.isNotEmpty(hasChangeAccount)) {\n                isChange = true;\n            }\n            // 日记账头表\n            header = this.saveThirdAccountHeader(loanAccount, accounted, isChange);\n        } else {\n            approveBatchId = tempbatchid;\n            header.setApproveBatchId(approveBatchId);\n            header.setAccountHeaderId(Long.valueOf(las.get(0).getAttribute3()));\n            header.setTrxCategory(las.get(0).getTrxCategory());\n        }\n        for (int i = 0; i < las.size(); i++) {\n            LoanAccount la = las.get(i);\n            // 保存 loanAccout\n            TmsLoanAccount tmsLoanAccount = new TmsLoanAccount();\n            BeanUtils.copyProperties(la, tmsLoanAccount);\n            tmsLoanAccount.setApproveBatchId(approveBatchId);\n            tmsLoanAccount.setImpBatchNum(approveBatchId);\n            tmsLoanAccount.setGlTransferErrorMsg(approveBatchId);\n            tmsLoanAccount.setGlTransferDate(la.getAccountingDate());\n            tmsLoanAccount.setApproveStatus(LoanConstants.LOAN_GL_APPROVE_STATUS_N);\n            tmsLoanAccount.setGlTransferStatusCode(LoanConstants.LOAN_GL_TRANSFER_STATUS_N); // 未传送\n            tmsLoanAccount.setAccountType(LoanConstants.LOAN_ACCOUNT_TYPE_TRX);\n            tmsLoanAccount.setAttribute3(String.valueOf(header.getAccountHeaderId()));\n            tmsLoanAccount.setJeLineNum(i + 1);\n            if (la.getAccountId() == null) {\n                tmsLoanAccount.setCreatedBy(SessionUtils.getSessionUser().getUsername());\n                tmsLoanAccount.setCreationDate(new Date());\n            }\n            tmsLoanAccount.setLastUpdatedBy(SessionUtils.getSessionUser().getUsername());\n            tmsLoanAccount.setLastUpdateDate(new Date());\n            this.saveOrUpdate(tmsLoanAccount);\n            las.get(i).setAccountId(tmsLoanAccount.getAccountId());\n        }\n        // 更新余额表分录状态 已创建\n        balanceService.updateAccountingStatus(las.get(0).getEventId(),\n                LoanConstants.LOAN_GL_CREATED_STATUS_Y);\n        // 关联公共附件\n        if (CollectionUtils.isNotEmpty(commonAttach)) {\n            for (PpsCommAttachment attach : commonAttach) {\n                attach.setRemarks(HAS_UPLOADED);\n                uploadAttachService.updateAttach(attach);\n            }\n            this.saveAttachment(commonAttach, CommonEnums.AttachmentBizType.THIRD_BALANCE_ACCOUNT_ATTACH.getValue(),\n                    approveBatchId);\n        }\n        return header;\n    }\n\n    @Override\n    public void saveAndStartProcess(LoanAccountDTO dto, TmsLoanAccountHeader header) throws ParseException {\n        //  引入异步计算统计逻辑\n        thirdTransAccountingService.genTransTypeSummaryData(header);\n        LoanAccount account = dto.getLoanAccounts().get(0);\n        UICUserInfoDto userInfoDto = SessionUtils.getSessionUser().getUic