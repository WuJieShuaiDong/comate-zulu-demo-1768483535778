ants.LOAN_ACCOUNT_TYPE_TRX); // 交易事件\n            } else if (types.contains(saveType)) {\n                tmsLoanAccount.setAccountType(LoanConstants.LOAN_ACCOUNT_TYPE_ACCT); // 计提记账\n            }\n            tmsLoanAccount.setProcessType(la.getProcessType());\n            if (la.getAccountId() == null) {\n                tmsLoanAccount.setCreatedBy(SessionUtils.getSessionUser().getUsername());\n                tmsLoanAccount.setCreationDate(new Date());\n            }\n            tmsLoanAccount.setLastUpdatedBy(SessionUtils.getSessionUser().getUsername());\n            tmsLoanAccount.setLastUpdateDate(new Date());\n            this.saveOrUpdate(tmsLoanAccount);\n            la.setAccountStatus(LoanConstants.LOAN_GL_CREATED_STATUS_Y);\n            // 更新原始单据分录状态\n            saveOriginalBillStatus(la, saveType);\n        }\n    }\n\n    public void validateFinancial(List<LoanAccount> las, String saveType) {\n        List<Long> eventIds = new ArrayList<>();\n        LoanAccount account = new LoanAccount();\n        // 获取修改前的分录\n        List<LoanAccount> oldAccounts = new ArrayList<>();\n        if (LoanConstants.DEAL_EVENT.equals(saveType)) {\n            eventIds = las.stream().map(LoanAccount::getEventId).collect(Collectors.toList())\n                    .stream().distinct().collect(Collectors.toList());\n            account.setEventIds(eventIds);\n            oldAccounts = this.getFinancialAccounts(account);\n        } else if (LoanConstants.DEAL_ACCRUAL.equals(saveType)) {\n            eventIds = las.stream().map(LoanAccount::getAccrualId).collect(Collectors.toList())\n                    .stream().distinct().collect(Collectors.toList());\n            account.setEventIds(eventIds);\n            oldAccounts = this.getDealAccrualAccounts(account);\n        } else if (LoanConstants.IFRS_FAIRVALUE.equals(saveType)) {\n            eventIds = las.stream().map(LoanAccount::getAccrualId).collect(Collectors.toList())\n                    .stream().distinct().collect(Collectors.toList());\n            account.setEventIds(eventIds);\n            List<LoanAccount> ifrsAccounts = this.getFairvalueAccounts(account);\n            oldAccounts = ifrsAccounts.stream().filter(la -> !StringUtils.equals(IFRS, la.getAttribute4()))\n                    .collect(Collectors.toList());\n        } else if (LoanConstants.DEAL_NET_VALUE.equals(saveType)) {\n            eventIds = las.stream().map(LoanAccount::getAccrualId).collect(Collectors.toList())\n                    .stream().distinct().collect(Collectors.toList());\n            account.setEventIds(eventIds);\n            oldAccounts = this.getNetValueAccounts(account);\n        } else if (BILL_CATEGORY_NOTEREC.equals(saveType)) {\n            eventIds = las.stream().map(LoanAccount::getEventId).collect(Collectors.toList())\n                    .stream().distinct().collect(Collectors.toList());\n            account.setEventIds(eventIds);\n            oldAccounts = this.getBillReceivableAccounts(account);\n        }\n        for (LoanAccount newAccount : las) {\n            if (StringUtils.equals(IFRS, newAccount.getAttribute4())) {\n                continue;\n            }\n            if (StringUtils.equals(newAccount.getManCreated(), Y)) {\n                newAccount.setAttribute4(Y);\n            } else {\n                for (LoanAccount oldAccount : oldAccounts) {\n                    if (!StringUtils.equals(oldAccount.getManCreated(), Y)) {\n                        // 理财交易记账分录校验\n                        if (LoanConstants.DEAL_EVENT.equals(saveType) &&\n                                StringUtils.equals(newAccount.getEventNumber(), oldAccount.getEventNumber()) &&\n                                StringUtils.equals(oldAccount.getDirection(), newAccount.getDirection())) {\n                            if (isChangeAccount(newAccount, oldAccount)) {\n                                newAccount.setAttribute4(Y);\n                            }\n                        }\n                        // 应收票据记账分录校验\n                        if (BILL_CATEGORY_NOTEREC.equals(saveType) &&\n                                StringUtils.equals(newAccount.getEventNumber(), oldAccount.getEventNumber()) &&\n                                StringUtils.equals(oldAccount.getDirection(), newAccount.getDirection()) &&\n                                Objects.equals(oldAccount.getJeLineNum(), newAccount.getJeLineNum())) {\n                            if (isChangeAccount(newAccount, oldAccount)) {\n                                newAccount.setAttribute4(Y);\n                            }\n                        }\n                        List<String> saveTypes = Arrays.asList(LoanConstants.DEAL_ACCRUAL,\n                                LoanConstants.IFRS_FAIRVALUE, LoanConstants.DEAL_NET_VALUE);\n                        // 理财计提记账分录校验\n                        if (saveTypes.contains(saveType) &&\n                                newAccount.getAccrualId().equals(oldAccount.getAccrualId()) &&\n                                StringUtils.equals(oldAccount.getDirection(), newAccount.getDirection())) {\n                            if (isChangeAccount(newAccount, oldAccount)) {\n                                newAccount.setAttribute4(Y);\n                            }\n                        }\n                    }\n\n                }\n            }\n        }\n    }\n\n    /**\n     * 校验提交保存的分录数据的借贷方金额是否相等、分录状态等\n     *\n     * @param las\n     * @param saveType\n     */\n    private void checkDrCrAmount(List<LoanAccount> las, String saveType) {\n        BigDecimal amountDR = new BigDecimal(0); // 借方金额\n        BigDecimal amountCR = new BigDecimal(0); // 贷方金额\n        for (LoanAccount la : las) {\n            String accountStatus = null;\n            if (LoanConstants.DEAL_EVENT.equals(saveType)) {\n                TmsDealEvent event = dealEventDAO.selectByPrimaryKey(la.getEventId());\n                accountStatus = event.getAccountingStatus();\n            } else if (LoanConstants.DEAL_ACCRUAL.equals(saveType)) {\n                TmsDealInterestAccrual accrual = dealInterestAccrualDAO.selectByPrimaryKey(la.getAccrualId());\n                accountStatus = accrual.getAccountStatus();\n            } else if (LoanConstants.COMPANY_ACCRUAL.equals(saveType)) {\n                TmsLoanInterestAccrual accrual = loanInterestAccrualDAO.selectByPrimaryKey(la.getAccrualId());\n                accountStatus = accrual.getAccountStatus();\n            } else if (LoanConstants.IFRS_FAIRVALUE.equals(saveType)) {\n                TmsDealIfrsFairvalue fairvalue = fairvalueDAO.selectByPrimaryKey(la.getAccrualId());\n                accountStatus = fairvalue.getAccountingStatus();\n            } else if (LoanConstants.DEAL_NET_VALUE.equals(saveType)) {\n                TmsProductNetValue netValue = valueDAO.selectByPrimaryKey(la.getAccrualId());\n                accountStatus = netValue.getAccountingStatus();\n            } else if (BILL_CATEGORY_NOTEREC.equals(saveType)) {\n                TmsBillTrxEvent event = billTrxEventDAO.selectByPrimaryKey(la.getEventId());\n                accountStatus = event.getAccountingStatus();\n            }\n            if (LoanConstants.LOAN_GL_CREATED_STATUS_P.equals(accountStatus)) {\n                throw new ServiceException(\"此单据已被更新，请重新查询后操作!\");\n            }\n            if (la.getAccountedDr() != null) {\n                amountDR = amountDR.add(la.getAccountedDr());\n            }\n            if (la.getAccountedCr() != null) {\n                amountCR = amountCR.add(la.getAccountedCr());\n            }\n            if (StringUtils.equals(la.getManCreated(), Y)) {\n                la.setAttribute4(Y);\n            }\n        }\n        if (amountDR.compareTo(amountCR) != 0) {\n            throw new ServiceException(\"借方金额合计与贷方金额合计不等，请重新查询后操作!\");\n        }\n    }\n\n    /**\n     * 更新原始单据（理财交易事件、计提）分录状态  已保存\n     *\n     * @param la\n     * @param saveType\n     */\n    private void saveOriginalBillStatus(LoanAccount la, String saveType) {\n        if (LoanConstants.DEAL_EVENT.equals(saveType)) {\n            DealEventProcessDTO dto = new DealEventProcessDTO();\n            dto.setAccountingStatus(la.getAccountStatus());\n            dto.setEventId(la.getEventId());\n            // 更新理财交易事件的分录状态  已保存\n            processService.updateAccountingStatus(dto);\n        } else if (LoanConstants.DEAL_ACCRUAL.equals(saveType)) {\n            // 更新理财交易计提的分录状态  已保存\n            DealInterestAccrualDTO dto = new DealInterestAccrualDTO();\n            dto.setAccountStatus(la.getAccountStatus());\n            dto.setAccrualId(la.getAccrualId());\n            interestAccrualService.updateAccountingStatus(dto);\n        } else if (LoanConstants.COMPANY_ACCRUAL.equals(saveType)) {\n            // 更新公司间借款计提的分录状态  已保存\n            DealInterestAccrualDTO dto = new DealInterestAccrualDTO();\n            dto.setAccountStatus(la.getAccountStatus());\n            dto.setAccrualId(la.getAccrualId());\n            loanInterestAccrualService.updateAccountingStatus(dto);\n        } else if (LoanConstants.IFRS_FAIRVALUE.equals(saveType)) {\n            // 更新公允价值的分录状态  已保存\n            DealIfrsFairvalueDTO dto = new DealIfrsFairvalueDTO();\n            dto.setFairId(la.getAccrualId());\n            dto.setAccountingStatus(la.getAccountStatus());\n            changeService.updateAccountingStatus(dto);\n        } else if (LoanConstants.DEAL_NET_VALUE.equals(saveType)) {\n            // 更新净值理财的分录状态  已保存\n            DealProductNetvalueDTO dto = new DealProductNetvalueDTO();\n            dto.setAccountingStatus(la.getAccountStatus());\n            dto.setId(la.getAccrualId());\n            dto.setStatus(BizConstants.DealNetvalueBillStatus.FINANCIAL_PROCESSING);\n            productNetvalueService.updateAccountingStatus(dto, DealNetvalueEnum.OPERATE_BOOKING);\n        } else if (BILL_CATEGORY_NOTEREC.equals(saveType)) {\n            TmsBillTrxEvent dto = new TmsBillTrxEvent();\n            dto.setAccountingStatus(la.getAccountStatus());\n            dto.setEventId(la.getEventId());\n            // 更新应收票据交易事件分录状态  已保存\n            billEventService.updateAccountingStatus(dto);\n        }\n    }\n\n    // 保存资金划拨记账分录附件\n//    private void saveAttachment(LoanAccount la) {\n//        String eventNumber = la.getEventNumber();\n//        // 申请时处理申请附件\n//        String currentUser = SessionUtils.getSessionUser().getUsername();\n//        if (CollectionUtils.isNotEmpty(la.getAttachIds()) && StringUtils.isNotBlank(eventNumber)) {\n//            List<String> attachIds = la.getAttachIds();\n//            attachmentDAO.updateAttachBizpk(attachIds, TRANSFER_ACCOUNT_ATTACH.getValue(), eventNumber, currentUser);\n//        }\n//    }\n\n    /**\n     * 保存记提事件的日记账\n     * 校验ccid\n     *\n     * @param las LoanAccount\n     * @return\n     */\n    @Override\n    public void saveAccountsAccruals(List<LoanAccount> las) {\n        las.forEach(la -> {\n            // mingqinag add  增加控制多个用户或者tab页操作同一笔数出现异常数据\n            TmsLoanAccountAccrual accrual = this.loanAccountAccrualService.findOne(la.getAccrualId());\n            if (LoanConstants.LOAN_GL_CREATED_STATUS_P.equals(accrual.getAccountStatus()) || (LoanConstants\n                    .LOAN_GL_CREATED_STATUS_Y\n                    .equals(accrual\n                            .getAccountStatus())\n                    &&\n                    la.getAccountId()\n                            == null\n                    && !\"Y\"\n                    .equals(la.getManCreated()))) {\n                throw new ServiceException(\"此单据已被更新，请重新查询后操作!\");\n            }\n        });\n        las.forEach(la -> {\n            // mingqinag add  增加控制多个用户或者tab页操作同一笔数出现异常数据\n            TmsLoanAccountAccrual accrual = this.loanAccountAccrualService.findOne(la.getAccrualId());\n            if (LoanConstants.LOAN_GL_CREATED_STATUS_P.equals(accrual.getAccountStatus())) {\n                throw new ServiceException(\"此单据已被更新，请重新查询后操作!\");\n            }\n            // 保存 loanAccout\n            TmsLoanAccount tmsLoanAccount = new TmsLoanAccount();\n            BeanUtils.copyProperties(la, tmsLoanAccount);\n            if (tmsLoanAccount.getAccounted() != null) {\n                tmsLoanAccount.setAccounted(tmsLoanAccount.getAccounted().setScale(2, BigDecimal.ROUND_HALF_UP));\n            }\n            // 未审批\n            tmsLoanAccount.setApproveStatus(LoanConstants.LOAN_GL_APPROVE_STATUS_N);\n            // 未传送\n            tmsLoanAccount.setGlTransferStatusCode(LoanConstants.LOAN_GL_TRANSFER_STATUS_N);\n            // 会计事件记账\n            tmsLoanAccount.setAccountType(LoanConstants.LOAN_ACCOUNT_TYPE_ACCT);\n            tmsLoanAccount.setProcessType(la.getProcessType());\n            // 交易类别\n            this.saveOrUpdate(tmsLoanAccount);\n            //更新记提事件\n            this.loanAccountAccrualService.updateAccrauls(la.getAccrualId(),\n                    LoanConstants.LOAN_GL_CREATED_STATUS_Y);\n        });\n    }\n\n    // 生成批次 - 会计事件 key 公司段 + 请求编号\n    private Map<String, List<LoanAccount>> getBatch(List<LoanAccount> las) {\n        Map<String, List<LoanAccount>> rmap = new HashMap<>();\n        for (int i = 0; i < las.size(); i++) {\n            LoanAccount la = las.get(i);\n            String key = la.getSegment1() + la.getRequestNumber();\n            if (null != rmap.get(key)) {\n                rmap.get(key).add(la);\n            } else {\n                List<LoanAccount> last = new ArrayList<>();\n                last.add(la);\n                rmap.put(key, last);\n            }\n        }\n        return rmap;\n    }\n\n    // 生成批次-记提事件 key 公司段\n    private Map<String, List<LoanAccount>> getBatchAccruals(List<LoanAccount> las) {\n        Map<String, List<LoanAccount>> rmap = new HashMap<>();\n        for (int i = 0; i < las.size(); i++) {\n            LoanAccount la = las.get(i);\n            String key = la.getSegment1();\n            if (null != rmap.get(key)) {\n                rmap.get(key).add(la);\n            } else {\n                List<LoanAccount> last = new ArrayList<>();\n                last.add(la);\n                rmap.put(key, last);\n            }\n        }\n        return rmap;\n    }\n\n    @Override\n    public String getApproveBatchId() {\n        return serialNumUtil.getSerialNumStr(\"loan_account_approve_batch\", \"TMS\");\n    }\n\n    /**\n     * 提交审批交易事件的日记账\n     * 校验ccid\n     *\n     * @param dto\n     * @return 用于记账的交易事件列表 包含成功的信息和校验失败的信息\n     */\n    @Override\n    @Transactional\n    public void saveApproveCompAccounts(LoanAccountDTO dto) {\n        List<LoanAccount> las = dto.getLoanAccounts();\n        String userName = SessionUtils.getSessionUser().getUsername();\n        BigDecimal amountDR = new BigDecimal(0); // 借方金额\n        BigDecimal amountCR = new BigDecimal(0); // 贷方金额\n        // mingqinag add  增加控制多个用户或者tab页操作同一笔数出现异常数据\n        for (LoanAccount record : las) {\n            TmsLoanTrxEvent event = this.loanTrxEventService.findOne(record.getEventId());\n            if (LoanConstants.LOAN_GL_CREATED_STATUS_P.equals(event.getAccountStatus())) {\n                throw new ServiceException(\"此单据已被更新，请重新查询后操作!\");\n            }\n            if (record.getAccountedDr() != null) {\n                amountDR = amountDR.add(record.getAccountedDr());\n            }\n            if (record.getAccountedCr() != null) {\n                amountCR = amountCR.add(record.getAccountedCr());\n            }\n            if (StringUtils.equals(record.getManCreated(), Y)) {\n                record.setAttribute4(Y);\n            }\n            if (StringUtils.isBlank(record.getTrxCategory())) {\n                record.setTrxCategory(BUSINESS_TYPE_INTERCOMPANY);\n            }\n        }\n        if (amountDR.compareTo(amountCR) != 0) {\n            throw new ServiceException(\"借方金额合计与贷方金额合计不等，请重新查询后操作!\");\n        }\n        this.validateCompAccount(las);\n\n        // 批上待关联附件获取及分组\n        List<PpsCommAttachment> attachmentList = new ArrayList<>();\n        if (CollectionUtils.isNotEmpty(dto.getAttachIds())) {\n            dto.getAttachIds().forEach(t -> attachmentList.add(uploadAttachService.getAttachPath(t)));\n        }\n        Map<String, List<PpsCommAttachment>> attachMap = new HashMap<>();\n        List<PpsCommAttachment> commonAttach = new ArrayList<>();\n        if (CollectionUtils.isNotEmpty(attachmentList)) {\n            // 从事件处理页面复制过来的附件\n            attachMap.putAll(attachmentList.stream().filter(t -> HAS_UPLOADED.equals(t.getRemarks()))\n                    .collect(Collectors.groupingBy(PpsCommAttachment::getBizPk)));\n            // 记账页面上传的附件\n            commonAttach.addAll(attachmentList.stream()\n                    .filter(t -> !HAS_UPLOADED.equals(t.getRemarks())).collect(Collectors.toList()));\n        }\n        // 提交审批时生成日记账批名和头名\n        Map<String, List<LoanAccount>> map = getBatch(las);\n        map.keySet().forEach(\n                key -> {\n                    List<LoanAccount> laste = map.get(key);\n                    String segment1 = laste.get(0).getSegment1();\n                    String requestNo = laste.get(0).getRequestNumber();\n//                    String trxTypeName = laste.get(0).getTrxTypeName();\n                    String eventNames = laste.stream().map(LoanAccount::getEventTypeName).distinct().\n                            reduce(String::concat).get();\n                    String tempbatchid = laste.get(0).getApproveBatchId();\n                    String approveBatchId = \"\";\n                    if (StringUtils.isBlank(tempbatchid)) {\n                        approveBatchId = getApproveBatchId();\n                    } else {\n                        approveBatchId = tempbatchid;\n                    }\n                    // 批名 || 头名\n                    String names = StringUtils.join(Arrays.asList(segment1, StringUtils.upperCase(userName),\n                                    DateUtils.formatDate(new Date(),\n                                            \"yyyyMMddHHmmss\"), \"(\" + requestNo + \")\", eventNames),\n                            \"-\");\n\n                    LoanAccount loanAccount = laste.get(0);\n                    loanAccount.setApproveBatchId(approveBatchId);\n                    loanAccount.setJeBatchName(names);\n                    loanAccount.setJeHeaderName(names);\n                    loanAccount.setAccountType(LoanConstants.LOAN_ACCOUNT_TYPE_TRX);\n                    // 本位币金额合计\n                    BigDecimal accounted = new BigDecimal(0);\n                    for (LoanAccount account : laste) {\n                        if (account.getAccountedCr() != null) {\n                            accounted = accounted.add(account.getAccountedCr());\n                        }\n                    }\n                    Boolean isChange = false;\n                    List<LoanAccount> hasChangeAccount = laste.stream()\n                            .filter(ac -> StringUtils.equals(ac.getAttribute4(), Y)).collect(Collectors.toList());\n                    if (CollectionUtils.isNotEmpty(hasChangeAccount)) {\n                        isChange = true;\n                    }\n                    // 日记账头表\n                    TmsLoanAccountHeader header = this.saveLoanAccountHeader(loanAccount, accounted, isChange, null);\n                    this.saveAccountHis(header, EVENT_STATUS_SUBMIT, null);\n                    for (int i = 0; i < laste.size(); i++) {\n                        LoanAccount la = laste.get(i);\n                        // 保存 loanAccout\n                        TmsLoanAccount tmsLoanAccount = new TmsLoanAccount();\n                        BeanUtils.copyProperties(la, tmsLoanAccount);\n                        tmsLoanAccount.setJeBatchName(names); // 批名\n                        tmsLoanAccount.setJeHeaderName(names); // 头名\n                        tmsLoanAccount.setJeLineNum(i + 1); // 行号\n                        tmsLoanAccount.setApproveBatchId(approveBatchId);\n                        tmsLoanAccount.setImpBatchNum(approveBatchId);\n                        tmsLoanAccount.setGlTransferErrorMsg(approveBatchId);\n                        tmsLoanAccount.setGlTransferDate(la.getAccountingDate());\n                        tmsLoanAccount.setApproveStatus(LoanConstants.LOAN_GL_APPROVE_STATUS_P); // 审批中\n                        tmsLoanAccount.setGlTransferStatusCode(LoanConstants.LOAN_GL_TRANSFER_STATUS_N); // 未传送\n                        tmsLoanAccount.setAccountType(LoanConstants.LOAN_ACCOUNT_TYPE_TRX); // 交易事件记账\n                        tmsLoanAccount.setAttribute3(String.valueOf(header.getAccountHeaderId()));\n                        if (la.getAccountId() == null) {\n                            tmsLoanAccount.setCreatedBy(SessionUtils.getSessionUser().getUsername());\n                            tmsLoanAccount.setCreationDate(new Date());\n                        }\n                        tmsLoanAccount.setLastUpdatedBy(SessionUtils.getSessionUser().getUsername());\n                        tmsLoanAccount.setLastUpdateDate(new Date());\n                        this.saveOrUpdate(tmsLoanAccount);\n                        // 更新交易事件分录状态  已提交\n                        this.loanTrxEventService.updateAccountStatus(la.getEventId(),\n                                LoanConstants.LOAN_GL_CREATED_STATUS_P);\n\n                        // 把从事件处理页面复制的附件关联到批附件上\n                        if (CollectionUtils.isNotEmpty(attachMap.get(tmsLoanAccount.getEventNumber()))) {\n                            List<PpsCommAttachment> attachList = attachMap.get(tmsLoanAccount.getEventNumber());\n                            this.saveAttachment(attachList,\n                                    CommonEnums.AttachmentBizType.TRANSFER_ACCOUNT_ATTACH.getValue(), approveBatchId);\n                            // 防止重复关联\n                            attachMap.remove(tmsLoanAccount.getEventNumber());\n                        }\n\n                    }\n                    // 把记账页面上传的附件关联到批附件上\n       