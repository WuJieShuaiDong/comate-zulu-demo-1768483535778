l> list = this.getPmcUrlParam(searchConn, event.getTransferNum());\n        if (CollectionUtils.isNotEmpty(list)) {\n            receiptContactsList.addAll(list);\n        }\n    }\n\n    /**\n     * 理财记账回单\n     */\n    private void dealLoanReceipt(Long eventId, List<AccountElectReceiptContactDetail> receiptContactsList) {\n        DealEventQueryDto queryDto = new DealEventQueryDto();\n        queryDto.setEventId(eventId);\n        DealEventDto event = investmentCommonService.getDealEventById(eventId);\n        TmsAccount tmsAccount = tmsAccountDAO.selectByPrimaryKey(event.getAcAccountId());\n        TransactionsSearch searchConn = new TransactionsSearch();\n        searchConn.setAcctNum(tmsAccount.getAccountNo());\n        searchConn.setStartAmt(event.getSettlementAmount().abs().toString()); // 结算金额\n        searchConn.setEndAmt(event.getSettlementAmount().abs().toString());\n        searchConn.setStartDate(DateUtils.getSpecifiedDayBefore(event.getSettlementDate(), 3)); // 日期\n        searchConn.setEndDate(DateUtils.getSpecifiedDayAfter(event.getSettlementDate(), 3));\n        // List<String> trscodList = this.getTrscodList(event.getEventType());\n        // searchConn.setTrscodList(trscodList);\n        searchConn.setAccountAutoFlag(N);\n        List<AccountElectReceiptContactDetail> list = this.getPmcUrlParam(searchConn, event.getEventNumber());\n        if (CollectionUtils.isNotEmpty(list)) {\n            receiptContactsList.addAll(list);\n        }\n    }\n\n    /**\n     * 事件记账回单\n     */\n    private void eventLoanReceipt(Long eventId, List<AccountElectReceiptContactDetail> receiptContactsList) {\n        TmsLoanTrxEvent event = loanTrxEventService.findOne(eventId);\n        TmsLoanEventSettlementInfo settlementInfo = new TmsLoanEventSettlementInfo();\n        settlementInfo.setEventId(eventId);\n        List<TmsLoanEventSettlementInfo> tmsLoanEventSettlementInfos = loanSettleInfoMyDao.queryByEventId\n                (settlementInfo);\n        tmsLoanEventSe