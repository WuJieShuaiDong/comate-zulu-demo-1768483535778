 {\n                bill.setAccType(RECEIVE);\n            }\n            billList.add(bill);\n        });\n    }\n\n    /**\n     * 查询 已关联电子回单\n     */\n    @Override\n    public List<AccountElectReceiptContactDetail> getContactElectronicReceipt(\n            AccountElectReceiptContactConn condition) {\n        List<AccountElectReceiptContactDetail> result = new ArrayList<>();\n        condition.getEventIds().forEach(eventId -> {\n            String eventNumber;\n            if (LoanEventType.LOAN_TRANS.equals(condition.getLoanType())) {\n                FundTransferDTO event = fundTransferService.selectByTransferId(eventId);\n                eventNumber = event.getTransferNum();\n            } else if (LoanEventType.LOAN_DEAL.equals(condition.getLoanType())) {\n                DealEventDto event = investmentCommonService.getDealEventById(eventId);\n                eventNumber = event.getEventNumber();\n            } else {\n                TmsLoanTrxEvent event = loanTrxEventService.findOne(eventId);\n                eventNumber = event.getEventNumber();\n            }\n            result.addAll(this.getElectReceiptUrlByEventNumber(eventNumber));\n        });\n        fndLookupApi.translate(result, \"trscod\", BizConstants.FndLookupType.TMS_ACCRULE_BANKTYPE);\n        fndFlexValueApi.translate(result, \"rrctyp\", BizConstants.FndFlexSet.TMS_ER_RRCCOD);\n        return result;\n    }\n\n    @Override\n    public List<AccountElectReceiptContactDetail> getElectReceiptUrlByEventNumber(String eventNumber) {\n        List<AccountElectReceiptContactDetail> result = new ArrayList<>();\n        TmsAccountElectReceiptContactExample example = new TmsAccountElectReceiptContactExample();\n        TmsAccountElectReceiptContactExample.Criteria criteria = example.createCriteria();\n        criteria.andBillNumberEqualTo(eventNumber);\n        List<TmsAccountElectReceiptContact> list = tmsAccountElectReceiptContactDAO.selectByExample(example);\n        HashSet<TmsAccountElectReceiptContact> h = new HashSet<>(list);\n        list.clear();\n        list.addAll(h);\n        list.forEach(each -> {\n            AccountElectReceiptContactDetail detail = new AccountElectReceiptContactDetail();\n            UtilType.copyProperties(detail, each);\n            detail.setAccountNoName(this.getAccountName(detail.getAccountNo()));\n            if (StringUtils.isNotBlank(detail.getPrintInstanceNumber())) {\n                detail.setElectReceiptUrl(pmcUrl + \"cmb/receipt/image?printInstanceNumber=\" + detail\n                        .getPrintInstanceNumber());\n            }\n            if (StringUtils.isNotBlank(each.getElectReceiptUrl())) {\n                detail.setElectReceiptUrl(each.getElectReceiptUrl());\n            }\n            result.add(detail);\n        });\n        return result;\n    }\n\n    /**\n     * 查询 返回数组\n     */\n    @Override\n    public TreasuryBillLimit getBillLimit(AccountElectReceiptContactConn account) {\n        TreasuryBillLimit result = new TreasuryBillLimit();\n        List<String> evenNumberList = new ArrayList<>();\n        List<String> accountNoList = new ArrayList<>();\n        account.getEventIds().forEach(eventId -> {\n            if (LoanEventType.LOAN_TRANS.equals(account.getLoanType())) {\n                FundTransferDTO event = fundTransferService.selectByTransferId(eventId);\n                TmsAccount tmsAccount;\n                if (Y.equals(event.getImageFlag())) {\n                    tmsAccount = tmsAccountDAO.selectByPrimaryKey(event.getReAccountId());\n                } else {\n                    tmsAccount = tmsAccountDAO.selectByPrimaryKey(event.getPayAccountId());\n                }\n                evenNumberList.add(event.getTransferNum());\n                accountNoList.add(tmsAccount.getAccountNo());\n            } else if (LoanEventType.LOAN_DEAL.equals(account.getLoanType())) {\n                DealEventDto event = investmentCommonService.getDealEventById(eventId);\n                TmsAccount tmsAccount = tmsAccountDAO.selectByPrimaryKey(event.getAcAccountId());\n                evenNumberList.add(event.getEventNumber());\n                accountNoList.add(tmsAccount.getAccountNo());\n            } else {\n                TmsLoanTrxEvent event = loanTrxEventService.findOne(eventId);\n                evenNumberList.add(event.getEventNumber());\n                TmsLoanEventSettlementInfo settlementInfo = new TmsLoanEventSettlementInfo();\n                settlementInfo.setEventId(eventId);\n                List<TmsLoanEventSettlementInfo> tmsLoanEventSettlementInfos = loanSettleInfoMyDao.queryByEventId\n                        (settlementInfo);\n                for (TmsLoanEventSettlementInfo tmsLoanEventSettlementInfo : tmsLoanEventSettlementInfos) {\n                    TmsAccount tmsAccount = tmsAccountDAO.selectByPrimaryKey(tmsLoanEventSettlementInfo\n                            .getCompanyAccountId());\n                    accountNoList.add(tmsAccount.getAccountNo());\n                }\n            }\n        });\n        result.setBillNumberList(evenNumberList);\n        result.setAccountNoList(accountNoList);\n        return result;\n\n    }\n\n    /**\n     * 获取数据集合\n     */\n    private List<AccountElectReceiptContactDetail> getPmcUrlParam(\n            TransactionsSearch searchConn, String eventNumber) {\n        List<TransactionsInfor> transactionsCmbsList = transactionsCmbDAO.queryTransactionsReceipt(searchConn);\n        List<AccountElectReceiptContactDetail> receiptContactsList = new ArrayList<>();\n        transactionsCmbsList.forEach(rec -> {\n            AccountElectReceiptContactDetail receiptContact = new AccountElectReceiptContactDetail();\n            receiptContact.setBillNumber(eventNumber);\n            receiptContact.setAccType(DealCommonEnum.DIRECTION_C.getCode().equals(rec.getAmtcdr()) ? RECEIVE : PAY);\n            receiptContact.setAccountNo(rec.getAcctNum());\n            receiptContact.setAccountNoName(rec.getAcctName());\n            receiptContact.setContactAccountNo(rec.getRpyacc());\n            receiptContact.setContactAccountNoName(rec.getRpynam());\n            receiptContact.setTrxdat(rec.getEtydat());\n            receiptContact.setCurrencyCode(\"CNY\");\n            receiptContact.setTrxamt(rec.getTrsamt());\n            receiptContact.setRefnbr(rec.getRefnbr());\n            receiptContact.setTrscod(rec.getTrscod());\n            receiptContact.setNartxt(rec.getNaryur());\n            receiptContact.setBank(rec.getBank());\n            receiptContact.setTrxMatchNum(ElectReceiptUtils.getMatchAttribute(rec.getTrscod(), rec));\n            receiptContact.setRrctyp(matchElectronicrImageUtil.getReceiptCode(rec.getTrscod(), rec.getAmtcdr()));\n            receiptContact.setBusnar(rec.getBusnar());\n            receiptContactsList.add(receiptContact);\n        });\n        if (receiptContactsList.size() == 0) {\n            return null;\n        }\n        return receiptContactsList;\n    }\n\n    /**\n     * 获取调用pmc的接口\n     */\n    @Override\n    public List<AccountElectReceiptContactDetail> doPmcReceiptRecordInterface(\n            List<AccountElectReceiptContactDetail> receiptContactsList) {\n        JSONArray refnbrJsonArray = new JSONArray();\n        receiptContactsList.forEach(rec -> {\n            JSONObject jsonObject = new JSONObject();\n            jsonObject.put(\"refnbr\", rec.getRefnbr());\n            jsonObject.put(\"trxMatchNum\", rec.getTrxMatchNum());\n            jsonObject.put(\"receiptCode\", rec.getRrctyp());\n            jsonObject.put(\"account\", rec.getAccountNo());\n            jsonObject.put(\"payeeAccount\", rec.getContactAccountNo());\n            jsonObject.put(\"amount\", rec.getTrxamt());\n            jsonObject.put(\"receiptNaryur\", rec.getNartxt());\n            jsonObject.put(\"dealDate\", rec.getTrxdat().substring(0, 4) + \"-\" + rec.getTrxdat().substring(4, 6) + \"-\"\n                    + rec.getTrxdat().substring(6, 8));\n            jsonObject.put(\"businessType\", rec.getBusinessType());\n            jsonObject.put(\"bank\", rec.getBank());\n            // 交银香港特殊\n            if (Objects.nonNull(rec.getBank()) && AccountConstans.ACCOUNT_BANK_BOCOMHK.equals(rec.getBank())) {\n                jsonObject.put(\"refnbr\", rec.getBusnar());\n            }\n            refnbrJsonArray.add(jsonObject);\n        });\n\n        matchElectronicrImageUtil.getContactElectronicImage(refnbrJsonArray.toJSONString(), receiptContactsList);\n\n        fndLookupApi.translate(receiptContactsList, \"trscod\", BizConstants.FndLookupType.TMS_ACCRULE_BANKTYPE);\n        fndFlexValueApi.translate(receiptContactsList, \"rrctyp\", BizConstants.FndFlexSet.TMS_ER_RRCCOD);\n        return receiptContactsList;\n    }\n\n    /**\n     * 获取账户名\n     */\n    private String getAccountName(String accountNo) {\n        if (StringUtils.isNotBlank(accountNo)) {\n            TmsAccountExample example = new TmsAccountExample();\n            TmsAccountExample.Criteria criteria = example.createCriteria();\n            criteria.andAccountNoEqualTo(accountNo);\n            List<TmsAccount> accounts = tmsAccountDAO.selectByExample(example);\n            if (accounts.size() > 0) {\n                return accounts.get(0).getAccountName();\n            } else {\n                return null;\n            }\n        } else {\n            return null;\n        }\n    }\n\n    /**\n     * 根据事件获取文件\n     */\n    @Override\n    public List<PpsCommAttachment> fetchAttach(LoanAccountDTO account) {\n        // 根据事件id和类型获取附件\n        if (LoanEventType.LOAN_TRANS.equals(account.getLoanType())) {\n            return this.getTransAttachment(account.getEventIds());\n        } else if (LoanEventType.LOAN_DEAL.equals(account.getLoanType())) {\n            return this.getDealAttachment(account.getEventIds());\n        } else if (LoanEventType.LOAN_EVENT.equals(account.getLoanType())) {\n            return this.getCompanyAttachment(account.getEventIds());\n        } else if (LoanEventType.LOAN_NET_VALUE.equals(account.getLoanType())) {\n            return this.getDealNetValueAttachment(account.getEventIds());\n        } else if (LoanEventType.LOAN_BILL.equals(account.getLoanType())) {\n            return this.getBillManagementAttachment(account.getEventIds());\n        } else if (LoanEventType.LOAN_FOREIGN.equals(account.getLoanType())) {\n            return this.getForeignExchangeAttachment(account.getEventIds());\n        }\n\n        // 根据批号获取附件\n        if (StringUtils.isNotBlank(account.getGlImpBatchNum())) {\n//            return this.getAttachmentByGlImpBatchNum(account.getGlImpBatchNum());\n            return this.getVoucherApprovalAttach(account);\n        }\n        return new ArrayList<>(0);\n    }\n\n    /**\n     * 根据事件ids获取资金划拨附件\n     */\n    public List<PpsCommAttachment> getTransAttachment(List<Long> eventIds) {\n        List<FundTransferDTO> eventDtoList = new ArrayList<>();\n        eventIds.forEach(item -> {\n            FundTransferDTO event = fundTransferService.selectByTransferId(item);\n            eventDtoList.add(event);\n        });\n        // 获取附件\n        List<PpsCommAttachment> fileList = new ArrayList<>();\n        for (FundTransferDTO eventDto : eventDtoList) {\n            PpsCommAttachment attachment = new PpsCommAttachment();\n            // 获取记账页面上传的附件\n            attachment.setBizType(CommonEnums.AttachmentBizType.TRANSFER_ACCOUNT_ATTACH.getValue());\n            attachment.setBizPk(eventDto.getTransferNum());\n            List<PpsCommAttachment> loanAttachments = uploadAttachService.inintFileAtt(attachment);\n            fileList.addAll(loanAttachments);\n\n            // 获取事件结算时上传的附件\n            Long transferId = eventDto.getTransferId();\n            attachment.setBizType(CommonEnums.AttachmentBizType.TRANSFER_ELECTRONIC_RECEIPT_ATTACH.getValue());\n            attachment.setBizPk(String.valueOf(transferId));\n            List<PpsCommAttachment> eventAttachments = uploadAttachService.inintFileAtt(attachment);\n            if (CollectionUtils.isNotEmpty(eventAttachments)) {\n                for (PpsCommAttachment attach : eventAttachments) {\n                    if (HAS_UPLOADED.equals(attach.getRemarks())) {\n                        continue;\n                    }\n                    attach.setRemarks(HAS_UPLOADED);\n                    uploadAttachService.updateAttach(attach);\n                    attach.setBizType(CommonEnums.AttachmentBizType.TRANSFER_ACCOUNT_ATTACH.getValue());\n                    attach.setBizPk(eventDto.getTransferNum());\n                    fileList.add(this.saveAttachmentNew(attach));\n                }\n            }\n        }\n        return fileList;\n    }\n\n    /**\n     * 根据事件ids获取理财附件\n     */\n    public List<PpsCommAttachment> getDealAttachment(List<Long> eventIds) {\n        List<DealEventDto> eventDtoList = new ArrayList<>();\n        eventIds.forEach(item -> {\n            DealEventDto event = investmentCommonService.getDealEventById(item);\n            if (event != null) {\n                eventDtoList.add(event);\n            }\n        });\n        // 获取附件\n        List<PpsCommAttachment> fileList = new ArrayList<>();\n        for (DealEventDto eventDto : eventDtoList) {\n            PpsCommAttachment attachment = new PpsCommAttachment();\n            // 获取记账页面上传的附件\n            attachment.setBizType(CommonEnums.AttachmentBizType.TRANSFER_ACCOUNT_ATTACH.getValue());\n            attachment.setBizPk(eventDto.getEventNumber());\n            List<PpsCommAttachment> loanAttachments = uploadAttachService.inintFileAtt(attachment);\n            fileList.addAll(loanAttachments);\n\n            // 获取事件结算时上传的附件\n            Long selId = eventDto.getSelId();\n            attachment.setBizType(CommonEnums.AttachmentBizType.DEAL_EVENT_SETTLEMENT_ATTACH.getValue());\n            attachment.setBizPk(String.valueOf(selId));\n            List<PpsCommAttachment> eventAttachments = uploadAttachService.inintFileAtt(attachment);\n            if (CollectionUtils.isNotEmpty(eventAttachments)) {\n                for (PpsCommAttachment attach : eventAttachments) {\n                    if (HAS_UPLOADED.equals(attach.getRemarks())) {\n                        continue;\n                    }\n                    attach.setRemarks(HAS_UPLOADED);\n                    uploadAttachService.updateAttach(attach);\n                    attach.setBizType(CommonEnums.AttachmentBizType.TRANSFER_ACCOUNT_ATTACH.getValue());\n                    attach.setBizPk(eventDto.getEventNumber());\n                    fileList.add(this.saveAttachmentNew(attach));\n                }\n            }\n        }\n        return fileList;\n    }\n\n    /**\n     * 根据事件ids获取公司间借款交易事件附件\n     *\n     * @param eventIds\n     * @return\n     */\n    public List<PpsCommAttachment> getCompanyAttachment(List<Long> eventIds) {\n        List<TmsLoanTrxEvent> eventList = new ArrayList<>();\n        eventIds.forEach(item -> {\n            TmsLoanTrxEvent event = trxEventDAO.selectByPrimaryKey(item);\n            if (event != null) {\n                eventList.add(event);\n            }\n        });\n        // 获取附件\n        List<PpsCommAttachment> fileList = new ArrayList<>();\n        for (TmsLoanTrxEvent event : eventList) {\n            PpsCommAttachment attachment = new PpsCommAttachment();\n            // 获取记账页面上传的附件\n            attachment.setBizType(CommonEnums.AttachmentBizType.ACCOUNT_ELECT_RECEIPT_CONTACT_ATTACH.getValue());\n            attachment.setBizPk(event.getEventNumber());\n            List<PpsCommAttachment> loanAttachments = uploadAttachService.inintFileAtt(attachment);\n            fileList.addAll(loanAttachments);\n\n            // 获取事件处理页面上传的附件\n            attachment.setBizType(CommonEnums.AttachmentBizType.LOAN_EVENT_ATTACH.getValue());\n            attachment.setBizPk(String.valueOf(event.getEventId()));\n            List<PpsCommAttachment> eventAttachments = uploadAttachService.inintFileAtt(attachment);\n            if (CollectionUtils.isNotEmpty(eventAttachments)) {\n                for (PpsCommAttachment attach : eventAttachments) {\n                    if (HAS_UPLOADED.equals(attach.getRemarks())) {\n                        continue;\n                    }\n                    attach.setRemarks(HAS_UPLOADED);\n                    uploadAttachService.updateAttach(attach);\n                    attach.setBizType(CommonEnums.AttachmentBizType.ACCOUNT_ELECT_RECEIPT_CONTACT_ATTACH.getValue());\n                    attach.setBizPk(event.getEventNumber());\n                    fileList.add(this.saveAttachmentNew(attach));\n                }\n            }\n            // 获取从pmc返回的电子回单附件\n            attachment.setBizType(CommonEnums.AttachmentBizType.LOAN_SETTLEMENT_ELECTRONIC_RECEIPT_ATTACH.getValue());\n            attachment.setBizPk(String.valueOf(event.getEventId()));\n            List<PpsCommAttachment> electronicAttachments = uploadAttachService.inintFileAtt(attachment);\n            if (CollectionUtils.isNotEmpty(electronicAttachments)) {\n                for (PpsCommAttachment attach : electronicAttachments) {\n                    if (HAS_UPLOADED.equals(attach.getRemarks())) {\n                        continue;\n                    }\n                    attach.setRemarks(HAS_UPLOADED);\n                    uploadAttachService.updateAttach(attach);\n                    attach.setBizType(CommonEnums.AttachmentBizType.ACCOUNT_ELECT_RECEIPT_CONTACT_ATTACH.getValue());\n                    attach.setBizPk(event.getEventNumber());\n                    fileList.add(this.saveAttachmentNew(attach));\n                }\n            }\n        }\n        return fileList;\n    }\n\n    /**\n     * 根据事件ids获取票据相关附件\n     */\n    public List<PpsCommAttachment> getBillManagementAttachment(List<Long> eventIds) {\n        List<TmsBillTrxEvent> list = new ArrayList<>();\n        eventIds.forEach(item -> {\n            TmsBillTrxEvent value = billTrxEventDAO.selectByPrimaryKey(item);\n            if (value != null) {\n                list.add(value);\n            }\n        });\n        // 获取附件\n        List<PpsCommAttachment> fileList = new ArrayList<>();\n        for (TmsBillTrxEvent item : list) {\n            PpsCommAttachment attachment = new PpsCommAttachment();\n            // 获取记账页面上传的附件\n            attachment.setBizType(BILL_RECEIVABLE_ACCOUNT_ATTACH.getValue());\n            attachment.setBizPk(String.valueOf(item.getEventNumber()));\n            List<PpsCommAttachment> loanAttachments = uploadAttachService.inintFileAtt(attachment);\n            fileList.addAll(loanAttachments);\n        }\n        return fileList;\n    }\n\n    /**\n     * 根据事件ids获取外汇相关附件\n     */\n    public List<PpsCommAttachment> getForeignExchangeAttachment(List<Long> eventIds) {\n        List<TmsForeignExchangeManage> list = new ArrayList<>();\n        eventIds.forEach(item -> {\n            TmsForeignExchangeManage value = tmsForeignExchangeManageDAO.selectByPrimaryKey(item);\n            if (value != null) {\n                list.add(value);\n            }\n        });\n        logger.info(\"foreign List<TmsForeignExchangeManage>: {}\", JSONObject.toJSONString(list));\n        // 获取附件\n        List<PpsCommAttachment> fileList = new ArrayList<>();\n        for (TmsForeignExchangeManage item : list) {\n            PpsCommAttachment attachment = new PpsCommAttachment();\n            // 获取页面上传的附件\n            attachment.setBizType(CommonEnums.AttachmentBizType.FOREIGN_EXCHANGE_ACCOUNT_ATTACH.getValue());\n            attachment.setBizPk(String.valueOf(item.getTransactionNumber()));\n            List<PpsCommAttachment> loanAttachments = uploadAttachService.inintFileAtt(attachment);\n            logger.info(\"FOREIGN_EXCHANGE_ATTACH loanAttachments: {}\", JSONObject.toJSONString(loanAttachments));\n            fileList.addAll(loanAttachments);\n            // 获取外汇交易上传的附件\n            attachment.setBizType(CommonEnums.AttachmentBizType.FOREIGN_EXCHANGE_ATTACH.getValue());\n            attachment.setBizPk(String.valueOf(String.valueOf(item.getId())));\n            List<PpsCommAttachment> eventAttachments = uploadAttachService.inintFileAtt(attachment);\n            if (CollectionUtils.isNotEmpty(eventAttachments)) {\n                for (PpsCommAttachment attach : eventAttachments) {\n                    if (HAS_UPLOADED.equals(attach.getRemarks())) {\n                        continue;\n                    }\n                    attach.setRemarks(HAS_UPLOADED);\n                    uploadAttachService.updateAttach(attach);\n                    attach.setBizType(CommonEnums.AttachmentBizType.FOREIGN_EXCHANGE_ACCOUNT_ATTACH.getValue());\n                    attach.setBizPk(String.valueOf(item.getTransactionNumber()));\n                    fileList.add(this.saveAttachmentNew(attach));\n                }\n            }\n            // 电子回单\n            attachment.setBizType(CommonEnums.AttachmentBizType.FOREIGN_EXCHANGE_RECEIPT_ATTACH.getValue());\n            attachment.setBizPk(String.valueOf(String.valueOf(item.getId())));\n            List<PpsCommAttachment> reEventAttachments = uploadAttachService.inintFileAtt(attachment);\n            if (CollectionUtils.isNotEmpty(reEventAttachments)) {\n                for (PpsCommAttachment attach : reEventAttachments) {\n                    if (HAS_UPLOADED.equals(attach.getRemarks())) {\n                        continue;\n                    }\n                    attach.setRemarks(HAS_UPLOADED);\n                    uploadAttachService.updateAttach(attach);\n                    attach.setBizType(CommonEnums.AttachmentBizType.FOREIGN_EXCHANGE_ACCOUNT_ATTACH.getValue());\n                    attach.setBizPk(String.valueOf(item.getTransactionNumber()));\n                    fileList.add(this.saveAttachmentNew(attach));\n                }\n            }\n        }\n        return fileList;\n    }\n\n    /**\n     * 根据事件ids获取净值理财附件\n     */\n    public List<PpsCommAttachment> getDealNetValueAttachment(List<Long> eventIds) {\n        List<TmsProductNetValue> valueList = new ArrayList<>();\n        eventIds.forEach(item -> {\n            TmsProductNetValue value = valueDAO.selectByPrimaryKey(item);\n            if (value != null) {\n                valueList.add(value);\n            }\n        });\n        // 获取附件\n        List<PpsCommAttachment> fileList = new ArrayList<>();\n        for (TmsProductNetValue value : valueList) {\n            PpsCommAttachment attachment = new PpsCommAttachment();\n            // 获取记账页面上传的附件\n            attachment.setBizType(DEAL_NETVALUE_ACCOUNT_ATTACH.getValue());\n            attachment.setBizPk(String.valueOf(value.getId()));\n            List<PpsCommAttachment> loanAttachments = uploadAttachService.inintFileAtt(attachment);\n            fileList.addAll(loanAttachments);\n\n            // 获取净值单据上传的附件\n            attachment.setBizType(CommonEnums.AttachmentBizType.DEAL_NETVALUE_BILL_ATTACH.getValue());\n            attachment.setBizPk(String.valueOf(String.valueOf(value.getId())));\n            List<PpsCommAttachment> eventAttachments = uploadAttachService.inintFileAtt(attachment);\n            if (CollectionUtils.isNotEmpty(eventAttachments)) {\n                for (PpsCommAttachment attach : eventAttachments) {\n                    if (HAS_UPLOADED.equals(attach.getRemarks())) {\n                        continue;\n                    }\n                    attach.setRemarks(HAS_UPLOADED);\n                    uploadAttachService.updateAttach(attach);\n                    attach.setBizType(DEAL_NETVALUE_ACCOUNT_ATTACH.getValue());\n                    attach.setBizPk(String.valueOf(value.getId()));\n                    fileList.add(this.saveAttachmentNew(attach));\n                }\n            }\n        }\n        return fileList;\n    }\n\n    /**\n     * 根据总账批次号获取附件 - 附件在提交审批后/提交总账后 都关联到了批次上\n     */\n    public List<PpsCommAttachment> getAttachmentByGlImpBatchNum(String glImpBatchNum) {\n        // 理