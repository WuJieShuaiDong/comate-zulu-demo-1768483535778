 his.setCreationDate(new Date());\n        his.setLastUpdatedBy(SessionUtils.getSessionUser().getUsername());\n        his.setLastUpdateDate(new Date());\n        hisDAO.insert(his);\n    }\n\n    /**\n     * 提交审批记提事件的日记账\n     * 校验ccid\n     *\n     * @param las LoanAccount\n     * @return 用于记账的交易事件列表 包含成功的信息和校验失败的信息\n     */\n    @Override\n    @Transactional\n    public void saveApproveAccountsAccruals(List<LoanAccount> las) {\n        String userName = SessionUtils.getSessionUser().getUsername();\n        las.forEach(la -> {\n            // mingqinag add  增加控制多个用户或者tab页操作同一笔数出现异常数据\n            TmsLoanAccountAccrual accrual = this.loanAccountAccrualService.findOne(la.getAccrualId());\n            if (LoanConstants.LOAN_GL_CREATED_STATUS_P.equals(accrual.getAccountStatus()) || (LoanConstants\n                    .LOAN_GL_CREATED_STATUS_Y\n                    .equals(accrual\n                            .getAccountStatus())\n                    &&\n                    la.getAccountId()\n                            == null\n                    && !\"Y\"\n                    .equals(la.getManCreated()))) {\n                throw new ServiceException(\"此单据已被更新，请重新查询后操作!\");\n            }\n        });\n        // 提交审批时生成日记账批名和头名\n        Map<String, List<LoanAccount>> map = getBatchAccruals(las);\n        map.keySet().forEach(\n                key -> {\n                    List<LoanAccount> laste = map.get(key);\n                    String segment1 = laste.get(0).getSegment1();\n                    String eventTypeName = laste.get(0).getEventTypeName();\n                    String period = laste.get(0).getAccountPeriod();\n                    String tempbatchid = laste.get(0).getApproveBatchId();//中间量 修改审批拒绝的BUG 将同一单的BatchID从头到尾都置为相同的\n                    String approveBatchId = \"\";\n                    if (StringUtils.isBlank(tempbatchid)) {\n                        approveBatchId = getApproveBatchId();\n                    }\n                    // 批名 || 头名\n                    String names = StringUtils.join(Arrays.asList(segment1, StringUtils.upperCase(userName), period,\n                                    eventTypeName, DateUtils.formatDate(new Date(),\n                                            \"yyyyMMddHHmmss\")),\n                            \"-\");\n\n                    for (int i = 0; i < laste.size(); i++) {\n                        LoanAccount la = laste.get(i);\n                        // 保存 loanAccout\n                        TmsLoanAccount tmsLoanAccount = new TmsLoanAccount();\n                        BeanUtils.copyProperties(la, tmsLoanAccount);\n                        tmsLoanAccount.setJeLineNum(i + 1); // 行号\n                        tmsLoanAccount.setJeBatchName(names); // 批名\n                        tmsLoanAccount.setJeHeaderName(names); // 头名\n                        if (StringUtils.isBlank(tempbatchid)) {\n                            tmsLoanAccount.setApproveBatchId(approveBatchId); // 审批批次号\n                        } else {\n                            tmsLoanAccount.setApproveBatchId(tempbatchid);\n                        }\n                        tmsLoanAccount.setApproveStatus(LoanConstants.LOAN_GL_APPROVE_STATUS_P); // 审批中\n                        tmsLoanAccount.setGlTransferStatusCode(LoanConstants.LOAN_GL_TRANSFER_STATUS_N); // 未传送\n                        tmsLoanAccount.setAccountType(LoanConstants.LOAN_ACCOUNT_TYPE_ACCT);                 // 会计事件记账\n                        tmsLoanAccount.setTrxCategory(BUSINESS_TYPE_INTERCOMPANY);        // 交易类别\n\n                        this.saveOrUpdate(tmsLoanAccount);\n                        //更新记提事件  已提交\n                        this.loanAccountAccrualService.updateAccrauls(la.getAccrualId(),\n                                LoanConstants.LOAN_GL_CREATED_STATUS_P);\n\n                    }\n                    ;\n                    if (StringUtils.isBlank(tempbatchid)) {\n                        submitProcess(approveBatchId, segment1, names, LoanConstants.ACCOUNTING_PROCESS);\n                    } else {\n                        submitProcess(tempbatchid, segment1, names, LoanConstants.ACCOUNTING_PROCESS);\n                    }\n                }\n        );\n    }\n\n    /**\n     * 获取 提交审批后的分录信息\n     *\n     * @param account eventIdList\n     * @return 记账信息\n     */\n    @Override\n    public Page<TmsLoanAccount> getSubmitAccounts(LoanAccount account) {\n        TmsLoanAccountExample example = new TmsLoanAccountExample();\n        TmsLoanAccountExample.Criteria criteria = example.createCriteria();\n\n        if (\"Y\".equals(account.getReqBy())) {\n            account.setReqBy(SessionUtils.getSessionUser().getUicUser().getUsername());\n        } else {\n            account.setReqBy(null);\n            List<String> companys = this.loanRoleDao.getCompanysByUserName(SessionUtils.getSessionUser().getUsername());\n            if (CollectionUtils.isEmpty(companys)) {\n                return new Page<>();\n            }\n            criteria.andSegment1In(companys);\n        }\n        if (StringUtils.isNotEmpty(account.getTrxType())) {\n            criteria.andTrxTypeEqualTo(account.getTrxType());\n        }\n        if (StringUtils.isNotEmpty(account.getSegment1())) {\n            criteria.andSegment1EqualTo(account.getSegment1());\n        }\n        if (StringUtils.isNotEmpty(account.getRequestNumber())) {\n            criteria.andRequestNumberEqualTo(account.getRequestNumber());\n        }\n        if (StringUtils.isNotEmpty(account.getEventNumber())) {\n            criteria.andEventNumberEqualTo(account.getEventNumber());\n        }\n        if (StringUtils.isNotEmpty(account.getTrxCurrencyCode())) {\n            criteria.andTrxCurrencyCodeEqualTo(account.getTrxCurrencyCode());\n        }\n        if (null != account.getLedgerId()) {\n            criteria.andLedgerIdEqualTo(account.getLedgerId());\n        }\n        if (StringUtils.isNotEmpty(account.getAccountPeriod())) {\n            criteria.andAccountPeriodEqualTo(account.getAccountPeriod());\n        }\n        if (StringUtils.isNotEmpty(account.getApproveStatus())) {\n            criteria.andApproveStatusEqualTo(account.getApproveStatus());\n        }\n        if (StringUtils.isNotEmpty(account.getGlTransferStatusCode())) {\n            criteria.andGlTransferStatusCodeEqualTo(account.getGlTransferStatusCode());\n        }\n        if (StringUtils.isNotEmpty(account.getEventType())) {\n            criteria.andEventTypeEqualTo(account.getEventType());\n        }\n        if (StringUtils.isNotEmpty(account.getTrxCategory())) {\n            criteria.andTrxCategoryEqualTo(account.getTrxCategory());\n        }\n        if (StringUtils.isNotEmpty(account.getAccountType())) {\n            criteria.andAccountTypeEqualTo(account.getAccountType());\n        }\n        if (StringUtils.isNotEmpty(account.getJeBatchName())) {\n            criteria.andJeBatchNameLike(\"%\" + account.getJeBatchName() + \"%\");\n        }\n        if (null != account.getGlDateBegin()) {\n            criteria.andAccountingDateGreaterThanOrEqualTo(account.getGlDateBegin());\n        }\n        if (null != account.getGlDateEnd()) {\n            criteria.andAccountingDateLessThanOrEqualTo(account.getGlDateEnd());\n        }\n        if (null != account.getReqBy()) {\n            criteria.andCreatedByEqualTo(account.getReqBy());\n        }\n        if (StringUtils.isNotBlank(account.getImpBatchNum())) {\n            criteria.andImpBatchNumEqualTo(account.getImpBatchNum());\n        }\n        example.setOrderByClause(\"je_batch_name ASC, je_line_num ASC\");\n        PageHelper.startPage(account.getPage(), account.getPageSize());\n        Page<TmsLoanAccount> acList = (Page<TmsLoanAccount>) this.dao.selectByExample(example);\n        return acList;\n    }\n\n    @Override\n    public List<Map<String, String>> suggestAccountsNum(LoanCommonReqQueryCon reqQueryCon) {\n        PageHelper.startPage(1, 10);\n        return loanAccountDao.suggestAccountsNum(reqQueryCon.getRequestNum());\n    }\n\n    /**\n     * 将数据通过BSD传输到总账\n     */\n    @Override\n    public void sendLoanAccountToGLbyBSD(String impBatchNum, int count) {\n        if (count > 0) {\n            try {\n                // 调用波塞冬api来启动etl抽取数据到erp主库:\n                logger.info(\"tms loanAccount Import To ERP job start: \" + DateUtils.getNow());\n                List<TransformInfo> transformInfos = new ArrayList<>();\n                TransformInfo transformInfo = new TransformInfo();\n                transformInfo.setDiActionOrder(1);\n                transformInfo.setDiJobCode(\"FIN_FUNDS_LOAN_ACCOUNT\");\n                transformInfo.setDiBatchNumber(impBatchNum);\n                transformInfo.setTotalCount(count);\n                transformInfo.setDiTransformationCode(\"APPLAT_FIN_FUNDS_LOAN_ACCOUNT\");\n                transformInfos.add(transformInfo);\n                JobInfo jobInfo = new JobInfo();\n                jobInfo.setDiChannelCode(\"PN_DC_FIN_FUNDS_CENTER\");\n                jobInfo.setDiTotalCount(count);\n                jobInfo.setDiTransformationInf(transformInfos);\n                jobInfo.setMessages(JSON.toJSONString(jobInfo));\n                poseidonManualStartService.startSendToServer(jobInfo);\n                TmsLoanAccountExample example = new TmsLoanAccountExample();\n                TmsLoanAccountExample.Criteria criteria = example.createCriteria();\n                criteria.andImpBatchNumEqualTo(impBatchNum);\n                List<TmsLoanAccount> tmsLoanAccountList = this.dao.selectByExample(example);\n                tmsLoanAccountList.forEach(record -> {\n                    record.setGlTransferStatusCode(LoanConstants.LOAN_GL_TRANSFER_STATUS_Y);\n                    this.saveOrUpdate(record);\n                });\n            } catch (Exception e) {\n                e.printStackTrace();\n            }\n        } else {\n            logger.info(\"tms loanAccount num = 0\");\n        }\n    }\n\n    /**\n     * 获取公司的账期信息 包括已关闭和已打开，不包括调整期\n     *\n     * @param la\n     * @return\n     */\n    @Override\n    public List<String> getAccountPeriodsOfCompany(LoanAccount la) {\n        return this.loanAccountDao.getAccountPeriodsOfCompany(la);\n    }\n\n    /**\n     * 获取公司的默认最新账期信息 已打开，不包括调整期\n     *\n     * @param la\n     * @return\n     */\n    @Override\n    public String getDefaultAccountPeriodOfCompany(LoanAccount la) {\n        List<String> periods = this.loanAccountDao.getDefaultAccountPeriodOfCompany(la);\n        if (CollectionUtils.isNotEmpty(periods)) {\n            return periods.get(0);\n        }\n        return null;\n    }\n\n    @Override\n    public void submitProcess(String batchId, String companyCode, String jeBatchName, String processType) {\n        String username = SessionUtils.getSessionUser().getUsername();\n        StartProcessRequest request = new StartProcessRequest(packageId, processDefineId, username);\n        fillRequestData(request, batchId, companyCode, processType);\n        // 流程名称\n        request.setProcessName(getProcessName(companyCode, jeBatchName));\n        try {\n            StartProcessResponse response = bpmProcessApi.startProcess(request);\n            if (!response.isSuccess()) {\n                // BPM流程发起失败\n                logger.error(\"流程发起失败，原因：\" + response.getMessage());\n                throw new ServiceException(\"流程发起失败，原因：\" + response.getMessage());\n            } else {\n                // 记录流程发起记录\n                bpmApprovalRecordsApi.recordStartProcess(request, response, batchId, ProcessBizType\n                        .LOAN_ACCOUNT_PROCESS);\n                // TODO 发起成功后业务逻辑\n                this.addPerformer(batchId);\n            }\n        } catch (Exception e) {\n            logger.error(\"发起日记账审批流程失败，失败原因：\", e);\n            throw new ServiceException(\"发起日记账审批流程失败\");\n        }\n    }\n\n    private void fillRequestData(StartProcessRequest request, String batchId, String companyCode, String processType) {\n        List<ActivityData> activityDatas = new ArrayList<>();\n        LoanRoleHeaderMy loanRole = new LoanRoleHeaderMy();\n        loanRole.setCompanyCode(companyCode);\n        if (LoanConstants.OTHERS_PROCESS.equals(processType)) {\n            loanRole.setProcessType(LoanConstants.OTHERS_PROCESS);\n        } else {\n            loanRole.setProcessType(LoanConstants.ACCOUNTING_PROCESS);\n        }\n        List<TmsLoanRoleHeader> listRoles = new ArrayList<>();\n        try {\n            listRoles = loanRoleService.getRoleHeaderByLine(loanRole);\n        } catch (Exception e) {\n            e.printStackTrace();\n            // errMsg.add(\"发起交易流程失败,未找到资金经理或者资金总监!\");\n            // return \"error\";\n            throw new ServiceException(\"日记账审批流程发起失败，原因：未找到财务经理!\");\n        }\n\n        Set<String> managers = new HashSet<>();  // 经理\n        listRoles.stream().filter(record -> \"TMS_FinManager\".equals(record.getRoleCode())).forEach(record -> managers\n                .add(record.getRoleUser()));\n        if (managers.size() == 0) {\n            // errMsg.add(\"发起交易流程失败,未找到资金经理或者资金总监!\");\n            // return \"error\";\n            throw new ServiceException(\"日记账审批流程发起失败，原因：未找到财务经理!\");\n        }\n        //  获取资金经理用户名\n        JSONObject jsonObject = new JSONObject();\n        jsonObject.put(\"vacationType\", \"CUXTMSTY\");\n        jsonObject.put(\"defalutApprovalList\", org.apache.commons.lang3.StringUtils.join(managers.toArray\n                (), \",\"));\n        activityDatas.add(new ActivityData(\"processVariable\", jsonObject.toJSONString()));\n        activityDatas.add(new ActivityData(\"batchId\", batchId));\n        request.setActivityData(activityDatas);\n    }\n\n    private String getProcessName(String companyCode, String jeBatchName) {\n        StringBuilder processName = new StringBuilder();\n        processName.append(\"请你审批\");\n        processName.append(SessionUtils.getSessionUser().getUicUser().getName());\n        processName.append(\"提交的\");\n        FndFlexValueDTO dto = fndFlexValueApi.selectByType(BizConstants.FndFlexSet.COM_OU_SOB, companyCode);\n        processName.append(dto.getMeaning());\n        processName.append(\"的资金凭证：\");\n        processName.append(jeBatchName);\n        return processName.toString();\n    }\n\n    @Override\n    public LoanAccountApprove findByProcessId(String processId) {\n        String businessId = bpmApprovalRecordsApi.getBusinessId(processId);\n        TmsLoanAccountExample example = new TmsLoanAccountExample();\n        TmsLoanAccountExample.Criteria criteria = example.createCriteria();\n        criteria.andApproveBatchIdEqualTo(businessId);\n        example.setOrderByClause(\"je_line_num asc\");\n        List<TmsLoanAccount> tmsLoanAccountList = this.dao.selectByExample(example);\n        List<LoanAccount> loanAccountList = new ArrayList<>();\n        tmsLoanAccountList.forEach(record -> {\n            LoanAccount loanAccount = new LoanAccount();\n            UtilType.copyProperties(loanAccount, record);\n            loanAccountList.add(loanAccount);\n        });\n        fndFlexValueApi.translate(loanAccountList,\n                \"segment1\", BizConstants.FndFlexSet.BD_COMPANY,\n                \"segment2\", BizConstants.FndFlexSet.BD_DEPARTMENT,\n                \"segment3\", BizConstants.FndFlexSet.BD_ACCOUNT,\n                \"segment4\", BizConstants.FndFlexSet.BD_PRODUCT,\n                \"segment5\", BizConstants.FndFlexSet.BD_INTERCOMPANY,\n                \"segment6\", BizConstants.FndFlexSet.BD_PROJECT,\n                \"segment7\", BizConstants.FndFlexSet.BD_SPARE1,\n                \"segment8\", BizConstants.FndFlexSet.BD_SPARE2,\n                \"eventType\", BizConstants.FndFlexSet.TMS_DEAL_ACCEVENTTYPE,\n                \"eventType\", BizConstants.FndFlexSet.TMS_DEAL_TRASACTIONTYPE);\n        fndLookupApi.translate(loanAccountList, \"eventType\", BizConstants.FndLookupType.TMS_ACCRULE_CASH_DIREC,\n                \"trxType\", BizConstants.FndLookupType.TMS_ACCRULE_BANKTYPE);\n        LoanAccountApprove approveDetail = new LoanAccountApprove();\n        List<ProcessRecordDTO> bpmHistory = new ArrayList<>();\n        List<ProcessRecordDTO> bpmActivity = bpmApprovalRecordsApi.getProcessRecords(businessId, ProcessBizType\n                .LOAN_ACCOUNT_PROCESS);\n        bpmActivity.stream().filter(record -> record.getEndTime() != null).forEach(record -> bpmHistory.add\n                (record));\n        approveDetail.setBpmHistory(bpmHistory);\n        approveDetail.setSourceName(\"资金中心\");\n        if (null != loanAccountList && loanAccountList.size() != 0) {\n            approveDetail.setBatchName(loanAccountList.get(0).getJeBatchName());\n            approveDetail.setCompanyName(loanAccountList.get(0).getSegment1Name());\n            approveDetail.setPeriodName(loanAccountList.get(0).getAccountPeriod());\n            approveDetail.setCompanySob(loanAccountList.get(0).getSegment1());\n            approveDetail.setCurrencyCode(loanAccountList.get(0).getLedgerCurrencyCode());\n            approveDetail.setTrxCategory(loanAccountList.get(0).getTrxCategory());\n            approveDetail.setApproveBatchId(loanAccountList.get(0).getApproveBatchId());\n            // 交易记账因为是多选合起来生成会计分录 并在提交时根据规则拆分成不同日记账，所以用多余字段lTransferErrorMsg来存批次号\n            approveDetail.setGlTransferErrorMsg(loanAccountList.get(0).getGlTransferErrorMsg());\n            approveDetail.setLoanAccounts(loanAccountList);\n        }\n        fndFlexValueApi.translate(approveDetail,\n                \"companySob\", BizConstants.FndFlexSet.COM_OU_SOB, \"trxCategory\", BizConstants.FndFlexSet\n                        .TMS_DEAL_TYPE);\n        return approveDetail;\n    }\n\n    /**\n     * 审批拒绝\n     *\n     * @param approveId 审批id\n     */\n    @Override\n    public void rejectAccount(String approveId) {\n        // 查询出要拒绝的批次数据\n        TmsLoanAccountExample example = new TmsLoanAccountExample();\n        TmsLoanAccountExample.Criteria criteria = example.createCriteria();\n        criteria.andApproveBatchIdEqualTo(approveId);\n        List<TmsLoanAccount> tmsLoanAccountList = this.dao.selectByExample(example);\n        tmsLoanAccountList.forEach(record -> {\n            record.setApproveStatus(LoanConstants.LOAN_GL_APPROVE_STATUS_R);\n            this.saveOrUpdate(record);\n        });\n        //置成提交时的状态  已保存\n\n /*       public static final String LOAN_ACCOUNT_TYPE_TRX = \"AT01\";        //  交易事件\n        public static final String LOAN_ACCOUNT_TYPE_ACCT = \"AT02\";      // 会计事件*/\n        //  交易事件 更新event\n        if (null != tmsLoanAccountList && tmsLoanAccountList.size() > 0\n                && tmsLoanAccountList.get(0).getAccountType().equals(LoanConstants.LOAN_ACCOUNT_TYPE_TRX)) {\n            tmsLoanAccountList.forEach(tla -> {\n                this.loanTrxEventService.updateAccountStatus(tla.getEventId(),\n                        LoanConstants.LOAN_GL_CREATED_STATUS_N);\n            });\n        } else if (null != tmsLoanAccountList && tmsLoanAccountList.size() > 0\n                && tmsLoanAccountList.get(0).getAccountType().equals(LoanConstants.LOAN_ACCOUNT_TYPE_ACCT)) {\n            // 更新记提 accrual\n            tmsLoanAccountList.forEach(tla -> {\n                this.loanAccountAccrualService.updateAccrauls(tla.getAccrualId(),\n                        LoanConstants.LOAN_GL_CREATED_STATUS_N);\n            });\n        } else if (null != tmsLoanAccountList && tmsLoanAccountList.size() > 0\n                && tmsLoanAccountList.get(0).getAccountType().equals(LoanConstants.LOAN_ACCOUNT_TYPE_OTHERS)) {\n            // 更新杂项流水\n            tmsLoanAccountList.forEach(tla -> {\n                this.transactionsAutoAccountService.updateTransactionsStatus(tla.getSourceId(),\n                        LoanConstants.LOAN_GL_CREATED_STATUS_N);\n            });\n\n            this.accountElectReceiptContactService.deleteByBillNumber(approveId);\n        }\n    }\n\n    /**\n     * 为表 tms_loan_account attribute1 字段 添加审批人\n     *\n     * @param approveBatchId 审批编号\n     */\n    @Override\n    public void addPerformer(String approveBatchId) {\n        List<String> performers = bpmApprovalRecordsApi.getCurrentPerformers(approveBatchId,\n                ProcessBizType.LOAN_ACCOUNT_PROCESS);\n        TmsLoanAccount tmsLoanAccount = new TmsLoanAccount();\n        UICTransInfoUtils uicUtils = UICTransInfoUtils.getInstance();\n        StringBuilder performerList = new StringBuilder();\n        for (String performer : performers) {\n            UICUserInfoDto realUser = uicUtils.getUserByUserName(performer);\n            performerList.append(realUser.getName());\n            tmsLoanAccount.setAttribute2(performer);\n        }\n        tmsLoanAccount.setAttribute1(performerList.toString());\n        TmsLoanAccountExample example = new TmsLoanAccountExample();\n        example.createCriteria().andApproveBatchIdEqualTo(approveBatchId);\n        tmsLoanAccountDAO.updateByExampleSelective(tmsLoanAccount, example);\n    }\n\n    private List<String> getTrscodList(String code) {\n        FndLookupValueDTO applyType = fndLookupApi.selectByType(BizConstants.FndLookupType.TMS_ERTYPE,\n                code);\n        List<String> trscodList = new ArrayList<>();\n        if (applyType != null && StringUtils.isNotBlank(applyType.getTag())) {\n            trscodList = Arrays.asList(StringUtils.split(applyType.getTag(), PERSON_SPLIT));\n        }\n        return trscodList;\n    }\n\n\n    /**\n     * 关联电子回单 初始化查询\n     */\n    @Override\n    public List<AccountElectReceiptContactDetail> getInitElectronicReceipt(AccountElectReceiptContactConn account) {\n        List<AccountElectReceiptContactDetail> accountElectReceiptContactDetailist = new ArrayList<>();\n        List<AccountElectReceiptContactDetail> receiptContactsList = new ArrayList<>();\n        // 获取交易事件\n        account.getEventIds().forEach(eventId -> {\n            if (LoanEventType.LOAN_TRANS.equals(account.getLoanType())) 