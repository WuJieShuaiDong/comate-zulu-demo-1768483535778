                "content": "     * 根据事件ID 组装外汇交易事件记账用数据\n     */\n    private List<LoanAccount> assembleForeignExchangeAccount(Long eventId) {\n        // todo 定位问题后删除无用日志\n        List<LoanAccount> re = new ArrayList<>();\n        List<String> types = new ArrayList<>();\n        // 外汇交易\n        types.add(FOREIGN_CATEGORY);\n        //  先查询已保存的事件记账\n        List<LoanAccount> saved = this.getSavedAccouts(eventId, types, null);\n        if (saved.size() > 0) {\n            return saved;\n        }\n        // 外汇状态取的支付处理中和已结清的\n        // 获取带记账规则的事件信息，贷方\n        LoanAccount ruleCR = this.getForeignExchangeAccountWithRuleCR(eventId);\n        logger.info(\"getForeignExchangeAccountWithRuleCR result: {}\", JSONObject.toJSONString(ruleCR));\n        // 获取带记账规则的事件信息，借方\n        LoanAccount ruleDR = this.getForeignExchangeAccountWithRuleDR(eventId);\n        logger.info(\"getForeignExchangeAccountWithRuleDR result: {}\", JSONObject.toJSONString(ruleDR));\n        // todo 外汇的事件类型不用给值？\n        // ruleCR.setEventType(FOREIGN_EVENT_TYPE);\n        // ruleDR.setEventType(FOREIGN_EVENT_TYPE);\n        if (!StringUtils.equals(ruleCR.getTrxCurrencyCode(), ruleCR.getLedgerCurrencyCode())) {\n            TmsExchangeRate rate = this.selectExchangeRate(ruleCR.getTrxCurrencyCode(), ruleCR.getLedgerCurrencyCode(),\n                    ruleCR.getAccountingDate());\n            logger.info(\"selectExchangeRate rate: {}\", JSONObject.toJSONString(rate));\n            if (null != rate) {\n                ruleCR.setExchangeRate(rate.getRate());\n                ruleCR.setExchangeRateStr(rate.getRate().stripTrailingZeros().toPlainString());\n            }\n        } else {\n            ruleCR.setExchangeRate(BigDecimal.ONE);\n            ruleCR.setExchangeRateStr(ruleCR.getExchangeRate().stripTrailingZeros().toPlainString());\n        }\n\n        if (!StringUtils.equals(ruleDR.getTrxCurrencyCode(), ruleDR.getLedgerCurrencyCode())) {\n            TmsExchangeRate rate = this.selectExchangeRate(ruleDR.getTrxCurrencyCode(), ruleDR.getLedgerCurrencyCode(),\n                    ruleDR.getAccountingDate());\n            logger.info(\"selectExchangeRate rate: {}\", rate);\n            if (rate != null) {\n                ruleDR.setExchangeRate(rate.getRate());\n                ruleDR.setExchangeRateStr(rate.getRate().stripTrailingZeros().toPlainString());\n            }\n        } else {\n            ruleDR.setExchangeRate(BigDecimal.ONE);\n            ruleDR.setExchangeRateStr(ruleDR.getExchangeRate().stripTrailingZeros().toPlainString());\n        }\n        // 贷方\n        LoanAccount crLoanAccount = getForeignExchangeAccountsByRuleCR(ruleCR, BL);\n        re.add(crLoanAccount);\n        // 借方\n        LoanAccount drLoanAccount = getForeignExchangeAccountsByRuleDR(ruleDR, BL);\n        re.add(drLoanAccount);\n        // 获取交易对手名\n        /*TmsLoanCompanyRuleExample tmsLoanCompanyRuleExample = new TmsLoanCompanyRuleExample();\n        TmsLoanCompanyRuleExample.Criteria loanCompanyRuleCriteria = tmsLoanCompanyRuleExample.createCriteria();\n        loanCompanyRuleCriteria.andCompanyCodeEqualTo(crLoanAccount.getCounterparty());\n        List<TmsLoanCompanyRule> tmsLoanCompanyRules = tmsLoanCompanyRuleDao.selectByExample(tmsLoanCompanyRuleExample);\n        String counterpartyName = tmsLoanCompanyRules.get(0).getCounterpartyName();\n        crLoanAccount.setCounterpartyName(counterpartyName);\n        drLoanAccount.setCounterpartyName(counterpartyName);*/\n        // 如果存在取不到期末汇率的情况，这里的Accounted计算结果不准确，此时先构建返回数据，由用户输入汇率后再计算得出Accounted，只计算取不到的\n        // 借贷方本位币金额比较\n        BigDecimal drAccounted = drLoanAccount.getAccounted();\n        BigDecimal crAccounted = crLoanAccount.getAccounted();\n        LoanAccount scLoanAccount;\n        if (null != ruleDR.getServiceCharge() && ruleDR.getServiceCharge().compareTo(BigDecimal.ZERO) > 0 &&\n                StringUtils.isNotBlank(ruleDR.getTaxSegment3())) {\n            // 有手续费\n            logger.info(\"ruleDR.getServiceCharge: {}\", ruleDR.getServiceCharge());\n            scLoanAccount = getForeignExchangeAccountsByRuleDR(ruleDR, SERVICE_CHARGE);\n            re.add(scLoanAccount);\n            drAccounted = drAccounted.add(scLoanAccount.getAccounted());\n        }\n        if (null != ruleCR.getExchangeRate() && null != ruleDR.getExchangeRate()) {\n            // 有汇率时生成投资和汇兑损益\n            // 相减取绝对值\n            BigDecimal difference = drAccounted.subtract(crAccounted).abs();\n            logger.info(\"drAccounted.subtract(crAccounted).abs(): {}, \", difference);\n            ruleCR.setPlAmount(difference);\n            ruleDR.setPlAmount(difference);\n            // todo 投资损益和汇兑损益同时存在时如何双方金额相同的？\n            if (StringUtils.isNotBlank(ruleCR.getPlInSegment3()) && !((difference.compareTo(BigDecimal.ZERO)) == 0)) {\n                // 创建投资损益分录行\n                if ((drAccounted.compareTo(crAccounted)) > 0) {\n                    // 贷方\n                    re.add(getForeignExchangeAccountsByRuleCR(ruleCR, INVESTMENT));\n                } else {\n                    // 借方\n                    re.add(getForeignExchangeAccountsByRuleDR(ruleDR, INVESTMENT));\n                }\n            }\n            if (StringUtils.isNotBlank(ruleCR.getPlFeSegment3()) && !((difference.compareTo(BigDecimal.ZERO)) == 0)) {\n                // 创建汇兑损益分录行\n                if ((drAccounted.compareTo(crAccounted)) > 0) {\n                    // 贷方\n                    re.add(getForeignExchangeAccountsByRuleCR(ruleCR, REMITTANCE));\n                } else {\n                    // 借方\n                    re.add(getForeignExchangeAccountsByRuleDR(ruleDR, REMITTANCE));\n                }\n            }\n        }\n\n        for (int i = 0; i < re.size(); i++) {\n            re.get(i).setJeLineNum(i + 1);\n        }\n        return re;\n    }\n\n    /**\n     * 根据事件ID 组装应收票据交易事件记账用数据  贴现生成五条\n     */\n    private List<LoanAccount> assembleBillReceivableAccount(Long eventId) {\n        List<LoanAccount> re = new ArrayList<>();\n        List<String> types = new ArrayList<>();\n        // 应收票据\n        types.add(BillConstants.BILL_CATEGORY_NOTEREC);\n        //  先查询已保存的事件记账\n        List<LoanAccount> saved = this.getSavedAccouts(eventId, types, null);\n        if (saved.size() > 0) {\n            return saved;\n        }\n        // 获取带记账规则的事 件信息\n        LoanAccount rule = this.getBillReceivableAccountWithRule(eventId);\n        if (!StringUtils.equals(rule.getTrxCurrencyCode(), rule.getLedgerCurrencyCode())) {\n            TmsExchangeRate rate = this.selectExchangeRate(rule.getTrxCurrencyCode(), rule.getLedgerCurrencyCode(),\n                    rule.getAccountingDate());\n            if (rate != null) {\n                rule.setExchangeRate(rate.getRate());\n                rule.setExchangeRateStr(rate.getRate().stripTrailingZeros().toPlainString());\n            }\n        } else {\n            rule.setExchangeRate(BigDecimal.ONE);\n            rule.setExchangeRateStr(rule.getExchangeRate().stripTrailingZeros().toPlainString());\n        }\n        // 贷方\n        re.add(getBillReceivableAccountsByRuleCR(rule));\n        // 借方\n        re.add(getBillReceivableAccountsByRuleDR(rule, false));\n        // 贴现待特殊处理\n        /*if (BillConstants.EVENT_TYPE_DISCOUNT.equals(rule.getEventType())) {\n            // 借方\n            re.add(getBillReceivableAccountsByRuleDR(rule, true));\n            discountLoanSpecialHandle(rule, re);\n        }*/\n        for (int i = 0; i < re.size(); i++) {\n            re.get(i).setJeLineNum(i + 1);\n        }\n        return re;\n    }\n\n    /**\n     * 贴现特殊处理 按照收票事件生成两条，然后更新部分字段\n     *\n     * @param rule\n     * @param re\n     */\n    public void discountLoanSpecialHandle(LoanAccount rule, List<LoanAccount> re) {\n        TmsBillManagementExample tmsBillManagementExample = new TmsBillManagementExample();\n        tmsBillManagementExample.createCriteria().andBillNumEqualTo(rule.getRequestNumber());\n        List<TmsBillManagement> billManagements = tmsBillManagementDAO.selectByExample(tmsBillManagementExample);\n        List<Long> billIds = billManagements.stream().map(TmsBillManagement::getBillId)\n                .distinct().collect(Collectors.toList());\n\n        TmsBillTrxEventExample tmsBillTrxEventExample = new TmsBillTrxEventExample();\n        tmsBillTrxEventExample.createCriteria().andBillIdIn(billIds)\n                .andEventTypeEqualTo(BillConstants.EVENT_TYPE_INVOICE);\n        List<TmsBillTrxEvent> eventList = billTrxEventDAO.selectByExample(tmsBillTrxEventExample);\n        if (CollectionUtils.isEmpty(eventList)) {\n            String message = \"应收票据交易事件ID：\" + rule.getEventId() + \"未找到对应的收票事件！\";\n            LOGGER.error(message);\n            throw new RuntimeException(message);\n        }\n\n        // 获取带记账规则的事件信息\n        LoanAccount ruleTwo = this.getBillReceivableAccountWithRule(eventList.get(0).getEventId());\n        if (!StringUtils.equals(ruleTwo.getTrxCurrencyCode(), ruleTwo.getLedgerCurrencyCode())) {\n            TmsExchangeRate rate = this.selectExchangeRate(ruleTwo.getTrxCurrencyCode(),\n                    ruleTwo.getLedgerCurrencyCode(), ruleTwo.getAccountingDate());\n            if (rate != null) {\n                ruleTwo.setExchangeRate(rate.getRate());\n                ruleTwo.setExchangeRateStr(rate.getRate().stripTrailingZeros().toPlainString());\n            }\n        } else {\n            ruleTwo.setExchangeRate(BigDecimal.ONE);\n            ruleTwo.setExchangeRateStr(ruleTwo.getExchangeRate().stripTrailingZeros().toPlainString());\n        }\n        ruleTwo.setEntered(rule.getBillAmount());\n        LoanAccount first = re.get(0);\n        // 贷方\n        LoanAccount cr = getBillReceivableAccountsByRuleCR(ruleTwo);\n        cr.setEventNumber(rule.getEventNumber());\n        cr.setEventId(rule.getEventId());\n        cr.setAccountingDate(first.getAccountingDate());\n        cr.setAccountPeriod(first.getAccountPeriod());\n        cr.setDirection(LoanConstants.LOAN_GL_DIRECTION_DR);\n        cr.setAccountedDr(cr.getAccountedCr());\n        cr.setAccountedCr(null);\n        cr.setEventType(first.getEventType());\n        cr.setNaryur(\"应收票据贴现\" + SYMBOL + rule.getRequestNumber());\n\n        re.add(cr);\n        // 借方\n        LoanAccount dr = getBillReceivableAccountsByRuleDR(ruleTwo, false);\n        dr.setEventNumber(rule.getEventNumber());\n        dr.setEventId(rule.getEventId());\n        dr.setAccountingDate(first.getAccountingDate());\n        dr.setAccountPeriod(first.getAccountPeriod());\n        dr.setDirection(LoanConstants.LOAN_GL_DIRECTION_CR);\n        dr.setAccountedCr(dr.getAccountedDr());\n        dr.setAccountedDr(null);\n        dr.setEventType(first.getEventType());\n        dr.setNaryur(\"应收票据贴现\" + SYMBOL + rule.getRequestNumber());\n\n        re.add(dr);\n    }\n\n    @Override\n    public TmsExchangeRate selectExchangeRate(String baseCurrency, String invoicingCurrency, Date rateDate) {\n        ExchangeRateQueryDto dto = new ExchangeRateQueryDto();\n        dto.setBaseCurrency(baseCurrency);\n        dto.setInvoicingCurrency(invoicingCurrency);\n        dto.setRateType(BD_PERIOD_END);\n        dto.setRateDate(DateUtils.getMonthLastDate(rateDate));\n        List<TmsExchangeRate> rateList = exchangeRateService.selecRateList(dto);\n        if (CollectionUtils.isEmpty(rateList) || rateList.size() > 1) {\n            LOGGER.info(\"基本货币{} 计价货币{} 没有查到汇率信息或者查到多条\", baseCurrency, invoicingCurrency);\n            return null;\n        }\n        return rateList.get(0);\n    }\n\n    /**\n     * 根据ID 组装理财交易计提利息记账用数据\n     *\n     * @param accrualId\n     * @return\n     */\n    private List<LoanAccount> assembleDealAccrualAccount(Long accrualId) {\n        List<LoanAccount> re = new ArrayList();\n        List<String> types = new ArrayList<>();\n        types.add(DealTypeConstants.DEAL_INTEREST_ACCRUAL); // 计提利息类别\n        types.add(TERMDEPOSIT);\n        types.add(TERMFINANCING);\n        //  先查询已保存的事件记账\n        List<LoanAccount> saved = this.getSavedAccouts(null, types, accrualId);\n        if (saved.size() > 0) {\n            return saved;\n        }\n        // 获取带记账规则的事 件信息\n        List<LoanAccount> rules = this.loanAccountDao.getDealAccrualAccounts(accrualId);\n        fndFlexValueApi.translate(rules,\n                \"eventType\", BizConstants.FndFlexSet.TMS_DEAL_TRASACTIONTYPE);\n        List<LoanAccount> reclassifyRules = rules.stream().filter(loanAccount -> StringUtils.equals(loanAccount\n                .getReclassifyFlag(), Y)).collect(Collectors.toList());\n        // 重分类计提记账规则信息必须是两条结果: 长期和短期科目信息，缺少任何一条都会报错\n        if (CollectionUtils.isEmpty(rules) || (CollectionUtils.isNotEmpty(reclassifyRules) && reclassifyRules\n                .size() != 2 && !StringUtils.equals(rules.get(0).getEventType(), LoanConstants.TMS_DEAL_ACCEVENTTYPE_A07))) {\n            // 无匹配的会计事件记账规则或记账规则设置错误，请检查后重新提交。\n            String message = msgManageApi.getMsg(LoanConstants.TMS_NOACCOUNTRULE);\n            LOGGER.error(\"理财计提利息ID：\" + accrualId + \"无匹配的记账规则或记账规则设置错误！\");\n            throw new RuntimeException(message);\n        }\n        List<String> type = Arrays.asList(LONG_TERM, NONE);\n        TmsExchangeRate rate = null;\n        boolean impairmentFlag = true;\n        for (LoanAccount rule : rules) {\n            if (StringUtils.equals(rule.getEventType(), LoanConstants.TMS_DEAL_ACCEVENTTYPE_A07)) {\n                LOGGER.info(\"EventType is A07, ProcessType = \" + rule.getProcessType());\n                if (rule.getProcessType().equals(TERMDEPOSIT)) {\n                    rule.setTrxCategory(TERMDEPOSIT);\n                } else {\n                    rule.setTrxCategory(TERMFINANCING);\n                }\n            } else {\n                // 理财计提设置默认trx_type（自动冲销使用）\n                rule.setTrxCategory(DealTypeConstants.DEAL_INTEREST_ACCRUAL);\n            }\n            Date accountingDate = DateUtils.getLastDayOfMonthMMM(rule.getAccountPeriod());\n            if (accountingDate == null) {\n                throw new RuntimeException(\"获取GL日期异常,请联系管理员协助处理。\");\n            }\n            rule.setAccountingDate(accountingDate);\n            if (rate == null && !StringUtils.equals(rule.getTrxCurrencyCode(), rule.getLedgerCurrencyCode())) {\n                rate = this.selectExchangeRate(rule.getTrxCurrencyCode(), rule.getLedgerCurrencyCode(),\n                        rule.getAccountingDate());\n            }\n            if (rate != null) {\n                rule.setExchangeRate(rate.getRate());\n                rule.setExchangeRateStr(rate.getRate().stripTrailingZeros().toPlainString());\n            }\n            // 重分类 定期理财：贷方 -- 长期 / 定期存款：贷方 -- NONE\n            if (StringUtils.equals(rule.getReclassifyFlag(), Y) && type.contains(rule.getLstcod())) {\n                re.addAll(getFinancialAccountsByRuleCR(rule, LONG_TERM));\n            }\n            // 重分类 -- 短期\n            if (StringUtils.equals(rule.getReclassifyFlag(), Y) && StringUtils.equals(rule.getLstcod(), SHORT_TERM)) {\n                // 贷方\n                re.addAll(getFinancialAccountsByRuleCR(rule, SHORT_TERM));\n                // 借方\n                re.addAll(getFinancialAccountsByRuleDR(rule));\n            }\n            // 非重分类\n            if (!StringUtils.equals(rule.getReclassifyFlag(), Y)) {\n                // 贷方\n                re.addAll(getFinancialAccountsByRuleCR(rule, null));\n                // 借方\n                re.addAll(getFinancialAccountsByRuleDR(rule));\n            }\n            // 季度末做减值准备分录\n            if (ifQuarterEnd(rule.getAccountPeriod()) && impairmentFlag\n                    && StringUtils.equals(rule.getAccrualType(), LoanConstants.TMS_DEAL_ACCEVENTTYPE_A03)\n                    && ((TERMDEPOSIT.equals(rule.getProcessType()) && rule.getDaysDeposit() > 92)\n                    || TERMFINANCING.equals(rule.getProcessType()))) {\n                // 当该交易已经重分类时，取该交易类型下计提应收利息会计事件、长短期标识为短期的记账规则中配置的减值准备科目\n                if (Y.equalsIgnoreCase(rule.getReclassifyFlag())\n                        && !StringUtils.equals(rule.getLstcod(), SHORT_TERM)) {\n                    continue;\n                }\n                impairmentFlag = false;\n                List<FndFlexValue> flexValueList = this.getFlexValue();\n                flexValueList = flexValueList.stream().filter(o ->\n                        StringUtils.equals(o.getFlexValue(), \"RATE\")).collect(Collectors.toList());\n                if (CollectionUtils.isEmpty(flexValueList)) {\n                    throw new RuntimeException(\"获取TMS_DR_PARAMETER值集数据异常,请联系管理员协助处理。\");\n                }\n                FndFlexValue flexValue = flexValueList.get(0);\n                BigDecimal originBalance = rule.getTrxBalance().add(rule.getEntered())\n                        .multiply(new BigDecimal(flexValue.getMeaning()))\n                        .abs().setScale(2, BigDecimal.ROUND_HALF_UP);\n                BigDecimal newBalance;\n                if (rule.getExchangeRate() != null) {\n                    newBalance = originBalance.multiply(rule.getExchangeRate()).setScale(2,\n                            BigDecimal.ROUND_HALF_UP);\n                } else {\n                    newBalance = originBalance.multiply(BigDecimal.ONE);\n                }\n                // 贷方\n                List<LoanAccount> tempCrList = getFinancialAccountsByRuleCR(rule, null);\n                tempCrList.forEach(loanAccount -> {\n                    loanAccount.setEntered(originBalance);\n                    loanAccount.setAccountedCr(newBalance);\n                    loanAccount.setAccounted(newBalance);\n                    loanAccount.setSegment3(rule.getImpairmentCrSegment3());\n                    loanAccount.setNaryur(loanAccount.getNaryur().replaceAll(\"计提应收利息\", \"计提减值准备\"));\n                });\n                re.addAll(tempCrList);\n                // 借方\n                List<LoanAccount> tempDrList = getFinancialAccountsByRuleDR(rule);\n                tempDrList.forEach(loanAccount -> {\n                    loanAccount.setEntered(originBalance);\n                    loanAccount.setAccountedDr(newBalance);\n                    loanAccount.setAccounted(newBalance);\n                    loanAccount.setSegment3(rule.getImpairmentDrSegment3());\n                    loanAccount.setNaryur(loanAccount.getNaryur().replaceAll(\"计提应收利息\", \"计提减值准备\"));\n                });\n                re.addAll(tempDrList);\n            }\n        }\n        return re;\n    }\n\n    /**\n     * 获取值集TMS_DR_PARAMETER\n     */\n    public List<FndFlexValue> getFlexValue() {\n        FndFlexValue fndFlexValue = new FndFlexValue();\n        fndFlexValue.setFlexValueSetName(BizConstants.FndFlexSet.TMS_DR_PARAMETER);\n        fndFlexValue.setEnableFlag(\"Y\");\n        fndFlexValue.setLanguage(LangEnv.getLang());\n\n        return fndFlexValueService.selectValueByCondition(fndFlexValue, null).getList();\n    }\n\n    /**\n     * 判断会计区间是否季度末\n     *\n     * @param accountPeriod\n     * @return\n     */\n    private boolean ifQuarterEnd(String accountPeriod) {\n        if (StringUtils.isBlank(accountPeriod) && 6 != accountPeriod.length()) {\n            return false;\n        }\n        List<String> quarterEndList = Arrays.asList(\"MAR\", \"JUN\", \"SEP\", \"DEC\");\n        if (quarterEndList.contains(accountPeriod.substring(0, 3))) {\n            return true;\n        }\n        return false;\n    }\n\n    //  已保存的记账信息\n    private List<LoanAccount> getSavedAccouts(Long evnentId, List<String> trxCategory, Long accrualId) {\n        TmsLoanAccountExample example = new TmsLoanAccountExample();\n        TmsLoanAccountExample.Criteria criteria = example.createCriteria();\n        if (evnentId != null) {\n            criteria.andEventIdEqualTo(evnentId);\n        }\n        if (accrualId != null) {\n            criteria.andAccrualIdEqualTo(accrualId);\n        }\n        criteria.andTrxCategoryIn(trxCategory);\n        criteria.andApproveStatusIn(Arrays.asList(LoanConstants.LOAN_GL_APPROVE_STATUS_N,\n                LoanConstants.LOAN_GL_APPROVE_STATUS_R)); // 已保存 已拒绝\n        List<TmsLoanAccount> las = this.dao.selectByExample(example);\n        return las.stream().map(la -> {\n            LoanAccount lat = new LoanAccount();\n            BeanUtils.copyProperties(la, lat);\n            String exchangeRateStr = la.getExchangeRate().stripTrailingZeros().toPlainString();\n            lat.setExchangeRateStr(exchangeRateStr);\n            return lat;\n        }).collect(Collectors.toList());\n    }\n\n    // 对分录按照 借贷进行排序\n    private void sortAccouts(List<LoanAccount> las) {\n        Collections.sort(las, new Comparator<LoanAccount>() {\n            @Override\n            public int compare(LoanAccount o1, LoanAccount o2) {\n                return o2.getDirection().compareTo(o1.getDirection());\n            }\n        });\n    }\n\n    // 获取带记账规则的事 件信息\n    private List<LoanAccount> getAccountWithRuleXin(Long evnentId) {\n        List<LoanAccount> rules = this.loanAccountDao.getAccountsSettlement(evnentId);\n        if (null != rules) {\n            fndFlexValueApi.translate(rules,\n                    \"eventType\", BizConstants.FndFlexSet.TMS_DEAL_TRASACTIONTYPE);\n            return rules;\n        } else {\n            String message = msgManageApi.getMsg(LoanConstants.TMS_NOACCOUNTRULE);\n            LOGGER.error(\"交易事件ID：\" + evnentId + \"无匹配的记账规则或记账规则设置错误！\");\n            throw new RuntimeException(message);\n        }\n    }\n\n    // 获取带记账规则的第三方余额结转信息\n    private LoanAccount getThirdBalanceWithRule(Long balanceId) {\n        List<LoanAccount> rules = this.loanAccountDao.getThirdBalanceAccounts(balanceId);\n        if (CollectionUtils.isEmpty(rules)) {\n            // 无匹配的会计事件记账规则或记账规则设置错误，请检查后重新提交。\n            String message = msgManageApi.getMsg(LoanConstants.TMS_NOACCOUNTRULE);\n            LOGGER.error(\"第三方余额ID：\" + balanceId + \"无匹配的记账规则或记账规则设置错误！\");\n            throw new RuntimeException(message);\n        } else if (rules.size() == 1) {\n            return rules.get(0);\n        } else {\n            throw new RuntimeException(\"账号:\" + rules.get(0).getAccountNo() + \"存在多条入账规则，请调整后重新创建分录\");\n        }\n    }\n\n    // 获取带记账规则的资金划拨贷方信息\n    private LoanAccount getTransferAccountWithRuleXin(Long transferId) {\n        LoanAccount rule = this.loanAccountDao.getTransferAccountsCR(transferId);\n        if (null != rule) {\n            return rule;\n        } else {\n            // 无匹配的会计事件记账规则或记账规则设置错误，请检查后重新提交。\n            String message = msgManageApi.getMsg(LoanConstants.TMS_NOACCOUNTRULE);\n            LOGGER.error(\"资金划拨单ID：\" + transferId + \"无匹配的记账规则或记账规则设置错误！\");\n            throw new RuntimeException(message);\n        }\n    }\n\n    // 获取带记账规则的理财交易借贷方信息\n    private LoanAccount getFinancialAccountWithRule(Long eventId) {\n        LoanAccount rule = this.loanAccountDao.getFinancialAccounts(eventId);\n        if (null != rule) {\n            fndFlexValueApi.translate(rule,\n                    \"eventType\", BizConstants.FndFlexSet.TMS_DEAL_TRASACTIONTYPE);\n            return rule;\n        } else {\n            // 无匹配的会计事件记账规则或记账规则设置错误，请检查后重新提交。\n            String message = msgManageApi.getMsg(LoanConstants.TMS_NOACCOUNTRULE);\n            LOGGER.error(\"理财交易事件ID：\" + eventId + \"无匹配的记账规则或记账规则设置错误！\");\n            throw new RuntimeException(message);\n        }\n    }\n\n    public LoanAccount getForeignExchangeAccountWithRuleCR(Long eventId) {\n        LoanAccount rule = loanAccountDao.getForeignExchangeAccountsCR(eventId);\n        if (null != rule) {\n            return rule;\n        } else {\n            // 无匹配的会计事件记账规则或记账规则设置错误，请检查后重新提交。\n            String message = msgManageApi.getMsg(LoanConstants.TMS_NOACCOUNTRULE);\n            LOGGER.error(\"外汇交易单ID：\" + eventId + \"无匹配的记账规则或记账规则设置错误！\");\n            throw new RuntimeException(message);\n        }\n    }\n\n    public LoanAccount getForeignExchangeAccountWithRuleDR(Long eventId) {\n        LoanAccount rule = loanAccountDao.getForeignExchangeAccountsDR(eventId);\n        if (null != rule) {\n            return rule;\n        } else {\n            // 无匹配的会计事件记账规则或记账规则设置错误，请检查后重新提交。\n            String message = msgManageApi.getMsg(LoanConstants.TMS_NOACCOUNTRULE);\n            LOGGER.error(\"外汇交易单ID：\" + eventId + \"无匹配的记账规则或记账规则设置错误！\");\n            throw new RuntimeException(message);\n        }\n    }\n\n    // 获取带记账规则的理财交易借贷方信息\n    private LoanAccount getBillReceivableAccountWithRule(Long eventId) {\n        LoanAccount rule = this.loanAccountDao.getBillReceivableAccounts(eventId);\n        if (null != rule) {\n            fndFlexValueApi.translate(rule,\n                    \"eventType\", BizConstants.FndFlexSet.TMS_NOTE_TRASACTIONTYPE);\n            return rule;\n        } else {\n            // 无匹配的会计事件记账规则或记账规则设置错误，请检查后重新提交。\n            String message = msgManageApi.getMsg(LoanConstants.TMS_NOACCOUNTRULE);\n            LOGGER.error(\"应收票据交易事件ID：\" + eventId + \"无匹配的记账规则或记账规则设置错误！\");\n            throw new RuntimeException(message);\n        }\n    }\n\n    // 获取带记账规则的净值理财交易信息\n    private List<LoanAccount> getValueAccountWithRule(Long evnentId) {\n        List<LoanAccount> rules = this.loanAccountDao.getValueAccounts(evnentId);\n        if (CollectionUtils.isNotEmpty(rules)) {\n            fndFlexValueApi.translate(rules,\n                    \"eventType\", BizConstants.FndFlexSet.TMS_DEAL_TRASACTIONTYPE);\n            return rules;\n        } else {\n            String message = msgManageApi.getMsg(LoanConstants.TMS_NOACCOUNTRULE);\n            LOGGER.error(\"净值理财单据ID：\" + evnentId + \"无匹配的记账规则或记账规则设置错误！\");\n            throw new RuntimeException(message);\n        }\n    }\n\n    // 获取带记账规则的事件信息（原）\n    private LoanAccount getAccountWithRule(Long evnentId) {\n        List<LoanAccount> rules = this.loanAccountDao.getAccounts(evnentId);\n        if (null != rules && rules.size() == 1) {\n            LoanAccount rule = rules.get(0);\n            fndFlexValueApi.translate(rule,\n                    \"eventType\", BizConstants.FndFlexSet.TMS_DEAL_TRASACTIONTYPE);\n            return rule;\n        } else {\n            String message = msgManageApi.getMsg(LoanConstants.TMS_NOACCOUNTRULE);\n            LOGGER.error(\"交易事件ID：\" + evnentId + \"无匹配的记账规则或记账规则设置错误！\");\n            throw new RuntimeException(message);\n        }\n    }\n\n    // 获取带记账规则的资金划拨借方信息\n    private LoanAccount getTransferAccountWithRule(Long transferId) {\n        LoanAccount rule = this.loanAccountDao.getTransferAccountsDR(transferId);\n        if (null != rule) {\n            return rule;\n        } else {\n            String message = msgManageApi.getMsg(LoanConstants.TMS_NOACCOUNTRULE);\n            LOGGER.error(\"交易事件ID：\" + transferId + \"无匹配的记账规则或记账规则设置错误！\");\n            throw new RuntimeException(message);\n        }\n    }\n\n    /**\n     * 组装净值理财分录明细数据：生成借方和贷方分录\n     *\n     * @param rule\n     * @param direction\n     * @return\n     */\n    private LoanAccount getValueAccounts(LoanAccount rule, String direction, Date accountingDate) {\n        LoanAccount account = new LoanAccount();\n        BeanUtils.copyProperties(rule, account);\n        account.setDirection(direction);\n        account.setAccountingDate(accountingDate);\n        account.setTrxCategory(DEAL_PRODUCT_NETVALUE);\n        account.setEventType(LoanConstants.TMS_DEAL_ACCEVENTTYPE_A06);\n        if (StringUtils.equals(rule.getReclassifyFlag(), Y) && StringUtils.equals(rule.getLstcod(), SHORT_TERM)\n                && LoanConstants.LOAN_GL_DIRECTION_CR.equals(direction)) {\n            account.setEntered(rule.getReclassifyAmount());\n        }\n        if (rule.getExchangeRate() != null) {\n            account.setAccounted(account.getEntered().multiply(rule.getExchangeRate()).setScale(2,\n                    BigDecimal.ROUND_HALF_UP));\n        } else {\n            account.setExchangeRate(BigDecimal.ONE);\n            account.setExchangeRateStr(BigDecimal.ONE.toString());\n            account.setAccounted(account.getEntered().multiply(BigDecimal.ONE));\n        }\n        if (LoanConstants.LOAN_GL_DIRECTION_DR.equals(direction)) {\n            account.setSegment3(rule.getDrSegment3());\n            account.setAccountedDr(account.getAccounted().abs());\n        } else if (LoanConstants.LOAN_GL_DIRECTION_CR.equals(direction)) {\n            account.setSegment3(rule.getCrSegment3());\n            account.setAccountedCr(account.getAccounted().abs());\n        }\n        account.setNaryur(account.getTrxTypeName() + SYMBOL + account.getRequestNumber());\n        // 默认值\n        account.setSegment2(\"0\");\n        account.setSegment4(\"000\");\n        account.setSegment5(\"00\");\n        account.setSegment6(\"0\");\n        account.setSegment7(\"0\");\n        account.setSegment8(\"0\");\n        return account;\n    }\n\n    // 根据记账规则 生成数据(借方)\n    private List<LoanAccount> getAccountsByRuleDR(LoanAccount rule) {\n        List<LoanAccount> re = new ArrayList<>();\n        // 公司间贷款 交易事件都是一借一贷 后续贷款业务再加\n        LoanAccount debit = new LoanAccount();\n        // 账期根据 实际付款时期（入账日期）生成\n        String accountPeriod = DateUtils.formatLocalDate(rule.getAccountingDate(), Locale.ENGLISH, \"MMM-yy\")\n                .toUpperCase();\n        rule.setAccountingDate(DateUtils.formatDateOfZero(rule.getAccountingDate()));\n        BeanUtils.copyProperties(rule, debit);\n        debit.setDirection(LoanConstants.LOAN_GL_DIRECTION_DR);\n        debit.setAccountPeriod(accountPeriod);\n        debit.setTrxCategory(BUSINESS_TYPE_INTERCOMPANY);\n        debit.setEntered(debit.getEntered().abs());\n        if (rule.getExchangeRate() != null) {\n            debit.setAccounted(debit.getEntered().multiply(rule.getExchangeRate()).setScale(2,\n                    BigDecimal.ROUND_HALF_UP));\n        } else {\n            debit.setAccounted(debit.getEntered().multiply(BigDecimal.ONE));\n        }\n        if (StringUtils.equals(rule.getEventType(), LoanConstants.EVENT_TYPE_ZFBJ)) {\n            // 借方\n            debit.setSegment3(rule.getDrSegment3());\n            debit.setSegment5(rule.getCounterpartyCode());\n        } else if (StringUtils.equals(rule.getEventType(), LoanConstants.EVENT_TYPE_SDLX)) {\n            debit.setSegment3(rule.getFinAccount());\n            debit.setSegment5(\"00\");\n        } else if (StringUtils.equals(rule.getEventType(), LoanConstants.EVENT_TYPE_SHBJ)) {\n            debit.setSegment3(rule.getFinAccount());\n            debit.setSegment5(\"00\");\n        } else if (StringUtils.equals(rule.getEventType(), LoanConstants.EVENT_TYPE_SDJK)) {\n            debit.setSegment3(rule.getFinAccount());\n            debit.setSegment5(\"00\");\n        } else if (StringUtils.equals(rule.getEventType(), LoanConstants.EVENT_TYPE_ZFLX)) {\n            debit.setSegment3(rule.getDrSegment3());\n            debit.setSegment5(rule.getCounterpartyCode());\n        } else if (StringUtils.equals(rule.getEventType(), LoanConstants.EVENT_TYPE_GHBJ)) {\n            debit.setSegment3(rule.getDrSegment3());\n            debit.setSegment5(rule.getCounterpartyCode());\n        }\n\n        // 如果对手方公司为外部公司 则内网段为 “00”\n        if (!StringUtils.equals(rule.getCounterpartyType(), LoanConstants.CUNTERPARTY_TYPE_COMPANY)) {\n            debit.setSegment5(\"00\");\n        }\n        debit.setNaryur(debit.getTrxTypeName() + SYMBOL + debit.getEventTypeName() + SYMBOL + debit.getRequestNumber());\n        re.add(debit);\n        dealAccountDefaultValues(re);\n        return re;\n    }\n\n    // 根据记账规则 生成数据 -- 收入(借方)\n    private List<LoanAccount> getTransferAccountsByRuleDR(LoanAccount rule) {\n        List<LoanAccount> re = new ArrayList<>();\n        // 公司间贷款 交易事件都是一借一贷 后续贷款业务再加\n        LoanAccount debit = new LoanAccount();\n        // 账期根据 实际付款时期（入账日期）生成\n        String accountPeriod = DateUtils.formatLocalDate(rule.getAccountingDate(), Locale.ENGLISH, \"MMM-yy\")\n                .toUpperCase();\n        rule.setAccountingDate(DateUtils.formatDateOfZero(rule.getAccountingDate()));\n        BeanUtils.copyProperties(rule, debit);\n        debit.setDirection(LoanConstants.LOAN_GL_DIRECTION_DR);\n        debit.setAccountPeriod(accountPeriod);\n        if (StringUtils.equals(IFT, rule.getTransferType())) {\n            // 公司内 -- 支出（借）\n            debit.setSegment2(\"0\");\n            debit.setSegment3(rule.getFinAccount());\n            debit.setSegment5(\"00\");\n            debit.setSegment7(\"0\");\n        } else if (StringUtils.equals(CFT, rule.getTransferType()) && StringUtils.equals(rule.getEventType(),\n                EVENT_TYPE_ZC)) {\n            // 公司间--支出（借）\n            debit.setSegment3(StringUtils.isBlank(\n                    rule.getDrSegment3()) == true ? rule.getFinAccount() : rule.getDrSegment3());\n            debit.setSegment5(rule.getCounterpartyCode());\n            // 非镜像单取付款主体BG\n            debit.setSegment7(rule.getPayBgCode());\n            if (StringUtils.isNotBlank(rule.getPayBgCode())) {\n                // 查找BG对应的成本中心\n                FndFlexValueDTO valueDTO = fndFlexValueApi.selectByType(TMS_BG_CET_MAPPING, rule.getPayBgCode());\n                if (valueDTO != null) {\n                    debit.setSegment2(valueDTO.getMeaning());\n                }\n            }\n            // todo：非镜像单据，且为第三方单据，存在paySubject，需要用存在paySubject代替科目\n        } else if (StringUtils.equals(CFT, rule.getTransferType()) && StringUtils.equals(rule.getEventType(),\n                EVENT_TYPE_SR)) {\n            debit.setSegment2(\"0\");\n            // 公司间--收入（借）\n            debit.setSegment3(StringUtils.isBlank(\n                    rule.getDrSegment3()) == true ? rule.getFinAccount() : rule.getDrSegment3());\n            debit.setSegment5(\"00\");\n            debit.setSegment7(\"0\");\n        }\n        if (rule.getExchangeRate() != null) {\n            debit.setAccounted(debit.getEntered().multiply(rule.getExchangeRate()).setScale(2,\n                    BigDecimal.ROUND_HALF_UP));\n        } else {\n            debit.setAccounted(debit.getEntered().multiply(BigDecimal.ONE));\n        }\n        debit.setAccountedDr(debit.getAccounted());\n        debit.setNaryur(debit.getTrxTypeName() + debit.getEventNumber());\n        debit.setTrxCategory(rule.getTransferType());\n        // CFT + 支出方向 + sourceSysCode + 存在paySubject，用paySubject代替科目\n        if (StringUtils.equals(CFT, rule.getTransferType()) && StringUtils.equals(rule.getEventType(), EVENT_TYPE_ZC)\n                && StringUtils.isNotBlank(rule.getThirdPaySubject()) && StringUtils.isNotBlank(rule.getSourceSysCode())) {\n            resetLoanAccountSegment(rule.getThirdPaySubject(), debit);\n        } else {\n            transAccountDefaultValues(debit);\n        }\n        re.add(debit);\n        return re;\n    }\n\n    // 根据记账规则 生成资金划拨记账数据--支出（贷方）\n    private List<LoanAccount> getTransferAccountsByRuleCR(LoanAccount rule) {\n        List<LoanAccount> re = new ArrayList<>();\n        LoanAccount debit = new LoanAccount();\n        // 账期根据 实际付款时期（入账日期）生成\n        String accountPeriod = DateUtils.formatLocalDate(rule.getAccountingDate(), Locale.ENGLISH, \"MMM-yy\")\n                .toUpperCase();\n        rule.setAccountingDate(DateUtils.formatDateOfZero(rule.getAccountingDate()));\n        BeanUtils.copyProperties(rule, debit);\n        debit.setDirection(LoanConstants.LOAN_GL_DIRECTION_CR);\n        debit.setAccountPeriod(accountPeriod);\n        if (StringUtils.equals(IFT, rule.getTransferType())) {\n            // 公司内 -- 支出（贷）\n            debit.setSegment2(\"0\");\n            debit.setSegment3(rule.getFinAccount()); // 科目段\n            debit.setSegment5(\"00\"); // 内往段待确认\n            debit.setSegment7(\"0\");\n        } else if (StringUtils.equals(CFT, rule.getTransferType()) && StringUtils.equals(rule.getEventType(),\n                EVENT_TYPE_ZC)) {\n            // 公司间 -- 支出（贷）\n            debit.setSegment2(\"0\");\n    