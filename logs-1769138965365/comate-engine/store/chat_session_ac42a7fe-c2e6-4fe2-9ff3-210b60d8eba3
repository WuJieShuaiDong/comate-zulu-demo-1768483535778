 ex 认证异常\n     * @return 401响应\n     */\n    @ExceptionHandler(value = {AuthException.class})\n    @ResponseBody\n    public ResponseEntity<ResponseMessage> handleAuthException(AuthException ex) {\n        log.warn(\"Authentication failed: {}\", ex.getMessage());\n        return new ResponseEntity<>(\n            new ResponseMessage(ResponseMessage.FAIL, ex.getMessage()),\n            HttpStatus.UNAUTHORIZED\n        );\n    }\n\n    /**\n     * 初始化数据绑定（适用于Content-Type: multipart/form-data的数据,\n     * Content-Type为json的数据通过MappingJackson2HttpMessageConverter序列化与反序列化）\n     *\n     * @param binder\n     */\n    @InitBinder\n    public void initBinder(WebDataBinder binder) {\n        // 将传入的String类型的Date数据转换成Date（类似Json反序列化）\n        binder.registerCustomEditor(Date.class, new PropertyEditorSupport() {\n            @Override\n            public void setAsText(String text) {\n                try {\n                    setValue(DateUtils.parseDate(text));\n                } catch (Exception e) {\n                    e.printStackTrace();\n                }\n            }\n        });\n    }\n\n}\n"
