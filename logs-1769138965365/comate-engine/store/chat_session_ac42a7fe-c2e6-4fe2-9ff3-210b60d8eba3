ts[0];\n        if (supId == null || supId.isEmpty()) {\n            log.error(\"doSupPortalAuthenticate supId is null\");\n            response.sendError(HttpServletResponse.SC_UNAUTHORIZED, \"鉴权信息缺失\");\n            return false;\n        }\n\n        String loginAccount = parts[1];\n        if (loginAccount == null || loginAccount.isEmpty()) {\n            log.error(\"doSupPortalAuthenticate loginAccount is null\");\n            response.sendError(HttpServletResponse.SC_UNAUTHORIZED, \"鉴权信息缺失\");\n            return false;\n        }\n\n        // ===== 3. 存入ThreadLocal =====\n        PmcPortalLogin.LoginInfo loginInfo = new PmcPortalLogin.LoginInfo();\n        loginInfo.setSupId(supId);\n        loginInfo.setLoginAccount(loginAccount);\n        PmcPortalLogin.setLoginInfo(loginInfo);\n\n        return true;\n    }\n\n    @Override\n    public void afterCompletion(HttpServletRequest request, HttpServletResponse response, Object handler, Exception ex) {\n        // 清理ThreadLocal, 防止内存泄漏\n        PmcPortalLogin.clear();\n    }\n}",
