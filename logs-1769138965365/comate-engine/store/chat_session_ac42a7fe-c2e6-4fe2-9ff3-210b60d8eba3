tions) {\n            strBuilder.append(violation.getMessage() + \"\\n\");\n        }\n        return new ResponseEntity<>(new ResponseMessage(ResponseMessage.FAIL, \"form认证错误\"), HttpStatus.OK);\n    }\n\n    /**\n     * feign 服务调用异常\n     *\n     * @param ex\n     * @param request\n     *\n     * @return\n     */\n    @ExceptionHandler(value = {FeignException.class})\n    @ResponseBody\n    public ResponseEntity<ResponseMessage> handleFeignException(Exception ex, WebRequest request) {\n        log.info(\"exception throw , exception : {}\", ex);\n        FeignException feignException = (FeignException) ex;\n        String feignExceptionMessage = feignException.getMessage();\n        String[] splitFeignExceptionMessage = feignExceptionMessage.split(\"; content:\");\n        if (splitFeignExceptionMessage.length == 2) {\n            ObjectMapper mapper = new ObjectMapper();\n            try {\n                ResponseMessage responseMessage =\n                        (ResponseMessage) mapper.readValue(splitFeignExceptionMessage[1], ResponseMessage.class);\n                return new ResponseEntity<>(responseMessage, HttpStatus.OK);\n            } catch (IOException e) {\n                log.warn(\"transform message fail, because: {}\", e.getMessage());\n                String message = splitFeignExceptionMessage[1];\n                return new ResponseEntity<>(ResponseMessage.fail(message), HttpStatus.OK);\n            }\n        }\n        return new ResponseEntity<>(new ResponseMessage(ResponseMessage.FAIL, \"feign 服务调用异常！\"), HttpStatus.OK);\n    }\n\n    /**\n     * @param ex\n     * @param request\n     *\n     * @return\n     */\n    @ExceptionHandler(value = {AccessDeniedException.class})\n    @ResponseBody\n    public ResponseEntity<ResponseMessage> handleAccessDeniedException(AccessDeniedException ex, WebRequest request) {\n        return new ResponseEntity<>(ResponseMessage.fail(\"当前用户无权限访问该节点，请联系系统管理员！\"), HttpStatus.OK);\n    }\n\n    /**\n     * 重复导出全局异常