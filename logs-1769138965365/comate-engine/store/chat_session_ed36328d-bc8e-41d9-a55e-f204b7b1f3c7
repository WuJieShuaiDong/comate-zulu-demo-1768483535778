Y KEY (`bpm_batch_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='预提批审批流';\n\n-- ----------------------------\n-- Table structure for ap_bpm_log\n-- ----------------------------\nDROP TABLE IF EXISTS `ap_bpm_log`;\nCREATE TABLE `ap_bpm_log` (\n  `id` bigint(20) NOT NULL,\n  `operator` varchar(45) DEFAULT NULL COMMENT '操作人',\n  `operation_date` datetime DEFAULT NULL COMMENT '操作时间',\n  `remark` varchar(300) DEFAULT NULL COMMENT '操作备注或意见',\n  `bpm_activity_id` varchar(100) DEFAULT NULL COMMENT 'bpm中的任务Id',\n  `bpm_batch_id` bigint(20) NOT NULL,\n  PRIMARY KEY (`id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='预提批审批流日志';\n\n-- ----------------------------\n-- Table structure for ap_business_type_setting\n-- ----------------------------\nDROP TABLE IF EXISTS `ap_business_type_setting`;\nCREATE TABLE `ap_business_type_setting` (\n  `business_type_id` bigint(20) NOT NULL,\n  `rank` bigint(20) DEFAULT NULL COMMENT '排名',\n  `business_type` varchar(30) DEFAULT NULL COMMENT '业务类型',\n  `vendor_site_type` varchar(45) DEFAULT NULL COMMENT '供应商地点类型',\n  `creation_date` datetime DEFAULT NULL,\n  `created_by` varchar(45) DEFAULT NULL,\n  `last_update_date` datetime DEFAULT NULL,\n  `last_update_by` varchar(45) DEFAULT NULL,\n  `last_update_login` varchar(45) DEFAULT NULL,\n  PRIMARY KEY (`business_type_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='业务类型的设置';\n\n-- ----------------------------\n-- Table structure for ap_category_type_setting\n-- ----------------------------\nDROP TABLE IF EXISTS `ap_category_type_setting`;\nCREATE TABLE `ap_category_type_setting` (\n  `category_type_id` bigint(20) NOT NULL AUTO_INCREMENT,\n  `first_category` varchar(45) DEFAULT NULL,\n  `second_category` varchar(45) DEFAULT NULL,\n  `third_category` varchar(45) DEFAULT NULL,\n  `payment_type` varchar(45) DEFAULT NULL,\n  `start_date` datetime DEFAULT NULL,\n  `end_date` datetime DEFAULT NULL,\n  `creation_date` datetime DEFAULT NULL,\n  `created_by` varchar(45) DEFAULT NULL,\n  `last_upda