y>src/main/webapp/WEB-INF</directory>\n                            <!--是否过滤文件，也就是是否启动auto-config的功能 -->\n                            <filtering>true</filtering>\n                            <!--只更新 -->\n                            <includes>\n                                <include>web.xml</include>\n                            </includes>\n                            <!--目标路径 -->\n                            <targetPath>WEB-INF</targetPath>\n                        </resource>\n                        <resource>\n                            <directory>src/main/resources/release</directory>\n                            <filtering>true</filtering>\n                            <includes>\n                                <include>log4j2.xml</include>\n                            </includes>\n                            <targetPath>WEB-INF/classes</targetPath>\n                        </resource>\n                    </webResources>\n                </configuration>\n            </plugin>\n\n\n            <plugin>\n                <groupId>org.apache.maven.plugins</groupId>\n                <artifactId>maven-surefire-plugin</artifactId>\n                <version>2.19.1</version>\n                <configuration>\n                    <testFailureIgnore>true</testFailureIgnore>\n                    <includes>\n                        <include>com/baidu/ce/**/*.class</include>\n                        <include>com/baidu/tms/**/*.class</include>\n                        <!--                        <include>com/baidu/tms/**/service/**/*.class</include>-->\n                    </includes>\n                    <excludes>\n                        <exclude>com/baidu/p2p/**/*.class</exclude>\n                        <exclude>**/*ControllerTest.class</exclude>\n\n                        <!-- 安环由于数据表改变错误的 case 先去除 -->\n                        <!--\n                        <exclude>**/FndDescFlexColumnsServiceTest.class</exclude>\n                        <exclude>**/FndDescFlexContextsTest.class</exclude>\n                        <exclude>**/FndDescFlexsServiceTest.class</exclude>\n                        <exclude>**/FndDescFlexSyncServiceTest.class</exclude>\n                        -->\n\n                        <!-- 外接钱包接口，同步数据，不需要单测 -->\n                        <exclude>**/QianBaoServiceTest.class</exclude>\n\n                    </excludes>\n                    <argLine>-Xms2048m -Xmx2048m</argLine>\n                    <argLine>-Dfile.encoding=UTF-8</argLine>\n                    <argLine>\n                        --add-opens java.base/java.lang=ALL-UNNAMED\n                        --add-opens java.base/java.io=ALL-UNNAMED\n                        --add-opens java.base/java.math=ALL-UNNAMED\n                        --add-opens java.base/java.nio=ALL-UNNAMED\n                        --add-opens java.base/java.security=ALL-UNNAMED\n                        --add-opens java.base/java.text=ALL-UNNAMED\n                        --add-opens java.base/java.time=ALL-UNNAMED\n                        --add-opens java.base/java.util=ALL-UNNAMED\n                        --add-opens java.base/jdk.internal.access=ALL-UNNAMED\n                        --add-opens java.base/jdk.internal.misc=ALL-UNNAMED\n                    </argLine>\n\n                </configuration>\n            </plugin>\n\n            <!-- 配置PMD静态代码扫描工具 -->\n            <plugin>\n                <groupId>org.apache.maven.plugins</groupId>\n                <artifactId>maven-pmd-plugin</artifactId>\n                <version>3.6</version>\n                <configuration>\n                    <targetJdk>1.8</targetJdk>\n                    <format>html</format>\n                    <format>xml</format>\n                    <aggregate>true</aggregate>\n                    <outputDirectory>target/site</outputDirectory>\n                </configuration>\n            </plugin>\n\n            <!-- findbugs配置 -->\n            <plugin>\n                <groupId>org.codehaus.mojo</groupId>\n    