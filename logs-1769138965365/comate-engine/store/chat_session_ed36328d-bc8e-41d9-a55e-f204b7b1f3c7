  PRIMARY KEY (`apply_his_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='预付款未核销原因表';\n\n-- ----------------------------\n-- Table structure for ap_fssc_status\n-- ----------------------------\nDROP TABLE IF EXISTS `ap_fssc_status`;\nCREATE TABLE `ap_fssc_status` (\n  `payment_header_id` bigint(20) NOT NULL,\n  `payment_num` varchar(100) NOT NULL,\n  `erp_pay_date` varchar(100) DEFAULT NULL COMMENT 'erp支付日期',\n  `bank_pay_date` varchar(100) DEFAULT NULL COMMENT '银行支付日期',\n  `sub_status_desc` varchar(50) DEFAULT NULL COMMENT '子状态',\n  `status_desc` varchar(50) DEFAULT NULL COMMENT '财务处理状态',\n  `fssc_role` varchar(50) DEFAULT NULL COMMENT '当前处理人',\n  `pay_status` varchar(50) DEFAULT NULL COMMENT '后台字段',\n  `sub_status` varchar(50) DEFAULT NULL COMMENT '后台字段',\n  PRIMARY KEY (`payment_header_id`)\n) ENGINE=InnoDB DEFAULT CHARSET=utf8 ROW_FORMAT=DYNAMIC;\n\n-- ----------------------------\n-- Table structure for ap_fssc_status_temp\n-- ----------------------------\nDROP TABLE IF EXISTS `ap_fssc_status_temp`;\nCREATE TABLE `ap_fssc_status_temp` (\n  `payment_header_id` bigint(20) NOT NULL,\n  `payment_num` varchar(100) NOT NULL,\n  `erp_pay_date` varchar(100) DEFAULT NULL COMMENT 'erp支付日期',\n  `bank_pay_date` varchar(100) DEFAULT NULL COMMENT '银行支付日期',\n  `sub_status_desc` varchar(50) DEFAULT NULL COMMENT '子状态',\n  `status_desc` varchar(50) DEFAULT NULL COMMENT '财务处理状态',\n  `fssc_role` varchar(50) DEFAULT NULL COMMENT '当前处理人',\n  `pay_status` varchar(50) DEFAULT NULL COMMENT '后台字段',\n  `sub_status` varchar(50) DEFAULT NULL COMMENT '后台字段',\n  `imp_batch_num` varchar(100) DEFAULT NULL,\n  `business_sys_id` varchar(20) DEFAULT NULL\n) ENGINE=InnoDB DEFAULT CHARSET=utf8 ROW_FORMAT=DYNAMIC;\n\n-- ----------------------------\n-- Table structure for ap_fssc_task_assignment\n-- ----------------------------\nDROP TABLE IF EXISTS `ap_fssc_task_assignment`;\nCREATE TABLE `ap_fssc_task_assignment` (\n  `payment_header_id` bigint(20) NOT NULL,\n  `his_seq` bigint(20) DEFAULT NUL