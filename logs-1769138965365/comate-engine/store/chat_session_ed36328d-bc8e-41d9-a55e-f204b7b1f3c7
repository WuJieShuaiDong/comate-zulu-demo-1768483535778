e_status_code` varchar(30) DEFAULT NULL COMMENT '审批状态',\n  `contract_num` varchar(225) DEFAULT NULL COMMENT '合同编号',\n  `num_status_code` varchar(30) DEFAULT NULL COMMENT '合同号状态\\nNOT_GENERATED(\"未生效\"), \\n            GENERATED(\"生效\"), \\n            DROPPED(\"作废\");\\n            ',\n  `status_code` varchar(30) DEFAULT NULL COMMENT '合同状态\\nNOT_EFFECTIVE(\"未生效\"),\\n            EFFECTIVE(\"生效\"),\\n            TERMINATED(\"终止\"),\\n            INVALID(\"作废\");\\n            ',\n  `fst_type_code` varchar(30) NOT NULL COMMENT '合同类型-一级\\n普通合同',\n  `sec_type_code` varchar(30) NOT NULL COMMENT '合同类型-二级\\n采购合同',\n  `dept_code` varchar(30) DEFAULT NULL COMMENT '签约部门ID',\n  `associate_type_code` varchar(30) DEFAULT NULL COMMENT '关联性质\\n无/补充合同/终止合同/续签合同/其他合同',\n  `content_summary` longtext COMMENT '合同概要信息',\n  `begin_date` date DEFAULT NULL COMMENT '合同开始日期',\n  `end_date` date DEFAULT NULL COMMENT '合同结束日期',\n  `cost_type_code` varchar(30) DEFAULT NULL COMMENT '费用类型\\nFREE(\"免费\"),\\n            PAY(\"付款\"),\\n            INCOME(\"收款\"),\\n            PAYANDINCOME(\"收款及付款\"),\\n            ',\n  `report_code` varchar(150) DEFAULT NULL COMMENT '采购报告编号',\n  `order_num` varchar(30) DEFAULT NULL COMMENT 'PO编号',\n  `purchase_sp_num` varchar(225) DEFAULT NULL COMMENT '自主采购申请编号',\n  `lock_flag` char(1) DEFAULT NULL COMMENT '锁定状态',\n  `robinApproved` varchar(10) DEFAULT NULL COMMENT 'null:没有审批日志 false:robin没有审批 true: robin审批的',\n  `created_by` varchar(45) DEFAULT NULL COMMENT 'created_by',\n  `creation_date` datetime DEFAULT NULL COMMENT 'creation_date',\n  `last_updated_by` varchar(45) DEFAULT NULL COMMENT 'last_updated_by',\n  `last_update_date` datetime DEFAULT NULL COMMENT 'last_update_date',\n  `pay_condition_remarks` longtext COMMENT '付款条件说明',\n  `process_state` varchar(20) DEFAULT NULL COMMENT '运行 完成 终止 挂起 作废',\n  `use_template` char(1) DEFAULT NULL COMMENT '合同性质',\n  `pay_money` decimal(20,6) DEFAULT NULL COMMENT '合同总金额',\n  `pay_is_estimated` char(1) DEFAULT NULL COMMENT '是