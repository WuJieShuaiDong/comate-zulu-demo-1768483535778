ory>\n                <includes>\n                    <include>**/*.properties</include>\n                    <include>spring/**/spring-all.xml</include>\n                </includes>\n                <filtering>true</filtering>\n            </resource>\n\n            <resource>\n                <!--  -->\n                <directory>src/main/resources</directory>\n                <includes>\n                    <include>**/*.xlsx</include>\n                    <include>**/*.ftl</include>\n                </includes>\n                <filtering>false</filtering>\n            </resource>\n\n            <resource>\n                <!--拷贝所有的xml文件,不要替换 -->\n                <directory>src/main/java</directory>\n                <includes>\n                    <include>**/*.xml</include>\n                </includes>\n                <filtering>false</filtering>\n            </resource>\n            <resource>\n                <directory>src/main/resources</directory>\n            </resource>\n\n        </resources>\n\n        <testResources>\n            <testResource>\n                <directory>src/test/resources</directory>\n                <filtering>false</filtering>\n            </testResource>\n\n            <testResource>\n                <directory>src/test/resources</directory>\n                <includes>\n                    <include>**/*.properties</include>\n                </includes>\n                <filtering>true</filtering>\n            </testResource>\n\n            <testResource>\n                <directory>src/test/resources</directory>\n                <includes>\n                    <include>**/*.xlsx</include>\n                    <include>**/*.ftl</include>\n                </includes>\n                <filtering>false</filtering>\n            </testResource>\n\n\n            <testResource>\n                <directory>src/test/java</directory>\n\n                <includes>\n                    <include>**/*.json</include>\n                    <include>**/*.xml</include>\n                </includes>\n                <filtering>false</filtering>\n            </testResource>\n\n\n        </testResources>\n\n        <plugins>\n            <plugin>\n                <artifactId>maven-compiler-plugin</artifactId>\n                <version>3.5.1</version>\n                <configuration>\n                    <source>1.8</source>\n                    <target>1.8</target>\n                    <encoding>UTF-8</encoding>\n                    <compilerArguments>\n                        <extdirs>${basedir}/src/main/webapp/WEB-INF/lib</extdirs>\n                    </compilerArguments>\n                </configuration>\n            </plugin>\n\n\n            <plugin>\n                <groupId>org.codehaus.mojo</groupId>\n                <artifactId>cobertura-maven-plugin</artifactId>\n                <version>2.7</version>\n                <configuration>\n                    <maxmem>2048m</maxmem>\n                    <check/>\n                    <formats>\n                        <format>html</format>\n                        <format>xml</format>\n                    </formats>\n                    <!-- 多模块配置统计 -->\n                    <aggregate>true</aggregate>\n                    <instrumentation>\n                        <ignoreTrivial>true</ignoreTrivial>\n                        <excludes>\n                            <!-- tms中不需要统计的部分 -->\n                            <exclude>com/baidu/tms/**/controller/**/*.class</exclude>\n                            <exclude>com/baidu/tms/**/dao/**/*.class</exclude>\n                            <exclude>com/baidu/tms/**/domain/**/*.class</exclude>\n                            <exclude>com/baidu/tms/**/util/**/*.class</exclude>\n                            <exclude>com/baidu/tms/**/citi/**/*.class</exclude>\n                            <exclude>com/baidu/tms/**/common/**/*.class</exclude>\n\n                            <!-- 排除service接口 -->\n                            <exclude>