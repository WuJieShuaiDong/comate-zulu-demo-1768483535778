            "originalContent": "package com.baidu.p2p.core.utils;\n\nimport static org.junit.Assert.*;\n\nimport org.junit.After;\nimport org.junit.Before;\nimport org.junit.Test;\n\nimport java.util.concurrent.Callable;\nimport java.util.concurrent.ExecutionException;\nimport java.util.concurrent.ExecutorService;\nimport java.util.concurrent.Executors;\nimport java.util.concurrent.Future;\nimport java.util.concurrent.LinkedBlockingQueue;\nimport java.util.concurrent.ThreadPoolExecutor;\nimport java.util.concurrent.TimeUnit;\nimport java.util.concurrent.atomic.AtomicBoolean;\n\npublic class NewThreadPoolExecutorUtilTest{\n\n\n    private ExecutorService customExecutor;\n\n    private ThreadPoolExecutor executor;\n    @Before\n    public void setup() {\n        ExecutorService executor = NewThreadPoolExecutorUtil.getExecutorService();\n        executor.shutdown();\n        try {\n            if (!executor.awaitTermination(5, TimeUnit.SECONDS)) {\n                executor.shutdownNow();\n            }\n        } catch (InterruptedException e) {\n            executor.shutdownNow();\n            Thread.currentThread().interrupt();\n        }\n    }\n\n    @After\n    public void teardown() {\n        ExecutorService executor = NewThreadPoolExecutorUtil.getExecutorService();\n        executor.shutdown();\n        try {\n            if (!executor.awaitTermination(5, TimeUnit.SECONDS)) {\n                executor.shutdownNow();\n            }\n        } catch (InterruptedException e) {\n            executor.shutdownNow();\n            Thread.currentThread().interrupt();\n        }\n    }\n    // testCreateExecutorServiceWithValidParameters 用于测试 createExecutorService\n    // generated by Comate\n    @Test\n    public void testCreateExecutorServiceWithValidParameters() {\n        int corePoolSize = 5;\n        int maxPoolSize = 10;\n        int queueSize = 100;\n        \n        ThreadPoolExecutor executor = NewThreadPoolExecutorUtil.createExecutorService(corePoolSize, maxPoolSize, queueSize,\n                \"test-pool-\");\n        \n        assertNotNull(executor);\n        assertEquals(corePoolSize, executor.getCorePoolSize());\n        assertEquals(maxPoolSize, executor.getMaximumPoolSize());\n        assertFalse(executor.isShutdown());\n    }\n\n    // testCreateExecutorServiceWithNegativeCorePoolSize 用于测试 createExecutorService\n    // generated by Comate\n    @Test(expected = IllegalArgumentException.class)\n    public void testCreateExecutorServiceWithNegativeCorePoolSize() {\n        NewThreadPoolExecutorUtil.createExecutorService(-1, 10, 100, \"invalid-pool-\");\n    }\n\n    // testGetExecutorServiceInitialState 用于测试 getExecutorService\n    // generated by Comate\n    @Test\n    public void testGetExecutorServiceInitialState() {\n        ExecutorService executor = NewThreadPoolExecutorUtil.getExecutorService();\n        assertNotNull(\"Executor should not be null\", executor);\n        assertFalse(\"Executor should not be shutdown\", executor.isShutdown());\n        assertFalse(\"Executor should not be terminated\", executor.isTerminated());\n        assertTrue(\"Returned executor should be ThreadPoolExecutor\", \n            executor instanceof ThreadPoolExecutor);\n        ThreadPoolExecutor threadPool = (ThreadPoolExecutor) executor;\n        assertEquals(\"Core pool size should match default\", \n            10, threadPool.getCorePoolSize());\n        assertEquals(\"Max pool size should match default\", \n            20, threadPool.getMaximumPoolSize());\n    }\n\n    // testShutdownExecutorNullExecutor 用于测试 shutdownExecutor\n    // generated by Comate\n    @Test\n    public void testShutdownExecutorNullExecutor() {\n        NewThreadPoolExecutorUtil.shutdownExecutor(null, 1, TimeUnit.SECONDS);\n    }\n\n    // testSubmitNullExecutor 用于测试 submit\n    // generated by Comate\n    @Test(expected = IllegalArgumentException.class)\n    public void testSubmitNullExecutor() {\n        Callable<String> task = () -> \"test\";\n        NewThreadPoolExecutorUtil.submit(null, task);\n    }\n\n    // testSubmitWithRealExecutor 用于测试 submit\n    // generated by Comate\n    @Test\n    public void testSubmitWithRealExecutor() throws Exception {\n        ExecutorService executor = java.util.concurrent.Executors.newSingleThreadExecutor();\n        try {\n            Callable<String> task = () -> \"real result\";\n            Future<String> future = NewThreadPoolExecutorUtil.submit(executor, task);\n            assertEquals(\"real result\", future.get(1, TimeUnit.SECONDS));\n        } finally {\n            executor.shutdown();\n            executor.awaitTermination(1, TimeUnit.SECONDS);\n        }\n    }\n\n    // testExecuteNullExecutor 用于测试 execute\n    // generated by Comate\n    @Test(expected = IllegalArgumentException.class)\n    public void testExecuteNullExecutor() {\n        Runnable task = () -> System.out.println(\"Task executed\");\n        NewThreadPoolExecutorUtil.execute(null, task);\n    }\n\n    // testWrapExecutorWithNullExecutor 用于测试 wrapExecutor\n    // generated by Comate\n    @Test(expected = NullPointerException.class)\n    public void testWrapExecutorWithNullExecutor() {\n        NewThreadPoolExecutorUtil.wrapExecutor(null);\n    }\n\n    // testSetCorePoolSizeWithValidValue 用于测试 setCorePoolSize\n    // generated by Comate\n    @Test\n    public void testSetCorePoolSizeWithValidValue() {\n    ThreadPoolExecutor executor = NewThreadPoolExecutorUtil.createExecutorService(5, 10, 100, \"test-pool-\");\n    int newCorePoolSize = 7;\n    \n    NewThreadPoolExecutorUtil.setCorePoolSize(executor, newCorePoolSize);\n    \n    assertEquals(newCorePoolSize, executor.getCorePoolSize());\n    }\n\n    // testSetCorePoolSizeWithNegativeValue 用于测试 setCorePoolSize\n    // generated by Comate\n    @Test(expected = IllegalArgumentException.class)\n    public void testSetCorePoolSizeWithNegativeValue() {\n    ThreadPoolExecutor executor = NewThreadPoolExecutorUtil.createExecutorService(5, 10, 100, \"test-pool-\");\n    NewThreadPoolExecutorUtil.setCorePoolSize(executor, -1);\n    }\n\n    // testSetMaximumPoolSizeWithValidValue 用于测试 setMaximumPoolSize\n    // generated by Comate\n    @Test\n    public void testSetMaximumPoolSizeWithValidValue() {\n        ThreadPoolExecutor executor = new ThreadPoolExecutor(\n            2, 5, 5, TimeUnit.MINUTES, \n            new LinkedBlockingQueue<>(10)\n        );\n        int newMaxPoolSize = 8;\n        \n        NewThreadPoolExecutorUtil.setMaximumPoolSize(executor, newMaxPoolSize);\n        \n        assertEquals(newMaxPoolSize, executor.getMaximumPoolSize());\n    }\n\n    // testSetMaximumPoolSizeWithZeroValue 用于测试 setMaximumPoolSize\n    // generated by Comate\n    @Test(expected = IllegalArgumentException.class)\n    public void testSetMaximumPoolSizeWithZeroValue() {\n        ThreadPoolExecutor executor = new ThreadPoolExecutor(\n            2, 5, 5, TimeUnit.MINUTES, \n            new LinkedBlockingQueue<>(10)\n        );\n        NewThreadPoolExecutorUtil.setMaximumPoolSize(executor, 0);\n    }\n\n    // testPrintThreadPoolStatusWithNullExecutor 用于测试 printThreadPoolStatus\n    // generated by Comate\n    @Test\n    public void testPrintThreadPoolStatusWithNullExecutor() {\n        executor = NewThreadPoolExecutorUtil.createExecutorService(2, 4, 10, \"test-pool-\");\n    \n        NewThreadPoolExecutorUtil.printThreadPoolStatus(null, \"null-pool\");\n        // No exception should be thrown\n    \n        executor.shutdown();\n        try {\n            if (!executor.awaitTermination(5, TimeUnit.SECONDS)) {\n                executor.shutdownNow();\n            }\n        } catch (InterruptedException e) {\n            executor.shutdownNow();\n            Thread.currentThread().interrupt();\n        }\n    }\n\n    // testPrintThreadPoolStatusWithEmptyQueue 用于测试 printThreadPoolStatus\n    // generated by Comate\n    @Test\n    public void testPrintThreadPoolStatusWithEmptyQueue() {\n        executor = NewThreadPoolExecutorUtil.createExecutorService(2, 4, 10, \"test-pool-\");\n    \n        NewThreadPoolExecutorUtil.printThreadPoolStatus(executor, \"empty-pool\");\n        assertEquals(0, executor.getQueue().size());\n    \n        executor.shutdown();\n        try {\n            if (!executor.awaitTermination(5, TimeUnit.SECONDS)) {\n                executor.shutdownNow();\n            }\n        } catch (InterruptedException e) {\n            executor.shutdownNow();\n            Thread.currentThread().interrupt();\n        }\n    }\n\n    // testPrintThreadPoolStatusWithFullQueue 用于测试 printThreadPoolStatus\n    // generated by Comate\n    @Test\n    public void testPrintThreadPoolStatusWithFullQueue() throws InterruptedException {\n        executor = NewThreadPoolExecutorUtil.createExecutorService(2, 4, 10, \"test-pool-\");\n    \n        // Fill the queue\n        for (int i = 0; i < 10; i++) {\n            executor.execute(() -> {\n                try {\n                    Thread.sleep(1000);\n                } catch (InterruptedException e) {\n                    Thread.currentThread().interrupt();\n                }\n            });\n        }\n        \n        // Wait for tasks to be queued\n        Thread.sleep(100);\n        \n        NewThreadPoolExecutorUtil.printThreadPoolStatus(executor, \"full-pool\");\n        assertEquals(10, executor.getQueue().size());\n    \n        executor.shutdown();\n        try {\n            if (!executor.awaitTermination(5, TimeUnit.SECONDS)) {\n                executor.shutdownNow();\n            }\n        } catch (InterruptedException e) {\n            executor.shutdownNow();\n            Thread.currentThread().interrupt();\n        }\n    }\n\n    // testExecuteWithErrorThrowingTask 用于测试 execute\n    // generated by Comate\n    @Test\n    public void testExecuteWithErrorThrowingTask() throws InterruptedException {\n        // 创建一个单线程池用于测试\n        ExecutorService executor = Executors.newFixedThreadPool(1);\n        \n        // 创建一个会抛出Error的任务\n        Runnable errorTask = () -> {\n            throw new OutOfMemoryError(\"Simulated memory error\");\n        };\n        \n        try {\n            NewThreadPoolExecutorUtil.execute(executor, errorTask, \"error-task\");\n            \n            // 给任务一点时间执行\n            Thread.sleep(500);\n            \n            // 验证日志中是否记录了Error（实际项目中可能需要验证日志）\n            // 这里主要验证程序不会崩溃，且Error被捕获\n        } finally {\n            executor.shutdown();\n            executor.awaitTermination(1, TimeUnit.SECONDS);\n        }\n    }\n\n    // testExecuteNormalTask 用于测试 execute\n    // generated by Comate\n    @Test\n    public void testExecuteNormalTask() throws InterruptedException {\n        // 创建一个单线程池用于测试\n        ExecutorService executor = Executors.newFixedThreadPool(1);\n        \n        // 创建一个正常任务\n        final boolean[] taskExecuted = {false};\n        Runnable normalTask = () -> {\n            taskExecuted[0] = true;\n        };\n        \n        try {\n            NewThreadPoolExecutorUtil.execute(executor, normalTask, \"normal-task\");\n            \n            // 给任务一点时间执行\n            Thread.sleep(500);\n            \n            // 验证任务确实执行了\n            assertTrue(taskExecuted[0]);\n        } finally {\n            executor.shutdown();\n            executor.awaitTermination(1, TimeUnit.SECONDS);\n        }\n    }\n\n    // testSubmitWithExceptionThrowingTask 用于测试 submit\n    // generated by Comate\n    @Test\n    public void testSubmitWithExceptionThrowingTask() throws Exception {\n        ExecutorService executor = Executors.newSingleThreadExecutor();\n        try {\n            Callable<String> exceptionTask = () -> {\n                throw new RuntimeException(\"Simulated runtime exception\");\n            };\n            Future<String> future = NewThreadPoolExecutorUtil.submit(\n                executor, \n                exceptionTask, \n                \"exception-task\"\n            );\n            try {\n                future.get();\n                fail(\"Expected ExecutionException to be thrown\");\n            } catch (ExecutionException e) {\n                assertTrue(e.getCause() instanceof RuntimeException);\n                assertEquals(\"Simulated runtime exception\", e.getCause().getMessage());\n            }\n        } finally {\n            executor.shutdown();\n            executor.awaitTermination(1, TimeUnit.SECONDS);\n        }\n    }\n\n    // testExecuteWithCustomExecutor 用于测试 execute\n    // generated by Comate\n    @Test\n    public void testExecuteWithCustomExecutor() throws InterruptedException {\n        customExecutor = NewThreadPoolExecutorUtil.createExecutorService(\n            2, 4, 10, \"test-pool\");\n        ExecutorService defaultExecutor = NewThreadPoolExecutorUtil.getExecutorService();\n        defaultExecutor.shutdown();\n        try {\n            if (!defaultExecutor.awaitTermination(5, TimeUnit.SECONDS)) {\n                defaultExecutor.shutdownNow();\n            }\n        } catch (InterruptedException e) {\n            defaultExecutor.shutdownNow();\n            Thread.currentThread().interrupt();\n        }\n        AtomicBoolean taskExecuted = new AtomicBoolean(false);\n        Runnable task = () -> taskExecuted.set(true);\n        NewThreadPoolExecutorUtil.execute(customExecutor, task);\n        Thread.sleep(100);\n        assertTrue(\"Task should be executed\", taskExecuted.get());\n        if (customExecutor != null) {\n            customExecutor.shutdownNow();\n        }\n        defaultExecutor = NewThreadPoolExecutorUtil.getExecutorService();\n        defaultExecutor.shutdown();\n        try {\n            if (!defaultExecutor.awaitTermination(5, TimeUnit.SECONDS)) {\n                defaultExecutor.shutdownNow();\n            }\n        } catch (InterruptedException e) {\n            defaultExecutor.shutdownNow();\n            Thread.currentThread().interrupt();\n        }\n    }\n\n}",
