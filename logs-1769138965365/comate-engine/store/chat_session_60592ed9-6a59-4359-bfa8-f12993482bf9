ncingClient cmbClient;\n43->\n44->    @Autowired\n45->    private CmbcFinancingClient cmbcClient;\n46->\n47->    @Autowired\n48->    private PmcSupplierAdmClient pmcSupplierAdmClient;\n49->\n50->    @Autowired\n51->    private PmcPortalClient pmcPortalClient;\n52->    @Autowired\n53->    private CommonAttachmentService commonAttachmentService;\n54->\n55->    @Autowired\n56->    private ObjectMapper objectMapper;\n57->\n58->    /**\n59->     * 融资测算接口\n60->     * @param query 包含银行编码等融资测算参数\n61->     * @return 融资测算结果\n62->     */\n63->    @Override\n64->    public ResponseMessage calculateFinancing(PmcFinanceBankBaseQO query) {\n65->        // 1. 参数校验\n66->        if (query == null || query.getFinanceAmount() == null\n67->                || query.getFinanceRate() == null ||  query.getFinancePeriod() == null) {\n68->            return ResponseMessage.fail(\"参数错误：融资金额、融资利率、融资期限不能为空\");\n69->        }\n70->        // feeAmount\n71->        // 如果融资利率包含%，只取前面的数字\n72->        query.setFinanceRate(query.getFinanceRate().replace(\"%\", \"\"));\n73->        // 融资成本测算=融资金额*利率/365*融资天数\n74->        BigDecimal fee = query.getFinanceAmount().multiply(new BigDecimal(query.getFinanceRate())).divide(new BigDecimal(100));\n75->        BigDecimal financeAmount = fee.divide(new BigDecimal(365), 8, RoundingMode.HALF_UP).multiply(new BigDecimal(query.getFinancePeriod()))\n76->                .setScale(2, RoundingMode.HALF_UP);\n77->        FinancingEstimateResultDTO estimateResult = new FinancingEstimateResultDTO();\n78->        estimateResult.setFeeAmount(financeAmount);\n79->        return ResponseMessage.success(estimateResult);\n80->    }\n81->    /**\n82->     * 提交融资申请\n83->     * @param applyDTO 包含银行编码等融资申请信息\n84->     * @return 申请提交结果\n85->     */\n86->    @Override\n87->    public ResponseMessage submitFinancingApply(PmcFinanceBankBaseQO applyDTO) {\n88->        // 1. 参数校验\n89->        if (applyDTO == null || applyDTO.getBankCode() == null) {\n90->            return ResponseMessage.fail(\"参数错误：申请信息不完整\");\n91->        }\n92->        // 3. 提交申请\n93->        if (PayBankConstants.CMB_BANK_CODE.equals(applyDTO.getBankCode())) {\n94->            return cmbClient.submitFinancingApply(applyDTO);\n95->        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(applyDTO.getBankCode())) {\n96->            return cmbcClient.submitFinancingApply(applyDTO);\n97->        } else {\n98->            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n99->        }\n100->\n101->        // 4. 返回申请结果\n102->    }\n103->\n104->    /**\n105->     * 通过详情信息提交融资申请\n106->     * @return 申请提交结果\n107->     */\n108->    private ResponseMessage submitFinancingApplyByDetail(PmcFinanceBankBaseQO request) {\n109->        // 发送银行提交申请\n110->        ResponseMessage responseMessage = submitFinancingApply(request);\n111->        // 3. 处理银行响应\n112->        if (ResponseMessage.FAIL.equals(responseMessage.getStatus())) {\n113->            log.error(\"银行接口调用失败，开始本地状态，申请单号：{}，错误原因：{}\",\n114->                    request.getApplyNumber(), responseMessage.getMessage());\n115->            request.setBankDealStatus(false);\n116->            updateApplyStatusOrSendMeg(request);\n117->            // 管理员重发需要抛具体异常\n118->            if (\"1\".equals(request.getProcessFlag())) {\n119->                return ResponseMessage.fail(\"银行处理失败：\" + getDataBaseMsg(request));\n120->            } else {\n121->                // 提交失败，看是否存在warnMsg\n122->                Object data = responseMessage.getData();\n123->                if (data != null) {\n124->                    Map<String, Object> map = new HashMap<>();\n125->                    if (data instanceof Map) {\n126->                        UtilType.copyProperties(map, data, true);\n127->                        if (StringUtils.isNotBlank(map.get(\"warnMsg\").toString())) {\n128->                            return ResponseMessage.success(map);\n129->                        }\n130->                    }\n131->                }\n132->                return responseMessage;\n133->            }\n134->        } else {\n135->            // 4. 更新本地状态已提交\n136->            request.setBankDealStatus(true);\n137->            updateApplyStatusOrSendMeg(request);\n138->        }\n139->        return responseMessage;\n140->    }\n141->\n142->    private String getDataBaseMsg(PmcFinanceBankBaseQO request) {\n143->        PmcFinanceSupplierApplyQO qo = new PmcFinanceSupplierApplyQO();\n144->        qo.setApplyNumber(request.getApplyNumber());\n145->        List<PmcFinanceSupplierApplyDTO> list;\n146->        list = pmcSupplierAdmClient.selectList(qo).getList();\n147->        if (list.isEmpty()) {\n148->            throw new WebException(\"查询不到申请单号：\" + request.getApplyNumber());\n149->        }\n150->        PmcFinanceSupplierApplyDTO dto = list.get(0);\n151->        return dto.getMessage();\n152->    }\n153->\n154->    /**\n155->    * 跨服务在这里汇总流程\n156->     * 1、发送银行获取额度\n157->     * 2、发送service校验额度、中间状态处理\n158->     * 3、修改为状态之后,同步占用额度，同步组装报文，校验关键信息是否为空，有缺失发送预警消息\n159->     * 4、service校验通过，则web模块发送银行进行申请\n160->     * 5、银行返回成功，则修改状态为已提交\n161->    * */\n162->    @Override\n163->    public ResponseMessage submitFinancingApplyOpt(PmcFinanceSupplierApplyDTO pmcFinanceSupplierApplyDTO) {\n164->        try {\n165->            // todo 流程待优化\n166->            // 1、先查询银行可用额度，放到报文DTO中\n167->            setAvailableAmount(pmcFinanceSupplierApplyDTO);\n168->\n169->            // 2、提交service校验额度、提交融资申请单\n170->            ResponseMessage responseMessage = pmcPortalClient.saveOrUpdateFinancingApply(pmcFinanceSupplierApplyDTO);\n171->\n172->            if (ResponseMessage.FAIL.equals(responseMessage.getStatus())) {\n173->                // 提交失败，看是否存在warnMsg\n174->                Object data = responseMessage.getData();\n175->                if (data != null) {\n176->                    Map<String, Object> map = new HashMap<>();\n177->                    if (data instanceof Map) {\n178->                        UtilType.copyProperties(map, data, true);\n179->                        if (StringUtils.isNotBlank(map.get(\"warnMsg\").toString())) {\n180->                            return ResponseMessage.success(map);\n181->                        }\n182->                    }\n183->                }\n184->                return responseMessage;\n185->            }\n186->\n187->            // 3、如果本地处理成功，并且状态为提交银行中，则提交银行融资申请\n188->            if (ResponseMessage.OK.equals(responseMessage.getStatus())\n189->                    && SupplierFinancingApplyStatus.SUBMITTED.name().equals(pmcFinanceSupplierApplyDTO.getStatus())) {\n190->                PmcFinanceBankBaseQO request = new PmcFinanceBankBaseQO();\n191->                Object quotaData = responseMessage.getData();\n192->                UtilType.copyProperties(request, quotaData, true);\n193->                return this.submitFinancingApplyByDetail(request);\n194->            }\n195->            return responseMessage;\n196->        } catch (WebException e) {\n197->            log.error(\"设置可用额度失败：{}\", e.getMessage());\n198->            return ResponseMessage.fail(\"设置银行可用额度失败：\" + e.getMessage());\n199->        } catch (Exception e) {\n200->            log.error(\"提交融资申请异常：\", e);\n201->            return ResponseMessage.fail(\"提交融资申请异常，请稍后重试\");\n202->        }\n203->    }\n204->\n205->    private void setAvailableAmount(PmcFinanceSupplierApplyDTO pmcFinanceSupplierApplyDTO) {\n206->        // 1、先查询银行可用额度，放到报文DTO中\n207->        PmcFinanceBankBaseQO baseQO = new PmcFinanceBankBaseQO();\n208->        baseQO.setSupplierCode(pmcFinanceSupplierApplyDTO.getSupplierCode());\n209->        baseQO.setBankCode(pmcFinanceSupplierApplyDTO.getBankCode());\n210->        baseQO.setCompanyCode(pmcFinanceSupplierApplyDTO.getCompanyCode());\n211->        ResponseMessage quotaResult = this.queryFinancingQuota(baseQO);\n212->        FinanceQuotaDTO quotaDTO = new FinanceQuotaDTO();\n213->        if (ResponseMessage.OK.equals(quotaResult.getStatus())) {\n214->            Object quotaData = quotaResult.getData();\n215->            UtilType.copyProperties(quotaDTO, quotaData, true);\n216->            pmcFinanceSupplierApplyDTO.setAvailableAmount(quotaDTO.getExoAvailableAmount());\n217->        } else  {\n218->            log.error(\"查询银行可用额度失败：{}\", quotaResult.getMessage());\n219->            // 异常直接返回错误信息\n220->            throw new WebException(\"查询银行可用额度失败, \" + quotaResult.getMessage());\n221->        }\n222->    }\n223->\n224->    /**\n225->     * 执行本地状态回滚操作\n226->     */\n227->    private void updateApplyStatusOrSendMeg(PmcFinanceBankBaseQO request) {\n228->        try {\n229->            ResponseMessage rollback = pmcSupplierAdmClient.updateApplyStatusOrSendMeg(request);\n230->            if (ResponseMessage.FAIL.equals(rollback.getStatus())) {\n231->                log.error(\"更新本地记录失败，申请单号：{}，错误信息：{}\",\n232->                    request.getApplyNumber(), rollback.getMessage());\n233->                throw new WebException(\"更新本地记录失败：\" + rollback.getMessage());\n234->            }\n235->        } catch (Exception e) {\n236->            log.error(\"更新融资本地记录时发生异常，申请单号：{}\", request.getApplyNumber(), e);\n237->            throw new WebException(\"更新融资本地记录时发生异常\" + e.getMessage());\n238->        }\n239->    }\n240->\n241->    /**\n242->     * 查询融资结果\n243->     * @param query 包含银行编码等查询条件\n244->     * @return 融资结果信息\n245->     */\n246->    @Override\n247->    public ResponseMessage queryFinancingResult(PmcFinanceBankBaseQO query) {\n248->        // 1. 参数校验\n249->        if (query == null || query.getBankCode() == null) {\n250->            return ResponseMessage.fail(\"参数错误：银行编码不能为空\");\n251->        }\n252->\n253->        // 2 通用业务校验\n254->        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(query, \"queryFinancingResult\");\n255->        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n256->            return checkResult;\n257->        }\n258->        // 3. 查询融资结果\n259->        if (PayBankConstants.CMB_BANK_CODE.equals(query.getBankCode())) {\n260->            return cmbClient.queryFinancingResult(query);\n261->        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(query.getBankCode())) {\n262->            return cmbcClient.queryFinancingResult(query);\n263->        } else {\n264->            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n265->        }\n266->    }\n267->\n268->    /**\n269->     * 查询融资额度\n270->     * @param query 包含银行编码和供应商编码、公司编码的查询条件\n271->     * @return 融资额度信息\n272->     */\n273->    @Override\n274->    public ResponseMessage queryFinancingQuota(PmcFinanceBankBaseQO query) {\n275->        // 1. 参数校验\n276->        if (query == null || query.getSupplierCode() == null || query.getBankCode() == null) {\n277->            return ResponseMessage.fail(\"参数错误：银行编码或者供应商编码不能为空\");\n278->        }\n279->       return getUseQuota(query);\n280->    }\n281->\n282->    /**\n283->     * 上传融资附件\n284->     * @param file 上传的文件\n285->     * @param qo 包含银行编码等附件信息\n286->     * @return 上传结果\n287->     */\n288->    @Override\n289->    public ResponseMessage uploadFinancingAttachment(MultipartFile file, PmcFinanceBankBaseQO qo) {\n290->        // 1. 参数校验\n291->        if (file == null || file.isEmpty() || qo == null || StringUtils.isBlank(qo.getBankCode())) {\n292->            return ResponseMessage.fail(\"参数错误：文件或银行编码不能为空\");\n293->        }\n294->\n295->        // 2 通用业务校验\n296->        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(qo, \"uploadFinancingAttachment\");\n297->        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n298->            return checkResult;\n299->        }\n300->\n301->        // 3. 文件上传处理\n302->        if (PayBankConstants.CMB_BANK_CODE.equals(qo.getBankCode())) {\n303->            return cmbClient.uploadAttachment(file, qo);\n304->        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(qo.getBankCode())) {\n305->            return cmbcClient.uploadAttachment(file, qo);\n306->        } else {\n307->            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n308->        }\n309->    }\n310->\n311->    /**\n312->     * 补充融资附件\n313->     * @param qo 包含银行编码等附件信息\n314->     * @return 补充上传结果\n315->     */\n316->    @Override\n317->    public ResponseMessage supplementFinancingAttachment(PmcFinanceBankBaseQO qo) {\n318->        // 1. 参数校验\n319->        if (qo.getAttachList() == null || qo.getAttachList().isEmpty() || qo == null || StringUtils.isBlank(qo.getApplyNumber())) {\n320->            return ResponseMessage.fail(\"参数错误：附件列表或申请单号不能为空\");\n321->        }\n322->        // 2 通用业务校验\n323->        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(qo, \"supplementFinancingAttachment\");\n324->        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n325->            return checkResult;\n326->        }\n327->        // 3. 文件补充处理\n328->        if (PayBankConstants.CMB_BANK_CODE.equals(qo.getBankCode())) {\n329->            return cmbClient.supplementFinancingAttachment(qo);\n330->        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(qo.getBankCode())) {\n331->            return cmbcClient.supplementFinancingAttachment(qo);\n332->        } else {\n333->            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n334->        }\n335->    }\n336->\n337->    @Override\n338->    public ResponseMessage adminSubmitFinancingApply(PmcFinanceSupplierApplyDTO pmcFinanceSupplierApplyQO) {\n339->        // 1、先查询银行可用额度，放到报文DTO中\n340->        setAvailableAmount(pmcFinanceSupplierApplyQO);\n341->\n342->        // 2、校验关键信息\n343->        PmcFinanceBankBaseQO query = new PmcFinanceBankBaseQO();\n344->        query.setApplyNumber(pmcFinanceSupplierApplyQO.getApplyNumber());\n345->        query.setBankCode(pmcFinanceSupplierApplyQO.getBankCode());\n346->        query.setCompanyCode(pmcFinanceSupplierApplyQO.getCompanyCode());\n347->        query.setPayCheckNum(pmcFinanceSupplierApplyQO.getPayCheckNum());\n348->        query.setSupplierCode(pmcFinanceSupplierApplyQO.getSupplierCode());\n349->        query.setBankQuota(pmcFinanceSupplierApplyQO.getAvailableAmount());\n350->        ResponseMessage checkResult = pmcSupplierAdmClient.admSubmitApply(query);\n351->        if (ResponseMessage.OK.equals(checkResult.getStatus())) {\n352->            PmcFinanceBankBaseQO request = new PmcFinanceBankBaseQO();\n353->            Object quotaData = checkResult.getData();\n354->            UtilType.copyProperties(request, quotaData, true);\n355->            request.setProcessFlag(\"1\");\n356->            return this.submitFinancingApplyByDetail(request);\n357->        }\n358->        return checkResult;\n359->    }\n360->\n361->\n362->    /**\n363->     * 补充融资附件\n364->     *\n365->     * @param attachDTO 融资附件上传DTO，包含附件列表和申请编号\n366->     * @return ResponseMessage 统一响应对象，包含操作结果\n367->     */\n368->    @Override\n369->    public ResponseMessage admSupplementAttach(PmcFinanceAdmUploadAttachDTO attachDTO) {\n370->        ResponseMessage responseMessage = pmcSupplierAdmClient.getUploadAdmAttachment(attachDTO);\n371->        if (ResponseMessage.FAIL.equals(responseMessage.getStatus())) {\n372->            return responseMessage;\n373->        }\n374->        @SuppressWarnings(\"unchecked\")\n375->        Map<String, Object> map = (Map<String, Object>) responseMessage.getData();\n376->\n377->        PmcFinanceBankBaseQO qo = BeanUtil.mapToBean(map, PmcFinanceBankBaseQO.class, true);\n378->        qo.setApplyNumber(attachDTO.getApplyNumber());\n379->\n380->        return supplementFinancingAttachment(qo);\n381->    }\n382->\n383->\n384->    private ResponseMessage getUseQuota(PmcFinanceBankBaseQO query) {\n385->        // 1、查询本地维护的额度信息\n386->        PmcPortalRemainQuotaQO pmcPortalRemainQuotaQO = new PmcPortalRemainQuotaQO();\n387->        pmcPortalRemainQuotaQO.setSupplierCode(query.getSupplierCode());\n388->        pmcPortalRemainQuotaQO.setBankCode(query.getBankCode());\n389->        pmcPortalRemainQuotaQO.setCompanyCode(query.getCompanyCode());\n390->        BigDecimal localQuotaResult = pmcSupplierAdmClient.calculateAvailableQuota(pmcPortalRemainQuotaQO);\n391->        log.info(\"供应商{}，本地额度：{}\", query.getSupplierCode(), localQuotaResult);\n392->        // 2、查询银行额度信息\n393->        Map<String, Object> selectMap = pmcSupplierAdmClient.selectInit();\n394->        if (selectMap == null || selectMap.isEmpty()) {\n395->            return ResponseMessage.fail(\"系统初始化失败，请联系管理员\");\n396->        }\n397->        List<Map<String, Object>> bankQuotaMapList = (List<Map<String, Object>>) selectMap.get(\"bankQuotaList\");\n398->        FinanceQuotaDTO quotaDTO = new FinanceQuotaDTO();\n399->        quotaDTO.setExoAvailableAmount(localQuotaResult);\n400->        if (CollectionUtils.isEmpty(bankQuotaMapList)) {\n401->            return ResponseMessage.success(\"ok\", quotaDTO);\n402->        }\n403->        boolean hasBankQuota = bankQuotaMapList.stream()\n404->                .anyMatch(map -> query.getBankCode().equals(map.get(\"code\")));\n405->        // 3、返回额度信息\n406->        if (hasBankQuota) {\n407->            if (PayBankConstants.CMB_BANK_CODE.equals(query.getBankCode())) {\n408->                Object quotaData = cmbClient.queryFinancingQuota(query).getData();\n409->                if (quotaData instanceof Map) {\n410->                    Map<String, Object> quotaMap = (Map<String, Object>) quotaData;\n411->                    quotaDTO.setExoAvailableAmount(new BigDecimal(quotaMap.get(\"exoAvailableAmount\").toString()));\n412->                    // 其他需要的字段可以添加到这里\n413->                } else if (quotaData instanceof FinanceQuotaDTO) {\n414->                    quotaDTO = (FinanceQuotaDTO) quotaData;\n415->                }\n416->                if (localQuotaResult.compareTo(quotaDTO.getExoAvailableAmount()) < 0) {\n417->                    quotaDTO.setExoAvailableAmount(localQuotaResult);\n418->                }\n419->                log.info(\"供应商{}，银行额度：{}\", query.getSupplierCode(), JSONObject.toJSONString(quotaDTO));\n420->                return ResponseMessage.success(\"ok\", quotaDTO);\n421->            }  else {\n422->                return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n423->            }\n424->        } else {\n425->            return ResponseMessage.success(\"ok\", quotaDTO);\n426->        }\n427->    }\n428->}",
