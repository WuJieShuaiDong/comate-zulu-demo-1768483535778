      "content": "package com.baidu.pmc.web.service.financing.impl;\n\nimport cn.hutool.core.bean.BeanUtil;\nimport com.alibaba.fastjson.JSONObject;\nimport com.baidu.pmc.common.ResponseMessage;\nimport com.baidu.pmc.common.exception.WebException;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.common.utils.UtilType;\nimport com.baidu.pmc.pojo.constants.SupplierFinancingApplyStatus;\nimport com.baidu.pmc.pojo.dto.PmcFinanceAdmUploadAttachDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyDTO;\nimport com.baidu.pmc.pojo.dto.cmb.FinanceQuotaDTO;\nimport com.baidu.pmc.pojo.dto.cmb.FinancingEstimateResultDTO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceBankBaseQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceSupplierApplyQO;\nimport com.baidu.pmc.pojo.qo.PmcPortalRemainQuotaQO;\nimport com.baidu.pmc.web.clients.PmcPortalClient;\nimport com.baidu.pmc.web.clients.PmcSupplierAdmClient;\nimport com.baidu.pmc.web.clients.cmb.CmbFinancingClient;\nimport com.baidu.pmc.web.clients.cmbc.CmbcFinancingClient;\nimport com.baidu.pmc.web.service.commonattachment.CommonAttachmentService;\nimport com.baidu.pmc.web.service.financing.PmcFinancingBankService;\nimport com.baidu.pmc.web.service.payebankfile.PayBankConstants;\nimport com.fasterxml.jackson.databind.ObjectMapper;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections.CollectionUtils;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\nimport org.springframework.web.multipart.MultipartFile;\n\nimport java.math.BigDecimal;\nimport java.math.RoundingMode;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\n@Slf4j\n@Service\npublic class PmcFinancingBankServiceImpl implements PmcFinancingBankService {\n\n    @Autowired\n    private CmbFinancingClient cmbClient;\n\n    @Autowired\n    private CmbcFinancingClient cmbcClient;\n\n    @Autowired\n    private PmcSupplierAdmClient pmcSupplierAdmClient;\n\n    @Autowired\n    private PmcPortalClient pmcPortalClient;\n    @Autowired\n    private CommonAttachmentService commonAttachmentService;\n\n    @Autowired\n    private ObjectMapper objectMapper;\n\n    /**\n     * 融资测算接口\n     * @param query 包含银行编码等融资测算参数\n     * @return 融资测算结果\n     */\n    @Override\n    public ResponseMessage calculateFinancing(PmcFinanceBankBaseQO query) {\n        // 1. 参数校验\n        if (query == null || query.getFinanceAmount() == null\n                || query.getFinanceRate() == null ||  query.getFinancePeriod() == null) {\n            return ResponseMessage.fail(\"参数错误：融资金额、融资利率、融资期限不能为空\");\n        }\n        // feeAmount\n        // 如果融资利率包含%，只取前面的数字\n        query.setFinanceRate(query.getFinanceRate().replace(\"%\", \"\"));\n        // 融资成本测算=融资金额*利率/365*融资天数\n        BigDecimal fee = query.getFinanceAmount().multiply(new BigDecimal(query.getFinanceRate())).divide(new BigDecimal(100));\n        BigDecimal financeAmount = fee.divide(new BigDecimal(365), 8, RoundingMode.HALF_UP).multiply(new BigDecimal(query.getFinancePeriod()))\n                .setScale(2, RoundingMode.HALF_UP);\n        FinancingEstimateResultDTO estimateResult = new FinancingEstimateResultDTO();\n        estimateResult.setFeeAmount(financeAmount);\n        return ResponseMessage.success(estimateResult);\n    }\n    /**\n     * 提交融资申请\n     * @param applyDTO 包含银行编码等融资申请信息\n     * @return 申请提交结果\n     */\n    @Override\n    public ResponseMessage submitFinancingApply(PmcFinanceBankBaseQO applyDTO) {\n        // 1. 参数校验\n        if (applyDTO == null || applyDTO.getBankCode() == null) {\n            return ResponseMessage.fail(\"参数错误：申请信息不完整\");\n        }\n        // 3. 提交申请\n        if (PayBankConstants.CMB_BANK_CODE.equals(applyDTO.getBankCode())) {\n            return cmbClient.submitFinancingApply(applyDTO);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(applyDTO.getBankCode())) {\n            return cmbcClient.submitFinancingApply(applyDTO);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n\n        // 4. 返回申请结果\n    }\n\n    /**\n     * 通过详情信息提交融资申请\n     * @return 申请提交结果\n     */\n    private ResponseMessage submitFinancingApplyByDetail(PmcFinanceBankBaseQO request) {\n        // 发送银行提交申请\n        ResponseMessage responseMessage = submitFinancingApply(request);\n        // 3. 处理银行响应\n        if (ResponseMessage.FAIL.equals(responseMessage.getStatus())) {\n            log.error(\"银行接口调用失败，开始本地状态，申请单号：{}，错误原因：{}\",\n                    request.getApplyNumber(), responseMessage.getMessage());\n            request.setBankDealStatus(false);\n            updateApplyStatusOrSendMeg(request);\n            // 管理员重发需要抛具体异常\n            if (\"1\".equals(request.getProcessFlag())) {\n                return ResponseMessage.fail(\"银行处理失败：\" + getDataBaseMsg(request));\n            } else {\n                // 提交失败，看是否存在warnMsg\n                Object data = responseMessage.getData();\n                if (data != null) {\n                    Map<String, Object> map = new HashMap<>();\n                    if (data instanceof Map) {\n                        UtilType.copyProperties(map, data, true);\n                        if (StringUtils.isNotBlank(map.get(\"warnMsg\").toString())) {\n                            return ResponseMessage.success(map);\n                        }\n                    }\n                }\n                return responseMessage;\n            }\n        } else {\n            // 4. 更新本地状态已提交\n            request.setBankDealStatus(true);\n            updateApplyStatusOrSendMeg(request);\n        }\n        return responseMessage;\n    }\n\n    private String getDataBaseMsg(PmcFinanceBankBaseQO request) {\n        PmcFinanceSupplierApplyQO qo = new PmcFinanceSupplierApplyQO();\n        qo.setApplyNumber(request.getApplyNumber());\n        List<PmcFinanceSupplierApplyDTO> list;\n        list = pmcSupplierAdmClient.selectList(qo).getList();\n        if (list.isEmpty()) {\n            throw new WebException(\"查询不到申请单号：\" + request.getApplyNumber());\n        }\n        PmcFinanceSupplierApplyDTO dto = list.get(0);\n        return dto.getMessage();\n    }\n\n    /**\n    * 跨服务在这里汇总流程\n     * 1、发送银行获取额度\n     * 2、发送service校验额度、中间状态处理\n     * 3、修改为状态之后,同步占用额度，同步组装报文，校验关键信息是否为空，有缺失发送预警消息\n     * 4、service校验通过，则web模块发送银行进行申请\n     * 5、银行返回成功，则修改状态为已提交\n    * */\n    @Override\n    public ResponseMessage submitFinancingApplyOpt(PmcFinanceSupplierApplyDTO pmcFinanceSupplierApplyDTO) {\n        try {\n            // todo 流程待优化\n            // 1、先查询银行可用额度，放到报文DTO中\n            setAvailableAmount(pmcFinanceSupplierApplyDTO);\n\n            // 2、提交service校验额度、提交融资申请单\n            ResponseMessage responseMessage = pmcPortalClient.saveOrUpdateFinancingApply(pmcFinanceSupplierApplyDTO);\n\n            if (ResponseMessage.FAIL.equals(responseMessage.getStatus())) {\n                // 提交失败，看是否存在warnMsg\n                Object data = responseMessage.getData();\n                if (data != null) {\n                    Map<String, Object> map = new HashMap<>();\n                    if (data instanceof Map) {\n                        UtilType.copyProperties(map, data, true);\n                        if (StringUtils.isNotBlank(map.get(\"warnMsg\").toString())) {\n                            return ResponseMessage.success(map);\n                        }\n                    }\n                }\n                return responseMessage;\n            }\n\n            // 3、如果本地处理成功，并且状态为提交银行中，则提交银行融资申请\n            if (ResponseMessage.OK.equals(responseMessage.getStatus())\n                    && SupplierFinancingApplyStatus.SUBMITTED.name().equals(pmcFinanceSupplierApplyDTO.getStatus())) {\n                PmcFinanceBankBaseQO request = new PmcFinanceBankBaseQO();\n                Object quotaData = responseMessage.getData();\n                UtilType.copyProperties(request, quotaData, true);\n                return this.submitFinancingApplyByDetail(request);\n            }\n            return responseMessage;\n        } catch (WebException e) {\n            log.error(\"设置可用额度失败：{}\", e.getMessage());\n            return ResponseMessage.fail(\"设置银行可用额度失败：\" + e.getMessage());\n        } catch (Exception e) {\n            log.error(\"提交融资申请异常：\", e);\n            return ResponseMessage.fail(\"提交融资申请异常，请稍后重试\");\n        }\n    }\n\n    private void setAvailableAmount(PmcFinanceSupplierApplyDTO pmcFinanceSupplierApplyDTO) {\n        // 1、先查询银行可用额度，放到报文DTO中\n        PmcFinanceBankBaseQO baseQO = new PmcFinanceBankBaseQO();\n        baseQO.setSupplierCode(pmcFinanceSupplierApplyDTO.getSupplierCode());\n        baseQO.setBankCode(pmcFinanceSupplierApplyDTO.getBankCode());\n        baseQO.setCompanyCode(pmcFinanceSupplierApplyDTO.getCompanyCode());\n        ResponseMessage quotaResult = this.queryFinancingQuota(baseQO);\n        FinanceQuotaDTO quotaDTO = new FinanceQuotaDTO();\n        if (ResponseMessage.OK.equals(quotaResult.getStatus())) {\n            Object quotaData = quotaResult.getData();\n            UtilType.copyProperties(quotaDTO, quotaData, true);\n            pmcFinanceSupplierApplyDTO.setAvailableAmount(quotaDTO.getExoAvailableAmount());\n        } else  {\n            log.error(\"查询银行可用额度失败：{}\", quotaResult.getMessage());\n            // 异常直接返回错误信息\n            throw new WebException(\"查询银行可用额度失败, \" + quotaResult.getMessage());\n        }\n    }\n\n    /**\n     * 执行本地状态回滚操作\n     */\n    private void updateApplyStatusOrSendMeg(PmcFinanceBankBaseQO request) {\n        try {\n            ResponseMessage rollback = pmcSupplierAdmClient.updateApplyStatusOrSendMeg(request);\n            if (ResponseMessage.FAIL.equals(rollback.getStatus())) {\n                log.error(\"更新本地记录失败，申请单号：{}，错误信息：{}\",\n                    request.getApplyNumber(), rollback.getMessage());\n                throw new WebException(\"更新本地记录失败：\" + rollback.getMessage());\n            }\n        } catch (Exception e) {\n            log.error(\"更新融资本地记录时发生异常，申请单号：{}\", request.getApplyNumber(), e);\n            throw new WebException(\"更新融资本地记录时发生异常\" + e.getMessage());\n        }\n    }\n\n    /**\n     * 查询融资结果\n     * @param query 包含银行编码等查询条件\n     * @return 融资结果信息\n     */\n    @Override\n    public ResponseMessage queryFinancingResult(PmcFinanceBankBaseQO query) {\n        // 1. 参数校验\n        if (query == null || query.getBankCode() == null) {\n            return ResponseMessage.fail(\"参数错误：银行编码不能为空\");\n        }\n\n        // 2 通用业务校验\n        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(query, \"queryFinancingResult\");\n        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n            return checkResult;\n        }\n        // 3. 查询融资结果\n        if (PayBankConstants.CMB_BANK_CODE.equals(query.getBankCode())) {\n            return cmbClient.queryFinancingResult(query);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(query.getBankCode())) {\n            return cmbcClient.queryFinancingResult(query);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n\n    /**\n     * 查询融资额度\n     * @param query 包含银行编码和供应商编码、公司编码的查询条件\n     * @return 融资额度信息\n     */\n    @Override\n    public ResponseMessage queryFinancingQuota(PmcFinanceBankBaseQO query) {\n        // 1. 参数校验\n        if (query == null || query.getSupplierCode() == null || query.getBankCode() == null) {\n            return ResponseMessage.fail(\"参数错误：银行编码或者供应商编码不能为空\");\n        }\n       return getUseQuota(query);\n    }\n\n    /**\n     * 上传融资附件\n     * @param file 上传的文件\n     * @param qo 包含银行编码等附件信息\n     * @return 上传结果\n     */\n    @Override\n    public ResponseMessage uploadFinancingAttachment(MultipartFile file, PmcFinanceBankBaseQO qo) {\n        // 1. 参数校验\n        if (file == null || file.isEmpty() || qo == null || StringUtils.isBlank(qo.getBankCode())) {\n            return ResponseMessage.fail(\"参数错误：文件或银行编码不能为空\");\n        }\n\n        // 2 通用业务校验\n        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(qo, \"uploadFinancingAttachment\");\n        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n            return checkResult;\n        }\n\n        // 3. 文件上传处理\n        if (PayBankConstants.CMB_BANK_CODE.equals(qo.getBankCode())) {\n            return cmbClient.uploadAttachment(file, qo);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(qo.getBankCode())) {\n            return cmbcClient.uploadAttachment(file, qo);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n\n    /**\n     * 补充融资附件\n     * @param qo 包含银行编码等附件信息\n     * @return 补充上传结果\n     */\n    @Override\n    public ResponseMessage supplementFinancingAttachment(PmcFinanceBankBaseQO qo) {\n        // 1. 参数校验\n        if (qo.getAttachList() == null || qo.getAttachList().isEmpty() || qo == null || StringUtils.isBlank(qo.getApplyNumber())) {\n            return ResponseMessage.fail(\"参数错误：附件列表或申请单号不能为空\");\n        }\n        // 2 通用业务校验\n        ResponseMessage checkResult = pmcSupplierAdmClient.commonCheckData(qo, \"supplementFinancingAttachment\");\n        if (ResponseMessage.FAIL.equals(checkResult.getStatus())) {\n            return checkResult;\n        }\n        // 3. 文件补充处理\n        if (PayBankConstants.CMB_BANK_CODE.equals(qo.getBankCode())) {\n            return cmbClient.supplementFinancingAttachment(qo);\n        } else  if (PayBankConstants.CMBC_BANK_CODE.equals(qo.getBankCode())) {\n            return cmbcClient.supplementFinancingAttachment(qo);\n        } else {\n            return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n        }\n    }\n\n    @Override\n    public ResponseMessage adminSubmitFinancingApply(PmcFinanceSupplierApplyDTO pmcFinanceSupplierApplyQO) {\n        // 1、先查询银行可用额度，放到报文DTO中\n        setAvailableAmount(pmcFinanceSupplierApplyQO);\n\n        // 2、校验关键信息\n        PmcFinanceBankBaseQO query = new PmcFinanceBankBaseQO();\n        query.setApplyNumber(pmcFinanceSupplierApplyQO.getApplyNumber());\n        query.setBankCode(pmcFinanceSupplierApplyQO.getBankCode());\n        query.setCompanyCode(pmcFinanceSupplierApplyQO.getCompanyCode());\n        query.setPayCheckNum(pmcFinanceSupplierApplyQO.getPayCheckNum());\n        query.setSupplierCode(pmcFinanceSupplierApplyQO.getSupplierCode());\n        query.setBankQuota(pmcFinanceSupplierApplyQO.getAvailableAmount());\n        ResponseMessage checkResult = pmcSupplierAdmClient.admSubmitApply(query);\n        if (ResponseMessage.OK.equals(checkResult.getStatus())) {\n            PmcFinanceBankBaseQO request = new PmcFinanceBankBaseQO();\n            Object quotaData = checkResult.getData();\n            UtilType.copyProperties(request, quotaData, true);\n            request.setProcessFlag(\"1\");\n            return this.submitFinancingApplyByDetail(request);\n        }\n        return checkResult;\n    }\n\n\n    /**\n     * 补充融资附件\n     *\n     * @param attachDTO 融资附件上传DTO，包含附件列表和申请编号\n     * @return ResponseMessage 统一响应对象，包含操作结果\n     */\n    @Override\n    public ResponseMessage admSupplementAttach(PmcFinanceAdmUploadAttachDTO attachDTO) {\n        ResponseMessage responseMessage = pmcSupplierAdmClient.getUploadAdmAttachment(attachDTO);\n        if (ResponseMessage.FAIL.equals(responseMessage.getStatus())) {\n            return responseMessage;\n        }\n        @SuppressWarnings(\"unchecked\")\n        Map<String, Object> map = (Map<String, Object>) responseMessage.getData();\n\n        PmcFinanceBankBaseQO qo = BeanUtil.mapToBean(map, PmcFinanceBankBaseQO.class, true);\n        qo.setApplyNumber(attachDTO.getApplyNumber());\n\n        return supplementFinancingAttachment(qo);\n    }\n\n\n    private ResponseMessage getUseQuota(PmcFinanceBankBaseQO query) {\n        // 1、查询本地维护的额度信息\n        PmcPortalRemainQuotaQO pmcPortalRemainQuotaQO = new PmcPortalRemainQuotaQO();\n        pmcPortalRemainQuotaQO.setSupplierCode(query.getSupplierCode());\n        pmcPortalRemainQuotaQO.setBankCode(query.getBankCode());\n        pmcPortalRemainQuotaQO.setCompanyCode(query.getCompanyCode());\n        BigDecimal localQuotaResult = pmcSupplierAdmClient.calculateAvailableQuota(pmcPortalRemainQuotaQO);\n        log.info(\"供应商{}，本地额度：{}\", query.getSupplierCode(), localQuotaResult);\n        // 2、查询银行额度信息\n        Map<String, Object> selectMap = pmcSupplierAdmClient.selectInit();\n        if (selectMap == null || selectMap.isEmpty()) {\n            return ResponseMessage.fail(\"系统初始化失败，请联系管理员\");\n        }\n        List<Map<String, Object>> bankQuotaMapList = (List<Map<String, Object>>) selectMap.get(\"bankQuotaList\");\n        FinanceQuotaDTO quotaDTO = new FinanceQuotaDTO();\n        quotaDTO.setExoAvailableAmount(localQuotaResult);\n        if (CollectionUtils.isEmpty(bankQuotaMapList)) {\n            return ResponseMessage.success(\"ok\", quotaDTO);\n        }\n        boolean hasBankQuota = bankQuotaMapList.stream()\n                .anyMatch(map -> query.getBankCode().equals(map.get(\"code\")));\n        // 3、返回额度信息\n        if (hasBankQuota) {\n            if (PayBankConstants.CMB_BANK_CODE.equals(query.getBankCode())) {\n                Object quotaData = cmbClient.queryFinancingQuota(query).getData();\n                if (quotaData instanceof Map) {\n                    Map<String, Object> quotaMap = (Map<String, Object>) quotaData;\n                    quotaDTO.setExoAvailableAmount(new BigDecimal(quotaMap.get(\"exoAvailableAmount\").toString()));\n                    // 其他需要的字段可以添加到这里\n                } else if (quotaData instanceof FinanceQuotaDTO) {\n                    quotaDTO = (FinanceQuotaDTO) quotaData;\n                }\n                if (localQuotaResult.compareTo(quotaDTO.getExoAvailableAmount()) < 0) {\n                    quotaDTO.setExoAvailableAmount(localQuotaResult);\n                }\n                log.info(\"供应商{}，银行额度：{}\", query.getSupplierCode(), JSONObject.toJSONString(quotaDTO));\n                return ResponseMessage.success(\"ok\", quotaDTO);\n            }  else {\n                return ResponseMessage.fail(\"参数错误：不支持的银行编码\");\n            }\n        } else {\n            return ResponseMessage.success(\"ok\", quotaDTO);\n        }\n    }\n}",
