      "content": "package com.baidu.pmc.web.controller;\n\nimport com.baidu.pmc.common.ResponseMessage;\nimport com.baidu.pmc.common.exception.WebException;\nimport com.baidu.pmc.common.i18n.constants.ResponseStream;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.pojo.dto.PmcAccountDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceAdmUploadAttachDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceCompQuotaSetDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierQuotaSetDTO;\nimport com.baidu.pmc.pojo.dto.SupplierFinancingUsageDTO;\nimport com.baidu.pmc.pojo.model.PmcDataP2pSupplier;\nimport com.baidu.pmc.pojo.model.PmcFinanceCompQuotaSet;\nimport com.baidu.pmc.pojo.qo.PmcAccountSearchQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceCompQuotaSetQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceSupplierApplyQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceSupplierQuotaSetQO;\nimport com.baidu.pmc.pojo.qo.PmcPortalSuggestQO;\nimport com.baidu.pmc.pojo.qo.SupplierFinancingUsageQO;\nimport com.baidu.pmc.pojo.vo.PageInfo;\nimport com.baidu.pmc.web.clients.PmcSupplierAdmClient;\nimport com.baidu.pmc.web.configuration.export.ExportRepeatCheckLock;\nimport com.baidu.pmc.web.service.financing.PmcFinancingBankService;\nimport com.baidu.pmc.web.utils.ExportExcelUtil;\nimport lombok.extern.slf4j.Slf4j;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.http.HttpStatus;\nimport org.springframework.http.ResponseEntity;\nimport org.springframework.stereotype.Controller;\nimport org.springframework.web.bind.annotation.PostMapping;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.ResponseBody;\n\nimport javax.servlet.http.HttpServletRequest;\nimport javax.servlet.http.HttpServletResponse;\nimport java.math.BigDecimal;\nimport java.util.ArrayList;\nimport java.util.List;\nimport java.util.Map;\n\n/**\n * pmc 管理员融资申请列表查询接入接口\n *\n * @author liumandong\n */\n@RequestMapping(\"/pmcSupplierAdm\")\n@Slf4j\n@Controller\npublic class PmcSupplierAdmController {\n\n\n    @Autowired\n    private PmcSupplierAdmClient pmcSupplierAdmClient;\n\n    @Autowired\n    private ExportExcelUtil exportExcelUtil;\n\n    private static final String FILE_NAME_PREFIX = \"主体额度查询\";\n\n    @Autowired\n    private PmcFinancingBankService pmcFinancingBankService;\n\n\n    @PostMapping(\"/selectList\")\n    @ResponseBody\n    public ResponseEntity<?> selectList(@RequestBody PmcFinanceSupplierApplyQO pmcFinanceSupplierApplyQO) {\n        PageInfo<PmcFinanceSupplierApplyDTO> data = pmcSupplierAdmClient.selectList(pmcFinanceSupplierApplyQO);\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", data), HttpStatus.OK);\n    }\n\n    /**\n     * 管理员导出融资申请列表\n     */\n    @PostMapping(\"/export\")\n    @ResponseBody\n    @ExportRepeatCheckLock\n    public ResponseMessage export(@RequestBody PmcFinanceSupplierApplyQO query,\n                                                  HttpServletRequest request, HttpServletResponse response) {\n        log.info(\"管理员点击导出融资申请列表\");\n        List<PmcFinanceSupplierApplyDTO> result = pmcSupplierAdmClient.export(query);\n        List<List<List<List<String>>>> detailsList = new ArrayList<>();\n        List<List<List<String>>> detailsNew = new ArrayList<>();\n        List<List<String>> resultIn = new ArrayList<>();\n        int index = 1;\n        for (PmcFinanceSupplierApplyDTO data : result) {\n            List<String> values = new ArrayList<>();\n            // 序号\n            values.add(String.valueOf(index++));\n            values.add(String.valueOf(data.getSupplierName()));\n            values.add(String.valueOf(data.getApplyNumber()));\n            values.add(String.valueOf(data.getSourceNum()));\n            values.add(String.valueOf(DateUtils.formatDate(data.getCreateDate())));\n            values.add(String.valueOf(data.getPayAmount()));\n            values.add(String.valueOf(data.getFinanceAmount()));\n            values.add(String.valueOf(data.getCurrencyName()));\n            values.add(String.valueOf(data.getBankCodeName()));\n            values.add(String.valueOf(data.getFinanceDay()));\n            values.add(String.valueOf(data.getFinanceRate() == null ? \"--\" : data.getFinanceRate() + \"%\"));\n            values.add(String.valueOf(data.getFactoringFee() == null ? \"--\" : data.getFactoringFee()));\n            values.add(String.valueOf(data.getActualFinanceAmount()  == null ? \"--\" : data.getActualFinanceAmount()));\n            values.add(String.valueOf(DateUtils.formatDate(data.getFinanceBankBeginDate()) == null ? \"--\"\n                    : DateUtils.formatDate(data.getFinanceBankBeginDate())));\n            values.add(String.valueOf(DateUtils.formatDate(data.getFinanceBankEndDate())) == null ? \"--\"\n                    : DateUtils.formatDate(data.getFinanceBankEndDate()));\n            values.add(String.valueOf(data.getApplySubmit()));\n            values.add(String.valueOf(data.getStatusDesc()));\n            values.add(String.valueOf(StringUtils.isBlank(data.getNextOperationNode()) ? \"--\" : data.getNextOperationNode()));\n            resultIn.add(values);\n        }\n        detailsNew.add(resultIn);\n        detailsList.add(detailsNew);\n        String[] sheetName = {\"供应商融资列表导出\"};\n        String[] headerIn = {\"序号\", \"供应商名称\", \"融资申请单号\", \"付款单号\", \"融资申请日期\", \"可融资金额\",\n                \"融资申请金额\", \"币种\", \"融资机构\", \"融资天数\", \"融资利率\", \"保理手续费\", \"实际融资金额\", \"融资开始日期\",\n                \"融资结束日期\",\"申请人\",\"融资申请状态\",\"后续处理节点\"};\n        List<String[]> headers = new ArrayList<>();\n        headers.add(headerIn);\n        try {\n            ResponseStream.setHeader(\"供应商融资列表导出\".concat(DateUtils.getDate(\"yyyyMMddHHmmss\")).concat(\".xlsx\"),\n                    ResponseStream.ContentType.EXCEL, request, response);\n            exportExcelUtil.exportMoreDifferentSheetExcel(sheetName, headers, detailsList, response);\n        } catch (Exception e) {\n            throw new WebException(\"导出异常\");\n        }\n        return ResponseMessage.success(\"导出成功\");\n    }\n\n\n    /**\n     * 查询主体额度\n     */\n    @PostMapping(\"/getQuotaSet\")\n    @ResponseBody\n    public ResponseEntity<?> selectQuotaSet(@RequestBody PmcFinanceCompQuotaSetQO query) {\n        try {\n            PageInfo<PmcFinanceCompQuotaSetDTO> result = pmcSupplierAdmClient.selectQuotaSet(query);\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\", result), HttpStatus.OK);\n        } catch (Exception e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 导出主体额度\n     */\n    @PostMapping(\"/exportQuotaSet\")\n    @ResponseBody\n    @ExportRepeatCheckLock\n    public ResponseMessage exportQuotaSet(@RequestBody PmcFinanceCompQuotaSetQO query,\n                                                                          HttpServletRequest request, HttpServletResponse response) {\n        log.info(\"web用户点击导出主体额度\");\n        List<PmcFinanceCompQuotaSetDTO> result = pmcSupplierAdmClient.exportQuotaSet(query);\n        List<List<List<List<String>>>> detailsList = new ArrayList<>();\n        List<List<List<String>>> detailsNew = new ArrayList<>();\n        List<List<String>> resultIn = new ArrayList<>();\n        int index = 1;\n        for (PmcFinanceCompQuotaSetDTO data : result) {\n            List<String> values = new ArrayList<>();\n            // 序号\n            values.add(String.valueOf(index++));\n            // 银行名称\n            values.add(String.valueOf(data.getBankCodeName()));\n            values.add(String.valueOf(data.getCompanyCode()));\n            values.add(String.valueOf(data.getCompanyCodeName()));\n            values.add(\"Y\".equals(data.getEnableFlag()) ? \"是\" : \"否\");\n            values.add(data.getCreditCompCodeName());\n            values.add(String.valueOf(data.getBankCreditQuota()));\n            values.add(String.valueOf(data.getCompanyCreditQuota()));\n            values.add(String.valueOf(data.getRemainQuota()));\n            values.add(data.getPayAccount());\n            resultIn.add(values);\n        }\n        detailsNew.add(resultIn);\n        detailsList.add(detailsNew);\n        String[] sheetName = {\"主体额度查询\"};\n        String[] headerIn = {\"序号\", \"银行名称\", \"公司主体编号\", \"主体名称\", \"是否启用\", \"银行授信主体\", \"银行授信主体额度\",\n                \"公司主体授信额度\",\n                \"银行授信主体剩余额度\", \"公司主体自动扣款账户\"};\n        List<String[]> headers = new ArrayList<>();\n        headers.add(headerIn);\n        try {\n            ResponseStream.setHeader(FILE_NAME_PREFIX.concat(DateUtils.getDate(\"yyyyMMddHHmmss\")).concat(\".xlsx\"),\n                    ResponseStream.ContentType.EXCEL, request, response);\n            exportExcelUtil.exportMoreDifferentSheetExcel(sheetName, headers, detailsList, response);\n        } catch (Exception e) {\n            throw new WebException(\"导出异常\");\n        }\n        return ResponseMessage.success(\"导出成功\");\n    }\n\n\n    /**\n     * 保存主体额度\n     */\n    @PostMapping(\"/saveOrUpdate\")\n    @ResponseBody\n    public ResponseMessage saveOrUpdate(@RequestBody PmcFinanceCompQuotaSetDTO dto) {\n        return pmcSupplierAdmClient.saveOrUpdate(dto);\n    }\n\n\n    /**\n     * 查询供应商额度\n     */\n    @PostMapping(\"/getSupplierQuota\")\n    @ResponseBody\n    public ResponseEntity<?> selectSupplierQuotaSet(@RequestBody PmcFinanceSupplierQuotaSetQO query) {\n        try {\n            PageInfo<PmcFinanceSupplierQuotaSetDTO> result = pmcSupplierAdmClient.selectSupplierQuotaSet(query);\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\", result), HttpStatus.OK);\n        } catch (Exception e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n\n    /**\n     * 查询供应商额度使用情况\n     */\n    @PostMapping(\"/getSupplierQuotaUse\")\n    @ResponseBody\n    public ResponseEntity<?> selectSupplierQuotaUse(@RequestBody SupplierFinancingUsageQO query) {\n        try {\n            PageInfo<SupplierFinancingUsageDTO> result = pmcSupplierAdmClient.selectSupplierQuotaUse(query);\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\", result), HttpStatus.OK);\n        } catch (Exception e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n\n    /**\n     * 导出供应商额度\n     */\n    @PostMapping(\"/exportSupplierQuota\")\n    @ResponseBody\n    @ExportRepeatCheckLock\n    public ResponseMessage exportSupplierQuotaSet(@RequestBody PmcFinanceSupplierQuotaSetQO query,\n                                                  HttpServletRequest request, HttpServletResponse response) {\n        log.info(\"web用户点击导出供应商额度\");\n        List<PmcFinanceSupplierQuotaSetDTO> result = pmcSupplierAdmClient.exportSupplierQuotaSet(query);\n        List<List<List<List<String>>>> detailsList = new ArrayList<>();\n        List<List<List<String>>> detailsNew = new ArrayList<>();\n        List<List<String>> resultIn = new ArrayList<>();\n        int index = 1;\n        for (PmcFinanceSupplierQuotaSetDTO data : result) {\n            List<String> values = new ArrayList<>();\n            // 序号\n            values.add(String.valueOf(index++));\n            values.add(String.valueOf(data.getSupplierName()));\n            values.add(String.valueOf(data.getRegistrationCode()));\n            values.add(String.valueOf(data.getSupplierCode()));\n            values.add(\"Y\".equals(data.getFinanceFlag()) ? \"是\" : \"否\");\n            values.add(String.valueOf(data.getCreditQuota()));\n            values.add(DateUtils.formatDate(data.getEffectiveStartDate()));\n            values.add(DateUtils.formatDate(data.getEffectiveEndDate()));\n            resultIn.add(values);\n        }\n        detailsNew.add(resultIn);\n        detailsList.add(detailsNew);\n        String[] sheetName = {\"供应商额度查询\"};\n        String[] headerIn = {\"序号\", \"供应商名称\", \"统一社会信用代码\",  \"供应商编码\", \"是否开通融资业务\",\n                \"授信额度\", \"生效开始日期\", \"生效结束日期\"};\n        List<String[]> headers = new ArrayList<>();\n        headers.add(headerIn);\n        try {\n            ResponseStream.setHeader(\"供应商额度查询\".concat(DateUtils.getDate(\"yyyyMMddHHmmss\")).concat(\".xlsx\"),\n                    ResponseStream.ContentType.EXCEL, request, response);\n            exportExcelUtil.exportMoreDifferentSheetExcel(sheetName, headers, detailsList, response);\n        } catch (Exception e) {\n            throw new WebException(\"导出异常\");\n        }\n        return ResponseMessage.success(\"导出成功\");\n    }\n\n    /**\n     * 保存供应商额度\n     */\n    @PostMapping(\"/saveOrUpdateSupplierQuota\")\n    @ResponseBody\n    public ResponseMessage saveOrUpdateSupplierQuotaSet(@RequestBody PmcFinanceSupplierQuotaSetDTO dto) {\n        return pmcSupplierAdmClient.saveOrUpdateSupplierQuotaSet(dto);\n    }\n\n\n    @PostMapping(\"/selectInit\")\n    public ResponseEntity<Object> selectInit() {\n        Map<String, Object> selectMap = pmcSupplierAdmClient.selectInit();\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", selectMap), HttpStatus.OK);\n    }\n\n    /**\n     * 根据输入值模糊检索交易类型code和名称\n     * @param parameter\n     * @return\n     */\n    @PostMapping(value = \"/selectSuggest\")\n    public ResponseEntity<Object> selectSuggest(@RequestBody PmcPortalSuggestQO parameter) {\n        List<PmcDataP2pSupplier> codeDescs = pmcSupplierAdmClient.selectSuggest(parameter);\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", codeDescs), HttpStatus.OK);\n    }\n\n    @PostMapping(\"/selectSuggestAccount\")\n    @ResponseBody\n    public ResponseEntity selectAccount(@RequestBody PmcAccountSearchQO pmcAccountSearchQO) {\n        PageInfo<PmcAccountDTO> data = pmcSupplierAdmClient.getAccountViewPage(pmcAccountSearchQO);\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", data), HttpStatus.OK);\n    }\n\n    /**\n     * 计算两个精度数据的差值(前端丢精度)\n     * @return 两个数值的差值\n     */\n    @PostMapping(\"/calculateDifference\")\n    @ResponseBody\n    public ResponseEntity calculateDifference(@RequestBody PmcFinanceCompQuotaSet quotaSet) {\n        if (quotaSet.getBankCreditQuota() == null || quotaSet.getCompanyCreditQuota() == null) {\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\", 0.00), HttpStatus.OK);\n        }\n        BigDecimal remainQuota = quotaSet.getBankCreditQuota().subtract(quotaSet.getCompanyCreditQuota());\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", remainQuota), HttpStatus.OK);\n    }\n    /**\n     * 管理员拒绝发送中的融资\n     */\n    @PostMapping(\"/admRejectSendBank\")\n    @ResponseBody\n    public ResponseMessage admReject(@RequestBody PmcFinanceSupplierApplyDTO query) {\n        return pmcSupplierAdmClient.admRejectSendBank(query);\n    }\n\n    /**\n     * 管理员再次提交发送中的融资到银行\n     */\n    @PostMapping(\"/admSendToBank\")\n    @ResponseBody\n    public ResponseMessage admSendToBank(@RequestBody PmcFinanceSupplierApplyDTO query) {\n        return pmcFinancingBankService.adminSubmitFinancingApply(query);\n    }\n\n    /**\n     * 管理员补充附件上传\n     * 先通过attach/upload 上传后得到  List<Long> attachIds; 再通过接口关联并上传银行\n     */\n    @PostMapping(\"/admSupplementAttach\")\n    @ResponseBody\n    public ResponseMessage admSupplementAttach(@RequestBody PmcFinanceAdmUploadAttachDTO attachDTO) {\n        if (attachDTO.getAttachList() == null || attachDTO.getAttachList().isEmpty()) {\n            return ResponseMessage.fail(\"附件ID列表不能为空\");\n        }\n        if (attachDTO.getApplyNumber() == null) {\n            return ResponseMessage.fail(\"融资申请编号不能为空\");\n        }\n        return pmcFinancingBankService.admSupplementAttach(attachDTO);\n    }\n\n    /**\n     * 获取融资申请单详情\n     */\n    @PostMapping(\"/getDetail\")\n    @ResponseBody\n    public ResponseEntity<?> getFinancingApplyDetail(@RequestBody PmcFinanceSupplierApplyQO query) {\n        Map<String, Object> result = pmcSupplierAdmClient.getFinancingApplyDetail(query);\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", result), HttpStatus.OK);\n    }\n    \n\n}\n",
