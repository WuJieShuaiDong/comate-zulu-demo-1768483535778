      "content": "package com.baidu.pmc.web.controller;\n\nimport com.baidu.pmc.common.ResponseMessage;\n\n\nimport com.baidu.pmc.common.exception.WebException;\nimport com.baidu.pmc.common.i18n.constants.ResponseStream;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.common.utils.StringUtils;\n\nimport com.baidu.pmc.pojo.dto.PmcAccountDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceCompQuotaSetDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyHisDTO;\nimport com.baidu.pmc.pojo.dto.PmcPayChecksSupplierCodeDTO;\nimport com.baidu.pmc.pojo.dto.FinanceIndicatorDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceApplyNumberDTO;\n\nimport com.baidu.pmc.pojo.model.PmcDataP2pSupplier;\nimport com.baidu.pmc.pojo.qo.PmcFinanceCompQuotaSetQO;\nimport com.baidu.pmc.pojo.qo.PmcPortalSuggestQO;\nimport com.baidu.pmc.pojo.qo.PayChecksQO;\nimport com.baidu.pmc.pojo.qo.PmcAccountSearchQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceSupplierApplyQO;\nimport com.baidu.pmc.pojo.qo.PmcPortalRemainQuotaQO;\nimport com.baidu.pmc.pojo.vo.PageInfo;\nimport com.baidu.pmc.web.clients.PmcPortalClient;\nimport com.baidu.pmc.web.configuration.export.ExportRepeatCheckLock;\nimport com.baidu.pmc.web.service.financing.PmcFinancingBankService;\nimport com.baidu.pmc.web.utils.ExportExcelUtil;\n\nimport lombok.extern.slf4j.Slf4j;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.http.HttpStatus;\nimport org.springframework.http.ResponseEntity;\nimport org.springframework.stereotype.Controller;\nimport org.springframework.web.bind.annotation.PostMapping;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.ResponseBody;\n\n\nimport javax.servlet.http.HttpServletRequest;\nimport javax.servlet.http.HttpServletResponse;\nimport java.math.BigDecimal;\nimport java.util.ArrayList;\nimport java.util.List;\nimport java.util.Map;\n\n/**\n * pmc portal 接入接口\n *\n * @author liumandong\n */\n@RequestMapping(\"/pmcPortal\")\n@Slf4j\n@Controller\npublic class PmcPortalController {\n\n    @Autowired\n    private PmcPortalClient pmcPortalClient;\n\n    @Autowired\n    private ExportExcelUtil exportExcelUtil;\n\n    @Autowired\n    private PmcFinancingBankService pmcFinancingBankService;\n\n\n    @PostMapping(\"/selectList\")\n    @ResponseBody\n    public ResponseMessage selectList(@RequestBody PmcFinanceSupplierApplyQO pmcFinanceSupplierApplyQO) {\n        PageInfo<PmcFinanceSupplierApplyDTO> data = pmcPortalClient.selectList(pmcFinanceSupplierApplyQO);\n        return ResponseMessage.success(data);\n    }\n\n\n    @PostMapping(\"/getPayCheckList\")\n    @ResponseBody\n    public ResponseEntity getPayCheckList(@RequestBody PmcFinanceSupplierApplyQO qo) {\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\",\n                pmcPortalClient.getPayCheckList(qo)), HttpStatus.OK);\n    }\n\n\n    /**\n     * 保存融资申请单\n     */\n    @PostMapping(\"/saveOrUpdate\")\n    @ResponseBody\n    public ResponseMessage saveOrUpdateFinancingApply(@RequestBody PmcFinanceSupplierApplyDTO pmcFinanceSupplierApplyDTO) {\n        return pmcFinancingBankService.submitFinancingApplyOpt(pmcFinanceSupplierApplyDTO);\n    }\n\n\n    /**\n     * 查询融资申请历史记录\n     */\n    @PostMapping(\"/queryHis\")\n    @ResponseBody\n    public ResponseEntity<?> queryFinancingApplyHis(@RequestBody PmcFinanceSupplierApplyQO query) {\n        try {\n            PageInfo<PmcFinanceSupplierApplyHisDTO> result = pmcPortalClient.queryFinancingApplyHis(query);\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\", result), HttpStatus.OK);\n        } catch (Exception e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 获取融资申请单详情\n     */\n    @PostMapping(\"/getDetail\")\n    @ResponseBody\n    public ResponseEntity<?> getFinancingApplyDetail(@RequestBody PmcFinanceSupplierApplyQO query) {\n        Map<String, Object> result = pmcPortalClient.getFinancingApplyDetail(query);\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", result), HttpStatus.OK);\n    }\n\n    /**\n     * 获取付款单详情\n     */\n    @PostMapping(\"/getPayCheckDetail\")\n    @ResponseBody\n    public ResponseEntity<?> selectPmcPayCheckByPayCheckNum(@RequestBody PayChecksQO payChecksQO) {\n        PmcPayChecksSupplierCodeDTO result = pmcPortalClient.selectPmcPayCheckByPayCheckNum(payChecksQO);\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", result), HttpStatus.OK);\n    }\n\n\n    /**\n     * 导出供应商申请列表\n     */\n    @PostMapping(\"/export\")\n    @ResponseBody\n    @ExportRepeatCheckLock\n    public ResponseMessage exportSupplierQuotaSet(@RequestBody PmcFinanceSupplierApplyQO query,\n                                                  HttpServletRequest request, HttpServletResponse response) {\n        log.info(\"供应商点击导出融资申请列表\");\n        List<PmcFinanceSupplierApplyDTO> result = pmcPortalClient.export(query);\n        List<List<List<List<String>>>> detailsList = new ArrayList<>();\n        List<List<List<String>>> detailsNew = new ArrayList<>();\n        List<List<String>> resultIn = new ArrayList<>();\n        int index = 1;\n        for (PmcFinanceSupplierApplyDTO data : result) {\n            List<String> values = new ArrayList<>();\n            // 序号\n            values.add(String.valueOf(index++));\n            values.add(String.valueOf(data.getSupplierName()));\n            values.add(String.valueOf(data.getApplyNumber()));\n            values.add(String.valueOf(data.getSourceNum()));\n            values.add(String.valueOf(data.getPayAmount()));\n            values.add(String.valueOf(data.getFinanceAmount()));\n            values.add(String.valueOf(data.getCurrencyName()));\n            values.add(String.valueOf(data.getBankCodeName()));\n            values.add(String.valueOf(data.getFinanceDay()));\n            values.add(String.valueOf(data.getApplySubmit()));\n            values.add(String.valueOf(data.getStatusDesc()));\n            values.add(String.valueOf(StringUtils.isBlank(data.getNextOperationNode()) ? \"--\" : data.getNextOperationNode()));\n            resultIn.add(values);\n        };\n        detailsNew.add(resultIn);\n        detailsList.add(detailsNew);\n        String[] sheetName = {\"供应商融资列表导出\"};\n        String[] headerIn = {\"序号\", \"供应商名称\", \"融资申请单号\", \"付款单号\", \"可融资金额\",\n                \"融资申请金额\", \"币种\", \"融资机构\", \"融资天数\", \"申请人\", \"融资申请状态\", \"后续处理节点\"};\n        List<String[]> headers = new ArrayList<>();\n        headers.add(headerIn);\n        try {\n            ResponseStream.setHeader(\"供应商融资列表导出\".concat(DateUtils.getDate(\"yyyyMMddHHmmss\")).concat(\".xlsx\"),\n                    ResponseStream.ContentType.EXCEL, request, response);\n            exportExcelUtil.exportMoreDifferentSheetExcel(sheetName, headers, detailsList, response);\n        } catch (Exception e) {\n            throw new WebException(\"导出异常\");\n        }\n        return ResponseMessage.success(\"导出成功\");\n    }\n\n    @PostMapping(\"/selectInit\")\n    public ResponseEntity<Object> selectInit() {\n        Map<String, Object> selectMap = pmcPortalClient.selectInit();\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", selectMap), HttpStatus.OK);\n    }\n\n    /**\n     * 根据输入值模糊检索交易类型code和名称\n     * @param parameter\n     * @return\n     */\n    @PostMapping(value = \"/selectSuggest\")\n    @ResponseBody\n    public ResponseEntity<Object> selectSuggest(@RequestBody PmcPortalSuggestQO parameter) {\n        List<PmcDataP2pSupplier> codeDescs = pmcPortalClient.selectSuggest(parameter);\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", codeDescs), HttpStatus.OK);\n    }\n\n    /**\n     * 计算供应商可用额度\n     * @return 可用额度\n     */\n    @PostMapping(\"/calculateAvailableQuota\")\n    @ResponseBody\n    public ResponseEntity<Object> calculateAvailableQuota(@RequestBody PmcPortalRemainQuotaQO query) {\n        try {\n            BigDecimal availableQuota = pmcPortalClient.calculateAvailableQuota(query);\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\", availableQuota), HttpStatus.OK);\n        } catch (Exception e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    @PostMapping(\"/selectSuggestAccount\")\n    @ResponseBody\n    public ResponseEntity selectAccount(@RequestBody PmcAccountSearchQO pmcAccountSearchQO) {\n        PageInfo<PmcAccountDTO> data = pmcPortalClient.getAccountViewPage(pmcAccountSearchQO);\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", data), HttpStatus.OK);\n    }\n\n    /**\n     * 生成融资申请单号\n     * @return 融资申请单号，格式：FA+日期时间+4位流水，例如：FA202506111200000001\n     */\n    @PostMapping(\"/generateFinancingNo\")\n    @ResponseBody\n    public ResponseEntity<?> generateFinancingApplicationNo() {\n        PmcFinanceApplyNumberDTO applicationNoJson = pmcPortalClient.generateFinancingApplicationNo();\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", applicationNoJson), HttpStatus.OK);\n    }\n\n    /**\n     * 查询是否融资权限\n     */\n    @PostMapping(\"/getFinanceRole\")\n    public ResponseEntity<?> getFinanceRole() {\n        try {\n            boolean status = pmcPortalClient.getFinanceRole();\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\", status), HttpStatus.OK);\n        } catch (Exception e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n\n    /**\n     * 查询供应商融资指标数据\n     * @return 融资指标DTO\n     */\n    @PostMapping(\"/getKpiData\")\n    @ResponseBody\n    public ResponseEntity<?> queryFinanceIndicators() {\n        try {\n            FinanceIndicatorDTO indicators = pmcPortalClient.queryFinanceIndicators();\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\", indicators), HttpStatus.OK);\n        } catch (Exception e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 查询主体额度\n     */\n    @PostMapping(\"/getQuotaSet\")\n    @ResponseBody\n    public ResponseEntity<?> selectQuotaSet(@RequestBody PmcFinanceCompQuotaSetQO query) {\n        try {\n            PageInfo<PmcFinanceCompQuotaSetDTO> result = pmcPortalClient.selectQuotaSet(query);\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\", result), HttpStatus.OK);\n        } catch (Exception e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 检查融资首页大图提示状态\n     * @return 是否显示提示\n     */\n    @PostMapping(\"/checkPromptStatus\")\n    @ResponseBody\n    public ResponseEntity<?> checkPromptStatus() {\n        try {\n            Boolean shouldShow = pmcPortalClient.checkPromptStatus();\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\", shouldShow), HttpStatus.OK);\n        } catch (Exception e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 永久不显示融资首页大图提示\n     * @return 操作结果\n     */\n    @PostMapping(\"/disablePromptPermanently\")\n    @ResponseBody\n    public ResponseEntity<?> disablePromptPermanently() {\n        try {\n            pmcPortalClient.disablePromptPermanently();\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\"), HttpStatus.OK);\n        } catch (Exception e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 当天不显示融资首页大图提示\n     * @return 操作结果\n     */\n    @PostMapping(\"/closePromptForToday\")\n    @ResponseBody\n    public ResponseEntity<?> closePromptForToday() {\n        try {\n            pmcPortalClient.closePromptForToday();\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\"), HttpStatus.OK);\n        } catch (Exception e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n}\n",
