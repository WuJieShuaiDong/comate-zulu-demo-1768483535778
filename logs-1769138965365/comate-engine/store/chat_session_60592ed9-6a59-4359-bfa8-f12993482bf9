QO();\n1613->        qo.setSupplierCode(pmcDataP2pSupplier.getSupplierCode());\n1614->        qo.setFlag(\"0\");\n1615->        dto.setCurrentAvailableQuota(calculateAvailableQuota(qo));\n1616->        return dto;\n1617->    }\n1618->\n1619->    private Map<String, Object> calculateCurrentMonthAvailableAmount(String supplierCode) {\n1620->        // 取供应商当月审批完成，并且计划付款日期大于当前日期5天\n1621->        // 单据状态=已审批&头寸审批通过的付款金额\n1622->        List<String> statusList = Arrays.asList(PayStatus.APPROVED.name(), PayStatus.RELEASED.name());\n1623->        Date currentDatePlus7Days = DateUtils.addDays(new Date(), 5);\n1624->        Map<String, Object> result = pmcPayChecksMapper.sumAmountBySupplierAndMonth(\n1625->                supplierCode,\n1626->                statusList,\n1627->                currentDatePlus7Days\n1628->        );\n1629->        return result;\n1630->    }\n1631->\n1632->    private Map<String, Object> calculateCurrentMonthFinancedAmount(String supplierCode) {\n1633->        // 取供应商融资申请日期在当月且融资申请状态不等于已保存，已拒绝，已驳回的融资申请金额\n1634->        List<String> excludeStatuses = Arrays.asList(\n1635->                SupplierFinancingApplyStatus.SAVED.name(),\n1636->                SupplierFinancingApplyStatus.REJECTED.name(),\n1637->                SupplierFinancingApplyStatus.REJECT.name()\n1638->        );\n1639->        Map<String, Object> result = pmcFinanceSupplierApplyMapper.sumAmountBySupplierAndMonth(\n1640->                supplierCode,\n1641->                excludeStatuses\n1642->        );\n1643->        return result;\n1644->    }\n1645->\n1646->    private Map<String, Object> calculateYearlyAvailableAmount(String supplierCode) {\n1647->        // 取供应商当年审批完成，并且计划付款日期大于当前日期5天\n1648->        // 单据状态=已审批&头寸审批通过的付款金额\n1649->        List<String> statusList = Arrays.asList(PayStatus.APPROVED.name(), PayStatus.RELEASED.name());\n1650->        Date currentDatePlus7Days = DateUtils.addDays(new Date(), 5);\n1651->        Map<String, Object> result = pmcPayChecksMapper.sum