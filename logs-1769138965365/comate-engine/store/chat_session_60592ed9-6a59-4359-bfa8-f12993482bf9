   pmcFinanceSupplierApplyMapper.selectByApplyNumber(request.getApplyNumber());\n1549->                if (\"1\".equals(request.getProcessFlag())) {\n1550->                    // 插入历史\n1551->                    PmcFinanceSupplierApplyHis applyHis = new PmcFinanceSupplierApplyHis();\n1552->                    BeanUtils.copyProperties(apply, applyHis);\n1553->                    applyHis.setCreateDate(new Date());\n1554->                    applyHis.setLastUpdateDate(new Date());\n1555->                    applyHis.setCreateBy(\"admin\");\n1556->                    applyHis.setLastUpdateBy(\"admin\");\n1557->                    applyHis.setOperationUser(\"admin\");\n1558->                    applyHis.setOperationNode(SupplierFinancingApplyStatus.getOperationNode(apply.getStatus()));\n1559->                    pmcFinanceSupplierApplyHisMapper.insert(applyHis);\n1560->                } else {\n1561->                    // 供应商提交更新对应的操作历史记录状态为已提交\n1562->                    // 查询最新的一条操作历史记录\n1563->                    List<PmcFinanceSupplierApplyHis> applyHisList = pmcFinanceSupplierApplyHisMapper\n1564->                            .selectByApplyNumber(request.getApplyNumber());\n1565->                    PmcFinanceSupplierApplyHis applyHis = applyHisList.get(0);\n1566->                    if (SupplierFinancingApplyStatus.SEND_BANK.name().equals(applyHis.getStatus())) {\n1567->                        applyHis.setStatus(SupplierFinancingApplyStatus.SUBMITTED.name());\n1568->                        applyHis.setOperationNode(SupplierFinancingApplyStatus.getOperationNode(applyHis.getStatus()));\n1569->                        applyHis.setLastUpdateDate(new Date());\n1570->                        pmcFinanceSupplierApplyHisMapper.updateByPrimaryKey(applyHis);\n1571->                    }\n1572->                }\n1573->                sendBankSuccessRuLiuMessage(apply);\n1574->                return updated > 0;\n1575->            } else {\n1576->                log.info(\"融资申请-银行