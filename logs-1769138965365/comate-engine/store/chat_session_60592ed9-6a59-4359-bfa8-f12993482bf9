      "content": "package com.baidu.pmc.bankcommon.core.service;\n\nimport com.baidu.pmc.pojo.dto.PayChecksDTO;\nimport com.baidu.pmc.pojo.dto.cmb.BalanceInfo;\nimport com.baidu.pmc.pojo.dto.cmb.PayInstructDTO;\nimport com.baidu.pmc.pojo.dto.cmb.TmsAccountBalanceCmb;\nimport com.baidu.pmc.pojo.dto.cmb.TransInfo;\nimport com.baidu.pmc.pojo.model.PmcPayChecks;\nimport com.baidu.pmc.pojo.model.cmb.PayQO;\nimport com.baidu.pmc.pojo.qo.BankcommonBalanceOldQO;\nimport com.baidu.pmc.pojo.qo.cmb.PayInstructQO;\nimport com.github.pagehelper.Page;\n\nimport java.util.List;\nimport java.util.Map;\n\npublic interface BankStrategy {\n\n    /**\n     * 获取当前策略的CODE，对应BankStrategyEnum中的 bankStrategy 字段\n     */\n    String getBankStrategy();\n\n    /**\n     * 获取指令列表\n     */\n    Page<PayInstructDTO> getPayInstructList(PayInstructQO qo);\n\n    /**\n     * 生成转账付出指令\n     *\n     * @return\n     */\n    Integer genBankUnUrgentPay(String bankCode);\n\n    /**\n     * 获取转账记录\n     */\n    List<TransInfo> selectBankTrans(PayQO qo);\n\n    /**\n     * 查询银行余额（带分页）\n     */\n    List<BalanceInfo> selectBankBalance(PayQO qo);\n\n    /**\n     * 查询银行余额进行校验\n     */\n    List<BalanceInfo> queryBalanceForCheck(List<PayQO> qos);\n\n    /**\n     * 查询嫌疑交易列表\n     */\n    Page<PayInstructDTO> bankSuspectList(PayInstructQO qo);\n\n    /**\n     * 析疑\n     */\n    String bankAnalysisSuspect(PayInstructQO payInstructQO);\n\n    /**\n     * 更新交易指令\n     */\n    String updateInstruct(PayInstructQO payInstructQO);\n\n    /**\n     * 更新指令失败批次\n     */\n    void updateInstructFailedBatch(String bankCode, List<Long> payIds);\n\n    /**\n     * 银行付款\n     */\n    int bankDirectBankPay(String bankCode);\n\n    /**\n     * 支付结果查询\n     */\n    List<Map<String, Object>> queryPayResult(List<Map<String, Object>> instructs, String bankCode);\n\n    /**\n     * 电子回单查询\n     *\n     * @param payQO\n     * @return\n     */\n    String selectElectReceipt(PayQO payQO);\n\n    /**\n     * 退票查询\n     *\n     * @param payQO\n     * @return\n     */\n    String selectBankcommonRefund(PayQO payQO);\n\n    /**\n     * 查询银行历史余额\n     *\n     * @param bankcommonBalanceOldQO 查询条件对象\n     * @return 银行余额列表\n     * @throws Exception 加密密码时可能抛出的异常\n     */\n    List<TmsAccountBalanceCmb> selectBankBalanceOld(BankcommonBalanceOldQO bankcommonBalanceOldQO);\n\n    /**\n     * 按照支付单生成支付指令\n     *\n     * @param bankCode\n     * @param checks\n     * @return\n     */\n    List<Map<String, Object>> generateBankPayInstructs(String bankCode, List<PayChecksDTO> checks);\n\n\n    /**\n     * 支付结果查询任务--调用queryPayResult进行查询\n     *\n     * @return\n     */\n    String bankQueryPayResultJob(String bankCode);\n\n\n    /**\n     * 定时任务-生成未紧急支付的指令\n     */\n    Integer getBankUnUrgentPayTask();\n\n    /**\n     * 定时任务-对公付款后台任务\n     */\n    Integer bankUnUrgentPayTask();\n\n\n    /**\n     * 定时任务 - 支付结果查询\n     */\n    Integer bankQueryPayResultTask();\n\n    /**\n     * 定时任务 - 电子回单查询\n     */\n    Integer selectBankElectReceiptTask();\n\n    /**\n     * 校验指令-收款方\n     */\n    String verityReceive(PayChecksDTO payChecksDTO, PmcPayChecks payCheck, String bankCode);\n\n    /**\n     * 校验指令-付款方\n     */\n    String verityPay(List<String> bankCodes, PayChecksDTO payChecksDTO, PmcPayChecks payCheck, String bankCode);\n\n    /**\n     * 请求HTTP ，不同银行HTTP请求方式报文各不同，个性化扩展\n     */\n    String postBankHttp(String request, String uri, Map<String, Object> dto, String bankCode);\n\n    /**\n     * 请求前置机，不同银行前置机请求方式报文各不同，个性化扩展\n     */\n    String postMACHINE(String request, String hashValue, Long tenantId, String[] ipArr, String bankCode);\n    /**\n     * 指令字段转换\n     *\n     * @param payInstructs\n     */\n    default void translateInstruct(PayInstructDTO payInstructs) {\n        payInstructs.setCurrencyName(payInstructs.getAmountCurrencyName());\n        payInstructs.setPayeeBankName(payInstructs.getPayeeBank());\n        payInstructs.setPayeeProvName(payInstructs.getPayeeProv());\n        payInstructs.setPayeeCityName(payInstructs.getPayeeCity());\n        payInstructs.setFunCodeName(payInstructs.getFunNameName());\n        payInstructs.setBusinessResultCode(payInstructs.getProcessCode());\n    }\n}\n",
