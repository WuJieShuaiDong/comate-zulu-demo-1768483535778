 -> v2));\n        for (Map<String, Object> instruct : instructs) {\n            if (Constants.ENABLED_N.equals(instruct.getOrDefault(\"interBankFlag\", Constants.ENABLED_Y))) {\n                instruct.put(\"payeeBanchNumber\", \"\");\n            }\n            String trnUid = StringUtils.toString(instruct.get(\"trnUid\"));\n            String elecChequeNo = trnUid;\n            try {\n                elecChequeNo = StringCompressor.compress(trnUid, 16);\n            } catch (Exception e) {\n                log.error(\"trnUid转电子凭证号失败\", e);\n            }\n            instruct.put(\"elecChequeNo\", elecChequeNo);\n            String interBankFlag = StringUtils.toString(instruct.get(\"interBankFlag\"));\n            String sysFlag = interBankFlag.equals(Constants.ENABLED_Y) ? \"1\" : \"0\";\n            // 本行/他行标志(0：表示本行 1：表示他行)\n            instruct.put(\"sysFlag\", sysFlag);\n            if (interBankFlag.equals(Constants.ENABLED_Y)) {\n                // 收款行速选标志 跨行输入\n                instruct.put(\"payeeBankSelectFlag\", \"1\");\n                // 同城异地标志（0：同城1：异地 当SysFlag=1即跨行转帐时必输，0代表同城票交汇路、1代表人行现代支付汇路）银行建议都输入1\n                instruct.put(\"remitLocation\", \"1\");\n            }\n            PayChecksDTO payCheck = payCheckMap.get(StringUtils.toString(instruct.get(\"payCheckNum\")));\n            if (payCheck != null) {\n                // 收款行地址(取省+市)\n                instruct.put(\"payeeAddress\", payCheck.getAttribute5Name() + payCheck.getAttribute6Name());\n                // 收款行名称\n                instruct.put(\"payeeBankName\", payCheck.getAttribute3Name() + payCheck.getAttribute4());\n                // 汇款用途(对公不输入，对私B)\n                if (\"PERSONAL\".equals(payCheck.getBeneficiaryTypeFlag())) {\n                    instruct.put(\"remitPurpose\", \"B\");\n                }\n            }\n        }\n        return instructs;\n    }\n\n    @Override\n    public String bankQueryPayResultJob(String bankCode) {\n        Map<String, String> extentionParams = new HashMap<>();\n        Date beginDate = DateUtils.addDays(new Date(), -25);\n        extentionParams.put(\"beginDate\", DateUtils.formatDate(beginDate, \"yyyyMMdd\"));\n        return bankcommonService.bankcommonQueryPayResultJob(bankCode, extentionParams);\n    }\n\n    @Override\n    public Integer getBankUnUrgentPayTask() {\n        return 0;\n    }\n\n    @Override\n    public Integer bankUnUrgentPayTask() {\n        return 0;\n    }\n\n    @Override\n    public Integer bankQueryPayResultTask() {\n        return 0;\n    }\n\n    @Override\n    public Integer selectBankElectReceiptTask() {\n        return 0;\n    }\n\n    @Override\n    public String verityReceive(PayChecksDTO payChecksDTO, PmcPayChecks payCheck, String bankCode) {\n        // 收款方信息校验\n        StringBuilder failedStringBuilder = new StringBuilder();\n        if (StringUtils.isBlank(payChecksDTO.getAttributeCategory())) {\n            failedStringBuilder.append(\"收款人信息弹性域字段为空！\");\n        } else if (!Constants.WIRE_CN.equals(payChecksDTO.getAttributeCategory())\n                && !Constants.PAYCARD_CN.equals(payChecksDTO.getAttributeCategory())) {\n            failedStringBuilder.append(\"收款人信息弹性域非工资卡中国或电汇中国! \");\n        }\n        if (StringUtils.isBlank(payChecksDTO.getAttribute1())) {\n            failedStringBuilder.append(\"收款人名称为空! \");\n        } else if (StringUtils.length(payChecksDTO.getAttribute1()) > 60) {\n            failedStringBuilder.append(\"收款人名称长度大于60! \");\n        }\n        if (StringUtils.isBlank(payChecksDTO.getAttribute2())) {\n            failedStringBuilder.append(\"收款方帐号为空！\");\n        } else if (payChecksDTO.getAttribute2().length() > 32) {\n            failedStringBuilder.append(\"收款方帐号长度大于32！\");\n        } else if (payChecksDTO.getAttribute2().contains(\"/\") || payChecksDTO.getAttribute2().contains(\"\\\\\")) {\n            failedStringBuilder.append(\"收款账号字段格式错误！ \");\n        }\n        if (StringUtils.isBlank(payChecksDTO.getAttribute3())) {\n            failedStringBuilder.append(\"收款账号开户行为空！ \");\n        }\n        // 收款方值集翻译失败\n        if (StringUtils.isBlank(payChecksDTO.getAttribute3Name())) {\n            failedStringBuilder.append(\"银行code:\").append(payChecksDTO.getAttribute3()).append(\"值集翻译失败\");\n        }\n\n        if (StringUtils.isBlank(payChecksDTO.getAttribute4())) {\n            failedStringBuilder.append(\"收款账号开户行支行为空！ \");\n        } else {\n            String bankBranch = payChecksDTO.getAttribute3Name() + payChecksDTO.getAttribute4();\n            if (bankBranch.length() > 100) {\n                failedStringBuilder.append(\"收款人开户行+开户支行名称长度大于100！\");\n            }\n        }\n        // 跨行对联行号进行校验，同行不校验\n        if (!StringUtils.equals(payChecksDTO.getAttribute3(), payChecksDTO.getBankCode())) {\n            // 鉴于银行名称不准确，因此采用收款行联行号非空形式，长度小于等于12\n            if (StringUtils.isBlank(payChecksDTO.getAttribute7())) {\n                failedStringBuilder.append(\"收款行联行号为空！\");\n            } else if (StringUtils.length(payChecksDTO.getAttribute7()) != 5\n                    && StringUtils.length(payChecksDTO.getAttribute7()) != 12) {\n                failedStringBuilder.append(\"收款行联行号长度为5位或12位！\");\n            }\n        }\n        if (StringUtils.isNotBlank(payChecksDTO.getRemark())\n                && StringUtils.length(payChecksDTO.getRemark()) > 60) {\n            failedStringBuilder.append(\"用途字段长度大于60！\");\n        } else if (StringUtils.isNotBlank(payChecksDTO.getRemark())\n                && payChecksDTO.getRemark().contains(\"|\")) {\n            failedStringBuilder.append(\"用途字段格式错误！\");\n        }\n\n        payCheck.setFailureReasons(failedStringBuilder.toString());\n        return payCheck.getFailureReasons();\n    }\n\n    @Override\n    public String verityPay(List<String> bankCodes, PayChecksDTO payChecksDTO, PmcPayChecks payCheck, String bankCode) {\n\n        StringBuilder verityFailedStringBuilder = new StringBuilder();\n        // 付款方信息校验\n        if (!Constants.TYPE_HOME.equals(payChecksDTO.getAccountType())) {\n            verityFailedStringBuilder.append(\"付款账户非国内账户！\");\n        }\n        if (!bankCodes.contains(payChecksDTO.getBankCode())) {\n            verityFailedStringBuilder.append(\"付款银行没有开通银企直连！\");\n        }\n        if (StringUtils.isBlank(payChecksDTO.getReferenceNumber())) {\n            verityFailedStringBuilder.append(\"业务参考号为空！\");\n        } else if (payChecksDTO.getReferenceNumber().length() > 20) {\n            payChecksDTO.setReferenceNumber(payChecksDTO.getReferenceNumber().substring(0, 19));\n        }\n        if (StringUtils.isBlank(payChecksDTO.getAccount())) {\n            verityFailedStringBuilder.append(\"付款账户为空！\");\n        } else if (payChecksDTO.getAccount().length() > 32) {\n            verityFailedStringBuilder.append(\"付款账户长度大于32！\");\n        }\n        if (StringUtils.isBlank(payChecksDTO.getAccountName())) {\n            verityFailedStringBuilder.append(\"付款人名称为空! \");\n        } else if (StringUtils.length(payChecksDTO.getAccountName()) > 60) {\n            verityFailedStringBuilder.append(\"付款人名称长度大于60! \");\n        }\n        if (!StringUtils.equals(payChecksDTO.getCurrency(), payChecksDTO.getAmountCurrency())) {\n            verityFailedStringBuilder.append(\"付款币种和账户币种不一致！\");\n        }\n        if (!Constants.CNY.equals(payChecksDTO.getAmountCurrency())) {\n            verityFailedStringBuilder.append(\"币种不是人民币！\");\n        }\n        if (payChecksDTO.getAmount() == null || payChecksDTO.getAmount().compareTo(BigDecimal.ZERO) <= 0) {\n            verityFailedStringBuilder.append(\"金额小于等于0！\");\n        }\n        if (!Constants.ENABLED_Y.equals(payChecksDTO.getDirectFlag())) {\n            verityFailedStringBuilder.append(\"没有启用银企支付！\");\n        }\n\n        payCheck.setFailureReasons(verityFailedStringBuilder.toString());\n        return payCheck.getFailureReasons();\n    }\n\n    @Override\n    public String postBankHttp(String request, String uri, Map<String, Object> dto, String bankCode) {\n        return \"\";\n    }\n\n    @Override\n    public String postMACHINE(String request, String hashValue, Long tenantId, String[] ipArr, String bankCode) {\n        request = spdbSign(request);\n        String requestLength = StringUtils.leftPad(String.valueOf(request.length() + 6), 6, '0');\n        request = requestLength + request;\n        PmcCmbMachineDTO cmbMachineDTO = new PmcCmbMachineDTO();\n        cmbMachineDTO.setTenantId(tenantId);\n        cmbMachineDTO.setStatus(Constants.UP);\n        cmbMachineDTO.setMachineBank(bankCode);\n        List<PmcCmbMachine> pmcCmbMachines = machineService.selectMachine(cmbMachineDTO);\n        if (CollectionUtils.isEmpty(pmcCmbMachines)) {\n            log.error(\"无可用前置机 postMACHINE\");\n            // 无可用前置机\n            mailService.sendMachineFailedMail(\"无可用前置机\", new ArrayList<>(), \"\");\n            return Constants.NO_ENABLED_MACHINE;\n        }\n        pmcCmbMachines.forEach(detail -> log.info(\"可用前置机：\" + detail.getName() + \" \" + detail.getIp()));\n        log.info(\"租户：\" + tenantId);\n        // 一致性哈希算法 获取分配机器\n        Map<String, PmcCmbMachine> map = pmcCmbMachines.stream()\n                .collect(Collectors.toMap(PmcCmbMachine::getIp, Function.identity(), (k1, k2) -> k1));\n        String[] currentServers = map.keySet().toArray(new String[0]);\n        String server = new NodeDistributeUtil().getServer(hashValue, currentServers);\n        log.info(\"request server : \" + server);\n        PmcCmbMachine machine = map.get(server);\n        log.info(\"请求前置机ip地址: {}\", machine.getIp());\n        String[] ipPort;\n        if (server.split(\"//\").length != 2\n                || (ipPort = server.split(\"//\")[1].split(\":\")).length != 2) {\n            log.error(\"ip = {}, 格式不正确\", server);\n            return Constants.NO_ENABLED_MACHINE;\n        }\n        if (null != ipArr) {\n            ipArr[0] = ipPort[0];\n        }\n        try {\n            // 请求报文\n            log.info(\"请求报文 request={}\", request);\n            Example example = new Example(PmcPayCommonBankSet.class);\n            example.createCriteria().\n                    andEqualTo(\"bankCode\", bankCode)\n                    .andEqualTo(\"transferFlag\", Constants.ENABLED_Y);\n            List<PmcPayCommonBankSet> pmcPayCommonBankSets = pmcPayCommonBankSetMapper.selectByExample(example);\n            String requestType = Constants.RequestTypeEnum.XML;\n            if (CollectionUtils.isNotEmpty(pmcPayCommonBankSets)) {\n                requestType = pmcPayCommonBankSets.get(0).getRequestType();\n            }\n            String response = null;\n            if (Constants.RequestTypeEnum.XML.equals(requestType)) {\n                response = OkHttpUtils.sendHttpRequest(machine.getIp(), request);\n            } else {\n                response = OkHttpUtils.sendHttpRequestJson(machine.getIp(), request);\n            }\n            log.info(\"response :\" + response);\n            return spdbVerifySign(response);\n        } catch (Exception e) {\n            log.error(\"网络出错，请检查网络！\", e);\n        }\n        return Constants.BANK_POST_EXCEPTION;\n    }\n\n\n    /**\n     * 请求前置机-文件下载\n     * @param request\n     * @return\n     */\n    public String postMACHINEFile(String request) {\n        request = spdbSign(request);\n        String requestLength = StringUtils.leftPad(String.valueOf(request.length() + 6), 6, '0') ;\n        request = requestLength + request;\n        log.info(\"请求前置机ip地址: {}\", fileUrl);\n        try {\n            // 请求报文\n            log.info(\"请求报文 request={}\", request);\n            String response = OkHttpUtils.sendHttpRequestStream(fileUrl, request);\n            log.info(\"response :\" + response);\n            // 文件流特殊处理\n            String lengthString = response.substring(0, 6).trim();\n            Integer responseLength = Integer.valueOf(lengthString);\n            String responseInfo = response.substring(0, responseLength);\n            String fileStream = response.substring(responseLength);\n            String verifySignResponse = spdbVerifySign(responseInfo);\n            StringReader reader = new StringReader(verifySignResponse);\n            InputSource source = new InputSource(reader);\n            SafeXml safeXml = new SafeXml(SafeXml.Level.NONE);\n            SAXBuilder sax = safeXml.getSAXBuilder();\n            Document doc = sax.build(source);\n            Element rootElement = doc.getRootElement();\n            Element body = rootElement.getChild(\"body\");\n            // 将文件字节流流转成base64编码，存入body报文\n            byte[] pdfBytes = fileStream.getBytes(StandardCharsets.ISO_8859_1);\n            String base64String = Base64.getEncoder().encodeToString(pdfBytes);\n            Element fileContent = new Element(\"fileContent\");\n            fileContent.setText(base64String);\n            body.addContent(fileContent);\n            return generateXML(doc);\n        } catch (Exception e) {\n            log.error(\"网络出错，请检查网络！\", e);\n        }\n        return Constants.BANK_POST_EXCEPTION;\n    }\n\n    private String spdbSign(String request) {\n        log.info(\"spdbSign request before sign:\" + request);\n        try {\n            StringReader reader = new StringReader(request);\n            InputSource source = new InputSource(reader);\n            SafeXml safeXml = new SafeXml(SafeXml.Level.NONE);\n            SAXBuilder sax = safeXml.getSAXBuilder();\n            Document doc = sax.build(source);\n            Element rootElement = doc.getRootElement();\n            Element body = rootElement.getChild(\"body\");\n            Format format = Format.getPrettyFormat();\n            format.setExpandEmptyElements(true);\n            XMLOutputter outputter = new XMLOutputter(format);\n\n            String bodyString = outputter.outputString(body);\n            log.info(\"bodyString: \" + bodyString);\n            String signResult = OkHttpUtils.sendHttpRequestContentType(signUrl, bodyString, SpdbConstants.ContentType.SIGN);\n\n            Element signElement = parseRequestSign(signResult);\n            // 替换body元素\n            int index = rootElement.indexOf(body);\n            rootElement.removeContent(body);\n            rootElement.addContent(index, signElement.clone());\n            String signRequest = generateXML(doc);\n            log.info(\"spdbSign request after sign:\" + signRequest);\n            return signRequest;\n        }catch (Exception e) {\n            log.error(\"spdbSign request error\", e);\n            return \"\";\n        }\n    }\n\n    /**\n     * 拼装签名结果\n     * @param signResult\n     * @return\n     */\n    private Element parseRequestSign(String signResult) {\n        log.info(\"解析浦发请求签名开始: {}\", signResult);\n        try {\n            StringReader reader = new StringReader(signResult);\n            InputSource source = new InputSource(reader);\n            SafeXml safeXml = new SafeXml(SafeXml.Level.NONE);\n            SAXBuilder sax = safeXml.getSAXBuilder();\n            Document doc = sax.build(source);\n            Element rootElement = doc.getRootElement();\n            String result = rootElement.getChild(\"head\").getChildTextTrim(\"result\");\n            if (\"0\".equals(result)) {\n                Element body = rootElement.getChild(\"body\");\n                body.getChild(\"sign\").setName(\"signature\");\n                return body;\n            } else {\n                return null;\n            }\n        }catch (Exception e) {\n            log.error(\"解析请求签名结果异常\", e);\n            return null;\n        }\n    }\n\n    private String spdbVerifySign(String response) {\n        log.info(\"spdbVerifySign response before sign:\" + response);\n        try {\n            StringReader reader = new StringReader(response.substring(6));\n            InputSource source = new InputSource(reader);\n            SafeXml safeXml = new SafeXml(SafeXml.Level.NONE);\n            SAXBuilder sax = safeXml.getSAXBuilder();\n            Document doc = sax.build(source);\n            Element rootElement = doc.getRootElement();\n            Element body = rootElement.getChild(\"body\");\n            String signature = body.getChildText(\"signature\");\n            // 失败情况无需校验签名，直接返回\n            if (StringUtils.isBlank(signature)){\n                return response.substring(6);\n            }\n            String signResult = OkHttpUtils.sendHttpRequestContentType(signUrl, signature, SpdbConstants.ContentType.VERIFY_SIGN);\n            Element signElement = parseResponseSign(signResult);\n            // 替换body元素\n            int index = rootElement.indexOf(body);\n            rootElement.removeContent(body);\n            rootElement.addContent(index, signElement.clone());\n            String signResponse = generateXML(doc);\n            log.info(\"spdbVerifySign response after sign:\" + signResponse);\n            return signResponse;\n        }catch (Exception e) {\n            log.error(\"spdbVerifySign request error\", e);\n            return \"\";\n        }\n    }\n\n    /**\n     * 解析响应签名\n     * @param signResult\n     * @return\n     */\n    private Element parseResponseSign(String signResult) {\n        log.info(\"解析浦发响应签名开始: {}\", signResult);\n        try {\n            StringReader reader = new StringReader(signResult);\n            InputSource source = new InputSource(reader);\n            SafeXml safeXml = new SafeXml(SafeXml.Level.NONE);\n            SAXBuilder sax = safeXml.getSAXBuilder();\n            Document doc = sax.build(source);\n            Element rootElement = doc.getRootElement();\n            String result = rootElement.getChild(\"head\").getChildTextTrim(\"result\");\n            if (\"0\".equals(result)) {\n                Element body = rootElement.getChild(\"body\").getChild(\"sic\").getChild(\"body\");\n                return body;\n            } else {\n                return null;\n            }\n        }catch (Exception e) {\n            log.error(\"解析响应签名结果异常\", e);\n            return null;\n        }\n    }\n    /**\n     * 获取xml报文字符串\n     *\n     * @param document dom\n     * @return xml\n     */\n    private String generateXML(Document document) {\n        XMLOutputter xmlOutputter = new XMLOutputter();\n        Format format = Format.getPrettyFormat();\n        format.setExpandEmptyElements(true);\n        format.setEncoding(Constants.ENCODING_GBK);\n        xmlOutputter.setFormat(format);\n        return xmlOutputter.outputString(document);\n\n    }\n}",
