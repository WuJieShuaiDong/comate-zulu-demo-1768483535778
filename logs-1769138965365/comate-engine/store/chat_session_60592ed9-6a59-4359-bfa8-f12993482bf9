) {\n1442->            log.error(\"组装银行融资申请报文信息缺失，request: {}\", result);\n1443->            log.error(\"组装银行融资申请报文信息缺失，错误消息: {}\", e.getMessage());\n1444->            // 阻断后续发送银行流程\n1445->            // 发送如流消息\n1446->            log.info(\"融资申请-组装参数失败,发送如流消息\");\n1447->            sendBankFailRuliuMessage(result.getApplyNumber());\n1448->            throw new ServiceException(\"管理员重发，缺失部分信息\");\n1449->        }\n1450->        return result;\n1451->    }\n1452->\n1453->\n1454->    @Override\n1455->    public boolean selectFinanceRole() {\n1456->        String supplierCode = PmcPortalLogin.getSupId();\n1457->        Example example = new Example(PmcFinanceSupplierQuotaSet.class);\n1458->        Example.Criteria criteria = example.createCriteria();\n1459->        criteria.andEqualTo(\"supplierCode\", supplierCode);\n1460->        criteria.andEqualTo(\"financeFlag\", \"Y\");\n1461->        List<PmcFinanceSupplierQuotaSet> pmcFinanceSupplierQuotaSet\n1462->                = pmcFinanceSupplierQuotaSetMapper.selectByExample(example);\n1463->        if (CollectionUtils.isNotEmpty(pmcFinanceSupplierQuotaSet)) {\n1464->            return true;\n1465->        }\n1466->        return false;\n1467->    }\n1468->\n1469->    /**\n1470->     * 融资测算校验\n1471->     */\n1472->    private String validateCalculateFinancing(PmcFinanceBankBaseQO query) {\n1473->        return \"ok\";\n1474->    }\n1475->\n1476->    /**\n1477->     * 融资申请提交校验\n1478->     */\n1479->    private String validateSubmitFinancingApply(PmcFinanceBankBaseQO query) {\n1480->        if (StringUtils.isBlank(query.getPayCheckNum())) {\n1481->            return \"付款单号不能为空\";\n1482->        }\n1483->        if (StringUtils.isBlank(query.getApplyNumber())) {\n1484->            return \"融资单号不能为空\";\n1485->        }\n1486->        // 查询申请明细\n1487->        PmcFinanceSupplierApply apply = pmcFinanceSupplierApplyMapper.selectByApplyNumber(query.getApplyNumber());\n1488->        if (apply == null) {\n1489->            return \"