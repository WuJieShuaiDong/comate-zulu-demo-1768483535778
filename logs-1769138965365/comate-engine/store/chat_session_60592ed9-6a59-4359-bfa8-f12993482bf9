     Validate.notBlank(request.getBuyerAccount(), \"还款账户(buyerAccount)不能为空\");\n1903->    }\n1904->\n1905->    /**\n1906->     * 管理员拒绝发送中的融资\n1907->     *\n1908->     * @param query 融资申请信息\n1909->     * @return 操作结果\n1910->     */\n1911->    @Override\n1912->    @Transactional(rollbackFor = Exception.class)\n1913->    public boolean admRejectSendBank(PmcFinanceSupplierApplyDTO query) {\n1914->        try {\n1915->            log.info(\"管理员拒绝发送中的融资，申请单号：{}\", query.getApplyNumber());\n1916->\n1917->            // 校验参数\n1918->            if (StringUtils.isBlank(query.getApplyNumber())) {\n1919->                return false;\n1920->            }\n1921->            // 查询融资申请信息\n1922->            PmcFinanceSupplierApply apply = pmcFinanceSupplierApplyMapper.selectByApplyNumber(query.getApplyNumber());\n1923->            if (apply == null) {\n1924->                return false;\n1925->            }\n1926->\n1927->            // 校验状态：只有发送中的融资才能被拒绝\n1928->            if (!SupplierFinancingApplyStatus.SEND_BANK.name().equals(apply.getStatus())) {\n1929->                return false;\n1930->            }\n1931->            // 更新融资申请状态为\"拒绝\"\n1932->            apply.setStatus(SupplierFinancingApplyStatus.REJECTED.name());\n1933->            apply.setLastUpdateDate(new Date());\n1934->            apply.setLastUpdateBy(\"admin\");\n1935->            pmcFinanceSupplierApplyMapper.updateByPrimaryKey(apply);\n1936->            // 插入历史\n1937->            PmcFinanceSupplierApplyHis applyHis = new PmcFinanceSupplierApplyHis();\n1938->            BeanUtils.copyProperties(apply, applyHis);\n1939->            applyHis.setCreateDate(new Date());\n1940->            applyHis.setLastUpdateDate(new Date());\n1941->            applyHis.setCreateBy(\"admin\");\n1942->            applyHis.setLastUpdateBy(\"admin\");\n1943->            applyHis.setOperationUser(\"admin\");\n1944->            applyHis.setOperationNode(SupplierFinancingApplyStatus.getOperationNode(apply.getStatus()));\n1945->     