      "content": "package com.baidu.pmc.core.controller;\n\n\n\nimport com.baidu.pmc.common.ResponseMessage;\nimport com.baidu.pmc.core.service.AccountService;\nimport com.baidu.pmc.core.service.PmcPortalFinancingPromptService;\nimport com.baidu.pmc.core.service.PmcPortalFinancingService;\n\n\nimport com.baidu.pmc.pojo.dto.PmcAccountDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceCompQuotaSetDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyHisDTO;\nimport com.baidu.pmc.pojo.dto.PmcPayChecksSupplierCodeDTO;\nimport com.baidu.pmc.pojo.dto.FinanceIndicatorDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceApplyNumberDTO;\nimport com.baidu.pmc.pojo.model.PmcDataP2pSupplier;\nimport com.baidu.pmc.pojo.model.PmcFinanceSupplierApply;\nimport com.baidu.pmc.pojo.qo.PmcFinanceBankBaseQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceCompQuotaSetQO;\nimport com.baidu.pmc.pojo.qo.PmcPortalSuggestQO;\nimport com.baidu.pmc.pojo.qo.PayChecksQO;\nimport com.baidu.pmc.pojo.qo.PmcAccountSearchQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceSupplierApplyQO;\nimport com.baidu.pmc.pojo.qo.PmcPortalRemainQuotaQO;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.http.HttpStatus;\nimport org.springframework.http.ResponseEntity;\nimport org.springframework.web.bind.annotation.PostMapping;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.RestController;\n\nimport com.github.pagehelper.PageInfo;\n\nimport lombok.extern.slf4j.Slf4j;\n\nimport java.math.BigDecimal;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\n\n\n/*\n* Created by  liumandong\n* */\n@Slf4j\n@RestController\n@RequestMapping(\"/pmcPortal\")\npublic class PmcPortalController {\n\n    @Autowired\n    private PmcPortalFinancingService pmcPortalFinancingService;\n\n    @Autowired\n    private AccountService accountService;\n\n    @Autowired\n    private PmcPortalFinancingPromptService pmcPortalFinancingPromptService;\n    /**\n     * 供应商查询申请融资申请列表\n     *\n     * @param pmcFinanceSupplierApplyQO\n     *\n     * @return\n     */\n    @PostMapping(\"/selectList\")\n    public ResponseEntity<Object> list(@RequestBody PmcFinanceSupplierApplyQO pmcFinanceSupplierApplyQO) {\n        PageInfo<PmcFinanceSupplierApplyDTO> pageInfo = pmcPortalFinancingService.findByConditionSupplierCode(pmcFinanceSupplierApplyQO);\n        return new ResponseEntity<>(pageInfo, HttpStatus.OK);\n    }\n\n    /**\n     * 供应商查询付款单列表\n     *\n     * @param\n     *\n     * @return\n     */\n\n    @PostMapping(\"/getPayCheckList\")\n    public ResponseEntity<Object> getPayCheckList(@RequestBody PmcFinanceSupplierApplyQO qo) {\n        PageInfo<PmcPayChecksSupplierCodeDTO> payCheckPage = pmcPortalFinancingService.getPayCheckList(qo);\n        return new ResponseEntity<>(payCheckPage, HttpStatus.OK);\n    }\n\n    /**\n     * 保存融资申请单\n     */\n    @PostMapping(\"/saveOrUpdate\")\n    public ResponseEntity<?> submitFinancingApply(@RequestBody PmcFinanceSupplierApplyDTO pmcFinanceSupplierApplyDTO) {\n        PmcFinanceBankBaseQO pmcFinanceBankBaseQO ;\n        try {\n            pmcFinanceBankBaseQO = pmcPortalFinancingService.saveOrUpdateFinancingApply(pmcFinanceSupplierApplyDTO);\n        } catch (Exception e) {\n            log.error(\"保存融资申请单失败\", e);\n            if (\"融资申请单已提交，但缺失部分信息，请耐心等待管理员处理或联系管理员邮箱!\".equals(e.getMessage())) {\n                Map<String, Object> map = new HashMap<>();\n                map.put(\"warnMsg\", e.getMessage());\n                return new ResponseEntity<>(ResponseMessage.fail(map), HttpStatus.OK);\n            }\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", pmcFinanceBankBaseQO), HttpStatus.OK);\n    }\n\n\n    /**\n     * 查询融资申请历史记录\n     */\n    @PostMapping(\"/queryHis\")\n    public ResponseEntity<?> queryFinancingApplyHis(@RequestBody PmcFinanceSupplierApplyQO query) {\n        try {\n            PageInfo<PmcFinanceSupplierApplyHisDTO> result = pmcPortalFinancingService.queryFinancingApplyHis(query);\n\n            return new ResponseEntity<>(result, HttpStatus.OK);\n        } catch (Exception e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 获取融资申请单详情\n     */\n    @PostMapping(\"/getDetail\")\n    public ResponseEntity<?> getFinancingApplyDetail(@RequestBody PmcFinanceSupplierApplyQO query) {\n        Map<String, Object> result = pmcPortalFinancingService.getFinancingApplyDetail(query);\n        return new ResponseEntity<>(result, HttpStatus.OK);\n    }\n\n\n    /**\n     * 获取付款单详情\n     */\n    @PostMapping(\"/getPayCheckDetail\")\n    public ResponseEntity<?> selectPmcPayCheckByPayCheckNum(@RequestBody PayChecksQO payChecksQO) {\n        PmcFinanceSupplierApply apply = new PmcFinanceSupplierApply();\n        PmcPayChecksSupplierCodeDTO result = pmcPortalFinancingService.selectPmcPayCheckByPayCheckNum(payChecksQO, apply);\n        return new ResponseEntity<>(result, HttpStatus.OK);\n    }\n\n    /**\n     * 导出供应商融资申请列表\n     */\n    @PostMapping(\"/export\")\n    public ResponseEntity<List<PmcFinanceSupplierApplyDTO>> export(@RequestBody PmcFinanceSupplierApplyQO query) {\n        List<PmcFinanceSupplierApplyDTO> result = pmcPortalFinancingService.export(query);\n        return new ResponseEntity<>(result, HttpStatus.OK);\n    }\n\n    @PostMapping(\"/selectInit\")\n    public ResponseEntity<Object> selectInit() {\n        Map<String, Object> selectMap = pmcPortalFinancingService.getSelectPortalInit();\n        return new ResponseEntity<>(selectMap, HttpStatus.OK);\n    }\n\n    /**\n     * 根据输入值模糊检索交易类型code和名称\n     * @param parameter\n     * @return\n     */\n    @PostMapping(value = \"/selectSuggest\")\n    public ResponseEntity<Object> selectSuggest(@RequestBody PmcPortalSuggestQO parameter) {\n        List<PmcDataP2pSupplier> codeDescs = pmcPortalFinancingService.selectSuggest(parameter);\n        return new ResponseEntity<>(codeDescs, HttpStatus.OK);\n    }\n\n    /**\n     * 计算供应商可用额度\n     * @return 可用额度\n     */\n    @PostMapping(\"/calculateAvailableQuota\")\n    public ResponseEntity<Object> calculateAvailableQuota(@RequestBody PmcPortalRemainQuotaQO qo) {\n        try {\n            BigDecimal availableQuota = pmcPortalFinancingService.calculateAvailableQuota(qo);\n            return new ResponseEntity<>(availableQuota, HttpStatus.OK);\n        } catch (Exception e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    @PostMapping(\"/selectSuggestAccount\")\n    public ResponseEntity<Object> getAccountViewPage(@RequestBody PmcAccountSearchQO pmcAccountSearchQO) {\n        PageInfo<PmcAccountDTO> pageInfo =\n                accountService.selectAccount(pmcAccountSearchQO);\n        return new ResponseEntity<>(pageInfo, HttpStatus.OK);\n    }\n\n    /**\n     * 生成融资申请单号\n     * @return 融资申请单号，格式：FA+日期时间+4位流水，例如：FA2025102020480001\n     */\n    @PostMapping(\"/generateFinancingNo\")\n    public ResponseEntity<?> generateFinancingApplicationNo() {\n        PmcFinanceApplyNumberDTO applicationNoJson = pmcPortalFinancingService.generateFinancingApplicationNo();\n        return new ResponseEntity<>(applicationNoJson, HttpStatus.OK);\n    }\n\n    /**\n     * 获取kpi指标\n     */\n    @PostMapping(\"/getKpiData\")\n    public ResponseEntity<?> getFinanceIndicators() {\n        FinanceIndicatorDTO queryFinanceIndicators = pmcPortalFinancingService.queryFinanceIndicators();\n        return new ResponseEntity<>(queryFinanceIndicators, HttpStatus.OK);\n    }\n\n    /**\n     * 查询主体额度\n     */\n    @PostMapping(\"/getQuotaSet\")\n    public ResponseEntity<?> selectQuotaSet(@RequestBody PmcFinanceCompQuotaSetQO query) {\n        try {\n            PageInfo<PmcFinanceCompQuotaSetDTO> result = pmcPortalFinancingService.selectQuotaSet(query);\n            return new ResponseEntity<>(result, HttpStatus.OK);\n        } catch (Exception e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n\n    /**\n     * 更新融资申请记录\n     */\n    @PostMapping(\"/updateApply\")\n    public ResponseEntity<?> updateApplyStatusOrBankApplyNumber(@RequestBody PmcFinanceBankBaseQO qo) {\n        try {\n            boolean status =  pmcPortalFinancingService.updateApplyStatusOrSendMeg(qo);\n            if (!status) {\n                return new ResponseEntity<>(ResponseMessage.fail(\"更新失败\"), HttpStatus.OK);\n            }\n        } catch (Exception e) {\n            log.error(\"rollbackApplyStatus  error \", e);\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n        return new ResponseEntity<>(ResponseMessage.success(\"ok\", \"更新成功\"), HttpStatus.OK);\n    }\n\n\n    /**\n     * 查询是否融资权限\n     */\n    @PostMapping(\"/getFinanceRole\")\n    public ResponseEntity<?> getFinanceRole() {\n        boolean status = pmcPortalFinancingService.selectFinanceRole();\n        return new ResponseEntity<>(status, HttpStatus.OK);\n    }\n\n\n    /**\n     * 检查融资首页大图提示状态\n     * @return 是否显示提示\n     */\n    @PostMapping(\"/checkPromptStatus\")\n    public ResponseEntity<?> checkPromptStatus() {\n        try {\n            boolean shouldShow = pmcPortalFinancingPromptService.shouldShowPrompt();\n            return new ResponseEntity<>(shouldShow, HttpStatus.OK);\n        } catch (Exception e) {\n            log.error(\"检查提示状态失败\", e);\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 永久不显示融资首页大图提示\n     * @return 操作结果\n     */\n    @PostMapping(\"/disablePromptPermanently\")\n    public ResponseEntity<?> disablePromptPermanently() {\n        try {\n            pmcPortalFinancingPromptService.disablePromptPermanently();\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\"), HttpStatus.OK);\n        } catch (Exception e) {\n            log.error(\"设置永久不提示失败\", e);\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 当天不显示融资首页大图提示\n     * @return 操作结果\n     */\n    @PostMapping(\"/closePromptForToday\")\n    public ResponseEntity<?> closePromptForToday() {\n        try {\n            pmcPortalFinancingPromptService.closePromptForToday();\n            return new ResponseEntity<>(ResponseMessage.success(\"ok\"), HttpStatus.OK);\n        } catch (Exception e) {\n            log.error(\"设置当天不提示失败\", e);\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n    }\n}\n",
