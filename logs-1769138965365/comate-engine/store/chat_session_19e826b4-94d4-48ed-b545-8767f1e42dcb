                  "content": "/*\n * Copyright (C) 2018 Baidu, Inc. All Rights Reserved.\n */\npackage com.baidu.pmc.core.service;\n\nimport com.baidu.pmc.pojo.constants.PayNode;\nimport com.baidu.pmc.pojo.constants.PayOperation;\nimport com.baidu.pmc.pojo.constants.PayStatus;\nimport com.baidu.pmc.pojo.dto.PayCheckIdDTO;\nimport com.baidu.pmc.pojo.dto.PayCheckIdsDTO;\nimport com.baidu.pmc.pojo.dto.PayCheckSplitDTO;\nimport com.baidu.pmc.pojo.dto.PayChecksDTO;\nimport com.baidu.pmc.pojo.dto.PayChecksInfoModifyDTO;\nimport com.baidu.pmc.pojo.dto.PayChecksModifyDTO;\nimport com.baidu.pmc.pojo.dto.PayChecksUrgencyFlagDTO;\nimport com.baidu.pmc.pojo.dto.TmsFeedbackDTO;\nimport com.baidu.pmc.pojo.dto.third.PaycheckRequestDTO;\nimport com.baidu.pmc.pojo.model.PmcPayChecks;\nimport com.baidu.pmc.pojo.qo.PayBatchUpdateStatus;\nimport com.baidu.pmc.pojo.qo.PayChecksQO;\nimport com.github.pagehelper.PageInfo;\n\nimport java.util.List;\n\n/**\n * 付款服务\n */\npublic interface PayChecksService extends BaseService<PmcPayChecks> {\n\n    /**\n     * 查询付款和收款人\n     *\n     * @param payChecksQO 查询条件\n     * @return\n     */\n    List<PayChecksDTO> selectAllPayChecks(PayChecksQO payChecksQO);\n\n    /**\n     * 查询付款和收款人(不含翻译)\n     *\n     * @param payChecksQO 查询条件\n     * @return\n     */\n    List<PayChecksDTO> selectAllPayChecksSimple(PayChecksQO payChecksQO);\n\n    /**\n     * 分页查询付款和收款人\n     *\n     * @param payChecksQO 查询条件\n     * @return\n     */\n    PageInfo<PayChecksDTO> selectPayChecks(PayChecksQO payChecksQO);\n\n    /**\n     * 根据用户权限查询付款和收款人\n     *\n     * @param payChecksQO 查询条件\n     * @return\n     */\n    PageInfo<PayChecksDTO> selectPayChecksWithPermission(PayChecksQO payChecksQO);\n\n    /**\n     * 同 selectPayChecksWithPermission 不分页 用于导出\n     *\n     * @param payChecksQO 查询条件\n     * @return\n     */\n    List<PayChecksDTO> selectPayChecksWithPermissionExport(PayChecksQO payChecksQO);\n\n    /**\n     * 模糊查询所有付款编号\n     *\n     * @param number 付款编号\n     * @return\n     */\n    List<String> selectPayCheckNumLike(String number);\n\n    /**\n     * 根据付款ID查询付款(会按照当前租户获取)\n     *\n     * @param ckId 付款ID\n     * @return\n     */\n    PayChecksDTO selectByCheckId(Long ckId);\n\n    /**\n     * 查询付款（含付款操作和收款人信息变更历史纪录）\n     *\n     * @param ckId 付款ID\n     * @return\n     */\n    PayChecksDTO selectByCheckIdWithHistory(Long ckId);\n\n    /**\n     * 前端业务系统（FSSC、对公结算平台）联查付款单据详情\n     *\n     * @param paycheckRequestDTO\n     * @return\n     */\n    PayChecksDTO getStatusDetail(PaycheckRequestDTO paycheckRequestDTO) throws Exception;\n\n    /**\n     * TMS查询单据状态和付款日期\n     *\n     * @param paycheckRequestDTO\n     * @return\n     */\n    TmsFeedbackDTO getStatusByByCondition(PaycheckRequestDTO paycheckRequestDTO) throws Exception;\n\n    /**\n     * 查询付款（含收款人信息变更历史纪录）\n     *\n     * @param ckId 付款ID\n     * @return\n     */\n    PayChecksDTO selectByCheckIdWithPayInfoHistory(Long ckId);\n\n    /**\n     * 查询付款(按当前租户获取)\n     *\n     * @param payCheckIds 付款ID 集合\n     * @return\n     */\n    List<PmcPayChecks> selectByCheckIds(List<Long> payCheckIds);\n\n    /**\n     * 根据付款ID和租户ID获取付款单（如果租户ID为null，则获取当前用户的租户ID，如果当前用户租户ID为null，则抛出异常）\n     *\n     * @param checkId\n     * @param tenantId\n     * @return\n     */\n    PmcPayChecks selectOneByCheckIdAndTenantId(Long checkId, Long tenantId);\n\n    /**\n     * 付款受理节点更新付款和收款人信息\n     *\n     * @param modifyDTO 付款和收款人编辑DTO\n     * @return\n     */\n    int updateReview(PayChecksInfoModifyDTO modifyDTO);\n\n    /**\n     * 更新付款（对比是否有更新内容）\n     *\n     * @param modifyDTO 付款和收款人编辑DTO\n     * @return\n     */\n    boolean updatePayInfoIfUpdated(PayChecksInfoModifyDTO modifyDTO);\n\n    /**\n     * 更新收款人信息（对比是否有更新内容）\n     *\n     * @param modifyDTO 付款和收款人编辑DTO\n     * @return\n     */\n    boolean updatePayChecksIfUpdated(PayChecksInfoModifyDTO modifyDTO);\n\n    /**\n     * 更新收款人信息（对比是否有更新内容）\n     *\n     * @param modifyDTO 付款和收款人编辑DTO\n     * @param payChecks 当前付款单\n     * @return\