                }\n            };\n\n            Thread t = new Thread(group, wrappedRunnable,\n                    prefix + threadNumber.getAndIncrement(), 0);\n            t.setDaemon(daemon.get());\n            if (t.getPriority() != Thread.NORM_PRIORITY) {\n                t.setPriority(Thread.NORM_PRIORITY);\n            }\n            return t;\n        }\n    }\n\n    /**\n     * 带日志的拒绝策略\n     */\n    private static class LoggingCallerRunsPolicy extends CallerRunsPolicy {\n        @Override\n        public void rejectedExecution(Runnable r, ThreadPoolExecutor e) {\n            logger.warn(\"Task rejected. Thread pool is saturated. \" +\n                            \"Active threads: {}, Queue size: {}, Pool size: {}\",\n                    e.getActiveCount(), e.getQueue().size(), e.getPoolSize());\n\n            // 调用者运行策略，减缓提交速度\n            super.rejectedExecution(r, e);\n        }\n    }\n\n    // 防止实例化\n    private NewThreadPoolExecutorUtil() {\n        throw new AssertionError(\"Cannot instantiate ThreadPoolExecutorUtil\");\n    }\n}\n多个业务场景下使用线程池，有无bug,如果有风险给出解决方法",
