ue<>(DEFAULT_QUEUE_SIZE);\n\n        // 使用自定义线程工厂，便于线程命名和追踪\n        ThreadFactory threadFactory = new NamedThreadFactory(\"default-pool-\");\n\n        // 使用自定义拒绝策略，增强日志记录\n        RejectedExecutionHandler rejectedHandler = new LoggingCallerRunsPolicy();\n\n        // 核心线程数与最大线程数分离\n        executor = new ThreadPoolExecutor(\n                DEFAULT_CORE_POOL_SIZE,\n                DEFAULT_MAX_POOL_SIZE,\n                KEEP_ALIVE_TIME,\n                KEEP_ALIVE_TIME_UNIT,\n                queue,\n                threadFactory,\n                rejectedHandler\n        );\n\n        // 允许核心线程超时关闭，在负载低时释放资源\n        executor.allowCoreThreadTimeOut(false);\n\n        logger.info(\"Default thread pool initialized. Core size: {}, Max size: {}, Queue capacity: {}\",\n                DEFAULT_CORE_POOL_SIZE, DEFAULT_MAX_POOL_SIZE, DEFAULT_QUEUE_SIZE);\n    }\n\n    /**\n     * 获取默认线程池实例\n     */\n    public static synchronized ExecutorService getExecutorService() {\n        if (isShutdown.get()) {\n            logger.warn(\"Thread pool has been shut down, creating new instance...\");\n            initDefaultExecutor();\n            isShutdown.set(false);\n        }\n        return executor;\n    }\n\n    /**\n     * 创建自定义线程池\n     */\n    public static ThreadPoolExecutor createExecutorService(int corePoolSize, int maxPoolSize, int queueSize) {\n        return createExecutorService(corePoolSize, maxPoolSize, queueSize, \"custom-pool-\");\n    }\n\n    /**\n     * 创建自定义线程池，指定线程名称前缀\n     */\n    public static ThreadPoolExecutor createExecutorService(\n            int corePoolSize, int maxPoolSize, int queueSize, String threadNamePrefix) {\n\n        if (corePoolSize < 0 || maxPoolSize <= 0 || maxPoolSize < corePoolSize || queueSize <= 0) {\n            throw new IllegalArgumentException(\"Invalid thread pool parameters\");\n        }\n\n        BlockingQueue<Runnable> queue = new ArrayBlockingQueue<>(queueSize);\n        ThreadFactory threadFactory = new NamedThreadFactory(threadNamePrefix);\n        RejectedExecutionHandler rejectedHandler = new LoggingCallerRunsPolicy();\n\n        ThreadPoolExecutor executor = new ThreadPoolExecutor(\n                corePoolSize,\n                maxPoolSize,\n                KEEP_ALIVE_TIME,\n                KEEP_ALIVE_TIME_UNIT,\n                queue,\n                threadFactory,\n                rejectedHandler\n        );\n\n        // 注册关闭钩子\n        Runtime.getRuntime().addShutdownHook(new Thread(() -> {\n            logger.info(\"Shutting down custom thread pool: {}\", threadNamePrefix);\n            shutdownAndAwaitTermination(executor, 30, TimeUnit.SECONDS);\n        }));\n\n        logger.info(\"Custom thread pool created. Core size: {}, Max size: {}, Queue capacity: {}\",\n                corePoolSize, maxPoolSize, queueSize);\n\n        return executor;\n    }\n\n    /**\n     * 优雅关闭线程池\n     */\n    public static void shutdownExecutor(ExecutorService executor, long timeout, TimeUnit unit) {\n        if (executor == null || executor.isTerminated()) {\n            return;\n        }\n\n        shutdownAndAwaitTermination(executor, timeout, unit);\n    }\n\n    /**\n     * 优雅关闭线程池并等待终止\n     */\n    private static void shutdownAndAwaitTermination(ExecutorService executor, long timeout, TimeUnit unit) {\n        if (executor == null) {\n            return;\n        }\n\n        try {\n            // 首先尝试优雅关闭\n            executor.shutdown();\n\n            // 等待指定时间让任务完成\n            if (!executor.awaitTermination(timeout, unit)) {\n                // 如果超时，强制关闭\n                logger.warn(\"Thread pool did not terminate in time, forcing shutdown...\");\n                executor.shutdownNow();\n\n                // 等待强制关闭完成\n                if (!executor.awaitTermination(timeout, unit)) {\n                    logger.error(\"Thread pool still did not terminate after forced shutdown\");\n                }\n            }\n        } catch (InterruptedException ie) {\n            // 恢复中