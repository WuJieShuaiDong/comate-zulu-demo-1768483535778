                "originalContent": "package com.baidu.pmc.bankcommon.core.utils;\n\nimport com.baidu.pmc.bankcommon.core.model.BankTransaction;\nimport lombok.extern.slf4j.Slf4j;\n\nimport java.util.List;\n\n/**\n * 银行交易记录解析演示类\n * 展示如何使用BankTransactionParser解析银行流水数据\n *\n * @author baidu.pmc\n * @since 2025-01-09\n */\n@Slf4j\npublic class BankTransactionDemo {\n\n    /**\n     * 演示银行流水数据解析\n     */\n    public static void main(String[] args) {\n        // 模拟银行流水数据（用户提供的实际数据）\n        String bankTransactionData = \"状态|交易日期|交易时间|业务类型|流水号|流水序号|账号|户名|收支标志|币种|交易金额|余额|可用余额|对方账号|对方户名|对方地址|对方开户行行号|对方开户行行名|票据种类|票据号码|票据名称|票据签发日期|附言|备注|交易码|备用\\n\" +\n                \"0|20251105|093003|2|EBB0001P70190041|1|310069079018800073806|怒访址撵鉴遮斌粤惨佣|D|CNY|100.00|11991096.17|0|81100614850188002002204|僧铃抬鲸届系括冉翘损御缎缠||01110146999|交通银行北京广渠路支行||||||q2yuyh5004#测试1|101700||\\n\" +\n                \"0|20251105|093022|2|EBB0001P70080041|2|310069079018800073806|怒访址撵鉴遮斌粤惨佣|D|CNY|100.00|11990996.17|0|81100614850188002002205|僧铃抬鲸届系括冉翘损御缎缠||01110146999|交通银行北京广渠路支行||||||q2yuyh50054#测试1|101700||\\n\" +\n                \"0|20251105|093041|2|EBB0001P70160051|3|310069079018800073806|怒访址撵鉴遮斌粤惨佣|D|CNY|100.00|11990896.17|0|81100614850188002002206|僧铃抬鲸届系括冉翘损御缎缠||01110146999|交通银行北京广渠路支行||||||q2yuy454#测试1|101700||\\n\" +\n                \"0|20251105|093058|2|EBB0001P70160052|4|310069079018800073806|怒访址撵鉴遮斌粤惨佣|D|CNY|100.00|11990796.17|0|81100614850188002002207|僧铃抬鲸届系括冉翘损御缎缠||01110146999|交通银行北京广渠路支行||||||q2yuy4554#测试1|101700||\";\n\n        log.info(\"🎯 开始演示银行交易记录解析...\");\n\n        // 解析银行交易记录\n        List<BankTransaction> transactions = BankTransactionParser.parseBankTransactions(bankTransactionData);\n\n        // 打印解析结果\n        log.info(\"✅ 解析完成！共处理 {} 条交易记录\", transactions.size());\n\n        // 展示详细解析结果\n        displayParsingResults(transactions);\n\n        // 统计信息\n        displayStatistics(transactions);\n\n        // 业务逻辑示例：统计收支情况\n        analyzeTransactionTrends(transactions);\n    }\n\n    /**\n     * 展示解析结果\n     */\n    private static void displayParsingResults(List<BankTransaction> transactions) {\n        log.info(\"\\n📊 详细解析结果:\");\n        log.info(\"=\".repeat(80));\n\n        for (int i = 0; i < Math.min(transactions.size(), 3); i++) {\n            BankTransaction transaction = transactions.get(i);\n            log.info(\"第 {} 条交易记录:\", i + 1);\n            log.info(\"  交易时间: {} {}\", transaction.getTransactionDate(), transaction.getTransactionTime());\n            log.info(\"  流水信息: {}(序号:{})\", transaction.getSerialNumber(), transaction.getSequenceNumber());\n            log.info(\"  账户信息: {} - {}\",\n                    maskAccountNumber(transaction.getAccountNumber()),\n                    transaction.getAccountName());\n            log.info(\"  交易详情: {} {} {}\",\n                    transaction.getIncomeExpenseFlag(),\n                    transaction.getCurrency(),\n                    transaction.getTransactionAmount());\n            log.info(\"  余额变化: {}\", transaction.getBalance());\n            log.info(\"  对方账户: {} - {}\",\n                    maskAccountNumber(transaction.getCounterpartyAccount()),\n                    transaction.getCounterpartyName());\n            log.info(\"  附言说明: {}\", transaction.getRemarkMemo());\n            log.info(\"-\".repeat(60));\n        }\n\n        if (transactions.size() > 3) {\n            log.info(\"... 省略 {} 条记录\", transactions.size() - 3);\n        }\n    }\n\n    /**\n     * 展示统计分析\n     */\n    private static void displayStatistics(List<BankTransaction> transactions) {\n        log.info(\"\\n📈 交易统计信息:\");\n        log.info(\"=\".repeat(80));\n\n        // 统计交易笔数\n        int totalCount = transactions.size();\n\n        // 统计收支金额\n        double totalExpense = 0.0;\n        double totalIncome = 0.0;\n\n        for (BankTransaction transaction : transactions) {\n            try {\n                Double amount = Double.parseDouble(transaction.getTransactionAmount());\n                if (\"D\".equals(transaction.getIncomeExpenseFlag())) {\n                    totalExpense += amount;\n                } else if (\"C\".equals(transaction.getIncomeExpenseFlag())) {\n                    totalIncome += amount;\n                }\n            } catch (NumberFormatException e) {\n                log.warn(\"金额格式异常: {}\", transaction.getTransactionAmount());\n            }\n        }\n\n        log.info(\"总交易笔数: {}\", totalCount);\n        log.info(\"总支出金额: {:.2f} CNY\", totalExpense);\n        log.info(\"总收入金额: {:.2f} CNY\", totalIncome);\n        log.info(\"净收支金额: {:.2f} CNY\", totalIncome - totalExpense);\n\n        // 账户余额变化\n        if (transactions.size() >= 2) {\n            try {\n                double startBalance = Double.parseDouble(transactions.get(0).getBalance());\n                double endBalance = Double.parseDouble(transactions.get(transactions.size() - 1).getBalance());\n                log.info(\"期初余额: {:.2f} CNY\", startBalance);\n                log.info(\"期末余额: {:.2f} CNY\", endBalance);\n                log.info(\"余额变化: {:.2f} CNY\", endBalance - startBalance);\n            } catch (NumberFormatException e) {\n                log.warn(\"余额格式解析异常\");\n            }\n        }\n    }\n\n    /**\n     * 分析交易趋势\n     */\n    private static void analyzeTransactionTrends(List<BankTransaction> transactions) {\n        log.info(\"\\n🔍 交易趋势分析:\");\n        log.info(\"=\".repeat(80));\n\n        // 按交易时间统计\n        log.info(\"交易时间分布:\");\n        transactions.stream()\n                .map(t -> t.getTransactionDate() + \" \" + t.getTransactionTime())\n                .distinct()\n                .sorted()\n                .forEach(time -> log.info(\"  {}\", time));\n\n        // 统计交易类型\n        long expenseCount = transactions.stream()\n                .filter(t -> \"D\".equals(t.getIncomeExpenseFlag()))\n                .count();\n        long incomeCount = transactions.stream()\n                .filter(t -> \"C\".equals(t.getIncomeExpenseFlag()))\n                .count();\n\n        log.info(\"交易类型统计:\");\n        log.info(\"  支出交易: {} 笔 ({:.1f}%)\", expenseCount, (expenseCount * 100.0 / transactions.size()));\n        log.info(\"  收入交易: {} 笔 ({:.1f}%)\", incomeCount, (incomeCount * 100.0 / transactions.size()));\n    }\n\n    /**\n     * 账号脱敏处理\n     */\n    private static String maskAccountNumber(String accountNumber) {\n        if (accountNumber == null || accountNumber.length() <= 8) {\n            return accountNumber;\n        }\n        return accountNumber.substring(0, 4) + \"****\" + accountNumber.substring(accountNumber.length() - 4);\n    }\n}",
