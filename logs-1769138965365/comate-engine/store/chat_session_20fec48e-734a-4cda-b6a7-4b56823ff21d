s[14]));\n            transaction.setCounterpartyAddress(cleanField(fields[15]));\n            transaction.setCounterpartyBankCode(cleanField(fields[16]));\n            transaction.setCounterpartyBankName(cleanField(fields[17]));\n            transaction.setBillType(cleanField(fields[18]));\n            transaction.setBillNumber(cleanField(fields[19]));\n            transaction.setBillName(cleanField(fields[20]));\n            transaction.setBillIssueDate(cleanField(fields[21]));\n            transaction.setRemarkMemo(cleanField(fields[22]));\n            transaction.setAdditionalRemark(cleanField(fields[23]));\n            transaction.setTransactionCode(cleanField(fields[24]));\n            transaction.setBackupField(cleanField(fields[25]));\n\n            return transaction;\n\n        } catch (Exception e) {\n            log.error(\"解析第{}行数据时发生异常\", lineNumber, e);\n            return null;\n        }\n    }\n\n    /**\n     * 清理字段值\n     *\n     * @param field 原始字段值\n     * @return 清理后的字段值\n     */\n    private static String cleanField(String field) {\n        return field != null ? field.trim() : \"\";\n    }\n\n    /**\n     * 打印解析结果（用于调试和验证）\n     *\n     * @param transactions 交易记录列表\n     */\n    public static void printParsingResult(List<BankTransaction> transactions) {\n        log.info(\"=== 银行交易记录解析结果 ===\");\n        log.info(\"共解析出 {} 条交易记录\", transactions.size());\n\n        if (transactions.isEmpty()) {\n            log.info(\"没有解析到有效的交易记录\");\n            return;\n        }\n\n        for (int i = 0; i < Math.min(transactions.size(), 5); i++) {\n            BankTransaction transaction = transactions.get(i);\n            log.info(\"第 {} 条记录:\", i + 1);\n            log.info(\"  状态: {}\", transaction.getStatus());\n            log.info(\"  交易日期: {}\", transaction.getTransactionDate());\n            log.info(\"  交易时间: {}\", transaction.getTransactionTime());\n            log.info(\"  业务类型: {}\", transaction.getBusinessType());\n            log.info(\" 