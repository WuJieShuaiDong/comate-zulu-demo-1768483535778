                "basename": "BankTransactionParser.java",
                "originalContent": "package com.baidu.pmc.bankcommon.core.utils;\n\nimport com.baidu.pmc.bankcommon.core.model.BankTransaction;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.lang3.StringUtils;\n\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.List;\n\n/**\n * 银行交易记录解析工具类\n * 用于解析银行流水文本数据，按照固定分隔符分割字段\n */\n@Slf4j\npublic class BankTransactionParser {\n\n    private static final String FIELD_SEPARATOR = \"|\";\n    private static final int EXPECTED_FIELD_COUNT = 26;\n\n    /**\n     * 解析银行交易记录字符串\n     *\n     * @param dataString 包含表头和数据的完整字符串\n     * @return 解析后的交易记录列表\n     */\n    public static List<BankTransaction> parseBankTransactions(String dataString) {\n        List<BankTransaction> transactions = new ArrayList<>();\n\n        if (StringUtils.isBlank(dataString)) {\n            log.warn(\"银行交易记录字符串为空\");\n            return transactions;\n        }\n\n        // 按行分割字符串\n        String[] lines = dataString.split(\"\\n\");\n        if (lines.length < 2) {\n            log.warn(\"银行交易记录数据行数不足，至少需要表头和一行数据\");\n            return transactions;\n        }\n\n        try {\n            // 第一行是表头\n            String headerLine = lines[0].trim();\n            // 移除开头的\"状态|\"，并根据项目规则修正字段名\n            String[] headerFields = parseFields(headerLine.replaceFirst(\"^状态\\\\|\", \"\"));\n\n            // 处理数据行\n            for (int i = 1; i < lines.length; i++) {\n                String dataLine = lines[i].trim();\n                if (StringUtils.isBlank(dataLine)) {\n                    continue;\n                }\n\n                String[] dataFields = parseFields(dataLine);\n                if (dataFields.length == EXPECTED_FIELD_COUNT) {\n                    BankTransaction transaction = createTransaction(headerFields, dataFields);\n                    transactions.add(transaction);\n                } else {\n                    log.warn(\"第{}行数据字段数量不正确，期望{}个，实际{}个\",\n                            i + 1, EXPECTED_FIELD_COUNT, dataFields.length);\n                }\n            }\n\n        } catch (Exception e) {\n            log.error(\"解析银行交易记录时发生异常\", e);\n        }\n\n        return transactions;\n    }\n\n    /**\n     * 解析单行数据字段\n     *\n     * @param line 原始数据行\n     * @return 分割后的字段数组\n     */\n    private static String[] parseFields(String line) {\n        String[] fields = line.split(\"\\\\\" + FIELD_SEPARATOR, -1); // 保留空字段\n\n        // 处理字段值，去除前后空格\n        for (int i = 0; i < fields.length; i++) {\n            fields[i] = fields[i].trim();\n        }\n\n        return fields;\n    }\n\n    /**\n     * 根据表头和数据字段创建交易记录对象\n     *\n     * @param headerFields 表头字段\n     * @param dataFields 数据字段\n     * @return 交易记录对象\n     */\n    private static BankTransaction createTransaction(String[] headerFields, String[] dataFields) {\n        BankTransaction transaction = new BankTransaction();\n\n        // 根据索引设置字段值\n        if (headerFields.length >= 1) transaction.setStatus(getField(dataFields, 0)); // 状态\n        if (headerFields.length >= 2) transaction.setTransactionDate(getField(dataFields, 1)); // 交易日期\n        if (headerFields.length >= 3) transaction.setTransactionTime(getField(dataFields, 2)); // 交易时间\n        if (headerFields.length >= 4) transaction.setBusinessType(getField(dataFields, 3)); // 业务类型\n        if (headerFields.length >= 5) transaction.setSerialNumber(getField(dataFields, 4)); // 流水号\n        if (headerFields.length >= 6) transaction.setSequenceNumber(getField(dataFields, 5)); // 流水序号\n        if (headerFields.length >= 7) transaction.setAccountNumber(getField(dataFields, 6)); // 账号\n        if (headerFields.length >= 8) transaction.setAccountName(getField(dataFields, 7)); // 户名\n        if (headerFields.length >= 9) transaction.setIncomeExpenseFlag(getField(dataFields, 8)); // 收支标志\n        if (headerFields.length >= 10) transaction.setCurrency(getField(dataFields, 9)); // 币种\n        if (headerFields.length >= 11) transaction.setTransactionAmount(getField(dataFields, 10)); // 交易金额\n        if (headerFields.length >= 12) transaction.setBalance(getField(dataFields, 11)); // 余额\n        if (headerFields.length >= 13) transaction.setAvailableBalance(getField(dataFields, 12)); // 可用余额\n        if (headerFields.length >= 14) transaction.setCounterpartyAccount(getField(dataFields, 13)); // 对方账号\n        if (headerFields.length >= 15) transaction.setCounterpartyName(getField(dataFields, 14)); // 对方户名\n        if (headerFields.length >= 16) transaction.setCounterpartyAddress(getField(dataFields, 15)); // 对方地址\n        if (headerFields.length >= 17) transaction.setCounterpartyBankCode(getField(dataFields, 16)); // 对方开户行行号\n        if (headerFields.length >= 18) transaction.setCounterpartyBankName(getField(dataFields, 17)); // 对方开户行行名\n        if (headerFields.length >= 19) transaction.setBillType(getField(dataFields, 18)); // 票据种类\n        if (headerFields.length >= 20) transaction.setBillNumber(getField(dataFields, 19)); // 票据号码\n        if (headerFields.length >= 21) transaction.setBillName(getField(dataFields, 20)); // 票据名称\n        if (headerFields.length >= 22) transaction.setBillIssueDate(getField(dataFields, 21)); // 票据签发日期\n        if (headerFields.length >= 23) transaction.setRemarkMemo(getField(dataFields, 22)); // 附言\n        if (headerFields.length >= 24) transaction.setAdditionalRemark(getField(dataFields, 23)); // 备注\n        if (headerFields.length >= 25) transaction.setTransactionCode(getField(dataFields, 24)); // 交易码\n        if (headerFields.length >= 26) transaction.setBackupField(getField(dataFields, 25)); // 备用字段\n\n        return transaction;\n    }\n\n    /**\n     * 安全获取字段值\n     *\n     * @param fields 字段数组\n     * @param index 索引\n     * @return 字段值，如果索引越界返回空字符串\n     */\n    private static String getField(String[] fields, int index) {\n        return (index >= 0 && index < fields.length) ? fields[index] : \"\";\n    }\n\n    /**\n     * 打印解析结果（用于调试和验证）\n     *\n     * @param transactions 交易记录列表\n     */\n    public static void printParsingResult(List<BankTransaction> transactions) {\n        log.info(\"=== 银行交易记录解析结果 ===\");\n        log.info(\"共解析出 {} 条交易记录\", transactions.size());\n\n        for (int i = 0; i < transactions.size(); i++) {\n            BankTransaction transaction = transactions.get(i);\n            log.info(\"第 {} 条记录:\", i + 1);\n            log.info(\"  状态: {}\", transaction.getStatus());\n            log.info(\"  交易日期: {}\", transaction.getTransactionDate());\n            log.info(\"  交易时间: {}\", transaction.getTransactionTime());\n            log.info(\"  业务类型: {}\", transaction.getBusinessType());\n            log.info(\"  流水号: {}\", transaction.getSerialNumber());\n            log.info(\"  账号: {}\", maskAccountNumber(transaction.getAccountNumber()));\n            log.info(\"  户名: {}\", transaction.getAccountName());\n            log.info(\"  收支标志: {}\", transaction.getIncomeExpenseFlag());\n            log.info(\"  交易金额: {}\", transaction.getTransactionAmount());\n            log.info(\"  余额: {}\", transaction.getBalance());\n            log.info(\"  附言: {}\", transaction.getRemarkMemo());\n            log.info(\"---\");\n        }\n    }\n\n    /**\n     * 脱敏处理账号信息（用于日志输出）\n     *\n     * @param accountNumber 原始账号\n     * @return 脱敏后的账号\n     */\n    private static String maskAccountNumber(String accountNumber) {\n        if (StringUtils.isBlank(accountNumber) || accountNumber.length() <= 8) {\n            return accountNumber;\n        }\n        return accountNumber.substring(0, 4) + \"****\" + accountNumber.substring(accountNumber.length() - 4);\n    }\n}",
