      "content": "package com.baidu.pmc.bankcommon.core.service.bcm.impl;\n\nimport com.alibaba.fastjson.JSON;\nimport com.baidu.pmc.bankcommon.core.constants.Constants;\nimport com.baidu.pmc.bankcommon.core.dto.ResponseBodyDTO;\nimport com.baidu.pmc.bankcommon.core.dto.ResponseHeaderDTO;\nimport com.baidu.pmc.bankcommon.core.service.AccountService;\nimport com.baidu.pmc.bankcommon.core.service.BankCommonPayInstructInterService;\nimport com.baidu.pmc.bankcommon.core.service.BankStrategyClient;\nimport com.baidu.pmc.bankcommon.core.service.BankcommonPayInstructService;\nimport com.baidu.pmc.bankcommon.core.service.BankcommonService;\nimport com.baidu.pmc.bankcommon.core.service.MachineService;\nimport com.baidu.pmc.bankcommon.core.service.PayChecksHisService;\nimport com.baidu.pmc.bankcommon.core.service.PayChecksService;\nimport com.baidu.pmc.bankcommon.core.service.PayChecksWriteBackService;\nimport com.baidu.pmc.bankcommon.core.service.PmcPayCommonBankColSetService;\nimport com.baidu.pmc.bankcommon.core.service.bcm.BankBcmService;\nimport com.baidu.pmc.bankcommon.core.service.impl.OperateByJDBC;\nimport com.baidu.pmc.bankcommon.core.service.impl.SendMailService;\nimport com.baidu.pmc.bankcommon.core.utils.DateTool;\nimport com.baidu.pmc.bankcommon.core.utils.MessageBuilder;\nimport com.baidu.pmc.bankcommon.core.utils.ResponseXmlParser;\nimport com.baidu.pmc.bankcommon.core.utils.WkContextHolder;\nimport com.baidu.pmc.bankcommon.persistence.dao.PmcPayCommonBankColSetMapper;\nimport com.baidu.pmc.bankcommon.persistence.dao.PmcPayCommonBankSetMapper;\nimport com.baidu.pmc.bankcommon.persistence.dao.PmcPayCommonTransFlexSetMapper;\nimport com.baidu.pmc.bankcommon.persistence.domain.PmcPayCommonBankColSet;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.pojo.dto.cmb.TransInfo;\nimport com.baidu.pmc.pojo.model.PmcAccount;\nimport com.baidu.pmc.pojo.model.PmcPayCommonBankSet;\nimport com.baidu.pmc.pojo.model.cmb.PayQO;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections.CollectionUtils;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\nimport tk.mybatis.mapper.entity.Example;\n\nimport java.util.ArrayList;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Objects;\n\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.BD_COMPANY;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.CURRENCY;\n\n@Slf4j\n@Service\npublic class BankBcmServiceImpl implements BankBcmService {\n    /**\n     * 10 毫秒重试\n     */\n    private static final long REDIS_LOCK_TIMEOUT = 10;\n    /**\n     * 10 分钟超时\n     */\n    private static final int REDIS_LOCK_EXPIRE = 10 * 60;\n\n\n    @Autowired\n    private AccountService accountService;\n\n    @Autowired\n    private SendMailService mailService;\n    @Autowired\n    private MachineService machineService;\n    @Autowired\n    private BankcommonPayInstructService bankcommonPayInstructService;\n    //  @Autowired\n    //    private BankcommonPayInstructMapper bankcommonPayInstructMapper;\n    @Autowired\n    private BankCommonPayInstructInterService bankCommonPayInstructInterService;\n    @Autowired\n    private PayChecksWriteBackService payChecksWriteBackService;\n    @Autowired\n    private PayChecksService payChecksService;\n    @Autowired\n    private PayChecksHisService payChecksHisService;\n    @Autowired\n    private OperateByJDBC operateByJDBC;\n\n    @Autowired\n    private MessageBuilder messageBuilder;\n\n    @Autowired\n    private ResponseXmlParser responseXmlParser;\n\n    @Autowired\n    private PmcPayCommonBankColSetMapper pmcPayCommonBankColSetMapper;\n\n    @Autowired\n    private PmcPayCommonBankColSetService pmcPayCommonBankColSetService;\n\n    @Autowired\n    private PmcPayCommonBankSetMapper pmcPayCommonBankSetMapper;\n\n    @Autowired\n    private BankStrategyClient bankStrategyClient;\n\n    @Autowired\n    private PmcPayCommonTransFlexSetMapper pmcPayCommonTransFlexSetMapper;\n\n    @Autowired\n    private BankcommonService bankcommonService;\n\n    @Override\n    public List<TransInfo> selectBankcommonTrans(PayQO payQO, Map<String, String> extentionParams) {\n        List<TransInfo> result = new ArrayList<>();\n        PmcAccount account = accountService.queryBankcommonAccountByAccountNo(payQO);\n        if (account == null || payQO.getStartDate() == null || payQO.getEndDate() == null) {\n            return result;\n        }\n\n        Map<String, Object> dto = new HashMap<String, Object>();\n        dto.put(\"tenantId\", account.getTenantId());\n        dto.put(\"account\", account.getAccountNo());\n        dto.put(\"bankCode\", account.getBank());\n        dto.put(\"currency\", account.getCurrency());\n        dto.put(\"beginDate\", DateUtils.formatDate(payQO.getStartDate(), DateTool.DAY_PARTTEN_YYYYMMDD));\n        dto.put(\"endDate\", DateUtils.formatDate(payQO.getEndDate(), DateTool.DAY_PARTTEN_YYYYMMDD));\n        // 如果有日期扩展参数，则使用扩展参数覆盖默认参数\n        if (Objects.nonNull(extentionParams)) {\n            if (Objects.nonNull(extentionParams.get(\"beginDate\"))) {\n                dto.put(\"beginDate\", extentionParams.get(\"beginDate\"));\n            }\n            if (Objects.nonNull(extentionParams.get(\"endDate\"))) {\n                dto.put(\"endDate\", extentionParams.get(\"endDate\"));\n            }\n        }\n        this.homeTransactionsDeal(dto, extentionParams);\n\n        if (CollectionUtils.isNotEmpty((List<TransInfo>) dto.get(\"transInfoList\"))) {\n            String company = operateByJDBC.translate(BD_COMPANY, account.getCompanyCode());\n            for (TransInfo trans : (List<TransInfo>) dto.get(\"transInfoList\")) {\n                trans.setBankAccount(account.getAccountNo());\n                trans.setCompanyName(company);\n                trans.setCurrencyName(operateByJDBC.translate(CURRENCY, trans.getCurrency()));\n                result.add(trans);\n            }\n        }\n\n        return result;\n    }\n\n\n    /**\n     * 调起银行流水接口\n     */\n    private void homeTransactionsDeal(Map<String, Object> dto, Map<String, String> extentionParams) {\n        try {\n            Integer pageSize = 20;\n            Example examplePageSize = new Example(PmcPayCommonBankColSet.class);\n            examplePageSize.createCriteria().\n                    andEqualTo(\"bankCode\", dto.get(\"bankCode\"))\n                    .andEqualTo(\"interfaceType\", dto.get(\"interfaceType\"))\n                    .andEqualTo(\"interfaceDirection\", Constants.BankcommonInterfaceDirectionEnum.REQUEST)\n                    .andEqualTo(\"columnCode\", Constants.BankcommonColumnCodeEnum.DEFAULT_PAGE_SIZE)\n                    .andEqualTo(\"enableFlag\", Constants.ENABLED_Y);\n            List<PmcPayCommonBankColSet> pmcPayCommonBankColSetsPageSize = pmcPayCommonBankColSetMapper.selectByExample(examplePageSize);\n            if (CollectionUtils.isNotEmpty(pmcPayCommonBankColSetsPageSize)) {\n                pageSize = Integer.parseInt(pmcPayCommonBankColSetsPageSize.get(0).getMappingBankCol());\n            }\n            dto.put(\"pageSize\", pageSize);\n            List<TransInfo> res = new ArrayList<>();\n            dto.put(\"funName\", Constants.BankcommonTranscodeEnum.TRANSACTIONS);\n            String request = messageBuilder.queryTransactionsMessage(dto, extentionParams);\n\n            // 发送银行请求\n            String response = bankcommonService.postBank(request, dto, StringUtils.toString(dto.get(\"bankCode\")));\n            if (Constants.NO_ENABLED_MACHINE.equals(response)) {\n                log.error(\"流水查询时 无可用前置机异常, accountNo={}\", StringUtils.toString(dto.get(\"account\")));\n            } else if (Constants.BANK_POST_EXCEPTION.equals(response)) {\n                log.error(\"流水查询请求异常, accountNo={}\", StringUtils.toString(dto.get(\"account\")));\n            }\n            ResponseHeaderDTO responseHeaderDto =\n                    responseXmlParser.parseResponseXml(response, dto);\n            log.info(\"homeTransactionsDeal 处理银行请求结果 resDto={}\", JSON.toJSONString(responseHeaderDto));\n            if (responseHeaderDto == null) {\n                log.error(\"homeTransactionsDeal 银行报文解析为空\");\n                return;\n            }\n            ResponseHeaderDTO.SystemHeadBean header = responseHeaderDto.getHeader();\n            ResponseBodyDTO bodyDto = responseHeaderDto.getBody();\n            if (header == null || !Constants.RESPONSE_SUCCESS.equals(header.getStatus()) || bodyDto == null\n                    || CollectionUtils.isEmpty(bodyDto.getTransInfoList())) {\n                log.error(\"homeTransactionsDeal 银行报文解析发生错误\");\n                return;\n            }\n            // 处理成功\n            res.addAll(bodyDto.getTransInfoList());\n\n            dto.put(\"transInfoList\", res);\n        } catch (Exception e) {\n            log.error(\"homeTransactionsDeal 账户流水处理失败\", e);\n        }\n    }\n\n}\n",
