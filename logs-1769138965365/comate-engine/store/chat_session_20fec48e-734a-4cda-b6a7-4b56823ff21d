.translate(CURRENCY, trans.getCurrency()));\n                result.add(trans);\n            }\n        }\n\n        return result;\n    }\n\n\n    /**\n     * 调起银行流水接口\n     */\n    private void homeTransactionsDeal(Map<String, Object> dto, Map<String, String> extentionParams) {\n        try {\n            Integer pageSize = 20;\n            Example examplePageSize = new Example(PmcPayCommonBankColSet.class);\n            examplePageSize.createCriteria().\n                    andEqualTo(\"bankCode\", dto.get(\"bankCode\"))\n                    .andEqualTo(\"interfaceType\", dto.get(\"interfaceType\"))\n                    .andEqualTo(\"interfaceDirection\", Constants.BankcommonInterfaceDirectionEnum.REQUEST)\n                    .andEqualTo(\"columnCode\", Constants.BankcommonColumnCodeEnum.DEFAULT_PAGE_SIZE)\n                    .andEqualTo(\"enableFlag\", Constants.ENABLED_Y);\n            List<PmcPayCommonBankColSet> pmcPayCommonBankColSetsPageSize = pmcPayCommonBankColSetMapper.selectByExample(examplePageSize);\n            if (CollectionUtils.isNotEmpty(pmcPayCommonBankColSetsPageSize)) {\n                pageSize = Integer.parseInt(pmcPayCommonBankColSetsPageSize.get(0).getMappingBankCol());\n            }\n            dto.put(\"pageSize\", pageSize);\n            List<TransInfo> res = new ArrayList<>();\n            dto.put(\"funName\", Constants.BankcommonTranscodeEnum.TRANSACTIONS);\n            String request = messageBuilder.queryTransactionsMessage(dto, extentionParams);\n\n            // 发送银行请求\n            String response = bankcommonService.postBank(request, dto, StringUtils.toString(dto.get(\"bankCode\")));\n            if (Constants.NO_ENABLED_MACHINE.equals(response)) {\n                log.error(\"流水查询时 无可用前置机异常, accountNo={}\", StringUtils.toString(dto.get(\"account\")));\n            } else if (Constants.BANK_POST_EXCEPTION.equals(response)) {\n                log.error(\"流水查询请求异常, accountNo={}\", StringUtils.toString(dto.get(\"account\")));\n 