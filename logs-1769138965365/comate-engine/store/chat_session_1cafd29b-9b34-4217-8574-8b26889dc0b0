                  "content": "/*\n * Copyright (c) 2016. Baidu, Inc. All Rights Reserved.\n */\n\npackage com.baidu.p2p.bpm.service.impl;\n\nimport com.alibaba.fastjson.JSONObject;\nimport com.baidu.p2p.bpm.common.OperationResponseUtil;\nimport com.baidu.p2p.bpm.common.ProcessBizType;\nimport com.baidu.p2p.bpm.common.ProcessOperationType;\nimport com.baidu.p2p.bpm.domain.ActivityData;\nimport com.baidu.p2p.bpm.domain.BearFyiRequestBuilder;\nimport com.baidu.p2p.bpm.domain.CompleteActivityRequest;\nimport com.baidu.p2p.bpm.domain.CompleteActivityResponse;\nimport com.baidu.p2p.bpm.domain.CreateInsideReqRequest;\nimport com.baidu.p2p.bpm.domain.OperateActivityResponse;\nimport com.baidu.p2p.bpm.domain.OperationResponse;\nimport com.baidu.p2p.bpm.domain.PayeeBasicInfo;\nimport com.baidu.p2p.bpm.domain.PreviewResponse;\nimport com.baidu.p2p.bpm.domain.ProcessRecord;\nimport com.baidu.p2p.bpm.domain.ReassignActivityRequest;\nimport com.baidu.p2p.bpm.domain.RejectActivityRequest;\nimport com.baidu.p2p.bpm.domain.ReplyInsideReqRequest;\nimport com.baidu.p2p.bpm.domain.StaticFormRequest;\nimport com.baidu.p2p.bpm.facade.dto.ProcessRecordDTO;\nimport com.baidu.p2p.bpm.service.AbstractProcessStrategy;\nimport com.baidu.p2p.bpm.service.IProcessStrategy;\nimport com.baidu.p2p.cm.facade.dto.ContractInfoDTO;\nimport com.baidu.p2p.commons.api.MessageSendApi;\nimport com.baidu.p2p.commons.api.domain.MessageSendBuilder;\nimport com.baidu.p2p.commons.constants.BizConstants;\nimport com.baidu.p2p.core.j2ee.context.Config;\nimport com.baidu.p2p.fnd.api.MsgManageApi;\nimport com.baidu.p2p.pay.controller.PaymentAppraiseValidator;\nimport com.baidu.p2p.pay.controller.PaymentAppraiseValidator.AppraiseValidationResult;\nimport com.baidu.p2p.pay.domain.PayMethod;\nimport com.baidu.p2p.pay.domain.PayMethodColumn;\nimport com.baidu.p2p.pay.domain.PayeeInfo;\nimport com.baidu.p2p.pay.domain.Payment;\nimport com.baidu.p2p.pay.domain.PaymentOperator;\nimport com.baidu.p2p.pay.domain.PaymentProcessStartRequest;\nimport com.baidu.p2p.pay.domain.PaymentStatus;\nimport com.baidu.p2p.pay.facade.PaymentFacade;\nimport com.baidu.p2p.pay.facade.dto.PaymentAll;\nimport com.baidu.p2p.pay.facade.dto.PaymentPayeeForm;\nimport com.baidu.p2p.pay.service.PaymentFlowService;\nimport com.baidu.p2p.pay.service.PaymentProcessService;\nimport com.baidu.p2p.pay.service.PaymentService;\nimport com.baidu.p2p.po.common.PoHeaderAllEnums;\nimport com.baidu.p2p.system.config.ConfigConstants;\nimport com.baidu.p2p.system.i18n.LangEnv;\nimport com.baidu.p2p.system.uic.UICTransInfoUtils;\nimport com.baidu.p2p.system.uic.dto.UICUserInfoDto;\nimport org.apache.commons.collections4.CollectionUtils;\nimport org.apache.commons.lang3.StringUtils;\nimport org.apache.logging.log4j.LogManager;\nimport org.apache.logging.log4j.Logger;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.beans.factory.annotation.Value;\nimport org.springframework.stereotype.Service;\nimport org.springframework.transaction.annotation.Transactional;\nimport org.springframework.ui.Model;\nimport org.springframework.validation.BeanPropertyBindingResult;\n\nimport java.lang.reflect.Method;\nimport java.text.DecimalFormat;\nimport java.util.ArrayList;\nimport java.util.List;\nimport java.util.concurrent.CompletableFuture;\n\nimport static com.baidu.p2p.bpm.common.BpmConstants.START_ACT_DEF_ID;\nimport static com.baidu.p2p.bpm.common.BpmConstants.VENDOR_NAME_EN;\nimport static com.baidu.p2p.bpm.common.ProcessBizType.PAY_PAYMENT_PROCESS;\nimport static com.baidu.p2p.commons.constants.BizConstants.FndMessageCode.PAY_INTERNAL_PROCESS_PASS;\nimport static com.baidu.p2p.commons.constants.BizConstants.FndMessageCode.PAY_INTERNAL_PROCESS_REJECT;\nimport static com.baidu.p2p.commons.constants.BizConstants.FndMessageCode.PAY_NO_CONTRACT_TIP;\nimport static com.baidu.p2p.commons.constants.BizConstants.FndMessageCode.PAY_NO_REPORT_TIP;\nimport static com.baidu.p2p.commons.constants.BizConstants.FndMessageCode.PAY_VENDOR_PROCESS_PASS;\nimport static com.baidu.p2p.commons.constants.BizConstants.FndMessageCode.PAY_VENDOR_PROCESS_PASS_EMAIL;\nimport static com.baidu.p2p.commons.constants.BizConstants.FndMessageCode.PAY_VENDOR_PROCESS_REJECT;\nimport static com.baidu.p2p.commons.constants.BizConstants.FndMessageCode.PAY_VENDOR_PROCESS_REJECT_EMAIL;\nimport static com.baidu.p2p.core.contants.ConfigConstants.CONTRACT_URL_VIEWBYID;\nimport static com.baidu.p2p.core.contants.ConfigConstants.PPS_PORTAL_CAIGOU_TOVIEWREPORTBYCODE;\n\n/**\n * 支付流程\n * Created by anhuan on 16-8-14.\n */\n@Service(\"paymentProcessStrategy\")\n@Transactional\npublic class PaymentProcessStrategy extends AbstractProcessStrategy implements IProcessStrategy {\n\n    private static Logger LOG = LogManager.getLogger(PaymentProcessStrategy.class);\n\n    @Autowired\n    PaymentFacade paymentFacade;\n\n    @Autowired\n    PaymentFlowService flowService;\n\n    @Autowired\n    PaymentAppraiseValidator appraiseValidator;\n\n    @Autowired\n    PaymentService paymentService;\n\n    @Autowired\n    MessageSendApi messageSendApi;\n\n    @Autowired\n    MsgManageApi msgManageApi;\n\n    @Autowired\n    PaymentProcessService paymentProcessService;\n\n    @Value(\"${pay.process.view.url}\")\n    private String url;\n\n    @Value(\"${pay.data.name}\")\n    private String dataName;\n\n    private static final String TIP = \"审批重点提示\";\n\n    // 增加一个参数，使得用户具有权限查看合同。\n    private static final String CONTRACT_AUTH_PARAM = \"&temp=auto\";\n\n    @Override\n    public String getTaskForm(StaticFormRequest request, Model model) {\n        String processId = request.getProcessId();\n        String activityId = request.getActivityId();\n        ProcessRecord record;\n        if (request.getStatus() == 0) {\n            record = getProcessRecord(processId, activityId);\n            if (record == null || StringUtils.isEmpty(record.getOperationType())) {\n                model.addAttribute(\"error\", \"该流程不存在或该任务不是运行中状态\");\n                return \"process/error\";\n            }\n        }\n\n        String businessId = approvalRecordsApi.getBusinessId(processId);\n        PaymentAll paymentAll = paymentFacade.loadPayment(Long.valueOf(businessId));\n        final Payment payment = paymentAll.getPayment();\n\n        model.addAttribute(\"processTipList\", bpmProcessApi.getProcessTips(businessId, PAY_PAYMENT_PROCESS));\n        model.addAttribute(\"po\", paymentAll.getBasic().getPo());\n        model.addAttribute(\"basicInfo\", paymentAll.getBasic().getBasic());\n        ContractInfoDTO contract = paymentAll.getContract();\n        model.addAttribute(\"contractInfo\", contract);\n        if (contract != null && contract.getContractId() != null) {\n            String contractUrl = Config.get(CONTRACT_URL_VIEWBYID, contract.getContractId().toString())\n                    .concat(CONTRACT_AUTH_PARAM);\n            model.addAttribute(\"contractViewUrl\", contractUrl);\n        }\n        model.addAttribute(\"payeeInfo\", getPayeeInfo(paymentAll.getPayee()));\n        model.addAttribute(\"supportStatementNumber\", paymentAll.getPayee().isSupportStatementNumber());\n        model.addAttribute(\"checkoutDetails\", paymentAll.getCheckouts());\n        model.addAttribute(\"checkoutSelectedDetails\", paymentAll.getCheckouts().allSelectedLines(false));\n        model.addAttribute(\"prepays\", paymentAll.getPrepays());\n        model.addAttribute(\"paymentHistory\", paymentAll.getHistories());\n        model.addAttribute(\"records\", paymentAll.getActivities());\n        model.addAttribute(\"i18n_version\", Config.get(ConfigConstants.APPLICATION_VERSION));\n        boolean isIndependent = payment.getPoHeader().isIndependentProcurement();\n        String reportCode = contract == null ? null : contract.getReportCode();\n        if (isIndependent && StringUtils.isNotBlank(reportCode)) {\n            String reportUrl = Config.get(PPS_PORTAL_CAIGOU_TOVIEWREPORTBYCODE, reportCode).concat(CONTRACT_AUTH_PARAM);\n            model.addAttribute(\"reportViewUrl\", reportUrl);\n        }\n        model.addAttribute(\"isIndependent\", isIndependent);\n        model.addAttribute(\"poHeaderId\", payment.getPoHeader().getPoHeaderId());\n\n        // 这个申请人取pr的替代提交人\n        final String prSubstitutedSubmitterId = payment.getPoHeader().getPrSubstitutedSubmitterId();\n        if (StringUtils.isNotBlank(prSubstitutedSubmitterId)) {\n            UICTransInfoUtils transInfoUtils = UICTransInfoUtils.getInstance();\n            model.addAttribute(\"applicant\", transInfoUtils.getUserByUserName(prSubstitutedSubmitterId));\n        }\n        model.addAttribute(\"currencyFormatPattern\", payment.getCurrency().formatThousandPattern());\n        model.addAttribute(\"stdCurrencyFormatPattern\", payment.getStandardCurrency().formatThousandPattern());\n\n        try {\n            model.addAttribute(\"noContractTip\", msgManageApi.getMsg(PAY_NO_CONTRACT_TIP, LangEnv.getLang()));\n            model.addAttribute(\"noReportTip\", msgManageApi.getMsg(PAY_NO_REPORT_TIP, LangEnv.getLang()));\n        } catch (Exception e) {\n            model.addAttribute(\"noContractTip\", TIP);\n            model.addAttribute(\"noReportTip\", TIP);\n        }\n\n        if (request.getStatus() != 0) {\n            return \"pay/readonly-task-form\";\n        }\n\n        final AppraiseValidationResult result = appraiseValidator.approvalValidate(payment,\n                determineNodeType(activityId), new BeanPropertyBindingResult(payment, \"payment\"));\n\n        LOG.debug(\"[pay] {}: payment approval appraise validation result {}\",\n                payment.getPaymentHeaderId(), result);\n\n        if (result.hasRunningAppraises()) { // 没评价\n            model.addAttribute(\"hasRunningAppraise\", true);\n            model.addAttribute(\"appraiseUrl\", result.getRunningAppraise().getUrl());\n            model.addAttribute(\"needAppraise\", true);\n        } else { // 评价了\n            model.addAttribute(\"needAppraise\", false);\n        }\n        List<ProcessRecordDTO> records = getApprovalRecords(businessId, ProcessBizType.PAY_PAYMENT_PROCESS.getValue());\n        ProcessRecord curRecord = getProcessRecord(processId, activityId);\n        fillRequestInfoIfNecessary(records, curRecord.getOperationType(), model);\n\n        return \"pay/task-form\";\n    }\n\n    public enum NodeType {\n        UNKNOWN,\n        APPLICANT,\n        BUYER;\n    }\n\n    /**\n     * 从任务id中判断当前节点\n     * <p>\n     * 从这种id中: '1472564527689829856_act1', 获得下划线后面部分: 'act1'\n     * <p>\n     * N.B. 如果模型更改了这个定义对应的类型很可能变更。\n     *\n     * @param activityId bpm activity id, e.g. \"1472564527689829856_act1\"\n     *\n     * @return 任务定义ID\n     */\n    public static NodeType determineNodeType(String activityId) {\n        if (StringUtils.isBlank(activityId)) {\n            return NodeType.UNKNOWN;\n        }\n\n        final String[] actIdParts = StringUtils.split(activityId, \"_\", 2);\n        if (actIdParts.length < 2) {\n            return NodeType.UNKNOWN;\n        }\n\n        switch (actIdParts[1]) {\n            case \"act1\":\n                return NodeType.APPLICANT;\n            case \"act4\":\n                return NodeType.BUYER;\n            default:\n                return NodeType.UNKNOWN;\n        }\n    }\n\n    private PayeeBasicInfo getPayeeInfo(PaymentPayeeForm payeeForm) {\n        PayeeBasicInfo payeeBasicInfo = new PayeeBasicInfo();\n        payeeBasicInfo.setHasMultiPayee(payeeForm.getHasMultiPayee());\n        payeeBasicInfo.setAllowMultiPayee(payeeForm.isAllowMultiPayee());\n        String selectedPayMethodCode = payeeForm.getSelectedPayMethodCode();\n        payeeBasicInfo.setSelectedPayMethodCode(selectedPayMethodCode);\n        payeeBasicInfo.setSelectedPayMethodName(payeeForm.getSelectedPayMethodName());\n        payeeBasicInfo.setStatementNumber(payeeForm.getStatementNumber());\n        List<String> fields = new ArrayList<>();\n        List<String> values = new ArrayList<>();\n        PayeeInfo payee = payeeForm.getPayee();\n        for (PayMethod method : payeeForm.getPayMethods()) {\n            if (!selectedPayMethodCode.equals(method.getPayMethodCode())) {\n                continue;\n            }\n            for (PayMethodColumn column : method.getColumns()) {\n                fields.add(column.getName());\n                values.add(getValue(payee, column));\n            }\n            break;\n        }\n        payeeBasicInfo.setFields(fields);\n        payeeBasicInfo.setValues(values);\n        return payeeBasicInfo;\n    }\n\n    private String getValue(PayeeInfo payee, PayMethodColumn column) {\n        try {\n            String displayField = column.getDisplayField();\n            String fieldName = StringUtils.isEmpty(displayField) ? column.getField() : displayField;\n            String gName = \"get\".concat(StringUtils.capitalize(fieldName));\n            Method gMethod = PayeeInfo.class.getMethod(gName);\n            gMethod.setAccessible(true);\n            return (String) gMethod.invoke(payee);\n        } catch (Exception e) {\n            LOG.error(\"[pay] 付款审批待办，获取收付款信息失败\", e);\n        }\n        return StringUtils.EMPTY;\n    }\n\n    @Override\n    public OperationResponse completeActivity(CompleteActivityRequest request) {\n        final UICUserInfoDto performer = UICTransInfoUtils.getInstance().getUserByUserName(request.getPerformUser());\n        final PaymentOperator operator = PaymentOperator.fromUicUser(performer);\n\n        String businessId = approvalRecordsApi.getBusinessId(request.getProcessId());\n        if (StringUtils.isBlank(businessId)) {\n            return OperationResponseUtil.failResponse(\"没找到付款申请，不能审批。\");\n        }\n\n        long paymentHeaderId = Long.parseLong(businessId);\n        Payment payment = paymentService.getPayment(paymentHeaderId);\n        if (payment == null) {\n            return OperationResponseUtil.failResponse(\"没找到付款申请，不能审批。\");\n        }\n\n        // 非已提交状态无法审批\n        if (payment.getPaymentStatus() != PaymentStatus.SUBMITTED) {\n            return OperationResponseUtil.failResponse(\"单据状态已发生改变，不能审批。\");\n        }\n\n        final AppraiseValidationResult result = appraiseValidator.approvalValidate(payment,\n                determineNodeType(request.getActivityId()), new BeanPropertyBindingResult(payment, \"payment\"));\n        LOG.debug(\"[pay] {}: payment approval appraise validation result {}\", payment.getPaymentHeaderId(), result);\n        // 评价判断，没有评价不能提交\n        if (result.hasRunningAppraises()) {\n            LOG.debug(\"[pay] 没有评价不能提交审批，流程id：{}，任务id：{}\", request.getProcessId(), request.getActivityId());\n            return OperationResponseUtil.failResponse(\"没有评价，不能提交审批！请先去评价。\");\n        }\n\n        final PaymentProcessStartRequest startProcessRequest = paymentProcessService.createStartProcessRequest(\n                payment, payment.getPaymentHeader().getSubmitExchangeRate(), operator);\n\n        request.addActivityData(new ActivityData(dataName, JSONObject.toJSONString(startProcessRequest)));\n\n        try {\n            CompleteActivityResponse response = bpmProcessApi.completeActivity(request);\n            if (response.isSuccess()) {\n                if (CollectionUtils.isEmpty(response.getTasks())) {\n                    flowService.businessApproved(paymentHeaderId, operator);\n                    // FYI通知供应商或申请人\n                    sendFyi(request.getProcessId(), performer, payment, true, null);\n\n                }\n                approvalRecordsApi.recordCompleteActivity(request, response);\n                return OperationResponseUtil.successResponse();\n            }\n            LOG.error(\"[pay] 付款审批待办，调用提交任务接口返回失败，原因：{}\", response.getMessage());\n            return OperationResponseUtil.failResponse(response.getMessage());\n        } catch (Exception e) {\n            LOG.error(\"[pay] 付款审批待办，提交任务失败\", e);\n            return OperationResponseUtil.failResponse(\"提交任务失败，请稍候重试或联系管理员\");\n        }\n    }\n\n    @Override\n    public OperationResponse rejectActivity(RejectActivityRequest request) {\n        final UICUserInfoDto userByUserName = UICTransInfoUtils.getInstance().getUserByUserName(request.getPerformer());\n        final PaymentOperator rejectPerformer = PaymentOperator.fromUicUser(userByUserName);\n        String businessId = approvalRecordsApi.getBusinessId(request.getProcessId());\n        long paymentHeaderId = Long.parseLong(businessId);\n\n        Payment payment = paymentService.getPayment(paymentHeaderId);\n        final AppraiseValidationResult result = appraiseValidator.approvalValidate(payment,\n                determineNodeType(request.getActivityId()), new BeanPropertyBindingResult(payment, \"payment\"));\n        LOG.debug(\"[pay] {}: payment approval appraise validation result {}\", payment.getPaymentHeaderId(), result);\n        // 评价判断，没有评价不能提交\n        if (result.hasRunningAppraises()) {\n            LOG.debug(\"[pay] 没有评价不能拒绝审批，流程id：{}，任务id：{}\", request.getProcessId(), request.getActivityId());\n            return OperationResponseUtil.failResponse(\"没有评价，不能拒绝审批！请先去评价。\");\n        }\n\n        try {\n            final OperateActivityResponse response = bpmProcessApi.rejectActivity(request);\n            if (response.isSuccess()) {\n                flowService.reject(Long.parseLong(businessId), rejectPerformer);\n                approvalRecordsApi.recordRejectActivity(request, response);\n                CompletableFuture.runAsync(() ->\n                        sendFyi(request.getProcessId(), userByUserName, payment, false, request.getReason()));\n                return OperationResponseUtil.successResponse();\n            }\n            LOG.error(\"[pay] 付款审批待办，调用拒绝任务接口返回失败，原因：{}\", response.getMessage());\n            return OperationResponseUtil.failResponse(response.getMessage());\n        } catch (Exception e) {\n            LOG.error(\"[pay] 付款审批待办，拒绝任务失败\", e);\n            return OperationResponseUtil.failResponse(\"拒绝任务失败，请稍候重试或联系管理员\");\n        }\n    }\n\n    private void sendFyi(final String processId, final UICUserInfoDto userInfoDto, final Payment payment,\n                         final Boolean isPass, final String reason) {\n        try {\n            JSONObject params = new JSONObject();\n            params.put(\"paymentNum\", payment.getPaymentNum());\n            DecimalFormat nf = new DecimalFormat(payment.getCurrency().formatThousandPattern());\n            params.put(\"amount\", nf.format(payment.getPayAmount()));\n            params.put(\"currencyCode\", payment.getCurrency().getCurrencyCode());\n            params.put(\"reason\", reason);\n            if (isPayByVendor(payment)) { // 发送站内信给供应商\n                String messageCode = isPass ? PAY_VENDOR_PROCESS_PASS : PAY_VENDOR_PROCESS_REJECT;\n                messageSendApi.sendMessage(\n                        MessageSendBuilder.getInstance()\n                                .buildTo(payment.getSupplierId())\n                                .buildMessageCode(messageCode)\n                                .buildLanguage(LangEnv.getLang())\n                                .buildParameterObject(params)\n                );\n                messageCode = isPass ? PAY_VENDOR_PROCESS_PASS_EMAIL : PAY_VENDOR_PROCESS_REJECT_EMAIL;\n                messageSendApi.sendEmail(\n                        MessageSendBuilder.getInstance()\n                                .buildTo(payment.getApplicant().getApplicantEmail())\n                                .buildMessageCode(messageCode)\n                                .buildLanguage(LangEnv.getLang())\n                                .buildParameterObject(params)\n                );\n            } else {\n                String messageCode = isPass ? PAY_INTERNAL_PROCESS_PASS : PAY_INTERNAL_PROCESS_REJECT;\n                BearFyiRequestBuilder fyiRequestBuilder = BearFyiRequestBuilder.getInstance()\n                        .buildReceiver(payment.getPoHeader().getPrSubmitterId())\n                        .buildProcessViewUrl(url, processId, null);\n                if (!isPass) {\n                    params.put(\"performer\", userInfoDto.getUsername());\n                    fyiRequestBuilder.buildMessage(messageCode, \"US\", params);\n                    params.put(\"performer\", userInfoDto.getName());\n                    fyiRequestBuilder.buildMessage(messageCode, \"ZHS\", params);\n                } else {\n                    fyiRequestBuilder.buildMessage(messageCode, params);\n                }\n                bpmProcessApi.erpBearFYI(fyiRequestBuilder);\n            }\n        } catch (Exception e) {\n            LOG.error(\"[pay] 付款审批{}时，发送fyi失败，流程id：{}，原因：\", isPass ? \"完成\" : \"被拒绝\", processId,\n                    e.getCause().getMessage());\n        }\n    }\n\n    private boolean isPayByVendor(Payment payment) {\n        return PoHeaderAllEnums.PaySponsorCode.VENDOR.getValue().equals(payment.getPoHeader().getPaySponsorCode());\n    }\n\n    @Override\n    public OperationResponse reassignActivity(ReassignActivityRequest request) {\n        String businessId = approvalRecordsApi.getBusinessId(request.getProcessId());\n        long paymentHeaderId = Long.parseLong(businessId);\n        Payment payment = paymentService.getPayment(paymentHeaderId);\n        final AppraiseValidationResult result = appraiseValidator.approvalValidate(payment,\n                determineNodeType(request.getActivityId()), new BeanPropertyBindingResult(payment, \"payment\"));\n        LOG.debug(\"[pay] {}: payment approval appraise validation result {}\", payment.getPaymentHeaderId(), result);\n        // 评价判断，没有评价不能提交\n        if (result.hasRunningAppraises()) {\n            LOG.debug(\"[pay] 没有评价不能转发审批，流程id：{}，任务id：{}\", request.getProcessId(), request.getActivityId());\n            return OperationResponseUtil.failResponse(\"没有评价，不能转发审批！请先去评价。\");\n        }\n\n        try {\n            OperateActivityResponse response = bpmProcessApi.reassignActivity(request);\n            if (response.isSuccess()) {\n                approvalRecordsApi.recordReassignActivity(request, response);\n                return OperationResponseUtil.successResponse();\n            }\n            LOG.error(\"[pay] 付款审批待办，调用转发任务接口返回失败，原因：{}\", response.getMessage());\n            return OperationResponseUtil.failResponse(response.getMessage());\n        } catch (Exception e) {\n            LOG.error(\"[pay] 付款审批待办，转发任务失败\", e);\n            return OperationResponseUtil.failResponse(\"转发任务失败，请稍候重试或联系管理员\");\n        }\n    }\n\n    @Override\n    public OperationResponse requestActivity(CreateInsideReqRequest request) {\n        String businessId = approvalRecordsApi.getBusinessId(request.getProcessId());\n        long paymentHeaderId = Long.parseLong(businessId);\n        Payment payment = paymentService.getPayment(paymentHeaderId);\n        final AppraiseValidationResult result = appraiseValidator.approvalValidate(payment,\n                determineNodeType(request.getActivityId()), new BeanPropertyBindingResult(payment, \"payment\"));\n        LOG.debug(\"[pay] {}: payment approval appraise validation result {}\", payment.getPaymentHeaderId(), result);\n        // 评价判断，没有评价不能提交\n        if (result.hasRunningAppraises()) {\n            LOG.debug(\"[pay] 没有评价不能请求审批，流程id：{}，任务id：{}\", request.getProcessId(), request.getActivityId());\n            return OperationResponseUtil.failResponse(\"没有评价，不能发送请求！请先去评价。\");\n        }\n\n        try {\n            CompleteActivityResponse response = bpmProcessApi.createInsideRequestActivity(request);\n            if (response.isSuccess()) {\n                approvalRecordsApi.recordCreateInsideRequest(request, response);\n                return OperationResponseUtil.successResponse();\n            }\n            LOG.error(\"[pay] 付款审批待办，调用请求任务接口返回失败，原因：{}\", response.getMessage());\n            return OperationResponseUtil.failResponse(response.getMessage());\n        } catch (Exception e) {\n            LOG.error(\"[pay] 付款审批待办，请求任务失败\", e);\n            return OperationResponseUtil.failResponse(\"请求任务失败，请稍候重试或联系管理员\");\n        }\n\n    }\n\n    @Override\n    public OperationResponse replyInsideRequestActivity(ReplyInsideReqRequest request) {\n        try {\n            CompleteActivityResponse response = bpmProcessApi.replyInsideRequestActivity(request);\n            if (response.isSuccess()) {\n                approvalRecordsApi.recordReplyInsideRequest(request, response);\n                return OperationResponseUtil.successResponse();\n            }\n            LOG.error(\"[pay] 付款审批待办，调用回复任务接口返回失败，原因：{}\", response.getMessage());\n            return OperationResponseUtil.failResponse(response.getMessage());\n        } catch (Exception e) {\n            LOG.error(\"[pay] 付款审批待办，回复任务失败\", e);\n            return OperationResponseUtil.failResponse(\"回复任务失败，请稍候重试或联系管理员\");\n        }\n    }\n\n    @Override\n    protected List<ProcessRecordDTO> filterPreviousRecords(List<ProcessRecordDTO> records) {\n        List<ProcessRecordDTO> filteredRecords = new ArrayList<>();\n        boolean isByVendor = false;\n        for (ProcessRecordDTO record : records) {\n            if (START_ACT_DEF_ID.equals(record.getActDefId()) && VENDOR_NAME_EN.equals(record.getPerformer())) {\n                isByVendor = true;\n            }\n            if (\"act1\".equals(record.getActDefId()) && !isByVendor) {\n                continue;\n            }\n            if (ProcessOperationType.REVOKE.getValue().equals(record.getOperationType())) {\n                record.setRemark(StringUtils.EMPTY);\n            }\n            filteredRecords.add(record);\n        }\n        return filteredRecords;\n    }\n\n    @Override\n    protected void fillPreviewMsg(PreviewResponse response) {\n        String msg = StringUtils.EMPTY;\n        try {\n            msg = msgManageApi.getMsg(BizConstants.FndMessageCode.PAY_SUBMIT_WFTIPS, LangEnv.getLang());\n        } catch (Exception e) {\n            LOG.error(\"[PAY] 获取预览页面话术失败，失败原因：{}\", e.getMessage());\n        }\n        response.setMsg(msg);\n    }\n}\n",
