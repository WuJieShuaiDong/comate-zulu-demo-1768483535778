FinancingStatus.values()) {\n            if (status.getValue().equals(value)) {\n                return status;\n            }\n        }\n        throw new IllegalArgumentException(\"未知的融资状态: \" + value);\n    }\n\n    /**\n     * 获取下一个状态\n     * @param currentStatus 当前状态\n     * @return 下一个状态，如果已经是最后一个状态则返回null\n     */\n    public static FinancingStatus getNextStatus(FinancingStatus currentStatus) {\n        FinancingStatus[] statuses = values();\n        int currentIndex = currentStatus.ordinal();\n        if (currentIndex < statuses.length - 1) {\n            return statuses[currentIndex + 1];\n        }\n        return null;\n    }\n\n    /**\n     * 获取下一个状态\n     * @param currentValue 当前状态值\n     * @return 下一个状态，如果已经是最后一个状态则返回null\n     */\n    public static FinancingStatus getNextStatus(String currentValue) {\n        FinancingStatus currentStatus = fromValue(currentValue);\n        return getNextStatus(currentStatus);\n    }\n\n    public static void main(String[] args) {\n        System.out.println(FinancingStatus.BANK_FUNDED.getValue() + \".\" + FinancingStatus.BANK_FUNDED.getDescription());\n        System.out.println(FinancingStatus.getNextStatus(FinancingStatus.BANK_REVIEWING).getDescription());\n        System.out.println(JSONObject.toJSON(getAllStatuses()));\n    }\n\n    /**\n     * 获取所有枚举状态及对应描述，返回List<CodeDesc>\n     * 每个CodeDesc对象包含code(状态值)和description(状态描述)\n     */\n    public static List<CodeDesc> getAllStatuses() {\n        return Arrays.stream(values())\n                .map(status -> new CodeDesc(status.getValue(), status.getDescription()))\n                .collect(Collectors.toList());\n    }\n\n    /**\n     * 根据状态值获取描述\n     * @param value 状态值\n     * @return 对应的状态描述\n     */\n    public static String getDescriptionByValue(String value) {\n        for (FinancingStatus status : values()) {\n            if (status.getValue().equals(value)) {\n                return status.getDescription();\n            }\n        }\n        return \"\";\