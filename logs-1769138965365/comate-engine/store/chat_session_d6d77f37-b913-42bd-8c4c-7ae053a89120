error(\"融资申请->update bank_apply_number failed: {} by apply_number: {}\", resultDTO.getFinanceNumber(),\n                    submitQO.getApplyNumber());\n            return ResponseMessage.fail(\"融资申请请求结果失败 返回银行融资编号bank_apply_number为空\");\n        }\n        return ResponseMessage.success(resultDTO);\n    }\n\n    @Override\n    public ResponseMessage financingApplyDetails(PmcFinanceBankBaseQO submitQO) {\n\n        FinanceApplyQueryRequest request = new FinanceApplyQueryRequest();\n\n        FinanceApplyQueryRequest.FinanceApplyItemBase item = new FinanceApplyQueryRequest.FinanceApplyItemBase();\n        item.setCoreid(bankCoreId);\n        item.setCotype(CoType.CORE_ENT.getCode());\n        item.setFinnbr(submitQO.getFinanceNumber());\n        request.setTdorpquyx(Collections.singletonList(item));\n\n        PmcCmbCloudDirectQO qo = buildCloudDirectQo(submitQO);\n        CmbResponse<FinanceApplyQueryResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FINANCING_APPLY_DETAILS.getCode(), request, qo,\n                    new TypeReference<CmbResponse<FinanceApplyQueryResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"融资结果查询->fail to get financing cal result， request: {}\", UtilType.bean2Json(request), e);\n            return ResponseMessage.fail(\"融资申请结果查询失败\");\n\n        }\n        if (Objects.isNull(response)) {\n            log.error(\"融资结果查询->fail to get financing cal result, request: {}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"融资申请查询失败\");\n        }\n        // todo:把 response 转换成需要的统一格式结果\n        FinancingApplyResultQueryDTO resultQueryDTO = new FinancingApplyResultQueryDTO();\n\n        FinanceApplyQueryResponse applyResponse = response.getResponse().getBody();\n        if (applyResponse == null) {\n            log.error(\"融资结果查询->fail to get financing cal result, request: {}, response {}\",\n                    UtilType.bean2Json(request), UtilType.bean2Json(response));\n            return ResponseMessage.fail(\"融资申请查询失败\");\n        }\n        List<FinanceApplyQueryResponse.ContInfo> contInfos = applyResponse.getTdorpquyy();\n        List<FinanceApplyQueryResponse.FeeInfo> feeInfos = applyResponse.getTdorpquyz();\n        List<FinanceApplyQueryResponse.DocumentInfo> documentInfos = applyResponse.getTdorpquyw();\n        if (CollectionUtils.isNotEmpty(contInfos)) {\n            FinanceApplyQueryResponse.ContInfo contInfo = contInfos.get(0);\n            resultQueryDTO.setTransferRequestId(contInfo.getTreqid());\n            resultQueryDTO.setCoreCorpCode(contInfo.getCorcod());\n            resultQueryDTO.setCoreCorpName(contInfo.getCornam());\n            resultQueryDTO.setTotalCount(contInfo.getTotsum());\n            resultQueryDTO.setTotalAmount(contInfo.getTotamt());\n            resultQueryDTO.setSupplierName(contInfo.getSmfnam());\n            resultQueryDTO.setSupplierCode(contInfo.getSmfcod());\n            resultQueryDTO.setApplyDate(contInfo.getOpdate());\n            resultQueryDTO.setDueDate(contInfo.getEnddat());\n            resultQueryDTO.setLoanStartDate(contInfo.getRelopd());\n            resultQueryDTO.setLoanEndDate(contInfo.getRelend());\n            resultQueryDTO.setFinanceAmount(contInfo.getFinamt());\n            resultQueryDTO.setFinanceType(contInfo.getFintyp());\n            resultQueryDTO.setSource(contInfo.getSource());\n            resultQueryDTO.setBusinessType(contInfo.getBiztyp());\n            resultQueryDTO.setOperationStatus(contInfo.getOprsts());\n            resultQueryDTO.setCurrency(Constants.Currency.cmbCode2Code(contInfo.getFinccy()));\n            resultQueryDTO.setFinanceRate(contInfo.getFinrat());\n            resultQueryDTO.setInterest(contInfo.getIntere());\n        }\n        if (CollectionUtils.isNotEmpty(feeInfos)) {\n            FinanceApplyQueryResponse.FeeInfo feeInfo = feeInfos.get(0);\n            resultQueryDTO.setFeeRate(feeInfo.getFerate());\n            resultQueryDTO.setFeeAmount(feeInfo.getFeeamt());\n            resultQueryDTO.setPaymentMethod(feeInfo.getPaytra());\n            resultQueryDTO.setPaymentAccount(feeInfo.getPayacc());\n            resultQueryDTO.setFeeType(feeInfo.getFeetyp());\n            resultQueryDTO.setServiceProviderName(feeInfo.getSernam());\n            resultQueryDTO.setServiceAccount(feeInfo.getSeracc());\n            resultQueryDTO.setBankName(feeInfo.getOpname());\n        }\n        if (CollectionUtils.isNotEmpty(documentInfos)) {\n            FinanceApplyQueryResponse.DocumentInfo documentInfo = documentInfos.get(0);\n            resultQueryDTO.setSupplierAccount(documentInfo.getSmfacc());\n            resultQueryDTO.setSupplierCode(documentInfo.getSmfcod());\n            resultQueryDTO.setSupplierBank(documentInfo.getSmfbak());\n            resultQueryDTO.setSupplierAddress(documentInfo.getSmfadd());\n            resultQueryDTO.setContractId(documentInfo.getContid());\n            resultQueryDTO.setContractName(documentInfo.getConnam());\n            resultQueryDTO.setDocumentId(documentInfo.getDocuid());\n            resultQueryDTO.setDocumentAmount(documentInfo.getDocamt());\n            resultQueryDTO.setPayableAmount(documentInfo.getRevamt());\n            resultQueryDTO.setPayableStartDate(documentInfo.getCaltim());\n            resultQueryDTO.setDocumentType(documentInfo.getDoctyp());\n            resultQueryDTO.setBuyerAccount(documentInfo.getBuyacc());\n            resultQueryDTO.setRemark(documentInfo.getRemark());\n            resultQueryDTO.setPayPlanDate(documentInfo.getPrdexp());\n        }\n        return ResponseMessage.success(resultQueryDTO);\n    }\n\n    @Override\n    public ResponseMessage financingQuotaQuery(PmcFinanceBankBaseQO queryQO) {\n        FinancingQuotaQryRequest request = new FinancingQuotaQryRequest();\n        FinancingQuotaQryRequest.FinancingQuotaQry quotaQry = new FinancingQuotaQryRequest.FinancingQuotaQry();\n        quotaQry.setCoreid(bankCoreId);\n        quotaQry.setCrdtid(bankCreditId);\n        quotaQry.setCotype(CoType.CORE_ENT.getCode());\n        request.setPchxcquyx(Collections.singletonList(quotaQry));\n        PmcCmbCloudDirectQO qo = buildCloudDirectQo(queryQO);\n        CmbResponse<FinancingQuotaQryResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FINANCING_QUOTA_QRY.getCode(), request, qo,\n                    new TypeReference<CmbResponse<FinancingQuotaQryResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"融资额度查询->fail to query financing quota, request :{}\", UtilType.bean2Json(request), e);\n            return ResponseMessage.fail(\"招行云直联查询额度失败\");\n\n        }\n        if (Objects.isNull(response)) {\n            log.error(\"融资额度查询->fail to query financing quota, request :{}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"招行云直联查询额度失败\");\n        }\n        FinanceQuotaDTO quotaDTO = new FinanceQuotaDTO();\n        FinancingQuotaQryResponse quotaRes = response.getResponse().getBody();\n        if (Objects.nonNull(quotaRes)) {\n            List<FinancingQuota> quotas = quotaRes.getPchxcquyw();\n            if (CollectionUtils.isEmpty(quotas)) {\n                if (StringUtils.isNotBlank(applicationEnv) && !applicationEnv.startsWith(\"online\")) {\n                    // 测试环境没取到值先给一个值\n                    quotas = new ArrayList<>();\n                    FinancingQuota test = new FinancingQuota();\n                    test.setEavamt(new BigDecimal(\"99999.83\"));\n                    quotas = new ArrayList<>();\n                    quotas.add(test);\n                } else {\n                    return ResponseMessage.fail(\"招行云直联未返回结果\");\n                }\n            }\n            FinancingQuota quota = quotas.get(0);\n            quotaDTO.setCurrency(Constants.Currency.cmbCode2Code(quota.getExoccy()));\n            quotaDTO.setCreditType(quota.getCrdtyp());\n            quotaDTO.setStartDate(quota.getStadat());\n            quotaDTO.setEndDate(quota.getEnddat());\n            quotaDTO.setIsExop(quota.getIsexop());\n            quotaDTO.setExoAmount(quota.getExoamt());\n            quotaDTO.setExoUsedAmount(quota.getEudamt());\n            quotaDTO.setExoAvailableAmount(quota.getEavamt());\n            quotaDTO.setCreditAmount(quota.getCrdamt());\n            quotaDTO.setCreditUsedAmount(quota.getCudamt());\n            quotaDTO.setCreditAvailableAmount(quota.getCavamt());\n            quotaDTO.setCreditStatus(quota.getCrests());\n        }\n        return ResponseMessage.success(quotaDTO);\n    }\n\n    @Override\n    public ResponseMessage uploadAttachment(PmcFinanceBankBaseQO uploadQO) {\n        // todo: 上传合同和发票，改为供应商在银行上传，展示不用接入\n        if (StringUtils.isBlank(uploadQO.getFilePath())) {\n            return ResponseMessage.fail(\"缺少附件信息\");\n        }\n        FileUploadRequest request = new FileUploadRequest();\n        request.setFilepath(uploadQO.getFilePath());\n        CmbResponse<FileUploadResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FILE_UPLOAD.getCode(), request, buildCloudDirectQo(uploadQO),\n                    new TypeReference<CmbResponse<FileUploadResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"融资上传->ffail to upload\");\n            return ResponseMessage.fail(\"附件上传失败\");\n        }\n        if (Objects.isNull(response)) {\n            log.error(\"融资上传->fail to upload file, response is empty, request :{}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"附件上传失败\");\n        }\n        FileUploadResponse uploadResponse = response.getResponse().getBody();\n        String fileKey = uploadResponse.getFilkey();\n        if (StringUtils.isBlank(fileKey)) {\n            return ResponseMessage.fail(\"文件上传失败\");\n        }\n        return ResponseMessage.success(fileKey);\n    }\n\n    @Override\n    public ResponseMessage attachmentRelate(PmcFinanceBankBaseQO supplementQO) {\n\n        AttachmentBindRequest request = new AttachmentBindRequest();\n        AttachmentBindRequest.ApplyInfo applyInfo = new AttachmentBindRequest.ApplyInfo();  // 融资申请部分\n        applyInfo.setCoreid(bankCoreId);\n        applyInfo.setBscode(Constants.FunCode.FINANCING_APPLY.getCode());   // 这里固定为融资申请\n        applyInfo.setYurref(supplementQO.getPayCheckNum()); // 业务参考号，取付款清单号\n        applyInfo.setRelyrf(supplementQO.getPayCheckNum()); // todo:关联的融资申请业务参考号,这里还要确定一下取哪个\n        // todo:是否支持多个附件\n        AttachmentBindRequest.AttachmentInfo attachmentInfo = new AttachmentBindRequest.AttachmentInfo();   // 附件部分\n        attachmentInfo.setAtthid(supplementQO.getAttachmentNumber());\n        attachmentInfo.setAtthnm(supplementQO.getAttachmentName());\n        request.setPcclbsatx(Collections.singletonList(applyInfo));\n        request.setPcclbsaty(Collections.singletonList(attachmentInfo));\n\n        PmcCmbCloudDirectQO qo = buildCloudDirectQo(supplementQO);\n        CmbResponse<AttachmentBindResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FINANCING_ATTACH_BIND.getCode(), request, qo,\n                    new TypeReference<CmbResponse<AttachmentBindResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"融资附件业务绑定->fail to bind attachment\", e);\n            return ResponseMessage.fail(\"附件绑定业务失败\");\n\n        }\n        if (Objects.isNull(response)) {\n            log.error(\"融资附件业务绑定->fail to bind attachment, response is empty, request :{}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"附件绑定业务失败\");\n        }\n        AttachmentBindResponse bindResponse = response.getResponse().getBody();\n        List<BindResult> bindResult = bindResponse.getPcclbsatz();\n        if (CollectionUtils.isEmpty(bindResult)) {\n            return ResponseMessage.fail(\"附件绑定业务请求异常\");\n        }\n        if (Constants.CmbResponseCode.BIND_SUCCESS_CODE.equals(bindResult.get(0).getRtncod())) {\n            return ResponseMessage.success(\"绑定成功\");\n        }\n        List<BindResultDetail> details = bindResponse.getPcclbsatw();\n        StringBuilder builder = new StringBuilder();\n        if (CollectionUtils.isNotEmpty(details)) {\n            details.forEach(detail -> {\n                builder.append(detail.getAtthid()).append(\":\").append(detail.getErrmsg()).append(\";\");\n            });\n        }\n        return ResponseMessage.fail(builder.toString());\n    }\n\n    private PmcCmbCloudDirectQO buildCloudDirectQo(PmcFinanceBankBaseQO bankBaseQO) {\n        PmcCmbCloudDirectQO qo = new PmcCmbCloudDirectQO();\n        String acc = RandomStringUtils.randomAlphanumeric(10);\n        if (StringUtils.isNotBlank(bankBaseQO.getBuyerAccount())) {\n            acc = bankBaseQO.getBuyerAccount();\n        }\n        qo.setMachineBank(bankMachine);\n        qo.setAccnbr(acc);\n        qo.setYurref(bankBaseQO.getYurref());   // 作为reqid参数，要求前17位是yyyyMMddHHmmssSSS格式，有前置机可以不传\n        return qo;\n    }\n\n\n    /**\n     * 定时刷新融资申请结果查询\n     */\n    @Override\n    @MicroScheduleExecutor(code = \"getCmbFinancingResultJob\")\n    public void getFinancingResultJob() {\n        Logger logger = MicroScheduleContext.currentTaskContext().getLogger();\n        logger.info(\"*****定时刷新融资申请结果查询开始*******\");\n        queryAllFinancingResult();\n        logger.info(\"*****定时刷新融资申请结果查询结束*******\");\n    }\n\n    /**\n     * 根据未完结单据查询并刷新融资结果\n     */\n    private void queryAllFinancingResult() {\n        HashMap<String, String> cmbStatusMapping = new HashMap<>();\n        cmbStatusMapping.put(\"00\", SupplierFinancingApplyStatus.BANK_PROCESSING.name());\n        cmbStatusMapping.put(\"01\", SupplierFinancingApplyStatus.REJECTED.name());\n        cmbStatusMapping.put(\"04\", SupplierFinancingApplyStatus.PENDING_DISBURSEMEN.name());\n        cmbStatusMapping.put(\"08\", SupplierFinancingApplyStatus.DISBURSED.name());\n        cmbStatusMapping.put(\"09\", SupplierFinancingApplyStatus.REJECT.name());\n        cmbStatusMapping.put(\"20\", SupplierFinancingApplyStatus.SETTLED.name());\n\n        List<String> pendingStatus = Arrays.asList(SupplierFinancingApplyStatus.SUBMITTED.name(),\n                SupplierFinancingApplyStatus.BANK_PROCESSING.name(),\n                SupplierFinancingApplyStatus.PENDING_DISBURSEMEN.name(),\n                SupplierFinancingApplyStatus.DISBURSED.name());\n\n\n        List<PmcFinanceSupplierApply> financeSupplierApplyList =\n                pmcFinanceSupplierApplyMapper.getPendingFinanceApplyByStatus(pendingStatus);\n        log.info(\"待查询融资单据数量：{}\", financeSupplierApplyList.size());\n        financeSupplierApplyList.forEach(apply -> {\n            PmcFinanceBankBaseQO query = new PmcFinanceBankBaseQO();\n            query.setFinanceNumber(apply.getBankApplyNumber());\n            ResponseMessage responseMessage = this.financingApplyDetails(query);\n            if (ResponseMessage.OK.equals(responseMessage.getStatus())) {\n                FinancingApplyResultQueryDTO result = (FinancingApplyResultQueryDTO) responseMessage.getData();\n                String returnStatus = result.getOperationStatus();\n                if (StringUtils.isEmpty(returnStatus)) {\n                    log.info(\"单据：{},查询银行状态异常，状态为\", apply.getApplyNumber());\n                    return;\n                }\n                String pmcStatus = cmbStatusMapping.get(returnStatus);\n                if (StringUtils.isEmpty(pmcStatus)) {\n                    // pmcStatus = returnStatus;\n                    log.error(\"融资状态查询，单据：{}状态无符合映射列表:{}\", apply.getBankApplyNumber(), returnStatus);\n                }\n                if (!apply.getStatus().equals(pmcStatus)) {\n                    log.info(\"单据：{},由状态：{}变更为：{}\", apply.getApplyNumber(), apply.getStatus(), pmcStatus);\n                    apply.setStatus(pmcStatus);\n                    apply.setLastUpdateDate(DateUtils.getNow());\n                    changeApplyStatus(apply);\n                } else {\n                    log.info(\"单据：{},无状态变更，当前状态：{}，{}\", apply.getApplyNumber(), apply.getStatus(), pmcStatus);\n                }\n            } else {\n                log.info(\"单据：{},查询银行状态异常，返回异常\", apply.getApplyNumber());\n\n            }\n        });\n\n    }\n\n    /**\n     * 变更状态\n     */\n    @Override\n    @Transactional(rollbackFor = Exception.class)\n    public void changeApplyStatus(PmcFinanceSupplierApply apply) {\n        // 更新融资单\n        pmcFinanceSupplierApplyMapper.updateByPrimaryKey(apply);\n        // 插入历史\n        PmcFinanceSupplierApplyHis applyHis = new PmcFinanceSupplierApplyHis();\n        BeanUtils.copyProperties(apply, applyHis);\n        // 操作人 供应商或者银行\n        applyHis.setCreateDate(new Date());\n        applyHis.setLastUpdateDate(new Date());\n        applyHis.setCreateBy(\"system\");\n        applyHis.setLastUpdateBy(\"system\");\n        applyHis.setOperationNode(SupplierFinancingApplyStatus.getOperationNode(apply.getStatus()));\n        pmcFinanceSupplierApplyHisMapper.insert(applyHis);\n        List<String> payCheckFinStatus = Arrays.asList(PayStatus.APPLY_FIN.name(), PayStatus.FINANCED.name());\n\n        PmcPayChecks payCheck = getPayCheck(apply, payCheckFinStatus);\n\n        // 已融资\n        if (SupplierFinancingApplyStatus.DISBURSED.name().equals(apply.getStatus())) {\n\n            payCheck.setStatus(PayStatus.FINANCED.name());\n            pmcPayChecksMapper.updateByPrimaryKey(payCheck);\n        }\n\n        // 拒绝 需要恢复原始付款单信息\n        if (SupplierFinancingApplyStatus.REJECTED.name().equals(apply.getStatus())\n                || SupplierFinancingApplyStatus.REJECT.name().equals(apply.getStatus())) {\n            payCheck.setStatus(apply.getPayOriginStatus());\n            payCheck.setPayGroup(apply.getPayOriginGroup());\n            pmcPayChecksMapper.updateByPrimaryKey(payCheck);\n        }\n        // 结清需要修改原始付款单信息\n        if (SupplierFinancingApplyStatus.SETTLED.name().equals(apply.getStatus())) {\n            payCheck.setActualPayDate(new Date());\n            PmcAccount pmcAccount =\n                    pmcAccountMapper.findByAccountNo(apply.getFinanceAccount(), null);\n            payCheck.setAcAccountId(pmcAccount.getAcAccountId());\n            payCheck.setAccount(apply.getFinanceAccount());\n            payCheck.setStatus(PayStatus.PAYED.name());\n            pmcPayChecksMapper.updateByPrimaryKey(payCheck);\n            // 触发回传\n            payChecksWriteBackService.writeBack(payCheck);\n        }\n\n\n        payChecksHisService.saveOrUpdateHis(payCheck, payCheck.getStatus()\n                , PayNode.FINANCE_APPLY.name()\n                , PayOperation.FINANCE_BANK_RETURN.name()\n                , \"融资银行回调状态变更为\" + SupplierFinancingApplyStatus.getDescription(apply.getStatus()));\n\n    }\n\n\n    /**\n     * 定时重发处理中的融资申请\n     */\n    @Override\n    @MicroScheduleExecutor(code = \"getCmbFinancingApplyJob\")\n    public void getCmbFinancingApplyJob() {\n        Logger logger = MicroScheduleContext.currentTaskContext().getLogger();\n        logger.info(\"*****定时重发处理中的融资申请开始*******\");\n        queryAllFinancingApply();\n        logger.info(\"*****定时重发处理中的融资申请结束*******\");\n    }\n\n    /**\n     * 根据未完结单据查询并刷新融资结果\n     */\n    private void queryAllFinancingApply() {\n        List<String> pendingStatus = Arrays.asList(SupplierFinancingApplyStatus.SEND_BANK.name());\n        List<PmcFinanceSupplierApply> financeSupplierApplyList =\n                pmcFinanceSupplierApplyMapper.getPendingFinanceApplyByStatus(pendingStatus);\n        log.info(\"待查询融资单据数量：{}\", financeSupplierApplyList.size());\n        financeSupplierApplyList.forEach(apply -> {\n            PmcFinanceBankBaseQO query = new PmcFinanceBankBaseQO();\n            query.setFinanceNumber(apply.getBankApplyNumber());\n            PayChecksQO payChecksQO = new PayChecksQO();\n            payChecksQO.setPayCheckNum(apply.getPayCheckNum());\n            payChecksQO.setStatus(PayStatus.APPLY_FIN.name());\n            List<PayChecksDTO> payChecksDTOS = pmcPayChecksMapper.selectAllPayChecks(payChecksQO);\n            PayChecksDTO payChecksDTO = payChecksDTOS.get(0);\n            // 组装报文\n            // todo 组装报文逻辑定时任务cmb和cmbc，还有service都有使用，如果有变化需要同步修改\n            query = assembleFinancingRequest(apply, payChecksDTO);\n            try {\n                validateFinancingRequest(query);\n            } catch (RuntimeException e) {\n                log.info(\"组装银行融资申请报文信息缺失，request: {}\", UtilType.bean2Json(query));\n                log.info(\"组装银行融资申请报文信息缺失，错误消息: {}\", e.getMessage());\n                return;\n            }\n            // 检查额度是否满足\n            if (!checkData(query)) {\n                dealApplyByRejected(apply);\n            }\n            ResponseMessage responseMessage = this.financingApply(query);\n            if (ResponseMessage.OK.equals(responseMessage.getStatus())) {\n                apply.setStatus(SupplierFinancingApplyStatus.SUBMITTED.name());\n                apply.setLastUpdateDate(DateUtils.getNow());\n                pmcFinanceSupplierApplyMapper.updateByPrimaryKey(apply);\n            } else {\n                log.info(\"单据：{},发送银行重新提交异常!\", apply.getApplyNumber());\n            }\n        });\n    }\n\n\n    private PmcFinanceBankBaseQO assembleFinancingRequest(PmcFinanceSupplierApply applyDTO, PayChecksDTO payChecksDTO) {\n        PmcFinanceBankBaseQO request = new PmcFinanceBankBaseQO();\n        PmcDataP2pSupplier supplier = supplierMapper.selectBySupplierCode(applyDTO.getSupplierCode());\n        payChecksDTO.setBankCodeName(operateByJDBC.translate(BANK, applyDTO.getBankCode()));\n\n        // 查询对应的付款单信息\n        request.setApplyNumber(applyDTO.getApplyNumber());\n        request.setPayCheckNum(applyDTO.getPayCheckNum());\n        request.setSupplierCode(applyDTO.getSupplierCode());\n        request.setSupplierName(supplier.getSupplierName());\n        request.setBankCode(applyDTO.getBankCode());\n        request.setCompanyCode(payChecksDTO.getCompanyCode());\n        request.setRegistrationCode(supplier.getRegistrationCode());\n        request.setPayPlanDate(applyDTO.getPatyPlanDate());\n        request.setFinanceAmount(applyDTO.getFinanceAmount());\n        request.setSupplierAccount(payChecksDTO.getAccount());\n        // todo 供应商开户银行和开户地址\n        request.setSupplierBank(payChecksDTO.getBankCodeName());\n        request.setSupplierAddress(StringUtils.isBlank(payChecksDTO.getAttribute4()) ? payChecksDTO.getAttribute6() : payChecksDTO.getAttribute4());\n        request.setPayableAmount(request.getFinanceAmount());\n        request.setCurrency(applyDTO.getCurrency());\n        request.setFinanceNumber(applyDTO.getPayCheckNum());\n\n        // 查询主体额度账户信息\n        PmcPortalRemainQuotaQO qo = new PmcPortalRemainQuotaQO();\n        qo.setBankCode(applyDTO.getBankCode());\n        qo.setSupplierCode(payChecksDTO.getCompanyCode());\n        List<PmcFinanceCompQuotaSet> compQuotaSet = queryValidCompQuotaSet(qo.getBankCode(), qo.getCompanyCode());\n        String buyAccount = compQuotaSet.get(0).getPayAccount();\n\n\n        // 查询发票信息\n        Example example = new Example(PmcPayIcInvoicesData.class);\n        Example.Criteria criteria = example.createCriteria();\n        criteria.andEqualTo(\"payCheckNum\", applyDTO.getPayCheckNum());\n        criteria.andEqualTo(\"checkId\", payChecksDTO.getCheckId());\n        List<PmcPayIcInvoicesData> pmcPayIcInvoicesData = pmcPayIcInvoicesDataMapper.selectByExample(example);\n        if (CollectionUtils.isNotEmpty(pmcPayIcInvoicesData)) {\n            PmcPayIcInvoicesData payIcInvoicesData = pmcPayIcInvoicesData.get(0);\n            request.setInvoiceNumber(payIcInvoicesData.getInvoiceNumber());\n            request.setInvoiceCode(payIcInvoicesData.getInvoiceCode());\n            request.setInvoiceDate(payIcInvoicesData.getInvoiceDate());\n            request.setTaxExcludedAmount(payIcInvoicesData.getInvoiceAmount());\n            request.setDocumentAmount(payIcInvoicesData.getTotalAmount());\n        }\n        // 合同信息\n        request.setContractId(payChecksDTO.getPayChecksAttribute16());\n        request.setContractName(\"/\");\n        // 还款账户\n        request.setBuyerAccount(buyAccount);\n\n        // 融资开始日期和融资结束日期\n        request.setFinanceStartDate(new Date());\n        request.setFinanceEndDate(applyDTO.getPatyPlanDate());\n\n        return request;\n    }\n\n    private boolean checkData(PmcFinanceBankBaseQO bankBaseQO) {\n        log.info(\"融资申请交检查数据：{}\", JSONObject.toJSONString(bankBaseQO));\n        // 3、有效额度是否满足\n        PmcPortalRemainQuotaQO qo = new PmcPortalRemainQuotaQO();\n        qo.setSupplierCode(bankBaseQO.getSupplierCode());\n        qo.setCompanyCode(bankBaseQO.getCompanyCode());\n        qo.setBankCode(bankBaseQO.getBankCode());\n        BigDecimal currentAvailableQuota = calculateAvailableQuota(qo);\n        ResponseMessage responseMessage = this.financingQuotaQuery(bankBaseQO);\n        FinanceQuotaDTO quotaDTO = new FinanceQuotaDTO();\n        Object quotaData = responseMessage.getData();\n        UtilType.copyProperties(quotaDTO, quotaData, true);\n        if (currentAvailableQuota.compareTo(quotaDTO.getExoAvailableAmount()) > 0) {\n            currentAvailableQuota = quotaDTO.getExoAvailableAmount();\n        }\n        if (currentAvailableQuota.compareTo(bankBaseQO.getFinanceAmount()) <= 0) {\n            log.info(\"当前可用额度不足，供应商编码: {}, 可用额度: {}, 融资金额: {}\",\n                    qo.getSupplierCode(), currentAvailableQuota, bankBaseQO.getFinanceAmount());\n            return false;\n        }\n        // 计划付款日期是否在7天之内\n        if (DateUtils.getAbsoluteDaysBetween(bankBaseQO.getPayPlanDate(), new Date()) < 7) {\n            log.info(\"计划付款日期不在7天之内，供应商编码: {}, 计划付款日期: {}, 当前日期: {}\",\n                    bankBaseQO.getSupplierCode(), bankBaseQO.getPayPlanDate(), DateUtils.formatDate(new Date(), DateUtils.YYYYMMDD));\n            return false;\n        }\n        return true;\n    }\n\n    /**\n     * 根据银行代码、公司代码查询有效的公司额度设置\n     *\n     * @param bankCode    银行代码\n     * @param companyCode 公司代码\n     * @return 符合条件的公司额度设置列表\n     */\n    private List<PmcFinanceCompQuotaSet> queryValidCompQuotaSet(String bankCode, String companyCode) {\n        Example exampleComp = new Example(PmcFinanceCompQuotaSet.class);\n        Example.Criteria criteriaComp = exampleComp.createCriteria();\n        criteriaComp.andEqualTo(\"bankCode\", bankCode);\n        criteriaComp.andEqualTo(\"companyCode\", companyCode);\n        criteriaComp.andEqualTo(\"enableFlag\", \"Y\");\n        return pmcFinanceCompQuotaSetMapper.selectByExample(exampleComp);\n    }\n\n\n    /**\n     * 校验银行融资基础请求参数\n     *\n     * @param request 融资请求参数\n     * @throws IllegalArgumentException 包含具体字段的错误提示\n     */\n    private void validateFinancingRequest(PmcFinanceBankBaseQO request) {\n        // 1. 基础信息校验\n        Validate.notBlank(request.getApplyNumber(), \"融资申请单号(applyNumber)不能为空\");\n        Validate.notBlank(request.getPayCheckNum(), \"付款单号(payCheckNum)不能为空\");\n        Validate.notBlank(request.getSupplierCode(), \"供应商编码(supplierCode)不能为空\");\n        Validate.notBlank(request.getSupplierName(), \"供应商名称(supplierName)不能为空\");\n        Validate.notBlank(request.getBankCode(), \"银行编码(bankCode)不能为空\");\n        Validate.notBlank(request.getCompanyCode(), \"公司编码(companyCode)不能为空\");\n\n        // 2. 金额校验\n        Validate.notNull(request.getFinanceAmount(), \"融资金额(financeAmount)不能为空\");\n        Validate.isTrue(request.getFinanceAmount().compareTo(BigDecimal.ZERO) > 0,\n                \"融资金额必须大于0\");\n\n        // 3. 账户信息校验\n        Validate.notBlank(request.getSupplierAccount(), \"供应商账户(supplierAccount)不能为空\");\n        Validate.notBlank(request.getSupplierBank(), \"供应商开户行(supplierBank)不能为空\");\n        Validate.notBlank(request.getSupplierAddress(), \"供应商开户地址(supplierAddress)不能为空\");\n\n        // 4. 时间校验\n        Validate.notNull(request.getPayPlanDate(), \"付款计划日期(payPlanDate)不能为空\");\n\n\n        // 5. 发票信息校验\n        Validate.notBlank(request.getInvoiceNumber(), \"发票号码(invoiceNumber)不能为空\");\n        Validate.notBlank(request.getInvoiceCode(), \"发票代码(invoiceCode)不能为空\");\n        Validate.notNull(request.getInvoiceDate(), \"发票日期(invoiceDate)不能为空\");\n\n\n        Validate.notNull(request.getTaxExcludedAmount(), \"不含税金额(taxExcludedAmount)不能为空\");\n        Validate.notNull(request.getDocumentAmount(), \"单据金额(documentAmount)不能为空\");\n\n        Validate.notBlank(request.getContractId(), \"合同ID(contractId)不能为空\");\n        Validate.notBlank(request.getContractName(), \"合同名称(contractName)不能为空\");\n        Validate.notBlank(request.getBuyerAccount(), \"还款账户(buyerAccount)不能为空\");\n\n    }\n\n    public BigDecimal calculateAvailableQuota(PmcPortalRemainQuotaQO qo) {\n        BigDecimal availableQuota;\n        // 1. 获取供应商额度\n        Example example = new Example(PmcFinanceSupplierQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n        criteria.andEqualTo(\"supplierCode\", qo.getSupplierCode());\n        criteria.andEqualTo(\"financeFlag\", \"Y\");\n        criteria.andGreaterThanOrEqualTo(\"effectiveEndDate\", new Date());\n        criteria.andLessThanOrEqualTo(\"effectiveStartDate\", new Date());\n        List<PmcFinanceSupplierQuotaSet> pmcFinanceSupplierQuotaSet\n                = pmcFinanceSupplierQuotaSetMapper.selectByExample(example);\n        if (CollectionUtils.isEmpty(pmcFinanceSupplierQuotaSet)) {\n            log.info(\"供应商{}额度计算，无额度配置\", qo.getSupplierCode());\n            return BigDecimal.ZERO;\n        }\n        availableQuota = pmcFinanceSupplierQuotaSet.get(0).getCreditQuota();\n\n        // 2. 获取已占用金额\n        BigDecimal usedQuota = getUseFinancingAmt(qo.getSupplierCode(), \"\");\n\n        // 3. 获取主体剩余额度\n        if (StringUtils.isNotBlank(qo.getCompanyCode()) && StringUtils.isNotBlank(qo.getBankCode())) {\n            List<PmcFinanceCompQuotaSet> compQuotaSet = queryValidCompQuotaSet(qo.getBankCode(), qo.getCompanyCode());\n            if (CollectionUtils.isNotEmpty(compQuotaSet)) {\n                log.info(\"供应商:{},供应商额度:{},主体额度:{},已用额度:{}\", qo.getSupplierCode(),\n                        availableQuota, compQuotaSet.get(0).getAvailableFinancingQuota(), usedQuota);\n                if (availableQuota.subtract(usedQuota).compareTo(compQuotaSet.get(0).getAvailableFinancingQuota()) > 0) {\n                    return compQuotaSet.get(0).getAvailableFinancingQuota();\n                }\n            } else {\n                log.info(\"主体{},银行{}额度计算，无额度配置\", qo.getCompanyCode(), qo.getBankCode());\n                return BigDecimal.ZERO;\n            }\n        }\n        return availableQuota.subtract(usedQuota);\n    }\n\n    /**\n     * 计算已使用的融资金额\n     *\n     * @param supplierCode 供应商编码\n     * @param payCheckNum  付款单号(可选)\n     * @return BigDecimal 已使用的融资金额\n     * 计算规则：指定供应商/付款单下所有非终态融资申请的总金额\n     */\n    private BigDecimal getUseFinancingAmt(String supplierCode, String payCheckNum) {\n        BigDecimal usedQuota = new BigDecimal(0);\n        List<String> targetStatuses = Arrays.asList(\n                SupplierFinancingApplyStatus.SUBMITTED.name(),\n                SupplierFinancingApplyStatus.BANK_PROCESSING.name(),\n                SupplierFinancingApplyStatus.PENDING_DISBURSEMEN.name(),\n                SupplierFinancingApplyStatus.DISBURSED.name());\n        Map<String, Object> resultMap = pmcFinanceSupplierApplyMapper.selectSummaryByStatus(targetStatuses,\n                supplierCode, payCheckNum);\n        usedQuota = (BigDecimal) resultMap.get(\"totalAmount\");\n        return usedQuota;\n    }\n\n\n    private PmcPayChecks getPayCheck(PmcFinanceSupplierApply apply, List<String> payCheckFinStatus) {\n        Example example = new WkExample(PmcPayChecks.class);\n        example.createCriteria().\n                andEqualTo(\"payCheckNum\", apply.getPayCheckNum())\n                .andIn(\"status\", payCheckFinStatus);\n        List<PmcPayChecks> payChecks = pmcPayChecksMapper.selectByExample(example);\n\n        if (CollectionUtils.isEmpty(payChecks)) {\n            log.info(\"申请单{}未找到申请融资流程中的付款单：{}\", apply.getApplyNumber(),\n                    apply.getPayCheckNum());\n            return null;\n        }\n        PmcPayChecks payCheck = payChecks.get(0);\n        return payCheck;\n    }\n\n    private void dealApplyByRejected(PmcFinanceSupplierApply apply) {\n        apply.setStatus(SupplierFinancingApplyStatus.REJECTED.name());\n        // 更新融资单状态为已拒绝\n        pmcFinanceSupplierApplyMapper.updateByPrimaryKey(apply);\n        // 插入历史\n        PmcFinanceSupplierApplyHis applyHis = new PmcFinanceSupplierApplyHis();\n        BeanUtils.copyProperties(apply, applyHis);\n        // 操作人 供应商或者银行\n        applyHis.setCreateDate(new Date());\n        applyHis.setLastUpdateDate(new Date());\n        applyHis.setCreateBy(\"system\");\n        applyHis.setLastUpdateBy(\"system\");\n        applyHis.setOperationNode(SupplierFinancingApplyStatus.getOperationNode(apply.getStatus()));\n        pmcFinanceSupplierApplyHisMapper.insert(applyHis);\n\n        // 更新付款单\n        List<String> payCheckFinStatus = Arrays.asList(PayStatus.APPLY_FIN.name());\n        PmcPayChecks payChecks = getPayCheck(apply, payCheckFinStatus);\n        payChecks.setStatus(apply.getPayOriginStatus());\n        payChecks.setPayGroup(apply.getPayOriginGroup());\n        pmcPayChecksMapper.updateByPrimaryKey(payChecks);\n        log.info(\"融资申请被拒绝，更新付款单状态为：{}, 设置支付组: {}\", apply.getPayOriginStatus(), apply.getPayOriginGroup());\n    }\n\n}\n",
