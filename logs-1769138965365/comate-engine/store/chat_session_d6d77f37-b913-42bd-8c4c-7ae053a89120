pply -> {\n            PmcFinanceBankBaseQO query = new PmcFinanceBankBaseQO();\n            query.setFinanceNumber(apply.getBankApplyNumber());\n            PayChecksQO payChecksQO = new PayChecksQO();\n            payChecksQO.setPayCheckNum(apply.getPayCheckNum());\n            payChecksQO.setStatus(PayStatus.APPLY_FIN.name());\n            List<PayChecksDTO> payChecksDTOS = pmcPayChecksMapper.selectAllPayChecks(payChecksQO);\n            PayChecksDTO payChecksDTO = payChecksDTOS.get(0);\n            // 组装报文\n            // todo 组装报文逻辑定时任务cmb和cmbc，还有service都有使用，如果有变化需要同步修改\n            query = assembleFinancingRequest(apply, payChecksDTO);\n            try {\n                validateFinancingRequest(query);\n            } catch (RuntimeException e) {\n                log.info(\"组装银行融资申请报文信息缺失，request: {}\", UtilType.bean2Json(query));\n                log.info(\"组装银行融资申请报文信息缺失，错误消息: {}\", e.getMessage());\n                return;\n            }\n            // 检查额度是否满足\n            if (!checkData(query)) {\n                dealApplyByRejected(apply);\n            }\n            ResponseMessage responseMessage = this.financingApply(query);\n            if (ResponseMessage.OK.equals(responseMessage.getStatus())) {\n                apply.setStatus(SupplierFinancingApplyStatus.SUBMITTED.name());\n                apply.setLastUpdateDate(DateUtils.getNow());\n                pmcFinanceSupplierApplyMapper.updateByPrimaryKey(apply);\n            } else {\n                log.info(\"单据：{},发送银行重新提交异常!\", apply.getApplyNumber());\n            }\n        });\n    }\n\n\n    private PmcFinanceBankBaseQO assembleFinancingRequest(PmcFinanceSupplierApply applyDTO, PayChecksDTO payChecksDTO) {\n        PmcFinanceBankBaseQO request = new PmcFinanceBankBaseQO();\n        PmcDataP2pSupplier supplier = supplierMapper.selectBySupplierCode(applyDTO.getSupplierCode());\n        payChecksDTO.setBankCodeName(operateByJDBC.translate(BANK, applyDTO.getBankCode()));\n\n        // 查询对应的付款单信息\n        request.setApplyNumber(applyDTO.getApplyNumber());\n        request.setPayCheckNum(applyDTO.getPayCheckNum());\n        request.setSupplierCode(applyDTO.getSupplierCode());\n        request.setSupplierName(supplier.getSupplierName());\n        request.setBankCode(applyDTO.getBankCode());\n        request.setCompanyCode(payChecksDTO.getCompanyCode());\n        request.setRegistrationCode(supplier.getRegistrationCode());\n        request.setPayPlanDate(applyDTO.getPatyPlanDate());\n        request.setFinanceAmount(applyDTO.getFinanceAmount());\n        request.setSupplierAccount(payChecksDTO.getAccount());\n        // todo 供应商开户银行和开户地址\n        request.setSupplierBank(payChecksDTO.getBankCodeName());\n        request.setSupplierAddress(StringUtils.isBlank(payChecksDTO.getAttribute4()) ? payChecksDTO.getAttribute6() : payChecksDTO.getAttribute4());\n        request.setPayableAmount(request.getFinanceAmount());\n        request.setCurrency(applyDTO.getCurrency());\n        request.setFinanceNumber(applyDTO.getPayCheckNum());\n\n        // 查询主体额度账户信息\n        PmcPortalRemainQuotaQO qo = new PmcPortalRemainQuotaQO();\n        qo.setBankCode(applyDTO.getBankCode());\n        qo.setSupplierCode(payChecksDTO.getCompanyCode());\n        List<PmcFinanceCompQuotaSet> compQuotaSet = queryValidCompQuotaSet(qo.getBankCode(), qo.getCompanyCode());\n        String buyAccount = compQuotaSet.get(0).getPayAccount();\n\n\n        // 查询发票信息\n        Example example = new Example(PmcPayIcInvoicesData.class);\n        Example.Criteria criteria = example.createCriteria();\n        criteria.andEqualTo(\"payCheckNum\", applyDTO.getPayCheckNum());\n        criteria.andEqualTo(\"checkId\", payChecksDTO.getCheckId());\n        List<PmcPayIcInvoicesData> pmcPayIcInvoicesData = pmcPayIcInvoicesDataMapper.selectByExample(example);\n        if (CollectionUtils.isNotEmpty(pmcPayIcInvoicesData)) {\n            PmcPayIcInvoicesData payIcInvoicesData = pmcPayIcInvoicesData.get(0);\n            request.setInvoiceNumber(payIcInvoicesData.getInvoiceNumber());\n            request.setInvoiceCode(payIcInvoicesData.getInvoiceCode());\n            request.setInvoiceDate(payIcInvoicesData.getInvoiceDate());\n            request.setTaxExcludedAmount(payIcInvoicesData.getInvoiceAmount());\n            request.setDocumentAmount(payIcInvoicesData.getTotalAmount());\n        }\n        // 合同信息\n        request.setContractId(payChecksDTO.getPayChecksAttribute16());\n        request.setContractName(\"/\");\n        // 还款账户\n        request.setBuyerAccount(buyAccount);\n\n        // 融资开始日期和融资结束日期\n        request.setFinanceStartDate(new Date());\n        request.setFinanceEndDate(applyDTO.getPatyPlanDate());\n\n        return request;\n    }\n\n    private boolean checkData(PmcFinanceBankBaseQO bankBaseQO) {\n        log.info(\"融资申请交检查数据：{}\", JSONObject.toJSONString(bankBaseQO));\n        // 3、有效额度是否满足\n        PmcPortalRemainQuotaQO qo = new PmcPortalRemainQuotaQO();\n        qo.setSupplierCode(bankBaseQO.getSupplierCode());\n        qo.setCompanyCode(bankBaseQO.getCompanyCode());\n        qo.setBankCode(bankBaseQO.getBankCode());\n        BigDecimal currentAvailableQuota = calculateAvailableQuota(qo);\n        ResponseMessage responseMessage = this.financingQuotaQuery(bankBaseQO);\n        FinanceQuotaDTO quotaDTO = new FinanceQuotaDTO();\n        Object quotaData = responseMessage.getData();\n        UtilType.copyProperties(quotaDTO, quotaData, true);\n        if (currentAvailableQuota.compareTo(quotaDTO.getExoAvailableAmount()) > 0) {\n            currentAvailableQuota = quotaDTO.getExoAvailableAmount();\n        }\n        if (currentAvailableQuota.compareTo(bankBaseQO.getFinanceAmount()) <= 0) {\n            log.info(\"当前可用额度不足，供应商编码: {}, 可用额度: {}, 融资金额: {}\",\n                    qo.getSupplierCode(), currentAvailableQuota, bankBaseQO.getFinanceAmount());\n            return false;\n        }\n        // 计划付款日期是否在7天之内\n        if (DateUtils.getAbsoluteDaysBetween(bankBaseQO.getPayPlanDate(), new Date()) < 7) {\n            log.info(\"计划付款日期不在7天之内，供应商编码: {}, 计划付款日期: {}, 当前日期: {}\",\n                    bankBaseQO.getSupplierCode(), bankBaseQO.getPayPlanDate(), DateUtils.formatDate(new Date(), DateUtils.YYYYMMDD));\n            return false;\n        }\n        return true;\n    }\n\n    /**\n     * 根据银行代码、公司代码查询有效的公司额度设置\n     *\n     * @param bankCode    银行代码\n     * @param companyCode 公司代码\n     * @return 符合条件的公司额度设置列表\n     */\n    private List<PmcFinanceCompQuotaSet> queryValidCompQuotaSet(String bankCode, String companyCode) {\n        Example exampleComp = new Example(PmcFinanceCompQuotaSet.class);\n        Example.Criteria criteriaComp = exampleComp.createCriteria();\n        criteriaComp.andEqualTo(\"bankCode\", bankCode);\n        criteriaComp.andEqualTo(\"companyCode\", companyCode);\n        criteriaComp.andEqualTo(\"enableFlag\", \"Y\");\n        return pmcFinanceCompQuotaSetMapper.selectByExample(exampleComp);\n    }\n\n\n    /**\n     * 校验银行融资基础请求参数\n     *\n     * @param request 融资请求参数\n     * @throws IllegalArgumentException 包含具体字段的错误提示\n     */\n    private void validateFinancingRequest(PmcFinanceBankBaseQO request) {\n        // 1. 基础信息校验\n        Validate.notBlank(request.getApplyNumber(), \"融资申请单号(applyNumber)不能为空\");\n        Validate.notBlank(request.getPayCheckNum(), \"付款单号(payCheckNum)不能为空\");\n        Validate.notBlank(request.getSupplierCode(), \"供应商编码(supplierCode)不能为空\");\n        Validate.notBlank(request.getSupplierName(), \"供应商名称(supplierName)不能为空\");\n        Validate.notBlank(request.getBankCode(), \"银行编码(bankCode)不能为空\");\n        Validate.notBlank(request.getCompanyCode(), \"公司编码(companyCode)不能为空\");\n\n        // 2. 金额校验\n        Validate.notNull(request.getFinanceAmount(), \"融资金额(financeAmount)不能为空\");\n        Validate.isTrue(request.getFinanceAmount().compareTo(BigDecimal.ZERO) > 0,\n                \"融资金额必须大于0\");\n\n        // 3. 账户信息校验\n        Validate.notBlank(request.getSupplierAccount(), \"供应商账户(supplierAccount)不能为空\");\n        Validate.notBlank(request.getSupplierBank(), \"供应商开户行(supplierBank)不能为空\");\n        Validate.notBlank(request.getSupplierAddress(), \"供应商开户地址(supplierAddress)不能为空\");\n\n        // 4. 时间校验\n        Validate.notNull(request.getPayPlanDate(), \"付款计划日期(payPlanDate)不能为空\");\n\n\n        // 5. 发票信息校验\n        Validate.notBlank(request.getInvoiceNumber(), \"发票号码(invoiceNumber)不能为空\");\n        Validate.notBlank(request.getInvoiceCode(), \"发票代码(invoiceCode)不能为空\");\n        Validate.notNull(request.getInvoiceDate(), \"发票日期(invoiceDate)不能为空\");\n\n\n        Validate.notNull(request.getTaxExcludedAmount(), \"不含税金额(taxExcludedAmount)不能为空\");\n        Validate.notNull(request.getDocumentAmount(), \"单据金额(documentAmount)不能为空\");\n\n        Validate.notBlank(request.getContractId(), \"合同ID(contractId)不能为空\");\n        Validate.notBlank(request.getContractName(), \"合同名称(contractName)不能为空\");\n        Validate.notBlank(request.getBuyerAccount(), \"还款账户(buyerAccount)不能为空\");\n\n    }\n\n    public BigDecimal calculateAvailableQuota(PmcPortalRemainQuotaQO qo) {\n        BigDecimal availableQuota;\n        // 1. 获取供应商额度\n        Example example = new Example(PmcFinanceSupplierQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n        criteria.andEqualTo(\"supplierCode\", qo.getSupplierCode());\n        criteria.andEqualTo(\"financeFlag\", \"Y\");\n        criteria.andGreaterThanOrEqualTo(\"effectiveEndDate\", new Date());\n        criteria.andLessThanOrEqualTo(\"effectiveStartDate\", new Date());\n        List<PmcFinanceSupplierQuotaSet> pmcFinanceSupplierQuotaSet\n                = pmcFinanceSupplierQuotaSetMapper.selectByExample(example);\n        if (CollectionUtils.isEmpty(pmcFinanceSupplierQuotaSet)) {\n            log.info(\"供应商{}额度计算，无额度配置\", qo.getSupplierCode());\n            return BigDecimal.ZERO;\n        }\n        availableQuota = pmcFinanceSupplierQuotaSet.get(0).getCreditQuota();\n\n        // 2. 获取已占用金额\n        BigDecimal usedQuota = getUseFinancingAmt(qo.getSupplierCode(), \"\");\n\n        // 3. 获取主体剩余额度\n        if (StringUtils.isNotBlank(qo.getCompanyCode()) && StringUtils.isNotBlank(qo.getBankCode())) {\n            List<PmcFinanceCompQuotaSet> compQuotaSet = queryValidCompQuotaSet(qo.getBankCode(), qo.getCompanyCode());\n            if (CollectionUtils.isNotEmpty(compQuotaSet)) {\n                log.info(\"供应商:{},供应商额度:{},主体额度:{},已用额度:{}\", qo.getSupplierCode(),\n                        availableQuota, compQuotaSet.get(0).getAvailableFinancingQuota(), usedQuota);\n                if (availableQuota.subtract(usedQuota).compareTo(compQuotaSet.get(0).getAvailableFinancingQuota()) > 0) {\n                    return compQuotaSet.get(0).getAvailableFinancingQuota();\n                }\n            } else {\n                log.info(\"主体{},银行{}额度计算，无额度配置\", qo.getCompanyCode(), qo.getBankCode());\n                return BigDecimal.ZERO;\n            }\n        }\n        return availableQuota.subtract(usedQuota);\n    }\n\n    /**\n     * 计算已使用的融资金额\n     *\n     * @param supplierCode 供应商编码\n     * @param payCheckNum  付款单号(可选)\n     * @return BigDecimal 已使用的融资金额\n     * 计算规则：指定供应商/付款单下所有非终态融资申请的总金额\n     */\n    private BigDecimal getUseFinancingAmt(String supplierCode, String payCheckNum) {\n        BigDecimal usedQuota = new BigDecimal(0);\n        List<String> targetStatuses = Arrays.asList(\n                SupplierFinancingApplyStatus.SUBMITTED.name(),\n                SupplierFinancingApplyStatus.BANK_PROCESSING.name(),\n                SupplierFinancingApplyStatus.PENDING_DISBURSEMEN.name(),\n                SupplierFinancingApplyStatus.DISBURSED.name());\n        Map<String, Object> resultMap = pmcFinanceSupplierApplyMapper.selectSummaryByStatus(targetStatuses,\n                supplierCode, payCheckNum);\n        usedQuota = (BigDecimal) resultMap.get(\"totalAmount\");\n        return usedQuota;\n    }\n\n\n    private PmcPayChecks getPayCheck(PmcFinanceSupplierApply apply, List<String> payCheckFinStatus) {\n        Example example = new WkExample(PmcPayChecks.class);\n        example.createCriteria().\n                andEqualTo(\"payCheckNum\", apply.getPayCheckNum())\n                .andIn(\"status\", payCheckFinStatus);\n        List<PmcPayChecks> payChecks = pmcPayChecksMapper.selectByExample(example);\n\n        if (CollectionUtils.isEmpty(payChecks)) {\n            log.info(\"申请单{}未找到申请融资流程中的付款单：{}\", apply.getApplyNumber(),\n                    apply.getPayCheckNum());\n            return null;\n        }\n        PmcPayChecks payCheck = payChecks.get(0);\n        return payCheck;\n    }\n\n    private void dealApplyByRejected(PmcFinanceSupplierApply apply) {\n        apply.setStatus(SupplierFinancingApplyStatus.REJECTED.name());\n        // 更新融资单状态为已拒绝\n        pmcFinanceSupplierApplyMapper.updateByPrimaryKey(apply);\n        // 插入历史\n        PmcFinanceSupplierApplyHis applyHis = new PmcFinanceSupplierApplyHis();\n        BeanUtils.copyProperties(apply, applyHis);\n        // 操作人 供应商或者银行\n        applyHis.setCreateDate(new Date());\n        applyHis.setLastUpdateDate(new Date());\n        applyHis.setCreateBy(\"system\");\n        applyHis.setLastUpdateBy(\"system\");\n        applyHis.setOperationNode(SupplierFinancingApplyStatus.getOperationNode(apply.getStatus()));\n        pmcFinanceSupplierApplyHisMapper.insert(applyHis);\n\n        // 更新付款单\n        List<String> payCheckFinStatus = Arrays.asList(PayStatus.APPLY_FIN.name());\n        PmcPayChecks payChecks = getPayCheck(apply, payCheckFinStatus);\n        payChecks.setStatus(apply.getPayOriginStatus());\n        payChecks.setPayGroup(apply.getPayOriginGroup());\n        pmcPayChecksMapper.updateByPrimaryKey(payChecks);\n        log.info(\"融资申请被拒绝，更新付款单状态为：{}, 设置支付组: {}\", apply.getPayOriginStatus(), apply.getPayOriginGroup());\n    }\n\n}\n",
