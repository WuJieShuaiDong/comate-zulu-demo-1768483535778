ribute_category as payChecksAttributeCategory,tpc.attribute15 as payChecksAttribute15,\n    tpc.pay_route, tpc.beneficiary_type_flag, tpc.exchange_rate, tpc.exchange_amount,\n    tpi.pay_info_id, tpi.attribute_category, tpi.attribute1, tpi.attribute2, tpi.attribute3, tpi.attribute4,\n    tpi.attribute5, tpi.attribute6, tpi.attribute7, tpi.attribute8, tpi.attribute9, tpi.attribute10, tpi.attribute11,\n    tpi.attribute12, tpi.attribute13, tpi.attribute14, tpi.attribute15,\n    tpc.create_by, tpc.create_date, tpc.last_update_by, tpc.last_update_date, tpc.iface_id\n  </sql>\n    <select id=\"selectReleasedStatus\" parameterType=\"com.baidu.pmc.pojo.qo.PayChecksQO\"\n            resultType=\"com.baidu.pmc.pojo.model.PmcPayChecks\">\n        select tpc.check_id,tpc.pay_check_num,tpc.tenant_id,tpc.pay_plan_date\n        from pmc_pay_checks tpc\n        join pmc_account pa on\n        pa.account_no = tpc.account and pa.currency = tpc.currency and pa.tenant_id = tpc.tenant_id\n        where\n        tpc.pay_route='EPAYMENT'\n        and tpc.hangup_flag='N'\n        and pa.type in ('HOME','THIRDPART','ABROAD')\n        <if test=\"status != null and status != ''\">\n            and tpc.status = #{status,jdbcType=VARCHAR}\n        </if>\n        <if test=\"payPlanDate != null\">\n            and tpc.pay_plan_date &lt;= #{payPlanDate,jdbcType=DATE}\n        </if>\n    </select>\n    <select id=\"selectFailAndRefundQuery\" parameterType=\"com.baidu.pmc.pojo.qo.PayChecksQO\"\n            resultType=\"com.baidu.pmc.pojo.dto.PayChecksDTO\">\n        select\n        <include refid=\"Base_Column_List\"/>,\n        h.create_date hDate\n        from\n        pmc_pay_checks tpc,\n        pmc_pay_info tpi,\n        (\n        select pay_check_num,create_date,max(last_update_date)\n        from pmc_pay_checks_audit_his\n        where pay_check_num in (select pay_check_num from pmc_pay_checks where tenant_id = '1' and status in ('FAILED','REFUND'))\n        and status in('FAILED','REFUND')