hb\n            ON prlb.role_header_id = prhb.role_header_id\n            WHERE prlb.line_type = 'LINE_BG'\n            AND prhb.role_user = #{currentUser,jdbcType=VARCHAR}\n            AND prlb.line_value = tpc.attribute12) OR tpc.attribute12 is null)\n        </if>\n        order by tpc.urgency_flag desc, tpc.pay_plan_date asc\n    </select>\n\n    <select id=\"selectTransferCheck\" parameterType=\"com.baidu.pmc.pojo.qo.PayChecksQO\"\n            resultType=\"com.baidu.pmc.pojo.dto.PayChecksDTO\">\n        select\n        <include refid=\"Base_Column_List\"/>\n        from pmc_pay_checks tpc\n        left join pmc_pay_info tpi\n        on tpc.pay_info_id = tpi.pay_info_id join pmc_account pa on\n        pa.account_no = tpc.account and pa.currency = tpc.currency and pa.tenant_id = tpc.tenant_id\n        where tpc.attribute7 = '1'\n        <if test=\"sourceNum != null and sourceNum != ''\">\n            and tpc.source_num = #{sourceNum,jdbcType=VARCHAR}\n        </if>\n        <if test=\"payCheckNum != null and payCheckNum != ''\">\n            and tpc.pay_check_num = #{payCheckNum,jdbcType=VARCHAR}\n        </if>\n        <if test=\"tenantId != null and tenantId !=''\">\n            and tpc.tenant_id = #{tenantId, jdbcType=BIGINT}\n        </if>\n        <if test=\"payChecksAttribute12 != null and payChecksAttribute12 != ''\">\n            and tpc.attribute12 = #{payChecksAttribute12,jdbcType=VARCHAR}\n        </if>\n        <if test=\"currentUser != null and currentUser != ''\">\n            AND (EXISTS\n            (SELECT 1\n            FROM pmc_role_line prlb\n            INNER JOIN pmc_role_header prhb\n            ON prlb.role_header_id = prhb.role_header_id\n            WHERE prlb.line_type = 'LINE_BG'\n            AND prhb.role_user = #{currentUser,jdbcType=VARCHAR}\n            AND prlb.line_value = tpc.attribute12) OR tpc.attribute12 is null)\n        </if>\n        order by tpc.urgency_flag desc, tpc.pay_plan_date asc\n    </select>\n\n    <select id=\"selectAllPayChecks\" parameterType=\"com.baidu.pmc.pojo.qo.PayChecksQO\"\n            resultType=\"com.baidu.pmc.pojo.dto.PayChecksDTO\">\n        select\n        <include refid=\"Base_Column_List\"/>\n        from pmc_pay_checks tpc\n        left join pmc_pay_info tpi\n        on tpc.pay_info_id = tpi.pay_info_id\n        <where>\n            <if test=\"trxType != null and trxType != ''\">\n                and tpc.trx_type = #{trxType,jdbcType=VARCHAR}\n            </if>\n            <if test=\"companyCodes != null and companyCodes.size &gt; 0\">\n                and tpc.company_code in\n                <foreach close=\")\" collection=\"companyCodes\" item=\"companyCode\" open=\"(\" separator=\",\">\n                    #{companyCode}\n                </foreach>\n            </if>\n            <if test=\"voucherSource != null and voucherSource != ''\">\n                and tpc.voucher_source = #{voucherSource,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payPlanDateBegin != null\">\n                and tpc.pay_plan_date &gt;= #{payPlanDateBegin,jdbcType=DATE}\n            </if>\n            <if test=\"payPlanDateEnd != null\">\n                and tpc.pay_plan_date &lt;= #{payPlanDateEnd,jdbcType=DATE}\n            </if>\n            <if test=\"sourceNum != null and sourceNum != ''\">\n                and tpc.source_num = #{sourceNum,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payCheckNum != null and payCheckNum != ''\">\n                and tpc.pay_check_num = #{payCheckNum,jdbcType=VARCHAR}\n            </if>\n            <if test=\"status != null and status != ''\">\n                and tpc.status = #{status,jdbcType=VARCHAR}\n            </if>\n            <if test=\"acPoolId != null and acPoolId != ''\">\n                and tpc.ac_account_id in (select ac_account_id from pmc_account_pool_detail where ac_pool_id =\n                #{acPoolId,jdbcType=BIGINT})\n            </if>\n            <if test=\"currency != null and currency != ''\">\n                and tpc.currency = #{currency,jdbcType=VARCHAR}\n            </if>\n            <if test=\"amountCurrency != null and amountCurrency != ''\">\n                and tpc.amount_currency = #{amountCurrency,jdbcType=VARCHAR}\n            </if>\n            <if test=\"account != null and account != ''\">\n                and tpc.account = #{account,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payGroup != null and payGroup != ''\">\n                and tpc.pay_group = #{payGroup,jdbcType=VARCHAR}\n            </if>\n            <if test=\"bankCode != null and bankCode != ''\">\n                and tpc.bank_code = #{bankCode,jdbcType=VARCHAR}\n            </if>\n            <if test=\"bankCodes != null and bankCodes.size &gt; 0\">\n                and tpc.bank_code in\n                <foreach close=\")\" collection=\"bankCodes\" item=\"bankCode\" open=\"(\" separator=\",\">\n                    #{bankCode}\n                </foreach>\n            </if>\n            <if test=\"defaultStatus != null and defaultStatus.size &gt; 0\">\n                and tpc.status in\n                <foreach close=\")\" collection=\"defaultStatus\" item=\"item\" open=\"(\" separator=\",\">\n                    #{item}\n                </foreach>\n            </if>\n            <if test=\"defaultPayRoute != null and defaultPayRoute.size &gt; 0\">\n                and tpc.pay_route in\n                <foreach close=\")\" collection=\"defaultPayRoute\" item=\"item\" open=\"(\" separator=\",\">\n                    #{item}\n                </foreach>\n            </if>\n            <if test=\"checkIds != null and checkIds.size &gt; 0\">\n                and tpc.check_id in\n                <foreach close=\")\" collection=\"checkIds\" item=\"checkId\" open=\"(\" separator=\",\">\n                    #{checkId}\n                </foreach>\n            </if>\n            <if test=\"amount != null\">\n                and tpc.amount = #{amount,jdbcType=DEC