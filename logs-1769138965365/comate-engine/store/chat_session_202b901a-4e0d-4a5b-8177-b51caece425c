f test=\"status != null and status != ''\">\n                and tpc.status = #{status,jdbcType=VARCHAR}\n            </if>\n            <if test=\"acPoolId != null and acPoolId != ''\">\n                and tpc.ac_account_id in (select ac_account_id from pmc_account_pool_detail where ac_pool_id =\n                #{acPoolId,jdbcType=BIGINT})\n            </if>\n            <if test=\"currency != null and currency != ''\">\n                and tpc.currency = #{currency,jdbcType=VARCHAR}\n            </if>\n            <if test=\"amountCurrency != null and amountCurrency != ''\">\n                and tpc.amount_currency = #{amountCurrency,jdbcType=VARCHAR}\n            </if>\n            <if test=\"account != null and account != ''\">\n                and tpc.account = #{account,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payGroup != null and payGroup != ''\">\n                and tpc.pay_group = #{payGroup,jdbcType=VARCHAR}\n            </if>\n            <if test=\"bankCode != null and bankCode != ''\">\n                and tpc.bank_code = #{bankCode,jdbcType=VARCHAR}\n            </if>\n            <if test=\"defaultStatus != null and defaultStatus.size &gt; 0\">\n                and tpc.status in\n                <foreach close=\")\" collection=\"defaultStatus\" item=\"item\" open=\"(\" separator=\",\">\n                    #{item}\n                </foreach>\n            </if>\n            <if test=\"defaultPayRoute != null and defaultPayRoute.size &gt; 0\">\n                and tpc.pay_route in\n                <foreach close=\")\" collection=\"defaultPayRoute\" item=\"item\" open=\"(\" separator=\",\">\n                    #{item}\n                </foreach>\n            </if>\n            <if test=\"checkIds != null and checkIds.size &gt; 0\">\n                and tpc.check_id in\n                <foreach close=\")\" collection=\"checkIds\" item=\"checkId\" open=\"(\" separator=\",\">\n                    #{checkId}\n                </foreach>\n            </if>\n            <if test=\"amount != null\">\n                and tpc.amount = #{amount,jdbcType=DECIMAL}\n            </if>\n            <if test=\"exclusivePayGroup != null and exclusivePayGroup!= ''\">\n                and tpc.pay_group != #{exclusivePayGroup,jdbcType=VARCHAR}\n            </if>\n            <if test=\"applyDateBegin != null\">\n                and tpc.apply_date &gt;= #{applyDateBegin,jdbcType=DATE}\n            </if>\n            <if test=\"applyDateEnd != null\">\n                and tpc.apply_date &lt;= #{applyDateEnd,jdbcType=DATE}\n            </if>\n            <if test=\"amountBegin != null and amountBegin != ''\">\n                and tpc.amount &gt;= #{amountBegin,jdbcType=DECIMAL}\n            </if>\n            <if test=\"amountEnd != null and amountEnd != ''\">\n                and tpc.amount &lt;= #{amountEnd,jdbcType=DECIMAL}\n            </if>\n            <if test=\"payMethod != null and payMethod != ''\">\n                and tpc.pay_method = #{payMethod,jdbcType=VARCHAR}\n            </if>\n            <if test=\"hangupFlag != null and hangupFlag != ''\">\n                and tpc.hangup_flag = #{hangupFlag,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payRoute != null and payRoute != ''\">\n                and tpc.pay_route = #{payRoute,jdbcType=VARCHAR}\n            </if>\n            <if test=\"tenantId != null and tenantId !=''\">\n                AND tpc.tenant_id = #{tenantId, jdbcType=BIGINT}\n            </if>\n        </where>\n        order by tpc.urgency_flag desc, tpc.pay_plan_date asc\n    </select>\n\n    <select id=\"selectBankPayChecks\" parameterType=\"com.baidu.pmc.pojo.qo.PayChecksQO\"\n            resultType=\"com.baidu.pmc.pojo.dto.PayChecksDTO\">\n        <!-- 过滤避免SQL注入 -->\n        ${safeOrderBy=orderBy,@java.util.Objects@requireNonNull(orderBy == null || orderBy.toString().matches(\"[\\\\w\\\\s$.*,]+\") ? \"\" : null, \"orderBy is not valid\")}\n        select\n        <include refid=\"Base_Column_List\"/>\n        from pmc_pay_checks tpc use index (pmc_pay_checks_u1,pmc_pay_checks_n2,pmc_pay_checks_n3,pmc_pay_checks_n4)\n        left join pmc_pay_info tpi\n        on tpc.pay_info_id = tpi.pay_info_id\n        <where>\n            tpc.hangup_flag != 'Y'\n            <if test=\"bdDirectFlag != null and bdDirectFlag != ''\">\n                and tpc.bd_direct_flag = #{bdDirectFlag,jdbcType=VARCHAR}\n            </if>\n            <if test=\"trxType != null and trxType != ''\">\n                and tpc.trx_type = #{trxType,jdbcType=VARCHAR}\n            </if>\n            <if test=\"companyCodes != null and companyCodes.size &gt; 0\">\n                and tpc.company_code in\n                <foreach close=\")\" collection=\"companyCodes\" item=\"companyCode\" open=\"(\" separator=\",\">\n                    #{companyCode}\n                </foreach>\n            </if>\n            <if test=\"voucherSource != null and voucherSource != ''\">\n                and tpc.voucher_source = #{voucherSource,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payPlanDateBegin != null\">\n                and tpc.pay_plan_date &gt;= #{payPlanDateBegin,jdbcType=DATE}\n            </if>\n            <if test=\"payPlanDateEnd != null\">\n                and tpc.pay_plan_date &lt;= #{payPlanDateEnd,jdbcType=DATE}\n            </if>\n            <if test=\"sourceNum != null and sourceNum != ''\">\n                and tpc.source_num = #{sourceNum,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payCheckNum != null and payCheckNum != ''\">\n                and tpc.pay_check_num = #{payCheckNum,jdbcType=VARCHAR}\n            </if>\n            <if test=\"status != null and status != ''\">\n                and tpc.status = #{status,jdbcType=VARCHAR}\n            </if>\n            <if test=\"acPoolId != null and acPoolId != ''\">\n                and tpc.ac_account_id in (select ac_account_id from pmc_account_pool_detail where ac_pool_id =\n                #{acPoolId,jdbcType=BIGINT})\n            </if>\n            <if test=\"currency != null and currency != ''\">\n                and tpc.currency = #{currency,jdbcType=VARCHAR}\n            </if>\n            <if test=\"amountCurrency != null and amountCurrency != ''\">\n                and tpc.amount_currency = #{amountCurrency,jdbcType=VARCHAR}\n            </if>\n            <if test=\"account != null and account != ''\">\n                and tpc.account = #{account,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payGroup != null and payGroup != ''\">\n                and tpc.pay_group = #{payGroup,jdbcType=VARCHAR}\n            </if>\n            <if test=\"bankCode != null and bankCode != ''\">\n                and tpc.bank_code = #{bankCode,jdbcType=VARCHAR}\n            </if>\n            <if test=\"defaultStatus != null and defaultStatus.size &gt; 0\">\n                and tpc.status in\n                <foreach close=\")\" collection=\"defaultStatus\" item=\"item\" open=\"(\" separator=\",\">\n                    #{item}\n                </foreach>\n            </if>\n            <if test=\"defaultPayRoute != null and defaultPayRoute.size &gt; 0\">\n                and tpc.pay_route in\n                <foreach close=\")\" collection=\"defaultPayRoute\" item=\"item\" open=\"(\" separator=\",\">\n                    #{item}\n                </foreach>\n            </if>\n            <if test=\"checkIds != null and checkIds.size &gt; 0\">\n                and tpc.check_id in\n                <foreach close=\")\" collection=\"checkIds\" item=\"checkId\" open=\"(\" separator=\",\">\n                    #{checkId}\n                </foreach>\n            </if>\n            <if test=\"amount != null\">\n                and tpc.amount = #{amount,jdbcType=DECIMAL}\n            </if>\n            <if test=\"payee != null and payee != ''\">\n                and tpi.attribute1 = #{payee,jdbcType=VARCHAR}\n            </if>\n            <if test=\"exclusivePayGroup != null and exclusivePayGroup!= ''\">\n                and tpc.pay_group != #{exclusivePayGroup,jdbcType=VARCHAR}\n            </if>\n            <if test=\"applyDateBegin != null\">\n                and tpc.apply_date &gt;= #{applyDateBegin,jdbcType=DATE}\n            </if>\n            <if test=\"applyDateEnd != null\">\n                and tpc.apply_date &lt;= #{applyDateEnd,jdbcType=DATE}\n            </if>\n            <if test=\"amountBegin != null and amountBegin != ''\">\n                and tpc.amount &gt;= #{amountBegin,jdbcType=DECIMAL}\n            </if>\n            <if test=\"amountEnd != null and amountEnd != ''\">\n                and tpc.amount &lt;= #{amountEnd,jdbcType=DECIMAL}\n            </if>\n            <if test=\"payMethod != null and payMethod != ''\">\n                and tpc.pay_method = #{payMethod,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payInfoId != null and payInfoId != ''\">\n                and tpi.pay_info_id = #{payInfoId,jdbcType=BIGINT}\n            </if>\n            <if test=\"payRoute != null and payRoute != ''\">\n                and tpc.pay_route = #{payRoute,jdbcType=VARCHAR}\n            </if>\n            <if test=\"attribute1 != null and attribute1 != ''\">\n                and tpi.attribute1 = #{attribute1,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payChecksAttribute12 != null and payChecksAttribute12 != ''\">\n                and tpc.attribute12 = #{payChecksAttribute12,jdbcType=VARCHAR}\n            </if>\n            <if test=\"teamId != null and teamId != ''\">\n                and (tpc.pay_recipient) IN (select finance_accountant_name FROM pmc_finance_accountant pfa,\n                pmc_finance_team pft\n                where\n                pfa.finance_team_id =\n                pft.finance_team_id AND pft.finance_team_id = #{teamId, jdbcType=BIGINT})\n            </if>\n        <if test=\"tenantId != null and tenantId !=''\">\n            AND tpc.tenant_id = #{tenantId, jdbcType=BIGINT}\n        </if>\n        <if test=\"currentUser != null and currentUser != ''\">\n            AND tpc.status IN ('CREATED', 'APPROVING')\n            AND (EXISTS\n            (SELECT 1\n            FROM pmc_direct_approval_rule pdar\n            WHERE ((tpc.status = 'CREATED' AND pdar.approve_role = 'APPROVE1') OR\n            (tpc.status = 'APPROVING' AND pdar.approve_role = 'APPROVE2'))\n            AND tpc.amount > pdar.approve_start_amount\n            AND pdar.approve_currency = tpc.currency\n            AND pdar.approver_account = #{currentUser, jdbcType=VARCHAR}\n            <if test=\"tenantId != null and tenantId !=''\">\n            AND pdar.tenant_id = #{tenantId, jdbcType=BIGINT}))\n            </if>\n            AND (EXISTS\n            (SELECT 1\n            FROM pmc_role_line prlt\n            INNER JOIN pmc_role_header prht\n            ON prlt.role_header_id = prht.role_header_id\n            WHERE prlt.line_type = 'LINE_TRANSACTION'\n            AND prht.role_user = #{currentUser,jdbcType=VARCHAR}\n            AND prlt.line_value = tpc.trx_type) OR tpc.trx_type = '')\n            AND (EXISTS\n            (SELECT 1\n            FROM pmc_role_line prla\n            INNER JOIN pmc_role_header prha\n            ON prla.role_header_id = prha.role_header_id\n            WHERE prla.line_type = 'LINE_ACCOUNT'\n            AND prha.role_user = #{currentUser,jdbcType=VARCHAR}\n            AND prla.line_value = tpc.account) OR tpc.account = '')\n            AND (EXISTS\n            (SELECT 1\n            FROM pmc_role_line prlb\n            INNER JOIN pmc_role_header prhb\n            ON prlb.role_header_id = prhb.role_header_id\n            WHERE prlb.line_type = 'LINE_BG'\n            AND prhb.role_user = #{currentUser,jdbcType=VARCHAR}\n            AND prlb.line_value = tpc.attribute12) OR tpc.attribute12 is null)\n        </if>\n        </where>\n        <if test=\"orderBy != null and orderBy != ''\">\n            order by ${safeOrderBy}\n        </if>\n    </select>\n\n    <select id=\"selectByAutotenantId\" resultType=\"com.baidu.pmc.pojo.model.PmcPayChecks\">\n        select tpc.check_id, tpc.tenant_id, tpc.trx_type, tpc.amount, tpc.currency from pmc_pay_checks tpc,\n        pmc_direct_approval_rule\n        pdar\n        <where>\n            pdar.approve_role = 'SELFAPPROVE'\n            AND pdar.approve_start_amount &lt; tpc.amount\n            AND pdar.approve_limit_amount &gt;= tpc.amount\n            AND tpc.status = 'CREATED'\n            AND tpc.bd_direct_flag = 'Y'\n            AND pdar.approve_currency = tpc.currency\n            AND tpc.tenant_id = pdar.tenant_id\n            AND tpc.hangup_flag = 'N'\n            AND tpc.trx_type != 'P99'\n        </where>\n        order by tpc.urgency_flag desc, tpc.pay_plan_date asc\n    </select>\n    <select id=\"selectPayApproveStatusCollect\" resultType=\"com.baidu.pmc.pojo.dto.PayChecksDTO\">\n        select\n        tpc.company_code,\n        tpc.expense_category,\n        tpc.expense_type,\n        tpc.source_num,\n        tpc.pay_check_num,\n        tpc.amount_currency,\n        tpc.amount,\n        tpc.hangup_flag,\n        tpc.create_date,\n        tpc.status,\n        tpc.pay_recipient,\n        tpc.tenant_id,\n        tpi.attribute1\n        from pmc_pay_checks tpc\n        left join pmc_pay_info tpi\n        on tpc.pay_info_id = tpi.pay_info_id\n        where tpc.status not in ('PAYED','FAILED','REFUND','DELETE','CANCEL','DRAFT','REFUSED','COMPLETED','REFUND_END','DUPLICATED_REJECT','REPETITION')\n        and to_days(now()) - to_days(tpc.last_update_date) > #{date}\n    </select>\n    <select id=\"findCreatedAndApprovingCollect\" resultType=\"com.baidu.pmc.pojo.dto.PayChecksDTO\">\n        select\n        tpc.company_code,\n        tpc.expense_category,\n        tpc.expense_type,\n        tpc.source_num,\n        tpc.pay_check_num,\n        tpc.amount_currency,\n        tpc.amount,\n        tpc.hangup_flag,\n        tpc.create_date,\n        tpc.last_update_date,\n        tpc.status,\n        tpc.pay_recipient,\n        tpc.tenant_id,\n        tpi.attribute1,\n        tpc.pay_plan_date,\n        tpc.attribute12 payChecksAttribute12\n        from pmc_pay_checks tpc\n        left join pmc_pay_info tpi\n        on tpc.pay_info_id = tpi.pay_info_id\n        where\n        tpc.pay_plan_date &lt;= now()\n        and tpc.status in ('CREATED','APPROVING')\n          and tpc.hangup_flag ='N'\n          AND tpc.amount &gt;0\n        and to_days(now()) - to_days(tpc.last_update_date) > #{date}\n    </select>\n    <update id=\"updateNullDate\">\n    update pmc_pay_checks ppc\n    set ppc.actual_pay_date = NULL\n    where ppc.check_id = #{checkId}\n  </update>\n\n    <select id=\"selectSuperCorrectionList\" parameterType=\"com.baidu.pmc.pojo.qo.PayChecksQO\"\n            resultType=\"com.baidu.pmc.pojo.dto.PayChecksDTO\">\n        select\n        tpc.check_id,\n        tpc.source_num,\n        tpc.pay_check_num,\n        tpc.pay_plan_date,\n        tpc.trx_type,\n        tpc.company_code,\n        tpc.attribute12 as payChecksAttribute12,\n        tpc.amount_currency,\n        tpc.amount,\n        tpc.pay_group,\n        tpc.status,\n        tpc.source_system,\n        tpc.voucher_source\n        from pmc_pay_checks tpc\n        where tpc.status not in('PAYED','PAY_ORDER_GEN','BANK_PROCESSING')\n        <if test=\"sourceNum != null and sourceNum != ''\">\n            and tpc.source_num = #{sourceNum,jdbcType=VARCHAR}\n        </if>\n        <if test=\"payCheckNum != null and payCheckNum != ''\">\n            and tpc.pay_check_num = #{payCheckNum,jdbcType=VARCHAR}\n        </if>\n        <if test=\"status != null and status != ''\">\n            and tpc.status = #{status,jdbcType=VARCHAR}\n        </if>\n        <if test=\"trxType != null and trxType != ''\">\n            and tpc.trx_type = #{trxType,jdbcType=VARCHAR}\n        </if>\n        <if test=\"sourceSystem != null and sourceSys