         </if>\n            <if test=\"ebankExportFlag != null and ebankExportFlag != ''\">\n                and tpc.ebank_export_flag = #{ebankExportFlag,jdbcType=VARCHAR}\n            </if>\n            <if test=\"attribute1 != null and attribute1 != ''\">\n                and tpi.attribute1 like concat('%', #{attribute1,jdbcType=VARCHAR}, '%')\n            </if>\n            <if test=\"tenantId != null and tenantId !=''\">\n                AND tpc.tenant_id = #{tenantId, jdbcType=BIGINT}\n            </if>\n            <if test=\"actualPayDateBegin != null\">\n                AND tpc.actual_pay_date &gt;= #{actualPayDateBegin, jdbcType=DATE}\n            </if>\n            <if test=\"actualPayDateEnd != null\">\n                AND tpc.actual_pay_date &lt;= #{actualPayDateEnd, jdbcType=DATE}\n            </if>\n            <if test=\"payPlanDate != null\">\n                and tpc.pay_plan_date = #{payPlanDate,jdbcType=DATE}\n            </if>\n            <if test=\"createDateBegin != null\">\n                AND tpc.create_date &gt;= #{createDateBegin, jdbcType=DATE}\n            </if>\n\n            <if test=\"createDateEnd != null\">\n                AND tpc.create_date &lt; date_add(#{createDateEnd}, interval 1 day)\n            </if>\n            <if test=\"sourceDetailId != null and sourceDetailId !=''\">\n                AND tpc.source_detail_id = #{sourceDetailId, jdbcType=BIGINT}\n            </if>\n            <if test=\"sourceSystem != null and sourceSystem != ''\">\n                and tpc.source_system = #{sourceSystem,jdbcType=VARCHAR}\n            </if>\n            <if test=\"bdDirectFlag != null and bdDirectFlag != ''\">\n                and tpc.bd_direct_flag = #{bdDirectFlag,jdbcType=VARCHAR}\n            </if>\n            <if test=\"payChecksAttribute12 != null and payChecksAttribute12 != ''\">\n                and tpc.attribute12 = #{payChecksAttribute12,jdbcType=VARCHAR}\n            </if>\n\n            <if test='paySplitFlag != null and 