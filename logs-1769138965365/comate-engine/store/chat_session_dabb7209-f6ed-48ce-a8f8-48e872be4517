etCMBAccountHistoryBalance(DateUtils.getYesterdayOfZero(),DateUtils.getYesterdayOfZero());\n            // 邮件提醒\n            this.balanceOldErrorAndMail(date, bankList, null);\n        } catch (Exception e) {\n            log.error(\"历史余额查询异常\", e);\n        } finally {\n            lck.releaseLock();\n        }\n    }\n\n    @Override\n    public void balanceNowErrorAndMail(Date beforeDate, List<String> bankList, String type) {\n        try {\n            // 正常 且 启用银企直连账户\n            List<TmsAccount> openAccount = accountService.getOpenAccountOFBank(null, type);\n            if (CollectionUtils.isEmpty(openAccount)) {\n                log.info(\"balanceNowErrorAndMail 没有状态为正常启动银企直联的银行账户\");\n                return;\n            }\n            if (CollectionUtils.isNotEmpty(bankList)) {\n                openAccount = openAccount.stream()\n                        .filter(t -> bankList.contains(t.getBank())).collect(Collectors.toList());\n                if (CollectionUtils.isEmpty(openAccount)) {\n                    log.info(\"balanceNowErrorAndMail 银行下没有状态为正常启动银企直联的银行账户\");\n                    return;\n                }\n            }\n\n            Map<Long, TmsAccount> accountMap = openAccount.stream()\n                    .collect(Collectors.toMap(TmsAccount::getAcAccountId, Function.identity(), (k1, k2) -> k1));\n            // 余额处理查询账户\n            List<Long> accountIds = openAccount.stream().map(TmsAccount::getAcAccountId).collect(Collectors.toList());\n            // 全部余额数据\n            TmsAccountBalanceCmbExample example = new TmsAccountBalanceCmbExample();\n            TmsAccountBalanceCmbExample.Criteria criteria = example.createCriteria();\n            criteria.andAcAccountIdIn(accountIds);\n            criteria.andBalanceDateEqualTo(DateUtils.getCurrentDateOfZero());\n            // 今日余额\n            List<TmsAccountBalanceCmb> nowBalanceList = tmsAccountBalanceCmbDAO.selectByExample(example);\n            if (CollectionUtils.isNotEmpty(nowBalanceList)