ty(openAccount)) {\n                    log.info(\"balanceNowErrorAndMail 银行下没有状态为正常启动银企直联的银行账户\");\n                    return;\n                }\n            }\n\n            // 余额处理查询账户\n            List<Long> accountIds = openAccount.stream().map(TmsAccount::getAcAccountId).collect(Collectors.toList());\n            // 全部余额数据\n            TmsAccountBalanceCmbExample example = new TmsAccountBalanceCmbExample();\n            TmsAccountBalanceCmbExample.Criteria criteria = example.createCriteria();\n            criteria.andAcAccountIdIn(accountIds);\n            criteria.andBalanceDateEqualTo(DateUtils.getCurrentDateOfZero());\n\n            // 昨日余额\n            TmsAccountBalanceCmbExample exampleOld = new TmsAccountBalanceCmbExample();\n            exampleOld.createCriteria().andBalanceDateEqualTo(DateUtils.getYesterdayOfZero()).andAcAccountIdIn(accountIds);\n            List<TmsAccountBalanceCmb> oldBalanceList = tmsAccountBalanceCmbDAO.selectByExample(exampleOld);\n            if (CollectionUtils.isNotEmpty(oldBalanceList)) {\n                String date = DateUtils.formatDate(oldBalanceList.get(0).getBalanceDate(), \"yyyy-MM-dd\");\n                // 拉取失败账户\n                List<String> accountNoList = oldBalanceList.stream()\n                        .filter(t -> t.getLastUpdateDate().before(beforeDate))\n                        .map(TmsAccountBalanceCmb::getAccountNo).collect(Collectors.toList());\n                if (CollectionUtils.isNotEmpty(accountNoList)) {\n                    String title = \"昨日存在账户余额拉取异常账户\";\n                    StringBuilder content = new StringBuilder();\n                    content.append(\"<br/><b>详细信息：</b><br/> 日期\");\n                    content.append(date);\n                    content.append(\" 如下账户余额拉取失败: \");\n                    for (String account : accountNoList) {\n                        content.append(\"<div>\");\n                        content.append(account);\n                        content.append(\"</div>\");\n                    }\n                    String sendTo = this.getEmailReceiver();\n                    msgSendServiceAPI.sendMessageHtml(title, content.toString(), sendTo);\n                }\n            }\n        } catch (Exception e) {\n            log.error(\"余额邮件发送异常 \", e);\n        }\n    }\n\n    /**\n     * 获取招行历日终余额 （调用 2.4 查询账户历史余额）\n     *\n     * @param start 开始日期  左闭区间\n     * @param end   结束日期     右开区间\n     */\n    @Override\n    public void getCMBAccountHistoryBalance(Date start, final Date end) {\n        // 查询有效账户列表\n        List<TmsAccount> accountList = accountService.getEffectiveAccoutOFBank(AccountConstans.ACCOUNT_BANK_CMB);\n        // 获取余额  保存余额\n        while (start.compareTo(end) <= 0) {\n            // 遍历账号 处理流水\n            for (int i = 0; i < accountList.size(); i++) {\n                try {\n                    saveCMBAccountBalance(getCBMAccountHistoryBalanceInterface(accountList.get(i), start));\n                } catch (Exception e) {\n                    log.error(e.getMessage(), e);\n                }\n            }\n            start = DateUtils.addDays(start, 1);\n        }\n\n    }\n\n    @Override\n    public void getBocAccountTodayBalance(Date date) {\n        // 国内账户余额\n        List<TmsAccount> accountList =\n                accountService.getOpenAccountOFBank(AccountConstans.ACCOUNT_BANK_BOC, AccountConstans.TMS_ACCT_TYPE_HOME);\n        List<TmsAccountBalanceCmb> balance =\n                bocAccountBalanceJobService.selectBocBalance(accountList, date, BocConstants.BalanceNow.trncod);\n        saveCMBAccountBalance(balance);\n\n        // 全球账户余额\n        List<TmsAccount> accountListAbroad =\n                accountService.getOpenAccountOFBank(AccountConstans.ACCOUNT_BANK_BOC, AccountConstans.TMS_ACCT_TYPE_ABROAD);\n        List<TmsAccountBalanceCmb> balanceAbroad =\n                bocAccountBalanceJobService.selectBocBalance(accountListAbroad, date, BocConstants.AbroadBalanceNow.trncod);\n        saveCMBAccountBalance(