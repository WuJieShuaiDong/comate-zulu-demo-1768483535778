         log.error(\"autovSynCitiCamt052 解析花期日间对账单发生异常\", e);\n        } finally {\n            lck.releaseLock();\n        }\n    }\n\n    @Override\n    public Boolean handleCitiTransacitons(List<CitiTransactionDTO> writeBackDTOS) {\n        Boolean handleFlag = Boolean.TRUE;\n        if (CollectionUtils.isEmpty(writeBackDTOS)) {\n            return handleFlag;\n        }\n        // 1.对list进行遍历获取流水\n        List<TmsTransactionsCmb> transList = Lists.newArrayList();\n\n        Date curDate = new Date();\n        for (CitiTransactionDTO dto : writeBackDTOS) {\n            try {\n                TmsTransactionsCmb cmbTrx = new TmsTransactionsCmb();\n                cmbTrx.setAcctNum(dto.getAccountNumber());\n                cmbTrx.setCurrencyType(dto.getEntryCurrency());\n                String etydat = dto.getBookingDate().replace(\"-\", \"\");\n                cmbTrx.setEtydat(etydat);\n                cmbTrx.setVltdat(etydat);\n                String timeStr = StringUtils.isNotBlank(dto.getMsgCreateDate()) ?\n                        dto.getMsgCreateDate().substring(11, 19).replace(\":\", \"\") : \"100000\";\n                cmbTrx.setEtytim(timeStr);\n                cmbTrx.setTrscod(dto.getBankTransactionCode());\n\n                String naryur = dto.getRemittanceInfo();\n                if (StringUtils.isNotBlank(naryur)) {\n                    naryur = naryur.length() > 200 ? naryur.substring(0, 199) : naryur;\n                }\n                cmbTrx.setNaryur(naryur);\n\n                if (\"C\".equals(dto.getEntryCreditDebitIndicator())) {\n                    cmbTrx.setTrsamtc(dto.getEntryAmount());\n                    cmbTrx.setTrsamt(dto.getEntryAmount());\n                } else {\n                    cmbTrx.setTrsamtd(dto.getEntryAmount());\n                    cmbTrx.setTrsamt(dto.getEntryAmount().negate());\n                }\n\n                cmbTrx.setAmtcdr(dto.getEntryCreditDebitIndicator());\n                cmbTrx.setRefnbr(dto.getTransactionSvcReference());\n                cmbTrx.setYurref(dto.getTransactionEndToEndId());\n                cmbTrx.setBusnar(dto.getBankTransactionName());\n                cmbTrx.setRpynam(dto.getPartyName());\n                cmbTrx.setRpyacc(dto.getPartyAccount());\n                cmbTrx.setRpybnk(dto.getPartyBankName());\n                cmbTrx.setBankCode(B041);\n\n                cmbTrx.setCreationDate(curDate);\n                cmbTrx.setLastUpdateDate(curDate);\n                cmbTrx.setCreatedBy(SYS_AUTO);\n                cmbTrx.setLastUpdatedBy(SYS_AUTO);\n\n                // 花期账单不是主动指定日期，而是被动接收，所以日期范围不确定，暂时直接查数据库\n                TmsTransactionsCmbExample cmbTrxExample = new TmsTransactionsCmbExample();\n                TmsTransactionsCmbExample.Criteria validateCriteria = cmbTrxExample.createCriteria();\n                validateCriteria.andAcctNumEqualTo(cmbTrx.getAcctNum());\n                validateCriteria.andEtydatEqualTo(cmbTrx.getEtydat());\n                validateCriteria.andRefnbrEqualTo(cmbTrx.getRefnbr());\n                if (tmsTransactionsCmbDAO.countByExample(cmbTrxExample) == 0) {\n                    transList.add(cmbTrx);\n                } else {\n                    log.info(\"解析到花旗流水已存在,AcctNum:{},Etydat:{},Refnbr:{}\",\n                            cmbTrx.getAcctNum(), cmbTrx.getEtydat(), cmbTrx.getRefnbr());\n                }\n            } catch (Exception e) {\n                log.info(\"handleCitiTransacitons:{}\", ExceptionUtils.getStackTrace(e));\n                handleFlag = Boolean.FALSE;\n            }\n        }\n\n        if (CollectionUtils.isNotEmpty(transList)) {\n            tmsTransactionsCmbDAO.insertList(transList);\n            log.info(\"插入花旗流水数据:{}条\", transList.size());\n        }\n        return handleFlag;\n    }\n\n}\n",
