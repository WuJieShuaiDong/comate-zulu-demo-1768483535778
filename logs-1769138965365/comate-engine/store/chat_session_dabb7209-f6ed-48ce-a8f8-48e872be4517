private String erpDnloadPath; // 文件下载后存放的本地目录\n    private int gatePort = 22; // 文件网关服务器SFTP端口\n    private String gateUserName; // 文件网关服务器SFTP用户名\n    private String gateUserPassword; // 文件网关服务器SFTP用户密码\n    // 文档网关服务器相关对象\n    private SftpController sftp;\n    private int sftpTimeOut = 5000; // 连接网关服务器时的超时时间 单位：毫秒\n    private String gateHost; // 网关服务器的IP地址或HOST\n    // private int gatePort = 2223; // 测试服务器SFTP端口\n    // private String gateUserName = \"test\"; // 测试SFTP用户名\n    // private String gateUserPassword = \"test\"; // 测试用户密码\n    // 待解析处理的对账单文件列表\n    private String[] stmtFiles;\n    private int reqStatus;\n    private String reqMessage;\n\n\n    @Autowired\n    private CitiTransactionsService citiTransactionsService;\n\n    @Autowired\n    private MsgSendServiceAPI msgSendServiceAPI;\n\n    @Value(\"${tms.ce.common.mailReceiver}\")\n    private String commonMailReceivers;\n\n    public CitiAnalyzeStmt() {\n\n    }\n\n    /**\n     * 日间、日终对账单处理\n     * @param errorMsg\n     * @param isDaytime 是否是日间对账单\n     * @return\n     */\n    public List<Map<String, String>> runProgram(StringBuilder errorMsg, Boolean isDaytime) {\n        log.info(\"================程序开始================\");\n        setReqStatus(NORMAL, \"\");\n\n        // 准备一个要返回的list。list中每个元素都是一个map，map中存放一个账户的余额。\n        List<Map<String, String>> balanceList = null;\n\n        // 1.获取路径等相关参数和设置\n        if (reqStatus != ERROR) {\n            try {\n                log.info(\"1.获取路径等相关参数和设置\");\n                // 配置信息修改为从配置文件读取\n                getFileConfigInfo();\n                log.info(\"\\t成功获取配置信息\");\n            } catch (XepiException xe) {\n                setReqStatus(ERROR, \"获取配置信息失败，\" + xe.getErrorMsg());\n            } catch (Exception e) {\n                log.info(\"获取配置信息时发生未知错误:{}\", ExceptionUtils.getStackTrace(e));\n                setReqStatus(ERROR, \"获取配置信息时发生未知错误：\" + e.getMessage());\n            }\n        }\n\n        // 2.校验对账单文件的路径是否正确，若失败则将并发请求状态置为错误\n        // 校验完成后会自动去掉结尾的路径分隔符\n        if (reqStatus != ERROR) {\n            try {\n                log.info(\"2.校验本地文件路径是否正确\");\n                log.info(\"\\tERP端文件下载路径：\" + erpDnloadPath);\n                validateLocalPath();\n                log.info(\"\\t校验成功\");\n            } catch (XepiException xe) {\n                setReqStatus(ERROR, \"ERP文件路径校验失败，\" + xe.getErrorMsg());\n            } catch (Exception e) {\n                log.info(\"ERP文件路径校验时发生未知错误:{}\", ExceptionUtils.getStackTrace(e));\n                setReqStatus(ERROR, \"ERP文件路径校验时发生未知错误：\" + e.getMessage());\n            }\n        }\n        // 3.建立从ERP到文件网关服务器的SFTP连接，若无法连接则并将请求置为错误，记录错误信息到日志中\n        if (reqStatus != ERROR) {\n            try {\n                log.info(\"3.连接文档网关服务器\");\n                log.info(\"\\t文件网关服务器地址：\" + gateHost);\n                sftp = new SftpController();\n                sftp.createSession(gateHost, gateUserName, gateUserPassword, gatePort, sftpTimeOut);\n                log.info(\"\\t成功建立连接\");\n            } catch (JSchException je) {\n                setReqStatus(ERROR, \"连接文件网关服务器失败，\" + je.getMessage());\n            } catch (Exception e) {\n                log.info(\"连接文件网关服务器时发生未知错误:{}\", ExceptionUtils.getStackTrace(e));\n                setReqStatus(ERROR, \"连接文件网关服务器时发生未知错误：\" + e.getMessage());\n            }\n        }\n\n        // 4.若成功建立SFTP连接，则校验网关服务器的路径是否正确，若失败则将并发请求状态置为错误\n        // 校验完成后会自动去掉结尾的路径分隔符\n        if (reqStatus != ERROR) {\n            try {\n                log.info(\"4.校验网关服务器文件路径是否正确\");\n                log.info(\"\\t网关服务器下载路径：\" + gateDnloadPath);\n                log.info(\"\\t网关服务器下载完成路径：\" + gateDnDumpPath);\n                validateRemotePath();\n                log.info(\"\\t校验成功\");\n            } catch (XepiException xe) {\n                setReqStatus(ERROR, \"文件网关服务器路径校验失败，\" + xe.getMessage());\n            } catch (Exception e) {\n                log.info(\"文件网关服务器路径校验时发生未知错误:{}\", ExceptionUtils.getStackTrace(e));\n                setReqStatus(ERROR, \"文件网关服务器路径校验时发生未知错误：\" + e.getMessage());\n            }\n        }\n        // 5.从网关服务器下载对账单文件至ERP服务器\n        if (reqStatus != ERROR) {\n            try {\n                log.info(\"5.从网关服务器下载对账单文件\");\n                getStmtFromGate(isDaytime);\n            } catch (XepiException xe) {\n                setReqStatus(ERROR, \"下载对账单文件失败，\" + xe.getMessage());\n            } catch (Exception e) {\n                log.info(\"下载对账单文件时发生未知错误:{}\", ExceptionUtils.getStackTrace(e));\n                setReqStatus(ERROR, \"下载对账单文件时发生未知错误：\" + e.getMessage());\n            }\n        }\n        // 6.关闭SFTP连接，避免后续处理耗时导致异常（至此位置，下载文件已完成，后续无需使用SFTP连接）\n        if (reqStatus != ERROR) {\n            if (sftp != null) {\n                try {\n                    log.info(\"6.关闭SFTP连接\");\n                    sftp.closeSession();\n                    log.info(\"\\t关闭成功\");\n                } catch (Exception e) {\n                    log.info(\"关闭SFTP连接时发生未知错误:{}\", ExceptionUtils.getStackTrace(e));\n                    setReqStatus(WARNING, \"关闭SFTP连接时发生未知错误：\" + e.getMessage());\n                }\n            }\n        }\n        // 7.处理从网关服务器下载下来的对账单文件\n        // 若下载目录下存在之前未处理的文件，一并处理之\n        if (reqStatus != ERROR) {\n            try {\n                log.info(\"7.处理对账单文件\");\n                balanceList = processStmtFile(isDaytime);\n            } catch (XepiException xe) {\n                setReqStatus(ERROR, \"处理对账单文件失败，\" + xe.getMessage());\n            } catch (Exception e) {\n                log.info(\"处理对账单文件时发生未知错误:{}\", ExceptionUtils.getStackTrace(e));\n                setReqStatus(ERROR, \"处理对账单文件时发生未知错误:\" + e.getMessage());\n            }\n        }\n\n        if (reqStatus == ERROR) {\n            msgSendServiceAPI.sendMessage(\"TMS处理花旗对账单异常提醒\", reqMessage, commonMailReceivers);\n        }\n\n        // 9.程序结束，设置请求返回状态和消息\n        log.info(\"================程序结束================\");\n        errorMsg.append(reqMessage);\n        return balanceList;\n    }\n\n    /**\n     * 获取基础配置信息.\n     * <p>\n     * 从 configFile 指定的配置文件中读取设置信息\n     * </p>\n     *\n     * @return 无\n     *\n     * @throws XepiException 校验失败或者发生未知异常时抛出\n     */\n    private void getFileConfigInfo() throws XepiException {\n\n        String gateUserNameEncrypt = null;\n        String gateUserPassEncrypt = null;\n        try {\n            log.info(\"\\t开始读取配置信息\");\n            gateDnloadPath = Config.get(\"CITI_GATE_DNLOAD_PATH\");\n            gateDnDumpPath = Config.get(\"CITI_GATE_DNDUMP_PATH\");\n            erpDnloadPath = Config.get(\"TMS_DNLOAD_PATH\");\n            String timeout = Config.get(\"SFTP_TIMEOUT\");\n            if (timeout == null) {\n                sftpTimeOut = 5000;\n            } else {\n                sftpTimeOut = Integer.valueOf(timeout);\n            }\n            gateHost = Config.get(\"CITI_GATE_HOST\");\n            String port = Config.get(\"CITI_GATE_PORT\");\n            if (port == null) {\n                gatePort = 22;\n            } else {\n                gatePort = Integer.valueOf(gatePort);\n            }\n            gateUserNameEncrypt = Config.get(\"CITI_GATE_USER_NAME\");\n            gateUserPassEncrypt = Config.get(\"CITI_GATE_USER_PASSWORD\");\n        } catch (Exception e) {\n            log.info(e.getMessage());\n            throw new XepiException(\"读取配置信息发生错误，请查看日志\" + e.getMessage());\n        }\n        try {\n            gateUserName = Passwords.comingIn(gateUserNameEncrypt);\n            gateUserPassword = Passwords.comingIn(gateUserPassEncrypt);\n            // logger.info(\"gateUserNameEncrypt:\" + gateUserNameEncrypt + \" gateUserName:\" + gateUserName);\n        } catch (Exception e) {\n            log.info(e.getMessage());\n            log.info(\"gateUserNameEncrypt:\" + gateUserNameEncrypt + \" gateUserName:\" + gateUserName);\n            throw new XepiException(\"解密网关服务器用户名和密码出错\" + e.getMessage());\n        }\n    }\n\n    /**\n     * 校验ERP本地端文件存储路径是否正常.\n     *\n     * @return 无\n     *\n     * @throws XepiException 校验失败或者发生未知异常时抛出\n     */\n    private void validateLocalPath() throws XepiException {\n        File filePath;\n        if (erpDnloadPath != null) {\n            filePath = new File(erpDnloadPath);\n            if (!filePath.exists() || !filePath.isDirectory()) {\n                throw new XepiException(\"TMS端对账单文件下载路径必须为已存在的目录\");\n            }\n            // 去掉路径结尾的路径分隔符\n            if (erpDnloadPath.endsWith(SEPARATOR)) {\n                erpDnloadPath = erpDnloadPath.substring(0, erpDnloadPath.length() - 1);\n            }\n        } else {\n            throw new XepiException(\"必须指定TMS端对账单文件下载路径\");\n        }\n    }\n\n    /**\n     * 校验网关服务器端文件存储路径是否正常.\n     *\n     * @return 无\n     *\n     * @throws XepiException 校验失败或者发生未知异常时抛出\n     */\n    private void validateRemotePath() throws XepiException {\n        String[] list;\n        // 网关服务器 DOWNLOAD 目录\n        if (gateDnloadPath != null) {\n            try {\n                list = sftp.ls(gateDnloadPath);\n            } catch (Exception e) {\n                throw new XepiException(\"文件网关服务器文件下载路径访问错误，请检查设置\");\n            }\n            // 去掉路径结尾的路径分隔符\n            if (gateDnloadPath.endsWith(SEPARATOR)) {\n                gateDnloadPath = gateDnloadPath.substring(0, gateDnloadPath.length() - 1);\n            }\n        } else {\n            throw new XepiException(\"必须指定文件网关服务器指令文件下载路径\");\n        }\n        // 网关服务器 DOWNLOAD DUMP 目录\n        if (gateDnDumpPath != null) {\n            try {\n                list = sftp.ls(gateDnDumpPath);\n            } catch (Exception e) {\n                throw new XepiException(\"文件网关服务器文件下载转移路径访问错误，请检查设置\");\n            }\n            // 去掉路径结尾的路径分隔符\n            if (gateDnDumpPath.endsWith(SEPARATOR)) {\n                gateDnDumpPath = gateDnDumpPath.substring(0, gateDnDumpPath.length() - 1);\n            }\n        } else {\n            throw new XepiException(\"必须指定文件网关服务器指令文件下载转移路径\");\n        }\n    }\n\n    /**\n     * 从网关服务器下载对账单文件.\n     *\n     * @return 无\n     *\n     * @throws XepiException 校验失败或者发生未知异常时抛出\n     */\n    private void getStmtFromGate(Boolean isDaytime) throws XepiException {\n        String[] files;\n        try {\n            log.info(\"\\t获取网关服务器目录文件列表.....\");\n            files = sftp.ls(gateDnloadPath);\n        } catch (Exception e) {\n            log.info(\"获取网关服务器目录文件列表时出现错误：\" + e.getMessage());\n            throw new XepiException(\"获取网关服务器目录文件列表时错误，请查看日志获取详细信息\");\n        }\n        if (files != null) {\n            if (files.length > 0) {\n                log.info(\"\\t开始下载文件.....\");\n                log.info(\"\\t\\t\" + rpad(\"对账单文件名\", fileNameLength - 7, \" \"));\n                log.info(\"\\t\" + rpad(\"下载结果\", resultLength - 4, \" \"));\n                log.info(\"\\t\" + rpad(\"移动结果\", resultLength - 4, \" \"));\n                int successCount = 0;\n                int errorCount = 0;\n                int warningCount = 0;\n                String source;\n                String destination;\n                String dumpDest;\n                int getStatus = 0; // 0 表示成功， 1 表示失败\n                for (int i = 0; i < files.length; i++) {\n                    if (files[i] != null) {\n                        source = gateDnloadPath + SEPARATOR + files[i]; // Tips\n                        // 网关服务器的分隔符可能跟本地不一致\n                        destination = erpDnloadPath + SEPARATOR + files[i];\n                        dumpDest = gateDnDumpPath + SEPARATOR + files[i];\n                        getStatus = 0;\n                        // 只抓取文件名为指定前缀的指令文件\n                        if (files[i].startsWith(eodFilePrefix) || (isDaytime && files[i].startsWith(itdFilePrefix))) {\n                            // 从文件网关服务器下载对账单文件\n                            if (getStatus == 0) {\n                                try {\n                                    log.info(\"\\t\\t\" + rpad(files[i], fileNameLength, \" \"));\n                                    sftp.get(source, destination);\n                                    log.info(\"\\t\" + rpad(\"成功\", resultLength - 2, \" \"));\n                                } catch (Exception e) {\n                                    errorCount += 1;\n                                    getStatus = 1;\n                                    log.info(\"\\t\" + rpad(\"失败\", resultLength - 2, \" \"));\n                                    log.info(\"文件 \" + source + \" 下载失败：\" + e.getMessage());\n                                    setReqStatus(WARNING, \"存在从网关服务器下载失败的文件，\" + e.getMessage());\n                                }\n                            }\n                            // 下载成功后，将网关服务器的文件移动到指定目录\n                            if (getStatus == 0) {\n                                try {\n                                    log.info(\n                                            \"\\t\" + rpad(\"开始移动：\" + source + \"->\" + dumpDest, resultLength - 2, \" \"));\n                                    sftp.mv(source, dumpDest);\n                                    successCount += 1;\n                                    log.info(\"\\t\" + rpad(\"移动成功\", resultLength - 2, \" \"));\n                                } catch (Exception e) {\n                                    warningCount += 1;\n                                    log.info(\"文件 \" + source + \" 移动失败：\" + e.getMessage());\n                                    setReqStatus(WARNING,\n                                            \"存在在网关服务器转移失败的文件，\" + \"文件 \" + source + \" 移动失败：\" + e.getMessage());\n                                }\n                            }\n                        }\n                    }\n                }\n                log.info(\"\\t累计 成功 \" + String.valueOf(successCount) + \" 警告（仅移动失败） \"\n                        + String.valueOf(warningCount) + \" 失败 \" + String.valueOf(errorCount));\n                log.info(\"\\t结束下载文件.....\");\n            }\n        }\n    }\n\n    /**\n     * 处理本地目录中下载完成的对账单文件.\n     * <p>\n     * 处理步骤：<br>\n     * 1.先处理日间对账单文件<br>\n     * a)解密文件，在同一目录下生成后缀为 .decrypt 的同名文件<br>\n     * b)解析解密后的文件，读取XML数据<br>\n     * c)将读取的数据传给返写接口，处理并返写至数据库<br>\n     * d)删除原文件和解密后的文件<br>\n     * 2.按照步骤1的顺序再处理日终对账单文件<br>\n     * 以上任何步骤处理时若发生错误或校验失败，则将出错的文件保留在原目录下，不做任何处理，并在请求输出中体现，提醒相关人员。\n     * </p>\n     *\n     * @param isDaytime 是否是日间对账单\n     *\n     * @return 无\n     *\n     * @throws XepiException 校验失败或者发生未知异常时抛出\n     */\n    private List<Map<String, String>> processStmtFile(Boolean isDaytime) throws XepiException {\n        log.info(\"---打印安全组件顺序---\");\n        try {\n            for (int i = 0; i < Security.getProviders().length; i++) {\n                Provider p = Security.getProviders()[i];\n                log.info(\"打印安全组件顺序:[\" + (i + 1) + \"] \" + p.getName() + \" - \" + p.getClass().getName());\n            }\n        } catch (Exception e) {\n            log.info(\"获取安全组件顺序时发生错误：\" + e.getMessage());\n        }\n        // 准备好要返回的数据\n        List<Map<String, String>> balanceList = new ArrayList<>();\n        // 若在下载文件时，未初始化该数组，则将下载目录下的所有文件全部处理\n        log.info(\"\\t获取本地下载目录下的文件列表.....\");\n        try {\n            stmtFiles = sftp.lls(erpDnloadPath);\n            log.info(\"获取本地文件列表:{}\", JSON.toJSONString(stmtFiles));\n        } catch (Exception e) {\n            log.info(\"获取本地下载目录下的文件列表时发生错误：\" + e.getMessage());\n            throw new XepiException(\"获取本地下载目录下的文件列表时错误，请查看日志获取更多信息\");\n        }\n        if (stmtFiles != null) {\n            if (stmtFiles.length > 0) {\n                log.info(\"\\t开始处理文件.....\");\n                log.info(\"\\t\\t\" + rpad(\"文件名\", fileNameLength - 3, \" \"));\n                log.info(\"\\t\" + rpad(\"解密结果\", resultLength - 4, \" \"));\n                log.info(\"\\t\" + rpad(\"解析结果\", resultLength - 4, \" \"));\n                log.info(\"\\t\" + rpad(\"返写结果\", resultLength - 4, \" \"));\n                log.info(\"\\t\" + rpad(\"删除结果\", resultLength - 4, \" \"));\n\n                String encryptFile;\n                String decryptFile;\n                int processStatus = 0;\n                AckParser parser = new AckParser();\n                String[] prefixList = {eodFilePrefix};\n                if (isDaytime) {\n                    // TODO 暂时保留日间+日终，上线需要删除日终，日间和日终任务分别执行\n                    prefixList = new String[] {itdFilePrefix};\n                }\n                int successCount = 0;\n                int warningCount = 0;\n                int errorCount = 0;\n\n                for (String prefix : prefixList) {\n                    // 先处理日间对账单\n                    // 再处理日终对账单\n                    for (int i = 0; i < stmtFiles.length; i++) {\n                        // TODO 1.为了测试花旗对账单，注掉此行，测试完成需要修改回来 if (stmtFiles[i] != null) {\n                         if (stmtFiles[i] != null && !stmtFiles[i].endsWith(decryptSurfix)) {\n                            if (stmtFiles[i].startsWith(prefix)) {\n\n                                encryptFile = erpDnloadPath + SEPARATOR + stmtFiles[i];\n                                // TODO 2.为了测试花旗对账单，注掉此行，测试完成需要修改回来 decryptFile = encryptFile;\n                                decryptFile = encryptFile + decryptSurfix;\n                                processStatus = 0;\n                                log.info(\"开始处理文件，原始加密文件:{}\", encryptFile);\n\n                                // 解密文件\n                                // TODO 3.为了测试花旗对账单，注掉此行，测试完成需要修改回来（下面if）\n                                if (processStatus == 0) {\n                                    try {\n                                        log.info(\"开始解密文件...\");\n                                        try {\n                                            Security.removeProvider(\"BC\");\n                                        }catch (Exception e) {\n                                            log.error(\"移除BC安全组件失败:{}\" , e.getMessage());\n                                        }\n                                        // Security.addProvider(new BouncyCastleProvider());\n                                        Security.insertProviderAt(new BouncyCastleProvider(), 1);\n                                        // 解密文件\n                                        BasedLargeFileProcessor.decryptAndVerifyCiti(encryptFile, decryptFile);\n                                        log.info(\"解密成功,文件名:{},文件大小:{}\", decryptFile, decryptFile.length());\n                                    } catch (Exception e) {\n                                        errorCount += 1;\n                                        processStatus = 1;\n                                        log.info(\"解密文件异常:{}\", ExceptionUtils.getStackTrace(e));\n                                        setReqStatus(WARNING,\n                                                \"存在解密失败的反馈文件，\" + \"文件 \" + encryptFile + \" 解密失败：\" + e.getMessage());\n                                    }\n                                }\n\n                                // 解析文件\n                                if (processStatus == 0) {\n                                    try {\n                                         if (prefix.equals(itdFilePrefix)) {\n                                             parser.parseItdStmtFile(decryptFile);\n                                         } else if (prefix.equals(eodFilePrefix)) {\n                                             parser.parseEodStmtFile(decryptFile);\n                                         }\n                                        log.info(\"解析文件成功\");\n                                    } catch (Exception e) {\n                                        errorCount += 1;\n                                        processStatus = 1;\n                                        log.info(\"解析文件失败，错误堆栈：{}\", ExceptionUtils.getStackTrace(e));\n                                        setReqStatus(WARNING,\n                                                \"存在解析失败的反馈文件，\" + \"文件 \" + decryptFile + \" 解析失败：\" + e.getMessage());\n                                    }\n                                }\n\n                                // 调用API，处理接收到的数据\n                                if (processStatus == 0) {\n                                    List<CitiTransactionDTO> writeBackDTOS = Lists.newArrayList();\n                                    List<CitiTransactionDTO> balanceDTOS = Lists.newArrayList();\n\n                                    // 处理日间对账单\n                                     if (prefix.equals(itdFilePrefix)) {\n                                         writeBackDTOS = parser.getItdStmtWriteBackMap();\n                                     }\n\n                                    // 处理日终对账单\n                                    if (prefix.equals(eodFilePrefix)) {\n                                        writeBackDTOS = parser.getEodStmtWriteBackMap(balanceDTOS);\n                                    }\n\n                                    // 增加一步处理花旗交易流水号数据\n                                    log.info(\"解析到花旗流水数据:{}\", JSON.toJSONString(writeBackDTOS));\n                                    if (CollectionUtils.isNotEmpty(writeBackDTOS)) {\n                                        citiTransactionsService.handleCitiTransacitons(writeBackDTOS);\n                                    }\n\n                                    if (!isDaytime && CollectionUtils.isNotEmpty(balanceDTOS)) {\n                                        for (CitiTransactionDTO dto : balanceDTOS) {\n                                            log.info(\"------------->账单账户\");\n                                            String accountNo = dto.getAccountNumber();\n                                            String currency = dto.getCLBDCurrency();\n                                            String balanceDate = dto.getCLBDBalanceDate();\n                                            String onlineBalance = dto.getCLBDAmount();\n\n                                            log.info(\"accountNo :\" + accou