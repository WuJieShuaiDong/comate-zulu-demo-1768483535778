                "content": "package com.baidu.pmc.web.interceptor.config;\n\nimport com.baidu.pmc.common.component.PmcPortalLogin;\nimport com.baidu.pmc.web.utils.AesUtil;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.lang3.StringUtils;\nimport org.springframework.beans.factory.annotation.Value;\nimport org.springframework.stereotype.Component;\nimport org.springframework.web.servlet.handler.HandlerInterceptorAdapter;\n\nimport javax.servlet.http.HttpServletRequest;\nimport javax.servlet.http.HttpServletResponse;\n\n/**\n * @author liumandong\n */\n@Component\n@Slf4j\npublic class PmcPortalAuthInterceptor extends HandlerInterceptorAdapter {\n\n    /**\n     * 密钥（从配置中心获取）\n     */\n    @Value(\"${pmc.portal.aes.key}\")\n    private String aesKey;\n\n    private static final String SUP_PORTAL_HEAD_AUTH = \"SupAuth\";\n\n    @Override\n    public boolean preHandle(HttpServletRequest request, HttpServletResponse response, Object handler) throws Exception {\n        // ===== 1. AES解密鉴权 =====\n        // 从请求头获取加密的鉴权信息（客户端需在SupAuth头传递加密串）\n        String supAuth = request.getHeader(SUP_PORTAL_HEAD_AUTH);\n        if (supAuth == null || supAuth.isEmpty()) {\n            response.sendError(HttpServletResponse.SC_UNAUTHORIZED, \"缺少鉴权信息\");\n            return false;\n        }\n\n        String decryptedAuth;\n        try {\n            decryptedAuth = AesUtil.decrypt(supAuth, aesKey);\n        } catch (Exception e) {\n            log.error(\"doSupPortalAuthenticate exception\", e);\n            response.sendError(HttpServletResponse.SC_UNAUTHORIZED, \"鉴权信息解密失败\");\n            return false;\n        }\n        // 解密后不乱码有中文数字字母则通过鉴权通过\n        if (StringUtils.isBlank(decryptedAuth)) {\n            log.error(\"doSupPortalAuthenticate supInfo is null\");\n            response.sendError(HttpServletResponse.SC_UNAUTHORIZED, \"鉴权信息解密为空\");\n            return false;\n        }\n\n        // 解析解密字符串，形式为SupAuth=供应商ID_登录账号,下划线拆分\n        String[] parts = decryptedAuth.split(\"_\");\n        if (parts.length < 2) {\n            log.error(\"doSupPortalAuthenticate supInfo is invalid\");\n            response.sendError(HttpServletResponse.SC_UNAUTHORIZED, \"鉴权信息非法\");\n            return false;\n        }\n\n        String supId = parts[0];\n        if (supId == null || supId.isEmpty()) {\n            log.error(\"doSupPortalAuthenticate supId is null\");\n            response.sendError(HttpServletResponse.SC_UNAUTHORIZED, \"鉴权信息缺失\");\n            return false;\n        }\n\n        String loginAccount = parts[1];\n        if (loginAccount == null || loginAccount.isEmpty()) {\n            log.error(\"doSupPortalAuthenticate loginAccount is null\");\n            response.sendError(HttpServletResponse.SC_UNAUTHORIZED, \"鉴权信息缺失\");\n            return false;\n        }\n\n        // ===== 3. 存入ThreadLocal =====\n        PmcPortalLogin.LoginInfo loginInfo = new PmcPortalLogin.LoginInfo();\n        loginInfo.setSupId(supId);\n        loginInfo.setLoginAccount(loginAccount);\n        PmcPortalLogin.setLoginInfo(loginInfo);\n\n        return true;\n    }\n\n    @Override\n    public void afterCompletion(HttpServletRequest request, HttpServletResponse response, Object handler, Exception ex) {\n        // 清理ThreadLocal, 防止内存泄漏\n        PmcPortalLogin.clear();\n    }\n}",
