                "basename": "BcmBankStrategy.java",
                "originalContent": "package com.baidu.pmc.bankcommon.core.service.strategy;\n\nimport com.baidu.pmc.bankcommon.core.constants.Constants;\nimport com.baidu.pmc.bankcommon.core.service.AccountService;\nimport com.baidu.pmc.bankcommon.core.service.BankStrategy;\nimport com.baidu.pmc.bankcommon.core.service.BankcommonReceiptService;\nimport com.baidu.pmc.bankcommon.core.service.BankcommonService;\nimport com.baidu.pmc.bankcommon.core.service.MachineService;\nimport com.baidu.pmc.bankcommon.core.service.impl.SendMailService;\nimport com.baidu.pmc.bankcommon.core.utils.NodeDistributeUtil;\nimport com.baidu.pmc.bankcommon.core.utils.OkHttpUtils;\nimport com.baidu.pmc.bankcommon.core.utils.StringCompressor;\nimport com.baidu.pmc.bankcommon.persistence.dao.PmcPayCommonBankSetMapper;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.pojo.dto.PayChecksDTO;\nimport com.baidu.pmc.pojo.dto.cmb.BalanceInfo;\nimport com.baidu.pmc.pojo.dto.cmb.PayInstructDTO;\nimport com.baidu.pmc.pojo.dto.cmb.PmcCmbMachineDTO;\nimport com.baidu.pmc.pojo.dto.cmb.TmsAccountBalanceCmb;\nimport com.baidu.pmc.pojo.dto.cmb.TransInfo;\nimport com.baidu.pmc.pojo.model.PmcAccount;\nimport com.baidu.pmc.pojo.model.PmcPayChecks;\nimport com.baidu.pmc.pojo.model.PmcPayCommonBankSet;\nimport com.baidu.pmc.pojo.model.cmb.PayQO;\nimport com.baidu.pmc.pojo.model.cmb.PmcCmbMachine;\nimport com.baidu.pmc.pojo.qo.BankcommonBalanceOldQO;\nimport com.baidu.pmc.pojo.qo.cmb.PayInstructQO;\nimport com.github.pagehelper.Page;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections.CollectionUtils;\n\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\nimport tk.mybatis.mapper.entity.Example;\nimport java.math.BigDecimal;\nimport java.util.ArrayList;\nimport java.util.Date;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.UUID;\nimport java.util.function.Function;\nimport java.util.stream.Collectors;\n\n@Slf4j\n@Service\npublic class BcmBankStrategy implements BankStrategy {\n\n    @Autowired\n    private CommonBankStrategy commonBankStrategy;\n\n    @Autowired\n    private BankcommonService bankcommonService;\n\n    @Autowired\n    private BankcommonReceiptService bankcommonReceiptService;\n\n    @Autowired\n    private MachineService machineService;\n\n    @Autowired\n    private SendMailService mailService;\n\n    @Autowired\n    private PmcPayCommonBankSetMapper pmcPayCommonBankSetMapper;\n\n    @Autowired\n    private AccountService accountService;\n\n    @Override\n    public String getBankStrategy() {\n        return Constants.BankStrategyCode.BCM;    // 单独扩展的策略需要一个单独的策略code\n    }\n\n    @Override\n    public Page<PayInstructDTO> getPayInstructList(PayInstructQO qo) {\n        // 需要复用通用逻辑时，使用组合的方式调用\n        return commonBankStrategy.getPayInstructList(qo);\n    }\n\n    @Override\n    public Integer genBankUnUrgentPay(String bankCode) {\n        return commonBankStrategy.genBankUnUrgentPay(bankCode);\n    }\n\n    @Override\n    public List<TransInfo> selectBankTrans(PayQO qo) {\n        Map<String, String> extentionParams = new HashMap<>();\n        // 根据 startDate和 endDate 和当前日期判断传的日期标识为 0-当日及昨日交易明细查询  1-昨日以前历史明细查询\n\n\n\n\n        extentionParams.put(\"\", \"1\");\n        List<TransInfo> transInfos = bankcommonService.selectBankcommonTrans(qo, extentionParams);\n        transInfos.forEach(transInfo -> {\n            String referenceNumber = transInfo.getReferenceNumber();\n            // 把原先的电子凭证号写入业务摘要，供后续电子回单和流水使用\n            try {\n                String elecChequeNo = referenceNumber;\n                transInfo.setBusinessNaryur(elecChequeNo);\n            } catch (Exception e) {\n                // 存在非PMC单子，转换失败，直接返回原凭证号\n                log.error(\"电子凭证号转业务参考号失败\", e);\n            }\n\n        });\n        return transInfos;\n    }\n\n    @Override\n    public List<BalanceInfo> selectBankBalance(PayQO qo) {\n        List<BalanceInfo> balanceInfos = bankcommonService.selectBankcommonBalance(qo, null);\n        try {\n            balanceInfos.forEach(balanceInfo -> {\n                PayQO payQO = new PayQO();\n                payQO.setBank(qo.getBank());\n                payQO.setAccount(balanceInfo.getAccount());\n                PmcAccount pmcAccount = accountService.queryBankcommonAccountByAccountNo(payQO);\n                balanceInfo.setAnnotation(pmcAccount.getAccountName());\n                // 针对特殊银行特殊处理,例如交通银行是拼接格式\n                // <serial_record>\n                // 户名|账号|币种|余额|可用余额|开户日期|账户类型|开户行|错误信息|成功标志|\n                // XXX公司|310066661010121088868|CNY|85317882.08|85317882.08|19951117|1|310999||0|\n                // </serial_record>\n                // 获取余额字段对应的值,则需要对拼接格式进行拆分,获取第14个字段\n                String serialRecord = balanceInfo.getSerialRecord();\n                parseAvailableBalanceFromSerialRecord(balanceInfo, serialRecord);\n            });\n        }catch (Exception e){\n            log.error(\"查询银行余额时，获取账户名称失败\", e);\n        }\n        return balanceInfos;\n    }\n\n    /**\n     * 从银行序列记录中解析可用余额\n     * <serial_record>\n     * 户名|账号|币种|余额|可用余额|开户日期|账户类型|开户行|错误信息|成功标志|\n     * XXX公司|310066661010121088868|CNY|85317882.08|85317882.08|19951117|1|310999||0|\n     * </serial_record>\n     * 获取余额字段对应的值,则需要对拼接格式进行拆分,获取第14个字段\n     *\n     * @param balanceInfo 余额信息对象\n     * @param serialRecord 银行序列记录字符串\n     */\n    private void parseAvailableBalanceFromSerialRecord(BalanceInfo balanceInfo, String serialRecord) {\n        if (StringUtils.isBlank(serialRecord)) {\n            log.warn(\"serialRecord为空，账号: {}\", balanceInfo.getAccount());\n            return;\n        }\n        String[] split1 = serialRecord.split(\"\\\\|\");\n        if (split1.length >= 14) {\n            try {\n                String balanceStr = split1[13].trim();\n                if (StringUtils.isNotBlank(balanceStr)) {\n                    balanceInfo.setAvailableBalance(String.valueOf(new BigDecimal(balanceStr)));\n                } else {\n                    log.warn(\"余额字段为空，账号: {}\", balanceInfo.getAccount());\n                }\n            } catch (NumberFormatException e) {\n                log.error(\"余额格式转换失败，账号: {}, 余额字符串: {}\", balanceInfo.getAccount(), split1[13], e);\n            }\n        } else {\n            log.warn(\"serialRecord格式不正确，字段数量不足14个，实际: {}，账号: {}\", split1.length, balanceInfo.getAccount());\n        }\n    }\n\n    /**\n     * 从银行序列记录中解析可用余额（TmsAccountBalanceCmb版本）\n     * <serial_record>\n     * 户名|账号|开户行|账户类型|币种|会计日期|余额|冻结金额|错误信息|成功标志|怒纺止娘键者冰匀糙涌|\n     * 310069079018800073806|310999|1|CNY|20260107|381458534.34|0.00|账户余额查询成功|0|\n     * </serial_record>\n     * 获取余额字段对应的值,则需要对拼接格式进行拆分,获取第14个字段\n     *\n     * @param balanceInfo TmsAccountBalanceCmb余额信息对象\n     * @param serialRecord 银行序列记录字符串\n     */\n    private void parseOnlineBalanceFromSerialRecord(TmsAccountBalanceCmb balanceInfo, String serialRecord) {\n        if (StringUtils.isBlank(serialRecord)) {\n            log.warn(\"serialRecord为空，账号: {}\", balanceInfo.getAccountNo());\n            return;\n        }\n        String[] split1 = serialRecord.split(\"\\\\|\");\n        if (split1.length >= 17) {\n            try {\n                String balanceStr = split1[16].trim();\n                if (StringUtils.isNotBlank(balanceStr)) {\n                    balanceInfo.setOnlineBalance(new BigDecimal(balanceStr));\n                    log.debug(\"解析到可用余额: {}，账号: {}\", balanceStr, balanceInfo.getAccountNo());\n                } else {\n                    log.warn(\"余额字段为空，账号: {}\", balanceInfo.getAccountNo());\n                }\n            } catch (NumberFormatException e) {\n                log.error(\"余额格式转换失败，账号: {}, 余额字符串: {}\", balanceInfo.getAccountNo(), split1[13], e);\n            }\n        } else {\n            log.warn(\"serialRecord格式不正确，字段数量不足14个，实际: {}，账号: {}\", split1.length, balanceInfo.getAccountNo());\n        }\n    }\n\n    @Override\n    public List<BalanceInfo> queryBalanceForCheck(List<PayQO> qos) {\n        return bankcommonService.queryBankcommonBalanceForCheck(qos, null);\n    }\n\n    @Override\n    public Page<PayInstructDTO> bankSuspectList(PayInstructQO qo) {\n        return commonBankStrategy.bankSuspectList(qo);\n    }\n\n    @Override\n    public String bankAnalysisSuspect(PayInstructQO payInstructQO) {\n        Map<String, String> extentionParams = new HashMap<>();\n        Date beginDate = DateUtils.addDays(new Date(), -25);\n        extentionParams.put(\"beginDate\", DateUtils.formatDate(beginDate, \"yyyyMMdd\"));\n        return bankcommonService.bankcommonAnalysisSuspect(payInstructQO, extentionParams);\n    }\n\n    @Override\n    public String updateInstruct(PayInstructQO payInstructQO) {\n        return commonBankStrategy.updateInstruct(payInstructQO);\n    }\n\n    @Override\n    public void updateInstructFailedBatch(String bankCode, List<Long> payIds) {\n        commonBankStrategy.updateInstructFailedBatch(bankCode, payIds);\n    }\n\n    @Override\n    public int bankDirectBankPay(String bankCode) {\n        return bankcommonService.bankcommonDirectBankPay(bankCode, null);\n    }\n\n    @Override\n    public List<Map<String, Object>> queryPayResult(List<Map<String, Object>> instructs, String bankCode) {\n        Map<String, String> extentionParams = new HashMap<>();\n        // 修改查询状态起始日期，银行支持30天内查询\n        Date beginDate = DateUtils.addDays(new Date(), -25);\n        extentionParams.put(\"beginDate\", DateUtils.formatDate(beginDate, \"yyyyMMdd\"));\n        return bankcommonService.queryPayResult(instructs, bankCode, extentionParams);\n    }\n\n    @Override\n    public String selectElectReceipt(PayQO payQO) {\n        return bankcommonReceiptService.selectElectReceipt(payQO, null);\n    }\n\n    @Override\n    public String selectBankcommonRefund(PayQO payQO) {\n        return bankcommonService.selectBankcommonRefund(payQO, null);\n    }\n\n    /**\n     * 查询银行历史余额\n     *\n     * @param bankcommonBalanceOldQO 查询条件对象\n     * @return 银行余额列表\n     * @throws Exception 加密密码时可能抛出的异常\n     */\n    @Override\n    public List<TmsAccountBalanceCmb> selectBankBalanceOld(BankcommonBalanceOldQO bankcommonBalanceOldQO) {\n        List<TmsAccountBalanceCmb> balanceInfos = bankcommonService.selectBankcommonBalanceOld(bankcommonBalanceOldQO, null);\n        try {\n            balanceInfos.forEach(balanceInfo -> {\n                // 针对特殊银行特殊处理,例如交通银行是拼接格式\n                // <serial_record>\n                // 户名|账号|币种|余额|可用余额|开户日期|账户类型|开户行|错误信息|成功标志|\n                // XXX公司|310066661010121088868|CNY|85317882.08|85317882.08|19951117|1|310999||0|\n                // </serial_record>\n                // 获取余额字段对应的值,则需要对拼接格式进行拆分,获取第14个字段\n                String serialRecord = balanceInfo.getSerialRecord();\n                parseOnlineBalanceFromSerialRecord(balanceInfo, serialRecord);\n            });\n        }catch (Exception e){\n            log.error(\"查询银行余额时，获取账户名称失败\", e);\n        }\n        return balanceInfos;\n    }\n    @Override\n    public List<Map<String, Object>> generateBankPayInstructs(String bankCode, List<PayChecksDTO> checks) {\n        List<Map<String, Object>> instructs = commonBankStrategy.generateBankPayInstructs(bankCode, checks);\n        Map<String, PayChecksDTO> payCheckMap = checks.stream().collect(Collectors.toMap(PayChecksDTO::getPayCheckNum, Function.identity(), (v1, v2) -> v2));\n        for (Map<String, Object> instruct : instructs) {\n            if (Constants.ENABLED_N.equals(instruct.getOrDefault(\"interBankFlag\", Constants.ENABLED_Y))) {\n                instruct.put(\"payeeBanchNumber\", \"\");\n            }\n            String trnUid = StringUtils.toString(instruct.get(\"trnUid\"));\n            String elecChequeNo = trnUid;\n            try {\n                elecChequeNo = StringCompressor.compress(trnUid, 16);\n            } catch (Exception e) {\n                log.error(\"trnUid转电子凭证号失败\", e);\n            }\n            instruct.put(\"elecChequeNo\", elecChequeNo);\n            String interBankFlag = StringUtils.toString(instruct.get(\"interBankFlag\"));\n            String sysFlag = interBankFlag.equals(Constants.ENABLED_Y) ? \"1\" : \"0\";\n            // 本行/他行标志(0：表示本行 1：表示他行)\n            instruct.put(\"bankFlag\", sysFlag);\n            PayChecksDTO payCheck = payCheckMap.get(StringUtils.toString(instruct.get(\"payCheckNum\")));\n            if (payCheck != null) {\n                // 收款行地址(取省+市)\n                instruct.put(\"payeeAddress\", payCheck.getAttribute5Name() + payCheck.getAttribute6Name());\n                // 收款行名称\n                instruct.put(\"payeeBankName\", payCheck.getAttribute3Name() + payCheck.getAttribute4());\n                // 汇款用途(对公不输入，对私B)\n                if (\"PERSONAL\".equals(payCheck.getBeneficiaryTypeFlag())) {\n                    instruct.put(\"remitPurpose\", \"B\");\n                }\n            }\n        }\n        return instructs;\n    }\n\n    @Override\n    public String bankQueryPayResultJob(String bankCode) {\n        Map<String, String> extentionParams = new HashMap<>();\n        Date beginDate = DateUtils.addDays(new Date(), -25);\n        extentionParams.put(\"beginDate\", DateUtils.formatDate(beginDate, \"yyyyMMdd\"));\n        return bankcommonService.bankcommonQueryPayResultJob(bankCode, extentionParams);\n    }\n\n    @Override\n    public Integer getBankUnUrgentPayTask() {\n        return 0;\n    }\n\n    @Override\n    public Integer bankUnUrgentPayTask() {\n        return 0;\n    }\n\n    @Override\n    public Integer bankQueryPayResultTask() {\n        return 0;\n    }\n\n    @Override\n    public Integer selectBankElectReceiptTask() {\n        return 0;\n    }\n\n    @Override\n    public String verityReceive(PayChecksDTO payChecksDTO, PmcPayChecks payCheck, String bankCode) {\n        // 收款方信息校验\n        StringBuilder failedStringBuilder = new StringBuilder();\n        if (StringUtils.isBlank(payChecksDTO.getAttributeCategory())) {\n            failedStringBuilder.append(\"收款人信息弹性域字段为空！\");\n        } else if (!Constants.WIRE_CN.equals(payChecksDTO.getAttributeCategory())\n                && !Constants.PAYCARD_CN.equals(payChecksDTO.getAttributeCategory())) {\n            failedStringBuilder.append(\"收款人信息弹性域非工资卡中国或电汇中国! \");\n        }\n        if (StringUtils.isBlank(payChecksDTO.getAttribute1())) {\n            failedStringBuilder.append(\"收款人名称为空! \");\n        } else if (StringUtils.length(payChecksDTO.getAttribute1()) > 60) {\n            failedStringBuilder.append(\"收款人名称长度大于60! \");\n        }\n        if (StringUtils.isBlank(payChecksDTO.getAttribute2())) {\n            failedStringBuilder.append(\"收款方帐号为空！\");\n        } else if (payChecksDTO.getAttribute2().length() > 40) {\n            failedStringBuilder.append(\"收款方帐号长度大于40！\");\n        } else if (payChecksDTO.getAttribute2().contains(\"/\") || payChecksDTO.getAttribute2().contains(\"\\\\\")) {\n            failedStringBuilder.append(\"收款账号字段格式错误！ \");\n        }\n        if (StringUtils.isBlank(payChecksDTO.getAttribute3())) {\n            failedStringBuilder.append(\"收款账号开户行为空！ \");\n        }\n        // 收款方值集翻译失败\n        if (StringUtils.isBlank(payChecksDTO.getAttribute3Name())) {\n            failedStringBuilder.append(\"银行code:\").append(payChecksDTO.getAttribute3()).append(\"值集翻译失败\");\n        }\n\n        if (StringUtils.isBlank(payChecksDTO.getAttribute4())) {\n            failedStringBuilder.append(\"收款账号开户行支行为空！ \");\n        } else {\n            String bankBranch = payChecksDTO.getAttribute3Name() + payChecksDTO.getAttribute4();\n            if (bankBranch.length() > 100) {\n                failedStringBuilder.append(\"收款人开户行+开户支行名称长度大于100！\");\n            }\n        }\n        // 跨行对联行号进行校验，同行不校验\n        if (!StringUtils.equals(payChecksDTO.getAttribute3(), payChecksDTO.getBankCode())) {\n            // 鉴于银行名称不准确，因此采用收款行联行号非空形式，长度小于等于12\n            if (StringUtils.isBlank(payChecksDTO.getAttribute7())) {\n                failedStringBuilder.append(\"收款行联行号为空！\");\n            } else if (StringUtils.length(payChecksDTO.getAttribute7()) != 5\n                    && StringUtils.length(payChecksDTO.getAttribute7()) != 12) {\n                failedStringBuilder.append(\"收款行联行号长度为5位或12位！\");\n            }\n        }\n        if (StringUtils.isNotBlank(payChecksDTO.getRemark())\n                && StringUtils.length(payChecksDTO.getRemark()) > 60) {\n            failedStringBuilder.append(\"用途字段长度大于60！\");\n        } else if (StringUtils.isNotBlank(payChecksDTO.getRemark())\n                && payChecksDTO.getRemark().contains(\"|\")) {\n            failedStringBuilder.append(\"用途字段格式错误！\");\n        }\n\n        payCheck.setFailureReasons(failedStringBuilder.toString());\n        return payCheck.getFailureReasons();\n    }\n\n    @Override\n    public String verityPay(List<String> bankCodes, PayChecksDTO payChecksDTO, PmcPayChecks payCheck, String bankCode) {\n\n        StringBuilder verityFailedStringBuilder = new StringBuilder();\n        // 付款方信息校验\n        if (!Constants.TYPE_HOME.equals(payChecksDTO.getAccountType())) {\n            verityFailedStringBuilder.append(\"付款账户非国内账户！\");\n        }\n        if (!bankCodes.contains(payChecksDTO.getBankCode())) {\n            verityFailedStringBuilder.append(\"付款银行没有开通银企直连！\");\n        }\n        if (StringUtils.isBlank(payChecksDTO.getReferenceNumber())) {\n            verityFailedStringBuilder.append(\"业务参考号为空！\");\n        } else if (payChecksDTO.getReferenceNumber().length() > 20) {\n            payChecksDTO.setReferenceNumber(payChecksDTO.getReferenceNumber().substring(0, 19));\n        }\n        if (StringUtils.isBlank(payChecksDTO.getAccount())) {\n            verityFailedStringBuilder.append(\"付款账户为空！\");\n        } else if (payChecksDTO.getAccount().length() > 40) {\n            verityFailedStringBuilder.append(\"付款账户长度大于40！\");\n        }\n        if (StringUtils.isBlank(payChecksDTO.getAccountName())) {\n            verityFailedStringBuilder.append(\"付款人名称为空! \");\n        } else if (StringUtils.length(payChecksDTO.getAccountName()) > 60) {\n            verityFailedStringBuilder.append(\"付款人名称长度大于60! \");\n        }\n        if (!StringUtils.equals(payChecksDTO.getCurrency(), payChecksDTO.getAmountCurrency())) {\n            verityFailedStringBuilder.append(\"付款币种和账户币种不一致！\");\n        }\n        if (!Constants.CNY.equals(payChecksDTO.getAmountCurrency())) {\n            verityFailedStringBuilder.append(\"币种不是人民币！\");\n        }\n        if (payChecksDTO.getAmount() == null || payChecksDTO.getAmount().compareTo(BigDecimal.ZERO) <= 0) {\n            verityFailedStringBuilder.append(\"金额小于等于0！\");\n        }\n        if (!Constants.ENABLED_Y.equals(payChecksDTO.getDirectFlag())) {\n            verityFailedStringBuilder.append(\"没有启用银企支付！\");\n        }\n\n        payCheck.setFailureReasons(verityFailedStringBuilder.toString());\n        return payCheck.getFailureReasons();\n    }\n\n    @Override\n    public String postBankHttp(String request, String uri, Map<String, Object> dto, String bankCode) {\n        return \"\";\n    }\n\n    @Override\n    public String postMACHINE(String request, String hashValue, Long tenantId, String[] ipArr, String bankCode) {\n        String uuid = UUID.randomUUID().toString().replace(\"-\", \"\").substring(0, 20);\n        request = request.replaceFirst(\"^[\\\\s\\\\S]*?(?=<ap>)\", \"\");\n        request = request.replaceAll(\"req_no>.*?</req_no>\", \"req_no>\" + uuid + \"</req_no>\");\n        PmcCmbMachineDTO cmbMachineDTO = new PmcCmbMachineDTO();\n        cmbMachineDTO.setTenantId(tenantId);\n        cmbMachineDTO.setStatus(Constants.UP);\n        cmbMachineDTO.setMachineBank(bankCode);\n        List<PmcCmbMachine> pmcCmbMachines = machineService.selectMachine(cmbMachineDTO);\n        if (CollectionUtils.isEmpty(pmcCmbMachines)) {\n            log.error(\"无可用前置机 postMACHINE\");\n            // 无可用前置机\n            mailService.sendMachineFailedMail(\"无可用前置机\", new ArrayList<>(), \"\");\n            return Constants.NO_ENABLED_MACHINE;\n        }\n        pmcCmbMachines.forEach(detail -> log.info(\"可用前置机：\" + detail.getName() + \" \" + detail.getIp()));\n        log.info(\"租户：\" + tenantId);\n        // 一致性哈希算法 获取分配机器\n        Map<String, PmcCmbMachine> map = pmcCmbMachines.stream()\n                .collect(Collectors.toMap(PmcCmbMachine::getIp, Function.identity(), (k1, k2) -> k1));\n        String[] currentServers = map.keySet().toArray(new String[0]);\n        String server = new NodeDistributeUtil().getServer(hashValue, currentServers);\n        log.info(\"request server : \" + server);\n        PmcCmbMachine machine = map.get(server);\n        log.info(\"请求前置机ip地址: {}\", machine.getIp());\n        String[] ipPort;\n        if (server.split(\"//\").length != 2\n                || (ipPort = server.split(\"//\")[1].split(\":\")).length != 2) {\n            log.error(\"ip = {}, 格式不正确\", server);\n            return Constants.NO_ENABLED_MACHINE;\n        }\n        if (null != ipArr) {\n            ipArr[0] = ipPort[0];\n        }\n        try {\n            // 请求报文\n            log.info(\"请求报文 request={}\", request);\n            Example example = new Example(PmcPayCommonBankSet.class);\n            example.createCriteria().\n                    andEqualTo(\"bankCode\", bankCode)\n                    .andEqualTo(\"transferFlag\", Constants.ENABLED_Y);\n            List<PmcPayCommonBankSet> pmcPayCommonBankSets = pmcPayCommonBankSetMapper.selectByExample(example);\n            String requestType = Constants.RequestTypeEnum.XML;\n            if (CollectionUtils.isNotEmpty(pmcPayCommonBankSets)) {\n                requestType = pmcPayCommonBankSets.get(0).getRequestType();\n            }\n            String response = null;\n            if (Constants.RequestTypeEnum.XML.equals(requestType)) {\n                response = OkHttpUtils.sendHttpRequest(machine.getIp(), request);\n            } else {\n                response = OkHttpUtils.sendHttpRequestJson(machine.getIp(), request);\n            }\n            // 针对响应报文增加报文头（避免重复添加）\n            if (Constants.RequestTypeEnum.XML.equals(requestType) &&\n                    !response.trim().startsWith(\"<?xml\")) {\n                response = \"<?xml version=\\\"1.0\\\" encoding=\\\"GBK\\\"?>\" + response;\n            }\n            log.info(\"response :\" + response);\n            return response;\n        } catch (Exception e) {\n            log.error(\"网络出错，请检查网络！\", e);\n        }\n        return Constants.BANK_POST_EXCEPTION;\n    }\n\n}\n",
                "content": "package com.baidu.pmc.bankcommon.core.service.strategy;\n\nimport com.baidu.pmc.bankcommon.core.constants.Constants;\nimport com.baidu.pmc.bankcommon.core.service.AccountService;\nimport com.baidu.pmc.bankcommon.core.service.BankStrategy;\nimport com.baidu.pmc.bankcommon.core.service.BankcommonReceiptService;\nimport com.baidu.pmc.bankcommon.core.service.BankcommonService;\nimport com.baidu.pmc.bankcommon.core.service.MachineService;\nimport com.baidu.pmc.bankcommon.core.service.impl.SendMailService;\nimport com.baidu.pmc.bankcommon.core.utils.NodeDistributeUtil;\nimport com.baidu.pmc.bankcommon.core.utils.OkHttpUtils;\nimport com.baidu.pmc.bankcommon.core.utils.StringCompressor;\nimport com.baidu.pmc.bankcommon.persistence.dao.PmcPayCommonBankSetMapper;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.pojo.dto.PayChecksDTO;\nimport com.baidu.pmc.pojo.dto.cmb.BalanceInfo;\nimport com.baidu.pmc.pojo.dto.cmb.PayInstructDTO;\nimport com.baidu.pmc.pojo.dto.cmb.PmcCmbMachineDTO;\nimport com.baidu.pmc.pojo.dto.cmb.TmsAccountBalanceCmb;\nimport com.baidu.pmc.pojo.dto.cmb.TransInfo;\nimport com.baidu.pmc.pojo.model.PmcAccount;\nimport com.baidu.pmc.pojo.model.PmcPayChecks;\nimport com.baidu.pmc.pojo.model.PmcPayCommonBankSet;\nimport com.baidu.pmc.pojo.model.cmb.PayQO;\nimport com.baidu.pmc.pojo.model.cmb.PmcCmbMachine;\nimport com.baidu.pmc.pojo.qo.BankcommonBalanceOldQO;\nimport com.baidu.pmc.pojo.qo.cmb.PayInstructQO;\nimport com.github.pagehelper.Page;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections.CollectionUtils;\n\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\nimport tk.mybatis.mapper.entity.Example;\nimport java.math.BigDecimal;\nimport java.util.ArrayList;\nimport java.util.Date;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.UUID;\nimport java.util.function.Function;\nimport java.util.stream.Collectors;\n\n@Slf4j\n@Service\npublic class BcmBankStrategy implements BankStrategy {\n\n    @Autowired\n    private CommonBankStrategy commonBankStrategy;\n\n    @Autowired\n    private BankcommonService bankcommonService;\n\n    @Autowired\n    private BankcommonReceiptService bankcommonReceiptService;\n\n    @Autowired\n    private MachineService machineService;\n\n    @Autowired\n    private SendMailService mailService;\n\n    @Autowired\n    private PmcPayCommonBankSetMapper pmcPayCommonBankSetMapper;\n\n    @Autowired\n    private AccountService accountService;\n\n    @Override\n    public String getBankStrategy() {\n        return Constants.BankStrategyCode.BCM;    // 单独扩展的策略需要一个单独的策略code\n    }\n\n    @Override\n    public Page<PayInstructDTO> getPayInstructList(PayInstructQO qo) {\n        // 需要复用通用逻辑时，使用组合的方式调用\n        return commonBankStrategy.getPayInstructList(qo);\n    }\n\n    @Override\n    public Integer genBankUnUrgentPay(String bankCode) {\n        return commonBankStrategy.genBankUnUrgentPay(bankCode);\n    }\n\n    @Override\n    public List<TransInfo> selectBankTrans(PayQO qo) {\n        Map<String, String> extentionParams = new HashMap<>();\n        // 根据 startDate和 endDate 和当前日期判断传的日期标识为 0-当日及昨日交易明细查询  1-昨日以前历史明细查询\n\n\n\n\n        extentionParams.put(\"\", \"1\");\n        List<TransInfo> transInfos = bankcommonService.selectBankcommonTrans(qo, extentionParams);\n        transInfos.forEach(transInfo -> {\n            String referenceNumber = transInfo.getReferenceNumber();\n            // 把原先的电子凭证号写入业务摘要，供后续电子回单和流水使用\n            try {\n                String elecChequeNo = referenceNumber;\n                transInfo.setBusinessNaryur(elecChequeNo);\n            } catch (Exception e) {\n                // 存在非PMC单子，转换失败，直接返回原凭证号\n                log.error(\"电子凭证号转业务参考号失败\", e);\n            }\n\n        });\n        return transInfos;\n    }\n\n    @Override\n    public List<BalanceInfo> selectBankBalance(PayQO qo) {\n        List<BalanceInfo> balanceInfos = bankcommonService.selectBankcommonBalance(qo, null);\n        try {\n            balanceInfos.forEach(balanceInfo -> {\n                PayQO payQO = new PayQO();\n                payQO.setBank(qo.getBank());\n                payQO.setAccount(balanceInfo.getAccount());\n                PmcAccount pmcAccount = accountService.queryBankcommonAccountByAccountNo(payQO);\n                balanceInfo.setAnnotation(pmcAccount.getAccountName());\n                // 针对特殊银行特殊处理,例如交通银行是拼接格式\n                // <serial_record>\n                // 户名|账号|币种|余额|可用余额|开户日期|账户类型|开户行|错误信息|成功标志|\n                // XXX公司|310066661010121088868|CNY|85317882.08|85317882.08|19951117|1|310999||0|\n                // </serial_record>\n                // 获取余额字段对应的值,则需要对拼接格式进行拆分,获取第14个字段\n                String serialRecord = balanceInfo.getSerialRecord();\n                parseAvailableBalanceFromSerialRecord(balanceInfo, serialRecord);\n            });\n        }catch (Exception e){\n            log.error(\"查询银行余额时，获取账户名称失败\", e);\n        }\n        return balanceInfos;\n    }\n\n    /**\n     * 从银行序列记录中解析可用余额\n     * <serial_record>\n     * 户名|账号|币种|余额|可用余额|开户日期|账户类型|开户行|错误信息|成功标志|\n     * XXX公司|310066661010121088868|CNY|85317882.08|85317882.08|19951117|1|310999||0|\n     * </serial_record>\n     * 获取余额字段对应的值,则需要对拼接格式进行拆分,获取第14个字段\n     *\n     * @param balanceInfo 余额信息对象\n     * @param serialRecord 银行序列记录字符串\n     */\n    private void parseAvailableBalanceFromSerialRecord(BalanceInfo balanceInfo, String serialRecord) {\n        if (StringUtils.isBlank(serialRecord)) {\n            log.warn(\"serialRecord为空，账号: {}\", balanceInfo.getAccount());\n            return;\n        }\n        String[] split1 = serialRecord.split(\"\\\\|\");\n        if (split1.length >= 14) {\n            try {\n                String balanceStr = split1[13].trim();\n                if (StringUtils.isNotBlank(balanceStr)) {\n                    balanceInfo.setAvailableBalance(String.valueOf(new BigDecimal(balanceStr)));\n                } else {\n                    log.warn(\"余额字段为空，账号: {}\", balanceInfo.getAccount());\n                }\n            } catch (NumberFormatException e) {\n                log.error(\"余额格式转换失败，账号: {}, 余额字符串: {}\", balanceInfo.getAccount(), split1[13], e);\n            }\n        } else {\n            log.warn(\"serialRecord格式不正确，字段数量不足14个，实际: {}，账号: {}\", split1.length, balanceInfo.getAccount());\n        }\n    }\n\n    /**\n     * 从银行序列记录中解析可用余额（TmsAccountBalanceCmb版本）\n     * <serial_record>\n     * 户名|账号|开户行|账户类型|币种|会计日期|余额|冻结金额|错误信息|成功标志|怒纺止娘键者冰匀糙涌|\n     * 310069079018800073806|310999|1|CNY|20260107|381458534.34|0.00|账户余额查询成功|0|\n     * </serial_record>\n     * 获取余额字段对应的值,则需要对拼接格式进行拆分,获取第14个字段\n     *\n     * @param balanceInfo TmsAccountBalanceCmb余额信息对象\n     * @param serialRecord 银行序列记录字符串\n     */\n    private void parseOnlineBalanceFromSerialRecord(TmsAccountBalanceCmb balanceInfo, String serialRecord) {\n        if (StringUtils.isBlank(serialRecord)) {\n            log.warn(\"serialRecord为空，账号: {}\", balanceInfo.getAccountNo());\n            return;\n        }\n        String[] split1 = serialRecord.split(\"\\\\|\");\n        if (split1.length >= 17) {\n            try {\n                String balanceStr = split1[16].trim();\n                if (StringUtils.isNotBlank(balanceStr)) {\n                    balanceInfo.setOnlineBalance(new BigDecimal(balanceStr));\n                    log.debug(\"解析到可用余额: {}，账号: {}\", balanceStr, balanceInfo.getAccountNo());\n                } else {\n                    log.warn(\"余额字段为空，账号: {}\", balanceInfo.getAccountNo());\n                }\n            } catch (NumberFormatException e) {\n                log.error(\"余额格式转换失败，账号: {}, 余额字符串: {}\", balanceInfo.getAccountNo(), split1[13], e);\n            }\n        } else {\n            log.warn(\"serialRecord格式不正确，字段数量不足14个，实际: {}，账号: {}\", split1.length, balanceInfo.getAccountNo());\n        }\n    }\n\n    @Override\n    public List<BalanceInfo> queryBalanceForCheck(List<PayQO> qos) {\n        return bankcommonService.queryBankcommonBalanceForCheck(qos, null);\n    }\n\n    @Override\n    public Page<PayInstructDTO> bankSuspectList(PayInstructQO qo) {\n        return commonBankStrategy.bankSuspectList(qo);\n    }\n\n    @Override\n    public String bankAnalysisSuspect(PayInstructQO payInstructQO) {\n        Map<String, String> extentionParams = new HashMap<>();\n        Date beginDate = DateUtils.addDays(new Date(), -25);\n        extentionParams.put(\"beginDate\", DateUtils.formatDate(beginDate, \"yyyyMMdd\"));\n        return bankcommonService.bankcommonAnalysisSuspect(payInstructQO, extentionParams);\n    }\n\n    @Override\n    public String updateInstruct(PayInstructQO payInstructQO) {\n        return commonBankStrategy.updateInstruct(payInstructQO);\n    }\n\n    @Override\n    public void updateInstructFailedBatch(String bankCode, List<Long> payIds) {\n        commonBankStrategy.updateInstructFailedBatch(bankCode, payIds);\n    }\n\n    @Override\n    public int bankDirectBankPay(String bankCode) {\n        return bankcommonService.bankcommonDirectBankPay(bankCode, null);\n    }\n\n    @Override\n    public List<Map<String, Object>> queryPayResult(List<Map<String, Object>> instructs, String bankCode) {\n        Map<String, String> extentionParams = new HashMap<>();\n        // 修改查询状态起始日期，银行支持30天内查询\n        Date beginDate = DateUtils.addDays(new Date(), -25);\n        extentionParams.put(\"beginDate\", DateUtils.formatDate(beginDate, \"yyyyMMdd\"));\n        return bankcommonService.queryPayResult(instructs, bankCode, extentionParams);\n    }\n\n    @Override\n    public String selectElectReceipt(PayQO payQO) {\n        return bankcommonReceiptService.selectElectReceipt(payQO, null);\n    }\n\n    @Override\n    public String selectBankcommonRefund(PayQO payQO) {\n        return bankcommonService.selectBankcommonRefund(payQO, null);\n    }\n\n    /**\n     * 查询银行历史余额\n     *\n     * @param bankcommonBalanceOldQO 查询条件对象\n     * @return 银行余额列表\n     * @throws Exception 加密密码时可能抛出的异常\n     */\n    @Override\n    public List<TmsAccountBalanceCmb> selectBankBalanceOld(BankcommonBalanceOldQO bankcommonBalanceOldQO) {\n        List<TmsAccountBalanceCmb> balanceInfos = bankcommonService.selectBankcommonBalanceOld(bankcommonBalanceOldQO, null);\n        try {\n            balanceInfos.forEach(balanceInfo -> {\n                // 针对特殊银行特殊处理,例如交通银行是拼接格式\n                // <serial_record>\n                // 户名|账号|币种|余额|可用余额|开户日期|账户类型|开户行|错误信息|成功标志|\n                // XXX公司|310066661010121088868|CNY|85317882.08|85317882.08|19951117|1|310999||0|\n                // </serial_record>\n                // 获取余额字段对应的值,则需要对拼接格式进行拆分,获取第14个字段\n                String serialRecord = balanceInfo.getSerialRecord();\n                parseOnlineBalanceFromSerialRecord(balanceInfo, serialRecord);\n            });\n        }catch (Exception e){\n            log.error(\"查询银行余额时，获取账户名称失败\", e);\n        }\n        return balanceInfos;\n    }\n    @Override\n    public List<Map<String, Object>> generateBankPayInstructs(String bankCode, List<PayChecksDTO> checks) {\n        List<Map<String, Object>> instructs = commonBankStrategy.generateBankPayInstructs(bankCode, checks);\n        Map<String, PayChecksDTO> payCheckMap = checks.stream().collect(Collectors.toMap(PayChecksDTO::getPayCheckNum, Function.identity(), (v1, v2) -> v2));\n        for (Map<String, Object> instruct : instructs) {\n            if (Constants.ENABLED_N.equals(instruct.getOrDefault(\"interBankFlag\", Constants.ENABLED_Y))) {\n                instruct.put(\"payeeBanchNumber\", \"\");\n            }\n            String trnUid = StringUtils.toString(instruct.get(\"trnUid\"));\n            String elecChequeNo = trnUid;\n            try {\n                elecChequeNo = StringCompressor.compress(trnUid, 16);\n            } catch (Exception e) {\n          