rties(list.toPageInfo(), pageInfo);\n        pageInfo.setList(list);\n        return pageInfo;\n    }\n\n    @Override\n    public List<SupplierFinancingUsageDTO> queryFinancingUsage(SupplierFinancingUsageQO qo) {\n        return List.of();\n    }\n\n    @Override\n    public List<PmcFinanceSupplierQuotaSet> exportSupplierQuotaSet(PmcFinanceSupplierQuotaSetQO query) {\n        return getSupplierQuotaSetList(query);\n    }\n\n\n    @Override\n    public Long saveOrUpdateSupplierQuotaSet(PmcFinanceSupplierQuotaSet dto) {\n        PmcFinanceSupplierQuotaSet pmcFinanceSupplierQuotaSet = new PmcFinanceSupplierQuotaSet();\n        BeanUtils.copyProperties(dto, pmcFinanceSupplierQuotaSet);\n        // 插入数据\n        if (pmcFinanceSupplierQuotaSetMapper.selectCount(pmcFinanceSupplierQuotaSet) > 0) {\n            pmcFinanceSupplierQuotaSet.setLastUpdateDate(new Date());\n            pmcFinanceSupplierQuotaSetMapper.updateByPrimaryKey(pmcFinanceSupplierQuotaSet);\n        } else {\n            pmcFinanceSupplierQuotaSet.setCreateDate(new Date());\n            pmcFinanceSupplierQuotaSetMapper.insert(pmcFinanceSupplierQuotaSet);\n        }\n        return pmcFinanceSupplierQuotaSet.getId();\n    }\n\n\n    private List<PmcFinanceSupplierQuotaSet> getSupplierQuotaSetList(PmcFinanceSupplierQuotaSetQO query) {\n        Example example = new Example(PmcFinanceSupplierQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n        String supId = PmcPortalLogin.getSupId();\n        PmcDataP2pSupplier supplier  = null;\n        if (StringUtils.isNotBlank(supId)) {\n            supplier = pmcDataP2pSupplierMapper.selectBySupplierCode(supId);\n            if (supplier == null) {\n                throw new ServiceException(\"供应商信息不存在: supId=\" + supId);\n            }\n        }\n        if (StringUtils.isBlank(query.getSupplierName()) && supplier != null) {\n            query.setSupplierName(supplier.getSupplierName());\n        }\n        if (StringUtils.isBlank(query.getSupplierCode()) && supplier != null) {\n            query.setSupplierCode(supplier.getSupplierCode());\n        }\n        criteria.andEqualTo(\"supplierName\", query.getSupplierName())\n                .andEqualTo(\"supplierCode\", query.getSupplierCode());\n\n        if (StringUtils.isNotBlank(query.getRegistrationCode())) {\n            criteria.andEqualTo(\"registrationCode\", query.getRegistrationCode());\n        }\n        if (StringUtils.isNotBlank(query.getFinanceFlag())) {\n            criteria.andEqualTo(\"financeFlag\", query.getFinanceFlag());\n        }\n        List<PmcFinanceSupplierQuotaSet> list = pmcFinanceSupplierQuotaSetMapper.selectByExample(example);\n        return list;\n    }\n\n\n    private List<PmcFinanceCompQuotaSetDTO> getQuotaSetList(PmcFinanceCompQuotaSetQO query) {\n        Example example = new Example(PmcFinanceCompQuotaSet.class);\n\n        Example.Criteria criteria = example.createCriteria();\n        if (StringUtils.isNotBlank(query.getBankCode())) {\n            criteria.andEqualTo(\"bankCode\", query.getBankCode());\n        }\n        if (StringUtils.isNotBlank(query.getCreditCompCode())) {\n            criteria.andEqualTo(\"creditCompCode\", query.getCreditCompCode());\n        }\n        if (StringUtils.isNotBlank(query.getEnableFlag())) {\n            criteria.andEqualTo(\"enableFlag\", query.getEnableFlag());\n        }\n        if (StringUtils.isNotBlank(query.getPayAccount())) {\n            criteria.andEqualTo(\"payAccount\", query.getPayAccount());\n        }\n        List<PmcFinanceCompQuotaSet> list = pmcFinanceCompQuotaSetMapper.selectByExample(example);\n\n\n        List<PmcFinanceCompQuotaSetDTO> dtoList = list.stream().map(his -> {\n            PmcFinanceCompQuotaSetDTO dto = new PmcFinanceCompQuotaSetDTO();\n            BeanUtils.copyProperties(his, dto);\n            dto.setCompanyName(operateByJDBC.translate(BD_COMPANY, StringUtils.toString(dto.getCompanyCode())));\n            dto.setCreditCompName(operateByJDBC.translate(BD_COMPANY, StringUtils.toString(dto.getCreditCompCode())));\n            dto.setBankName(operateByJDBC.translate(BANK, StringUtils.toString(dto.getBankCode())));\n            return dto;\n        }).collect(Collectors.toList());\n        setPayAccountNames(dtoList);\n        return dtoList;\n    }\n\n\n    private void setPayAccountNames(List<PmcFinanceCompQuotaSetDTO> list) {\n        if (CollectionUtils.isEmpty(list)) {\n            return;\n        }\n        // 收集所有accountNo\n        List<String> accountNos = list.stream()\n                .map(PmcFinanceCompQuotaSet::getPayAccount)\n                .filter(StringUtils::isNotBlank)\n                .distinct()\n                .collect(Collectors.toList());\n\n        if (CollectionUtils.isEmpty(accountNos)) {\n            return;\n        }\n        // 批量查询accountName\n        Map<String, String> accountNameMap = accountMapper.batchSelectAccountNames(accountNos);\n\n        // 为每条记录设置PayAccountName\n        list.forEach(dto -> {\n            if (StringUtils.isNotBlank(dto.getPayAccount())) {\n                dto.setPayAccountName(accountNameMap.get(dto.getPayAccount()));\n                String currencyName = (operateByJDBC.translate(CURRENCY, \"CNY\"));\n                dto.setPayAccountInfo(dto.getPayAccount() + \"-\"+ currencyName+ \"-\"\n                        + dto.getBankName()+ \"-\"+dto.getPayAccountName());\n            }\n        });\n    }\n    @Override\n    public Map<String, Object> getSelectInit() {\n        Map<String, Object> result = new HashMap<>();\n        // 获取所有融资状态及描述\n        List<CodeDesc> statusList = SupplierFinancingApplyStatus.getAllStatuses();\n\n        // 获取融资机构列表\n        List<CodeDesc> bankList = operateByJDBC.selectByCon(BANK_FINANCING_RATES)\n                .stream()\n                .map(info -> new CodeDesc(info.getFlexValue(), info.getDescription()))\n                .collect(Collectors.toList());\n\n        List<FndFlexValueDTO> enbleFlagList = fndFlexValueApi.selectByType(Constants.PmcLookupInfoCode.YES_NO);\n\n\n        // 获取公司列表\n        List<CodeDesc> cnmpanyList = operateByJDBC.selectByCon(BD_COMPANY)\n                .stream()\n                .map(info -> new CodeDesc(info.getFlexValue(), info.getDescription()))\n                .collect(Collectors.toList());\n\n        // 处理步骤列表\n        List<CodeDesc> dealList = FinancingStatus.getAllStatuses();\n\n        // 网银地址列表\n        List<CodeDesc> bankUrlList = operateByJDBC.selectByCon(BANK_FINANCING_URL)\n                .stream()\n                .map(info -> new CodeDesc(info.getFlexValue(), info.getDescription()))\n                .collect(Collectors.toList());\n\n        result.put(\"yesNo\", fndFlexValueApi.convertToCodedLabelDTO(enbleFlagList));\n        result.put(\"statusList\", statusList);\n        result.put(\"bankList\", bankList);\n        result.put(\"companyList\", cnmpanyList);\n        result.put(\"dealList\", dealList);\n        result.put(\"bankUrlList\", bankUrlList);\n\n        return result;\n    }\n\n    @Override\n    public BigDecimal calculateAvailableQuota(PmcPortalRemainQuotaQO qo){\n        BigDecimal availableQuota;\n        // 1. 获取供应商额度\n        Example example = new Example(PmcFinanceSupplierQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n        criteria.andEqualTo(\"supplierCode\", qo.getSupplierCode());\n        criteria.andEqualTo(\"financeFlag\", \"1\");\n        List<PmcFinanceSupplierQuotaSet> pmcFinanceSupplierQuotaSet\n                = pmcFinanceSupplierQuotaSetMapper.selectByExample(example);\n\n        if (CollectionUtils.isEmpty(pmcFinanceSupplierQuotaSet)) {\n            throw new RuntimeException(\"供应商额度不存在\");\n        }\n        availableQuota = pmcFinanceSupplierQuotaSet.get(0).getCreditQuota();\n\n        // 2. 获取已占用金额\n        List<String> targetStatuses = Arrays.asList(\n                SupplierFinancingApplyStatus.SUBMITTED.name(),\n                SupplierFinancingApplyStatus.BANK_PROCESSING.name(),\n                SupplierFinancingApplyStatus.PENDING_DISBURSEMEN.name(),\n                SupplierFinancingApplyStatus.DISBURSED.name());\n\n        Map<String, Object> resultMap = pmcFinanceSupplierApplyMapper.selectSummaryByStatus(targetStatuses,\n                qo.getSupplierCode());\n        BigDecimal usedQuota = (BigDecimal) resultMap.get(\"totalAmount\");\n\n        return availableQuota.subtract(usedQuota);\n    }\n\n    @Override\n    public List<CodeDesc> selectSuggest(SuggestParameter parameter) {\n        if (parameter == null || StringUtils.isBlank(parameter.getInputVal())) {\n            throw new IllegalArgumentException(\"查询关键字不能为空\");\n        }\n\n        Example example = new Example(PmcDataP2pSupplier.class);\n        Example.Criteria criteria = example.createCriteria();\n\n        // 构建模糊查询条件\n        String keyword = \"%\" + parameter.getInputVal() + \"%\";\n        criteria.orLike(\"supplierName\", keyword)\n               .orLike(\"registrationCode\", keyword)\n               .orLike(\"supplierId\", keyword);\n\n        // 执行查询\n        List<PmcDataP2pSupplier> suppliers = pmcDataP2pSupplierMapper.selectByExample(example);\n\n        // 转换为CodeDesc列表\n        return suppliers.stream()\n                .map(supplier -> new CodeDesc(\n                    String.valueOf(supplier.getSupplierId()),\n                    supplier.getSupplierName() + \"~\" + supplier.getRegistrationCode() + \"\"\n                ))\n                .collect(Collectors.toList());\n    }\n    @Override\n    public PmcFinanceApplyNumberDTO generateFinancingApplicationNo() {\n        PmcFinanceApplyNumberDTO dto = new PmcFinanceApplyNumberDTO();\n        dto.setApplicationNo(FinancingApplicationNoUtil.generate());\n        return dto;\n    }\n\n    @Override\n    public String commonCheckData(PmcFinanceBankBaseQO query, String methodName) {\n        try {\n            log.info(\"执行通用数据校验，方法名：{}，参数类型：{}\", methodName,\n            