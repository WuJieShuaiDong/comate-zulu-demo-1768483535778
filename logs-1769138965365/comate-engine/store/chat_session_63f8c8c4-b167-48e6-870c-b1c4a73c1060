age,ppcih.serial_number\n        from pmc_cmc_pay_instruct ppci ,pmc_pay_checks ppc, pmc_cmc_pay_instruct_his ppcih\n        <where>\n            ppci.check_id = #{checkId,jdbcType=VARCHAR}\n            AND ppci.check_id = ppc.check_id\n            AND ppcih.pay_check_num = ppci.pay_check_num\n            AND ppcih.status in ('PAY_ORDER_GEN','FAILED','PAYED','REFUND')\n        </where>\n    </select>\n\n    <select id=\"selectCitiPayListOne\" resultType=\"com.baidu.pmc.pojo.dto.PmcCmbPayInstructDTO\">\n        SELECT\n            ppci.pay_check_num,  -- 付款单号\n            ppcih.value_date as payDate, -- 实际付款日期\n            ppcih.r_value_date as handleDate, -- 实际付款日期\n            ppcih.payment_amount as amount, -- 付款金额\n            ppcih.debit_acct_num as account, -- 付款银行账户\n            ppcih.acct_currency as amountCurrency, -- 账户币种\n            ppcih.benef_acc_name as payee, -- 收款人全称\n            ppcih.benef_acc_no as payeeAccount, -- 收款人银行账号\n            ppcih.benef_bank_name as payeeBank, -- 收款银行\n            ppcih. STATUS,  -- 付款状态\n            ppcih.last_update_date, -- 处理时间\n            ppcih.r_msg as processMessage, -- 银行反馈信息\n            ppcih.r_acct_svcr_ref as serialNumber -- 支付流水号\n        FROM\n            pmc_citi_pay_instruct ppci,\n            pmc_pay_checks ppc,\n            pmc_citi_pay_instruct_his ppcih\n        <where>\n            ppci.check_id = #{checkId,jdbcType=VARCHAR}\n            AND ppci.check_id = ppc.check_id\n            AND ppcih.pay_check_num = ppci.pay_check_num\n            AND ppcih.status in ('PAY_ORDER_GEN','FAILED','PAYED','REFUND')\n        </where>\n    </select>\n\n    <!--  中行指令详细信息  -->\n    <select id=\"selectBocPayListOne\" resultType=\"com.baidu.pmc.pojo.dto.PmcCmbPayInstructDTO\">\n        SELECT\n        ppci.pay_check_num,  -- 付款单号\n        ppcih.pay_date as payDate, -- 实际付款日期\n        ppcih.handle_date as handleDate, -- 实际付款日期\n        ppcih.amount as amount, -- 付款金额\n        ppcih.account as account, -- 付款银行账户\n    