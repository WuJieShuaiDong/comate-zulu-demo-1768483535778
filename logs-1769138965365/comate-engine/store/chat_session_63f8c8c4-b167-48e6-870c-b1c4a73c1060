nPredictDto\">\n        SELECT\n        pmc_pay.trx_type,\n        ac.company_code company_code,\n        ac.account_no company_account,\n        -pmc_pay.amount amount,\n        pmc_pay.status\n        FROM\n        pmc_pay_checks pmc_pay\n        inner JOIN pmc_account ac ON pmc_pay.ac_account_id = ac.ac_account_id\n        <where>\n            ac.type IN ('HOME', 'ABROAD')\n            AND (\n            pmc_pay.pay_plan_date &lt;= #{analysisDate}\n            AND pmc_pay.`status` IN (\n            'CREATED',\n            'APPROVING',\n            'APPROVED',\n            'RELEASED',\n            'PENDING_SENT',\n            'PAYAGAIN',\n            'SAVED',\n            'ACCEPTED',\n            'APPROVED_LEVER1',\n            'APPROVED_LEVER2',\n            'REVISED_REFUSE',\n            'REVISED',\n            'SUSPECTED',\n            'DRAFT',\n            'SENDING',\n            'PAY_ORDER_GEN',\n            'BANK_PROCESSING',\n            'FAILED_BALANCE',\n            'VERITY_FAILED'\n            )\n            OR (\n            pmc_pay.actual_pay_date = #{analysisDate}\n            AND pmc_pay.`status` = 'PAYED'\n            ))\n            <if test=\"currencyCode != null and currencyCode != ''\">\n                and ac.currency = #{currencyCode}\n            </if>\n            <if test=\"companyList != null and companyList.size() > 0\">\n                and ac.company_code in\n                <foreach collection=\"companyList\" item=\"item\" open=\"(\" close=\")\" separator=\",\">\n                    #{item}\n                </foreach>\n            </if>\n            <if test=\"accountPool != null and accountPool != ''\">\n                and ac.ac_account_id IN (\n                SELECT\n                detail.ac_account_id\n                FROM\n                pmc_account_pool pool\n                INNER JOIN pmc_account_pool_detail detail ON pool.ac_pool_id = detail.ac_pool_id\n                WHERE\n                pool.ac_pool_code = #{accountPool})\n            </if>\n            <if test=\"account != null and account != ''\">\n                and ac.account_no = #{account}\n            </if>\n            <if test=\"tenantId != null\">\n                and pmc_pay.tenant_id = #{tenantId}\n            </if>\n        </where>\n        union all\n        SELECT\n        pmc_pay.trx_type,\n        ac.company_code company_code,\n        ac.account_no company_account,\n        pmc_pay.exchange_amount amount,\n        pmc_pay.status\n        FROM\n        pmc_pay_checks pmc_pay\n        left join pmc_pay_info info on pmc_pay.pay_info_id = info.pay_info_id\n        inner JOIN pmc_account ac ON info.attribute2 = ac.account_no and pmc_pay.amount_currency = ac.currency\n        <where>\n            pmc_pay.voucher_source = 'ZJHB' and\n            ac.type IN ('HOME', 'ABROAD')\n            AND (\n            pmc_pay.pay_plan_date &lt;= #{analysisDate}\n            AND pmc_pay.`status` IN (\n            'CREATED',\n            'APPROVING',\n            'APPROVED',\n            'RELEASED',\n            'PENDING_SENT',\n            'PAYAGAIN',\n            'SAVED',\n            'ACCEPTED',\n            'APPROVED_LEVER1',\n            'APPROVED_LEVER2',\n            'REVISED_REFUSE',\n            'REVISED',\n            'SUSPECTED',\n            'DRAFT',\n            'SENDING',\n            'PAY_ORDER_GEN',\n            'BANK_PROCESSING',\n            'FAILED_BALANCE',\n            'VERITY_FAILED'\n            )\n            OR (\n            pmc_pay.actual_pay_date = #{analysisDate}\n            AND pmc_pay.`status` = 'PAYED'\n            ))\n            <if test=\"currencyCode != null and currencyCode != ''\">\n                and ac.currency = #{currencyCode}\n            </if>\n            <if test=\"companyList != null and companyList.size() > 0\">\n                and ac.company_code in\n                <foreach collection=\"companyList\" item=\"item\" open=\"(\" close=\")\" separator=\",\">\n                    #{it