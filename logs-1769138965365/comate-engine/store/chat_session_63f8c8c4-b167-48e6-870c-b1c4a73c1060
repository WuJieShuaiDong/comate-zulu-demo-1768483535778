    AND ppcih.status in ('PAY_ORDER_GEN','FAILED','PAYED','REFUND')\n        </where>\n    </select>\n\n    <!--  民生指令详细信息  -->\n    <select id=\"selectCmbcPayListOne\" resultType=\"com.baidu.pmc.pojo.dto.PmcCmbPayInstructDTO\">\n        SELECT\n        ppci.pay_check_num,  -- 付款单号\n        ppcih.pay_date as payDate, -- 实际付款日期\n        ppcih.handle_date as handleDate, -- 实际付款日期\n        ppcih.amount as amount, -- 付款金额\n        ppcih.account as account, -- 付款银行账户\n        ppcih.amount_currency as amountCurrency, -- 账户币种\n        ppcih.payee as payee, -- 收款人全称\n        ppcih.payee_account as payeeAccount, -- 收款人银行账号\n        ppcih.payee_bank as payeeBank, -- 收款银行\n        ppcih.`status`,  -- 付款状态\n        ppcih.last_update_date, -- 处理时间\n        ppcih.process_message as processMessage, -- 银行反馈信息\n        ppcih.process_instance_number as serialNumber, -- 支付流水号\n        ppcih.payee_prov as payeeProv, -- 收款账户省\n        ppcih.payee_city as payeeCity -- 收款账户市\n        FROM\n        pmc_cmbc_pay_instruct ppci,\n        pmc_pay_checks ppc,\n        pmc_cmbc_pay_instruct_his ppcih\n        <where>\n            ppci.check_id = #{checkId,jdbcType=VARCHAR}\n            AND ppci.check_id = ppc.check_id\n            AND ppcih.pay_check_num = ppci.pay_check_num\n            AND ppcih.status in ('PAY_ORDER_GEN','FAILED','PAYED','REFUND')\n        </where>\n    </select>\n\n    <select id=\"findDistinctTrxTypes\" resultType=\"java.lang.String\">\n        select distinct trx_type from pmc_pay_checks;\n    </select>\n\n    <select id=\"findStatisticData\" parameterType=\"com.baidu.pmc.pojo.qo.PayChecksQO\"\n            resultType=\"com.baidu.pmc.pojo.dto.PayStatisticData\">\n        select tpc.check_id, tpc.amount, tpc.status from pmc_pay_checks tpc\n        <where>\n            <if test=\"trxType != null and trxType != ''\">\n                and tpc.trx_type = #{trxType,jdbcType=VARCHAR}\n            </if>\n            <if test=\"trxTypes != null and trxTypes.size &gt; 0\">\n         