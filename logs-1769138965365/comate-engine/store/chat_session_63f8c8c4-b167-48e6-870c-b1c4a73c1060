no and pmc_pay.amount_currency = ac.currency\n        <where>\n            pmc_pay.voucher_source = 'ZJHB'\n            and ac.type IN ('HOME', 'ABROAD')\n            AND pmc_pay.`status` IN (\n            'CREATED',\n            'APPROVING',\n            'APPROVED',\n            'RELEASED',\n            'PENDING_SENT',\n            'PAYAGAIN',\n            'SAVED',\n            'ACCEPTED',\n            'APPROVED_LEVER1',\n            'APPROVED_LEVER2',\n            'REVISED_REFUSE',\n            'REVISED',\n            'SUSPECTED',\n            'DRAFT',\n            'SENDING',\n            'PAY_ORDER_GEN',\n            'BANK_PROCESSING',\n            'FAILED_BALANCE',\n            'VERITY_FAILED'\n            )\n            <if test=\"analysisBeginDate != null\">\n                and pmc_pay.pay_plan_date &gt;= #{analysisBeginDate}\n            </if>\n            <if test=\"analysisEndDate != null\">\n                and pmc_pay.pay_plan_date &lt;= #{analysisEndDate}\n            </if>\n            <if test=\"currencyCode != null and currencyCode != ''\">\n                and ac.currency = #{currencyCode}\n            </if>\n            <if test=\"companyList != null and companyList.size() > 0\">\n                and ac.company_code in\n                <foreach collection=\"companyList\" item=\"item\" open=\"(\" close=\")\" separator=\",\">\n                    #{item}\n                </foreach>\n            </if>\n            <if test=\"accountPool != null and accountPool != ''\">\n                and ac.ac_account_id IN (\n                SELECT\n                detail.ac_account_id\n                FROM\n                pmc_account_pool pool\n                INNER JOIN pmc_account_pool_detail detail ON pool.ac_pool_id = detail.ac_pool_id\n                WHERE\n                pool.ac_pool_code = #{accountPool})\n            </if>\n            <if test=\"account != null and account != ''\">\n                and ac.account_no = #{account}\n            </if>\n            <if test=\"tenantId != null\">\n                and pmc_pay.tenant_id = #{tenantId}\n            </if>\n        </where>\n        GROUP BY pmc_pay.trx_type\n    </select>\n\n    <select id=\"selectCibPayListOne\" resultType=\"com.baidu.pmc.pojo.dto.PmcCmbPayInstructDTO\">\n        SELECT\n        ppci.pay_check_num,  -- 付款单号\n        ppcih.pay_date as payDate, -- 实际付款日期\n        ppcih.handle_date as handleDate, -- 实际付款日期\n        ppcih.amount as amount, -- 付款金额\n        ppcih.account as account, -- 付款银行账户\n        ppcih.amount_currency as amountCurrency, -- 账户币种\n        ppcih.payee as payee, -- 收款人全称\n        ppcih.payee_account as payeeAccount, -- 收款人银行账号\n        ppcih.payee_bank as payeeBank, -- 收款银行\n        ppcih.`status`,  -- 付款状态\n        ppcih.last_update_date, -- 处理时间\n        ppcih.process_message as processMessage, -- 银行反馈信息\n        ppcih.process_instance_number as serialNumber, -- 支付流水号\n        ppcih.payee_prov as payeeProv, -- 收款账户省\n        ppcih.payee_city as payeeCity -- 收款账户市\n        FROM\n        pmc_cib_pay_instruct ppci,\n        pmc_pay_checks ppc,\n        pmc_cib_pay_instruct_his ppcih\n        <where>\n            ppci.check_id = #{checkId,jdbcType=VARCHAR}\n            AND ppci.check_id = ppc.check_id\n            AND ppcih.pay_check_num = ppci.pay_check_num\n            AND ppcih.status in ('PAY_ORDER_GEN','FAILED','PAYED','REFUND')\n        </where>\n    </select>\n\n    <select id=\"selectAbcPayListOne\" resultType=\"com.baidu.pmc.pojo.dto.PmcCmbPayInstructDTO\">\n        SELECT\n        ppci.pay_check_num,  -- 付款单号\n        ppcih.pay_date as payDate, -- 实际付款日期\n        ppcih.handle_date as handleDate, -- 实际付款日期\n        ppcih.amount as amount, -- 付款金额\n        ppcih.account as account, -- 付款银行账户\n        ppcih.amount_currency as amountCurrency, -- 账户币种\n        ppcih.payee as payee, -- 收款人全称\n        ppcih.payee_account as payeeAccount, -- 收款人银行账号\n        ppcih.payee_bank as payeeBank, -- 收款银行\n        ppcih.`status`,  -- 付