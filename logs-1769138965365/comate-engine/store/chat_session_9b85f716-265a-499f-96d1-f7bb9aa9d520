n        }\n\n        // ===== 2. 从URL解析登录人信息 =====\n        // 假设登录人ID（supId）通过URL参数传递，如 /pmcPortal/xxx?supId=123\n        String supId = request.getParameter(\"supId\");\n        if (supId == null || supId.isEmpty()) {\n            response.sendError(HttpServletResponse.SC_BAD_REQUEST, \"缺少登录人ID（supId）\");\n            return false;\n        }\n\n        // ===== 3. 存入ThreadLocal =====\n        PmcPortalLogin.LoginInfo loginInfo = new PmcPortalLogin.LoginInfo();\n        loginInfo.setSupId(supId);\n        PmcPortalLogin.setLoginInfo(loginInfo);\n\n        return true; // 鉴权通过，放行请求\n    }\n\n    @Override\n    public void afterCompletion(HttpServletRequest request, HttpServletResponse response, Object handler, Exception ex) {\n        // 清理ThreadLocal（关键！防止线程池复用导致信息泄露）\n        PmcPortalLogin.clear();\n    }\n}",
