                "content": "package com.baidu.pmc.web.configuration;\n\nimport org.springframework.boot.context.properties.ConfigurationProperties;\nimport org.springframework.boot.web.servlet.FilterRegistrationBean;\nimport org.springframework.context.annotation.Bean;\nimport org.springframework.context.annotation.Configuration;\nimport org.springframework.core.Ordered;\n\nimport com.baidu.pmc.web.configuration.uuap.UuapOriginalUrlFilter;\nimport com.baidu.pmc.web.configuration.uuap.UuapSsoCacheComponent;\nimport com.baidu.uuap.authentication.FrontBackSeparationAuthFilter;\nimport com.baidu.uuap.authentication.UuapAuthenticationFilter;\nimport com.baidu.uuap.logout.FrontBackSeparationLogoutFilter;\nimport com.baidu.uuap.logout.UuapLogoutFilter;\n\n/**\n * @author: sunxiaoning\n * @date: 2021/5/17\n */\n@Configuration\npublic class UuapConfig {\n\n    private static final int BASE_ORDER = 1;\n\n    /**\n     * UuapOriginalUrlFilter 拦截器级别\n     */\n    private static final int ORDER_UUAP_ORIGINAL_URL_FILTER = Ordered.HIGHEST_PRECEDENCE + 1;\n\n    @Bean\n    public UuapSsoCacheComponent uuapSsoCacheComponent() {\n        return new UuapSsoCacheComponent();\n    }\n\n    @Bean\n    @ConfigurationProperties(prefix = \"uuap\")\n    public UuapAuthenticationFilter uuapAuthenticationFilter(UuapSsoCacheComponent uuapSsoCacheComponent) {\n        FrontBackSeparationAuthFilter frontBackSeparationAuthFilter = new FrontBackSeparationAuthFilter();\n        frontBackSeparationAuthFilter.setUserCacheService(uuapSsoCacheComponent);\n        return frontBackSeparationAuthFilter;\n    }\n\n    /**\n     * 注册UUAP_SSO验证用户是否登录的Filter\n     *\n     * @return\n     */\n    @Bean\n    public FilterRegistrationBean cas20ValidateRegistration(\n            UuapAuthenticationFilter uuapAuthenticationFilter) {\n        FilterRegistrationBean cas20 = new FilterRegistrationBean();\n        cas20.setFilter(uuapAuthenticationFilter);\n        cas20.setOrder(BASE_ORDER + BASE_ORDER + BASE_ORDER);\n        cas20.addUrlPatterns(\"/*\");\n        return cas20;\n    }\n\n    @Bean\n    @ConfigurationProperties(prefix = \"uuap\")\n    public UuapLogoutFilter uuapLogoutFilter(UuapSsoCacheComponent uuapSsoCacheComponent) {\n        FrontBackSeparationLogoutFilter backSeparationLogoutFilter = new FrontBackSeparationLogoutFilter();\n        backSeparationLogoutFilter.setPostOperate(uuapSsoCacheComponent);\n        return backSeparationLogoutFilter;\n    }\n\n    /**\n     * UUAP退出Filter\n     * @return\n     */\n    @Bean\n    public FilterRegistrationBean cas20LogoutRegistration(UuapLogoutFilter uuapLogoutFilter) {\n        FilterRegistrationBean cas20 = new FilterRegistrationBean();\n        cas20.setFilter(uuapLogoutFilter);\n        cas20.setOrder(BASE_ORDER);\n        cas20.addUrlPatterns(\"/logout\");\n        return cas20;\n    }\n\n    /**\n     * 注入UuapOriginalUrlFilter\n     *\n     * @return\n     */\n    @Bean\n    public UuapOriginalUrlFilter uuapOriginalUrlFilter() {\n        return new UuapOriginalUrlFilter();\n    }\n    /**\n     * 注册UuapOriginalUrlFilter\n     *\n     * @param uuapOriginalUrlFilter\n     * @return\n     */\n    @Bean\n    public FilterRegistrationBean uuapOriginalUrlFilterFilterRegistrationBean(\n            UuapOriginalUrlFilter uuapOriginalUrlFilter) {\n        FilterRegistrationBean registrationBean = new FilterRegistrationBean();\n        registrationBean.setFilter(uuapOriginalUrlFilter);\n        registrationBean.setOrder(ORDER_UUAP_ORIGINAL_URL_FILTER);\n        return registrationBean;\n    }\n}\n",
