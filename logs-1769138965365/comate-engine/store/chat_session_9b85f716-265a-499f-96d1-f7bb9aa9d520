              "result": {
                "content": "package com.baidu.pmc.common.filter;\n\nimport java.io.IOException;\nimport java.util.Arrays;\nimport java.util.Collections;\nimport java.util.HashSet;\nimport java.util.Map;\nimport java.util.Set;\n\nimport javax.annotation.PostConstruct;\nimport javax.servlet.Filter;\nimport javax.servlet.FilterChain;\nimport javax.servlet.FilterConfig;\nimport javax.servlet.ServletException;\nimport javax.servlet.ServletRequest;\nimport javax.servlet.ServletResponse;\nimport javax.servlet.annotation.WebFilter;\nimport javax.servlet.http.HttpServletRequest;\nimport javax.servlet.http.HttpServletResponse;\n\nimport org.springframework.beans.factory.annotation.Value;\nimport org.springframework.core.annotation.Order;\n\nimport com.alibaba.fastjson.JSON;\nimport com.baidu.pmc.common.ResponseMessage;\nimport com.baidu.pmc.common.utils.SignUtils;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.google.common.collect.Maps;\n\nimport lombok.extern.slf4j.Slf4j;\n\n/**\n * filter对接口进行鉴权；只需对列表中的uri进行鉴权\n * @author: sunxiaoning\n * @date: 2019/9/26\n */\n@WebFilter(urlPatterns = \"/*\")\n@Order(value = 1)\n@Slf4j\npublic class WebInterfaceAuthFilter implements Filter {\n\n    @Value(\"${pmc.interface.filterPaths}\")\n    public String filterPaths;\n\n    @Value(\"${pmc.interface.permitApps}\")\n    private String psiConfigs;\n\n    private static Set<String> AUTH_PATHS = new HashSet<>();\n\n    @PostConstruct\n    public void init() {\n        AUTH_PATHS = Collections.unmodifiableSet(new HashSet<>(Arrays.asList(filterPaths.split(\",\"))));\n    }\n\n    @Override\n    public void init(FilterConfig filterConfig) {\n        System.out.println(\"----init interface filter----\");\n    }\n\n    @Override\n    public void doFilter(ServletRequest req, ServletResponse res, FilterChain chain)\n            throws IOException, ServletException {\n        HttpServletRequest request = (HttpServletRequest) req;\n        HttpServletResponse response = (HttpServletResponse) res;\n        String path = request.getRequestURI().substring(request.getContextPath().length()).replaceAll(\"[/]+$\", \"\");\n        boolean filterPath = AUTH_PATHS.contains(path);\n\n        if (filterPath) {\n            log.info(\"外围系统IP:{};访问:{}\", getIpAddress(request), path);\n            String appCode = request.getHeader(\"accessKey\");\n            String timestamp = request.getHeader(\"timestamp\");\n            String sign = request.getHeader(\"sign\");\n            log.info(\"appCode:{};timestamp:{};sign:{}\", appCode, timestamp, sign);\n\n            response.setCharacterEncoding(\"UTF-8\");\n            response.setContentType(\"application/json; charset=utf-8\");\n            ResponseMessage result = ResponseMessage.fail(\"访问接口鉴权失败!\");\n            // 1、对鉴权参数是否为空判断\n            if (StringUtils.isEmpty(appCode) || StringUtils.isEmpty(timestamp) || StringUtils.isEmpty(sign)) {\n                response.getWriter().write(JSON.toJSONString(result));\n                return;\n            }\n\n            // 2、请求超过指定时间就过期，不允许调用\n            long times = Long.valueOf(timestamp);\n            long expireTime = times + 5 * 60 * 1000;\n            long nowDate = System.currentTimeMillis();\n            if (expireTime < nowDate) {\n                log.info(\"check interface Auth failed,请求时间戳过期...\");\n                response.getWriter().write(JSON.toJSONString(result));\n                return;\n            }\n\n            // 3、验证签名\n            String privateKey = getPrivateKeyFromConfig(appCode);\n            String signStr = SignUtils.getMD5StrWith32(appCode + timestamp + privateKey);\n            if (sign.equals(signStr)) {\n                chain.doFilter(req, res);\n            } else {\n                log.info(\"check interface Auth failed,sign={}，接收的sign={}\", signStr, sign);\n                response.getWriter().write(JSON.toJSONString(result));\n                return;\n            }\n        } else {\n            chain.doFilter(req, res);\n        }\n    }\n\n    @Override\n    public void destroy() {\n        System.out.println(\"----destroy interface filter----\");\n    }\n\n\n    /**\n     * 获取用户真实IP地址，不使用request.getRemoteAddr()的原因是有可能用户使用了代理软件方式避免真实IP地址\n     * @param request\n     * @return\n     */\n    public static String getIpAddress(HttpServletRequest request) {\n        String ip = request.getHeader(\"x-forwarded-for\");\n        if (ip == null || ip.length() == 0 || \"unknown\".equalsIgnoreCase(ip)) {\n            ip = request.getHeader(\"Proxy-Client-IP\");\n        }\n        if (ip == null || ip.length() == 0 || \"unknown\".equalsIgnoreCase(ip)) {\n            ip = request.getHeader(\"WL-Proxy-Client-IP\");\n        }\n        if (ip == null || ip.length() == 0 || \"unknown\".equalsIgnoreCase(ip)) {\n            ip = request.getHeader(\"HTTP_CLIENT_IP\");\n        }\n        if (ip == null || ip.length() == 0 || \"unknown\".equalsIgnoreCase(ip)) {\n            ip = request.getHeader(\"HTTP_X_FORWARDED_FOR\");\n        }\n        if (ip == null || ip.length() == 0 || \"unknown\".equalsIgnoreCase(ip)) {\n            ip = request.getRemoteAddr();\n        }\n        String[] ips = ip.split(\",\");\n        if (ips.length > 1) {\n            return ips[0];\n        } else {\n            return ip;\n        }\n    }\n\n    /**\n     * 从配置文件中读取appCode对应的privateKey\n     * @param appCode\n     * @return\n     */\n    public String getPrivateKeyFromConfig(String appCode) {\n        Map<String, String> map = Maps.newHashMap();\n        String[] configs = psiConfigs.split(\";\");\n        for (int i = 0; i < configs.length; i++) {\n            String config = configs[i];\n            if (StringUtils.isNotBlank(config) && config.split(\":\").length >= 2) {\n                map.put(config.split(\":\")[0], config.split(\":\")[1]);\n            }\n            if (StringUtils.isNotBlank(config) && config.split(\":\").length >= 2) {\n                map.put(config.split(\":\")[0], config.split(\":\")[1]);\n            }\n        }\n        if (map.isEmpty()) {\n            return null;\n        } else {\n            return map.get(appCode);\n        }\n    }\n\n    public static void main(String[] args) {\n        long nowDate = System.currentTimeMillis();\n        System.out.println(nowDate);\n        System.out.println(SignUtils.getMD5StrWith32(\"FSSC-local\" + String.valueOf(nowDate) + \"local-test123456\"));\n    }\n\n\n}\n",
