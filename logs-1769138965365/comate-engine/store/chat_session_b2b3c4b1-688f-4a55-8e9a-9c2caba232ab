m));\n\n        PmcCmbCloudDirectQO qo = buildCloudDirectQo(submitQO);\n        CmbResponse<FinanceApplyQueryResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FINANCING_APPLY_DETAILS.getCode(), request, qo,\n                    new TypeReference<CmbResponse<FinanceApplyQueryResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"fail to get financing cal result， request: {}\", UtilType.bean2Json(request), e);\n        }\n        if (Objects.isNull(response)) {\n            log.error(\"fail to get financing cal result, request: {}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"融资申请查询失败\");\n        }\n        // todo:把 response 转换成需要的统一格式结果\n        FinancingApplyResultQueryDTO resultQueryDTO = new FinancingApplyResultQueryDTO();\n\n        FinanceApplyQueryResponse applyResponse = response.getResponse().getBody();\n        if (applyResponse == null) {\n            log.error(\"fail to get financing cal result, request: {}, response {}\",\n                    UtilType.bean2Json(request), UtilType.bean2Json(response));\n            return ResponseMessage.fail(\"融资申请查询失败\");\n        }\n        List<FinanceApplyQueryResponse.ContInfo> contInfos = applyResponse.getTdorpquyy();\n        List<FinanceApplyQueryResponse.FeeInfo> feeInfos = applyResponse.getTdorpquyz();\n        List<FinanceApplyQueryResponse.DocumentInfo> documentInfos = applyResponse.getTdorpquyw();\n        if (CollectionUtils.isNotEmpty(contInfos)) {\n            FinanceApplyQueryResponse.ContInfo contInfo = contInfos.get(0);\n            resultQueryDTO.setTransferRequestId(contInfo.getTreqid());\n            resultQueryDTO.setCoreCorpCode(contInfo.getCorcod());\n            resultQueryDTO.setCoreCorpName(contInfo.getCornam());\n            resultQueryDTO.setTotalCount(contInfo.getTotsum());\n            resultQueryDTO.setTotalAmount(contInfo.getTotamt());\n            resultQueryDTO.setSupplierName(contInfo.getSmfnam());\n            resultQueryDTO.setSupplierCode(contInfo.getSmfcod());\n            resultQueryDTO.setApplyDate(contInfo.getOpdate());\n            resultQueryDTO.setDueDate(contInfo.getEnddat());\n            resultQueryDTO.setLoanStartDate(contInfo.getRelopd());\n            resultQueryDTO.setLoanEndDate(contInfo.getRelend());\n            resultQueryDTO.setFinanceAmount(contInfo.getFinamt());\n            resultQueryDTO.setFinanceType(contInfo.getFintyp());\n            resultQueryDTO.setSource(contInfo.getSource());\n            resultQueryDTO.setBusinessType(contInfo.getBiztyp());\n            resultQueryDTO.setOperationStatus(contInfo.getOprsts());\n            resultQueryDTO.setCurrency(Constants.Currency.cmbCode2Code(contInfo.getFinccy()));\n            resultQueryDTO.setFinanceRate(contInfo.getFinrat());\n            resultQueryDTO.setInterest(contInfo.getIntere());\n        }\n        if (CollectionUtils.isNotEmpty(feeInfos)) {\n            FinanceApplyQueryResponse.FeeInfo feeInfo = feeInfos.get(0);\n            resultQueryDTO.setFeeRate(feeInfo.getFerate());\n            resultQueryDTO.setFeeAmount(feeInfo.getFeeamt());\n            resultQueryDTO.setPaymentMethod(feeInfo.getPaytra());\n            resultQueryDTO.setPaymentAccount(feeInfo.getPayacc());\n            resultQueryDTO.setFeeType(feeInfo.getFeetyp());\n            resultQueryDTO.setServiceProviderName(feeInfo.getSernam());\n            resultQueryDTO.setServiceAccount(feeInfo.getSeracc());\n            resultQueryDTO.setBankName(feeInfo.getOpname());\n        }\n        if (CollectionUtils.isNotEmpty(documentInfos)) {\n            FinanceApplyQueryResponse.DocumentInfo documentInfo = documentInfos.get(0);\n            resultQueryDTO.setSupplierAccount(documentInfo.getSmfacc());\n            resultQueryDTO.setSupplierCode(documentInfo.getSmfcod());\n            resultQueryDTO.setSupplierBank(documentInfo.getSmfbak());\n            resultQueryDTO.setSupplierAddress(documentInfo.getSmfadd());\n            resultQueryDTO.setContractId(documentInfo.getContid());\n            resultQueryDTO.setContractName(documentInfo.getConnam());\n            resultQueryDTO.setDocumentId(documentInfo.getDocuid());\n            resultQueryDTO.setDocumentAmount(documentInfo.getDocamt());\n            resultQueryDTO.setPayableAmount(documentInfo.getRevamt());\n            resultQueryDTO.setPayableStartDate(documentInfo.getCaltim());\n            resultQueryDTO.setDocumentType(documentInfo.getDoctyp());\n            resultQueryDTO.setBuyerAccount(documentInfo.getBuyacc());\n            resultQueryDTO.setRemark(documentInfo.getRemark());\n            resultQueryDTO.setPayPlanDate(documentInfo.getPrdexp());\n        }\n        return ResponseMessage.success(resultQueryDTO);\n    }\n\n    @Override\n    public ResponseMessage financingQuotaQuery(PmcFinanceBankBaseQO queryQO) {\n        FinancingQuotaQryRequest request = new FinancingQuotaQryRequest();\n        FinancingQuotaQryRequest.FinancingQuotaQry quotaQry = new FinancingQuotaQryRequest.FinancingQuotaQry();\n        quotaQry.setCoreid(bankCoreId);\n        // quotaQry.setCrdtid(bankCreditId);\n        quotaQry.setCotype(CoType.CORE_ENT.getCode());\n        request.setPchxcquyx(Collections.singletonList(quotaQry));\n        PmcCmbCloudDirectQO qo = buildCloudDirectQo(queryQO);\n        CmbResponse<FinancingQuotaQryResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FINANCING_QUOTA_QRY.getCode(), request, qo,\n                    new TypeReference<CmbResponse<FinancingQuotaQryResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"fail to query financing quota, request :{}\", UtilType.bean2Json(request), e);\n        }\n        if (Objects.isNull(response)) {\n            log.error(\"fail to query financing quota, request :{}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"招行云直联查询额度失败\");\n        }\n        FinanceQuotaDTO quotaDTO = new FinanceQuotaDTO();\n        FinancingQuotaQryResponse quotaRes = response.getResponse().getBody();\n        if (Objects.nonNull(quotaRes)) {\n            List<FinancingQuota> quotas = quotaRes.getPchxcquyw();\n            if (CollectionUtils.isEmpty(quotas)) {\n                return ResponseMessage.fail(\"招行云智联未返回结果\");\n            }\n            FinancingQuota quota = quotas.get(0);\n            quotaDTO.setCurrency(Constants.Currency.cmbCode2Code(quota.getExoccy()));\n            quotaDTO.setCreditType(quota.getCrdtyp());\n            quotaDTO.setStartDate(quota.getStadat());\n            quotaDTO.setEndDate(quota.getEnddat());\n            quotaDTO.setIsExop(quota.getIsexop());\n            quotaDTO.setExoAmount(quota.getExoamt());\n            quotaDTO.setExoUsedAmount(quota.getEudamt());\n            quotaDTO.setExoAvailableAmount(quota.getEavamt());\n            quotaDTO.setCreditAmount(quota.getCrdamt());\n            quotaDTO.setCreditUsedAmount(quota.getCudamt());\n            quotaDTO.setCreditAvailableAmount(quota.getCavamt());\n            quotaDTO.setCreditStatus(quota.getCrests());\n        }\n        return ResponseMessage.success(quotaDTO);\n    }\n\n    @Override\n    public ResponseMessage uploadAttachment(PmcFinanceBankBaseQO uploadQO) {\n        // todo: 上传合同和发票，改为供应商在银行上传，展示不用接入\n        if (StringUtils.isBlank(uploadQO.getFilePath())) {\n            return ResponseMessage.fail(\"缺少附件信息\");\n        }\n        FileUploadRequest request = new FileUploadRequest();\n        request.setFilepath(uploadQO.getFilePath());\n        CmbResponse<FileUploadResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FILE_UPLOAD.getCode(), request, buildCloudDirectQo(uploadQO),\n                    new TypeReference<CmbResponse<FileUploadResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"fail to upload\");\n            return ResponseMessage.fail(\"附件上传失败\");\n        }\n        if (Objects.isNull(response)) {\n            log.error(\"fail to upload file, response is empty, request :{}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"附件上传失败\");\n        }\n        FileUploadResponse uploadResponse = response.getResponse().getBody();\n        String fileKey = uploadResponse.getFilkey();\n        if (StringUtils.isBlank(fileKey)) {\n            return ResponseMessage.fail(\"文件上传失败\");\n        }\n        return ResponseMessage.success(fileKey);\n    }\n\n    @Override\n    public ResponseMessage attachmentRelate(PmcFinanceBankBaseQO supplementQO) {\n\n        AttachmentBindRequest request = new AttachmentBindRequest();\n        AttachmentBindRequest.ApplyInfo applyInfo = new AttachmentBindRequest.ApplyInfo();  // 融资申请部分\n        applyInfo.setCoreid(bankCoreId);\n        applyInfo.setBscode(Constants.FunCode.FINANCING_APPLY.getCode());   // 这里固定为融资申请\n        applyInfo.setYurref(supplementQO.getPayCheckNum()); // 业务参考号，取付款清单号\n        applyInfo.setRelyrf(supplementQO.getPayCheckNum()); // todo:关联的融资申请业务参考号,这里还要确定一下取哪个\n        // todo:是否支持多个附件\n        AttachmentBindRequest.AttachmentInfo attachmentInfo = new AttachmentBindRequest.AttachmentInfo();   // 附件部分\n        attachmentInfo.setAtthid(supplementQO.getAttachmentNumber());\n        attachmentInfo.setAtthnm(supplementQO.getAttachmentName());\n        request.setPcclbsatx(Collections.singletonList(applyInfo));\n        request.setPcclbsaty(Collections.singletonList(attachmentInfo));\n\n        PmcCmbCloudDirectQO qo = buildCloudDirectQo(supplementQO);\n        CmbResponse<AttachmentBindResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FINANCING_ATTACH_BIND.getCode(), request, qo,\n                    new TypeReference<CmbResponse<AttachmentBindResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"fail to bind attachment\", e);\n        }\n        if (Objects.isNull(response)) {\n            log.error(\"fail to bind attachment, response is empty, request :{}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"附件绑定业务失败\");\n        }\n        AttachmentBindResponse bindResponse = response.getResponse().getBody();\n        List<BindResult> bindResult = bindResponse.getPcclbsatz();\n        if (CollectionUtils.isEmpty(bindResult)) {\n            return ResponseMessage.fail(\"附件绑定业务请求异常\");\n        }\n        if (Constants.CmbResponseCode.BIND_SUCCESS_CODE.equals(bindResult.get(0).getRtncod())) {\n            return ResponseMessage.success(\"绑定成功\");\n        }\n        List<BindResultDetail> details = bindResponse.getPcclbsatw();\n        StringBuilder builder = new StringBuilder();\n        if (CollectionUtils.isNotEmpty(details)) {\n            details.forEach(detail -> {\n                builder.append(detail.getAtthid()).append(\":\").append(detail.getErrmsg()).append(\";\");\n            });\n        }\n        return ResponseMessage.fail(builder.toString());\n    }\n\n    private PmcCmbCloudDirectQO buildCloudDirectQo(PmcFinanceBankBaseQO bankBaseQO) {\n        PmcCmbCloudDirectQO qo = new PmcCmbCloudDirectQO();\n        String acc = RandomStringUtils.randomAlphanumeric(10);\n        if (StringUtils.isNotBlank(bankBaseQO.getBuyerAccount())) {\n            acc = bankBaseQO.getBuyerAccount();\n        }\n        qo.setMachineBank(bankMachine);\n        qo.setAccnbr(acc);\n        qo.setYurref(bankBaseQO.getYurref());   // 作为reqid参数，要求前17位是yyyyMMddHHmmssSSS格式，有前置机可以不传\n        return qo;\n    }\n}\n",
                "content": "package com.baidu.pmc.core.service.impl;\n\nimport com.baidu.pmc.common.ResponseMessage;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.common.utils.UtilType;\nimport com.baidu.pmc.core.constants.Constants;\nimport com.baidu.pmc.core.constants.Constants.CoType;\nimport com.baidu.pmc.core.constants.Constants.FunCode;\nimport com.baidu.pmc.core.dto.AttachmentBindRequest;\nimport com.baidu.pmc.core.dto.AttachmentBindResponse;\nimport com.baidu.pmc.core.dto.AttachmentBindResponse.BindResult;\nimport com.baidu.pmc.core.dto.AttachmentBindResponse.BindResultDetail;\nimport com.baidu.pmc.core.dto.CmbResponse;\nimport com.baidu.pmc.core.dto.FileUploadRequest;\nimport com.baidu.pmc.core.dto.FileUploadResponse;\nimport com.baidu.pmc.core.dto.FinanceApplyQueryRequest;\nimport com.baidu.pmc.core.dto.FinanceApplyQueryResponse;\nimport com.baidu.pmc.core.dto.FinanceApplyRequest;\nimport com.baidu.pmc.core.dto.FinanceApplyResponse;\nimport com.baidu.pmc.core.dto.FinanceEstimateRequest;\nimport com.baidu.pmc.core.dto.FinanceEstimateRequest.FinanceEstimateItem;\nimport com.baidu.pmc.core.dto.FinancingEstimateResponse;\nimport com.baidu.pmc.core.dto.FinancingEstimateResponse.FinancingEstimateResponsePartA;\nimport com.baidu.pmc.core.dto.FinancingEstimateResponse.FinancingEstimateResponsePartB;\nimport com.baidu.pmc.core.dto.FinancingQuotaQryRequest;\nimport com.baidu.pmc.core.dto.FinancingQuotaQryResponse;\nimport com.baidu.pmc.core.dto.FinancingQuotaQryResponse.FinancingQuota;\nimport com.baidu.pmc.core.service.CmbFinancingService;\nimport com.baidu.pmc.pojo.dto.cmb.FinanceQuotaDTO;\nimport com.baidu.pmc.pojo.dto.cmb.FinancingApplyResultDTO;\nimport com.baidu.pmc.pojo.dto.cmb.FinancingApplyResultQueryDTO;\nimport com.baidu.pmc.pojo.dto.cmb.FinancingEstimateResultDTO;\nimport com.baidu.pmc.pojo.dto.cmb.PmcCmbCloudDirectQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceBankBaseQO;\nimport com.fasterxml.jackson.core.type.TypeReference;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections.CollectionUtils;\nimport org.apache.commons.lang3.RandomStringUtils;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.beans.factory.annotation.Value;\nimport org.springframework.stereotype.Service;\n\nimport java.util.Collections;\nimport java.util.List;\nimport java.util.Objects;\n\n@Slf4j\n@Service\npublic class CmbFinancingServiceImpl implements CmbFinancingService {\n\n    @Value(\"${cmb.bank.core.id}\")\n    private String bankCoreId;\n\n    @Value(\"${cmb.bank.machine:CMB002}\")\n    private String bankMachine; // 测试使用CMB002\n\n    @Autowired\n    private CmbCloudDirectBaseService baseService;\n\n\n    @Override\n    public ResponseMessage financingEstimate(PmcFinanceBankBaseQO calcQO) {\n        String currency = Constants.Currency.getCmbCode(calcQO.getCurrency());\n        if (StringUtils.isBlank(currency)) {\n            return ResponseMessage.fail(\"不支持的币种类型\");\n        }\n        FinanceEstimateRequest request = new FinanceEstimateRequest();\n        FinanceEstimateItem item = new FinanceEstimateItem();\n        item.setCoreid(bankCoreId);\n        item.setCotype(CoType.CORE_ENT.getCode());\n        item.setSmfcod(calcQO.getRegistrationCode());\n        item.setMaxedt(DateUtils.formatDate(calcQO.getPayPlanDate(), \"yyyyMMdd\"));\n        item.setFinamt(calcQO.getFinanceAmount());    // 融资合计金额\n        item.setDocamt(calcQO.getDocAmt());    // 应付账款合计金额\n        item.setBilamt(calcQO.getBilAmt());    // 票面合计金额\n        item.setDocnum(1);  // 固定为 1\n        item.setFinccy(currency);\n        request.setTdorpcalx(Collections.singletonList(item));\n\n        PmcCmbCloudDirectQO qo = buildCloudDirectQo(calcQO);\n        CmbResponse<FinancingEstimateResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FINANCING_CAL.getCode(), request, qo,\n                    new TypeReference<CmbResponse<FinancingEstimateResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"fail to get financing cal result， request: {}\", UtilType.bean2Json(request), e);\n        }\n        if (Objects.isNull(response)) {\n            log.error(\"fail to get financing cal result, request: {}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"融资测算请求失败\");\n        }\n        FinancingEstimateResponse estimateResponse = response.getResponse().getBody();\n        List<FinancingEstimateResponsePartA> partAList = estimateResponse.getTdorpcaly();\n        List<FinancingEstimateResponsePartB> partBList = estimateResponse.getTdorpcalz();\n\n        // todo:把 response 转换成需要的统一格式结果\n        FinancingEstimateResultDTO estimateResult = new FinancingEstimateResultDTO();\n        if (CollectionUtils.isNotEmpty(partAList)) {\n            FinancingEstimateResponsePartA partA = partAList.get(0);\n            estimateResult.setCurrency(Constants.Currency.cmbCode2Code(partA.getFinccy()));\n            estimateResult.setEndDate(partA.getEnddat());\n            estimateResult.setFinanceAmount(partA.getFinamt());\n            estimateResult.setFinanceRate(partA.getFinrat());\n            estimateResult.setFinancePercent(partA.getFinpro());\n            estimateResult.setSettlementMode(partA.getSetmod());    // todo:映射\n        }\n        if (CollectionUtils.isNotEmpty(partBList)) {\n            FinancingEstimateResponsePartB partB = partBList.get(0);\n            estimateResult.setFeeAmount(partB.getFeeamt());\n            estimateResult.setFeeRate(partB.getFerate());\n            estimateResult.setFeeType(partB.getFeetyp());   // todo:映射\n            estimateResult.setPayAccount(partB.getPayacc());\n            estimateResult.setPayRate(partB.getSfnrat());\n            estimateResult.setPayAmount(partB.getSfnamt());\n            estimateResult.setOtherAmount(partB.getOthamt());\n        }\n        return ResponseMessage.success(estimateResult);\n    }\n\n    @Override\n    public ResponseMessage financingApply(PmcFinanceBankBaseQO submitQO) {\n        String currency = Constants.Currency.getCmbCode(submitQO.getCurrency());\n        if (StringUtils.isBlank(currency)) {\n            return ResponseMessage.fail(\"不支持的币种类型\");\n        }\n        FinanceApplyRequest request = new FinanceApplyRequest();\n\n        FinanceApplyRequest.FinanceApplyItemBase item = new FinanceApplyRequest.FinanceApplyItemBase();\n        item.setCoreid(bankCoreId);\n        item.setCotype(CoType.CORE_ENT.getCode());\n        item.setYurref(submitQO.getFinanceNumber());\n        item.setSmfcod(submitQO.getRegistrationCode());\n        // 固定为 02310100：国内保理\n        item.setBiztyp(StringUtils.isBlank(submitQO.getBizType()) ? \"02310100\" : submitQO.getBizType());\n        item.setFinccy(currency);\n        request.setTdorpaddx(Collections.singletonList(item));\n\n        FinanceApplyRequest.FinanceApplyItemCont itemCont = new FinanceApplyRequest.FinanceApplyItemCont();\n\n        itemCont.setSmfacc(submitQO.getSupplierAccount());\n        itemCont.setSmfbak(submitQO.getSupplierBank());\n        itemCont.setSmfadd(submitQO.getSupplierAddress());\n        itemCont.setRevCcy(currency);\n        itemCont.setRevamt(submitQO.getPayableAmount());\n        itemCont.setPrdexp(DateUtils.formatDate(submitQO.getPayPlanDate(), \"yyyyMMdd\"));\n        itemCont.setDocamt(submitQO.getDocumentAmount());\n        itemCont.setDocuid(submitQO.getInvoiceNumber());\n        // 01订单、02结算单、03发票、04付款承诺、05其他\n        itemCont.setDoctyp(StringUtils.isBlank(submitQO.getInvoiceType()) ? \"03\" : submitQO.getInvoiceType());\n        request.setTdorpaddy(Collections.singletonList(itemCont));\n\n        PmcCmbCloudDirectQO qo = buildCloudDirectQo(submitQO);\n        CmbResponse<FinanceApplyResponse> response = null;\n        try {\n            response = baseService.requestCMB(FunCode.FINANCING_APPLY.getCode(), request, qo,\n                    new TypeReference<CmbResponse<FinanceApplyResponse>>() {\n                    });\n        } catch (Exception e) {\n            log.error(\"fail to get financing cal result， request: {}\", UtilType.bean2Json(request), e);\n        }\n        if (Objects.isNull(response) || Objects.isNull(response.getResponse())) {\n            log.error(\"fail to get financing cal result, request: {}\", UtilType.bean2Json(request));\n            return ResponseMessage.fail(\"融资申请请求失败\");\n        }\n        FinanceApplyResponse applyResponse = response.getResponse().getBody();\n        FinancingApplyResultDTO resultDTO = new FinancingApplyResultDTO();\n        List<FinanceApplyResponse.MainResponse> mainResponseList = applyResponse.getTdorpaddz();\n        if (CollectionUtils.isNotEmpty(mainResponseList)) {\n            FinanceApplyResponse.MainResponse mainResponse = mainResponseList.get(0);\n            if (!\"SCDS000\".equals(mainResponse.getRtncod())) {\n                log.error(\"fail to get financing cal result, request: {}, response: {}\",\n                        UtilType.bean2Json(request), UtilType.bean2Json(response));\n                return ResponseMessage.fail(\"融资申请请求结果失败\");\n            }\n            resultDTO.setFinanceNumber(mainResponse.getFinnbr());\n            resultDTO.setFinanceCode(mainResponse.getRtncod());\n            resultDTO.setFinanceMessage(mainResponse.getRtnmsg());\n        }\n        return ResponseMessage.success(resultDTO);\n    }\n\n    @Override\n    public ResponseMessage financingApplyDetails(PmcFinanceBankBaseQO submitQO) {\n\n        FinanceApplyQueryRequest request = new FinanceApplyQueryRequest();\n\n        FinanceApplyQueryRequest.FinanceApplyItemBase item = new FinanceApplyQueryRequest.FinanceApplyItemBase();\n        item.setCoreid(bankCoreId);\n        item.setCotype(CoType.CORE_ENT.getCode());\n        item.setFinnbr(submitQO.getFinanceNumber());\n        request.setTdorpquyx(Collections.singletonList(item));\n\n