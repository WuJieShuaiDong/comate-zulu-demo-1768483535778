;\n\n        String result = bcmBankStrategy.selectElectReceipt(payQO);\n        assertEquals(expectedResult, result);\n        verify(bankcommonReceiptService).selectElectReceipt(eq(payQO), any());\n    }\n\n    @Test\n    public void testSelectBankcommonRefund() {\n        // 测试查询银行退款\n        PayQO payQO = new PayQO();\n        payQO.setBank(\"B033\");\n        String expectedResult = \"退款查询结果\";\n        when(bankcommonService.selectBankcommonRefund(eq(payQO), any())).thenReturn(expectedResult);\n\n        String result = bcmBankStrategy.selectBankcommonRefund(payQO);\n        assertEquals(expectedResult, result);\n        verify(bankcommonService).selectBankcommonRefund(eq(payQO), any());\n    }\n\n    @Test\n    public void testSelectBankBalanceOld() {\n        // 测试查询银行历史余额\n        BankcommonBalanceOldQO bankcommonBalanceOldQO = new BankcommonBalanceOldQO();\n        List<TmsAccountBalanceCmb> expectedResult = new ArrayList<>();\n        when(bankcommonService.selectBankcommonBalanceOld(eq(bankcommonBalanceOldQO), any())).thenReturn(expectedResult);\n\n        List<TmsAccountBalanceCmb> result = bcmBankStrategy.selectBankBalanceOld(bankcommonBalanceOldQO);\n        assertEquals(expectedResult, result);\n        verify(bankcommonService).selectBankcommonBalanceOld(eq(bankcommonBalanceOldQO), any());\n    }\n\n    @Test\n    public void testGenerateBankPayInstructs() {\n        // 测试生成银行支付指令\n        String bankCode = \"B033\";\n        List<PayChecksDTO> checks = new ArrayList<>();\n\n        PayChecksDTO check1 = new PayChecksDTO();\n        check1.setPayCheckNum(\"PC001\");\n        check1.setInterBankFlag(Constants.ENABLED_Y);\n        check1.setBeneficiaryTypeFlag(\"PERSONAL\");\n        check1.setAttribute3Name(\"招商银行\");\n        check1.setAttribute4(\"北京分行\");\n        check1.setAttribute5Name(\"北京市\");\n        check1.setAttribute6Name(\"海淀区\");\n        checks.add(check1);\n\n        List<Map<String, Object>> expectedInstructs = new ArrayList<>();\n 