        "content": "package com.baidu.tms.loan.controller;\n\nimport com.baidu.ce.config.ExportRepeatCheckLock;\nimport com.baidu.p2p.commons.constants.CommonEnums;\nimport com.baidu.p2p.core.j2ee.action.JsonResult;\nimport com.baidu.p2p.core.j2ee.action.ResponseStream;\nimport com.baidu.p2p.core.j2ee.exception.WebException;\nimport com.baidu.p2p.core.j2ee.web.BaseController;\nimport com.baidu.p2p.core.poi.excel.utils.ExcelKit;\nimport com.baidu.p2p.core.utils.DateUtils;\nimport com.baidu.p2p.core.utils.StringUtils;\nimport com.baidu.p2p.pay.facade.dto.CodedLabel;\nimport com.baidu.tms.loan.domain.LoanBankDrawDetail;\nimport com.baidu.tms.loan.domain.LoanBankDrawList;\nimport com.baidu.tms.loan.domain.LoanBankIrsDetail;\nimport com.baidu.tms.loan.domain.LoanBankListDetail;\nimport com.baidu.tms.loan.domain.LoanBankReqHead;\nimport com.baidu.tms.loan.domain.LoanCommonReqList;\nimport com.baidu.tms.loan.domain.LoanCommonReqQueryCon;\nimport com.baidu.tms.loan.domain.LoanCommonReqSuggest;\nimport com.baidu.tms.loan.domain.LoanReqFind;\nimport com.baidu.tms.loan.service.LoanBankReqService;\nimport com.baidu.tms.loan.service.LoanSelectInitComponent;\nimport com.github.pagehelper.PageInfo;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.validation.BindingResult;\nimport org.springframework.validation.annotation.Validated;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.RestController;\n\nimport javax.servlet.http.HttpServletRequest;\nimport javax.servlet.http.HttpServletResponse;\nimport java.io.InputStream;\nimport java.util.List;\nimport java.util.Map;\n\nimport static com.baidu.p2p.core.j2ee.action.JsonResult.failJsonResult;\nimport static com.baidu.p2p.core.j2ee.action.JsonResult.failJsonResultWithData;\nimport static com.baidu.p2p.core.j2ee.action.JsonResult.okJsonResult;\nimport static com.baidu.p2p.core.j2ee.action.JsonResult.okJsonResultWithData;\nimport static com.baidu.p2p.core.j2ee.action.JsonResult.okJsonResultWithMsg;\n\n@RestController\n@RequestMapping(\"/loan/bankReq\")\npublic class LoanBankReqController extends BaseController {\n\n    @Autowired\n    LoanBankReqService loanBankReqService;\n    @Autowired\n    private LoanSelectInitComponent loanSelectInitComponent;\n\n    /**\n     * loanReqSuggest\n     *\n     * @param condition\n     *\n     * @return\n     */\n    @RequestMapping(\"/reqNumSuggest\")\n    public JsonResult<?> loanReqSuggest(@RequestBody LoanCommonReqQueryCon condition) {\n        List<LoanCommonReqSuggest> list = loanBankReqService.reqNumSuggest(condition);\n        return okJsonResultWithData(list);\n    }\n\n    /**\n     * 查询list\n     *\n     * @param condition\n     *\n     * @return\n     */\n    @RequestMapping(\"/list\")\n    public JsonResult<?> list(@RequestBody LoanCommonReqQueryCon condition) {\n        PageInfo<LoanCommonReqList> pageInfo = loanBankReqService.findByCondition(condition);\n        return okJsonResultWithData(pageInfo);\n    }\n\n    @RequestMapping(\"/initLoanBankReq\")\n    public JsonResult<?> initLoanBankReq() {\n        return okJsonResultWithData(loanBankReqService.initLoanBankReq());\n    }\n\n    @RequestMapping(\"/save\")\n    public JsonResult<?> saveHead(@RequestBody LoanBankReqHead detail) {\n        try {\n            LoanBankReqHead result = loanBankReqService.saveHead(detail);\n            return okJsonResultWithData(result);\n        } catch (Exception e) {\n            logger.error(\"保存失败，失败原因：\", e);\n            return failJsonResult(e.getMessage());\n        }\n    }\n\n    @RequestMapping(\"/saveBank\")\n    public JsonResult<?> saveBank(@RequestBody LoanBankListDetail detail) {\n        try {\n            LoanBankListDetail result = loanBankReqService.saveBankList(detail);\n            return okJsonResultWithData(result);\n        } catch (Exception e) {\n            logger.error(\"保存失败，失败原因：\", e);\n            return failJsonResult(e.getMessage());\n        }\n    }\n\n    @RequestMapping(\"/deleteBank\")\n    public JsonResult<?> deleteBank(@RequestBody LoanReqFind find) {\n        try {\n            loanBankReqService.deleteBankList(find.getId());\n        } catch (Exception e) {\n            logger.error(\"保存失败，失败原因：\", e);\n            return failJsonResult(e.getMessage());\n        }\n        return okJsonResult();\n    }\n\n    @RequestMapping(\"/getDrawNum\")\n    public JsonResult<?> getDrawNum() {\n        String newDrawNum = loanBankReqService.getNewDrawNum();\n        return okJsonResultWithData(newDrawNum);\n    }\n\n    @RequestMapping(\"/getIrsNum\")\n    public JsonResult<?> getIrsNum() {\n        String newIrsNum = loanBankReqService.getNewIrsNum();\n        return okJsonResultWithData(newIrsNum);\n    }\n\n    @RequestMapping(\"/saveDrawDetail\")\n    public JsonResult<?> saveDrawDetail(@RequestBody LoanBankDrawDetail detail) {\n        try {\n            LoanBankDrawDetail result = loanBankReqService.saveDrawIrs(detail);\n            return StringUtils.isEmpty(result.getMessage()) ? JsonResult.okJsonResultWithData(result) :\n                    JsonResult.confirmJsonResultWithMsg(result.getMessage());\n        } catch (Exception e) {\n            logger.error(\"保存提款信息失败，失败原因：\", e);\n            return failJsonResult(e.getMessage());\n        }\n    }\n\n    @RequestMapping(\"/find\")\n    public JsonResult<?> find(@RequestBody @Validated LoanReqFind find, BindingResult result) {\n        if (result.hasErrors()) {\n            return failJsonResultWithData(result.getAllErrors());\n        }\n        return okJsonResultWithData(loanBankReqService.findBankReq(find.getId()));\n    }\n\n    @RequestMapping(\"/init_select\")\n    public JsonResult<?> initSelect() {\n        Map<String, List<CodedLabel>> selectDtoMap = loanSelectInitComponent.getBankReqSelectDtoMap();\n        return okJsonResultWithData(selectDtoMap);\n    }\n\n    @RequestMapping(\"/bankDrawList\")\n    public JsonResult<?> bankDrawList(@RequestBody @Validated LoanReqFind find, BindingResult result) {\n        if (result.hasErrors()) {\n            return failJsonResultWithData(result.getAllErrors());\n        }\n        LoanCommonReqQueryCon condition = new LoanCommonReqQueryCon();\n        condition.setReqId(find.getId());\n        List<LoanBankDrawList> list = loanBankReqService.bankDrawList(condition);\n        return okJsonResultWithData(list);\n    }\n\n    @RequestMapping(\"/terminatIrs\")\n    public JsonResult<?> terminatIrs(@RequestBody LoanBankIrsDetail irsDetail) {\n        try {\n            loanBankReqService.terminatIrs(irsDetail);\n        } catch (Exception e) {\n            logger.error(\"irs终止失败，失败原因：\", e);\n            return failJsonResult(e.getMessage());\n        }\n        return okJsonResult();\n    }\n\n    @RequestMapping(\"/bankPrepayment\")\n    public JsonResult<?> bankPrepayment(@RequestBody List<LoanBankDrawList> prepaymentList) {\n        try {\n            loanBankReqService.bankPrepayment(prepaymentList);\n        } catch (Exception e) {\n            logger.error(\"保存失败，失败原因：\", e);\n            return failJsonResult(e.getMessage());\n        }\n        return okJsonResult();\n    }\n\n    /**\n     * @Author:v_miaopeixin\n     * @Description:融资贷款管理导出Excel功能\n     * @return:JsonResult\n     * @Date: 2018/4/26 13:53\n     */\n    @RequestMapping(\"/loanExportToExcel\")\n    @ExportRepeatCheckLock\n    public void exportExcelData(LoanCommonReqQueryCon condition, HttpServletRequest request,\n                                         HttpServletResponse response, BindingResult result) {\n        if (result.hasErrors()) {\n            throw new WebException(\"参数验证失败\");\n        }\n        try {\n            List<LoanCommonReqList> details = loanBankReqService.getDatasByCondition(condition);\n            //转换日期格式为yyyy-MM-dd\n            details.forEach(\n                    detail -> {\n                        if (detail.getReqDate() != null) {\n                            detail.setReqDateStr(DateUtils.formatDate(detail.getReqDate(), \"yyyy-MM-dd\"));\n                        }\n                    }\n            );\n            String templateName = CommonEnums.ExcelTemplateName.TMS_LOAN_FINACIAL_MANAGE.getValue();\n            InputStream is = ExcelKit.createExcelWithTemp(details, templateName);\n            String fileName = \"融资贷款管理\" + DateUtils.getDate(\"yyyyMMddHHmmss\") + \".xlsx\";\n            ResponseStream.out(is, fileName, ResponseStream.ContentType.EXCEL, request, response);\n        } catch (Exception e) {\n            throw new WebException(\"导出异常\");\n        }\n    }\n}\n",
