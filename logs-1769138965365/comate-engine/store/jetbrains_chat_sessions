ArgumentMatchers.anyString;\nimport static org.mockito.ArgumentMatchers.eq;\nimport static org.mockito.Mockito.verify;\nimport static org.mockito.Mockito.when;\n\npublic class BcmBankStrategyTest extends AbstractServiceTest {\n\n    @Autowired\n    private BcmBankStrategy bcmBankStrategy;\n\n    @MockBean\n    private CommonBankStrategy commonBankStrategy;\n\n    @MockBean\n    private BankcommonService bankcommonService;\n\n    @MockBean\n    private BankcommonReceiptService bankcommonReceiptService;\n\n    @MockBean\n    private MachineService machineService;\n\n    @MockBean\n    private SendMailService mailService;\n\n    @MockBean\n    private PmcPayCommonBankSetMapper pmcPayCommonBankSetMapper;\n\n    @MockBean\n    private AccountService accountService;\n\n    @Test\n    public void testGetBankStrategy() {\n        // 测试银行策略代码返回\n        String result = bcmBankStrategy.getBankStrategy();\n        assertEquals(Constants.BankStrategyCode.BCM, result);\n    }\n\n    @Test\n    public void testGetPayInstructList() {\n        // 测试获取支付指令列表（委托给通用策略）\n        PayInstructQO qo = new PayInstructQO();\n        Page<PayInstructDTO> expectedPage = new Page<>();\n        when(commonBankStrategy.getPayInstructList(qo)).thenReturn(expectedPage);\n\n        Page<PayInstructDTO> result = bcmBankStrategy.getPayInstructList(qo);\n        assertEquals(expectedPage, result);\n        verify(commonBankStrategy).getPayInstructList(qo);\n    }\n\n    @Test\n    public void testGenBankUnUrgentPay() {\n        // 测试生成非紧急支付（委托给通用策略）\n        String bankCode = \"B033\";\n        Integer expectedResult = 10;\n        when(commonBankStrategy.genBankUnUrgentPay(bankCode)).thenReturn(expectedResult);\n\n        Integer result = bcmBankStrategy.genBankUnUrgentPay(bankCode);\n        assertEquals(expectedResult, result);\n        verify(commonBankStrategy).genBankUnUrgentPay(bankCode);\n    }\n\n    @Test\n    public void testSelectBankTrans() {\n        // 测试查询银行交易流水\n        PayQO qo = new 