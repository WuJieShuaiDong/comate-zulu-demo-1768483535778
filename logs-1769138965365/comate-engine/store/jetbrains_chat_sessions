        "content": "<?xml version=\"1.0\" encoding=\"UTF-8\" ?>\n<!DOCTYPE mapper PUBLIC \"-//mybatis.org//DTD Mapper 3.0//EN\" \"http://mybatis.org/dtd/mybatis-3-mapper.dtd\" >\n<mapper namespace=\"com.baidu.pmc.bankcommon.persistence.dao.PmcAccountMapper\" >\n  <resultMap id=\"BaseResultMap\" type=\"com.baidu.pmc.pojo.model.PmcAccount\" >\n    <id column=\"ac_account_id\" property=\"acAccountId\" jdbcType=\"BIGINT\" />\n    <result column=\"account_no\" property=\"accountNo\" jdbcType=\"VARCHAR\" />\n    <result column=\"account_name\" property=\"accountName\" jdbcType=\"VARCHAR\" />\n    <result column=\"category\" property=\"category\" jdbcType=\"VARCHAR\" />\n    <result column=\"legal_entity\" property=\"legalEntity\" jdbcType=\"VARCHAR\" />\n    <result column=\"company_code\" property=\"companyCode\" jdbcType=\"VARCHAR\" />\n    <result column=\"bank\" property=\"bank\" jdbcType=\"VARCHAR\" />\n    <result column=\"branch\" property=\"branch\" jdbcType=\"VARCHAR\" />\n    <result column=\"branch_name\" property=\"branchName\" jdbcType=\"VARCHAR\" />\n    <result column=\"country\" property=\"country\" jdbcType=\"VARCHAR\" />\n    <result column=\"province\" property=\"province\" jdbcType=\"VARCHAR\" />\n    <result column=\"city\" property=\"city\" jdbcType=\"VARCHAR\" />\n    <result column=\"open_date\" property=\"openDate\" jdbcType=\"TIMESTAMP\" />\n    <result column=\"state\" property=\"state\" jdbcType=\"VARCHAR\" />\n    <result column=\"orig_character\" property=\"origCharacter\" jdbcType=\"VARCHAR\" />\n    <result column=\"orig_usage\" property=\"origUsage\" jdbcType=\"VARCHAR\" />\n    <result column=\"type\" property=\"type\" jdbcType=\"VARCHAR\" />\n    <result column=\"currency\" property=\"currency\" jdbcType=\"VARCHAR\" />\n    <result column=\"multi_currency_payment\" property=\"multiCurrencyPayment\" jdbcType=\"VARCHAR\" />\n    <result column=\"fin_account\" property=\"finAccount\" jdbcType=\"VARCHAR\" />\n    <result column=\"fin_account_instruction\" property=\"finAccountInstruction\" jdbcType=\"VARCHAR\" />\n    <result column=\"create_by\" property=\"createBy\" jdbcType=\"VARCHAR\" />\n    <result column=\"create_date\" property=\"createDate\" jdbcType=\"TIMESTAMP\" />\n    <result column=\"last_update_by\" property=\"lastUpdateBy\" jdbcType=\"VARCHAR\" />\n    <result column=\"last_update_date\" property=\"lastUpdateDate\" jdbcType=\"TIMESTAMP\" />\n    <result column=\"attribute1\" property=\"attribute1\" jdbcType=\"VARCHAR\" />\n    <result column=\"attribute2\" property=\"attribute2\" jdbcType=\"VARCHAR\" />\n    <result column=\"attribute3\" property=\"attribute3\" jdbcType=\"VARCHAR\" />\n    <result column=\"attribute4\" property=\"attribute4\" jdbcType=\"VARCHAR\" />\n    <result column=\"attribute5\" property=\"attribute5\" jdbcType=\"VARCHAR\" />\n    <result column=\"attribute6\" property=\"attribute6\" jdbcType=\"VARCHAR\" />\n    <result column=\"attribute7\" property=\"attribute7\" jdbcType=\"VARCHAR\" />\n    <result column=\"attribute8\" property=\"attribute8\" jdbcType=\"VARCHAR\" />\n    <result column=\"attribute9\" property=\"attribute9\" jdbcType=\"VARCHAR\" />\n    <result column=\"attribute10\" property=\"attribute10\" jdbcType=\"VARCHAR\" />\n    <result column=\"attribute11\" property=\"attribute11\" jdbcType=\"VARCHAR\" />\n    <result column=\"attribute12\" property=\"attribute12\" jdbcType=\"VARCHAR\" />\n    <result column=\"attribute13\" property=\"attribute13\" jdbcType=\"VARCHAR\" />\n    <result column=\"attribute14\" property=\"attribute14\" jdbcType=\"VARCHAR\" />\n    <result column=\"attribute15\" property=\"attribute15\" jdbcType=\"VARCHAR\" />\n    <result column=\"attribute16\" property=\"attribute16\" jdbcType=\"VARCHAR\" />\n    <result column=\"attribute17\" property=\"attribute17\" jdbcType=\"VARCHAR\" />\n    <result column=\"attribute18\" property=\"attribute18\" jdbcType=\"VARCHAR\" />\n    <result column=\"attribute19\" property=\"attribute19\" jdbcType=\"VARCHAR\" />\n    <result column=\"attribute20\" property=\"attribute20\" jdbcType=\"VARCHAR\" />\n    <result column=\"open_by\" property=\"openBy\" jdbcType=\"VARCHAR\" />\n    <result column=\"open_bill\" property=\"openBill\" jdbcType=\"VARCHAR\" />\n    <result column=\"open_remark\" property=\"openRemark\" jdbcType=\"VARCHAR\" />\n    <result column=\"close_by\" property=\"closeBy\" jdbcType=\"VARCHAR\" />\n    <result column=\"close_bill\" property=\"closeBill\" jdbcType=\"VARCHAR\" />\n    <result column=\"close_date\" property=\"closeDate\" jdbcType=\"TIMESTAMP\" />\n    <result column=\"close_remark\" property=\"closeRemark\" jdbcType=\"VARCHAR\" />\n    <result column=\"contact_by\" property=\"contactBy\" jdbcType=\"VARCHAR\" />\n    <result column=\"contact_phone\" property=\"contactPhone\" jdbcType=\"VARCHAR\" />\n    <result column=\"contact_position\" property=\"contactPosition\" jdbcType=\"VARCHAR\" />\n    <result column=\"authorizer_by\" property=\"authorizerBy\" jdbcType=\"VARCHAR\" />\n    <result column=\"authorizer_phone\" property=\"authorizerPhone\" jdbcType=\"VARCHAR\" />\n    <result column=\"authorizer_position\" property=\"authorizerPosition\" jdbcType=\"VARCHAR\" />\n    <result column=\"bank_agreement_code\" property=\"bankAgreementCode\" jdbcType=\"VARCHAR\" />\n    <result column=\"bank_number\" property=\"bankNumber\" jdbcType=\"VARCHAR\" />\n    <result column=\"service_content\" property=\"serviceContent\" jdbcType=\"VARCHAR\" />\n    <result column=\"tenant_id\" jdbcType=\"BIGINT\" property=\"tenantId\" />\n  </resultMap>\n\n  <select id=\"queryBankcommonAccount\" resultMap=\"BaseResultMap\">\n    SELECT\n    account_no, type, bank, type, currency, tenant_id, branch, branch_name,country\n    FROM\n    pmc_account\n    WHERE state = 'OPEN' and attribute1 = 'Y' and type in ('HOME','ABROAD')\n    <if test=\"bank != null and bank != ''\">\n      and bank = #{bank}\n    </if>\n    <if test=\"company != null and company != ''\">\n      and company_code = #{company}\n    </if>\n    <if test=\"account != null and account != ''\">\n      and account_no = #{account,jdbcType=VARCHAR}\n    </if>\n    <if test=\"accountNumber != null and accountNumber != ''\">\n      and account_no = #{accountNumber,jdbcType=VARCHAR}\n    </if>\n    <if test=\"bankAccount != null and bankAccount != ''\">\n      and account_no = #{bankAccount,jdbcType=VARCHAR}\n    </if>\n    group by account_no, bank, currency\n  </select>\n\n  <select id=\"queryBankcommonAccountByAccountNo\" resultMap=\"BaseResultMap\">\n    SELECT * FROM pmc_account\n    <where>\n      state = 'OPEN' and attribute1 = 'Y' and type in ('HOME','ABROAD')\n      <if test=\"bank != null and bank != ''\">\n        and bank = #{bank,jdbcType=VARCHAR}\n      </if>\n      <if test=\"account != null and account != ''\">\n        and account_no = #{account,jdbcType=VARCHAR}\n      </if>\n      <if test=\"accountNumber != null and accountNumber != ''\">\n        and account_no = #{accountNumber,jdbcType=VARCHAR}\n      </if>\n      <if test=\"bankAccount != null and bankAccount != ''\">\n        and account_no = #{bankAccount,jdbcType=VARCHAR}\n      </if>\n    </where>\n    limit 1\n  </select>\n\n  <select id=\"selectAccountsWithDirectConnectButNoReceipt\" resultMap=\"BaseResultMap\">\n    SELECT * FROM pmc_account\n    WHERE state = 'OPEN'\n    AND service_content LIKE '%DIRECT_CONNECT%'\n    AND (attribute12 IS NULL OR attribute12 != 'ENABLED')\n  </select>\n\n</mapper>",
