ransaction.getBusinessType());\n        assertEquals(\"流水号不正确\", \"EBB0001P70190041\", firstTransaction.getSerialNumber());\n        assertEquals(\"流水序号不正确\", \"1\", firstTransaction.getSequenceNumber());\n        assertEquals(\"账号不正确\", \"310069079018800073806\", firstTransaction.getAccountNumber());\n        assertEquals(\"户名不正确\", \"怒访址撵鉴遮斌粤惨佣\", firstTransaction.getAccountName());\n        assertEquals(\"收支标志不正确\", \"D\", firstTransaction.getIncomeExpenseFlag());\n        assertEquals(\"币种不正确\", \"CNY\", firstTransaction.getCurrency());\n        assertEquals(\"交易金额不正确\", \"100.00\", firstTransaction.getTransactionAmount());\n        assertEquals(\"余额不正确\", \"11991096.17\", firstTransaction.getBalance());\n        assertEquals(\"可用余额不正确\", \"0\", firstTransaction.getAvailableBalance());\n        assertEquals(\"附言不正确\", \"q2yuyh5004#测试1\", firstTransaction.getRemarkMemo());\n        assertEquals(\"交易码不正确\", \"101700\", firstTransaction.getTransactionCode());\n\n        // 验证第二条记录\n        BankTransaction secondTransaction = transactions.get(1);\n        assertEquals(\"第二条记录的流水号不正确\", \"EBB0001P70080041\", secondTransaction.getSerialNumber());\n        assertEquals(\"第二条记录的流水序号不正确\", \"2\", secondTransaction.getSequenceNumber());\n        assertEquals(\"第二条记录的余额不正确\", \"11990996.17\", secondTransaction.getBalance());\n\n        log.info(\"✅ 测试通过：成功解析 {} 条银行交易记录\", transactions.size());\n        BankTransactionParser.printParsingResult(transactions);\n    }\n\n    /**\n     * 测试空数据解析\n     */\n    @Test\n    public void testParseEmptyData() {\n        String emptyData = \"\";\n        List<BankTransaction> transactions = BankTransactionParser.parseBankTransactions(emptyData);\n        assertNotNull(\"空数据应返回空列表\", transactions);\n        assertTrue(\"空数据应返回空列表\", transactions.isEmpty());\n\n        log.info(\"✅ 空数据解析测试通过\");\n    }\n\n    /**\n     * 测试格式异常数据\n     */\n    @Test\n    public void testParseMalformedData() {\n        // 测试字段数量不正确的数据行\n        String mal