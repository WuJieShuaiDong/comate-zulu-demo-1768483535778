        "content": "package com.baidu.pmc.bankcommon.core.constants;\n\n/**\n * Created by liugang07 on 2018/3/2.\n */\npublic class Constants {\n    /**\n     * 无可用前置机\n     */\n    public static final String NO_ENABLED_MACHINE = \"NO_ENABLED_MACHINE\";\n    /**\n     * 前置机异常信息\n     */\n    public static final String NO_ENABLED_MACHINE_MSG = \"前置机异常通讯\";\n    /**\n     * 接口请求失败\n     */\n    public static final String BANK_POST_EXCEPTION = \"BANK_POST_EXCEPTION\";\n    /**\n     * 请求失败信息\n     */\n    public static final String REQUEST_ERROR = \"请求失败\";\n    /**\n     * 前置机启用状态\n     */\n    public static final String UP = \"UP\";\n    /**\n     * 前置机停用状态\n     */\n    public static final String DOWN = \"DOWN\";\n    /**\n     * 常量 是/有效\n     */\n    public static final String ENABLED_Y = \"Y\";\n    /**\n     * 常量 否/无效\n     */\n    public static final String ENABLED_N = \"N\";\n    /**\n     * 付款单系统操作 默认操作人\n     */\n    public static final String SYSTEM_USER = \"bcdl\";\n    /**\n     * 付款指令系统操作 默认操作人\n     */\n    public static final String SYSTEM_INSTRUCT_USER = \"SYS_AUTO\";\n    /**\n     * 校验失败\n     */\n    public static final String CHECKOUT_FAILED = \"CHECKOUT_FAILED\";\n    /**\n     * 财务单据支付失败\n     */\n    public static final String PAY_FAILED_FIN = \"PAY_FAILED_FIN\";\n    /**\n     * 资金单据支付失败\n     */\n    public static final String PAY_FAILED_TMS = \"PAY_FAILED_TMS\";\n    /**\n     * 个人费用支付失败\n     */\n    public static final String PAY_FAILED_FIN_PERSON = \"PAY_FAILED_FIN_PERSON\";\n    /**\n     * 公司费用支付失败\n     */\n    public static final String PAY_FAILED_FIN_COMPANY = \"PAY_FAILED_FIN_COMPANY\";\n    /**\n     * 前置机通讯失败\n     */\n    public static final String MACHINE_FAILED = \"MACHINE_FAILED\";\n    /**\n     * 支付退票\n     */\n    public static final String PAY_REFUND = \"PAY_REFUND\";\n\n    /**\n     * 资金单据支付退票\n     */\n    public static final String PAY_REFUND_TMS = \"PAY_REFUND_TMS\";\n    /**\n     * 个人费用支付退票\n     */\n    public static final String PAY_REFUND_FIN_PERSON = \"PAY_REFUND_FIN_PERSON\";\n    /**\n     * 公司费用支付退票\n     */\n    public static final String PAY_REFUND_FIN_COMPANY = \"PAY_REFUND_FIN_COMPANY\";\n    /**\n     * 财务单据支付退票\n     */\n    public static final String PAY_REFUND_FIN = \"PAY_REFUND_FIN\";\n    /**\n     * 失败和退票预警邮件发送给报销人的开关\n     */\n    public static final String PMC_FAILMAIL_TO_REP = \"PMC_FAILMAIL_TO_REP\";\n    /**\n     * 功能开关\n     */\n    public static final String PMC_FUNCTIONS_SWITCH = \"PMC_FUNCTIONS_SWITCH\";\n    /**\n     * 银行值集\n     */\n    public static final String BANK_CODE_CITIC = \"B018\";\n    /**\n     * 报文严重错误无法解析\n     */\n    public static final String ERROR_XML_CODE = \"trn-b2eerror-rs\";\n    /**\n     * 人民币code\n     */\n    public static final String CNY = \"CNY\";\n    /**\n     * 电汇中国 支付方式\n     */\n    public static final String WIRE_CN = \"WIRE_CN\";\n    /**\n     * 工资卡中国 支付方式\n     */\n    public static final String PAYCARD_CN = \"PAYCARD_CN\";\n    /**\n     * 常量 HOME 国内\n     */\n    public static final String TYPE_HOME = \"HOME\";\n\n    /**\n     * ClientPatchID 1位标准\n     */\n    public static final String COMMON_INSTRUCT_TRN_UID = \"%01d\";\n\n    /**\n     * 报文编码\n     */\n    public static final String ENCODING_GBK = \"GBK\";\n\n    /**\n     * 报文编码\n     */\n    public static final String ENCODING_GB2312 = \"GB2312\";\n\n    /**\n     * 可疑状态\n     */\n    public static final String ORDER_UNKNOWN = \"ORDER_UNKNOWN\";\n\n    /**\n     * 余额不足\n     */\n    public static final String BALANCE_NOT_ENOUGH = \"BALANCE_NOT_ENOUGH\";\n\n    /**\n     * 组装支付报文失败\n     */\n    public static final String PAYMENT_MESSAGE_FAILED = \"PAYMENT_MESSAGE_FAILED\";\n\n    /**\n     * 支付过程中处理银行返回结果发生异常\n     */\n    public static final String BANK_RESULT_DEAL_ERROR = \"BANK_RESULT_DEAL_ERROR\";\n\n    /**\n     * 收入\n     */\n    public static final String DIRECTION_C = \"C\";\n    /**\n     * 收入name\n     */\n    public static final String DIRECTION_C_NAME = \"收入\";\n    /**\n     * 支出\n     */\n    public static final String DIRECTION_D = \"D\";\n    /**\n     * 支出name\n     */\n    public static final String DIRECTION_D_NAME = \"支出\";\n\n\n    /**\n     * 交易处理成功\n     */\n    public static final String RESPONSE_SUCCESS = \"RESPONSE_SUCCESS\";\n\n    /**\n     * 已提交银行处理\n     */\n    public static final String RESPONSE_PROCESSING = \"RESPONSE_PROCESSING\";\n\n    /**\n     * 支付成功\n     */\n    public static final String PAY_SUCCESS = \"PAY_SUCCESS\";\n\n    /**\n     * 支付失败\n     */\n    public static final String PAY_FAILED = \"PAY_FAILED\";\n\n    /**\n     * 余额不足\n     */\n    public static final String FAILED_BALANCE = \"FAILED_BALANCE\";\n\n    /**\n     * 支付中\n     */\n    public static final String PAY_PROCESSING = \"PAY_PROCESSING\";\n\n\n\n    /**\n     * 预留通用银行后缀map key\n     */\n    public static final String BANK_COMMON_SUFFIX = \"bankCommonSuffix\";\n    /**\n     * 银企标准化，指令表拼接正则校验\n     */\n    public static final String BANK_COMMON_VALID_TABLE_PATTERN = \"^pmc_[a-zA-Z0-9]+_pay_instruct(_his)?$\";\n\n    /**\n     * 银企标准化，指令表拼接逻辑\n     */\n    public static final String BANK_COMMON_INSTRUCT_TABLE = \"pmc_${bankSuffix}_pay_instruct\";\n    /**\n     * 银企标准化，指令历史表拼接逻辑\n     */\n    public static final String BANK_COMMON_INSTRUCT_HIS_TABLE = \"pmc_${bankSuffix}_pay_instruct_his\";\n\n\n    public static class BankcommonTranscodeEnum {\n\n        /**\n         * 银企支付\n         */\n        public static final String BANK_PAY = \"BANK_PAY\";\n\n        /**\n         * 账户实时余额查询\n         */\n        public static final String BALANCE_NOW = \"BALANCE_NOW\";\n\n        /**\n         * 账户历史余额查询\n         */\n        public static final String BALANCE_OLD = \"BALANCE_OLD\";\n        /**\n         * 查询支付状态\n         */\n        public static final String PAY_STATUS = \"PAY_STATUS\";\n\n        /**\n         * 帐户明细查询\n         */\n        public static final String TRANSACTIONS = \"TRANSACTIONS\";\n\n        /**\n         * 银企通用请求头\n         */\n        public static final String HEADER = \"HEADER\";\n\n        /**\n         * 电子回单查询\n         */\n        public static final String ELECT_RECEIPT_QEURY = \"ELECT_RECEIPT_QEURY\";\n\n        /**\n         * 电子回单下载\n         */\n        public static final String ELECT_RECEIPT_DOWNLOAD = \"ELECT_RECEIPT_DOWNLOAD\";\n\n        /**\n         * 退票查询\n         */\n        public static final String REFUND = \"REFUND\";\n\n\n    }\n\n    /**\n     * 银行接口方向枚举\n     */\n    public static class BankcommonInterfaceDirectionEnum {\n\n        /**\n         * 请求银行\n         */\n        public static final String REQUEST = \"REQUEST\";\n\n        /**\n         * 银行响应\n         */\n        public static final String RESPONSE = \"RESPONSE\";\n\n\n    }\n\n    public static class PayBankConstants {\n\n        /**\n         * 招商银行\n         */\n        public static final String CMB_BANK_CODE = \"B001\";\n\n        /**\n         * 工商银行\n         */\n        public static final String ICBC_BANK_CODE = \"B002\";\n\n        /**\n         * 中国银行\n         */\n        public static final String BOC_BANK_CODE = \"B003\";\n\n        /**\n         * 农业银行\n         */\n        public static final String ABC_BANK_CODE = \"B004\";\n\n        /**\n         * 建设银行\n         */\n        public static final String CCB_BANK_CODE = \"B005\";\n\n        /**\n         * 民生银行\n         */\n        public static final String CMBC_BANK_CODE = \"B007\";\n\n        /**\n         * 中信银行\n         */\n        public static final String CITIC_BANK_CODE = \"B018\";\n\n        /**\n         * 光大银行\n         */\n        public static final String CEB_BANK_CODE = \"B019\";\n\n        /**\n         * 兴业银行\n         */\n        public static final String CIB_BANK_CODE = \"B124\";\n\n        /**\n         * 交银香港\n         */\n        public static final String BOCOMHK_BANK_CODE = \"B707\";\n\n        /**\n         * 广发银行\n         */\n        public static final String CGB_BANK_CODE = \"C008\";\n        /**\n         * 中银香港\n         */\n        public static final String BOCHK_BANK_CODE = \"B035\";\n\n        /**\n         * 浦发银行\n         */\n        public static final String SPDB_BANK_CODE = \"B022\";\n\n        /**\n         * 华夏银行\n         */\n        public static final String HXB_BANK_CODE = \"B006\";\n\n        /**\n         * 交通银行\n         */\n        public static final String BCM_BANK_CODE = \"B017\";\n\n        /**\n         * 导出文件字段分隔符\n         */\n        public static final String FIELD_SEPARATOR = \" ;\";\n\n        /**\n         * 收款方行别代码-本行\n         */\n        public static final String OTHER_BANK = \"02\";\n\n        /**\n         * 收款方行别代码-国内他行\n         */\n        public static final String SELF_BANK = \"01\";\n\n    }\n\n    public static class BankStrategyCode {\n        public static final String COMMON = \"COMMON\";\n\n        public static final String CMB = \"CMB\";\n\n        public static final String CGB = \"CGB\";\n        public static final String BOCHK = \"BOCHK\";\n\n        public static final String SPDB = \"SPDB\";\n        public static final String HXB = \"HXB\";\n\n        public static final String BCM = \"BCM\";\n\n    }\n\n    public static class TransType {\n        /**\n         * 值集\n         */\n        public static final String FLEX = \"FLEX\";\n\n        /**\n         * 取自付款单\n         */\n        public static final String PAY = \"PAY\";\n\n        /**\n         * 日期格式\n         */\n        public static final String DATE = \"DATE\";\n\n        /**\n         * 从银行响应取\n         */\n        public static final String BANK = \"BANK\";\n\n        /**\n         * 直接取值\n         */\n        public static final String VALUE = \"VALUE\";\n\n        /**\n         * 唯一ID 付款接口取trnUid，其他接口取UUID\n         */\n        public static final String UUID = \"UUID\";\n\n        /**\n         * 从银行响应取,并将响应结果放入DTO用于下次查询使用，流水分页查询\n         */\n        public static final String BANK_DTO = \"BANK_DTO\";\n    }\n\n    /**\n     * 银行固定列枚举,用于定位余额，流水xml位置\n     */\n    public static class BankcommonColumnCodeEnum {\n\n        /**\n         * 实时余额\n         */\n        public static final String BALANCE_NOW = \"balanceNow\";\n\n        /**\n         * 流水\n         */\n        public static final String TRANSACTIONS = \"transactions\";\n\n        /**\n         * 流水分页初始页码\n         */\n        public static final String FIRST_PAGE_NO = \"firstPageNo\";\n\n        /**\n         * 流水分页大小\n         */\n        public static final String DEFAULT_PAGE_SIZE = \"defaultPageSize\";\n\n        /**\n         * 退票\n         */\n        public static final String REFUND = \"refund\";\n\n\n    }\n\n    /**\n     * 请求方式枚举\n     */\n    public static class RequestTypeEnum {\n\n        /**\n         * XML\n         */\n        public static final String XML = \"XML\";\n\n        /**\n         * JSON\n         */\n        public static final String JSON = \"JSON\";\n\n    }\n\n    /**\n     * Redis Key\n     */\n    public static class RedisKey {\n\n        /**\n         * 通用银行配置缓存\n         */\n        public static final String BANK_COMMON_COL_SET = \"commonBank:colSet:cache:\";\n\n        /**\n         * 通用银行后缀映射\n         */\n        public static final String BANK_COMMON_CODE_SUFFIX = \"commonBank:Set:suffix:cache:\";\n\n        /**\n         * 银行策略缓存\n         */\n        public static final String BANK_STRATEGY_CACHE = \"bank:strategy:cache:\";\n\n        /**\n         * 银行指令表字段配置(仅缓存table_flag=Y的配置)\n         */\n        public static final String INSTRUCT_TABLE_COL_PREFIX = \"bank:instruct:table:col:\";\n\n        /**\n         * 银行标准化银行列表\n         */\n        public static final String BANK_COMMON_LIST_KEY = \"commonBank:transfer:bank:list\";\n\n\n\n    }\n\n    /**\n     * 请求方式枚举\n     */\n    public static class RequestMethodEnum {\n\n        /**\n         * 前置机\n         */\n        public static final String MACHINE = \"MACHINE\";\n\n        /**\n         * HTTP\n         */\n        public static final String HTTP = \"HTTP\";\n\n    }\n\n    /**\n     * 银企HTTP请求的columnCode配置\n     */\n    public static final String HTTP_URL_COLUMN_CODE = \"http_uri\";\n\n\n}\n",
