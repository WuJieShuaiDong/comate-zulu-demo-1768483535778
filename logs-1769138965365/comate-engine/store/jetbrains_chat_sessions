        "content": "package com.baidu.pmc.bankcommon.core.service.impl;\n\nimport com.baidu.pmc.bankcommon.core.base.AbstractServiceTest;\nimport com.baidu.pmc.pojo.model.PmcAccount;\nimport org.junit.Test;\nimport org.springframework.beans.factory.annotation.Autowired;\n\nimport java.util.Arrays;\nimport java.util.List;\n\nimport static org.junit.Assert.assertEquals;\nimport static org.junit.Assert.assertTrue;\nimport static org.mockito.Mockito.when;\n\npublic class AccountServiceImplTest extends AbstractServiceTest {\n\n    @Autowired\n    private AccountServiceImpl accountService;\n\n    @Test\n    public void testQueryAccountsWithDirectConnectButNoReceipt() {\n        // 准备测试数据\n        PmcAccount account1 = new PmcAccount();\n        account1.setServiceContent(\"DIRECT_CONNECT,PAYMENT\"); // 有直连\n        account1.setAttribute12(null); // 无电子回单\n\n        PmcAccount account2 = new PmcAccount();\n        account2.setServiceContent(\"DIRECT_CONNECT\"); // 有直连\n        account2.setAttribute12(\"DISABLED\"); // 电子回单禁用\n\n        PmcAccount account3 = new PmcAccount();\n        account3.setServiceContent(\"DIRECT_CONNECT\"); // 有直连\n        account3.setAttribute12(\"ENABLED\"); // 有电子回单，不应返回\n\n        when(pmcAccountMapper.selectAccountsWithDirectConnectButNoReceipt())\n            .thenReturn(Arrays.asList(account1, account2));\n\n        // 执行测试\n        List<PmcAccount> result = accountService.queryAccountsWithDirectConnectButNoReceipt();\n\n        // 验证结果\n        assertEquals(2, result.size());\n        assertTrue(result.contains(account1));\n        assertTrue(result.contains(account2));\n    }\n}",
