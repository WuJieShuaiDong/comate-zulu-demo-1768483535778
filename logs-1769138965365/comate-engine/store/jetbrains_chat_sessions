(DEFAULT_QUEUE_SIZE);\n\n        // 使用自定义线程工厂，便于线程命名和追踪\n        ThreadFactory threadFactory = new NamedThreadFactory(\"default-pool-\");\n\n        // 使用自定义拒绝策略，增强日志记录\n        RejectedExecutionHandler rejectedHandler = new LoggingCallerRunsPolicy();\n\n        // 核心线程数与最大线程数分离\n        executor = new ThreadPoolExecutor(\n                DEFAULT_CORE_POOL_SIZE,\n                DEFAULT_MAX_POOL_SIZE,\n                KEEP_ALIVE_TIME,\n                KEEP_ALIVE_TIME_UNIT,\n                queue,\n                threadFactory,\n                rejectedHandler\n        );\n\n        // 允许核心线程超时关闭，在负载低时释放资源\n        executor.allowCoreThreadTimeOut(false);\n\n        logger.info(\"Default thread pool initialized. Core size: {}, Max size: {}, Queue capacity: {}\",\n                DEFAULT_CORE_POOL_SIZE, DEFAULT_MAX_POOL_SIZE, DEFAULT_QUEUE_SIZE);\n    }\n\n    /**\n     * 获取默认线程池实例\n     */\n    public static synchronized ExecutorService getExecutorService() {\n        if (isShutdown.get()) {\n            logger.warn(\"Thread pool has been shut down, creating new instance...\");\n            initDefaultExecutor();\n            isShutdown.set(false);\n        }\n        return executor;\n    }\n\n    /**\n     * 创建自定义线程池\n     */\n    public static ThreadPoolExecutor createExecutorService(int corePoolSize, int maxPoolSize, int queueSize) {\n        return createExecutorService(corePoolSize, maxPoolSize, queueSize, \"custom-pool-\");\n    }\n\n    /**\n     * 创建自定义线程池，指定线程名称前缀\n     */\n    public static ThreadPoolExecutor createExecutorService(\n            int corePoolSize, int maxPoolSize, int queueSize, String threadNamePrefix) {\n\n        if (corePoolSize < 0 || maxPoolSize <= 0 || maxPoolSize < corePoolSize || queueSize <= 0) {\n            throw new IllegalArgumentException(\"Invalid thread pool parameters\");\n        }\n\n        BlockingQueue<Runnable> queue = new ArrayBlockingQueue<>(queueSize);\n        ThreadFactory threadFactory = new NamedThreadFactory(threadNamePrefix);\n        RejectedExecutionHandler rejectedHandler = new LoggingCallerRunsPolicy();\n\n        ThreadPoolExecutor executor = new ThreadPoolExecutor(\n                corePoolSize,\n                maxPoolSize,\n                KEEP_ALIVE_TIME,\n                KEEP_ALIVE_TIME_UNIT,\n                queue,\n                threadFactory,\n                rejectedHandler\n        );\n\n        // 注册关闭钩子\n        Runtime.getRuntime().addShutdownHook(new Thread(() -> {\n            logger.info(\"Shutting down custom thread pool: {}\", threadNamePrefix);\n            shutdownAndAwaitTermination(executor, 30, TimeUnit.SECONDS);\n        }));\n\n        logger.info(\"Custom thread pool created. Core size: {}, Max size: {}, Queue capacity: {}\",\n                corePoolSize, maxPoolSize, queueSize);\n\n        return executor;\n    }\n\n    /**\n     * 优雅关闭线程池\n     */\n    public static void shutdownExecutor(ExecutorService executor, long timeout, TimeUnit unit) {\n        if (executor == null || executor.isTerminated()) {\n            return;\n        }\n\n        shutdownAndAwaitTermination(executor, timeout, unit);\n    }\n\n    /**\n     * 优雅关闭线程池并等待终止\n     */\n    private static void shutdownAndAwaitTermination(ExecutorService executor, long timeout, TimeUnit unit) {\n        if (executor == null) {\n            return;\n        }\n\n        try {\n            // 首先尝试优雅关闭\n            executor.shutdown();\n\n            // 等待指定时间让任务完成\n            if (!executor.awaitTermination(timeout, unit)) {\n                // 如果超时，强制关闭\n                logger.warn(\"Thread pool did not terminate in time, forcing shutdown...\");\n                executor.shutdownNow();\n\n                // 等待强制关闭完成\n                if (!executor.awaitTermination(timeout, unit)) {\n                    logger.error(\"Thread pool still did not terminate after forced shutdown\");\n                }\n            }\n        } catch (InterruptedException ie) {\n            // 恢复中断状态\n            executor.shutdownNow();\n            Thread.currentThread().interrupt();\n        } finally {\n            isShutdown.set(true);\n        }\n    }\n\n    /**\n     * 打印线程池当前状态\n     */\n    public static void printThreadPoolStatus(ThreadPoolExecutor executor, String poolName) {\n        if (executor == null) {\n            logger.warn(\"ThreadPoolExecutor is null, cannot print status\");\n            return;\n        }\n\n        StringBuilder status = new StringBuilder();\n        status.append(\"ThreadPool [\").append(poolName).append(\"] Status: \")\n                .append(\"CorePoolSize=\").append(executor.getCorePoolSize()).append(\", \")\n                .append(\"PoolSize=\").append(executor.getPoolSize()).append(\", \")\n                .append(\"ActiveCount=\").append(executor.getActiveCount()).append(\", \")\n                .append(\"LargestPoolSize=\").append(executor.getLargestPoolSize()).append(\", \")\n                .append(\"TaskCount=\").append(executor.getTaskCount()).append(\", \")\n                .append(\"CompletedTaskCount=\").append(executor.getCompletedTaskCount()).append(\", \")\n                .append(\"QueueSize=\").append(executor.getQueue().size()).append(\", \")\n                .append(\"QueueRemainingCapacity=\").append(executor.getQueue().remainingCapacity()).append(\", \")\n                .append(\"IsShutdown=\").append(executor.isShutdown()).append(\", \")\n                .append(\"IsTerminating=\").append(executor.isTerminating()).append(\", \")\n                .append(\"IsTerminated=\").append(executor.isTerminated());\n\n        logger.info(status.toString());\n    }\n\n    /**\n     * 打印默认线程池状态\n     */\n    public static void printDefaultThreadPoolStatus() {\n        printThreadPoolStatus(executor, \"DefaultThreadPool\");\n    }\n\n    /**\n     * 提交任务并捕获异常\n     */\n    public static <T> Future<T> submit(ExecutorService executor, Callable<T> task) {\n        if (executor == null || task == null) {\n            throw new IllegalArgumentException(\"Executor and task cannot be null\");\n        }\n\n        // 包装任务，添加异常处理\n        return executor.submit(() -> {\n            try {\n                return task.call();\n            } catch (Exception e) {\n                logger.error(\"Task execution failed\", e);\n                throw e; // 允许调用者处理异常\n            }\n        });\n    }\n\n    /**\n     * 提交Runnable任务并捕获异常\n     */\n    public static void execute(ExecutorService executor, Runnable task) {\n        if (executor == null || task == null) {\n            throw new IllegalArgumentException(\"Executor and task cannot be null\");\n        }\n\n        // 包装任务，添加异常处理\n        executor.execute(() -> {\n            try {\n                task.run();\n            } catch (Exception e) {\n                logger.error(\"Task execution failed\", e);\n            }\n        });\n    }\n\n    /**\n     * 自定义线程工厂，用于命名线程\n     */\n    private static class NamedThreadFactory implements ThreadFactory {\n        private final String prefix;\n        private final AtomicBoolean daemon;\n        private final ThreadGroup group;\n        private final AtomicInteger threadNumber = new AtomicInteger(1);\n\n        public NamedThreadFactory(String prefix) {\n            this(prefix, false);\n        }\n\n        public NamedThreadFactory(String prefix, boolean daemon) {\n            this.prefix = prefix;\n            this.daemon = new AtomicBoolean(daemon);\n            SecurityManager s = System.getSecurityManager();\n            this.group = (s != null) ? s.getThreadGroup() : Thread.currentThread().getThreadGroup();\n        }\n\n        @Override\n        public Thread newThread(Runnable r) {\n            // 包装Runnable，添加异常处理\n            Runnable wrappedRunnable = () -> {\n                try {\n                    r.run();\n                } catch (Exception e) {\n                    logger.error(\"Thread \" + Thread.currentThread().getName() + \" execution failed\", e);\n                }\n            };\n\n            Thread t = new Thread(group, wrappedRunnable,\n                    prefix + threadNumber.getAndIncrement(), 0);\n            t.setDaemon(daemon.get());\n            if (t.getPriority() != Thread.NORM_PRIORITY) {\n                t.setPriority(Thread.NORM_PRIORITY);\n            }\n            return t;\n        }\n    }\n\n    /**\n     * 带日志的拒绝策略\n     */\n    private static class LoggingCallerRunsPolicy extends CallerRunsPolicy {\n        @Override\n        public void rejectedExecution(Runnable r, ThreadPoolExecutor e) {\n            logger.warn(\"Task rejected. Thread pool is saturated. \" +\n                            \"Active threads: {}, Queue size: {}, Pool size: {}\",\n                    e.getActiveCount(), e.getQueue().size(), e.getPoolSize());\n\n            // 调用者运行策略，减缓提交速度\n            super.rejectedExecution(r, e);\n        }\n    }\n\n    // 防止实例化\n    private NewThreadPoolExecutorUtil() {\n        throw new AssertionError(\"Cannot instantiate ThreadPoolExecutorUtil\");\n    }\n}\n多个业务场景下使用线程池，有无bug,如果有风险给出解决方法",
