count(\"123456789\");\n        balanceInfo.setBalance(new BigDecimal(\"1000.00\"));\n        expectedBalanceInfos.add(balanceInfo);\n\n        PmcAccount pmcAccount = new PmcAccount();\n        pmcAccount.setAccountName(\"测试账户\");\n\n        when(bankcommonService.selectBankcommonBalance(eq(qo), any())).thenReturn(expectedBalanceInfos);\n        when(accountService.queryBankcommonAccountByAccountNo(any(PayQO.class))).thenReturn(pmcAccount);\n\n        List<BalanceInfo> result = bcmBankStrategy.selectBankBalance(qo);\n        assertNotNull(result);\n        assertEquals(1, result.size());\n        assertEquals(\"测试账户\", result.get(0).getAnnotation());\n        verify(bankcommonService).selectBankcommonBalance(eq(qo), any());\n        verify(accountService).queryBankcommonAccountByAccountNo(any(PayQO.class));\n    }\n\n    @Test\n    public void testSelectBankBalanceWithException() {\n        // 测试查询银行余额（发生异常的情况）\n        PayQO qo = new PayQO();\n        qo.setBank(\"B033\");\n        qo.setAccount(\"123456789\");\n\n        List<BalanceInfo> expectedBalanceInfos = new ArrayList<>();\n        BalanceInfo balanceInfo = new BalanceInfo();\n        balanceInfo.setAccount(\"123456789\");\n        expectedBalanceInfos.add(balanceInfo);\n\n        when(bankcommonService.selectBankcommonBalance(eq(qo), any())).thenReturn(expectedBalanceInfos);\n        when(accountService.queryBankcommonAccountByAccountNo(any(PayQO.class))).thenThrow(new RuntimeException(\"数据库连接失败\"));\n\n        List<BalanceInfo> result = bcmBankStrategy.selectBankBalance(qo);\n        assertNotNull(result);\n        assertEquals(1, result.size());\n        assertNull(result.get(0).getAnnotation()); // 异常时annotation应该为null\n    }\n\n    @Test\n    public void testQueryBalanceForCheck() {\n        // 测试查询余额用于检查\n        List<PayQO> qos = Arrays.asList(new PayQO());\n        List<BalanceInfo> expectedBalanceInfos = new ArrayList<>();\n\n        when(bankcommonService.queryBankcommonBalanceForCheck(eq(qos), any())).thenReturn(expectedBalanceInfos);\n\n        List<BalanceInfo> result = bcmBankStrategy.queryBalanceForCheck(qos);\n        assertEquals(expectedBalanceInfos, result);\n        verify(bankcommonService).queryBankcommonBalanceForCheck(eq(qos), any());\n    }\n\n    @Test\n    public void testBankSuspectList() {\n        // 测试银行可疑交易列表\n        PayInstructQO qo = new PayInstructQO();\n        Page<PayInstructDTO> expectedPage = new Page<>();\n        when(commonBankStrategy.bankSuspectList(qo)).thenReturn(expectedPage);\n\n        Page<PayInstructDTO> result = bcmBankStrategy.bankSuspectList(qo);\n        assertEquals(expectedPage, result);\n        verify(commonBankStrategy).bankSuspectList(qo);\n    }\n\n    @Test\n    public void testBankAnalysisSuspect() {\n        // 测试银行可疑交易分析\n        PayInstructQO payInstructQO = new PayInstructQO();\n        String expectedResult = \"分析完成\";\n\n        Map<String, String> extentionParams = new HashMap<>();\n        extentionParams.put(\"beginDate\", DateUtils.formatDate(DateUtils.addDays(new Date(), -25), \"yyyyMMdd\"));\n\n        when(bankcommonService.bankcommonAnalysisSuspect(eq(payInstructQO), eq(extentionParams))).thenReturn(expectedResult);\n\n        String result = bcmBankStrategy.bankAnalysisSuspect(payInstructQO);\n        assertEquals(expectedResult, result);\n        verify(bankcommonService).bankcommonAnalysisSuspect(eq(payInstructQO), eq(extentionParams));\n    }\n\n    @Test\n    public void testUpdateInstruct() {\n        // 测试更新指令（委托给通用策略）\n        PayInstructQO payInstructQO = new PayInstructQO();\n        String expectedResult = \"更新成功\";\n        when(commonBankStrategy.updateInstruct(payInstructQO)).thenReturn(expectedResult);\n\n        String result = bcmBankStrategy.updateInstruct(payInstructQO);\n        assertEquals(expectedResult, result);\n        verify(commonBankStrategy).updateInstruct(payInstructQO);\n    }\n\n    @Test\n    public void testUpdateInstructFailedBatch() {\n        // 测试批量更新