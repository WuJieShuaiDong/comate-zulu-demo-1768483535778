        "content": "package com.baidu.ce.config;\n\nimport com.baidu.p2p.core.j2ee.action.JsonResult;\nimport com.baidu.p2p.core.j2ee.exception.LockException;\nimport com.baidu.p2p.core.j2ee.exception.WebException;\nimport com.baidu.p2p.core.utils.lock.ILock;\nimport com.baidu.p2p.core.utils.lock.RedisLock;\nimport com.baidu.p2p.system.web.session.SessionUtils;\nimport lombok.extern.slf4j.Slf4j;\nimport org.aspectj.lang.ProceedingJoinPoint;\nimport org.aspectj.lang.annotation.Around;\nimport org.aspectj.lang.annotation.Aspect;\nimport org.aspectj.lang.reflect.MethodSignature;\nimport org.springframework.context.annotation.Configuration;\nimport org.springframework.web.context.request.RequestContextHolder;\nimport org.springframework.web.context.request.ServletRequestAttributes;\n\nimport javax.servlet.http.HttpServletRequest;\nimport java.lang.reflect.Method;\n\n/**\n * ExportRepeatCheckLock\n * @author: zhangfuliang\n * @date: 2025/1/16\n */\n@Aspect\n@Configuration\n@Slf4j\npublic class ExportRepeatCheckInterceptor {\n    @Around(\"execution(public * *(..)) && @annotation(com.baidu.ce.config.ExportRepeatCheckLock)\")\n    public Object interceptor(ProceedingJoinPoint pjp) {\n        MethodSignature signature = (MethodSignature) pjp.getSignature();\n        Method method = signature.getMethod();\n        String userName = SessionUtils.getSessionUser().getUsername();\n        String key = \"ExportRepeatCheck_\" + pjp.getTarget().getClass().getName() + \".\" + method.getName() + \"_\" + userName;\n        HttpServletRequest request = ((ServletRequestAttributes) RequestContextHolder.getRequestAttributes())\n                .getRequest();\n\n        ILock lck = new RedisLock(key, 10L, 300000L);\n        try {\n            lck.acquirLock();\n            return pjp.proceed();\n        } catch (LockException e) {\n            log.info(\"{}访问接口:{},验证重复导出,key:{}\", userName, request.getRequestURI(), key);\n            return JsonResult.failJsonResult(\"正在导出，请耐心等待！\");\n        } catch (Throwable throwable) {\n            throwable.printStackTrace();\n            throw new WebException(throwable.getMessage());\n        } finally {\n            lck.releaseLock();\n        }\n    }\n}\n",
