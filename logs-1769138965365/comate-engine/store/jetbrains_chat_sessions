        "absolutePath": "/Users/xiaoliu/baidu/bpit-proc-apps/pmc/pmc-basic-bankcommon/src/main/java/com/baidu/pmc/bankcommon/core/service/strategy/BcmBankStrategy.java",
        "content": "package com.baidu.pmc.bankcommon.core.service.strategy;\n\nimport com.baidu.pmc.bankcommon.core.constants.BcmConstants;\nimport com.baidu.pmc.bankcommon.core.constants.Constants;\nimport com.baidu.pmc.bankcommon.core.service.*;\nimport com.baidu.pmc.bankcommon.core.service.impl.SendMailService;\nimport com.baidu.pmc.bankcommon.persistence.dao.PmcPayCommonBankSetMapper;\nimport com.baidu.pmc.pojo.dto.PayChecksDTO;\nimport lombok.extern.slf4j.Slf4j;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.beans.factory.annotation.Value;\nimport org.springframework.stereotype.Service;\n\n@Slf4j\n@Service\npublic class BcmBankStrategy implements BankStrategy {\n\n    @Value(\"${bcm.sign.url}\")\n    private String signUrl;\n\n    @Value(\"${bcm.file.url}\")\n    private String fileUrl;\n\n    @Autowired\n    private SendMailService mailService;\n\n    @Autowired\n    private PmcPayCommonBankSetMapper pmcPayCommonBankSetMapper;\n\n    @Autowired\n    private MachineService machineService;\n\n    @Autowired\n    private BankcommonService bankcommonService;\n\n    @Autowired\n    private AccountService accountService;\n\n    @Override\n    public String getBankStrategy() {\n        return Constants.BankStrategyCode.BCM;\n    }\n\n    // 以下实现BankStrategy接口方法，参考SpdbBankStrategy但适配BCM银行特性\n\n    @Override\n    public String verityReceive(PayChecksDTO payChecksDTO, PmcPayChecks payCheck, String bankCode) {\n        StringBuilder failedStringBuilder = new StringBuilder();\n\n        // 收款方账户名校验\n        if (StringUtils.isBlank(payChecksDTO.getAttribute1())) {\n            failedStringBuilder.append(\"收款人名称为空! \");\n        } else if (StringUtils.length(payChecksDTO.getAttribute1()) > BcmConstants.FieldLength.ACCOUNT_NAME) {\n            failedStringBuilder.append(\"收款人名称长度超过限制! \");\n        }\n\n        // 收款方账号校验\n        if (StringUtils.isBlank(payChecksDTO.getAttribute2())) {\n            failedStringBuilder.append(\"收款方帐号为空! \");\n        } else if (payChecksDTO.getAttribute2().length() > BcmConstants.FieldLength.ACCOUNT_NO) {\n            failedStringBuilder.append(\"收款方帐号长度超过限制! \");\n        }\n\n        // 跨行联行号校验\n        if (!StringUtils.equals(payChecksDTO.getAttribute3(), payChecksDTO.getBankCode())) {\n            if (StringUtils.isBlank(payChecksDTO.getAttribute7())) {\n                failedStringBuilder.append(\"收款行联行号为空! \");\n            }\n        }\n\n        payCheck.setFailureReasons(failedStringBuilder.toString());\n        return payCheck.getFailureReasons();\n    }\n\n    @Override\n    public String verityPay(List<String> bankCodes, PayChecksDTO payChecksDTO, PmcPayChecks payCheck, String bankCode) {\n        StringBuilder verityFailedStringBuilder = new StringBuilder();\n\n        // 付款银行开通校验\n        if (!bankCodes.contains(payChecksDTO.getBankCode())) {\n            verityFailedStringBuilder.append(\"付款银行没有开通银企直连! \");\n        }\n\n        // 金额校验\n        if (payChecksDTO.getAmount() == null || payChecksDTO.getAmount().compareTo(BigDecimal.ZERO) <= 0) {\n            verityFailedStringBuilder.append(\"金额必须大于0! \");\n        }\n\n        // 币种校验\n        if (!Constants.CNY.equals(payChecksDTO.getAmountCurrency())) {\n            verityFailedStringBuilder.append(\"仅支持人民币交易! \");\n        }\n\n        // 账户类型校验\n        if (!Constants.TYPE_HOME.equals(payChecksDTO.getAccountType())) {\n            verityFailedStringBuilder.append(\"付款账户非国内账户! \");\n        }\n\n        // 银企支付标志校验\n        if (!Constants.ENABLED_Y.equals(payChecksDTO.getDirectFlag())) {\n            verityFailedStringBuilder.append(\"没有启用银企支付! \");\n        }\n\n        payCheck.setFailureReasons(verityFailedStringBuilder.toString());\n        return payCheck.getFailureReasons();\n    }\n\n    @Override\n    public String postBankHttp(String request, String uri, Map<String, Object> dto, String bankCode) {\n        try {\n            // 1. 对请求报文进行签名\n            String signedRequest = bcmSign(request);\n            if (StringUtils.isBlank(signedRequest)) {\n                log.error(\"BCM银行HTTP请求签名失败\");\n                return Constants.BANK_POST_EXCEPTION;\n            }\n\n            // 2. 构建完整请求URL\n            String fullUrl = uri + (uri.contains(\"?\") ? \"&\" : \"?\") + \"bankCode=\" + bankCode;\n\n            // 3. 发送HTTP请求\n            String response = OkHttpUtils.sendHttpRequest(fullUrl, signedRequest);\n            if (StringUtils.isBlank(response)) {\n                log.error(\"BCM银行HTTP请求返回空响应\");\n                return Constants.BANK_POST_EXCEPTION;\n            }\n\n            // 4. 验证响应签名\n            String verifiedResponse = bcmVerifySign(response);\n            if (verifiedResponse.contains(\"<error>\")) {\n                log.error(\"BCM银行HTTP请求返回错误: {}\", verifiedResponse);\n                return Constants.BANK_POST_EXCEPTION;\n            }\n\n            return verifiedResponse;\n        } catch (Exception e) {\n            log.error(\"BCM银行HTTP请求异常\", e);\n            return Constants.BANK_POST_EXCEPTION;\n        }\n    }\n\n    @Override\n    public String postMACHINE(String request, String hashValue, Long tenantId, String[] ipArr, String bankCode) {\n        // 1. 对请求报文进行签名\n        request = bcmSign(request);\n        String requestLength = StringUtils.leftPad(String.valueOf(request.length() + 6), 6, '0');\n        request = requestLength + request;\n\n        // 2. 获取可用前置机列表\n        PmcCmbMachineDTO cmbMachineDTO = new PmcCmbMachineDTO();\n        cmbMachineDTO.setTenantId(tenantId);\n        cmbMachineDTO.setStatus(Constants.UP);\n        cmbMachineDTO.setMachineBank(bankCode);\n        List<PmcCmbMachine> machines = machineService.selectMachine(cmbMachineDTO);\n\n        if (CollectionUtils.isEmpty(machines)) {\n            log.error(\"无可用BCM银行前置机\");\n            mailService.sendMachineFailedMail(\"无可用BCM银行前置机\", new ArrayList<>(), bankCode);\n            return Constants.NO_ENABLED_MACHINE;\n        }\n\n        // 3. 使用一致性哈希选择前置机\n        Map<String, PmcCmbMachine> machineMap = machines.stream()\n                .collect(Collectors.toMap(PmcCmbMachine::getIp, Function.identity(), (k1, k2) -> k1));\n        String server = new NodeDistributeUtil().getServer(hashValue, machineMap.keySet().toArray(new String[0]));\n        log.info(\"选择BCM银行前置机: {}\", server);\n\n        PmcCmbMachine machine = machineMap.get(server);\n        if (ipArr != null && ipArr.length > 0) {\n            ipArr[0] = machine.getIp();\n        }\n\n        try {\n            // 4. 获取银行配置确定请求类型\n            Example example = new Example(PmcPayCommonBankSet.class);\n            example.createCriteria()\n                .andEqualTo(\"bankCode\", bankCode)\n                .andEqualTo(\"transferFlag\", Constants.ENABLED_Y);\n            List<PmcPayCommonBankSet> bankSets = pmcPayCommonBankSetMapper.selectByExample(example);\n\n            String requestType = CollectionUtils.isNotEmpty(bankSets)\n                ? bankSets.get(0).getRequestType()\n                : Constants.RequestTypeEnum.XML;\n\n            // 5. 发送请求并获取响应\n            String response = Constants.RequestTypeEnum.XML.equals(requestType)\n                ? OkHttpUtils.sendHttpRequest(machine.getIp(), request)\n                : OkHttpUtils.sendHttpRequestJson(machine.getIp(), request);\n\n            // 6. 验证响应签名并返回\n            return bcmVerifySign(response);\n        } catch (Exception e) {\n            log.error(\"BCM银行前置机通信异常\", e);\n            return Constants.BANK_POST_EXCEPTION;\n        }\n    }\n\n    /**\n     * BCM银行请求签名方法\n     * @param request 原始请求报文\n     * @return 签名后的请求报文\n     */\n    private String bcmSign(String request) {\n        log.info(\"BCM银行请求报文签名前: {}\", request);\n        try {\n            // 1. 构建签名请求体\n            Map<String, String> params = new HashMap<>();\n            params.put(\"requestData\", request);\n            params.put(\"bankCode\", BcmConstants.BANK_CODE);\n\n            // 2. 调用签名服务\n            String signedResponse = OkHttpUtils.sendHttpRequestContentType(\n                signUrl,\n                new ObjectMapper().writeValueAsString(params),\n                BcmConstants.ContentType.SIGN\n            );\n\n            // 3. 解析签名结果\n            JsonNode responseNode = new ObjectMapper().readTree(signedResponse);\n            if (\"0\".equals(responseNode.path(\"resultCode\").asText())) {\n                String signedRequest = responseNode.path(\"signedData\").asText();\n                log.info(\"BCM银行请求报文签名后: {}\", signedRequest);\n                return signedRequest;\n            } else {\n                log.error(\"BCM银行签名失败: {}\", responseNode.path(\"resultMsg\").asText());\n                return \"\";\n            }\n        } catch (Exception e) {\n            log.error(\"BCM银行请求签名异常\", e);\n            return \"\";\n        }\n    }\n\n    /**\n     * BCM银行响应验签方法\n     * @param response 银行原始响应\n     * @return 验签后的响应报文\n     */\n    private String bcmVerifySign(String response) {\n        log.info(\"BCM银行响应验签前: {}\", response);\n        try {\n            // 1. 构建验签请求体\n            Map<String, String> params = new HashMap<>();\n            params.put(\"responseData\", response);\n            params.put(\"bankCode\", BcmConstants.BANK_CODE);\n\n            // 2. 调用验签服务\n            String verifyResponse = OkHttpUtils.sendHttpRequestContentType(\n                signUrl,\n                new ObjectMapper().writeValueAsString(params),\n                BcmConstants.ContentType.VERIFY_SIGN\n            );\n\n            // 3. 解析验签结果\n            JsonNode responseNode = new ObjectMapper().readTree(verifyResponse);\n            if (\"0\".equals(responseNode.path(\"resultCode\").asText())) {\n                String verifiedData = responseNode.path(\"verifiedData\").asText();\n                log.info(\"BCM银行响应验签后: {}\", verifiedData);\n                return verifiedData;\n            } else {\n                log.error(\"BCM银行验签失败: {}\", responseNode.path(\"resultMsg\").asText());\n                return response; // 验签失败返回原始响应\n            }\n        } catch (Exception e) {\n            log.error(\"BCM银行响应验签异常\", e);\n            return response;\n        }\n    }\n\n    // 其他BankStrategy接口方法实现...\n\n}\n",
