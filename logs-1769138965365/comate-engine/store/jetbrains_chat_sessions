        "content": "package com.baidu.pmc.bankcommon.core.utils;\n\nimport com.baidu.pmc.bankcommon.core.model.BankTransaction;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.lang3.StringUtils;\n\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.List;\n\n/**\n * 银行交易记录解析工具类\n * 用于解析银行流水文本数据，按照固定分隔符分割字段\n *\n * @author baidu.pmc\n * @since 2025-01-09\n */\n@Slf4j\npublic class BankTransactionParser {\n\n    private static final String FIELD_SEPARATOR = \"\\\\|\";\n    private static final int EXPECTED_FIELD_COUNT = 26;\n\n    /**\n     * 解析银行交易记录字符串\n     *\n     * @param dataString 包含表头和数据的完整字符串\n     * @return 解析后的交易记录列表\n     */\n    public static List<BankTransaction> parseBankTransactions(String dataString) {\n        List<BankTransaction> transactions = new ArrayList<>();\n\n        if (StringUtils.isBlank(dataString)) {\n            log.warn(\"银行交易记录字符串为空\");\n            return transactions;\n        }\n\n        // 按行分割字符串\n        String[] lines = dataString.split(\"\\n\");\n        if (lines.length < 2) {\n            log.warn(\"银行交易记录数据行数不足，至少需要表头和一行数据\");\n            return transactions;\n        }\n\n        try {\n            log.info(\"开始解析银行交易记录，共发现 {} 条数据记录\", lines.length - 1);\n\n            // 跳过表头，直接处理数据行\n            for (int i = 1; i < lines.length; i++) {\n                String dataLine = lines[i].trim();\n                if (StringUtils.isBlank(dataLine)) {\n                    continue;\n                }\n\n                BankTransaction transaction = parseDataLine(dataLine, i);\n                if (transaction != null) {\n                    transactions.add(transaction);\n                    log.info(\"成功解析第{}行数据：流水号={}, 交易金额={}\",\n                            i, transaction.getSerialNumber(), transaction.getTransactionAmount());\n                }\n            }\n\n        } catch (Exception e) {\n            log.error(\"解析银行交易记录时发生异常\", e);\n        }\n\n        log.info(\"银行交易记录解析完成，共解析 {} 条记录\", transactions.size());\n        return transactions;\n    }\n\n    /**\n     * 解析单行数据\n     *\n     * @param line 数据行内容\n     * @param lineNumber 行号\n     * @return 解析后的交易记录对象，解析失败返回null\n     */\n    private static BankTransaction parseDataLine(String line, int lineNumber) {\n        try {\n            // 使用固定分隔符分割，保留所有空字段\n            String[] fields = line.split(FIELD_SEPARATOR, -1);\n\n            // 如果字段多于预期，可能是末尾有额外的空字段，截取前26个\n            if (fields.length > EXPECTED_FIELD_COUNT) {\n                log.warn(\"第{}行发现{}个字段，截取前{}个字段\", lineNumber, fields.length, EXPECTED_FIELD_COUNT);\n                fields = Arrays.copyOf(fields, EXPECTED_FIELD_COUNT);\n            } else if (fields.length < EXPECTED_FIELD_COUNT) {\n                log.error(\"第{}行字段不足：期望{}个，实际{}个\", lineNumber, EXPECTED_FIELD_COUNT, fields.length);\n                return null;\n            }\n\n            // 创建交易记录对象\n            BankTransaction transaction = new BankTransaction();\n\n            // 按固定位置设置字段值\n            transaction.setStatus(cleanField(fields[0]));\n            transaction.setTransactionDate(cleanField(fields[1]));\n            transaction.setTransactionTime(cleanField(fields[2]));\n            transaction.setBusinessType(cleanField(fields[3]));\n            transaction.setSerialNumber(cleanField(fields[4]));\n            transaction.setSequenceNumber(cleanField(fields[5]));\n            transaction.setAccountNumber(cleanField(fields[6]));\n            transaction.setAccountName(cleanField(fields[7]));\n            transaction.setIncomeExpenseFlag(cleanField(fields[8]));\n            transaction.setCurrency(cleanField(fields[9]));\n            transaction.setTransactionAmount(cleanField(fields[10]));\n            transaction.setBalance(cleanField(fields[11]));\n            transaction.setAvailableBalance(cleanField(fields[12]));\n            transaction.setCounterpartyAccount(cleanField(fields[13]));\n            transaction.setCounterpartyName(cleanField(fields[14]));\n            transaction.setCounterpartyAddress(cleanField(fields[15]));\n            transaction.setCounterpartyBankCode(cleanField(fields[16]));\n            transaction.setCounterpartyBankName(cleanField(fields[17]));\n            transaction.setBillType(cleanField(fields[18]));\n            transaction.setBillNumber(cleanField(fields[19]));\n            transaction.setBillName(cleanField(fields[20]));\n            transaction.setBillIssueDate(cleanField(fields[21]));\n            transaction.setRemarkMemo(cleanField(fields[22]));\n            transaction.setAdditionalRemark(cleanField(fields[23]));\n            transaction.setTransactionCode(cleanField(fields[24]));\n            transaction.setBackupField(cleanField(fields[25]));\n\n            return transaction;\n\n        } catch (Exception e) {\n            log.error(\"解析第{}行数据时发生异常\", lineNumber, e);\n            return null;\n        }\n    }\n\n    /**\n     * 清理字段值\n     *\n     * @param field 原始字段值\n     * @return 清理后的字段值\n     */\n    private static String cleanField(String field) {\n        return field != null ? field.trim() : \"\";\n    }\n\n    /**\n     * 打印解析结果（用于调试和验证）\n     *\n     * @param transactions 交易记录列表\n     */\n    public static void printParsingResult(List<BankTransaction> transactions) {\n        log.info(\"=== 银行交易记录解析结果 ===\");\n        log.info(\"共解析出 {} 条交易记录\", transactions.size());\n\n        if (transactions.isEmpty()) {\n            log.info(\"没有解析到有效的交易记录\");\n            return;\n        }\n\n        for (int i = 0; i < Math.min(transactions.size(), 5); i++) {\n            BankTransaction transaction = transactions.get(i);\n            log.info(\"第 {} 条记录:\", i + 1);\n            log.info(\"  状态: {}\", transaction.getStatus());\n            log.info(\"  交易日期: {}\", transaction.getTransactionDate());\n            log.info(\"  交易时间: {}\", transaction.getTransactionTime());\n            log.info(\"  业务类型: {}\", transaction.getBusinessType());\n            log.info(\"  流水号: {}\", transaction.getSerialNumber());\n            log.info(\"  账号: {}\", maskAccountNumber(transaction.getAccountNumber()));\n            log.info(\"  户名: {}\", transaction.getAccountName());\n            log.info(\"  收支标志: {}\", transaction.getIncomeExpenseFlag());\n            log.info(\"  交易金额: {}\", transaction.getTransactionAmount());\n            log.info(\"  余额: {}\", transaction.getBalance());\n            log.info(\"  附言: {}\", transaction.getRemarkMemo());\n            log.info(\"---\");\n        }\n        if (transactions.size() > 5) {\n            log.info(\"... 省略 {} 条记录\", transactions.size() - 5);\n        }\n    }\n\n    /**\n     * 脱敏处理账号信息（用于日志输出）\n     *\n     * @param accountNumber 原始账号\n     * @return 脱敏后的账号\n     */\n    private static String maskAccountNumber(String accountNumber) {\n        if (StringUtils.isBlank(accountNumber) || accountNumber.length() <= 8) {\n            return accountNumber;\n        }\n        return accountNumber.substring(0, 4) + \"****\" + accountNumber.substring(accountNumber.length() - 4);\n    }\n}",
