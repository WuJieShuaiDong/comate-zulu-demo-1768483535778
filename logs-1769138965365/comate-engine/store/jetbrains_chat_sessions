        "content": "package com.baidu.pmc.bankcommon.persistence.domain;\n\nimport javax.persistence.Column;\nimport javax.persistence.Id;\nimport javax.persistence.Table;\nimport java.util.Date;\n\n@Table(name = \"pmc_pay_common_trans_flex_set\")\npublic class PmcPayCommonTransFlexSet {\n    /**\n     * 主键\n     */\n    @Id\n    private Long id;\n\n    /**\n     * 转义code\n     */\n    @Column(name = \"trans_code\")\n    private String transCode;\n\n    /**\n     * 转义名称\n     */\n    @Column(name = \"trans_name\")\n    private String transName;\n\n    /**\n     * 值集code\n     */\n    @Column(name = \"flex_set_name\")\n    private String flexSetName;\n\n    /**\n     * 值集值\n     */\n    @Column(name = \"flex_value\")\n    private String flexValue;\n\n    /**\n     * 映射银行字段\n     */\n    @Column(name = \"mapping_bank_col\")\n    private String mappingBankCol;\n\n    /**\n     * 返回字段\n     */\n    @Column(name = \"result_col\")\n    private String resultCol;\n\n    /**\n     * 创建人\n     */\n    @Column(name = \"created_by\")\n    private String createdBy;\n\n    /**\n     * 创建时间\n     */\n    @Column(name = \"creation_date\")\n    private Date creationDate;\n\n    /**\n     * 更新人\n     */\n    @Column(name = \"last_updated_by\")\n    private String lastUpdatedBy;\n\n    /**\n     * 更新时间\n     */\n    @Column(name = \"last_update_date\")\n    private Date lastUpdateDate;\n\n    /**\n     * 拓展字段1\n     */\n    private String attribute1;\n\n    /**\n     * 拓展字段2\n     */\n    private String attribute2;\n\n    /**\n     * 拓展字段3\n     */\n    private String attribute3;\n\n    /**\n     * 拓展字段4\n     */\n    private String attribute4;\n\n    /**\n     * 拓展字段5\n     */\n    private String attribute5;\n\n    /**\n     * 获取主键\n     *\n     * @return id - 主键\n     */\n    public Long getId() {\n        return id;\n    }\n\n    /**\n     * 设置主键\n     *\n     * @param id 主键\n     */\n    public void setId(Long id) {\n        this.id = id;\n    }\n\n    /**\n     * 获取转义code\n     *