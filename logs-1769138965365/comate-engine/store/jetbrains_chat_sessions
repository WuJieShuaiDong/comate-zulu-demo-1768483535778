        "content": "package com.baidu.pmc.bankcommon.core.utils;\n\nimport com.baidu.pmc.bankcommon.core.constants.Constants;\nimport com.baidu.pmc.bankcommon.core.service.impl.OperateByJDBC;\nimport com.baidu.pmc.bankcommon.persistence.dao.PmcPayCommonBankColSetMapper;\nimport com.baidu.pmc.bankcommon.persistence.dao.PmcPayCommonBankSetMapper;\nimport com.baidu.pmc.bankcommon.persistence.dao.PmcPayCommonTransFlexSetMapper;\nimport com.baidu.pmc.bankcommon.persistence.domain.PmcPayCommonBankColSet;\nimport com.baidu.pmc.bankcommon.persistence.domain.PmcPayCommonTransFlexSet;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.pojo.model.PmcPayCommonBankSet;\nimport com.baidu.pmc.pojo.model.fnd.FndFlexValue;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections.CollectionUtils;\nimport org.jdom2.Document;\nimport org.jdom2.Element;\nimport org.jdom2.output.Format;\nimport org.jdom2.output.XMLOutputter;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\nimport tk.mybatis.mapper.entity.Example;\n\nimport java.util.Arrays;\nimport java.util.Date;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Objects;\nimport java.util.Optional;\nimport java.util.UUID;\n\n\n/**\n * 请求报文\n */\n@Slf4j\n@Service\npublic class MessageBuilder {\n    @Autowired\n    private PmcPayCommonBankColSetMapper pmcPayCommonBankColSetMapper;\n\n    @Autowired\n    private PmcPayCommonBankSetMapper pmcPayCommonBankSetMapper;\n\n    @Autowired\n    private PmcPayCommonTransFlexSetMapper pmcPayCommonTransFlexSetMapper;\n\n    @Autowired\n    private OperateByJDBC operateByJDBC;\n\n\n    /**\n     * 银企通帐户明细查询请求体\n     */\n    public String queryTransactionsMessage(Map<String, Object> instructDto, Map<String, String> extentionParams) {\n        if (Objects.nonNull(extentionParams)) {\n            for (Map.Entry<String, String> entry : extentionParams.entrySet()) {\n                if (!instructDto.containsKey(entry.getKey())) {\n                    instructDto.put(entry.getKey(), entry.getValue());\n                }\n            }\n        }\n        instructDto.put(\"interfaceType\", Constants.BankcommonTranscodeEnum.TRANSACTIONS);\n        instructDto.put(\"interfaceDirection\", Constants.BankcommonInterfaceDirectionEnum.REQUEST);\n        Document document = bulidHeaderDocumentCommon(instructDto);\n        document = bulidBodyDocumentCommon(document, instructDto);\n        return generateRequest(document, instructDto);\n    }\n\n    /**\n     * 银企支付请求体\n     */\n    public String queryBankPayMessage(Map<String, Object> instructDto, Map<String, String> extentionParams) {\n        // 支付接口复制dto到新的map，防止修改原dto\n        HashMap<String, Object> dto = new HashMap<>(instructDto);\n        if (Objects.nonNull(extentionParams)) {\n            dto.putAll(extentionParams);\n        }\n        dto.put(\"bankCode\", dto.get(\"bank_code\"));\n        dto.put(\"interfaceType\", Constants.BankcommonTranscodeEnum.BANK_PAY);\n        dto.put(\"interfaceDirection\", Constants.BankcommonInterfaceDirectionEnum.REQUEST);\n        Document document = bulidHeaderDocumentCommon(dto);\n        document = bulidBodyDocumentCommon(document, dto);\n        return generateRequest(document, dto);\n    }\n\n    /**\n     * 银企支付状态查询请求体\n     */\n    public String queryPayStatusMessage(Map<String, Object> dto, Map<String, String> extentionParams) {\n        if (Objects.nonNull(extentionParams)) {\n            dto.putAll(extentionParams);\n        }\n        dto.put(\"interfaceType\", Constants.BankcommonTranscodeEnum.PAY_STATUS);\n        dto.put(\"interfaceDirection\", Constants.BankcommonInterfaceDirectionEnum.REQUEST);\n        Document document = bulidHeaderDocumentCommon(dto);\n        document = bulidBodyDocumentCommon(document, dto);\n        return generateRequest(document, dto);\n    }\n\n    /**\n     * 实时余额查询交易请求体\n     */\n    public String queryBalanceNowMessage(Map<String, Object> instructDto, Map<String, String> extentionParams) {\n        if (Objects.nonNull(extentionParams)) {\n            instructDto.putAll(extentionParams);\n        }\n        instructDto.put(\"interfaceType\", Constants.BankcommonTranscodeEnum.BALANCE_NOW);\n        instructDto.put(\"interfaceDirection\", Constants.BankcommonInterfaceDirectionEnum.REQUEST);\n        Document document = bulidHeaderDocumentCommon(instructDto);\n        document = bulidBodyDocumentCommon(document, instructDto);\n        return generateRequest(document, instructDto);\n    }\n\n    /**\n     * 历史余额查询交易请求体\n     */\n    public String queryBalanceOldMessage(Map<String, Object> instructDto, Map<String, String> extentionParams) {\n        if (Objects.nonNull(extentionParams)) {\n            instructDto.putAll(extentionParams);\n        }\n        instructDto.put(\"interfaceType\", Constants.BankcommonTranscodeEnum.BALANCE_OLD);\n        instructDto.put(\"interfaceDirection\", Constants.BankcommonInterfaceDirectionEnum.REQUEST);\n        Document document = bulidHeaderDocumentCommon(instructDto);\n        document = bulidBodyDocumentCommon(document, instructDto);\n        return generateRequest(document, instructDto);\n    }\n\n    /**\n     * 电子回单查询\n     */\n    public String queryElectReceiptQueryMessage(Map<String, Object> instructDto, Map<String, String> extentionParams) {\n        if (Objects.nonNull(extentionParams)) {\n            instructDto.putAll(extentionParams);\n        }\n        instructDto.put(\"interfaceType\", Constants.BankcommonTranscodeEnum.ELECT_RECEIPT_QEURY);\n        instructDto.put(\"interfaceDirection\", Constants.BankcommonInterfaceDirectionEnum.REQUEST);\n        Document document = bulidHeaderDocumentCommon(instructDto);\n        document = bulidBodyDocumentCommon(document, instructDto);\n        return generateRequest(document, instructDto);\n    }\n    /**\n     * 电子回单下载\n     */\n    public String queryElectReceiptDownloadMessage(Map<String, Object> instructDto, Map<String, String> extentionParams) {\n        if (Objects.nonNull(extentionParams)) {\n            instructDto.putAll(extentionParams);\n        }\n        instructDto.put(\"interfaceType\", Constants.BankcommonTranscodeEnum.ELECT_RECEIPT_DOWNLOAD);\n        instructDto.put(\"interfaceDirection\", Constants.BankcommonInterfaceDirectionEnum.REQUEST);\n        Document document = bulidHeaderDocumentCommon(instructDto);\n        document = bulidBodyDocumentCommon(document, instructDto);\n        return generateRequest(document, instructDto);\n    }\n\n    /**\n     * 银企通用退票查询请求体\n     */\n    public String queryRefundMessage(Map<String, Object> instructDto, Map<String, String> extentionParams) {\n        if (Objects.nonNull(extentionParams)) {\n            for (Map.Entry<String, String> entry : extentionParams.entrySet()) {\n                if (!instructDto.containsKey(entry.getKey())) {\n                    instructDto.put(entry.getKey(), entry.getValue());\n                }\n            }\n        }\n        instructDto.put(\"interfaceType\", Constants.BankcommonTranscodeEnum.REFUND);\n        instructDto.put(\"interfaceDirection\", Constants.BankcommonInterfaceDirectionEnum.REQUEST);\n        Document document = bulidHeaderDocumentCommon(instructDto);\n        bulidBodyDocumentCommon(document, instructDto);\n        return generateRequest(document, instructDto);\n    }\n\n\n    /**\n     * 根据银行配置生成xml,JSON的请求报文\n     *\n     * @param document    xml报文\n     * @param instructDto 请求参数dto\n     * @return\n     */\n    private String generateRequest(Document document, Map<String, Object> instructDto) {\n        Example example = new Example(PmcPayCommonBankSet.class);\n        example.createCriteria().\n                andEqualTo(\"bankCode\", instructDto.get(\"bankCode\"))\n                .andEqualTo(\"transferFlag\", Constants.ENABLED_Y);\n        List<PmcPayCommonBankSet> pmcPayCommonBankSets = pmcPayCommonBankSetMapper.selectByExample(example);\n        String requestType = Constants.RequestTypeEnum.XML;\n        if (CollectionUtils.isNotEmpty(pmcPayCommonBankSets)) {\n            requestType = pmcPayCommonBankSets.get(0).getRequestType();\n        }\n        switch (requestType) {\n            case Constants.RequestTypeEnum.XML:\n                return generateXML(document);\n            case Constants.RequestTypeEnum.JSON:\n                String xmlString = null;\n                try {\n                    xmlString = generateXML(document);\n                    return XmlJsonUtil.simpleXmlToJson(xmlString);\n                } catch (Exception e) {\n                    log.error(\"xml转JSON失败\", e);\n                    log.error(\"xml转JSON失败,报文：{}\", xmlString);\n\n                    return \"\";\n                }\n            default:\n                return generateXML(document);\n        }\n\n    }\n\n    /**\n     * 获取xml报文字符串\n     *\n     * @param document dom\n     * @return xml\n     */\n    public String generateXML(Document document) {\n        XMLOutputter xmlOutputter = new XMLOutputter();\n        Format format = Format.getPrettyFormat();\n        format.setExpandEmptyElements(true);\n        format.setEncoding(Constants.ENCODING_GBK);\n        xmlOutputter.setFormat(format);\n        String xml = xmlOutputter.outputString(document);\n        return xml;\n\n    }\n\n\n    /**\n     * 获取请求头Document\n     *\n     * @param instructDto\n     */\n\n    public Document bulidHeaderDocumentCommon(Map<String, Object> instructDto) {\n        Document headerDocument = null;\n        Example example = new Example(PmcPayCommonBankColSet.class);\n        example.createCriteria().\n                andEqualTo(\"bankCode\", instructDto.get(\"bankCode\"))\n                .andEqualTo(\"interfaceType\", Constants.BankcommonTranscodeEnum.HEADER)\n                .andEqualTo(\"interfaceDirection\", Constants.BankcommonInterfaceDirectionEnum.REQUEST)\n                .andEqualTo(\"enableFlag\", Constants.ENABLED_Y);\n        List<PmcPayCommonBankColSet> pmcPayCommonBankColSets = pmcPayCommonBankColSetMapper.selectByExample(example);\n        if (CollectionUtils.isNotEmpty(pmcPayCommonBankColSets)) {\n            for (PmcPayCommonBankColSet pmcPayCommonBankColSet : pmcPayCommonBankColSets) {\n                headerDocument = convertToDocument(headerDocument, pmcPayCommonBankColSet, instructDto);\n            }\n        }\n        return headerDocument;\n    }\n\n    /**\n     * 获取请求体Document\n     *\n     * @param rootDocument\n     * @param instructDto\n     */\n    public Document bulidBodyDocumentCommon(Document rootDocument, Map<String, Object> instructDto) {\n\n        Example example = new Example(PmcPayCommonBankColSet.class);\n        example.createCriteria().\n                andEqualTo(\"bankCode\", instructDto.get(\"bankCode\"))\n                .andLike(\"interfaceType\", StringUtils.toString(instructDto.get(\"interfaceType\")))\n                .andLike(\"interfaceDirection\", StringUtils.toString(instructDto.get(\"interfaceDirection\")))\n                .andIsNotNull(\"transType\")\n                .andEqualTo(\"enableFlag\", Constants.ENABLED_Y);\n        List<PmcPayCommonBankColSet> pmcPayCommonBankColSets = pmcPayCommonBankColSetMapper.selectByExample(example);\n        if (CollectionUtils.isNotEmpty((pmcPayCommonBankColSets))) {\n            for (PmcPayCommonBankColSet pmcPayCommonBankColSet : pmcPayCommonBankColSets) {\n                rootDocument = convertToDocument(rootDocument, pmcPayCommonBankColSet, instructDto);\n            }\n        }\n        return rootDocument;\n    }\n\n    public Document convertToDocument(Document document, PmcPayCommonBankColSet pmcPayCommonBankColSet, Map<String, Object> instructDto) {\n        String[] split = pmcPayCommonBankColSet.getMappingBankCol().split(\"\\\\.\");\n        String mappingBankValue = getMappingBankValue(pmcPayCommonBankColSet, instructDto);\n        int length = split.length;\n        Element parentElement = null;\n        Element element = null;\n        for (int i = 0; i < length; i++) {\n            String s = split[i];\n            // 初始化创建\n            if (document == null) {\n                Element rootEl = new Element(s);\n                parentElement = rootEl;\n                document = new Document(rootEl);\n            } else {\n                // 第一次循环，获取根节点作为父节点\n                if (i == 0) {\n                    parentElement = document.getRootElement();\n                    continue;\n                }\n                element = parentElement.getChild(s);\n                if (element == null) {\n                    element = new Element(s);\n                    if (i == length - 1) {\n                        // 到叶子节点时，添加文本\n                        CommonUtil.addEleWithTextByXpath(parentElement, s, mappingBankValue);\n                    } else {\n                        // 非叶子节点时，添加元素\n                        parentElement.addContent(element);\n                    }\n                }\n                parentElement = element;\n            }\n        }\n        return document;\n    }\n\n    /**\n     * 根据传入的PmcPayCommonBankColSet和instructDto对象，获取对应的映射银行值\n     *\n     * @param pmcPayCommonBankColSet PmcPayCommonBankColSet对象，包含交易类型、列代码和交易详情\n     * @param instructDto            包含指令数据的Map对象\n     *                               VALUE 固定值\n     *                               PAY 付款单对象\n     *                               FLEX 弹性域转化\n     *                               UUID 唯一值\n     * @return 映射后的银行值\n     */\n    private String getMappingBankValue(PmcPayCommonBankColSet pmcPayCommonBankColSet, Map<String, Object> instructDto) {\n        String transType = pmcPayCommonBankColSet.getTransType();\n        String columnCode = pmcPayCommonBankColSet.getColumnCode();\n        String transDetail = pmcPayCommonBankColSet.getTransDetail();\n        try {\n            switch (transType) {\n                case Constants.TransType.VALUE:\n                    return transDetail;\n                case Constants.TransType.PAY:\n                    return StringUtils.toString(instructDto.get(columnCode));\n                case Constants.TransType.DATE:\n                    return DateUtils.formatDate(new Date(), transDetail);\n                case Constants.TransType.FLEX:\n                    return getFlexMappingBankValue(pmcPayCommonBankColSet, instructDto);\n                case Constants.TransType.UUID:\n                    return getUuidMappingBankValue(instructDto);\n                default:\n                    return transDetail;\n            }\n        } catch (Exception e) {\n            log.error(\"getMappingBankValue error:\", e);\n        }\n        return \"\";\n    }\n\n    /**\n     * 映射类型为值集取数逻辑\n     *\n     * @param pmcPayCommonBankColSet\n     * @param instructDto\n     * @return\n     */\n    private String getFlexMappingBankValue(PmcPayCommonBankColSet pmcPayCommonBankColSet, Map<String, Object> instructDto) {\n        String transDetail = pmcPayCommonBankColSet.getTransDetail();\n        Example example = new Example(PmcPayCommonTransFlexSet.class);\n        example.createCriteria().andEqualTo(\"transCode\", transDetail);\n        List<PmcPayCommonTransFlexSet> pmcPayCommonTransFlexSets = pmcPayCommonTransFlexSetMapper.selectByExample(example);\n        if (CollectionUtils.isNotEmpty(pmcPayCommonTransFlexSets)) {\n            PmcPayCommonTransFlexSet pmcPayCommonTransFlexSet = pmcPayCommonTransFlexSets.get(0);\n            String name = pmcPayCommonTransFlexSet.getFlexSetName();\n            List<String> values = Arrays.asList(pmcPayCommonTransFlexSet.getFlexValue().split(\",\"));\n            List<FndFlexValue> fndFlexValues = operateByJDBC.selectBySetAndValue(name, values);\n\n            if (CollectionUtils.isNotEmpty(fndFlexValues)) {\n                FndFlexValue fndFlexValue = null;\n                // 一对一匹配\n                if (fndFlexValues.size() == 1) {\n                    fndFlexValue = fndFlexValues.get(0);\n                } else {\n                    // 一对多匹配值集\n                    fndFlexValue = fndFlexValues\n                            .stream()\n                            .filter(f -> StringUtils.equals(f.getFlexValue(),\n                                    StringUtils.toString(instructDto.get(pmcPayCommonBankColSet.getColumnCode()))))\n                            .findFirst().orElse(null);\n                }\n                if (fndFlexValue != null) {\n                    return invokeFieldGet(fndFlexValue, pmcPayCommonTransFlexSet.getResultCol());\n                }\n            }\n        }\n        return \"\";\n\n    }\n\n    /**\n     * 映射类型为UUID取数逻辑\n     *\n     * @param instructDto\n     * @return\n     */\n    private String getUuidMappingBankValue(Map<String, Object> instructDto) {\n        String interfaceType = StringUtils.toString(instructDto.get(\"interfaceType\"));\n        if (Constants.BankcommonTranscodeEnum.BANK_PAY.equals(interfaceType)) {\n            return StringUtils.toString(instructDto.get(\"trn_uid\"));\n        } else {\n            return String.valueOf(UUID.randomUUID()).replace(\"-\", \"\");\n        }\n    }\n\n    /**\n     * 反射获取字段值\n     *\n     * @param obj\n     * @param fieldName\n     * @return\n     */\n    private String invokeFieldGet(Object obj, String fieldName) {\n        String getMethod = \"get\" + fieldName.substring(0, 1).toUpperCase() + fieldName.substring(1);\n        try {\n            return Optional.ofNullable(obj.getClass().getMethod(getMethod).invoke(obj))\n                    .orElse(\"\")\n                    .toString();\n        } catch (Exception e) {\n            log.error(\"invokeFieldGet error:\".concat(e.getMessage()));\n        }\n        return \"\";\n    }\n}\n",
