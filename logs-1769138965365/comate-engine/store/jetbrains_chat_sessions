        "content": "#应用相关\nserver.port=9090\nspring.application.name=pmc-web\n#server.context-path=/pmc\n\n#spring cloud配置\neureka.client.service-url.defaultZone=${eureka.serviceUrl}\neureka.client.registry-fetch-interval-seconds=10\neureka.instance.lease-renewal-interval-in-seconds=10\neureka.instance.lease-expiration-duration-in-seconds=10\neureka.server.eviction-interval-timer-in-ms=30000\n\n# hystri配置\nhystrix.command.default.execution.isolation.thread.timeoutInMilliseconds=180000\nhystrix.threadpool.default.coreSize=500\n\nspring.mvc.throw-exception-if-no-handler-found=true\n#spring json\nspring.jackson.generator.write_numbers_as_strings=true\nspring.jackson.generator.quote_non_numeric_numbers=true\nspring.jackson.parser.allow_single_quotes=true\nspring.jackson.parser.allow_unquoted_field_names=true\n\nserver.tomcat.uri-encoding=GBK\n#国际化\nspring.messages.basename=i18n/messages\nspring.messages.cache-seconds=3600\nspring.messages.encoding=UTF-8\n\nspring.session.store-type=redis\nserver.session.timeout=10\n\nspring.mvc.static-path-pattern=/**\nspring.resources.static-locations=classpath\\:/META-INF/resources/,classpath\\:/resources/,classpath\\:/dist/,classpath\\:/webapp/,classpath\\:/public/\n\n#log\nlogging.config=classpath:logback-spring.xml\n\n# 水麒麟功能权限客户端redis配置 ${redis.enableListener}\nwk.core.redis.nodes=${spring.redis.nodes}\nwk.core.redis.useCluster=${redis.useCluster}\nwk.core.redis.enableListener= false\nwk.clientRoleMode=MULTI\nwk.core-service.url=${wk.core-service.url}\nwk.core.service.url=${wk.core-service.url}\n\nwk.ignoreUrls=/pages/**/*, /i18nDicts, /poseidon/**, /cmb/receipt/**, /cmc/BFBFeedBack, \\\n  /pmc/payCheckHis/getAuditHistories, /pmc/payCheckStatus/getStatusDetail, /tmsPayChecksIface/saveTmsPayChecksIface, \\\n  /pay_query/toTmsChecks, /tmsPayChecksIface/selectStatus, /pmc/payData/**, /tmsAccountIface/suggestBankNumber,/inflow/**,/bpm/**\n\nwk.appCode=${wk.appCode}\n\nlb.isDev=true\n\n#水麒麟 lookup服务地址\nwk.lookup-service.url=${wk.lookup-service.url}\nwk.lookup.service.url=${wk.lookup-service.url}\n# 水麒麟数据字典redis配置\nwk.microlookup.redis.nodes=${spring.redis.nodes}\nwk.microlookup.redis.useCluster=${redis.useCluster}\n\n# 启用跨域脚本(XSS)保护\nsecurity.headers.xss=true\n\n# 文件上传下载大小限制\nspring.http.multipart.enabled=true\nspring.http.multipart.max-file-size=5MB\nspring.http.multipart.max-request-size=5MB\n\n# 文件路径\npmc.common.attachment.dir.diskPath=${pmc.common.attachment.dir.diskPath}\n\n# XSS过滤白名单 使用英文逗号分隔\npmc.xss.exclusions=\n\n# feign对压缩的支持\nfeign.compression.request.enabled=true\nfeign.compression.response.enabled=true\n\nribbon.ReadTimeout=180000\nribbon.ConnectTimeout=180000\n\n# 是否启用swagger\n#swagger.enable=${swagger.enable}\n\n# 外部系统需要进行认证的接口\npmc.interface.filterPaths=${pmc.interface.filterPaths}\npmc.interface.permitApps=${pmc.interface.permitApps}\n\n# apiGo 鉴权空间服务授权码\npmc.apiGo.jwtSignKey=${pmc.apiGo.jwtSignKey}\n\n#redis\npmc.redis.ip=${redis.ip}\npmc.redis.port=${redis.port}\npmc.redis.password=${redis.password}\npmc.redis.keyprefix=pmc_\n\napplication.env=${running.env}_\n\n# uuap\nuuap.casServerLoginUrl=${uuap.casServerLoginUrl}\nuuap.casServerSTokenDecryptUrl=${uuap.casServerSTokenDecryptUrl}\nuuap.sessionCheckUserStatusUrl=${uuap.sessionCheckUserStatusUrl}\nuuap.serverName=${uuap.serverName}\nuuap.uuapPublicTokenName=${uuap.uuapPublicTokenName}\nuuap.uuapSecretTokenName=${uuap.uuapSecretTokenName}\nuuap.appKey=${uuap.appKey}\nuuap.secretKey=${uuap.secretKey}\nuuap.ignoreInitConfiguration=true\nuuap.casServerLogoutUrl=${uuap.casServerLogoutUrl}\nuuap.afterLogoutRedirectUrl=${uuap.logoutRedirect}\nuuap.ignorePattern=/pages/**/*, /i18nDicts, /poseidon/**, /cmb/receipt/**, /cmc/BFBFeedBack, \\\n  /pmc/payCheckHis/getAuditHistories, /pmc/payCheckStatus/getStatusDetail, /tmsPayChecksIface/saveTmsPayChecksIface, \\\n  /pay_query/toTmsChecks, /tmsPayChecksIface/selectStatus, /pmc/payData/**, /pmcApiGo/**, /tmsAccountIface/suggestBankNumber,/inflow/**,/bpm/**, /pmcPortal/**,\\\n  /openApi/cmsSyn