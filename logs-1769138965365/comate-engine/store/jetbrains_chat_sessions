        "content": "package com.baidu.p2p.core.poi.excel.utils;\n\nimport com.alibaba.fastjson.JSONArray;\nimport com.alibaba.fastjson.JSONObject;\nimport com.baidu.p2p.core.utils.DateTool;\nimport com.baidu.p2p.core.utils.FastJsonUtil;\nimport com.baidu.p2p.core.utils.FreeMarkers;\nimport com.baidu.p2p.core.utils.StrUtils;\nimport com.google.common.collect.Maps;\nimport org.apache.commons.collections4.CollectionUtils;\nimport org.apache.commons.io.IOUtils;\nimport org.apache.commons.io.output.ByteArrayOutputStream;\nimport org.apache.commons.lang3.StringUtils;\nimport org.apache.poi.openxml4j.exceptions.InvalidFormatException;\nimport org.apache.poi.ss.usermodel.BorderStyle;\nimport org.apache.poi.ss.usermodel.Cell;\nimport org.apache.poi.ss.usermodel.CellStyle;\nimport org.apache.poi.ss.usermodel.CellType;\nimport org.apache.poi.ss.usermodel.DataFormat;\nimport org.apache.poi.ss.usermodel.DataValidation;\nimport org.apache.poi.ss.usermodel.DataValidationHelper;\nimport org.apache.poi.ss.usermodel.FillPatternType;\nimport org.apache.poi.ss.usermodel.IndexedColors;\nimport org.apache.poi.ss.usermodel.Row;\nimport org.apache.poi.ss.usermodel.Sheet;\nimport org.apache.poi.ss.usermodel.VerticalAlignment;\nimport org.apache.poi.ss.usermodel.Workbook;\nimport org.apache.poi.ss.usermodel.WorkbookFactory;\nimport org.apache.poi.ss.usermodel.FormulaEvaluator;\nimport org.apache.poi.ss.usermodel.CellValue;\nimport org.apache.poi.ss.usermodel.DateUtil;\nimport org.apache.poi.ss.util.CellRangeAddressList;\nimport org.apache.poi.xssf.usermodel.XSSFDataValidationConstraint;\nimport org.apache.poi.xssf.usermodel.XSSFDataValidationHelper;\nimport org.apache.poi.xssf.usermodel.XSSFSheet;\nimport org.apache.poi.xssf.usermodel.XSSFWorkbook;\nimport org.springframework.util.ResourceUtils;\n\nimport java.io.ByteArrayInputStream;\nimport java.io.File;\nimport java.io.FileInputStream;\nimport java.io.IOException;\nimport java.io.InputStream;\nimport java.text.DecimalFormat;\nimport java.text.SimpleDateFormat;\nimport java.util.ArrayList;\nimport java.util.List;\nimport java.util.Map;\n\nimport static org.apache.poi.ss.usermodel.Cell.CELL_TYPE_STRING;\n\npublic class ExcelKit {\n    private static int DEFAULT_SHEET_INDEX = 0;\n    private static int DEFAULT_NAME_ROW = 1;\n    private static int DEFAULT_TYPE_ROW = 2;\n    private static int DEFAULT_AUTOSIZE_ROW = 3;\n\n    public static InputStream getWb2Stream(Workbook wb) {\n        ByteArrayInputStream bais = null;\n        try {\n            ByteArrayOutputStream baos = new ByteArrayOutputStream();\n            try {\n                wb.write(baos);\n                bais = new ByteArrayInputStream(baos.toByteArray());\n            } catch (IOException e) {\n                // TODO Auto-generated catch block\n                e.printStackTrace();\n            } finally {\n\n            }\n            return bais;\n        } catch (Exception e) {\n            e.printStackTrace();\n        } finally {\n\n        }\n        return bais;\n    }\n\n    /**\n     * 根据模板下载多sheet 的   excel\n     *\n     * @param tempName\n     * @return\n     */\n    public static InputStream createMultiSheetExcelWithTemp(List<List<?>> dataPara, String tempName,\n                                                            List<JSONObject> configs) {\n        try {\n            Workbook wb = createMultiSheetExcelWithTempReturnWb(dataPara, tempName, configs);\n            return getWb2Stream(wb);\n        } catch (Exception e) {\n            e.printStackTrace();\n        } finally {\n\n        }\n        return null;\n    }\n\n    /**\n     * 根据模板下载多sheet 的   excel\n     *\n     * @param tempName\n     * @return\n     */\n    public static Workbook createMultiSheetExcelWithTempReturnWb(List<List<?>> dataPara, String tempName,\n                                                                 List<JSONObject> configs) {\n\n        List<List<JSONObject>> data = new ArrayList<List<JSONObject>>();\n        List<JSONObject> list = null;\n        JSONObject config = null;\n        FileInputStream fis = null;\n\n        try {\n            String path = ResourceUtils.getFile(\"classpath:doc\").getAbsolutePath() + File.separator + tempName;\n            if (dataPara != null && dataPara.size() > 0) {\n                for (List<?> ls : dataPara) {\n                    data.add(FastJsonUtil.toJsonList(ls, null));\n                }\n            }\n            fis = new FileInputStream(new File(path));\n            Workbook wb = WorkbookFactory.create(fis);\n\n            for (int d = 0; d < data.size(); d++) {\n                list = data.get(d);\n                config = configs.get(d);\n                createExcelWithDynamicTempWb(list, wb, config);\n            }\n            return wb;\n        } catch (Exception e) {\n            e.printStackTrace();\n        } finally {\n            IOUtils.closeQuietly(fis);\n        }\n        return null;\n\n    }\n\n    /**\n     * 根据模板下载excel\n     *\n     * @param list\n     * @param tempName\n     * @return\n     */\n    public static InputStream createExcelWithTemp(List<?> list, String tempName) {\n        return createExcelWithTemp(list, tempName, null);\n    }\n\n    /**\n     * 根据模板及其模板配置下载excel\n     *\n     * @param list\n     * @param tempName\n     * @param config\n     * @return\n     */\n    public static InputStream createExcelWithTemp(List<?> list, String tempName, JSONObject config) {\n        JSONObject conf = getDefaultConfig(config);\n        ByteArrayInputStream bais = null;\n        FileInputStream fis = null;\n        try {\n            String path = ResourceUtils.getFile(\"classpath:doc\").getAbsolutePath() + File.separator + tempName;\n            fis = new FileInputStream(new File(path));\n            Workbook wb = WorkbookFactory.create(fis);\n            return createExcelWithDynamicTemp(list, wb, conf);\n        } catch (Exception e) {\n            e.printStackTrace();\n        } finally {\n            IOUtils.closeQuietly(fis);\n        }\n        return bais;\n    }\n\n    /**\n     * 根据模板及其模板配置下载excel\n     *\n     * @param list\n     * @param tempName\n     * @return\n     */\n    public static Workbook createExcelWithTempWb(List<?> list, String tempName) {\n        return createExcelWithTempWb(list, tempName, null);\n    }\n\n    /**\n     * 根据模板及其模板配置下载excel\n     *\n     * @param list\n     * @param tempName\n     * @param config\n     * @return\n     */\n    public static Workbook createExcelWithTempWb(List<?> list, String tempName, JSONObject config) {\n        JSONObject conf = getDefaultConfig(config);\n        FileInputStream fis = null;\n        try {\n            String path = ResourceUtils.getFile(\"classpath:doc\").getAbsolutePath() + File.separator + tempName;\n            fis = new FileInputStream(new File(path));\n            Workbook wb = WorkbookFactory.create(fis);\n            return createExcelWithDynamicTempWb(list, wb, conf);\n        } catch (Exception e) {\n            e.printStackTrace();\n        } finally {\n            IOUtils.closeQuietly(fis);\n        }\n        return null;\n    }\n\n    /**\n     * 根据动态模板及其模板配置下载excel\n     *\n     * @param list\n     * @param config\n     * @return\n     */\n    public static InputStream createExcelWithDynamicTemp(List<?> list, Workbook wb1, JSONObject config) {\n        Workbook wb = createExcelWithDynamicTempWb(list, wb1, config);\n        return getWb2Stream(wb);\n    }\n\n    /**\n     * 根据动态模板及其模板配置下载excel\n     *\n     * @param wb\n     * @param config\n     * @return\n     */\n    public static Workbook createExcelWithDynamicTempWb(List<?> listA, Workbook wb, JSONObject config) {\n        JSONObject conf = getDefaultConfig(config);\n        List<JSONObject> list = FastJsonUtil.toJsonList(listA, null);\n        if (null == list) {\n            list = new ArrayList<JSONObject>();\n        }\n        int NAME_ROW = conf.getIntValue(\"nameRow\");\n        int TYPE_ROW = conf.getIntValue(\"typeRow\");\n        int AUTOSIZE_ROW = conf.getIntValue(\"autoSizeRow\");\n        int SHEET_INDEX = conf.getIntValue(\"sheetIndex\");\n        JSONObject DATAVALIDATION = conf.getJSONObject(\"dataValidation\");\n        JSONObject FORMULA = conf.getJSONObject(\"formula\");\n        try {\n\n            Sheet sheet = wb.getSheetAt(SHEET_INDEX);\n            Row nameRow = sheet.getRow(NAME_ROW);\n            Row typeRow = sheet.getRow(TYPE_ROW);\n            Row autoSizeRow = sheet.getRow(AUTOSIZE_ROW);\n            if (typeRow == null) {\n                typeRow = sheet.createRow(TYPE_ROW);\n            }\n            short lastCellNum = nameRow.getLastCellNum();\n\n            // 读取设置列\n            List<String> nameList = new ArrayList<String>();\n            List<String> typeList = new ArrayList<String>();\n            List<String> autosizeList = new ArrayList<String>();\n            for (int i = 0; i < lastCellNum; i++) {\n                Cell nameCell = nameRow.getCell(i);\n                if (nameCell != null && nameCell.getCellType() != Cell.CELL_TYPE_BLANK) {\n                    nameList.add(nameCell.getStringCellValue());\n\n                } else {\n                    nameList.add(\"_otherFiled_\");\n                }\n\n                Cell typeCell = typeRow.getCell(i);\n                if (typeCell != null && typeCell.getCellType() != Cell.CELL_TYPE_BLANK) {\n                    typeList.add(typeCell.getStringCellValue());\n                } else {\n                    typeList.add(\"string\");\n                }\n                if (autoSizeRow != null) {\n                    Cell autoCell = autoSizeRow.getCell(i);\n                    if (autoCell != null && autoCell.getCellType() != Cell.CELL_TYPE_BLANK) {\n                        autosizeList.add(autoCell.getStringCellValue());\n                    } else {\n                        autosizeList.add(\"1\");\n                    }\n                } else {\n                    autosizeList.add(\"1\");\n                }\n\n            }\n\n            // 下拉框处理\n            for (int j = 0; j < lastCellNum; j++) {\n                Cell nameCell = nameRow.getCell(j);\n                if (nameCell != null && nameCell.getCellType() != Cell.CELL_TYPE_BLANK) {\n                    String name = nameCell.getStringCellValue();\n                    if (DATAVALIDATION.get(name) != null) {\n                        Map map = (Map) DATAVALIDATION.get(name);\n                        DataValidationHelper help = new XSSFDataValidationHelper((XSSFSheet) sheet);\n                        DataValidation validation =\n                                help.createValidation((XSSFDataValidationConstraint) map.get(\"constraint\"),\n                                        (CellRangeAddressList) map.get(\"regions\"));\n                        validation.createErrorBox(\"输入值有误\", \"请从下拉框中选择\");\n                        validation.setShowErrorBox(true);\n                        sheet.addValidationData(validation);\n                        //                        sheet.addValidationData((XSSFDataValidation) DATAVALIDATION.get\n                        // (name));\n                    }\n                }\n            }\n            // 删除设置列\n            int lastRowNum = sheet.getLastRowNum();\n            if (lastRowNum < AUTOSIZE_ROW + 1) {\n                lastRowNum = AUTOSIZE_ROW + 1;\n            }\n            sheet.removeRow(nameRow);\n            sheet.removeRow(typeRow);\n            if (autoSizeRow != null) {\n                sheet.removeRow(autoSizeRow);\n            }\n            sheet.shiftRows(AUTOSIZE_ROW + 1, lastRowNum, -1 * AUTOSIZE_ROW + (AUTOSIZE_ROW - DEFAULT_AUTOSIZE_ROW));\n\n            Map<String, CellStyle> styleMap = getCellStyleMap(wb);\n\n            Row currRow = null;\n            Cell currCell = null;\n            JSONObject jo = null;\n            String func = null;\n\n            sheet.autoSizeColumn(18);\n            for (int i = 0; i < list.size(); i++) {\n\n                currRow = sheet.getRow(i + AUTOSIZE_ROW - 2);\n\n                jo = list.get(i);\n\n                if (currRow == null) {\n                    currRow = sheet.createRow(i + AUTOSIZE_ROW - 2);\n                }\n\n                Boolean cellLenTooLong = false;\n\n                for (int j = 0; j < lastCellNum; j++) {\n\n                    currCell = currRow.getCell(j);\n\n                    if (currCell == null) {\n                        currCell = currRow.createCell(j);\n                    }\n\n                    String type = typeList.get(j);\n                    CellStyle cellStyle = styleMap.get(type);\n\n                    if (cellStyle == null) {\n                        if (StringUtils.trim(type).startsWith(\"format=\")) {\n                            // format\n                            CellStyle cellStyleFormat = getBorderedCellStyle(wb);\n                            DataFormat dataFormat = wb.createDataFormat();\n                            String[] types = StringUtils.trim(type).substring(7).split(\"\\\\|type=\");\n                            String formatEx;\n                            if (types.length == 2) {\n                                type = types[1];\n                            }\n                            formatEx = types[0];\n\n                            String formatStr = FreeMarkers.renderString(formatEx, jo);\n                            short format = dataFormat.getFormat(formatStr);\n                            cellStyleFormat.setDataFormat(format);\n                            currCell.setCellStyle(cellStyleFormat);\n                        }\n                    } else {\n                        currCell.setCellStyle(cellStyle);\n                    }\n\n\n                    String name = nameList.get(j);\n                    func = FORMULA.getString(name);\n\n                    if (StringUtils.isNotEmpty(name) && StringUtils.trim(name)\n                            .startsWith(\"expression=\")) { // freemarker表达式\n                        String freemarkerValueStr = FreeMarkers.renderString(StringUtils.trim(name).substring(11), jo);\n                        jo.put(name, freemarkerValueStr);\n                    }\n                    if (StringUtils.isNotEmpty(name) && StringUtils.isNotEmpty(jo.getString(name))) {\n\n                        if (StringUtils.equalsIgnoreCase(\"integer\", type)\n                                || StringUtils.equalsIgnoreCase(\"integerNoCamma\", type)) {\n                            currCell.setCellValue(jo.getIntValue(name));\n                        } else if (StringUtils.equalsIgnoreCase(\"number\", type)\n                                || StringUtils.equalsIgnoreCase(\"numberNoComma\", type)) {\n                            currCell.setCellValue(jo.getDouble(name));\n                        } else if (StringUtils.equalsIgnoreCase(\"price\", type)) {\n                            currCell.setCellValue(jo.getDouble(name));\n                        } else if (StringUtils.equalsIgnoreCase(\"date\", type)) {\n                            Long value = jo.getLong(name);\n                            if (value != null && value != 0) {\n                                currCell.setCellValue(DateTool.parseLongToString(value, DateTool.DAY_PARTTEN));\n                            }\n                        } else if (StringUtils.equalsIgnoreCase(\"time\", type)) {\n                            Long value = jo.getLong(name);\n                            if (value != null && value != 0) {\n                                currCell.setCellValue(DateTool.parseLongToString(value, DateTool.DAY_PARTTEN_OFFICIAL));\n                            }\n                        } else if (StringUtils.equalsIgnoreCase(\"percent\", type)) {\n                            currCell.setCellValue(jo.getDouble(name));\n                        } else {\n                            currCell.setCellType(CELL_TYPE_STRING);\n                            currCell.setCellValue(jo.getString(name));\n\n                            if (conf.containsKey(\"textMaxLength\") && null != conf.getInteger(\"textMaxLength\")) {\n                                if (jo.getString(name).length() > conf.getInteger(\"textMaxLength\")) {\n                                    autosizeList.set(j, \"0\");\n                                    cellLenTooLong = true;\n                                    CellStyle cellStyleTooLong = currCell.getCellStyle();\n                                    currCell.setCellStyle(cellStyleTooLong);\n                                }\n                            }\n                        }\n                    }\n\n                    // 赋值函数\n                    if (StrUtils.isNotEmpty(func)) {\n                        func = func.replace(\"{ROW}\", (i + AUTOSIZE_ROW - 1) + \"\").replace(\"{COL}\", (j + 1) + \"\");\n                        currCell.setCellFormula(func);\n\n                    }\n\n                }\n\n                if (cellLenTooLong && conf.containsKey(\"cellWidth\") && null != conf.getInteger(\"cellWidth\")) {\n                    sheet.setColumnWidth(i, conf.getInteger(\"cellWidth\"));\n                }\n\n            }\n\n            // 设置是否自适应宽度\n            for (int j = 0; j < lastCellNum; j++) {\n                boolean flag = true;\n                if (autosizeList.size() > 0) {\n                    String val = autosizeList.get(j);\n                    if (StringUtils.equals(val, \"0\")) {\n                        flag = false;\n                    }\n                }\n                if (flag) {\n                    sheet.autoSizeColumn(j);\n                }\n            }\n        } catch (Exception e) {\n            e.printStackTrace();\n        }\n        return wb;\n    }\n\n    /**\n     * 创建动态excel模板\n     *\n     * @return\n     */\n    public static Workbook createExcelDynamicTemp1(List<List<String>> tempRow, String sheetName) {\n        Workbook wb = new XSSFWorkbook(); // 构建Excel\n        if (StrUtils.isEmpty(sheetName)) {\n            sheetName = \"sheet1\";\n        }\n        Sheet sheet = wb.createSheet(sheetName); // 构建sheet页\n        Row row = null;\n        Cell cell = null;\n        CellStyle cellStyle = getBorderedCellStyle(wb);\n        if (null != tempRow) {\n            for (int i = 0; i < tempRow.size(); i++) {\n                List<String> tempR = tempRow.get(i);\n                row = sheet.createRow(i);\n                if (null != tempR && tempR.size() > 0) {\n                    for (int j = 0; j < tempR.size(); j++) {\n                        cell = row.createCell(j);\n                        cell.setCellValue(tempR.get(j));\n                        if (i == 0) { // 头部标题行\n                            cellStyle.setFillForegroundColor(IndexedColors.GREY_25_PERCENT.getIndex());\n                            cellStyle.setFillPattern(FillPatternType.SOLID_FOREGROUND);\n                            sheet.autoSizeColumn(j);\n                        }\n                        cell.setCellStyle(cellStyle);\n                    }\n                }\n\n            }\n        }\n        return wb;\n    }\n\n    public static Workbook createExcelDynamicTemp(List<List<String>> tempRow, String sheetName) {\n        Workbook wb = new XSSFWorkbook(); // 构建Excel\n        if (StrUtils.isEmpty(sheetName)) {\n            sheetName = \"sheet1\";\n        }\n        Sheet sheet = wb.createSheet(sheetName); // 构建sheet页\n        if (CollectionUtils.isEmpty(tempRow)) {\n            return wb;\n        }\n\n        createHeaderRow(wb, sheet, tempRow.get(0));\n        createRows(wb, sheet, tempRow, null);\n\n        return wb;\n    }\n\n    /**\n     * 对金额优化\n     * @param tempRow\n     * @param sheetName\n     * @return\n     */\n    public static Workbook createExcelDynamicTempWithNum(List<List<String>> tempRow, String sheetName,\n                                                         List<Integer> amounts) {\n        Workbook wb = new XSSFWorkbook(); // 构建Excel\n        if (StrUtils.isEmpty(sheetName)) {\n            sheetName = \"sheet1\";\n        }\n        Sheet sheet = wb.createSheet(sheetName); // 构建sheet页\n        if (CollectionUtils.isEmpty(tempRow)) {\n            return wb;\n        }\n\n        createHeaderRow(wb, sheet, tempRow.get(0));\n        createRows(wb, sheet, tempRow, amounts);\n\n        return wb;\n    }\n\n    private static void createHeaderRow(Workbook wb, Sheet sheet, List<String> tempR) {\n        CellStyle headerCellStyle = getBorderedCellStyle(wb);\n        headerCellStyle.setFillForegroundColor(IndexedColors.GREY_25_PERCENT.getIndex());\n        headerCellStyle.setFillPattern(FillPatternType.SOLID_FOREGROUND);\n        Row row = sheet.createRow(0);\n        if (CollectionUtils.isNotEmpty(tempR)) {\n            Cell cell;\n            for (int j = 0; j < tempR.size(); j++) {\n                cell = row.createCell(j);\n                cell.setCellValue(tempR.get(j));\n                cell.setCellStyle(headerCellStyle);\n                sheet.autoSizeColumn(j);\n            }\n        }\n    }\n\n    private static void createRows(Workbook wb, Sheet sheet, List<List<String>> tempRow, List<Integer> amounts) {\n        Row row;\n        Cell cell;\n        CellStyle cellStyle = getBorderedCellStyle(wb);\n        Map<String, CellStyle> cellStyleMap = getCellStyleMap(wb);\n        for (int i = 1; i < tempRow.size(); i++) {\n            List<String> tempR = tempRow.get(i);\n            row = sheet.createRow(i);\n            if (CollectionUtils.isNotEmpty(tempR)) {\n                for (int j = 0; j < tempR.size(); j++) {\n                    cell = row.createCell(j);\n                    if (StringUtils.isNotBlank(tempR.get(j))) {\n                        if (CollectionUtils.isNotEmpty(amounts) && amounts.contains(j)) {\n                            cell.setCellValue(Double.parseDouble(tempR.get(j)));\n                            cell.setCellStyle(cellStyleMap.get(\"number\"));\n                        } else {\n                            cell.setCellValue(tempR.get(j));\n                            cell.setCellStyle(cellStyle);\n                        }\n                    }\n                }\n            }\n        }\n    }\n\n    public static JSONObject getDefaultConfig(JSONObject config) {\n        JSONObject conf = new JSONObject();\n        if (config != null) {\n            conf = config;\n        }\n        if (conf.getInteger(\"sheetIndex\") == null) {\n            conf.put(\"sheetIndex\", DEFAULT_SHEET_INDEX);\n        }\n        if (conf.getInteger(\"nameRow\") == null) {\n            conf.put(\"nameRow\", DEFAULT_NAME_ROW);\n        }\n        if (conf.getInteger(\"typeRow\") == null) {\n            conf.put(\"typeRow\", DEFAULT_TYPE_ROW);\n        }\n        if (conf.getInteger(\"autoSizeRow\") == null) {\n            conf.put(\"autoSizeRow\", DEFAULT_AUTOSIZE_ROW);\n        }\n        if (conf.getJSONObject(\"dataValidation\") == null) {\n            conf.put(\"dataValidation\", new JSONObject());\n        }\n        if (conf.getJSONObject(\"formula\") == null) {\n            conf.put(\"formula\", new JSONObject());\n        }\n\n        return conf;\n    }\n\n    public static CellStyle getBorderedCellStyle(Workbook wb) {\n        CellStyle cellStyle = wb.createCellStyle();\n\n        cellStyle.setBorderBottom(BorderStyle.THIN);\n        cellStyle.setBorderLeft(BorderStyle.THIN);\n        cellStyle.setBorderRight(BorderStyle.THIN);\n        cellStyle.setBorderTop(BorderStyle.THIN);\n        cellStyle.setVerticalAlignment(VerticalAlignment.CENTER);\n        return cellStyle;\n    }\n\n    public static Map<String, CellStyle> getCellStyleMap(Workbook wb) {\n        Map<String, CellStyle> map = Maps.newHashMap();\n\n        // double\n        CellStyle cellStyle = getBorderedCellStyle(wb);\n        DataFormat dataFormat = wb.createDataFormat();\n        short format = dataFormat.getFormat(\"#,##0.00\");\n        cellStyle.setDataFormat(format);\n        map.put(\"number\", cellStyle);\n\n        // numberNoComma\n        cellStyle = getBorderedCellStyle(wb);\n        dataFormat = wb.createDataFormat();\n        format = dataFormat.getFormat(\"###0.00\");\n        cellStyle.setDataFormat(format);\n        map.put(\"numberNoComma\", cellStyle);\n\n        // integer\n        cellStyle = getBorderedCellStyle(wb);\n        dataFormat = wb.createDataFormat();\n        format = dataFormat.getFormat(\"#,##0\");\n        cellStyle.setDataFormat(format);\n        map.put(\"integer\", cellStyle);\n\n        // integer without comma\n        cellStyle = getBorderedCellStyle(wb);\n        dataFormat = wb.createDataFormat();\n        format = dataFormat.getFormat(\"###0\");\n        cellStyle.setDataFormat(format);\n        map.put(\"integerNoCamma\", cellStyle);\n\n        // date\n        cellStyle = getBorderedCellStyle(wb);\n        dataFormat = wb.createDataFormat();\n        format = dataFormat.getFormat(DateTool.DAY_PARTTEN);\n        cellStyle.setDataFormat(format);\n        map.put(\"date\", cellStyle);\n\n        // time\n        cellStyle = getBorderedCellStyle(wb);\n        dataFormat = wb.createDataFormat();\n        format = dataFormat.getFormat(DateTool.DAY_PARTTEN_OFFICIAL);\n        cellStyle.setDataFormat(format);\n        map.put(\"time\", cellStyle);\n\n        // string\n        map.put(\"string\", getBorderedCellStyle(wb));\n\n        // text\n        cellStyle = getBorderedCellStyle(wb);\n        dataFormat = wb.createDataFormat();\n        format = dataFormat.getFormat(\"@\");\n        cellStyle.setDataFormat(format);\n        map.put(\"text\", cellStyle);\n\n        //price\n        cellStyle = getBorderedCellStyle(wb);\n        dataFormat = wb.createDataFormat();\n        format = dataFormat.getFormat(\"#,##0.00########\");\n        cellStyle.setDataFormat(format);\n        map.put(\"price\", cellStyle);\n\n        //percent\n        cellStyle = getBorderedCellStyle(wb);\n        dataFormat = wb.createDataFormat();\n        format = dataFormat.getFormat(\"#,##0.00%\");\n        cellStyle.setDataFormat(format);\n        map.put(\"percent\", cellStyle);\n\n        return map;\n    }\n\n    /**\n     * 获取excel单元格的字符串值；\n     * realType[auto(默认),string,date,time,number,double,integer]\n     * modified by hujianfeng\n     * date类型以\"yyyy-MM-dd\"格式返回文本；time类型以\"HH:mm:ss\"格式返回文本。\n     * 在excel上传文件中，配置行应该以\"字段名;类型;默认值\"的形式，如\"balanceDate;date\",\"onlineBalance;number;100.12\"。\n     *\n     * @param cell\n     * @param realType\n     * @param def      默认值\n     * @return\n     */\n    public static String getCellValue(Cell cell, String realType, String def) {\n        if (cell != null) {\n            switch (cell.getCellType()) {\n                case Cell.CELL_TYPE_BLANK:\n                case Cell.CELL_TYPE_ERROR:\n                    return null;\n                case Cell.CELL_TYPE_FORMULA:\n                case Cell.CELL_TYPE_BOOLEAN:\n                    break;\n                default:\n                    if (StrUtils.isNotEmpty(realType)) {\n                        if (\"string\".equalsIgnoreCase(realType)) {\n                            cell.setCellType(CELL_TYPE_STRING);\n                        } else if (\"number\".equalsIgnoreCase(realType) || \"numberNoComma\".equalsIgnoreCase(realType)\n                                || \"double\".equalsIgnoreCase(realType) || \"integer\".equalsIgnoreCase(realType)\n                                // modified by hujianfeng 20170505\n                                // 日期和时间类型，归为poi中的数字类型 Numeric cell type (whole numbers, fractional numbers, dates)\n                                || \"date\".equalsIgnoreCase(realType) || \"time\".equalsIgnoreCase(realType)) {\n                            cell.setCellType(Cell.CELL_TYPE_NUMERIC);\n                        }\n\n                    }\n            }\n\n            switch (cell.getCellType()) {\n                case Cell.CELL_TYPE_NUMERIC:\n                    if (\"integer\".equalsIgnoreCase(realType)) {\n                        try {\n                            return StrUtils.defaultString(\n                                    StrUtils.formatDoubleString2IntegerString(String.valueOf(cell.getNumericCellValue())),\n                                    def);\n                        } catch (Exception e) {\n                            return StrUtils.defaultString(\n                                    StrUtils.formatDoubleString2IntegerString(cell.getStringCellValue()),\n                                    def);\n                        }\n\n                    } else if (\"double\".equalsIgnoreCase(realType)) {\n                        try {\n                            DecimalFormat df = new DecimalFormat(\"0.##\");\n                            String cellValue = df.format(cell.getNumericCellValue());\n                            return StrUtils.defaultString(String.valueOf(cellValue), def);\n                        } catch (Exception e) {\n                            return StrUtils.defaultString(cell.getStringCellValue(), def);\n                        }\n                    }\n                    // hujianfeng 日期类型目前都以YYYY-MM-DD的格式转为文本。\n                    else if (\"date\".equalsIgnoreCase(realType)) {\n                        try {\n                            return StrUtils.defaultString(\n                                    new SimpleDateFormat(\"yyyy-MM-dd\").format(cell.getDateCellValue()), def);\n                        } catch (Exception e) {\n                            return StrUtils.defaultString(cell.getStringCellValue(), def);\n                        }\n                    }\n                    // hujianfeng 时间类型目前都以HH:mm:ss的格式转为文本。poi中的时间值，默认是1899-12-31这一天的时间。\n                    else if (\"time\".equalsIgnoreCase(realType)) {\n                        try {\n                            return StrUtils.defaultString(\n                                    new SimpleDateFormat(\"HH:mm:ss\").format(cell.getDateCellValue()), def);\n                        } catch (Exception e) {\n                            return StrUtils.defaultString(cell.getStringCellValue(), def);\n                        }\n                    }\n                    return StrUtils.defaultString(String.valueOf(cell.getNumericCellValue()), def);\n                case CELL_TYPE_STRING:\n                    // modified by hujianfeng 20170505\n                    return StrUtils.defaultString(cell.getStringCellValue(), def);\n                // try {\n                //    if (\"date\".equalsIgnoreCase(realType)) {\n                //        return StrUtils.defaultString(cell.getStringCellValue(), def);\n                //    }\n                //    if (\"time\".equalsIgnoreCase(realType)) {\n                //        return StrUtils.defaultString(cell.getStringCellValue(), def);\n                //    }\n                //    return StrUtils.defaultString(cell.getStringCellValue(), def);\n                // } catch (Exception e) {\n                //    DecimalFormat df = new DecimalFormat(\"0.##\");\n                //    String cellValue = df.format(cell.getNumericCellValue());\n                //    return StrUtils.defaultString(String.valueOf(cellValue), def);\n                // } finally {\n                // }\n                case Cell.CELL_TYPE_BOOLEAN:\n                    return StrUtils.defaultString(String.valueOf(cell.getBooleanCellValue()), def);\n                case Cell.CELL_TYPE_FORMULA:\n\n                    if (\"string\".equalsIgnoreCase(realType) || \"date\".equalsIgnoreCase(realType)\n                            || \"time\".equalsIgnoreCase(realType)) {\n                        try {\n                            return StrUtils.defaultString(String.valueOf(cell.getStringCellValue()), def); // 尝试字符串类型\n                        } catch (Exception e) {\n                            return def;\n                        }\n                    } else if (\"number\".equalsIgnoreCase(realType) || \"numberNoComma\".equalsIgnoreCase(realType)\n                            || \"double\".equalsIgnoreCase(realType) || \"integer\".equalsIgnoreCase(realType)) {\n                        try {\n                            DecimalFormat df = new DecimalFormat(\"0.##\");\n                            String cellValue = df.format(cell.getNumericCellValue());\n                            return StrUtils.defaultString(String.valueOf(cellValue), def); // 尝试数字串类型\n                        } catch (Exception e) {\n                            return def;\n                        }\n                    }\n\n                default:\n                    // 牵扯到公式计算\n                    if (cell.getCellType() == Cell.CELL_TYPE_FORMULA) {\n                        FormulaEvaluator evaluator = cell.getSheet().getWorkbook().getCreationHelper().createFormulaEvaluator();\n                        CellValue cellValue = evaluator.evaluate(cell);\n                        switch (cellValue.getCellType()) {\n                            case Cell.CELL_TYPE_BOOLEAN:\n                                return String.valueOf(cellValue.getBooleanValue());\n                            case Cell.CELL_TYPE_NUMERIC:\n                                // check if it is a date\n                                if (DateUtil.isCellDateFormatted(cell)) {\n                                    SimpleDateFormat dateFormat = new SimpleDateFormat(\"dd/MM/yyyy\");\n                                    return dateFormat.format(cell.getDateCellValue());\n                                } else {\n                                    return String.valueOf(cellValue.getNumberValue());\n                                }\n                            case Cell.CELL_TYPE_STRING:\n                                return cellValue.getStringValue();\n                            case Cell.CELL_TYPE_BLANK:\n                                // do something for blank cells\n                                break;\n                            case Cell.CELL_TYPE_ERROR:\n                                // do something for errors\n                                break;\n                    }\n                    }\n                    return null;\n            }\n\n        }\n        return null;\n    }\n\n    /**\n     * 读取excel转换为json, 含有日 默认date类型，其它String 类型\n     *\n     * @param startRow   开始行\n     * @param startCol   开始列\n     * @param fieldRowAt 与列对应的属性名及其类型、默认值、格式配置行\n     * @return\n     */\n    public static JSONArray readExcelToJSONType(InputStream in, int sheetIndex, int startRow, int startCol,\n                                            int fieldRowAt) {\n        try {\n            Workbook wb = WorkbookFactory.create(in);\n            List<String> fieldArr = new ArrayList<String>();\n            Sheet sheet = wb.getSheetAt(sheetIndex);\n            int lastRowNum = sheet.getLastRowNum();\n            int lastColNum = sheet.getRow(0).getLastCellNum();\n            Row fieldRow = sheet.getRow(fieldRowAt);\n            Cell cell = null;\n            if (fieldRow != null) {\n                for (int i = startCol; i < lastColNum; i++) {\n                    cell = fieldRow.getCell(i);\n                    cell.setCellType(CellType.STRING);\n                    if (StringUtils.isNotBlank(cell.getStringCellValue()) && cell.getStringCellValue().contains(\"日\")) {\n                        fieldArr.add(cell.getStringCellValue().concat(\";date\"));\n                    } else {\n                        fieldArr.add(cell.getStringCellValue().concat(\";string\"));\n                    }\n                }\n                return readExcelToJSON(sheet, startRow, lastRowNum, startCol, StringUtils.join(fieldArr, \"|\"));\n            }\n            return null;\n        } catch (IOException e) {\n            e.printStackTrace();\n        } catch (InvalidFormatException e) {\n            e.printStackTrace();\n        }\n\n        return null;\n    }\n\n    /**\n     * 读取excel转换为json\n     *\n     * @param startRow   开始行\n     * @param startCol   开始列\n     * @param fieldRowAt 与列对应的属性名及其类型、默认值、格式配置行\n     * @return\n     */\n    public static JSONArray readExcelToJSON(InputStream in, int sheetIndex, int startRow, int startCol,\n                                            int fieldRowAt) {\n        try {\n            Workbook wb = WorkbookFactory.create(in);\n            List<String> fieldArr = new ArrayList<String>();\n            Sheet sheet = wb.getSheetAt(sheetIndex);\n            int lastRowNum = sheet.getLastRowNum();\n            int lastColNum = sheet.getRow(0).getLastCellNum();\n            Row fieldRow = sheet.getRow(fieldRowAt);\n            Cell cell = null;\n            if (fieldRow != null) {\n                for (int i = startCol; i < lastColNum; i++) {\n                    cell = fieldRow.getCell(i);\n                    cell.setCellType(CellType.STRING);\n                    fieldArr.add(cell.getStringCellValue());\n                }\n                return readExcelToJSON(sheet, startRow, lastRowNum, startCol, StringUtils.join(fieldArr, \"|\"));\n            }\n            return null;\n        } catch (IOException e) {\n            e.printStackTrace();\n        } catch (InvalidFormatException e) {\n            e.printStackTrace();\n        }\n\n        return null;\n    }\n\n    /**\n     * 读取excel转换为json\n     *\n     * @param sheet\n     * @param startRow 开始行\n     * @param endRow   结尾行\n     * @param startCol 开始列\n     * @param fieldStr 与列对应的属性名及其类型、默认值、格式等，属性名与类型、默认值[引用列值]分号隔开例如：\"price;double;0.0|priceNotax;double;!1|taxNameZh;\n     *                 string;|createTime;time;yyyy-MM-dd HH:mm:ss\"\n     * @return\n     */\n    public static JSONArray readExcelToJSON(Sheet sheet, int startRow, int endRow, int startCol, String fieldStr) {\n        JSONArray arr = new JSONArray();\n\n        Row dataRow = null;\n        JSONObject oneObj = null;\n        String[] valueResult = null;\n        String[] fields = fieldStr.split(\"\\\\|\");\n        int endCol = startCol + fields.length - 1;\n        if (startRow > 0) {\n            for (int r = startRow; r <= endRow; r++) {\n                dataRow = sheet.getRow(r);\n                oneObj = new JSONObject();\n                oneObj.put(\"excelRowNo\", r + 1);\n                if (dataRow != null) {\n                    for (int c = startCol; c <= endCol; c++) {\n                        valueResult = readCelValue(dataRow, fields, startCol, c);\n                        if (valueResult != null && valueResult.length == 2) {\n                            oneObj.put(valueResult[0], valueResult[1]);\n                        }\n                    }\n\n                }\n                arr.add(oneObj);\n\n            }\n        }\n        return arr;\n\n    }\n\n    /**\n     * 读取excel转换为json\n     *\n     * @param sheet\n     * @param startRow 开始行 可以为0\n     * @param endRow   结尾行\n     * @param startCol 开始列\n     * @param fieldStr 与列对应的属性名及其类型、默认值、格式等，属性名与类型、默认值[引用列值]分号隔开例如：\"price;double;0.0|priceNotax;double;!1|taxNameZh;\n     *                 string;|createTime;time;yyyy-MM-dd HH:mm:ss\"\n     * @return\n     */\n    public static JSONArray readAllExcelToJSON(Sheet sheet, int startRow, int endRow, int startCol, String fieldStr) {\n        JSONArray arr = new JSONArray();\n\n        Row dataRow = null;\n        JSONObject oneObj = null;\n        String[] valueResult = null;\n        String[] fields = fieldStr.split(\"\\\\|\");\n        int endCol = startCol + fields.length - 1;\n        if (startRow >= 0) {\n            for (int r = startRow; r <= endRow; r++) {\n                dataRow = sheet.getRow(r);\n                oneObj = new JSONObject();\n                oneObj.put(\"excelRowNo\", r + 1);\n                if (dataRow != null) {\n                    for (int c = startCol; c <= endCol; c++) {\n                        valueResult = readCelValue(dataRow, fields, startCol, c);\n                        if (valueResult != null && valueResult.length == 2) {\n                            oneObj.put(valueResult[0], valueResult[1]);\n                        }\n                    }\n\n                }\n                arr.add(oneObj);\n\n            }\n        }\n        return arr;\n\n    }\n\n    private static String[] readCelValue(Row dataRow, String[] fields, int startCol, int c) {\n        Cell dataCell = null;\n        String cellVal = null;\n        String[] fileSchem = new String[3];\n        fileSchem = fields[c - startCol].split(\";\");\n        String defValue = null;\n        String[] valueResult = null;\n        if (fileSchem != null) {\n            dataCell = dataRow.getCell(c);\n            if (fileSchem.length == 1) {\n                cellVal = getCellValue(dataCell, \"auto\", null);\n            } else if (fileSchem.length == 2) {\n                cellVal = getCellValue(dataCell, fileSchem[1], null);\n            } else if (fileSchem.length >= 3) {\n                if (!StrUtils.isEmpty(fileSchem[2]) && fileSchem[2].startsWith(\"!\")) { // 引用列值\n                    valueResult = readCelValue(dataRow, fields, startCol, Integer.parseInt(fileSchem[2].substring(1)));\n                    if (valueResult != null && valueResult.length == 2) {\n                        defValue = valueResult[1];\n                    }\n                } else {\n                    defValue = fileSchem[2];\n                }\n                cellVal = getCellValue(dataCell, fileSchem[1], defValue);\n\n            }\n            if (!StrUtils.isEmpty(fileSchem[0])) {\n                return new String[]{fileSchem[0], cellVal};\n            }\n        }\n        return null;\n    }\n\n    public static void main(String[] args) {\n        System.out.println(\"!12\".substring(1));\n    }\n}\n",
