sertEquals(\"户名应一致\", \"怒访址撵鉴遮斌粤惨佣\", transaction.getAccountName());\n            assertEquals(\"币种应一致\", \"CNY\", transaction.getCurrency());\n            assertEquals(\"收支标志应一致\", \"D\", transaction.getIncomeExpenseFlag());\n        }\n\n        log.info(\"✅ 用户数据测试通过：成功解析 {} 条完整交易记录\", transactions.size());\n    }\n\n    /**\n     * 测试账号脱敏功能\n     */\n    @Test\n    public void testAccountNumberMasking() {\n        String testData = \"状态|交易日期|交易时间|业务类型|流水号|流水序号|账号|户名|收支标志|币种|交易金额|余额|可用余额|对方账号|对方户名|对方地址|对方开户行行号|对方开户行行名|票据种类|票据号码|票据名称|票据签发日期|附言|备注|交易码|备用\\n\" +\n                \"0|20251105|093003|2|EBB0001P70190041|1|310069079018800073806|测试户名|D|CNY|100.00|11991096.17|0|81100614850188002002204|对方户名||01110146999|开户行名称||||||测试附言|101700||\";\n\n        List<BankTransaction> transactions = BankTransactionParser.parseBankTransactions(testData);\n        Transaction transaction = transactions.get(0);\n\n        // 验证账号不应为空\n        assertNotNull(\"账号不应为空\", transaction.getAccountNumber());\n        assertNotNull(\"对方账号不应为空\", transaction.getCounterpartyAccount());\n\n        log.info(\"✅ 账号脱敏测试通过\");\n    }\n}",
