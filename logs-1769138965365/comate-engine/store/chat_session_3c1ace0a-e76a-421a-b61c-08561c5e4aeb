                  "content": "/*\n * Copyright (C) 2018 Baidu, Inc. All Rights Reserved.\n */\npackage com.baidu.pmc.core.controller;\n\nimport com.baidu.pmc.common.ResponseMessage;\nimport com.baidu.pmc.common.exception.ServiceException;\nimport com.baidu.pmc.common.utils.RedisLock;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.common.utils.ThreadPoolExecutorUtil;\nimport com.baidu.pmc.core.service.PayChecksService;\nimport com.baidu.pmc.core.service.PaySelectInitComponent;\nimport com.baidu.pmc.core.service.PayStatusManager;\nimport com.baidu.pmc.core.service.PmcPayScheduleRecService;\nimport com.baidu.pmc.pojo.constants.PayNode;\nimport com.baidu.pmc.pojo.constants.PayOperation;\nimport com.baidu.pmc.pojo.dto.PayCheckHangupDTO;\nimport com.baidu.pmc.pojo.dto.PayCheckIdDTO;\nimport com.baidu.pmc.pojo.dto.PayCheckIdsDTO;\nimport com.baidu.pmc.pojo.dto.PayCheckSplitDTO;\nimport com.baidu.pmc.pojo.dto.PayChecksDTO;\nimport com.baidu.pmc.pojo.dto.PayChecksInfoModifyDTO;\nimport com.baidu.pmc.pojo.dto.SelectDTO;\nimport com.baidu.pmc.pojo.model.PmcPayChecks;\nimport com.baidu.pmc.pojo.qo.PayChecksQO;\nimport com.github.pagehelper.PageInfo;\nimport lombok.extern.slf4j.Slf4j;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.http.HttpStatus;\nimport org.springframework.http.ResponseEntity;\nimport org.springframework.validation.BindingResult;\nimport org.springframework.validation.annotation.Validated;\nimport org.springframework.web.bind.annotation.PostMapping;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.RestController;\n\nimport java.time.Duration;\nimport java.time.Instant;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.concurrent.ExecutorService;\n\n/**\n * 付款受理控制器\n */\n@RestController\n@Slf4j\n@RequestMapping(\"/pay_review\")\npublic class PayReviewController {\n    @Autowired\n    private PayChecksService payChecksService;\n\n    @Autowired\n    private PaySelectInitComponent paySelectInitComponent;\n\n    @Autowired\n    private PayStatusManager payStatusManager;\n    @Autowired\n    private PmcPayScheduleRecService pmcPayScheduleRecService;\n    /**\n     * 10 毫秒重试\n     */\n    private static final long REDIS_LOCK_TIMEOUT = 10;\n    /**\n     * 1 分钟超时\n     */\n    private static final int REDIS_LOCK_EXPIRE = 1 * 60;\n\n    /**\n     * 查询页面接口\n     *\n     * @param qo 查询条件\n     * @return\n     */\n    @PostMapping(\"/list\")\n    public ResponseEntity<PageInfo> list(@RequestBody PayChecksQO qo) {\n        Instant startInstant = Instant.now();\n        log.info(\"================= controller get pay start =================\");\n        if (StringUtils.isBlank(qo.getStatus())) {\n            qo.setDefaultStatus(payStatusManager.getReviewQueryDefaultStatus());\n        }\n        qo.setBdDirectFlag(\"N\");\n        PageInfo<PayChecksDTO> pageInfo = payChecksService.selectPayChecksWithPermission(qo);\n        Instant endInstant = Instant.now();\n        log.info(\"================= controller get pay end cost =================\" + Duration.between(startInstant,\n                endInstant).toMillis());\n        return new ResponseEntity<>(pageInfo, HttpStatus.OK);\n    }\n\n    /**\n     * 编辑付款接口 (不含历史付款清单操作和收款人信息变更纪录)\n     *\n     * @param checkId 付款ID DTO\n     * @return\n     */\n    @PostMapping(\"/edit\")\n    public ResponseEntity<Object> edit(@RequestBody @Validated PayCheckIdDTO checkId, BindingResult result) {\n        if (result.hasErrors()) {\n            return new ResponseEntity<>(ResponseMessage.fail(result.getAllErrors().toString()), HttpStatus.OK);\n        }\n        PayChecksDTO payChecksDTO = payChecksService.selectByCheckId(checkId.getCheckId());\n        return new ResponseEntity<Object>(ResponseMessage.success(payChecksDTO), HttpStatus.OK);\n    }\n\n    /**\n     * 查看付款接口（含历史付款清单操作和收款人信息变更纪录）\n     *\n     * @param checkId 付款ID DTO\n     * @return\n     */\n    @PostMapping(\"/edit/load\")\n    public ResponseEntity<Object> load(@RequestBody @Validated PayCheckIdDTO checkId, BindingResult result) {\n        if (result.hasErrors()) {\n            return new ResponseEntity<>(ResponseMessage.fail(result.getAllErrors().toString()), HttpStatus.OK);\n        }\n        PayChecksDTO payChecksDTO = payChecksService.selectByCheckIdWithHistory(checkId.getCheckId());\n        return new ResponseEntity<Object>(ResponseMessage.success(payChecksDTO), HttpStatus.OK);\n    }\n\n    /**\n     * 保存付款清单和收款人信息\n     *\n     * @param dto 付款编辑DTO\n     * @return\n     */\n    @PostMapping(\"/save\")\n    public ResponseEntity<Object> save(@RequestBody @Validated PayChecksInfoModifyDTO dto, BindingResult result) {\n        if (result.hasErrors()) {\n            return new ResponseEntity<>(ResponseMessage.fail(result.getAllErrors().toString()), HttpStatus.OK);\n        }\n        try {\n            payChecksService.updateReview(dto);\n        } catch (ServiceException e) {\n            return new ResponseEntity<>(ResponseMessage.fail(e.getMessage()), HttpStatus.OK);\n        }\n        return new ResponseEntity<>(ResponseMessage.success(\"保存成功！\"), HttpStatus.OK);\n    }\n\n    /**\n     * 暂挂付款接口\n     *\n     * @param payCheckId 付款暂挂 DTO\n     * @return\n     */\n    @PostMapping(\"/hangup\")\n    public ResponseEntity<Object> hangup(@RequestBody @Validated PayCheckHangupDTO payCheckId, BindingResult result) {\n        if (result.hasErrors()) {\n            return new ResponseEntity<>(ResponseMessage.fail(result.getAllErrors().toString()), HttpStatus.OK);\n        }\n        String operationResult;\n        try {\n            operationResult = payChecksService.hangup(payCheckId, PayNode.valueOf(payCheckId.getPayNode()));\n        } catch (ServiceException e) {\n            return new ResponseEntity<>(ResponseMessage.fail(\"暂挂失败，原因：\" + e.getMessage()), HttpStatus.OK);\n        }\n        if (operationResult == null) {\n            return new ResponseEntity<>(ResponseMessage.success(\"暂挂成功！\"), HttpStatus.OK);\n        }\n        return new ResponseEntity<>(ResponseMessage.fail(operationResult), HttpStatus.OK);\n    }\n\n    /**\n     * 取消暂挂接口\n     *\n     * @param payCheckId 付款暂挂 DTO\n     * @return\n     */\n    @PostMapping(\"/cancel_hangup\")\n    public ResponseEntity<Object> cancelHangup(@RequestBody @Validated PayCheckHangupDTO payCheckId,\n                                               BindingResult result) {\n        if (result.hasErrors()) {\n            return new ResponseEntity<>(ResponseMessage.fail(result.getAllErrors().toString()), HttpStatus.OK);\n        }\n        String operationResult = payChecksService.cancelHangup(payCheckId, PayNode.valueOf(payCheckId.getPayNode()));\n        if (operationResult == null) {\n            return new ResponseEntity<>(ResponseMessage.success(\"取消暂挂成功！\"), HttpStatus.OK);\n        }\n        return new ResponseEntity<>(ResponseMessage.fail(operationResult), HttpStatus.OK);\n    }\n\n    /**\n     * 终止付款接口\n     *\n     * @param payCheckId 付款ID DTO\n     * @return\n     */\n    @PostMapping(\"/cancel\")\n    public ResponseEntity<Object> cancel(@RequestBody @Validated PayCheckIdDTO payCheckId, BindingResult result) {\n        if (result.hasErrors()) {\n            return new ResponseEntity<>(ResponseMessage.fail(result.getAllErrors().toString()), HttpStatus.OK);\n        }\n        try {\n            payChecksService.cancel(payCheckId, PayNode.PAY_REVIEW);\n        } catch (ServiceException e) {\n            return new ResponseEntity<>(ResponseMessage.fail(\"终止付款失败，原因：\" + e.getMessage()), HttpStatus.OK);\n        }\n        return new ResponseEntity<>(ResponseMessage.success(\"操作成功！\"), HttpStatus.OK);\n    }\n\n    /**\n     * 终止付款接口List\n     *\n     * @param payCheckId 付款ID DTO\n     * @return\n     */\n    @PostMapping(\"/cancelList\")\n    public ResponseEntity<Object> cancelList(@RequestBody @Validated PayCheckIdsDTO payCheckId, BindingResult result) {\n        if (result.hasErrors()) {\n            return new ResponseEntity<>(ResponseMessage.fail(result.getAllErrors().toString()), HttpStatus.OK);\n        }\n        try {\n            payChecksService.cancelList(payCheckId, PayNode.PAY_REVIEW);\n        } catch (ServiceException e) {\n            return new ResponseEntity<>(ResponseMessage.fail(\"终止付款失败，原因：\" + e.getMessage()), HttpStatus.OK);\n        }\n        return new ResponseEntity<>(ResponseMessage.success(\"操作成功！\"), HttpStatus.OK);\n    }\n\n    /**\n     * 根据ID检测付款计划付款日期接口\n     *\n     * @param checkIds 付款ID DTO 集合\n     * @return\n     */\n    @PostMapping(\"/review_check\")\n    public ResponseEntity<Object> reviewCheckByIds(@RequestBody @Validated PayCheckIdsDTO checkIds,\n                                                   BindingResult result) {\n        if (result.hasErrors()) {\n            return new ResponseEntity<>(ResponseMessage.fail(result.getAllErrors().toString()), HttpStatus.OK);\n        }\n        String operationResult = payChecksService.checkPayPlanDateByIds(checkIds);\n        if (operationResult == null) {\n            return new ResponseEntity<>(ResponseMessage.success(null), HttpStatus.OK);\n        }\n        return new ResponseEntity<>(ResponseMessage.fail(operationResult), HttpStatus.OK);\n    }\n\n    /**\n     * 按查询条件检测付款计划付款日期接口\n     *\n     * @param qo 查询条件\n     * @return\n     */\n    @PostMapping(\"/review_query_check\")\n    public ResponseEntity<Object> reviewCheckByQuery(@RequestBody PayChecksQO qo) {\n        payStatusManager.setDefaultStatusIfNecessary(qo, PayOperation.REVIEW);\n        String operationResult = payChecksService.checkPayPlanDateByQuery(qo);\n        if (operationResult == null) {\n            return new ResponseEntity<>(ResponseMessage.success(null), HttpStatus.OK);\n        }\n        return new ResponseEntity<>(ResponseMessage.fail(operationResult), HttpStatus.OK);\n    }\n\n    /**\n     * 根据ID付款受理\n     *\n     * @param checkId 付款ID DTO\n     * @return\n     */\n    @PostMapping(\"/review\")\n    public ResponseEntity<Object> reviewById(@RequestBody @Validated PayCheckIdDTO checkId, BindingResult result) {\n        if (result.hasErrors()) {\n            return new ResponseEntity<>(ResponseMessage.fail(result.getAllErrors().toString()), HttpStatus.OK);\n        }\n        try {\n            payChecksService.reviewById(checkId);\n        } catch (ServiceException e) {\n            return new ResponseEntity<>(ResponseMessage.fail(\"付款受理失败，原因：\" + e.getMessage()), HttpStatus.OK);\n        }\n        return new ResponseEntity<>(ResponseMessage.success(\"付款受理成功！\"), HttpStatus.OK);\n    }\n\n    /**\n     * 根据ID批量取消受理\n     *\n     * @param checkIds 付款ID集合\n     * @return\n     */\n    @PostMapping(\"/cancel_review\")\n    public ResponseEntity<Object> cancelReview(@RequestBody @Validated PayCheckIdsDTO checkIds, BindingResult result) {\n        if (result.hasErrors()) {\n            return new ResponseEntity<>(ResponseMessage.fail(result.getAllErrors().toString()), HttpStatus.OK);\n        }\n        try {\n            int batch = payChecksService.cancelReview(checkIds);\n            return new ResponseEntity<>(ResponseMessage.success(\"取消\" + batch + \"条付款受理成功\"), HttpStatus.OK);\n        } catch (ServiceException e) {\n            return new ResponseEntity<>(ResponseMessage.fail(\"付款取消受理失败，原因：\" + e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 根据ID批量受理\n     *\n     * @param checkIds 付款ID集合\n     * @return\n     */\n    @PostMapping(\"/batch_review\")\n    public ResponseEntity<Object> batchReview(@RequestBody @Validated PayCheckIdsDTO checkIds, BindingResult result) {\n        if (result.hasErrors()) {\n            return new ResponseEntity<>(ResponseMessage.fail(result.getAllErrors().toString()), HttpStatus.OK);\n        }\n        try {\n            int batch = payChecksService.batchReview(checkIds);\n            return new ResponseEntity<>(ResponseMessage.success(batch + \"条付款受理成功\"), HttpStatus.OK);\n        } catch (ServiceException e) {\n            return new ResponseEntity<>(ResponseMessage.fail(\"付款受理失败，原因：\" + e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 根据查询条件批量受理\n     *\n     * @param qo 查询条件\n     * @return\n     */\n    @PostMapping(\"/review_query\")\n    public ResponseEntity<Object> reviewByQuery(@RequestBody PayChecksQO qo) {\n        payStatusManager.setDefaultStatusIfNecessary(qo, PayOperation.REVIEW);\n        try {\n            int batch = payChecksService.reviewByQuery(qo);\n            return new ResponseEntity<>(ResponseMessage.success(batch + \"条付款受理成功\"), HttpStatus.OK);\n        } catch (ServiceException e) {\n            return new ResponseEntity<>(ResponseMessage.fail(\"付款受理失败，原因：\" + e.getMessage()), HttpStatus.OK);\n        }\n    }\n\n    /**\n     * 下拉列表初始化\n     *\n     * @return\n     */\n    @PostMapping(\"/init_select\")\n    public ResponseEntity<Map<String, List<SelectDTO>>> initSelect() {\n        List<String> filteredStatus = payStatusManager.getReviewQueryDefaultStatus();\n        Map<String, List<SelectDTO>> selectDtoMap = paySelectInitComponent.getBasicSelectDtoMap(filteredStatus);\n\n        selectDtoMap.put(\"payGroup\", paySelectInitComponent.getPayGroup());\n        return new ResponseEntity<Map<String, List<SelectDTO>>>(selectDtoMap, HttpStatus.OK);\n    }\n\n    /**\n     * 付款拆分\n     *\n     * @return\n     */\n    @PostMapping(\"/pay_split\")\n    public ResponseEntity<Object> paySplit(@RequestBody @Validated PayCheckSplitDTO checkId, BindingResult result) {\n        log.info(\"拆分付款：{}\", checkId);\n        if (result.hasErrors()) {\n            return new ResponseEntity<>(ResponseMessage.fail(result.getAllErrors().toString()), HttpStatus.OK);\n        }\n        String redisKey = \"split_pay_check\" + checkId.getCheckId();\n        log.info(\"redisKey:{}\", redisKey);\n        RedisLock redisLock = new RedisLock(redisKey);\n        try {\n            if (!redisLock.lock(REDIS_LOCK_TIMEOUT, REDIS_LOCK_EXPIRE)) {\n                log.info(\"付款正在拆分中，稍后再试：{}\", checkId);\n                throw new ServiceException(\"付款正在拆分中，稍后再试！\");\n            }\n            PayChecksDTO payChecksDTO = payChecksService.splitPayCheck(checkId);\n\n            // 异步推送\n            ExecutorService executor = ThreadPoolExecutorUtil.getExecutorService();\n            executor.execute(() -> {\n                log.info(\"执行推送拆分付款计划：{}\", payChecksDTO.getCheckId());\n                pmcPayScheduleRecService.pushSplitPaySchedule(payChecksDTO.getCheckId());\n            });\n\n            return new ResponseEntity<Object>(ResponseMessage.success(payChecksDTO), HttpStatus.OK);\n        } catch (ServiceException e) {\n            return new ResponseEntity<>(ResponseMessage.fail(\"付款拆分失败，原因：\" + e.getMessage()), HttpStatus.OK);\n        } catch (Exception e) {\n            log.error(\"拆分异常,checkid={},错误信息={}\", checkId, e);\n            throw new ServiceException(\"拆分异常\");\n        } finally {\n            redisLock.unlock();\n        }\n    }\n\n    /**\n     * 检查单据是否有关联的父单或子单\n     */\n    @PostMapping(\"/checkRelPayNum\")\n    public ResponseEntity<Object> checkRelPayNum(@RequestBody @Validated PayCheckIdDTO checkId, BindingResult result) {\n        log.info(\"检查单据是否有关联的父单或子单：{}\", checkId);\n        if (result.hasErrors()) {\n            return new ResponseEntity<>(ResponseMessage.fail(result.getAllErrors().toString()), HttpStatus.OK);\n        }\n        List<PmcPayChecks> payChecksList = payChecksService.getRelPayNums(checkId.getCheckId());\n        return new ResponseEntity<>(ResponseMessage.success(payChecksList), HttpStatus.OK);\n    }\n\n    /**\n     * 手动补偿拆分未付款\n     */\n    @PostMapping(\"/paySplitUnPayCheckMail\")\n    public ResponseEntity<Object> paySplitUnPayCheckMail() {\n        log.info(\"手动补偿拆分未付款：{}\");\n\n        payChecksService.paySplitUnPayCheckMail();\n        return new ResponseEntity<>(ResponseMessage.success(\"调用成功\"), HttpStatus.OK);\n    }\n}",
