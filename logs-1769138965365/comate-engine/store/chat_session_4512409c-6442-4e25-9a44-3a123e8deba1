on;\nimport java.util.stream.Collectors;\n\n/**\n * 通用策略\n */\n@Slf4j\n@Service\npublic class CommonBankStrategy implements BankStrategy {\n\n    /**\n     * 引入以下3个接口原因：\n     * 最初这个CommonBankStrategy是用来做通用化处理逻辑实现的，但是因为分工不同，已经在BankcommonXXXService中实现了，\n     * 所以这里不再实现，而是引入这几个模块，直接调用对应的方法即可。\n     * 后续接入新的银行时，则参考CmbBankStrategy\n     * 需要特殊处理时则重写对应方法，否则引入CommonBankStrategy然后直接调用CommonBankStrategy对应方法即可\n     */\n    @Autowired\n    private BankcommonPayInstructService bankcommonPayInstructService;\n\n    @Autowired\n    private BankcommonService bankcommonService;\n\n    @Autowired\n    private BankcommonReceiptService bankcommonReceiptService;\n\n    @Autowired\n    private BankInstructUtil bankInstructUtil;\n\n    @Autowired\n    private MachineService machineService;\n\n    @Autowired\n    private SendMailService mailService;\n\n    @Autowired\n    private PmcPayCommonBankSetMapper pmcPayCommonBankSetMapper;\n\n\n    @Override\n    public String getBankStrategy() {\n        return BankStrategyCode.COMMON;\n    }\n\n    @Override\n    public Page<PayInstructDTO> getPayInstructList(PayInstructQO qo) {\n        return bankcommonPayInstructService.bankcommonInstructList(qo, null);\n    }\n\n    @Override\n    public Integer genBankUnUrgentPay(String bankCode) {\n        return bankcommonPayInstructService.genBankcommonUnUrgentPay(bankCode, null);\n    }\n\n    @Override\n    public List<TransInfo> selectBankTrans(PayQO qo) {\n        return bankcommonService.selectBankcommonTrans(qo, null);\n    }\n\n    @Override\n    public List<BalanceInfo> selectBankBalance(PayQO qo) {\n        return bankcommonService.selectBankcommonBalance(qo, null);\n    }\n\n    @Override\n    public List<BalanceInfo> queryBalanceForCheck(List<PayQO> qos) {\n        return bankcommonService.queryBankcommonBalanceForCheck(qos, null);\n    }\n\n    @Override\n    public Page<PayInstructDTO> bankSuspectList(PayInstructQO qo) {\n        return bankcommonPayInstructService.bankcommonSuspectList(q