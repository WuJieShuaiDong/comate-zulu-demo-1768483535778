                  "content": "package com.baidu.pmc.bankcommon.core.utils;\n\nimport com.baidu.pmc.bankcommon.core.constants.Constants;\nimport com.baidu.pmc.bankcommon.core.dto.BankcommonReceiptDTO;\nimport com.baidu.pmc.bankcommon.core.dto.ResponseBodyDTO;\nimport com.baidu.pmc.bankcommon.core.dto.ResponseHeaderDTO;\nimport com.baidu.pmc.bankcommon.core.service.impl.OperateByJDBC;\nimport com.baidu.pmc.bankcommon.persistence.dao.PmcPayCommonBankColSetMapper;\nimport com.baidu.pmc.bankcommon.persistence.dao.PmcPayCommonBankSetMapper;\nimport com.baidu.pmc.bankcommon.persistence.dao.PmcPayCommonTransFlexSetMapper;\nimport com.baidu.pmc.bankcommon.persistence.domain.PmcPayCommonBankColSet;\nimport com.baidu.pmc.bankcommon.persistence.domain.PmcPayCommonTransFlexSet;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.pojo.dto.cmb.BalanceInfo;\nimport com.baidu.pmc.pojo.dto.cmb.RefundInfo;\nimport com.baidu.pmc.pojo.dto.cmb.TransInfo;\nimport com.baidu.pmc.pojo.model.PmcPayCommonBankSet;\nimport com.baidu.pmc.pojo.model.fnd.FndFlexValue;\nimport com.baidu.scan.safesdk.SafeXml;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections.CollectionUtils;\nimport org.jdom2.Document;\nimport org.jdom2.Element;\nimport org.jdom2.input.SAXBuilder;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\nimport org.xml.sax.InputSource;\nimport tk.mybatis.mapper.entity.Example;\n\nimport java.io.StringReader;\nimport java.math.BigDecimal;\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.Date;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Optional;\n\n/**\n * xml 响应体解析\n *\n * @author liuyanzhong\n */\n@Slf4j\n@Service\npublic class ResponseXmlParser {\n\n    @Autowired\n    private PmcPayCommonBankColSetMapper pmcPayCommonBankColSetMapper;\n\n    @Autowired\n    private PmcPayCommonTransFlexSetMapper pmcPayCommonTransFlexSetMapper;\n\n    @Autowired\n    private OperateByJDBC operateByJDBC;\n\n    @Autowired\n    private PmcPayCommonBankSetMapper pmcPayCommonBankSetMapper;\n\n    /**\n     * 银行响应报文\n     */\n    public ResponseHeaderDTO parseResponseXml(String response, Map<String, Object> dto) {\n        String funName = StringUtils.toString(dto.get(\"funName\"));\n        if (StringUtils.isEmpty(response)) {\n            return null;\n        }\n        response = generateResponse(response, dto);\n        log.info(\"parseResponseXml 解析xml返回报文, xml={}\", response);\n        ResponseHeaderDTO result = null;\n\n        try {\n\n            result = new ResponseHeaderDTO();\n            log.info(\"parseHeaderXml 解析xml返回报文第一步(head解析)\");\n            StringReader reader = new StringReader(response);\n            InputSource source = new InputSource(reader);\n            SafeXml safeXml = new SafeXml(SafeXml.Level.NONE);\n            SAXBuilder sax = safeXml.getSAXBuilder();\n            Document doc = sax.build(source);\n\n            Element rootElement = doc.getRootElement();\n            if (null != rootElement) {\n                ResponseHeaderDTO.SystemHeadBean systemHeadBean = parseHeadCoomon(rootElement, dto);\n                result.setHeader(systemHeadBean);\n            } else {\n                return null;\n            }\n\n            log.info(\"parseBodyXml 解析xml返回报文第二步(body解析)\");\n\n            ResponseBodyDTO body = null;\n            switch (funName) {\n                case Constants.BankcommonTranscodeEnum.BALANCE_NOW:\n                    body = parseBalanceNow(rootElement, dto);\n                    break;\n                case Constants.BankcommonTranscodeEnum.BALANCE_OLD:\n                    body = parseBalanceOld(rootElement, dto);\n                    break;\n                case Constants.BankcommonTranscodeEnum.BANK_PAY:\n                    body = parseBankPay(rootElement, dto);\n                    break;\n                case Constants.BankcommonTranscodeEnum.PAY_STATUS:\n                    body = parsePayStatus(rootElement, dto);\n                    break;\n                case Constants.BankcommonTranscodeEnum.TRANSACTIONS:\n                    body = parseTransactions(rootElement, dto);\n                    break;\n                case Constants.BankcommonTranscodeEnum.ELECT_RECEIPT_QEURY:\n                    body = parseElectReceiptQuery(rootElement, dto);\n                    break;\n                case Constants.BankcommonTranscodeEnum.ELECT_RECEIPT_DOWNLOAD:\n                    body = parseElectReceiptDownload(rootElement, dto);\n                    break;\n                case Constants.BankcommonTranscodeEnum.REFUND:\n                    body = parseRefund(rootElement, dto);\n                    break;\n                default:\n                    break;\n            }\n            result.setBody(body);\n        } catch (Exception e) {\n            log.error(\"parseHeaderXml 解析银行头部响应xml异常\", e);\n        }\n        return result;\n    }\n\n    /**\n     * 余额查询响应报文体\n     */\n    private ResponseBodyDTO parseBalanceNow(Element root, Map<String, Object> dto) {\n        dto.put(\"interfaceType\", Constants.BankcommonTranscodeEnum.BALANCE_NOW);\n        ResponseBodyDTO body = new ResponseBodyDTO();\n        try {\n            log.info(\"parseBalanceNow start ...\");\n            // 先定位到余额的节点\n            Example example = new Example(PmcPayCommonBankColSet.class);\n            example.createCriteria().\n                    andEqualTo(\"bankCode\", dto.get(\"bankCode\"))\n                    .andEqualTo(\"interfaceType\", dto.get(\"interfaceType\"))\n                    .andEqualTo(\"interfaceDirection\", Constants.BankcommonInterfaceDirectionEnum.RESPONSE)\n                    .andEqualTo(\"columnCode\", Constants.BankcommonColumnCodeEnum.BALANCE_NOW)\n                    .andEqualTo(\"enableFlag\", Constants.ENABLED_Y);\n            List<PmcPayCommonBankColSet> pmcPayCommonBankColSets = pmcPayCommonBankColSetMapper.selectByExample(example);\n            if (CollectionUtils.isNotEmpty(pmcPayCommonBankColSets)) {\n                PmcPayCommonBankColSet pmcPayCommonBankColSet = pmcPayCommonBankColSets.get(0);\n                String[] split = pmcPayCommonBankColSet.getMappingBankCol().split(\"\\\\.\");\n                Element balanceElement = root;\n                for (String s : split) {\n                    balanceElement = balanceElement.getChildren(s).get(0);\n                }\n                BalanceInfo balanceInfo = new BalanceInfo();\n                balanceInfo.setCurrentDate(new Date());\n                balanceInfo.setBank(StringUtils.toString(dto.get(\"bankCode\")));\n                // 解析实时余额信息字段\n                parseBodyCoomon(balanceInfo, balanceElement, dto);\n                body.setBalanceInfo(balanceInfo);\n            }\n        } catch (Exception e) {\n            log.error(\"parseBalanceNow 重新组装支付状态查询响应报文体异常\", e);\n        }\n        return body;\n    }\n\n    /**\n     * 历史余额查询响应报文体\n     */\n    private ResponseBodyDTO parseBalanceOld(Element root, Map<String, Object> dto) {\n        dto.put(\"interfaceType\", Constants.BankcommonTranscodeEnum.BALANCE_OLD);\n        ResponseBodyDTO body = new ResponseBodyDTO();\n        try {\n            log.info(\"parseBalanceOld start ...\");\n            parseBodyCoomon(body, root, dto);\n        } catch (Exception e) {\n            log.error(\"parseBalanceOld 重新组装支付状态查询响应报文体异常\", e);\n        }\n        return body;\n    }\n\n    /**\n     * 银企支付响应报文体\n     */\n    private ResponseBodyDTO parseBankPay(Element root, Map<String, Object> dto) {\n        dto.put(\"interfaceType\", Constants.BankcommonTranscodeEnum.BANK_PAY);\n        ResponseBodyDTO body = new ResponseBodyDTO();\n        try {\n            log.info(\"parseBankPay start ...\");\n            parseBodyCoomon(body, root, dto);\n        } catch (Exception e) {\n            log.error(\"parseBankPay 重新组装支付状态查询响应报文体异常\", e);\n        }\n        return body;\n    }\n\n    /**\n     * 支付状态查询响应报文体\n     */\n    private ResponseBodyDTO parsePayStatus(Element root, Map<String, Object> dto) {\n        dto.put(\"interfaceType\", Constants.BankcommonTranscodeEnum.PAY_STATUS);\n        ResponseBodyDTO body = new ResponseBodyDTO();\n        try {\n            log.info(\"parsePayStatus start ...\");\n            parseBodyCoomon(body, root, dto);\n        } catch (Exception e) {\n            log.error(\"parsePayStatus 重新组装支付状态查询响应报文体异常\", e);\n        }\n        return body;\n    }\n\n    /**\n     * 交易明细查询响应报文体\n     */\n    private ResponseBodyDTO parseTransactions(Element root, Map<String, Object> dto) {\n        dto.put(\"interfaceType\", Constants.BankcommonTranscodeEnum.TRANSACTIONS);\n        ResponseBodyDTO body = new ResponseBodyDTO();\n        try {\n            log.info(\"parseTransactions start ...\");\n            // 先动态映射流水其他字段\n            parseBodyCoomon(body, root, dto);\n            // 定位到流水的节点\n            Example example = new Example(PmcPayCommonBankColSet.class);\n            example.createCriteria().\n                    andEqualTo(\"bankCode\", dto.get(\"bankCode\"))\n                    .andEqualTo(\"interfaceType\", dto.get(\"interfaceType\"))\n                    .andEqualTo(\"interfaceDirection\", Constants.BankcommonInterfaceDirectionEnum.RESPONSE)\n                    .andEqualTo(\"columnCode\", Constants.BankcommonColumnCodeEnum.TRANSACTIONS)\n                    .andEqualTo(\"enableFlag\", Constants.ENABLED_Y);\n            List<PmcPayCommonBankColSet> pmcPayCommonBankColSets = pmcPayCommonBankColSetMapper.selectByExample(example);\n            if (CollectionUtils.isNotEmpty(pmcPayCommonBankColSets)) {\n                PmcPayCommonBankColSet pmcPayCommonBankColSet = pmcPayCommonBankColSets.get(0);\n                String[] split = pmcPayCommonBankColSet.getMappingBankCol().split(\"\\\\.\");\n                int length = split.length;\n                Element element = root;\n                List<Element> transInfoElements = new ArrayList<>();\n                List<TransInfo> transInfos = new ArrayList<>();\n                for (int i = 0; i < length; i++) {\n                    String s = split[i];\n                    if (i == length - 1) {\n                        transInfoElements = element.getChildren(s);\n                    } else {\n                        element = element.getChildren(s).get(0);\n                    }\n                }\n                // 动态映射流水字段\n                for (Element transInfoElement : transInfoElements) {\n                    TransInfo transInfo = new TransInfo();\n                    parseBodyCoomon(transInfo, transInfoElement, dto);\n                    String direction = transInfo.getDirection();\n                    String amtStr = transInfo.getTransAmount();\n                    if (StringUtils.isNotBlank(direction) && StringUtils.isNotBlank(amtStr)) {\n                        BigDecimal amt = new BigDecimal(amtStr);\n                        // 借贷\n                        if (StringUtils.equals(direction, Constants.DIRECTION_C)) {\n                            transInfo.setLoanMark(Constants.DIRECTION_C);\n                            transInfo.setLoanMarkName(Constants.DIRECTION_C_NAME);\n                            transInfo.setCreditAmount(String.valueOf(amt.abs()));\n                        } else if (StringUtils.equals(direction, Constants.DIRECTION_D)) {\n                            transInfo.setLoanMark(Constants.DIRECTION_D);\n                            transInfo.setLoanMarkName(Constants.DIRECTION_D_NAME);\n                            transInfo.setDebitAmount(String.valueOf(amt.abs()));\n                        }\n                    }\n\n                    // 交易日\n                    StringBuilder day = null;\n                    if (StringUtils.isNotBlank(transInfo.getDealDay())) {\n                        day = new StringBuilder(transInfo.getDealDay());\n                        if (day.length() == 8) {\n                            day.insert(4, \"-\");\n                            day.insert(7, \"-\");\n                        }\n                    }\n                    StringBuilder time = null;\n                    if (StringUtils.isNotBlank(transInfo.getDealTime())) {\n                        time = new StringBuilder(transInfo.getDealTime());\n                        if (time.length() == 6) {\n                            time.insert(2, \":\");\n                            time.insert(5, \":\");\n                        }\n                    }\n                    if (StringUtils.isBlank(transInfo.getDealDate())) {\n                        transInfo.setDealDate(day + \" \" + time);\n                    }\n                    transInfos.add(transInfo);\n                }\n                body.setTransInfoList(transInfos);\n            }\n        } catch (Exception e) {\n            log.error(\"parseTransactions 重新组装支付状态查询响应报文体异常\", e);\n        }\n        return body;\n    }\n\n    /**\n     * 回单查询响应报文体\n     */\n    private ResponseBodyDTO parseElectReceiptQuery(Element root, Map<String, Object> dto) {\n        dto.put(\"interfaceType\", Constants.BankcommonTranscodeEnum.ELECT_RECEIPT_QEURY);\n        ResponseBodyDTO body = new ResponseBodyDTO();\n        try {\n            BankcommonReceiptDTO bankcommonReceiptDTO = new BankcommonReceiptDTO();\n            log.info(\"parseElectReceiptQuery start ...\");\n            parseBodyCoomon(body, root, dto);\n            parseBodyCoomon(bankcommonReceiptDTO, root, dto);\n            body.setReceipt(bankcommonReceiptDTO);\n        } catch (Exception e) {\n            log.error(\"parseElectReceiptQuery 重新组装支付状态查询响应报文体异常\", e);\n        }\n        return body;\n    }\n\n    /**\n     * 回单查询响应报文体\n     */\n    private ResponseBodyDTO parseElectReceiptDownload(Element root, Map<String, Object> dto) {\n        dto.put(\"interfaceType\", Constants.BankcommonTranscodeEnum.ELECT_RECEIPT_DOWNLOAD);\n        ResponseBodyDTO body = new ResponseBodyDTO();\n        try {\n            BankcommonReceiptDTO bankcommonReceiptDTO = new BankcommonReceiptDTO();\n            log.info(\"parseElectReceiptQuery start ...\");\n            parseBodyCoomon(body, root, dto);\n            parseBodyCoomon(bankcommonReceiptDTO, root, dto);\n            body.setReceipt(bankcommonReceiptDTO);\n        } catch (Exception e) {\n            log.error(\"parseElectReceiptQuery 重新组装支付状态查询响应报文体异常\", e);\n        }\n        return body;\n    }\n\n    /**\n     * 退票查询响应报文体\n     */\n    private ResponseBodyDTO parseRefund(Element root, Map<String, Object> dto) {\n        dto.put(\"interfaceType\", Constants.BankcommonTranscodeEnum.REFUND);\n        ResponseBodyDTO body = new ResponseBodyDTO();\n        try {\n            log.info(\"parseRefund start ...\");\n            // 先动态映射退票其他字段\n            parseBodyCoomon(body, root, dto);\n            // 定位到退票数据的节点\n            Example example = new Example(PmcPayCommonBankColSet.class);\n            example.createCriteria().\n                    andEqualTo(\"bankCode\", dto.get(\"bankCode\"))\n                    .andEqualTo(\"interfaceType\", dto.get(\"interfaceType\"))\n                    .andEqualTo(\"interfaceDirection\", Constants.BankcommonInterfaceDirectionEnum.RESPONSE)\n                    .andEqualTo(\"columnCode\", Constants.BankcommonColumnCodeEnum.REFUND)\n                    .andEqualTo(\"enableFlag\", Constants.ENABLED_Y);\n            List<PmcPayCommonBankColSet> pmcPayCommonBankColSets = pmcPayCommonBankColSetMapper.selectByExample(example);\n            if (CollectionUtils.isNotEmpty(pmcPayCommonBankColSets)) {\n                PmcPayCommonBankColSet pmcPayCommonBankColSet = pmcPayCommonBankColSets.get(0);\n                String[] split = pmcPayCommonBankColSet.getMappingBankCol().split(\"\\\\.\");\n                int length = split.length;\n                Element element = root;\n                List<Element> refundInfoElements = new ArrayList<>();\n                List<RefundInfo> refundInfoList = new ArrayList<>();\n                for (int i = 0; i < length; i++) {\n                    String s = split[i];\n                    if (i == length - 1) {\n                        refundInfoElements = element.getChildren(s);\n                    } else {\n                        element = element.getChildren(s).get(0);\n                    }\n                }\n                // 动态映射退票字段\n                for (Element refundInfoElement : refundInfoElements) {\n                    RefundInfo refundInfo = new RefundInfo();\n                    parseBodyCoomon(refundInfo, refundInfoElement, dto);\n                    refundInfoList.add(refundInfo);\n                }\n                body.setRefundInfoList(refundInfoList);\n            }\n        } catch (Exception e) {\n            log.error(\"parseRefund 重新组装支付状态查询响应报文体异常\", e);\n        }\n        return body;\n    }\n\n    /**\n     * 根据银行配置生成响应报文，并转为XML格式\n     *\n     * @param response    响应报文\n     * @param instructDto 请求参数dto\n     * @return\n     */\n    private String generateResponse(String response, Map<String, Object> instructDto) {\n        String bankCode = StringUtils.toString(instructDto.get(\"bankCode\"));\n        if (StringUtils.isBlank(bankCode)) {\n            bankCode = StringUtils.toString(instructDto.get(\"bank_code\"));\n        }\n        Example example = new Example(PmcPayCommonBankSet.class);\n        example.createCriteria().\n                andEqualTo(\"bankCode\", bankCode)\n                .andEqualTo(\"transferFlag\", Constants.ENABLED_Y);\n        List<PmcPayCommonBankSet> pmcPayCommonBankSets = pmcPayCommonBankSetMapper.selectByExample(example);\n        String requestType = Constants.RequestTypeEnum.XML;\n        if (CollectionUtils.isNotEmpty(pmcPayCommonBankSets)) {\n            requestType = pmcPayCommonBankSets.get(0).getRequestType();\n        }\n        switch (requestType) {\n            case Constants.RequestTypeEnum.XML:\n                return response;\n            case Constants.RequestTypeEnum.JSON:\n                try {\n                    return XmlJsonUtil.jsonToXml(response, \"root\");\n                } catch (Exception e) {\n                    log.error(\"json转xml失败\", e);\n                    return \"\";\n                }\n            default:\n                return response;\n        }\n\n    }\n\n    /**\n     * 解析公共头部信息\n     *\n     * @param root\n     * @param dto\n     * @return\n     */\n    public ResponseHeaderDTO.SystemHeadBean parseHeadCoomon(Element root, Map<String, Object> dto) {\n        ResponseHeaderDTO.SystemHeadBean systemHeadBean = new ResponseHeaderDTO.SystemHeadBean();\n        Example example = new Example(PmcPayCommonBankColSet.class);\n        example.createCriteria().\n                andEqualTo(\"bankCode\", dto.get(\"bankCode\"))\n                .andEqualTo(\"interfaceType\", Constants.BankcommonTranscodeEnum.HEADER)\n                .andEqualTo(\"interfaceDirection\", Constants.BankcommonInterfaceDirectionEnum.RESPONSE)\n                .andEqualTo(\"enableFlag\", Constants.ENABLED_Y);\n        List<PmcPayCommonBankColSet> pmcPayCommonBankColSets = pmcPayCommonBankColSetMapper.selectByExample(example);\n        if (CollectionUtils.isNotEmpty(pmcPayCommonBankColSets)) {\n            for (PmcPayCommonBankColSet pmcPayCommonBankColSet : pmcPayCommonBankColSets) {\n                parseResponseCommon(systemHeadBean, pmcPayCommonBankColSet, root, dto);\n            }\n        }\n        return systemHeadBean;\n    }\n\n    /**\n     * 解析公共响应体信息\n     *\n     * @param root\n     * @param dto\n     * @return\n     */\n    public void parseBodyCoomon(Object obj, Element root, Map<String, Object> dto) {\n        Example example = new Example(PmcPayCommonBankColSet.class);\n        example.createCriteria().\n                andEqualTo(\"bankCode\", dto.get(\"bankCode\"))\n                .andEqualTo(\"interfaceType\", dto.get(\"interfaceType\"))\n                .andEqualTo(\"interfaceDirection\", Constants.BankcommonInterfaceDirectionEnum.RESPONSE)\n                .andIsNotNull(\"transType\")\n                .andEqualTo(\"enableFlag\", Constants.ENABLED_Y);\n        List<PmcPayCommonBankColSet> pmcPayCommonBankColSets = pmcPayCommonBankColSetMapper.selectByExample(example);\n        if (CollectionUtils.isNotEmpty(pmcPayCommonBankColSets)) {\n            for (PmcPayCommonBankColSet pmcPayCommonBankColSet : pmcPayCommonBankColSets) {\n                parseResponseCommon(obj, pmcPayCommonBankColSet, root, dto);\n            }\n        }\n    }\n\n    /**\n     * 解析公共字段\n     *\n     * @param obj\n     * @param pmcPayCommonBankColSet\n     * @param element\n     */\n    void parseResponseCommon(Object obj, PmcPayCommonBankColSet pmcPayCommonBankColSet, Element element, Map<String, Object> dto) {\n        String columnCode = pmcPayCommonBankColSet.getColumnCode();\n        String[] split = pmcPayCommonBankColSet.getMappingBankCol().split(\"\\\\.\");\n        int length = split.length;\n        try {\n            for (int i = 0; i < length; i++) {\n                String bankCol = split[i];\n                if (i != length - 1) {\n                    List<Element> children = element.getChildren(bankCol);\n                    if (CollectionUtils.isNotEmpty(children)) {\n                        element = children.get(0);\n                    } else {\n                        break;\n                    }\n                } else {\n                    String mappingBankValue = getMappingBankValue(pmcPayCommonBankColSet, element, bankCol, dto);\n                    if (Constants.TransType.BANK_DTO.equals(pmcPayCommonBankColSet.getTransType())) {\n                        dto.put(columnCode, mappingBankValue);\n                        continue;\n                    }\n                    invokeFieldSet(obj, columnCode, mappingBankValue);\n                }\n            }\n        } catch (Exception e) {\n            log.error(\"parseResponseCommon 异常\");\n        }\n\n    }\n\n    /**\n     * 动态映射\n     *\n     * @param pmcPayCommonBankColSet\n     * @param element\n     * @return\n     */\n    private String getMappingBankValue(PmcPayCommonBankColSet pmcPayCommonBankColSet, Element element, String bankCol, Map<String, Object> dto) {\n        String transType = pmcPayCommonBankColSet.getTransType();\n        String transDetail = pmcPayCommonBankColSet.getTransDetail();\n        try {\n            switch (transType) {\n                case Constants.TransType.VALUE:\n                    return transDetail;\n                case Constants.TransType.BANK:\n                    return StringUtils.toString(element.getChildTextTrim(transDetail));\n                case Constants.TransType.PAY:\n                    return StringUtils.toString(dto.get(transDetail));\n                case Constants.TransType.BANK_DTO:\n                    return StringUtils.toString(element.getChildTextTrim(transDetail));\n                case Constants.TransType.DATE:\n                    return DateUtils.formatDate(new Date(), transDetail);\n                case Constants.TransType.FLEX:\n                    return getFlexMappingBankValue(pmcPayCommonBankColSet, element, bankCol);\n                default:\n                    return transDetail;\n            }\n        } catch (Exception e) {\n            log.error(\"getMappingBankValue error:\", e);\n        }\n        return \"\";\n    }\n\n    /**\n     * 映射类型为值集取数逻辑\n     *\n     * @param pmcPayCommonBankColSet\n     * @param element\n     * @return\n     */\n    private String getFlexMappingBankValue(PmcPayCommonBankColSet pmcPayCommonBankColSet, Element element, String bankCol) {\n        String transDetail = pmcPayCommonBankColSet.getTransDetail();\n        Example example = new Example(PmcPayCommonTransFlexSet.class);\n        example.createCriteria().andEqualTo(\"transCode\", transDetail);\n