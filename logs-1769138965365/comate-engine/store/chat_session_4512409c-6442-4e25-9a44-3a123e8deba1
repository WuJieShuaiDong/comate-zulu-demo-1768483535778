ng spdbSign(String request) {\n        log.info(\"spdbSign request before sign:\" + request);\n        try {\n            StringReader reader = new StringReader(request);\n            InputSource source = new InputSource(reader);\n            SafeXml safeXml = new SafeXml(SafeXml.Level.NONE);\n            SAXBuilder sax = safeXml.getSAXBuilder();\n            Document doc = sax.build(source);\n            Element rootElement = doc.getRootElement();\n            Element body = rootElement.getChild(\"body\");\n            Format format = Format.getPrettyFormat();\n            format.setExpandEmptyElements(true);\n            XMLOutputter outputter = new XMLOutputter(format);\n\n            String bodyString = outputter.outputString(body);\n            log.info(\"bodyString: \" + bodyString);\n            String signResult = OkHttpUtils.sendHttpRequestContentType(signUrl, bodyString, SpdbConstants.ContentType.SIGN);\n\n            Element signElement = parseRequestSign(signResult);\n            // 替换body元素\n            int index = rootElement.indexOf(body);\n            rootElement.removeContent(body);\n            rootElement.addContent(index, signElement.clone());\n            String signRequest = generateXML(doc);\n            log.info(\"spdbSign request after sign:\" + signRequest);\n            return signRequest;\n        }catch (Exception e) {\n            log.error(\"spdbSign request error\", e);\n            return \"\";\n        }\n    }\n\n    /**\n     * 拼装签名结果\n     * @param signResult\n     * @return\n     */\n    private Element parseRequestSign(String signResult) {\n        log.info(\"解析浦发请求签名开始: {}\", signResult);\n        try {\n            StringReader reader = new StringReader(signResult);\n            InputSource source = new InputSource(reader);\n            SafeXml safeXml = new SafeXml(SafeXml.Level.NONE);\n            SAXBuilder sax = safeXml.getSAXBuilder();\n            Document doc = sax.build(source);\n            Element rootElement = doc.