nsactionTypeService;\n\n    @Autowired\n    private FndFlexValueDAO fndFlexValueDAO;\n\n    @Autowired\n    private LoanCompanyRuleService loanCompanyRuleService;\n\n    @Autowired\n    private TmsLoanInterestAccrualDAO loanInterestAccrualDAO;\n\n    @Autowired\n    private LoanInterestAccrualService loanInterestAccrualService;\n\n    @Autowired\n    private TmsLoanTrxEventDAO trxEventDAO;\n\n    @Autowired\n    private TmsDealIfrsFairvalueDAO fairvalueDAO;\n\n    @Autowired\n    private IfrsFairvalueChangeService changeService;\n\n    @Autowired\n    private TmsProductNetValueDAO valueDAO;\n\n    @Autowired\n    private DealProductNetvalueService productNetvalueService;\n\n    @Autowired\n    private TmsAccountBalanceQianbaoDAO balanceQianbaoDAO;\n\n    @Autowired\n    private ThirdAccountEndBalanceService balanceService;\n\n    @Autowired\n    private ThirdTransactionsService transactionsService;\n\n    @Autowired\n    private TmsThirdAccountDAO thirdAccountDAO;\n\n    @Autowired\n    private TmsThirdTransactionsDao thirdTransactionsDao;\n\n    @Autowired\n    private TmsThirdAccountRuleDao accountRuleDao;\n\n    @Autowired\n    private ThirdTransAccountingService thirdTransAccountingService;\n\n    @Autowired\n    private TmsLoanAccountHeaderDAO tmsLoanAccountHeaderDAO;\n\n    @Autowired\n    private CommonAttachmentDAO attachmentDAO;\n\n    @Autowired\n    private TmsThirdTransactionsSummaryDao thirdTransactionsSummaryDao;\n\n    @Autowired\n    private ThirdTansSummaryCommonService summaryCommonService;\n\n    @Autowired\n    private TmsBillTrxEventDAO billTrxEventDAO;\n\n    @Autowired\n    private BillEventService billEventService;\n\n    @Autowired\n    private ForeignExchangeService foreignExchangeService;\n\n    @Autowired\n    private TmsBillManagementDAO tmsBillManagementDAO;\n\n    @Autowired\n    private TmsForeignExchangeManageDAO tmsForeignExchangeManageDAO;\n\n    @Autowired\n    private TmsLoanAccountRuleDAO tmsLoanAccountRuleDAO;\n\n    @Value(\"${third.account.package.id}\")\n    private String thirdPackageId;\n\n    @Value(\"${third.account.process.define.id}\")\n    private String thirdProcessDefineId;\n\n    private static final String SYSTEM_ADMIN = \"system_admin\";\n    private static final String Y = \"Y\";\n    private static final String N = \"N\";\n    private static final String PAY = \"PAY\";\n    private static final String RECEIVE = \"RECEIVE\";\n    private static final String SYMBOL = \"-\";\n    private static final String HAS_UPLOADED = \"HAS_UPLOADED\";\n    private static final String SHORT_TERM = \"SHORT_TERM\";\n    private static final String LONG_TERM = \"LONG_TERM\";\n    private static final String NONE = \"None\";\n    private static final String CORP = \"CORP\";\n    private static final String BD_PERIOD_END = \"BD Period End\";\n    /**\n     * 代表红冲分录标识，该分录在编辑页面不允许修改\n     */\n    private static final String IFRS = \"IFRS\";\n    /**\n     * 每批次数量\n     */\n    private static final int UID_BATCH_NUM = 10000;\n\n    /**\n     * 日元\n     */\n    private static final String JPY = \"JPY\";\n\n    private static final String SERVICE_CHARGE = \"SERVICE_CHARGE\";\n    /**\n     * 汇兑损益\n     */\n    private static final String REMITTANCE = \"REMITTANCE\";\n\n    /**\n     * 投资损益\n     */\n    private static final String INVESTMENT = \"INVESTMENT\";\n\n    /**\n     * 借贷\n     */\n    private static final String BL = \"BL\";\n\n    private static final String FOREIGN_CATEGORY = \"FX\";\n\n    private static final String FOREIGN_EVENT_TYPE = \"FX01\";\n\n    /**\n     * 获取用于记账的交易事件\n     *\n     * @param event LoanAccountEvent\n     * @return 用于记账的交易事件列表\n     */\n    @Override\n    public Page<LoanAccountEvent> getEvents(LoanAccountEvent event) {\n\n        PageHelper.startPage(event.getPage(), event.getPageSize());\n        Page<LoanAccountEvent> page =\n                (Page<LoanAccountEvent>) loanAccountDao.getEvents(event);\n        return page;\n\n    }\n\n    /**\n     * 获取净值理财交易记账信息\n     *\n     * @param account eventIdList\n     * @return 记账信息\n     */\n    @Override\n    public List<LoanAccount> getNetValueAccounts(LoanAccount account) {\n        List<LoanAccount> accounts = new ArrayList<>();\n        account.getEventIds().forEach(accrualId -> {\n            List<LoanAccount> accountAssembleds = assembleNetValueAccount(accrualId);\n            sortAccouts(accountAssembleds);\n            accounts.addAll(accountAssembleds);\n        });\n        return accounts;\n    }\n\n    /**\n     * 获取新交易事件记账信息\n     *\n     * @param account eventIdList\n     * @return 记账信息\n     */\n    @Override\n    public List<LoanAccount> getCompanyAccounts(LoanAccount account) {\n        List<LoanAccount> accounts = new ArrayList<>();\n        account.getEventIds().forEach(eventId -> {\n            List<LoanAccount> accountAssembleds = assembleNewAccount(eventId);\n            sortAccouts(accountAssembleds);\n            accounts.addAll(accountAssembleds);\n        });\n        return accounts;\n    }\n\n    /**\n     * 获取交易事件记账信息\n     *\n     * @param account eventIdList\n     * @return 记账信息\n     */\n    @Override\n    public List<LoanAccount> getAccounts(LoanAccount account) {\n        List<LoanAccount> accounts = new ArrayList<>();\n        account.getEventIds().forEach(eventId -> {\n            List<LoanAccount> accountAssembleds = assembleAccount(eventId);\n            sortAccouts(accountAssembleds);\n            accounts.addAll(accountAssembleds);\n        });\n        return accounts;\n    }\n\n    /**\n     * 获取第三方余额结转记账信息\n     *\n     * @param account eventIdList\n     * @return 记账信息\n     */\n    @Override\n    public List<LoanAccount> getThirdBalanceAccounts(LoanAccount account) {\n        List<LoanAccount> accounts = new ArrayList<>();\n        account.getEventIds().forEach(eventId -> {\n            List<LoanAccount> accountAssembleds = assembleThirdBalanceAccount(eventId);\n            sortAccouts(accountAssembleds);\n            accounts.addAll(accountAssembleds);\n        });\n        return accounts;\n    }\n\n    @Transactional(rollbackFor = Exception.class)\n    @Override\n    public List<String> getBatchThirdBalanceAccounts(LoanAccount account, Boolean flag) {\n        List<String> errorMsg = new ArrayList<>();\n        account.getEventIds().forEach(eventId -> {\n            List<LoanAccount> accountAssembleds = new ArrayList<>();\n            try {\n                accountAssembleds = assembleThirdBalanceAccount(eventId);\n            } catch (Exception e) {\n                String message = e.getMessage();\n                String accountNo = this.loanAccountDao.selectByEventIdAsAccount(eventId);\n                errorMsg.add(accountNo + \"账号:\" + message);\n            }\n            if (CollectionUtils.isNotEmpty(accountAssembleds)) {\n                sortAccouts(accountAssembleds);\n                List<String> attrs = new ArrayList<>();\n                if (CollectionUtils.isNotEmpty(account.getAttachIds())) {\n                    account.getAttachIds().forEach(attachId -> {\n                        PpsCommAttachment ppsCommAttachment = uploadAttachService.getAttachPath(attachId);\n                        PpsCommAttachment newPpsCommAttachment = new PpsCommAttachment();\n                        BeanUtils.copyProperties(ppsCommAttachment, newPpsCommAttachment, \"attachId\");\n                        newPpsCommAttachment.setBizPk(String.valueOf(eventId));\n                        uploadAttachService.saveAttach(newPpsCommAttachment);\n                        attrs.add(newPpsCommAttachment.getAttachId());\n                    });\n                }\n                LoanAccountDTO dto = new LoanAccountDTO();\n                dto.setAttachIds(attrs);\n                dto.setLoanAccounts(accountAssembleds);\n                TmsLoanAccountHeader tmsLoanAccountHeader = null;\n                try {\n                    tmsLoanAccountHeader = saveThirdBalanceAccounts(dto);\n                } catch (Exception e) {\n                    String message = e.getMessage();\n                    String accountNo = this.loanAccountDao.selectByEventIdAsAccount(eventId);\n                    errorMsg.add(accountNo + \"账号:\" + message);\n                }\n                if (Objects.nonNull(tmsLoanAccountHeader) && flag) {\n                    try {\n                        saveAndStartProcess(dto, tmsLoanAccountHeader);\n                    } catch (Exception e) {\n                        String message = e.getMessage();\n                        String accountNo = this.loanAccountDao.selectByEventIdAsAccount(eventId);\n                        errorMsg.add(accountNo + \"账号:\" + message);\n                    }\n                }\n            }\n        });\n        return errorMsg;\n    }\n\n\n    /**\n     * 获取资金划拨记账信息\n     *\n     * @param account eventIdList\n     * @return 记账信息\n     */\n    @Override\n    public List<LoanAccount> getTransferAccounts(LoanAccount account) {\n        List<LoanAccount> accounts = new ArrayList<>();\n        account.getEventIds().forEach(eventId -> {\n            List<LoanAccount> accountAssembleds = assembleTransferAccount(eventId);\n            sortAccouts(accountAssembleds);\n            accounts.addAll(accountAssembleds);\n        });\n        return accounts;\n    }\n\n    /**\n     * 获取理财交易事件记账信息\n     *\n     * @param account eventIdList\n     * @return 理财交易事件记账信息\n     */\n    @Override\n    public List<LoanAccount> getFinancialAccounts(LoanAccount account) {\n        List<LoanAccount> accounts = new ArrayList<>();\n        account.getEventIds().forEach(eventId -> {\n            List<LoanAccount> accountAssembleds = assembleFinancialAccount(eventId);\n            sortAccouts(accountAssembleds);\n            accounts.addAll(accountAssembleds);\n        });\n        this.findOtherAccounts(accounts, account);\n        return accounts;\n    }\n\n    /**\n     * 获取应收票据交易事件记账信息\n     *\n     * @param account eventIdList\n     * @return 理财交易事件记账信息\n     */\n    @Override\n    public List<LoanAccount> getBillReceivableAccounts(LoanAccount account) {\n        List<LoanAccount> accounts = new ArrayList<>();\n        account.getEventIds().forEach(eventId -> {\n            List<LoanAccount> accountAssembleds = assembleBillReceivableAccount(eventId);\n            sortAccouts(accountAssembleds);\n            accounts.addAll(accountAssembleds);\n        });\n        return accounts;\n    }\n\n    /**\n     * 获取分录信息\n     * <p>\n     * 会计处理--外汇交易记账\n     *\n     * @param account\n     * @return 用于外汇交易记账的交易事件列表\n     */\n    @Override\n    public List<LoanAccount> getForeignExchangeAccounts(LoanAccount account) {\n        List<LoanAccount> accounts = new ArrayList<>();\n        account.getEventIds().forEach(eventId -> {\n            List<LoanAccount> accountAssembleds = assembleForeignExchangeAccount(eventId);\n            sortAccouts(accountAssembleds);\n            accounts.addAll(accountAssembleds);\n        });\n        logger.info(\"getForeignExchangeAccounts size: {}\", accounts.size());\n        return accounts;\n    }\n\n    /**\n     * 获取分录信息\n     * <p>\n     * 会计处理--外汇交易记账\n     *\n     * @param loanAccountList\n     * @return 用于外汇交易记账的交易事件列表\n     */\n    @Override\n    public List<LoanAccount> reGetForeignExchangeAccounts(List<LoanAccount> loanAccountList) {\n        logger.info(\"reGetForeignExchangeAccounts 开始 request: {}\", JSON.toJSONString(loanAccountList));\n        if (CollectionUtils.isEmpty(loanAccountList) || loanAccountList.size() < 3) {\n            return loanAccountList;\n        }\n        Map<Long, List<LoanAccount>> listMap = loanAccountList.stream().collect(Collectors\n                .groupingBy(LoanAccount::getEventId));\n        listMap.forEach((eventId, loanAccounts) -> {\n            List<LoanAccount> drList = loanAccounts.stream().filter(o ->\n                    LoanConstants.LOAN_GL_DIRECTION_DR.equals(o.getDirection())).collect(Collectors.toList());\n            List<LoanAccount> crList = loanAccounts.stream().filter(o ->\n                    LoanConstants.LOAN_GL_DIRECTION_CR.equals(o.getDirection())).collect(Collectors.toList());\n            if (CollectionUtils.isEmpty(drList) || CollectionUtils.isEmpty(crList)) {\n                throw new ServiceException(\"会计分录数据不完整\");\n            }\n            if (crList.size() == 1) {\n                List<LoanAccount> drTemp = drList.stream().filter(o -> !\"Y\".equals(o.getPlFlag()))\n                        .collect(Collectors.toList());\n                List<LoanAccount> temp = drList.stream().filter(o -> \"Y\".equals(o.getPlFlag()))\n                        .collect(Collectors.toList());\n                List<LoanAccount> crTemp = crList;\n                BigDecimal dr = drTemp.stream().map(LoanAccount::getAccounted).reduce(BigDecimal::add)\n                        .orElse(BigDecimal.ZERO);\n                BigDecimal cr = crTemp.stream().map(LoanAccount::getAccounted).reduce(BigDecimal::add)\n                        .orElse(BigDecimal.ZERO);\n                if (dr.compareTo(cr) < 0) {\n                    temp.get(0).setAccounted(cr.subtract(dr));\n                    temp.get(0).setAccountedDr(cr.subtract(dr));\n                    temp.get(0).setEntered(cr.subtract(dr));\n                } else if (dr.compareTo(cr) > 0) {\n                    temp.get(0).setDirection(LoanConstants.LOAN_GL_DIRECTION_CR);\n                    temp.get(0).setAccounted(dr.subtract(cr));\n                    temp.get(0).setAccountedDr(null);\n                    temp.get(0).setAccountedCr(dr.subtract(cr));\n                    temp.get(0).setEntered(dr.subtract(cr));\n                }\n\n            } else if (crList.size() == 2) {\n                List<LoanAccount> drTemp = drList;\n                List<LoanAccount> temp = crList.stream().filter(o -> \"Y\".equals(o.getPlFlag()))\n                        .collect(Collectors.toList());\n                List<LoanAccount> crTemp = crList.stream().filter(o -> !\"Y\".equals(o.getPlFlag()))\n                        .collect(Collectors.toList());\n                BigDecimal dr = drTemp.stream().map(LoanAccount::getAccounted).reduce(BigDecimal::add)\n                        .orElse(BigDecimal.ZERO);\n                BigDecimal cr = crTemp.stream().map(LoanAccount::getAccounted).reduce(BigDecimal::add)\n                        .orElse(BigDecimal.ZERO);\n                if (dr.compareTo(cr) < 0) {\n                    temp.get(0).setDirection(LoanConstants.LOAN_GL_DIRECTION_DR);\n                    temp.get(0).setAccounted(cr.subtract(dr));\n                    temp.get(0).setAccountedDr(cr.subtract(dr));\n                    temp.get(0).setAccountedCr(null);\n                    temp.get(0).setEntered(cr.subtract(dr));\n                } else if (dr.compareTo(cr) > 0) {\n                    temp.get(0).setAccounted(dr.subtract(cr));\n                    temp.get(0).setAccountedCr(dr.subtract(cr));\n                    temp.get(0).setEntered(dr.subtract(cr));\n                }\n            } else {\n                throw new ServiceException(\"会计分录贷方数据不完整\");\n            }\n\n        });\n        return loanAccountList;\n    }\n\n\n    /**\n     * 获取交易计提利息记账信息 用于创建理财记账\n     *\n     * @param account eventIdList\n     * @return 理财计提利息记账信息\n     */\n    @Override\n    public List<LoanAccount> getDealAccrualAccounts(LoanAccount account) {\n        List<LoanAccount> accounts = new ArrayList<>();\n        List<Long> eventIds = account.getEventIds().stream().distinct().collect(Collectors.toList());\n        eventIds.forEach(accrualId -> {\n            List<LoanAccount> accountAssembleds = assembleDealAccrualAccount(accrualId);\n            sortAccouts(accountAssembleds);\n            accounts.addAll(accountAssembleds);\n        });\n        logger.info(\"获取计提分录数据,入参:\" + StringUtils.join(eventIds.toArray(), \",\") + \";返回数量:\" + accounts.size());\n        return accounts;\n    }\n\n    /**\n     * 公司间借款--计提利息--获取分录明细数据：0\n     *\n     * @param account eventIdList\n     * @return\n     */\n    @Override\n    public List<LoanAccount> getLoanAccrualAccounts(LoanAccount account) {\n        List<LoanAccount> loanAccountList = Lists.newArrayList();\n        if (CollectionUtils.isEmpty(account.getEventIds())) {\n            return loanAccountList;\n        }\n\n        List<Long> eventIds = account.getEventIds().stream().distinct().collect(Collectors.toList());\n        eventIds.forEach(accrualId -> {\n            List<LoanAccount> accountList = assembleCompanyAccrualAccount(accrualId);\n            accountList = accountList.stream().sorted(Comparator.comparing(LoanAccount::getDirection)\n                    .reversed()).collect(Collectors.toList());\n            loanAccountList.addAll(accountList);\n        });\n        logger.info(\"获取公司间借款计提分录数据,入参:{};返回数量:{}\", StringUtils.join(eventIds.toArray(), \",\"), loanAccountList.size());\n\n        fndFlexValueApi.translate(loanAccountList,\n                \"segment1\", BizConstants.FndFlexSet.BD_COMPANY,\n                \"segment2\", BizConstants.FndFlexSet.BD_DEPARTMENT,\n                \"segment3\", BizConstants.FndFlexSet.BD_ACCOUNT,\n                \"segment4\", BizConstants.FndFlexSet.BD_PRODUCT,\n                \"segment5\", BizConstants.FndFlexSet.BD_INTERCOMPANY,\n                \"segment6\", BizConstants.FndFlexSet.BD_PROJECT,\n                \"segment7\", BizConstants.FndFlexSet.BD_SPARE1,\n                \"segment8\", BizConstants.FndFlexSet.BD_SPARE2,\n                \"eventType\", BizConstants.FndFlexSet.TMS_DEAL_ACCEVENTTYPE);\n        Map<String, String> trxTypeCodeAndNamePairs = transactionTypeService.getCodeAndNamePairs();\n        FndFlexValue fndFlexValue = new FndFlexValue();\n        fndFlexValue.setFlexValueSetName(BizConstants.FndFlexSet.TMS_CURRENCY);\n        List<FndFlexValue> flexValueList = fndFlexValueDAO.selectByConditionSetVague(fndFlexValue);\n        // 翻译交易类型&设置币种精度\n        loanAccountList.forEach(la -> {\n            la.setTrxTypeName(trxTypeCodeAndNamePairs.get(la.getTrxType()));\n            flexValueList.forEach(record -> {\n                if (record.getFlexValue().equals(la.getLedgerCurrencyCode())) {\n                    la.setCurrencyPrecision(record.getExtAttribute1());\n                }\n            });\n            la.setNaryur(la.getTrxTypeName() + SYMBOL + la.getEventTypeName() + SYMBOL + la.getRequestNumber());\n            if (INTERCOMPANY_INTEREST_ACCRUAL.equals(la.getTrxCategory())\n                    && JPY.equals(la.getLedgerCurrencyCode())) {\n                if (la.getAccountedCr() != null) {\n                    la.setAccountedCr(la.getAccountedCr().setScale(0, RoundingMode.HALF_UP));\n                }\n                if (la.getAccountedDr() != null) {\n                    la.setAccountedDr(la.getAccountedDr().setScale(0, RoundingMode.HALF_UP));\n                }\n                if (la.getAccounted() != null) {\n                    la.setAccounted(la.getAccounted().setScale(0, RoundingMode.HALF_UP));\n                }\n            }\n        });\n        return loanAccountList;\n    }\n\n    /**\n     * 公允价值重估入账获取会计分录\n     *\n     * @param account eventIdList\n     * @return\n     */\n    @Override\n    public List<LoanAccount> getFairvalueAccounts(LoanAccount account) {\n        List<LoanAccount> loanAccountList = Lists.newArrayList();\n        if (CollectionUtils.isEmpty(account.getEventIds())) {\n            return loanAccountList;\n        }\n\n        List<Long> eventIds = account.getEventIds().stream().distinct().collect(Collectors.toList());\n        eventIds.forEach(accrualId -> {\n            List<LoanAccount> accountList = assembleFairvalueAccount(accrualId);\n            accountList = accountList.stream().sorted(Comparator.comparing(LoanAccount::getDirection)\n                    .reversed()).collect(Collectors.toList());\n            loanAccountList.addAll(accountList);\n        });\n        logger.info(\"获取公允价值重估计算分录数据,入参:{