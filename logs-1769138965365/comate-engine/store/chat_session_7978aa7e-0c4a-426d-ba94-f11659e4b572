        <button onclick=\"performImageSearch('${fileName}')\" style=\"background: #3385ff; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer;\">\n                    搜索相似图片\n                </button>\n                <button onclick=\"this.closest('div').parentElement.remove()\" style=\"background: #666; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer;\">\n                    关闭\n                </button>\n            </div>\n        </div>\n    `;\n\n    document.body.appendChild(modal);\n}\n\n// 执行图片搜索\nfunction performImageSearch(fileName) {\n    const query = `与 \"${fileName}\" 相关的图片`;\n    document.getElementById('searchInput').value = query;\n    \n    // 关闭模态框\n    document.querySelector('div[style*=\"position: fixed\"]')?.remove();\n    \n    // 模拟图片搜索\n    showSearchingAnimation();\n    \n    setTimeout(() => {\n        alert(`正在进行图片搜索: ${query}\\n\\n这是一个模拟的图片搜索结果页面。在实际场景中，这里会显示相关的图片搜索结果。`);\n        hideSearchingAnimation();\n    }, 1500);\n}\n\n// 键盘快捷键支持\ndocument.addEventListener('keydown', function(e) {\n    const searchInput = document.getElementById('searchInput');\n    \n    // Ctrl+K 或 / 聚焦搜索框\n    if ((e.ctrlKey && e.key === 'k') || e.key === '/') {\n        e.preventDefault();\n        searchInput.focus();\n    }\n    \n    // ESC 清空搜索框\n    if (e.key === 'Escape') {\n        searchInput.value = '';\n        searchInput.blur();\n    }\n});\n\n// 搜索框自动完成建议（简化版）\ndocument.getElementById('searchInput').addEventListener('input', function(e) {\n    // 在实际项目中，这里会调用搜索建议API\n    // 这里简化为本地建议\n    const query = e.target.value.toLowerCase();\n    if (query.length > 2) {\n        // 可以在这里添加搜索建议逻辑\n    }\n});"
