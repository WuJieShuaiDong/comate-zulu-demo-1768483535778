                "content": "// 热搜数据\nconst hotSearchData = [\n    { rank: 1, text: \"OpenAI发布新款GPT模型\", hot: \"热\" },\n    { rank: 2, text: \"人工智能赋能千行百业\", hot: \"热\" },\n    { rank: 3, text: \"新能源汽车销量创新高\", hot: \"热\" },\n    { rank: 4, text: \"智慧城市建设加速推进\", hot: \"新\" },\n    { rank: 5, text: \"量子计算突破性进展\", hot: \"沸\" },\n    { rank: 6, text: \"元宇宙技术应用落地\", hot: \"新\" },\n    { rank: 7, text: \"数字经济发展迅速\", hot: \"热\" },\n    { rank: 8, text: \"区块链技术创新应用\", hot: \"新\" },\n    { rank: 9, text: \"云计算市场规模扩大\", hot: \"热\" },\n    { rank: 10, text: \"物联网设备快速增长\", hot: \"新\" }\n];\n\n// 页面加载完成后初始化\ndocument.addEventListener('DOMContentLoaded', function() {\n    initializeHotSearch();\n    initializeSearchFunctionality();\n    initializeImageSearch();\n});\n\n// 初始化热搜榜\nfunction initializeHotSearch() {\n    const hotSearchList = document.getElementById('hotSearchList');\n    \n    hotSearchData.forEach(item => {\n        const searchItem = document.createElement('a');\n        searchItem.className = 'hot-search-item';\n        searchItem.href = 'javascript:void(0)';\n        \n        searchItem.innerHTML = `\n            <span class=\"rank ${item.rank <= 3 ? 'top3' : ''}\">${item.rank}</span>\n            <span class=\"hot-search-text\">${item.text}</span>\n            <span class=\"hot-search-hot\">${item.hot}</span>\n        `;\n        \n        searchItem.addEventListener('click', function() {\n            performSearch(item.text);\n        });\n        \n        hotSearchList.appendChild(searchItem);\n    });\n}\n\n// 初始化搜索功能\nfunction initializeSearchFunctionality() {\n    const searchForm = document.getElementById('searchForm');\n    const searchInput = document.getElementById('searchInput');\n    const voiceSearchBtn = document.getElementById('voiceSearchBtn');\n\n    // 表单提交处理\n    searchForm.addEventListener('submit', function(e) {\n        e.preventDefault();\n        const query = searchInput.value.trim();\n        if (query) {\n            performSearch(quer