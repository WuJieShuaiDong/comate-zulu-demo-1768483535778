lCashFlow;\nimport com.baidu.tms.persistent.deal.domain.TmsDealCashFlowExample;\nimport com.baidu.tms.persistent.deal.domain.TmsDealEvent;\nimport com.baidu.tms.persistent.deal.domain.TmsDealEventExample;\nimport com.baidu.tms.persistent.deal.domain.TmsDealExample;\nimport com.baidu.tms.persistent.loan.dao.TmsFinancialProductDAO;\nimport com.baidu.tms.persistent.transaction.dao.TmsTransactionTypeDAO;\nimport com.baidu.tms.persistent.transaction.domain.TmsTransactionType;\nimport com.baidu.tms.persistent.transaction.domain.TmsTransactionTypeExample;\nimport com.github.pagehelper.PageInfo;\nimport lombok.extern.slf4j.Slf4j;\nimport org.springframework.beans.BeanUtils;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\nimport org.springframework.transaction.annotation.Transactional;\nimport org.springframework.util.CollectionUtils;\n\nimport java.math.BigDecimal;\nimport java.math.RoundingMode;\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.Comparator;\nimport java.util.Date;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Objects;\nimport java.util.stream.Collectors;\n\nimport static com.baidu.tms.deal.common.constants.DealTypeConstants.DEAL_APPLY_TYPE_PURCHASE1;\nimport static com.baidu.tms.deal.common.constants.DealTypeConstants.DEAL_APPLY_TYPE_PURCHASE2;\nimport static com.baidu.tms.deal.common.constants.DealTypeConstants.DEAL_APPLY_TYPE_PURCHASE4;\nimport static com.baidu.tms.deal.common.constants.DealTypeConstants.DEAL_APPLY_TYPE_REDEEM;\n\n/**\n * 活期理财--货币市场基金\n *\n * @author liuyanzhong\n * @date 2024/5/22\n */\n@Service\n@Slf4j\npublic class TmsMoneyMarketServiceImpl implements TmsMoneyMarketService {\n\n    @Autowired\n    private TmsDealDAO dealDAO;\n\n    @Autowired\n    private TmsDealEventDAO dealEventDAO;\n\n    @Autowired\n    private TmsDealCashFlowDAO cashFlowDAO;\n\n    @Autowired\n    private TmsFinancialProductDAO productDAO;\n\n    @Autowired\n    private FndFlexValueApi flexValueApi;\n\n    @Autowired\n    private InvestmentCommonService investmentCommonService;\n\n    @Autowired\n    private TmsDealApplyDAO tmsDealApplyDAO;\n\n    @Autowired\n    private TmsDealApplyHisDAO tmsDealApplyHisDAO;\n\n    @Autowired\n    private DealApplyDao dealApplyDao;\n\n    @Autowired\n    private DealEventCashUtil dealEventCashUtil;\n\n    @Autowired\n    private CommonAttachmentDAO attachmentDAO;\n\n    @Autowired\n    private TmsTransactionTypeDAO tmsTransactionTypeDAO;\n\n    /**\n     * 一年天数\n     */\n    public static final int DAYS_360 = 360;\n    public static final int DAYS_365 = 365;\n\n\n    @Override\n    public Map<String, Object> getSelectInit() {\n        Map<String, Object> dic = new HashMap<>();\n\n        // 理财产品\n        dic.put(\"productList\", investmentCommonService.getProductList(false,\n                DealCommonEnum.CURRENT_FINANCIAL_CATEGORY.getCode()));\n        // 所属银行\n        dic.put(\"bankList\", investmentCommonService.getBankList(new LoanCompanyRuleQuery()));\n        // 币种\n        dic.put(\"currencyList\",\n                investmentCommonService.getFndFlexSetSelectDTOs(BizConstants.FndFlexSet.TMS_CURRENCY, false));\n        // 状态\n        dic.put(\"statusList\",\n                investmentCommonService\n                        .getFndFlexSetSelectDTOs(BizConstants.FndFlexSet.TMS_DEAL_STATUS, false));\n        return dic;\n    }\n\n    @Override\n    public PageInfo<DealDto> selectMoneyMarketPage(DealQueryDto dealQueryDto) {\n        dealQueryDto.setDealCategory(DealTypeConstants.DEAL_TYPE_MONEYMARKET);\n        PageInfo<DealDto> dtoPageInfo = investmentCommonService.selectInvestment(dealQueryDto);\n        List<DealDto> dtoList = dtoPageInfo.getList();\n\n        // 当前余额\n        getCurrentPrincipal(dtoList);\n        // 操作栏可操作类型\n        this.addActionBar(dtoList);\n        return dtoPageInfo;\n    }\n\n    /**\n     * 余额取值优化\n     *\n     * @param dtoList\n     * @return\n     */\n    public void getCurrentPrincipal(List<DealDto> dtoList) {\n        if (CollectionUtils.isEmpty(dtoList)) {\n            return;\n        }\n        List<Long> dealIdList = dtoList.stream().map(DealDto::getDealId).collect(Collectors.toList());\n        Date date = new Date();\n        TmsDealEventExample eventExample = new TmsDealEventExample();\n        TmsDealEventExample.Criteria eventCriteria = eventExample.createCriteria();\n        eventCriteria.andDealIdIn(dealIdList);\n        eventCriteria.andEffectiveDateLessThanOrEqualTo(date);\n        eventExample.setOrderByClause(\"effective_date desc, event_order desc, event_id desc\");\n        List<TmsDealEvent> eventList = dealEventDAO.selectByExample(eventExample);\n        for (DealDto dto : dtoList) {\n            List<TmsDealEvent> temp = eventList.stream().filter(o -> Objects.equals(o.getDealId(), dto.getDealId()))\n                    .collect(Collectors.toList());\n            if (!CollectionUtils.isEmpty(temp)) {\n                dto.setCurrentBalance(temp.get(0).getPrincipalRemained());\n            }\n        }\n    }\n\n    /**\n     * 根据状态生成操作栏可操作类型\n     *\n     * @param dtoList\n     */\n    public void addActionBar(List<DealDto> dtoList) {\n        if (CollectionUtils.isEmpty(dtoList)) {\n            return;\n        }\n        dtoList.forEach(o -> {\n            List<String> actions = new ArrayList<>();\n            if (DealCommonEnum.STATUS_SAVED.getCode().equals(o.getDealStatus())) {\n                actions.add(TmsMoneyMarketActionBarEnum.EDIT.getCode());\n                actions.add(TmsMoneyMarketActionBarEnum.DELETE.getCode());\n            } else if (DealCommonEnum.STATUS_CONFIRM.getCode().equals(o.getDealStatus())) {\n                actions.add(TmsMoneyMarketActionBarEnum.WITHDRAW.getCode());\n            } else if (DealCommonEnum.STATUS_CONFIRMED.getCode().equals(o.getDealStatus())) {\n//                actions.add(TmsMoneyMarketActionBarEnum.ALTER.getCode());\n                actions.add(TmsMoneyMarketActionBarEnum.RENEW.getCode());\n                actions.add(TmsMoneyMarketActionBarEnum.REDEEM.getCode());\n                actions.add(TmsMoneyMarketActionBarEnum.REINVESTMENT.getCode());\n                actions.add(TmsMoneyMarketActionBarEnum.CASH.getCode());\n            }\n            o.setActionBarList(actions);\n        });\n    }\n\n    @Override\n    public Map<String, Object> getEditSelectInit() {\n        Map<String, Object> dic = new HashMap<>();\n        // 交易类型\n        dic.put(\"dealTypeList\",\n                investmentCommonService.getDealTypeList(DealTypeConstants.DEAL_TYPE_MONEYMARKET, true, true));\n        // 理财产品\n        dic.put(\"productList\", investmentCommonService.getProductList(true,\n                DealCommonEnum.CURRENT_FINANCIAL_CATEGORY.getCode()));\n        // 币种\n        dic.put(\"currencyList\",\n                investmentCommonService.getFndFlexSetSelectDTOs(BizConstants.FndFlexSet.TMS_CURRENCY, true));\n        // 利率类型\n        dic.put(\"rateTypeList\", this.getRateTypeList());\n        // 付息频率\n        dic.put(\"frequency\",\n                investmentCommonService.getFndFlexSetSelectDTOs(BizConstants.FndFlexSet.TMS_Deal_Frequency, true));\n        // 计息方式\n        dic.put(\"interestMethod\",\n                investmentCommonService.getFndLookupSelectDTOs(BizConstants.FndFlexSet.TMS_DEAL_IR_MODE, true));\n        // 假期日历\n        dic.put(\"holidayCode\",\n                investmentCommonService.getFndFlexSetSelectDTOs(BizConstants.FndFlexSet.TMS_Holiday_Code, true));\n        // 假期规则\n        dic.put(\"holidayRules\",\n                investmentCommonService.getFndFlexSetSelectDTOs(BizConstants.FndFlexSet.TMS_DEAL_HOLIDAY_RULE, true));\n        // 分红方式\n        dic.put(\"interestDist\",\n                investmentCommonService.getFndFlexSetSelectDTOs(BizConstants.FndFlexSet.TMS_INTEREST_DIST, true));\n        return dic;\n    }\n\n    /**\n     * 利率类型 写死的\n     */\n    private List<CodedLabel> getRateTypeList() {\n        List<CodedLabel> list = new ArrayList<>();\n        list.add(new CodedLabel(DealCommonEnum.FLOATING_RATE.getCode(), DealCommonEnum.FLOATING_RATE.getName()));\n        return list;\n    }\n\n    @Override\n    public String saveOrUpdate(DealDto dealDto) {\n        if (dealDto.getDueDate() == null) {\n            dealDto.setDueDate(DateUtils.addDays(DateUtils.getCurrentDateOfZero(), 1));\n        }\n        dealDto.setDealCategory(DealTypeConstants.DEAL_TYPE_MONEYMARKET);\n        this.checkAddParam(dealDto);\n//        if (dealDto.getDueDate().compareTo(DateUtils.getCurrentDateOfZero()) <= 0) {\n//            throw new WebException(\"到期日不能在今天及之前,建议到期日期填写为明天\");\n//        }\n\n        dealDto.setRate(dealDto.getExpectedAnnualRate());\n        dealDto.setBalance(dealDto.getAmount());\n        return investmentCommonService.saveOrUpdateDeal(dealDto, false);\n    }\n\n    /**\n     * 校验入参\n     */\n    private void checkAddParam(DealDto dealDto) {\n        DealEventCashUtil.commonDealCheck(dealDto);\n        if (StringUtils.isBlank(dealDto.getProductCode())) {\n            throw new WebException(\"理财产品不能为空\");\n        }\n        if (StringUtils.isBlank(dealDto.getDealType())) {\n            throw new WebException(\"交易类型不能为空\");\n        }\n        if (dealDto.getEffectiveDate() == null) {\n            throw new WebException(\"生效日期不能为空\");\n        }\n        if (dealDto.getDueDate() == null) {\n            throw new WebException(\"到期日期不能为空\");\n        }\n    }\n\n    @Override\n    @Transactional(rollbackFor = Exception.class)\n    public void addDealApplyApproved(PrepayApplyQuery req) {\n        log.info(\"addDealApplyApproved: {}\", JSON.toJSONString(req));\n\n        DealApplyDto apply = dealApplyDao.selectByPrimaryKey(req.getApplyId());\n        if (apply == null) {\n            log.error(\"资金货币新增申请不存在, applyId: {}\", req.getApplyId());\n            throw new WebException(\"资金货币新增申请不存在\");\n        }\n        if (ifApplyRepeat(apply.getApplyNum(), 0)) {\n            log.error(\"资金货币新增申请已经生成, applyId: {}\", req.getApplyId());\n            throw new WebException(\"该申请已经生成，不可重复\");\n        }\n        if (!StringUtils.equals(DEAL_APPLY_TYPE_PURCHASE1, apply.getBusinessType())) {\n            log.error(\"资金货币新增申请类型不对应, applyId: {}\", req.getApplyId());\n            throw new WebException(\"该申请类型不对应\");\n        }\n        DealDto dealDto = transformApplyToDeal(apply);\n        String dealId = this.saveOrUpdate(dealDto);\n        // 提交\n        DealDto submitDTO = new DealDto();\n        submitDTO.setDealId(Long.parseLong(dealId));\n        investmentCommonService.submitDealEvent(submitDTO);\n        // 回写dealId\n        TmsDealApply tmsDealApply = new TmsDealApply();\n        tmsDealApply.setApplyId(req.getApplyId());\n        tmsDealApply.setDealId(Long.parseLong(dealId));\n        tmsDealApplyDAO.updateByPrimaryKeySelective(tmsDealApply);\n    }\n\n    private boolean ifApplyRepeat(String applyNum, int level) {\n        boolean flag = false;\n        if (level == 0) {\n            TmsDealExample example = new TmsDealExample();\n            example.createCriteria().andDealNumEqualTo(applyNum);\n            List<TmsDeal> list = dealDAO.selectByExample(example);\n            if (!CollectionUtils.isEmpty(list)) {\n                flag = true;\n            }\n        } else if (level == 1) {\n            TmsDealEventExample example = new TmsDealEventExample();\n            example.createCriteria().andDealApplyNumEqualTo(applyNum);\n            List<TmsDealEvent> list = dealEventDAO.selectByExample(example);\n            if (!CollectionUtils.isEmpty(list)) {\n                flag = true;\n            }\n        }\n        return flag;\n    }\n\n    @Override\n    @Transactional(rollbackFor = Exception.class)\n    public void purchase2DealApplyApproved(PrepayApplyQuery req) {\n        log.info(\"purchase2DealApplyApproved: {}\", JSON.toJSONString(req));\n        if (req.getApplyId() == null) {\n            throw new WebException(\"有必填参数申请Id未填写\");\n        }\n        TmsDealApply apply = tmsDealApplyDAO.selectByPrimaryKey(req.getApplyId());\n        if (apply == null) {\n            throw new WebException(\"资金货币申请不存在\");\n        }\n        if (ifApplyRepeat(apply.getApplyNum(), 1)) {\n            throw new WebException(\"该申请已经生成，不可重复\");\n        }\n        if (!StringUtils.equals(DEAL_APPLY_TYPE_PURCHASE2, apply.getBusinessType())) {\n            throw new WebException(\"该申请类型不对应\");\n        }\n        Date effectiveDate = apply.getEffectiveDate();\n        BigDecimal addAmount = apply.getRepayAmount();\n        String dealNum = apply.getDealNum();\n        TmsDealExample example = new TmsDealExample();\n        example.createCriteria().andDealNumEqualTo(dealNum);\n        List<TmsDeal> dealList = dealDAO.selectByExample(example);\n        if (CollectionUtils.isEmpty(dealList)) {\n            log.error(\"未找到该交易, para: {}\", JSON.toJSONString(req));\n            throw new WebException(\"未找到该交易\");\n        }\n        TmsDeal deal = dealList.get(0);\n        BigDecimal remain = deal.getBalance().add(addAmount);\n        if (!DealCommonEnum.STATUS_CONFIRMED.getCode().equals(deal.getDealStatus())) {\n            throw new WebException(\"交易状态已经发生变更\");\n        }\n        TmsDealEventExample eventExample = new TmsDealEventExample();\n        TmsDealEventExample.Criteria exampleCriteria = eventExample.createCriteria();\n        exampleCriteria.andDealIdEqualTo(deal.getDealId());\n        eventExample.setOrderByClause(\"effective_date asc, event_order asc, event_id asc\");\n        List<TmsDealEvent> eventList = dealEventDAO.selectByExample(eventExample);\n        if (CollectionUtils.isEmpty(eventList)) {\n            log.error(\"未找到该交易事件, para: {}\", JSON.toJSONString(req));\n            throw new WebException(\"未找到该交易事件\");\n        }\n\n        DealDto dealDto = new DealDto();\n        BeanUtils.copyProperties(deal, dealDto);\n        dealDto.setEffectiveDate(effectiveDate);\n        dealDto.setBalance(remain);\n        dealDto.setSettlementAmount(addAmount);\n        dealDto.setDealApplyNum(apply.getApplyNum());\n        dealDto.setDealDate(apply.getPlanDealDate());\n        dealEventCashUtil.createPurchase2(dealDto, null, null);\n\n        if (!CollectionUtils.isEmpty(eventList)) {\n            eventList.forEach(e -> {\n                if (StringUtils.equals(e.getEventType(), LoanConstants.EVENT_TYPE_SHBJ)\n                        && StringUtils.equals(e.getEventTypeSub(), DealTypeConstants.EVENT_TYPE_SUB_ORIGIN)) {\n                    e.setSettlementAmount(remain);\n                    e.setPrincipalBalance(remain);\n                    e.setLastUpdateDate(new Date());\n                    dealEventDAO.updateByPrimaryKeySelective(e);\n\n                    // 更新资金流\n                    TmsDealCashFlow cashFlow = new TmsDealCashFlow();\n                    cashFlow.setEventId(e.getEventId());\n                    cashFlow.setAmount(remain);\n                    cashFlow.setLastUpdateDate(new Date());\n\n                    TmsDealCashFlowExample cashFlowExample = new TmsDealCashFlowExample();\n                    TmsDealCashFlowExample.Criteria cashFlowCriteria = cashFlowExample.createCriteria();\n                    cashFlowCriteria.andEventIdEqualTo(e.getEventId()).andDealIdEqualTo(e.getDealId());\n                    cashFlowDAO.updateByExampleSelective(cashFlow, cashFlowExample);\n                }\n            });\n        }\n        TmsDeal update = new TmsDeal();\n        update.setDealId(deal.getDealId());\n        update.setBalance(remain);\n        update.setHoldingCost(deal.getHoldingCost().add(addAmount));\n        update.setLastUpdateDate(new Date());\n        dealDAO.updateByPrimaryKeySelective(update);\n    }\n\n    @Override\n    @Transactional(rollbackFor = Exception.class)\n    public void redeemDealApplyApproved(PrepayApplyQuery req) {\n        log.info(\"redeemDealApplyApproved: {}\", JSON.toJSONString(req));\n        if (req.getApplyId() == null) {\n            throw new WebException(\"有必填参数申请Id未填写\");\n        }\n        TmsDealApply apply = tmsDealApplyDAO.selectByPrimaryKey(req.getApplyId());\n        if (apply == null) {\n            throw new WebException(\"资金货币申请不存在\");\n        }\n        if (ifApplyRepeat(apply.getApplyNum(), 1)) {\n            throw new WebException(\"该申请已经生成，不可重复\");\n        }\n        if (!StringUtils.equals(DEAL_APPLY_TYPE_REDEEM, apply.getBusinessType())) {\n            throw new WebException(\"该申请类型不对应\");\n        }\n        Date effectiveDate = apply.getEffectiveDate();\n        BigDecimal repayAmount = apply.getRepayAmount();\n        BigDecimal remain = apply.getRepayAmountRemain();\n        String dealNum = apply.getDealNum();\n        TmsDealExample example = new TmsDealExample();\n        example.createCriteria().andDealNumEqualTo(dealNum);\n        List<TmsDeal> dealList = dealDAO.selectByExample(example);\n        if (CollectionUtils.isEmpty(dealList)) {\n            log.error(\"未找到该交易, para: {}\", JSON.toJSONString(req));\n            throw new WebException(\"未找到该交易\");\n        }\n        TmsDeal deal = dealList.get(0);\n\n        if (!DealCommonEnum.STATUS_CONFIRMED.getCode().equals(deal.getDealStatus())) {\n            throw new WebException(\"交易状态已经发生变更\");\n        }\n        TmsDealEventExample eventExample = new TmsDealEventExample();\n        TmsDealEventExample.Criteria exampleCriteria = eventExample.createCriteria();\n        exampleCriteria.andDealIdEqualTo(deal.getDealId());\n        eventExample.setOrderByClause(\"effective_date asc, event_order asc, event_id asc\");\n        List<TmsDealEvent> eventList = dealEventDAO.selectByExample(eventExample);\n        if (CollectionUtils.isEmpty(eventList)) {\n            log.error(\"未找到该交易事件, para: {}\", JSON.toJSONString(req));\n            throw new WebException(\"未找到该交易事件\");\n        }\n\n        DealDto dealDto = new DealDto();\n        BeanUtils.copyProperties(deal, dealDto);\n        dealDto.setDealDate(apply.getPlanDealDate());\n        dealDto.setEffectiveDate(effectiveDate);\n        dealDto.setBalance(remain);\n        dealDto.setSettlementAmount(repayAmount);\n        dealDto.setDealApplyNum(apply.getApplyNum());\n        dealEventCashUtil.createRedeem(dealDto, null, null);\n\n        if (!CollectionUtils.isEmpty(eventList)) {\n            eventList.forEach(e -> {\n                if (StringUtils.equals(e.getEventType(), LoanConstants.EVENT_TYPE_SHBJ)\n                        && StringUtils.equals(e.getEventTypeSub(), DealTypeConstants.EVENT_TYPE_SUB_ORIGIN)) {\n                    if (BigDecimal.ZERO.compareTo(remain) != 0) {\n                        e.setSettlementAmount(remain);\n                        e.setPrincipalBalance(remain);\n                        e.setLastUpdateDate(new Date());\n                        dealEventDAO.updateByPrimaryKeySelective(e);\n\n                        // 更新资金流\n                        TmsDealCashFlow cashFlow = new TmsDealCashFlow();\n                        cashFlow.setEventId(e.getEventId());\n                        cashFlow.setAmount(remain);\n                        cashFlow.setLastUpdateDate(new Date());\n\n                        TmsDealCashFlowExample cashFlowExample = new TmsDealCashFlowExample();\n                        TmsDealCashFlowExample.Criteria cashFlowCriteria = cashFlowExample.createCriteria();\n                        cashFlowCriteria.andEventIdEqualTo(e.getEventId()).andDealIdEqualTo(e.getDealId());\n                        cashFlowDAO.updateByExampleSelective(cashFlow, cashFlowExample);\n                    } else {\n                        // 全部还款\n                        dealEventDAO.deleteByPrimaryKey(e.getEventId());\n                        TmsDealCashFlowExample cashFlowExample = new TmsDealCashFlowExample();\n                        TmsDealCashFlowExample.Criteria cashFlowCriteria = cashFlowExample.createCriteria();\n                        cashFlowCriteria.andEventIdEqualTo(e.getEventId()).andDealIdEqualTo(e.getDealId());\n                        cashFlowDAO.deleteByExample(cashFlowExample);\n                        // 创建0利息事件\n                        dealEventCashUtil.createInterestZeroType(dealDto, null, null);\n                    }\n                }\n            });\n        }\n        TmsDeal update = new TmsDeal();\n        update.setDealId(deal.getDealId());\n        update.setBalance(remain);\n        BigDecimal holdingCost = deal.getHoldingCost().subtract(repayAmount).compareTo(BigDecimal.ZERO) > 0\n                ? deal.getHoldingCost().subtract(repayAmount) : BigDecimal.ZERO;\n        update.setHoldingCost(holdingCost);\n        update.setLastUpdateDate(new Date());\n        dealDAO.updateByPrimaryKeySelective(update);\n    }\n\n    private DealDto transformApplyToDeal(DealApplyDto apply) {\n        DealDto dealDto = new DealDto();\n        BeanUtils.copyProperties(apply, dealDto);\n        dealDto.setDealId(null);\n        dealDto.setDealApplyNum(apply.getApplyNum());\n        dealDto.setProductCode(apply.getProductCode());\n        dealDto.setProductName(apply.getProductName());\n        dealDto.setDealType(apply.getDealType());\n        dealDto.setCounterpartyCode(apply.getCounterpartyCode());\n        dealDto.setCompanyCode(apply.getCompanyCode());\n        dealDto.setCompanyAccount(apply.getCompanyAccount());\n        dealDto.setCurrencyCode(apply.getCurrency());\n        dealDto.setAmount(apply.getAmount());\n        dealDto.setDealDate(apply.getPlanDealDate());\n        dealDto.setEffectiveDate(apply.getEffectiveDate());\n        if (apply.getEffectiveDate() != null) {\n            dealDto.setDueDate(DateUtils.addDays(apply.getEffectiveDate(), 1));\n        }\n        dealDto.setExpectedAnnualRate(apply.getExpectedAnnualRate());\n        dealDto.setSubmitter(apply.getApplyUser());\n        dealDto.setSubmitterName(apply.getApplyUserInfo());\n        dealDto.setSubmitterDept(apply.getApplyDept());\n\n        TmsTransactionTypeExample example = new TmsTransactionTypeExample();\n        example.createCriteria().andBusinessTypeEqualTo(DealTypeConstants.DEAL_TYPE_MONEYMARKET)\n                .andTransCodeEqualTo(apply.getDealType());\n        List<TmsTransactionType> types = tmsTransactionTypeDAO.selectByExample(example);\n        if (CollectionUtils.isEmpty(types)) {\n            log.error(\"交易类型不存在, para: {}\", JSON.toJSONString(apply));\n            throw new WebException(\"交易类型不存在\");\n        }\n        TmsTransactionType type = types.get(0);\n        dealDto.setFrequency(type.getInterestFrequency());\n        dealDto.setRateType(type.getRateType());\n        dealDto.setInterestType(type.getInterestType());\n        return dealDto;\n    }\n\n    @Override\n    public void saveEventCash(DealDto dealDto) {\n        TmsDeal deal = dealDAO.selectByPrimaryKey(dealDto.getDealId());\n        DealDto oldDealDto = new DealDto();\n        BeanUtils.copyProperties(deal, oldDealDto);\n        List<DealEventDto> eventList = dealDto.getEventList();\n        List<DealCashFlowDto> flowList = dealDto.getCashFlowList();\n        if (!CollectionUtils.isEmpty(eventList)) {\n            investmentCommonService.insertDealHis(oldDealDto, DealCommonEnum.OPERATE_EVENT_RE_SAVE);\n            for (DealEventDto event : eventList) {\n                TmsDealEvent dealEvent = new TmsDealEvent();\n                dealEvent.setEventId(event.getEventId());\n                dealEvent.setSettlementDate(event.getSettlementDate());\n                BigDecimal settlementAmount = event.getSettlementAmount();\n                BigDecimal totalInterest = event.getTotalInterest();\n                if (event.getInterestAdjustAmount() != null) {\n                    settlementAmount = settlementAmount.add(event.getInterestAdjustAmount());\n                    totalInterest = totalInterest.add(event.getInterestAdjustAmount());\n                }\n                if (event.getServiceCharge() != null) {\n                    settlementAmount = settlementAmount.add(event.getServiceCharge());\n                }\n                dealEvent.setSettlementAmount(settlementAmount);\n                dealEvent.setTotalInterest(totalInterest);\n                dealEvent.setServiceCharge(event.getServiceCharge());\n                dealEventDAO.updateByPrimaryKeySelective(dealEvent);\n                investmentCommonService.insertEventHis(event, DealCommonEnum.OPERATE_DEAL_EDIT);\n                TmsDealCashFlow cashFlow = new TmsDealCashFlow();\n                cashFlow.setSettlementDate(event.getSettlementDate());\n                cashFlow.setAmount(settlementAmount);\n                TmsDealCashFlowExample example = new TmsDealCashFlowExample();\n                TmsDealCashFlowExample.Criteria criteria = example.createCriteria();\n                criteria.andEventIdEqualTo(event.getEventId()).andDealIdEqualTo(event.getDealId());\n                cashFlowDAO.updateByExampleSelective(cashFlow, example);\n            }\n        }\n        if (!CollectionUtils.isEmpty(flowList)) {\n            investmentCommonService.insertDealHis(oldDealDto, DealCommonEnum.OPERATE_EVENT_RE_SAVE);\n            for (DealCashFlowDto flow : flowList) {\n                TmsDealCashFlow cashFlow = new TmsDealCashFlow();\n                cashFlow.setCashId(flow.getCashId());\n                cashFlow.setAccount(flow.getAccount());\n                cashFlowDAO.updateByPrimaryKeySelective(cashFlow);\n            }\n        }\n    }\n\n    @Override\n    public void confirmCashType(DealDto req) {\n        Long dealId = req.getDealId();\n        Date dealDate = req.getDealDate();\n        Date effectiveDate = req.getEffectiveDate();\n        BigDecimal balance = req.getDividendBalance();\n        String remark = req.getRemark();\n        if (dealId == null) {\n            throw new WebException(\"有必填参数dealId未填写\");\n        }\n        TmsDeal deal = dealDAO.selectByPrimaryKey(dealId);\n        if (!DealCommonEnum.STATUS_CONFIRMED.getCode().equals(deal.getDealStatus())) {\n            throw new WebException(\"交易状态已经发生变更，请更新后重试\");\n        }\n        this.checkCashTypePara(req);\n\n        TmsDealEventExample eventExample = new TmsDealEventExample();\n        TmsDealEventExample.Criteria exampleCriteria = eventExample.createCriteria();\n        exampleCriteria.andDealIdEqualTo(deal.getDealId());\n        eventExample.setOrderByClause(\"effective_date asc, event_order asc, event_id asc\");\n        List<TmsDealEvent> eventList = dealEventDAO.selectByExample(eventExample);\n        if (CollectionUtils.isEmpty(eventList)) {\n            log.error(\"未找到该交易事件, para: {}\", JSON.toJSONString(req));\n            throw new WebException(\"未找到该交易事件\");\n        }\n\n        DealDto dealDto = new DealDto();\n        BeanUtils.copyProperties(deal, dealDto);\n        dealDto.setEffectiveDate(effectiveDate);\n        dealDto.setDealDate(dealDate);\n        dealDto.setBalance(deal.getBalance());\n        dealDto.setSettlementAmount(balance);\n        dealDto.setRemark(remark);\n        List<TmsDealEvent> dealEventList = new ArrayList<>();\n        dealEventCashUtil.createInterestCashType(dealDto, dealEventList, null);\n        if (!CollectionUtils.isEmpty(dealEventList)) {\n            TmsDealEvent event = dealEventList.get(0);\n            saveAttachment(event.getEventId(), req.getDealAttachIds());\n        }\n\n    }\n\n    private void checkCashTypePara(DealDto req) {\n        Date dealDate = req.getDealDate();\n        Date effectiveDate = req.getEffectiveDate();\n        BigDecimal balance = req.getDividendBalance();\n        if (dealDate == null || effectiveDate == null || balance == null) {\n            throw new WebException(\"有必填参数未填写\");\n        }\n        if (dealDate.after(effectiveDate)) {\n            throw new WebException(\"确认日期不能早于生效日期\");\n        }\n        if (balance.compareTo(BigDecimal.ZERO) <= 0) {\n            throw new WebException(\"确认金额不能小于等于0\");\n        }\n        this.checkEffectiveDate(req);\n\n    }\n\n    private void checkEffectiveDate(DealDto req) {\n        TmsDealEventExample eventExample = new TmsDealEventExample();\n        TmsDealEventExample.Criteria exampleCriteria = eventExample.createCriteria();\n        exampleCriteria.andDealIdEqualTo(req.getDealId());\n        eventExample.setOrderByClause(\"effective_date asc, event_order asc, event_id asc\");\n        List<TmsDealEvent> eventList = dealEventDAO.selectByExample(eventExample);\n        if (CollectionUtils.isEmpty(eventList)) {\n            log.error(\"未找到该交易事件, para: {}\", JSON.toJSONString(req));\n            throw new WebException(\"未找到该交易事件\");\n        }\n        // 事件区间不匹配,禁掉\n        List<TmsDealEvent> confirmList = eventList.stream()\n                .filter(t -> TransactionEventStatusEnum.COMPLETED.getCode().equals(t.getEventStatus()))\n                .collect(Collectors.toList());\n        if (!CollectionUtils.isEmpty(confirmList)) {\n            TmsDealEvent dealEvent = confirmList.stream()\n                    .max(Comparator.comparing(TmsDealEvent::getEffectiveDate)).get();\n            Date date = dealEvent.getEffectiveDate();\n            if (date.after(req.getEffectiveDate())) {\n                throw new WebException(\"生效日期不能在已完成事件生效日期前\");\n            }\n        }\n        if (eventList.get(eventList.size() - 1).getEffectiveDate()\n                .before(req.getEffectiveDate())) {\n            throw new WebException(\"生效日期不能在到期日之后\");\n        }\n\n        // 顺序操作\n        List<TmsDealEvent> unConfirmWithdrawEvent = eventList.stream().filter(t -> (\n                        !TransactionEventStatusEnum.COMPLETED.getCode().equals(t.getEventStatus())\n                                && LoanConstants.EVENT_TYPE_SDLX.equals(t.getEventType())\n                                && !DealTypeConstants.EVENT_TYPE_SUB_ORIGIN.equals(t.getEventTypeSub())))\n                .collect(Collectors.toList());\n        if (!CollectionUtils.isEmpty(unConfirmWithdrawEvent)) {\n            throw new WebException(\"生效日期之前存在未完成的事件\");\n        }\n    }\n\n    @Override\n    public void confirmCapitalType(DealDto req) {\n        Long dealId = req.getDealId();\n        Date effectiveDate = req.getEffectiveDate();\n        BigDecimal balance = req.getDividendBalance();\n        if (dealId == null) {\n            throw new WebException(\"有必填参数dealId未填写\");\n        }\n        TmsDeal deal = dealDAO.selectByPrimaryKey(dealId);\n        if (!DealCommonEnum.STATUS_CONFIRMED.getCode().equals(deal.getDealStatus())) {\n            throw new WebException(\"交易状态已经发生变更，请更新后重试\");\n        }\n        this.checkCapitalTypePara(req);\n\n        TmsDealEventExample eventExample = new TmsDealEventExample();\n        TmsDealEventExample.Criteria exampleCriteria = eventExample.createCriteria();\n        exampleCriteria.andDealIdEqualTo(deal.getDealId());\n        eventExample.setOrderByClause(\"effective_date asc, event_order asc, event_id asc\");\n        List<TmsDealEvent> eventList = dealEventDAO.selectByExample(eventExample);\n        if (CollectionUtils.isEmpty(eventList)) {\n            log.error(\"未找到该交易事件, para: {}\", JSON.toJSONString(req));\n            throw new WebException(\"未找到该交易事件\");\n        }\n\n        DealDto dealDto = new DealDto();\n        BeanUtils.copyProperties(deal, dealDto);\n        dealDto.setEffectiveDate(effectiveDate);\n        dealDto.setBalance(deal.getBalance().add(balance));\n        dealDto.setSettlementAmount(balance);\n        List<TmsDealEvent> dealEventList = new ArrayList<>();\n        dealEventCashUtil.createInterestCapitalType(dealDto, dealEventList);\n        if (!CollectionUtils.isEmpty(dealEventList)) {\n            TmsDealEvent event = dealEventList.get(0);\n            saveAttachment(event.getEventId(), req.getDealAttachIds());\n        }\n        deal.setBalance(dealDto.getBalance());\n        deal.setLastUpdateDate(new Date());\n        dealDAO.updateByPrimaryKey(deal);\n        if (!CollectionUtils.isEmpty(eventList)) {\n            eventList.forEach(e -> {\n                if (StringUtils.equals(e.getEventType(), LoanConstants.EVENT_TYPE_SHBJ)\n                        && StringUtils.equals(e.getEventTypeSub(), DealTypeConstants.EVENT_TYPE_SUB_ORIGIN)) {\n                    e.setSettlementAmount(deal.getBalance());\n                    e.setPrincipalBalance(deal.getBalance());\n                    e.setLastUpdateDate(new Date());\n                    dealEventDAO.updateByPrimaryKeySelective(e);\n                    // 更新资金流\n                    TmsDealCashFlow cashFlow = new TmsDealCashFlow();\n                    cashFlow.setEventId(e.getEventId());\n                    cashFlow.setAmount(deal.getBalance());\n                    cashFlow.setLastUpdateDate(new Date());\n\n                    TmsDealCashFlowExample example = new TmsDealCashFlowExample();\n                    TmsDealCashFlowExample.Criteria criteria = example.createCriteria();\n                    criteria.andEventIdEqualTo(e.getEventId()).andDealIdEqualTo(e.getDealId());\n                    cashFlowDAO.updateByExampleSelective(cashFlow, example);\n                }\n            });\n        }\n    }\n\n    private void checkCapitalTypePara(DealDto req) {\n        Date effectiveDate = req.getEffectiveDate();\n        BigDecimal balance = req.getDividendBalance();\n        if (effectiveDate == null || balance == null) {\n            throw new WebException(\"有必填参数未填写\");\n        }\n        if (balance.compareTo(BigDecimal.ZERO) <= 0) {\n            throw new WebException(\"确认金额不能小于等于0\");\n        }\n        this.checkEffectiveDate(req);\n\n    }\n\n    /**\n     * 交易事件结算信息 附件关联入库\n     */\n    private void saveAttachment(Long eventId, List<String> attachIds) {\n        // 申请时处理申请附件\n        String currentUser = SessionUtils.getSessionUser().getUsername();\n        if (!CollectionUtils.isEmpty(attachIds) && eventId != null) {\n            attachmentDAO.updateAttachBizpk(attachIds,\n                    CommonEnums.AttachmentBizType.DEAL_EVENT_MM_ATTACH.getValue(),\n                    String.valueOf(eventId), currentUser);\n        }\n    }\n\n    @Override\n    @Transactional(rollbackFor = Exception.class)\n    public void withdrawCompletedApply(PrepayApplyQuery req) {\n        log.info(\"货币基金市场撤回已完成申请, para: {}\", JSON.toJSONString(req));\n        if (req.getApplyId() == null) {\n            throw new WebException(\"有必填参数申请Id未填写\");\n        }\n        TmsDealApply apply = tmsDealApplyDAO.selectByPrimaryKey(req.getApplyId());\n        if (apply == null) {\n            throw new WebException(\"资金货币申请不存在\");\n        }\n        if (!StringUtils.equals(DEAL_APPLY_TYPE_PURCHASE2, apply.getBusinessType())\n                && !StringUtils.equals(DEAL_APPLY_TYPE_REDEEM, apply.getBusinessType())) {\n            throw new WebException(\"撤回时申请类型不对应\");\n        }\n        TmsDealEventExample eventExample = new TmsDealEventExample();\n        TmsDealEventExample.Criteria exampleCriteria = eventExample.createCriteria();\n        exampleCriteria.andDealApplyNumEqualTo(apply.getApplyNum());\n        eventExample.setOrderByClause(\"effective_date asc, event_order asc, event_id asc\");\n        List<TmsDealEvent> withdrawEventList = dealEventDAO.selectByExample(eventExample);\n        if (CollectionUtils.isEmpty(withdrawEventList)) {\n            log.error(\"未找到该交易事件, para: {}\", JSON.toJSONString(req));\n            throw new WebException(\"未找到该交易事件\");\n        }\n        List<String> statusList = withdrawEventList.stream().map(TmsDealEvent::getEventStatus)\n                .collect(Collectors.toList());\n        if (statusList.contains(TransactionEventStatusEnum.COMPLETED.name())) {\n            log.error(\"申请的事件出纳已处理，不可撤回, para: {}\", JSON.toJSONString(req));\n            throw new WebException(\"申请的事件出纳已处理，不可撤回\");\n        }\n        TmsDealEvent withdrawEvent = withdrawEventList.get(0);\n        TmsDeal deal = dealDAO.selectByPrimaryKey(withdrawEvent.getDealId());\n        if (deal == null) {\n            log.error(\"未找到该交易, para: {}, dealId:{}\", JSON.toJSONString(req), withdrawEvent.getDealId());\n            throw new WebException(\"未找到该交易\");\n        }\n        if (!DealCommonEnum.STATUS_CONFIRMED.getCode().equals(deal.getDealStatus())) {\n            throw new WebException(\"交易状态已经发生变更\");\n        }\n        TmsDealEvent lastEvent = this.checkWithdrawCompletedApply(deal, withdrawEventList);\n        apply.setApplyStatus(DealSelectTypeConstants.DealApplyStatus.CANCEL.name());\n        tmsDealApplyDAO.updateByPrimaryKey(apply);\n        this.insertApplyWithdrawHis(apply);\n        withdrawEventList.forEach(e -> {\n            dealEventDAO.deleteByPrimaryKey(e.getEventId());\n            TmsDealCashFlowExample cashFlowExample = new TmsDealCashFlowExample();\n            TmsDealCashFlowExample.Criteria exampleCriteria2 = cashFlowExample.createCriteria();\n            exampleCriteria2.andEventIdEqualTo(e.getEventId()).andDealIdEqualTo(e.getDealId());\n            cashFlowDAO.deleteByExample(cashFlowExample);\n        });\n        BigDecimal repayAmount = apply.getRepayAmount();\n        if (StringUtils.equals(DEAL_APPLY_TYPE_PURCHASE2, apply.getBusinessType())) {\n            BigDecimal temp = withdrawEvent.getPrincipalBalance().abs();\n            BigDecimal remained = withdrawEvent.getPrincipalRemained().abs();\n            BigDecimal tempRes = remained.subtract(temp);\n            lastEvent.setPrincipalBalance(tempRes);\n            lastEvent.setSettlementAmount(tempRes);\n            dealEventDAO.updateByPrimaryKey(lastEvent);\n\n            TmsDealCashFlowExample cashFlowExample1 = new TmsDealCashFlowExample();\n            cashFlowExample1.createCriteria().andEventIdEqualTo(lastEvent.getEventId());\n            TmsDealCashFlow record = new TmsDealCashFlow();\n            record.setAmount(tempRes);\n            cashFlowDAO.updateByExampleSelective(record, cashFlowExample1);\n\n            TmsDeal update = new TmsDeal();\n            update.setDealId(deal.getDealId());\n            update.setBalance(tempRes);\n            update.setHoldingCost(deal.getHoldingCost().subtract(repayAmount));\n            update.setLastUpdateDate(new Date());\n            dealDAO.updateByPrimaryKeySelective(update);\n        } else if (StringUtils.equals(DEAL_APPLY_TYPE_REDEEM, apply.getBusinessType())) {\n            BigDecimal remain = apply.getRepayAmountRemain();\n            if (BigDecimal.ZERO.compareTo(remain) != 0) {\n                BigDecimal temp = withdrawEvent.getPrincipalBalance().abs();\n                BigDecimal remained = withdrawEvent.getPrincipalRemained().abs();\n                BigDecimal tempRes = remained.add(temp);\n                lastEvent.setPrincipalBalance(tempRes);\n                lastEvent.setSettlementAmount(tempRes);\n                dealEventDAO.updateByPrimaryKey(lastEvent);\n\n                TmsDealCashFlowExample cashFlowExample1 = new TmsDealCashFlowExample();\n                cashFlowExample1.createCriteria().andEventIdEqualTo(lastEvent.getEventId());\n                TmsDealCashFlow record = new TmsDealCashFlow();\n                record.setAmount(tempRes);\n                cashFlowDAO.updateByExampleSelective(record, cashFlowExample1);\n\n                TmsDeal update = new TmsDeal();\n                update.setDealId(deal.getDealId());\n                update.setBalance(tempRes);\n                update.setHoldingCost(deal.getHoldingCost().add(repayAmount));\n                update.setLastUpdateDate(new Date());\n                dealDAO.updateByPrimaryKeySelective(update);\n            } else {\n                BigDecimal remainTemp = lastEvent.getPrincipalRemained();\n                DealDto dealDto = new DealDto();\n                BeanUtils.copyProperties(deal, dealDto);\n                dealDto.setAmount(remainTemp);\n                dealDto.setCurrentIndex(Integer.parseInt(lastEvent.getEventNumber()\n                        .split(DealSelectTypeConstants.DEAL_EVENT_NUM_SPLIT)[1]) + 1);\n                List<TmsDealEvent> dealEventList = new ArrayList<>();\n                dealEventCashUtil.createReceivePrincipal(dealDto, dealEventList, null);\n                dealEventList.forEach(e -> {\n                    e.setEventStatus(DealCommonEnum.STATUS_BEFORE_CONFIRM.getCode());\n                    dealEventDAO.updateByPrimaryKey(e);\n                });\n\n                TmsDeal update = new TmsDeal();\n                update.setDealId(deal.getDealId());\n                update.setBalance(remainTemp);\n                update.setHoldingCost(deal.getHoldingCost().add(repayAmount));\n                update.setLastUpdateDate(new Date());\n                dealDAO.updateByPrimaryKeySelective(update);\n            }\n\n        }\n    }\n\n    /**\n     * 校验撤回已完成申请\n     *\n     * @param apply\n     */\n    private void insertApplyWithdrawHis(TmsDealApply apply) {\n        TmsDealApplyHis applyHis = new TmsDealApplyHis();\n        BeanUtils.copyProperties(apply, applyHis);\n        applyHis.setId(null);\n        applyHis.setApplyId(apply.getApplyId());\n        applyHis.setOperate(\"审批后撤回\");\n        applyHis.setApplyUser(SessionUtils.getSessionUser().getUsername());\n        applyHis.setApplyUserInfo(SessionUtils.getSessionUser().getUicUser().getName());\n        applyHis.setCreatedBy(SessionUtils.getSessionUser().getUsername());\n        applyHis.setCreationDate(new Date());\n        tmsDealApplyHisDAO.insert(applyHis);\n    }\n\n    /**\n     * 校验撤回已完成申请\n     *\n     * @param deal\n     * @param withdrawEventList\n     */\n    private TmsDealEvent checkWithdrawCompletedApply(TmsDeal deal, List<TmsDealEvent> withdrawEventList) {\n        TmsDealEvent withdrawEvent = withdrawEventList.get(0);\n\n        // 撤回事件后面的事件列表\n        TmsDealEventExample eventExample = new TmsDealEventExample();\n        TmsDealEventExample.Criteria exampleCriteria = eventExample.createCriteria();\n        exampleCriteria.andDealIdEqualTo(deal.getDealId());\n        eventExample.setOrderByClause(\"effective_date asc, event_order asc, event_id asc\");\n        List<TmsDealEvent> eventList = dealEventDAO.selectByExample(eventExample);\n        List<TmsDealEvent> temp = eventList.stream().filter(e -> StringUtils.equals(e.getEventNumber(),\n                withdrawEvent.getEventNumber())).collect(Collectors.toList());\n        if (CollectionUtils.isEmpty(temp)) {\n            log.error(\"事件列表异常, withdrawEvent: {}\", JSON.toJSONString(withdrawEvent));\n            throw new WebException(\"未找到该交易事件\");\n        }\n        List<TmsDealEvent> tempEventList;\n        TmsDealEvent lastEvent = null;\n        if (withdrawEventList.size() == 1) {\n            tempEventList = eventList.subList(eventList.indexOf(temp.get(0)) + 1, eventList.size());\n            if (CollectionUtils.isEmpty(tempEventList) || 1 != tempEventList.size()) {\n                log.error(\"事件列表异常, withdrawEvent: {}\", JSON.toJSONString(withdrawEvent));\n                throw new WebException(\"未找到该交易事件\");\n            }\n            lastEvent = tempEventList.get(0);\n            // 后边不允许有已完成事件\n            if (TransactionEventStatusEnum.COMPLETED.getCode().equals(lastEvent.getEventStatus())) {\n                log.error(\"该申请的事件后续有已完成的事件，该申请不可撤回, withdrawEvent: {}, lastEvent: {}\",\n                        JSON.toJSONString(withdrawEvent), JSON.toJSONString(lastEvent));\n                throw new WebException(\"该申请的事件后续有已完成的事件，该申请不可撤回\");\n            }\n        } else {\n            tempEventList = eventList.subList(0, eventList.indexOf(temp.get(0)));\n            if (CollectionUtils.isEmpty(tempEventList)) {\n                log.error(\"事件列表异常, withdrawEvent: {}\", JSON.toJSONString(withdrawEvent));\n                throw new WebException(\"未找到该交易事件\");\n            }\n            lastEvent = tempEventList.get(tempEventList.size() - 1);\n        }\n        return lastEvent;\n    }\n\n    @Override\n    public BigDecimal getCapitalRate(DealDto req) {\n        Long dealId = req.getDealId();\n        Date effectiveDate = req.getEffectiveDate();\n        BigDecimal dividendBalance = req.getDividendBalance();\n        TmsDeal deal = dealDAO.selectByPrimaryKey(dealId);\n        if (deal == null) {\n            log.error(\"未找到该交易, dealId: {}\", dealId);\n            throw new WebException(\"未找到该交易\");\n        }\n        if (effectiveDate.before(deal.getEffectiveDate()) || effectiveDate.after(deal.getDueDate())) {\n            throw new WebException(\"时间范围应在起止日期内\");\n        }\n        if (effectiveDate.after(DateUtils.getCurrentDateOfZero())) {\n            throw new WebException(\"时间不可大于当前日期\");\n        }\n        String interestType = StringUtils.isBlank(deal.getInterestType()) ? LoanConstants.INTEREST_CAL_TYPE_360 :\n                deal.getInterestType();\n\n        TmsDealEventExample eventExample = new TmsDealEventExample();\n        TmsDealEventExample.Criteria eventCriteria = eventExample.createCriteria();\n        eventCriteria.andDealIdEqualTo(dealId);\n        eventCriteria.andEffectiveDateLessThanOrEqualTo(effectiveDate);\n        List<String> eventType = Arrays.asList(LoanConstants.EVENT_TYPE_ZFBJ, LoanConstants.EVENT_TYPE_CAPITAL);\n        eventCriteria.andEventTypeIn(eventType);\n        eventExample.setOrderByClause(\"effective_date desc, event_order desc, event_id desc\");\n        List<TmsDealEvent> eventList = dealEventDAO.selectByExample(eventExample);\n        if (CollectionUtils.isEmpty(eventList)) {\n            log.error(\"该交易事件不完整, dealId: {}\", dealId);\n            throw new WebException(\"请确认日期选择是否正确\");\n        }\n        Date lastEffectiveDate = eventList.get(0).getEffectiveDate();\n        BigDecimal days = dealEventCashUtil.getInterestDays(lastEffectiveDate, effectiveDate, interestType, false)\n                .add(BigDecimal.ONE);\n        int dayOfYear = LoanConstants.INTEREST_CAL_TYPE_365.equals(interestType) ? DAYS_365 : DAYS_360;\n        return calculateRate(deal.getBalance(), dividendBalance, days, dayOfYear);\n    }\n\n    @Transactional(rollbackFor = Exception.class)\n    @Override\n    public void purchase4DealApplyApproved(PrepayApplyQuery req) {\n        log.info(\"purchase4DealApplyApproved: {}\", JSON.toJSONString(req));\n        if (req.getApplyId() == null) {\n            throw new WebException(\"有必填参数申请Id未填写\");\n        }\n        TmsDealApply apply = tmsDealApplyDAO.selectByPrimaryKey(req.getApplyId());\n        if (apply == null) {\n            throw new WebException(\"资金货币申请不存在\");\n        }\n        if (!StringUtils.equals(DEAL_APPLY_TYPE_PURCHASE4, apply.getBusinessType())) {\n            throw new WebException(\"该申请类型不对应\");\n        }\n        String dealNum = apply.getDealNum();\n        TmsDealExample example = new TmsDealExample();\n        example.createCriteria().andDealNumEqualTo(dealNum);\n        List<TmsDeal> dealList = dealDAO.selectByExample(example);\n        if (CollectionUtils.isEmpty(dealList)) {\n            log.error(\"未找到该交易, para: {}\", JSON.toJSONString(req));\n            throw new WebException(\"未找到该交易\");\n        }\n        TmsDeal deal = dealList.get(0);\n        if (!DealCommonEnum.STATUS_CONFIRMED.getCode().equals(deal.getDealStatus())) {\n            throw new WebException(\"交易状态已经发生变更\");\n        }\n        TmsDealEventExample eventExample = new TmsDealEventExample();\n        TmsDealEventExample.Criteria exampleCriteria = eventExample.createCriteria();\n        exampleCriteria.andDealIdEqualTo(deal.getDealId());\n        eventExample.setOrderByClause(\"effective_date asc, event_order asc, event_id asc\");\n        List<TmsDealEvent> eventList = dealEventDAO.selectByExample(eventExample);\n        if (CollectionUtils.isEmpty(eventList)) {\n            log.error(\"未找到该交易事件, para: {}\", JSON.toJSONString(req));\n            throw new WebException(\"未找到该交易事件\");\n        }\n        DealDto dealDto = new DealDto();\n        BeanUtils.copyProperties(deal, dealDto);\n\n        String attribute3 = apply.getAttribute3();\n        Date date = new Date();\n        Date addEffectiveDate = date;\n        // 续存到期日~续存生效日\n        if (StringUtils.contains(attribute3, \"~\")) {\n            String[] split = attribute3.split(\"~\");\n            if (split.length > 1) {\n                date = DateUtils.parseDate(split[0]);\n                addEffectiveDate = DateUtils.parseDate(split[1]);\n            }\n        }\n\n        BigDecimal bigDecimal = new BigDecimal(apply.getAttribute5());\n        BigDecimal attribute1 = new BigDecimal(apply.getAttribute1());\n        BigDecimal remain = deal.getBalance().add(attribute1);\n        BigDecimal rate = new BigDecimal(apply.getAttribute2());\n        dealDto.setBalance(remain);\n        dealDto.setDealApplyNum(apply.getApplyNum());\n        dealDto.setDueDate(date);\n        dealDto.setRate(rate);\n        dealDto.setEffectiveDate(deal.getEffectiveDate());\n        // 生成支付本金的结算金额等于追加申购金额\n        dealDto.setSettlementAmount(attribute1);\n        dealEventCashUtil.createPurchase4(dealDto, null, null);\n\n        // 更新本金收回事件\n        if (!CollectionUtils.isEmpty(eventList)) {\n            Date finalAddEffectiveDate = addEffectiveDate;\n            Date finalDate = date;\n            eventList.forEach(e -> {\n                if (StringUtils.equals(e.getEventType(), LoanConstants.EVENT_TYPE_SHBJ)\n                        && StringUtils.equals(e.getEventTypeSub(), DealTypeConstants.EVENT_TYPE_SUB_ORIGIN)) {\n                    e.setSettlementAmount(remain);\n                    e.setPrincipalBalance(remain);\n                    e.setLastUpdateDate(new Date());\n                    e.setEffectiveDate(finalAddEffectiveDate);\n                    e.setSettlementDate(finalDate);\n                    dealEventDAO.updateByPrimaryKeySelective(e);\n\n                    // 更新资金流\n                    TmsDealCashFlow cashFlow = new TmsDealCashFlow();\n                    cashFlow.setEventId(e.getEventId());\n                    cashFlow.setAmount(remain);\n                    cashFlow.setSettlementDate(finalDate);\n                    cashFlow.setLastUpdateDate(new Date());\n\n                    TmsDealCashFlowExample cashFlowExample = new TmsDealCashFlowExample();\n                    TmsDealCashFlowExample.Criteria cashFlowCriteria = cashFlowExample.createCriteria();\n                    cashFlowCriteria.andEventIdEqualTo(e.getEventId()).andDealIdEqualTo(e.getDealId());\n                    cashFlowDAO.updateByExampleSelective(cashFlow, cashFlowExample);\n                }\n            });\n        }\n        TmsDeal update = new TmsDeal();\n        update.setDealId(deal.getDealId());\n        update.setLastUpdateDate(new Date());\n        // 追加申购利率处理\n        update.setRate(new BigDecimal(apply.getAttribute2()));\n        update.setBalance(new BigDecimal(apply.getAttribute5()));\n        update.setDueDate(DateUtils.parseDate(apply.getAttribute3()));\n        update.setDealStatus(DealCommonEnum.STATUS_COMPLETED.getCode());\n\n        // 更新本金为 原本金+追加本金\n        BigDecimal principal = deal.getAmount().add(new BigDecimal(deal.getAttribute1()));\n        update.setAmount(principal);\n        dealDAO.updateByPrimaryKeySelective(update);\n    }\n\n    /**\n     * 计算利率\n     *\n     * @param amount    基础金额\n     * @param interest  利息\n     * @param days      利息天数\n     * @param dayOfYear 年天数\n     */\n    public BigDecimal calculateRate(BigDecimal amount, BigDecimal interest, BigDecimal days, Integer dayOfYear) {\n        return interest.multiply(new BigDecimal(100))\n                .multiply(new BigDecimal(dayOfYear))\n                .divide(days, 2, RoundingMode.HALF_UP)\n                .divide(amount, 2, RoundingMode.HALF_UP);\n    }\n\n}\n",
                "content": "package com.baidu.tms.deal.service.impl;\n\nimport com.alibaba.fastjson.JSON;\nimport com.baidu.p2p.commons.constants.BizConstants;\nimport com.baidu.p2p.commons.constants.CommonEnums;\nimport com.baidu.p2p.core.j2ee.exception.WebException;\nimport com.baidu.p2p.core.utils.DateUtils;\nimport com.baidu.p2p.core.utils.StringUtils;\nimport com.baidu.p2p.fnd.api.FndFlexValueApi;\nimport com.baidu.p2p.pay.facade.dto.CodedLabel;\nimport com.baidu.p2p.system.web.session.SessionUtils;\nimport com.baidu.tms.common.dao.CommonAttachmentDAO;\nimport com.baidu.tms.commons.dto.TransactionEventStatusEnum;\nimport com.baidu.tms.companyloan.dto.PrepayApplyQuery;\nimport com.baidu.tms.deal.common.constants.DealSelectTypeConstants;\nimport com.baidu.tms.deal.common.constants.DealTypeConstants;\nimport com.baidu.tms.deal.common.enums.DealCommonEnum;\nimport com.baidu.tms.deal.dao.DealApplyDao;\nimport com.baidu.tms.deal.dto.DealApplyDto;\nimport com.baidu.tms.deal.dto.DealCashFlowDto;\nimport com.baidu.tms.deal.dto.DealDto;\nimport com.baidu.tms.deal.dto.DealEventDto;\nimport com.baidu.tms.deal.dto.DealQueryDto;\nimport com.baidu.tms.deal.dto.TmsMoneyMarketActionBarEnum;\nimport com.baidu.tms.deal.service.InvestmentCommonService;\nimport com.baidu.tms.deal.service.TmsMoneyMarketService;\nimport com.baidu.tms.deal.util.DealEventCashUtil;\nimport com.baidu.tms.loan.domain.LoanCompanyRuleQuery;\nimport com.baidu.tms.loan.util.LoanConstants;\nimport com.baidu.tms.persistent.deal.dao.TmsDealApplyDAO;\nimport com.baidu.tms.persistent.deal.dao.TmsDealApplyHisDAO;\nimport com.baidu.tms.persistent.deal.dao.TmsDealCashFlowDAO;\nimport com.baidu.tms.persistent.deal.dao.TmsDealDAO;\nimport com.baidu.tms.persistent.deal.dao.TmsDealEventDAO;\nimport com.baidu.tms.persistent.deal.domain.TmsDeal;\nimport com.baidu.tms.persistent.deal.domain.TmsDealApply;\nimport com.baidu.tms.persistent.deal.domain.TmsDealApplyHis;\nimport com.baidu.tms.persistent.deal.domain.TmsDealCashFlow;\nimport com.baidu.tms.persistent.deal.domain.TmsDealCashFlowExample;\nimport com.baidu.tms.persistent.deal.domain.TmsDealEvent;\nimport com.baidu.tms.persistent.deal.domain.TmsDealEventExample;\nimport com.baidu.tms.persistent.deal.domain.TmsDealExample;\nimport com.baidu.tms.persistent.loan.dao.TmsFinancialProductDAO;\nimport com.baidu.tms.persistent.transaction.dao.TmsTransactionTypeDAO;\nimport com.baidu.tms.persistent.transaction.domain.TmsTransactionType;\nimport com.baidu.tms.persistent.transaction.domain.TmsTransactionTypeExample;\nimport com.github.pagehelper.PageInfo;\nimport lombok.extern.slf4j.Slf4j;\nimport org.springframework.beans.BeanUtils;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\nimport org.springframework.transaction.annotation.Transactional;\nimport org.springframework.util.CollectionUtils;\n\nimport java.math.BigDecimal;\nimport java.math.RoundingMode;\nimport java.util.ArrayList;\nimport java.util.Arrays;\nimport java.util.Comparator;\nimport java.util.Date;\nimport java.util.HashMap;\nimport java.util.List;\nimport java.util.Map;\nimport java.util.Objects;\nimport java.util.stream.Collectors;\n\nimport static com.baidu.tms.deal.common.constants.DealTypeConstants.DEAL_APPLY_TYPE_PURCHASE1;\nimport static com.baidu.tms.deal.common.constants.DealTypeConstants.DEAL_APPLY_TYPE_PURCHASE2;\nimport static com.baidu.tms.deal.common.constants.DealTypeConstants.DEAL_APPLY_TYPE_PURCHASE4;\nimport static com.baidu.tms.deal.common.constants.DealTypeConstants.DEAL_APPLY_TYPE_REDEEM;\n\n/**\n * 活期理财--货币市场基金\n *\n * @author liuyanzhong\n * @date 2024/5/22\n */\n@Service\n@Slf4j\npublic class TmsMoneyMarketServiceImpl implements TmsMoneyMarketService {\n\n    @Autowired\n    private TmsDealDAO dealDAO;\n\n    @Autowired\n    private TmsDealEventDAO dealEventDAO;\n\n    @Autowired\n    private TmsDealCashFlowDAO cashFlowDAO;\n\n    @Autowired\n    private TmsFinancialProductDAO productDAO;\n\n    @Autowired\n    private FndFlexValueApi flexValueApi;\n\n    @Autowired\n    private InvestmentCommonService investmentCommonService;\n\n    @Autowired\n    private TmsDealApplyDAO tmsDealApplyDAO;\n\n    @Autowired\n    private TmsDealApplyHisDAO tmsDealApplyHisDAO;\n\n    @Autowired\n    private DealApplyDao dealApplyDao;\n\n    @Autowired\n    private DealEventCashUtil dealEventCashUtil;\n\n    @Autowired\n    private CommonAttachmentDAO attachmentDAO;\n\n    @Autowired\n    private TmsTransactionTypeDAO tmsTransactionTypeDAO;\n\n    /**\n     * 一年天数\n     */\n    public static final int DAYS_360 = 360;\n    public static final int DAYS_365 = 365;\n\n\n    @Override\n    public Map<String, Object> getSelectInit() {\n        Map<String, Object> dic = new HashMap<>();\n\n        // 理财产品\n        dic.put(\"productList\", investmentCommonService.getProductList(false,\n                DealCommonEnum.CURRENT_FINANCIAL_CATEGORY.getCode()));\n        // 所属银行\n        dic.put(\"bankList\", investmentCommonService.getBankList(new LoanCompanyRuleQuery()));\n        // 币种\n        dic.put(\"currencyList\",\n                investmentCommonService.getFndFlexSetSelectDTOs(BizConstants.FndFlexSet.TMS_CURRENCY, false));\n        // 状态\n        dic.put(\"statusList\",\n                investmentCommonService\n                        .getFndFlexSetSelectDTOs(BizConstants.FndFlexSet.TMS_DEAL_STATUS, false));\n        return dic;\n    }\n\n    @Override\n    public PageInfo<DealDto> selectMoneyMarketPage(DealQueryDto dealQueryDto) {\n        dealQueryDto.setDealCategory(DealTypeConstants.DEAL_TYPE_MONEYMARKET);\n        PageInfo<DealDto> dtoPageInfo = investmentCommonService.selectInvestment(dealQueryDto);\n        List<DealDto> dtoList = dtoPageInfo.getList();\n\n        // 当前余额\n        getCurrentPrincipal(dtoList);\n        // 操作栏可操作类型\n        this.addActionBar(dtoList);\n        return dtoPageInfo;\n    }\n\n    /**\n     * 余额取值优化\n     *\n     * @param dtoList\n     * @return\n     */\n    public void getCurrentPrincipal(List<DealDto> dtoList) {\n        if (CollectionUtils.isEmpty(dtoList)) {\n            return;\n        }\n        List<Long> dealIdList = dtoList.stream().map(DealDto::getDealId).collect(Collectors.toList());\n        Date date = new Date();\n        TmsDealEventExample eventExample = new TmsDealEventExample();\n        TmsDealEventExample.Criteria eventCriteria = eventExample.createCriteria();\n        eventCriteria.andDealIdIn(dealIdList);\n        eventCriteria.andEffectiveDateLessThanOrEqualTo(date);\n        eventExample.setOrderByClause(\"effective_date desc, event_order desc, event_id desc\");\n        List<TmsDealEvent> eventList = dealEventDAO.selectByExample(eventExample);\n        for (DealDto dto : dtoList) {\n            List<TmsDealEvent> temp = eventList.stream().filter(o -> Objects.equals(o.getDealId(), dto.getDealId()))\n                    .collect(Collectors.toList());\n            if (!CollectionUtils.isEmpty(temp)) {\n                dto.setCurrentBalance(temp.get(0).getPrincipalRemained());\n            }\n        }\n    }\n\n    /**\n     * 根据状态生成操作栏可操作类型\n     *\n     * @param dtoList\n     */\n    public void addActionBar(List<DealDto> dtoList) {\n        if (CollectionUtils.isEmpty(dtoList)) {\n            return;\n        }\n        dtoList.forEach(o -> {\n            List<String> actions = new ArrayList<>();\n            if (DealCommonEnum.STATUS_SAVED.getCode().equals(o.getDealStatus())) {\n                actions.add(TmsMoneyMarketActionBarEnum.EDIT.getCode());\n                actions.add(TmsMoneyMarketActionBarEnum.DELETE.getCode());\n            } else if (DealCommonEnum.STATUS_CONFIRM.getCode().equals(o.getDealStatus())) {\n                actions.add(TmsMoneyMarketActionBarEnum.WITHDRAW.getCode());\n            } else if (DealCommonEnum.STATUS_CONFIRMED.getCode().equals(o.getDealStatus())) {\n//                actions.add(TmsMoneyMarketActionBarEnum.ALTER.getCode());\n                actions.add(TmsMoneyMarketActionBarEnum.RENEW.getCode());\n                actions.add(TmsMoneyMarketActionBarEnum.REDEEM.getCode());\n                actions.add(TmsMoneyMarketActionBarEnum.REINVESTMENT.getCode());\n                actions.add(TmsMoneyMarketActionBarEnum.CASH.getCode());\n            }\n            o.setActionBarList(actions);\n        });\n    }\n\n    @Override\n    public Map<String, Object> getEditSelectInit() {\n        Map<String, Object> dic = new HashMap<>();\n        // 交易类型\n        dic.put(\"dealTypeList\",\n                investmentCommonService.getDealTypeList(DealTypeConstants.DEAL_TYPE_MONEYMARKET, true, true));\n        // 理财产品\n        dic.put(\"productList\", investmentCommonService.getProductList(true,\n                DealCommonEnum.CURRENT_FINANCIAL_CATEGORY.getCode()));\n        // 币种\n        dic.put(\"currencyList\",\n                investmentCommonService.getFndFlexSetSelectDTOs(BizConstants.FndFlexSet.TMS_CURRENCY, true));\n        // 利率类型\n        dic.put(\"rateTypeList\", this.getRateTypeList());\n        // 付息频率\n        dic.put(\"frequency\",\n                investmentCommonService.getFndFlexSetSelectDTOs(BizConstants.FndFlexSet.TMS_Deal_Frequency, true));\n        // 计息方式\n        dic.put(\"interestMethod\",\n                investmentCommonService.getFndLookupSelectDTOs(BizConstants.FndFlexSet.TMS_DEAL_IR_MODE, true));\n        // 假期日历\n        dic.put(\"holidayCode\",\n                investmentCommonService.getFndFlexSetSelectDTOs(BizConstants.FndFlexSet.TMS_Holiday_Code, true));\n        // 假期规则\n        dic.put(\"holidayRules\",\n                investmentCommonService.getFndFlexSetSelectDTOs(BizConstants.FndFlexSet.TMS_DEAL_HOLIDAY_RULE, true));\n        // 分红方式\n        dic.put(\"interestDist\",\n                investmentCommonService.getFndFlexSetSelectDTOs(BizConstants.FndFlexSet.TMS_INTEREST_DIST, true));\n        return dic;\n    }\n\n    /**\n     * 利率类型 写死的\n     */\n    private List<CodedLabel> getRateTypeList() {\n        List<CodedLabel> list = new ArrayList<>();\n        list.add(new CodedLabel(DealCommonEnum.FLOATING_RATE.getCode(), DealCommonEnum.FLOATING_RATE.getName()));\n        return list;\n    }\n\n    @Override\n    public String saveOrUpdate(DealDto dealDto) {\n        if (dealDto.getDueDate() == null) {\n            dealDto.setDueDate(DateUtils.addDays(DateUtils.getCurrentDateOfZero(), 1));\n        }\n        dealDto.setDealCategory(DealTypeConstants.DEAL_TYPE_MONEYMARKET);\n        this.checkAddParam(dealDto);\n//        if (dealDto.getDueDate().compareTo(DateUtils.getCurrentDateOfZero()) <= 0) {\n//            throw new WebException(\"到期日不能在今天及之前,建议到期日期填写为明天\");\n//        }\n\n        dealDto.setRate(dealDto.getExpectedAnnualRate());\n        dealDto.setBalance(dealDto.getAmount());\n        return investmentCommonService.saveOrUpdateDeal(dealDto, false);\n    }\n\n    /**\n     * 校验入参\n     */\n    private void checkAddParam(DealDto dealDto) {\n        DealEventCashUtil.commonDealCheck(dealDto);\n        if (StringUtils.isBlank(dealDto.getProductCode())) {\n            throw new WebException(\"理财产品不能为空\");\n        }\n        if (StringUtils.isBlank(dealDto.getDealType())) {\n            throw new WebException(\"交易类型不能为空\");\n        }\n        if (dealDto.getEffectiveDate() == null) {\n            throw new WebException(\"生效日期不能为空\");\n        }\n        if (dealDto.getDueDate() == null) {\n            throw new WebException(\"到期日期不能为空\");\n        }\n    }\n\n    @Override\n    @Transactional(rollbackFor = Exception.class)\n    public void addDealApplyApproved(PrepayApplyQuery req) {\n        log.info(\"addDealApplyApproved: {}\", JSON.toJSONString(req));\n\n        DealApplyDto apply = dealApplyDao.selectByPrimaryKey(req.getApplyId());\n        if (apply == null) {\n            log.error(\"资金货币新增申请不存在, applyId: {}\", req.getApplyId());\n            throw new WebException(\"资金货币新增申请不存在\");\n        }\n        if (ifApplyRepeat(apply.getApplyNum(), 0)) {\n            log.error(\"资金货币新增申请已经生成, applyId: {}\", req.getApplyId());\n            throw new WebException(\"该申请已经生成，不可重复\");\n        }\n        if (!StringUtils.equals(DEAL_APPLY_TYPE_PURCHASE1, apply.getBusinessType())) {\n            log.error(\"资金货币新增申请类型不对应, applyId: {}\", req.getApplyId());\n            throw new WebException(\"该申请类型不对应\");\n        }\n        DealDto dealDto = transformApplyToDeal(apply);\n        String dealId = this.saveOrUpdate(dealDto);\n        // 提交\n        DealDto submitDTO = new DealDto();\n        submitDTO.setDealId(Long.parseLong(dealId));\n        investmentCommonService.submitDealEvent(submitDTO);\n        // 回写dealId\n        TmsDealApply tmsDealApply = new TmsDealApply();\n        tmsDealApply.setApplyId(req.getApplyId());\n        tmsDealApply.setDealId(Long.parseLong(dealId));\n        tmsDealApplyDAO.updateByPrimaryKeySelective(tmsDealApply);\n    }\n\n    private boolean ifApplyRepeat(String applyNum, int level) {\n        boolean flag = false;\n        if (level == 0) {\n            TmsDealExample example = new TmsDealExample();\n            example.createCriteria().andDealNumEqualTo(applyNum);\n            List<TmsDeal> list = dealDAO.selectByExample(example);\n            if (!CollectionUtils.isEmpty(list)) {\n                flag = true;\n            }\n        } else if (level == 1) {\n            TmsDealEventExample example = new TmsDealEventExample();\n            example.createCriteria().andDealApplyNumEqualTo(applyNum);\n            List<TmsDealEvent> list = dealEventDAO.selectByExample(example);\n            if (!CollectionUtils.isEmpty(list)) {\n                flag = true;\n            }\n        }\n        return flag;\n    }\n\n    @Override\n    @Transactional(rollbackFor = Exception.class)\n    public void purchase2DealApplyApproved(PrepayApplyQuery req) {\n        log.info(\"purchase2DealApplyApproved: {}\", JSON.toJSONString(req));\n        if (req.getApplyId() == null) {\n         