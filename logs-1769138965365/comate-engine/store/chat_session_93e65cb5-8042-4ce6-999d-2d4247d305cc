                "beforeChangeFileContent": "package com.baidu.pmc.core.service.impl;\n\nimport com.baidu.pmc.common.component.PmcPortalLogin;\nimport com.baidu.pmc.common.exception.ServiceException;\nimport com.baidu.pmc.common.utils.BeanUtils;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.core.fnd.service.FndFlexValueApi;\nimport com.baidu.pmc.core.service.OperateByJDBC;\nimport com.baidu.pmc.core.service.PmcPortalFinancingService;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcAccountMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcDataP2pSupplierMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcFinanceCompQuotaSetMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcFinanceSupplierApplyMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcPayChecksMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcFinanceSupplierApplyHisMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcFinanceSupplierQuotaSetMapper;\nimport com.baidu.pmc.pojo.constants.Constants;\nimport com.baidu.pmc.pojo.constants.FinancingStatus;\nimport com.baidu.pmc.pojo.constants.PayStatus;\nimport com.baidu.pmc.pojo.constants.SupplierFinancingApplyStatus;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyHisDTO;\nimport com.baidu.pmc.pojo.dto.PmcPayChecksSupplierCodeDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceCompQuotaSetDTO;\nimport com.baidu.pmc.pojo.dto.fnd.CodeDesc;\nimport com.baidu.pmc.pojo.dto.fnd.FndFlexValueDTO;\nimport com.baidu.pmc.pojo.dto.fnd.SuggestParameter;\nimport com.baidu.pmc.pojo.model.PmcDataP2pSupplier;\nimport com.baidu.pmc.pojo.model.PmcFinanceSupplierApply;\nimport com.baidu.pmc.pojo.model.PmcFinanceSupplierApplyHis;\nimport com.baidu.pmc.pojo.model.PmcPayChecks;\nimport com.baidu.pmc.pojo.qo.PayChecksQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceCompQuotaSetQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceSupplierApplyQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceSupplierQuotaSetQO;\nimport com.baidu.pmc.pojo.model.PmcFinanceSupplierQuotaSet;\nimport com.baidu.pmc.pojo.model.PmcFinanceCompQuotaSet;\nimport com.github.pagehelper.PageHelper;\nimport com.github.pagehelper.PageInfo;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections.CollectionUtils;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\nimport tk.mybatis.mapper.entity.Example;\n\nimport java.util.Arrays;\nimport java.util.Date;\nimport java.util.List;\nimport java.util.Map;\n\nimport java.util.HashMap;\n\nimport java.util.stream.Collectors;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.BANK;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.BD_COMPANY;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.CURRENCY;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.BANK_FINANCING_RATES;\n\n@Slf4j\n@Service\npublic class PmcPortalFinancingServiceImpl implements PmcPortalFinancingService {\n\n\n    @Autowired\n    private PmcFinanceSupplierApplyMapper pmcFinanceSupplierApplyMapper;\n\n    @Autowired\n    private PmcDataP2pSupplierMapper pmcDataP2pSupplierMapper;\n\n    @Autowired\n    private PmcPayChecksMapper pmcPayChecksMapper;\n\n    @Autowired\n    private PmcFinanceSupplierApplyHisMapper pmcFinanceSupplierApplyHisMapper;\n\n    @Autowired\n    private PmcFinanceSupplierQuotaSetMapper pmcFinanceSupplierQuotaSetMapper;\n\n    @Autowired\n    private PmcFinanceCompQuotaSetMapper pmcFinanceCompQuotaSetMapper;\n\n    @Autowired\n    private OperateByJDBC operateByJDBC;\n\n    @Autowired\n    private PmcAccountMapper accountMapper;\n\n    @Autowired\n    FndFlexValueApi fndFlexValueApi;\n\n\n    @Override\n    public PageInfo<PmcFinanceSupplierApplyDTO> findByConditionSupplierCode(PmcFinanceSupplierApplyQO pmcFinanceSupplierApplyQO) {\n\n        PmcDataP2pSupplier pmcDataP2pSupplier = pmcDataP2pSupplierMapper.selectBySupplierCode(PmcPortalLogin.getSupId());\n        if (pmcDataP2pSupplier == null) {\n            throw new SecurityException(\"供应商信息不存在!\");\n        }\n        pmcFinanceSupplierApplyQO.setSupplierCode(pmcDataP2pSupplier.getSupplierCode());\n\n        // 判断是否分页\n        if (pmcFinanceSupplierApplyQO.getPageNum() > 0\n                && pmcFinanceSupplierApplyQO.getPageSize() > 0) {\n            PageHelper.startPage(\n                    pmcFinanceSupplierApplyQO.getPageNum(),\n                    pmcFinanceSupplierApplyQO.getPageSize()\n            );\n        }\n        List<PmcFinanceSupplierApplyDTO> list = getListBySupplierCode(pmcFinanceSupplierApplyQO);\n        return new PageInfo<>(list);\n    }\n\n    @Override\n    public List<PmcFinanceSupplierApplyDTO> export(PmcFinanceSupplierApplyQO pmcFinanceSupplierApplyQO) {\n        PmcDataP2pSupplier pmcDataP2pSupplier = pmcDataP2pSupplierMapper.selectBySupplierCode(PmcPortalLogin.getSupId());\n        if (pmcDataP2pSupplier == null) {\n            throw new SecurityException(\"供应商信息不存在!\");\n        }\n        pmcFinanceSupplierApplyQO.setSupplierCode(pmcDataP2pSupplier.getSupplierCode());\n        return getListBySupplierCode(pmcFinanceSupplierApplyQO);\n    }\n\n\n    private List<PmcFinanceSupplierApplyDTO> getListBySupplierCode(PmcFinanceSupplierApplyQO qo) {\n        return pmcFinanceSupplierApplyMapper.selectApplyListBySupplierCode(qo).stream()\n                .map(his -> {\n                    PmcFinanceSupplierApplyDTO dto = new PmcFinanceSupplierApplyDTO();\n                    BeanUtils.copyProperties(his, dto);\n                    // 设置额外字段\n                    dto.setBankName(operateByJDBC.translate(BANK, StringUtils.toString(dto.getBankCode())));\n                    dto.setStatusDesc(SupplierFinancingApplyStatus.getDescription(dto.getStatus()));\n                    dto.setCurrencyName(operateByJDBC.translate(CURRENCY, dto.getCurrency()));\n                    return dto;\n                }).collect(Collectors.toList());\n    }\n\n\n    @Override\n    public PageInfo<PmcFinanceSupplierApplyHisDTO> queryFinancingApplyHis(PmcFinanceSupplierApplyQO query) {\n        if (query.getApplyNumber() == null) {\n            throw new IllegalArgumentException(\"申请单号不能为空\");\n        }\n        // 判断是否分页\n        if (query.getPageNum() > 0 && query.getPageSize() > 0) {\n            PageHelper.startPage(query.getPageNum(), query.getPageSize());\n        }\n\n        List<PmcFinanceSupplierApplyHis> hisList = pmcFinanceSupplierApplyHisMapper.selectByApplyNumber(query.getApplyNumber());\n\n        List<PmcFinanceSupplierApplyHisDTO> dtoList = hisList.stream().map(his -> {\n            PmcFinanceSupplierApplyHisDTO dto = new PmcFinanceSupplierApplyHisDTO();\n            BeanUtils.copyProperties(his, dto);\n            return dto;\n        }).collect(Collectors.toList());\n\n        return new PageInfo<>(dtoList);\n    }\n\n    @Override\n    public PageInfo<PmcFinanceSupplierApplyDTO> findByConditionAll(PmcFinanceSupplierApplyQO pmcFinanceSupplierApplyQO) {\n        // 判断是否分页\n        if (pmcFinanceSupplierApplyQO.getPageNum() > 0\n                && pmcFinanceSupplierApplyQO.getPageSize() > 0) {\n            PageHelper.startPage(\n                    pmcFinanceSupplierApplyQO.getPageNum(),\n                    pmcFinanceSupplierApplyQO.getPageSize()\n            );\n        }\n        List<PmcFinanceSupplierApplyDTO> list =\n                pmcFinanceSupplierApplyMapper.selectApplyListByAll(pmcFinanceSupplierApplyQO);\n        List<PmcFinanceSupplierApplyDTO> dtoList = list.stream()\n                .map(his -> {\n                    PmcFinanceSupplierApplyDTO dto = new PmcFinanceSupplierApplyDTO();\n                    BeanUtils.copyProperties(his, dto);\n                    // 设置额外字段\n                    dto.setBankName(operateByJDBC.translate(BANK, StringUtils.toString(dto.getBankCode())));\n                    dto.setStatusDesc(SupplierFinancingApplyStatus.getDescription(dto.getStatus()));\n                    dto.setCurrencyName(operateByJDBC.translate(CURRENCY, dto.getCurrency()));\n                    return dto;\n                }).collect(Collectors.toList());\n        return new PageInfo<>(dtoList);\n    }\n\n    @Override\n    public PageInfo<PmcPayChecksSupplierCodeDTO> getPayCheckList() {\n        PmcDataP2pSupplier pmcDataP2pSupplier = pmcDataP2pSupplierMapper.selectBySupplierCode(PmcPortalLogin.getSupId());\n        if (pmcDataP2pSupplier == null) {\n            throw new SecurityException(\"供应商信息不存在!\");\n        }\n        // 准备查询参数\n        List<String> statusList = Arrays.asList(PayStatus.APPROVED.name(), PayStatus.RELEASED.name());\n        Date currentDatePlus3Days = DateUtils.addDays(new Date(), 7);\n        // todo 这里暂时用供应商编码查询关联pmc_pay_checks.attribute15，后续方案调整再同步修改\n        List<PmcPayChecksSupplierCodeDTO> resultList = pmcPayChecksMapper.\n                selectBySupplierCode(pmcDataP2pSupplier.getSupplierCode(), currentDatePlus3Days, statusList);\n\n        resultList = resultList.stream()\n                .map(dto -> {\n                    // 创建新的DTO对象\n                    PmcPayChecksSupplierCodeDTO newDto = new PmcPayChecksSupplierCodeDTO();\n                    // 复制原DTO的属性\n                    BeanUtils.copyProperties(dto, newDto);\n\n                    // 设置属性\n                    newDto.setSupplierCode(pmcDataP2pSupplier.getSupplierCode());\n                    newDto.setSupplierName(pmcDataP2pSupplier.getSupplierName());\n\n                    // 计算融资天数\n                    newDto.setFinanceDays(DateUtils.daysBetween(DateUtils.getCurrentDate(), dto.getPayPlanDate()));\n                    return newDto;\n                })\n                .collect(Collectors.toList());\n\n        return new PageInfo<>(resultList);\n    }\n\n\n    @Override\n    public Map<String, Object> getFinancingApplyDetail(PmcFinanceSupplierApplyQO query) {\n        // 参数校验\n        if (query == null || StringUtils.isBlank(query.getApplyNumber())) {\n            throw new IllegalArgumentException(\"申请单号不能为空\");\n        }\n\n        // 查询申请明细\n        PmcFinanceSupplierApply apply = pmcFinanceSupplierApplyMapper.selectByApplyNumber(query.getApplyNumber());\n        if (apply == null) {\n            throw new IllegalArgumentException(\"未找到对应的融资申请单\");\n        }\n        PmcFinanceSupplierApplyDTO applyDTO = new PmcFinanceSupplierApplyDTO();\n        BeanUtils.copyProperties(apply, applyDTO);\n        applyDTO.setBankName(operateByJDBC.translate(BANK, StringUtils.toString(applyDTO.getBankCode())));\n        applyDTO.setStatusDesc(SupplierFinancingApplyStatus.getDescription(applyDTO.getStatus()));\n        applyDTO.setCurrencyName(operateByJDBC.translate(CURRENCY, applyDTO.getCurrency()));\n\n\n        // 查询单据状态历史记录\n        List<PmcFinanceSupplierApplyHis> hisList = pmcFinanceSupplierApplyHisMapper.selectByApplyNumber(query.getApplyNumber());\n        List<PmcFinanceSupplierApplyHisDTO> hisDtoList = hisList.stream().map(his -> {\n            PmcFinanceSupplierApplyHisDTO dto = new PmcFinanceSupplierApplyHisDTO();\n            BeanUtils.copyProperties(his, dto);\n            return dto;\n        }).collect(Collectors.toList());\n\n        // 查询付款单信息\n        PayChecksQO payChecksQO = new PayChecksQO();\n        payChecksQO.setPayCheckNum(query.getPayCheckNum());\n        PmcPayChecksSupplierCodeDTO payChecksSupplierCodeDTO = selectPmcPayCheckByPayCheckNum(payChecksQO);\n\n        // 构建返回结果\n        Map<String, Object> resultMap = new HashMap<>();\n        resultMap.put(\"applyDetail\", apply);\n        resultMap.put(\"historyList\", hisDtoList);\n        resultMap.put(\"payChecksSupplierCodeDTO\", payChecksSupplierCodeDTO);\n        return resultMap;\n    }\n\n    @Override\n    public Long saveOrUpdateFinancingApply(PmcFinanceSupplierApplyDTO pmcFinanceSupplierApplyDto) {\n        PmcFinanceSupplierApply pmcFinanceSupplierApply = new PmcFinanceSupplierApply();\n        BeanUtils.copyProperties(pmcFinanceSupplierApplyDto, pmcFinanceSupplierApply);\n        // 创建融资申请单\n        if (pmcFinanceSupplierApply == null) {\n            log.error(\"融资申请单参数为空\");\n            throw new IllegalArgumentException(\"融资申请单不能为空\");\n        }\n        if (pmcFinanceSupplierApply.getSupplierCode() == null) {\n            PmcDataP2pSupplier pmcDataP2pSupplier = pmcDataP2pSupplierMapper.selectBySupplierCode(PmcPortalLogin.getSupId());\n            if (pmcDataP2pSupplier == null) {\n                throw new SecurityException(\"供应商信息不存在!\");\n            }\n            pmcFinanceSupplierApply.setSupplierCode(pmcDataP2pSupplier.getSupplierCode());\n        }\n\n        if (StringUtils.isBlank(pmcFinanceSupplierApply.getApplyNumber())) {\n            throw new SecurityException(\"融资申请单号不能为空!\");\n        }\n        if (StringUtils.isBlank(pmcFinanceSupplierApply.getSourceNum())) {\n            throw new SecurityException(\"原始单据号不能为空!\");\n        }\n        if (StringUtils.isBlank(pmcFinanceSupplierApply.getPayCheckNum())) {\n            throw new SecurityException(\"付款单号不能为空!\");\n        }\n\n        if (pmcFinanceSupplierApplyMapper.selectCount(pmcFinanceSupplierApply) > 0) {\n            if (pmcFinanceSupplierApply.getLastUpdateDate() == null) {\n                pmcFinanceSupplierApply.setLastUpdateDate(new Date());\n            }\n            pmcFinanceSupplierApplyMapper.updateByPrimaryKeySelective(pmcFinanceSupplierApply);\n        } else {\n            // 设置操作人和时间\n            if (StringUtils.isBlank(pmcFinanceSupplierApply.getCreateBy())) {\n                pmcFinanceSupplierApply.setCreateBy(PmcPortalLogin.getLoginAccount());\n            }\n            pmcFinanceSupplierApply.setCreateDate(new Date());\n            pmcFinanceSupplierApply.setLastUpdateBy(pmcFinanceSupplierApply.getCreateBy());\n            pmcFinanceSupplierApply.setLastUpdateDate(new Date());\n            if (StringUtils.isBlank(pmcFinanceSupplierApply.getApplySubmit())) {\n                pmcFinanceSupplierApply.setApplySubmit(pmcFinanceSupplierApply.getCreateBy());\n            }\n            if (StringUtils.isBlank(pmcFinanceSupplierApply.getStatus())) {\n                pmcFinanceSupplierApply.setStatus(SupplierFinancingApplyStatus.SAVED.name());\n            }\n            pmcFinanceSupplierApplyMapper.insert(pmcFinanceSupplierApply);\n            log.info(\"成功创建融资申请单，申请单号: {},付款单号:{}\", pmcFinanceSupplierApply.getApplyNumber(), pmcFinanceSupplierApply.getPayCheckNum());\n        }\n\n        PmcFinanceSupplierApplyHis his = new PmcFinanceSupplierApplyHis();\n        BeanUtils.copyProperties(pmcFinanceSupplierApplyDto, his);\n        // 操作人 供应商或者银行\n        his.setCreateDate(new Date());\n        his.setLastUpdateDate(new Date());\n        // SUBMITTED:提交申请\n        // BANK_CONFIRMED:网银确认\n        // BANK_REVIEWING:银行审核\n        // BANK_FUNDED:银行放款\n        if (!StringUtils.isBlank(his.getOperationNode()) && FinancingStatus.getNextStatus(his.getOperationNode()) != null) {\n            // 设置下一个操作步骤\n            his.setAttribute1(FinancingStatus.getNextStatus(his.getOperationNode()).getDescription());\n        }\n        pmcFinanceSupplierApplyHisMapper.insert(his);\n        log.info(\"成功创建融资申请历史记录，申请单号: {} ,付款单号:{}\", his.getApplyNumber(), his.getPayCheckNum());\n\n        return pmcFinanceSupplierApply.getApplyId();\n    }\n\n    /**\n    *  根据付款单号查询对应的付款数据\n    * */\n    @Override\n    public PmcPayChecksSupplierCodeDTO selectPmcPayCheckByPayCheckNum(PayChecksQO payChecksQO) {\n        // 1. 参数校验\n        if (payChecksQO == null || StringUtils.isBlank(payChecksQO.getPayCheckNum())) {\n            throw new IllegalArgumentException(\"付款单号不能为空\");\n        }\n\n        // 2. 查询支付记录\n        Example example = new Example(PmcPayChecks.class);\n        example.createCriteria().andEqualTo(\"payCheckNum\", payChecksQO.getPayCheckNum());\n        PmcPayChecks pmcPayCheck = pmcPayChecksMapper.selectOneByExample(example);\n\n        PmcPayChecksSupplierCodeDTO dto = new PmcPayChecksSupplierCodeDTO();\n        if (pmcPayCheck == null) {\n            return dto;  // 返回空DTO\n        }\n\n        // 3. 属性拷贝\n        BeanUtils.copyProperties(pmcPayCheck, dto);\n\n        // 4. 计算日期差\n        if (dto.getPayPlanDate() != null) {\n            dto.setFinanceDays(DateUtils.daysBetween(DateUtils.getCurrentDate(), dto.getPayPlanDate()));\n        }\n\n        // 5. 补全供应商信息\n        if (StringUtils.isBlank(dto.getSupplierCode())) {\n            String supId = PmcPortalLogin.getSupId();\n            PmcDataP2pSupplier supplier = pmcDataP2pSupplierMapper.selectBySupplierCode(supId);\n            if (supplier == null) {\n                throw new ServiceException(\"供应商信息不存在: supId=\" + supId);\n            }\n            dto.setSupplierCode(supplier.getSupplierCode());\n            dto.setSupplierName(supplier.getSupplierName());\n        }\n\n        return dto;\n    }\n\n    @Override\n    public PageInfo<PmcFinanceCompQuotaSetDTO> selectQuotaSet(PmcFinanceCompQuotaSetQO query) {\n        // 判断是否分页\n        if (query.getPageNum() > 0\n                && query.getPageSize() > 0) {\n            PageHelper.startPage(\n                    query.getPageNum(),\n                    query.getPageSize()\n            );\n        }\n        return new PageInfo<>(getQuotaSetList(query));\n    }\n\n    @Override\n    public List<PmcFinanceCompQuotaSetDTO> exportQuotaSet(PmcFinanceCompQuotaSetQO query) {\n        return getQuotaSetList(query);\n    }\n\n    @Override\n    public Long saveOrUpdateCompQuotaSet(PmcFinanceCompQuotaSetDTO dto) {\n        PmcFinanceCompQuotaSet pmcFinanceCompQuotaSet = new PmcFinanceCompQuotaSet();\n        BeanUtils.copyProperties(dto, pmcFinanceCompQuotaSet);\n        // 插入数据\n        if (pmcFinanceCompQuotaSetMapper.selectCount(pmcFinanceCompQuotaSet) > 0) {\n            pmcFinanceCompQuotaSet.setLastUpdateDate(new Date());\n            pmcFinanceCompQuotaSetMapper.updateByPrimaryKey(pmcFinanceCompQuotaSet);\n            return pmcFinanceCompQuotaSet.getId();\n        } else {\n            pmcFinanceCompQuotaSet.setCreateDate(new Date());\n            pmcFinanceCompQuotaSetMapper.insert(pmcFinanceCompQuotaSet);\n        }\n        return 0L;\n    }\n\n    @Override\n    public PageInfo<PmcFinanceSupplierQuotaSet> selectSupplierQuotaSet(PmcFinanceSupplierQuotaSetQO query) {\n        // 判断是否分页\n        if (query.getPageNum() > 0 && query.getPageSize() > 0) {\n            PageHelper.startPage(query.getPageNum(), query.getPageSize());\n        }\n        return new PageInfo<>(getSupplierQuotaSetList(query));\n    }\n\n    @Override\n    public List<PmcFinanceSupplierQuotaSet> exportSupplierQuotaSet(PmcFinanceSupplierQuotaSetQO query) {\n        return getSupplierQuotaSetList(query);\n    }\n\n\n    @Override\n    public Long saveOrUpdateSupplierQuotaSet(PmcFinanceSupplierQuotaSet dto) {\n        PmcFinanceSupplierQuotaSet pmcFinanceSupplierQuotaSet = new PmcFinanceSupplierQuotaSet();\n        BeanUtils.copyProperties(dto, pmcFinanceSupplierQuotaSet);\n        // 插入数据\n        if (pmcFinanceSupplierQuotaSetMapper.selectCount(pmcFinanceSupplierQuotaSet) > 0) {\n            pmcFinanceSupplierQuotaSet.setLastUpdateDate(new Date());\n            pmcFinanceSupplierQuotaSetMapper.updateByPrimaryKey(pmcFinanceSupplierQuotaSet);\n        } else {\n            pmcFinanceSupplierQuotaSet.setCreateDate(new Date());\n            pmcFinanceSupplierQuotaSetMapper.insert(pmcFinanceSupplierQuotaSet);\n        }\n        return pmcFinanceSupplierQuotaSet.getId();\n    }\n\n\n    private List<PmcFinanceSupplierQuotaSet> getSupplierQuotaSetList(PmcFinanceSupplierQuotaSetQO query) {\n        Example example = new Example(PmcFinanceSupplierQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n        String supId = PmcPortalLogin.getSupId();\n        PmcDataP2pSupplier supplier = pmcDataP2pSupplierMapper.selectBySupplierCode(supId);\n        if (supplier == null) {\n            throw new ServiceException(\"供应商信息不存在: supId=\" + supId);\n        }\n        if (StringUtils.isBlank(query.getSupplierName())) {\n            query.setSupplierName(supplier.getSupplierName());\n        }\n        if (StringUtils.isBlank(query.getSupplierCode())) {\n            query.setSupplierCode(supplier.getSupplierCode());\n        }\n        criteria.andEqualTo(\"supplierName\", query.getSupplierName())\n                .andEqualTo(\"supplierCode\", query.getSupplierCode());\n\n        if (StringUtils.isNotBlank(query.getRegistrationCode())) {\n            criteria.andEqualTo(\"registrationCode\", query.getRegistrationCode());\n        }\n        if (StringUtils.isNotBlank(query.getFinanceFlag())) {\n            criteria.andEqualTo(\"financeFlag\", query.getFinanceFlag());\n        }\n        List<PmcFinanceSupplierQuotaSet> list = pmcFinanceSupplierQuotaSetMapper.selectByExample(example);\n        return list;\n    }\n\n\n    private List<PmcFinanceCompQuotaSetDTO> getQuotaSetList(PmcFinanceCompQuotaSetQO query) {\n        Example example = new Example(PmcFinanceCompQuotaSet.class);\n\n        Example.Criteria criteria = example.createCriteria();\n        if (StringUtils.isNotBlank(query.getBankCode())) {\n            criteria.andEqualTo(\"bankCode\", query.getBankCode());\n        }\n        if (StringUtils.isNotBlank(query.getCreditCompCode())) {\n            criteria.andEqualTo(\"creditCompCode\", query.getCreditCompCode());\n        }\n        if (StringUtils.isNotBlank(query.getEnableFlag())) {\n            criteria.andEqualTo(\"enableFlag\", query.getEnableFlag());\n        }\n        if (StringUtils.isNotBlank(query.getPayAccount())) {\n            criteria.andEqualTo(\"payAccount\", query.getPayAccount());\n        }\n        List<PmcFinanceCompQuotaSet> list = pmcFinanceCompQuotaSetMapper.selectByExample(example);\n\n\n        List<PmcFinanceCompQuotaSetDTO> dtoList = list.stream().map(his -> {\n            PmcFinanceCompQuotaSetDTO dto = new PmcFinanceCompQuotaSetDTO();\n            BeanUtils.copyProperties(his, dto);\n            dto.setCompanyName(operateByJDBC.translate(BD_COMPANY, StringUtils.toString(dto.getCompanyCode())));\n            dto.setCreditCompName(operateByJDBC.translate(BD_COMPANY, StringUtils.toString(dto.getCreditCompCode())));\n            dto.setBankName(operateByJDBC.translate(BANK, StringUtils.toString(dto.getBankCode())));\n            return dto;\n        }).collect(Collectors.toList());\n        setPayAccountNames(dtoList);\n        return dtoList;\n    }\n\n\n    private void setPayAccountNames(List<PmcFinanceCompQuotaSetDTO> list) {\n        if (CollectionUtils.isEmpty(list)) {\n            return;\n        }\n        // 收集所有accountNo\n        List<String> accountNos = list.stream()\n                .map(PmcFinanceCompQuotaSet::getPayAccount)\n                .filter(StringUtils::isNotBlank)\n                .distinct()\n                .collect(Collectors.toList());\n\n        if (CollectionUtils.isEmpty(accountNos)) {\n            return;\n        }\n        // 批量查询accountName\n        Map<String, String> accountNameMap = accountMapper.batchSelectAccountNames(accountNos);\n\n        // 为每条记录设置PayAccountName\n        list.forEach(dto -> {\n            if (StringUtils.isNotBlank(dto.getPayAccount())) {\n                dto.setPayAccountName(accountNameMap.get(dto.getPayAccount()));\n                String currencyName = (operateByJDBC.translate(CURRENCY, \"CNY\"));\n                dto.setPayAccountInfo(dto.getPayAccount() + \"-\"+ currencyName+ \"-\"\n                        + dto.getBankName()+ \"-\"+dto.getPayAccountName());\n            }\n        });\n    }\n    @Override\n    public Map<String, Object> getSelectInit() {\n        Map<String, Object> result = new HashMap<>();\n        // 获取所有状态及描述\n        List<Object[]> statusList = SupplierFinancingApplyStatus.getAllStatuses();\n\n        // 获取融资机构列表\n        List<CodeDesc> bankList = operateByJDBC.selectByCon(BANK_FINANCING_RATES)\n                .stream()\n                .map(info -> new CodeDesc(info.getFlexValue(), info.getDescription()))\n                .collect(Collectors.toList());\n\n        List<FndFlexValueDTO> enbleFlagList = fndFlexValueApi.selectByType(Constants.PmcLookupInfoCode.YES_NO);\n\n\n        // 获取公司列表\n        List<CodeDesc> cnmpanyList = operateByJDBC.selectByCon(BD_COMPANY)\n                .stream()\n                .map(info -> new CodeDesc(info.getFlexValue(), info.getDescription()))\n                .collect(Collectors.toList());\n\n        result.put(\"yesNo\", fndFlexValueApi.convertToCodedLabelDTO(enbleFlagList));\n        result.put(\"statusList\", statusList);\n        result.put(\"bankList\", bankList);\n        result.put(\"companyList\", cnmpanyList);\n\n        return result;\n    }\n\n    @Override\n    public List<CodeDesc> selectSuggest(SuggestParameter parameter) {\n        // 我想要针对供应商名称，统一社会信用代码，供应商编号进行模糊查询】，请实现这个方法\n\n        // todo\n        return List.of(new CodeDesc(\"1\", \"1\"));\n    }\n\n}",
                "afterChangeFileContent": "package com.baidu.pmc.core.service.impl;\n\nimport com.baidu.pmc.common.component.PmcPortalLogin;\nimport com.baidu.pmc.common.exception.ServiceException;\nimport com.baidu.pmc.common.utils.BeanUtils;\nimport com.baidu.pmc.common.utils.DateUtils;\nimport com.baidu.pmc.common.utils.StringUtils;\nimport com.baidu.pmc.core.fnd.service.FndFlexValueApi;\nimport com.baidu.pmc.core.service.OperateByJDBC;\nimport com.baidu.pmc.core.service.PmcPortalFinancingService;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcAccountMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcDataP2pSupplierMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcFinanceCompQuotaSetMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcFinanceSupplierApplyMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcPayChecksMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcFinanceSupplierApplyHisMapper;\nimport com.baidu.pmc.persistence.mapper.pmc.PmcFinanceSupplierQuotaSetMapper;\nimport com.baidu.pmc.pojo.constants.Constants;\nimport com.baidu.pmc.pojo.constants.FinancingStatus;\nimport com.baidu.pmc.pojo.constants.PayStatus;\nimport com.baidu.pmc.pojo.constants.SupplierFinancingApplyStatus;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceSupplierApplyHisDTO;\nimport com.baidu.pmc.pojo.dto.PmcPayChecksSupplierCodeDTO;\nimport com.baidu.pmc.pojo.dto.PmcFinanceCompQuotaSetDTO;\nimport com.baidu.pmc.pojo.dto.fnd.CodeDesc;\nimport com.baidu.pmc.pojo.dto.fnd.FndFlexValueDTO;\nimport com.baidu.pmc.pojo.dto.fnd.SuggestParameter;\nimport com.baidu.pmc.pojo.model.PmcDataP2pSupplier;\nimport com.baidu.pmc.pojo.model.PmcFinanceSupplierApply;\nimport com.baidu.pmc.pojo.model.PmcFinanceSupplierApplyHis;\nimport com.baidu.pmc.pojo.model.PmcPayChecks;\nimport com.baidu.pmc.pojo.qo.PayChecksQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceCompQuotaSetQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceSupplierApplyQO;\nimport com.baidu.pmc.pojo.qo.PmcFinanceSupplierQuotaSetQO;\nimport com.baidu.pmc.pojo.model.PmcFinanceSupplierQuotaSet;\nimport com.baidu.pmc.pojo.model.PmcFinanceCompQuotaSet;\nimport com.github.pagehelper.PageHelper;\nimport com.github.pagehelper.PageInfo;\nimport lombok.extern.slf4j.Slf4j;\nimport org.apache.commons.collections.CollectionUtils;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\nimport tk.mybatis.mapper.entity.Example;\n\nimport java.util.Arrays;\nimport java.util.Date;\nimport java.util.List;\nimport java.util.Map;\n\nimport java.util.HashMap;\n\nimport java.util.stream.Collectors;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.BANK;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.BD_COMPANY;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.CURRENCY;\nimport static com.baidu.pmc.pojo.constants.Constants.PmcLookupInfoCode.BANK_FINANCING_RATES;\n\n@Slf4j\n@Service\npublic class PmcPortalFinancingServiceImpl implements PmcPortalFinancingService {\n\n\n    @Autowired\n    private PmcFinanceSupplierApplyMapper pmcFinanceSupplierApplyMapper;\n\n    @Autowired\n    private PmcDataP2pSupplierMapper pmcDataP2pSupplierMapper;\n\n    @Autowired\n    private PmcPayChecksMapper pmcPayChecksMapper;\n\n    @Autowired\n    private PmcFinanceSupplierApplyHisMapper pmcFinanceSupplierApplyHisMapper;\n\n    @Autowired\n    private PmcFinanceSupplierQuotaSetMapper pmcFinanceSupplierQuotaSetMapper;\n\n    @Autowired\n    private PmcFinanceCompQuotaSetMapper pmcFinanceCompQuotaSetMapper;\n\n    @Autowired\n    private OperateByJDBC operateByJDBC;\n\n    @Autowired\n    private PmcAccountMapper accountMapper;\n\n    @Autowired\n    FndFlexValueApi fndFlexValueApi;\n\n\n    @Override\n    public PageInfo<PmcFinanceSupplierApplyDTO> findByConditionSupplierCode(PmcFinanceSupplierApplyQO pmcFinanceSupplierApplyQO) {\n\n        PmcDataP2pSupplier pmcDataP2pSupplier = pmcDataP2pSupplierMapper.selectBySupplierCode(PmcPortalLogin.getSupId());\n        if (pmcDataP2pSupplier == null) {\n            throw new SecurityException(\"供应商信息不存在!\");\n        }\n        pmcFinanceSupplierApplyQO.setSupplierCode(pmcDataP2pSupplier.getSupplierCode());\n\n        // 判断是否分页\n        if (pmcFinanceSupplierApplyQO.getPageNum() > 0\n                && pmcFinanceSupplierApplyQO.getPageSize() > 0) {\n            PageHelper.startPage(\n                    pmcFinanceSupplierApplyQO.getPageNum(),\n                    pmcFinanceSupplierApplyQO.getPageSize()\n            );\n        }\n        List<PmcFinanceSupplierApplyDTO> list = getListBySupplierCode(pmcFinanceSupplierApplyQO);\n        return new PageInfo<>(list);\n    }\n\n    @Override\n    public List<PmcFinanceSupplierApplyDTO> export(PmcFinanceSupplierApplyQO pmcFinanceSupplierApplyQO) {\n        PmcDataP2pSupplier pmcDataP2pSupplier = pmcDataP2pSupplierMapper.selectBySupplierCode(PmcPortalLogin.getSupId());\n        if (pmcDataP2pSupplier == null) {\n            throw new SecurityException(\"供应商信息不存在!\");\n        }\n        pmcFinanceSupplierApplyQO.setSupplierCode(pmcDataP2pSupplier.getSupplierCode());\n        return getListBySupplierCode(pmcFinanceSupplierApplyQO);\n    }\n\n\n    private List<PmcFinanceSupplierApplyDTO> getListBySupplierCode(PmcFinanceSupplierApplyQO qo) {\n        return pmcFinanceSupplierApplyMapper.selectApplyListBySupplierCode(qo).stream()\n                .map(his -> {\n                    PmcFinanceSupplierApplyDTO dto = new PmcFinanceSupplierApplyDTO();\n                    BeanUtils.copyProperties(his, dto);\n                    // 设置额外字段\n                    dto.setBankName(operateByJDBC.translate(BANK, StringUtils.toString(dto.getBankCode())));\n                    dto.setStatusDesc(SupplierFinancingApplyStatus.getDescription(dto.getStatus()));\n                    dto.setCurrencyName(operateByJDBC.translate(CURRENCY, dto.getCurrency()));\n                    return dto;\n                }).collect(Collectors.toList());\n    }\n\n\n    @Override\n    public PageInfo<PmcFinanceSupplierApplyHisDTO> queryFinancingApplyHis(PmcFinanceSupplierApplyQO query) {\n        if (query.getApplyNumber() == null) {\n            throw new IllegalArgumentException(\"申请单号不能为空\");\n        }\n        // 判断是否分页\n        if (query.getPageNum() > 0 && query.getPageSize() > 0) {\n            PageHelper.startPage(query.getPageNum(), query.getPageSize());\n        }\n\n        List<PmcFinanceSupplierApplyHis> hisList = pmcFinanceSupplierApplyHisMapper.selectByApplyNumber(query.getApplyNumber());\n\n        List<PmcFinanceSupplierApplyHisDTO> dtoList = hisList.stream().map(his -> {\n            PmcFinanceSupplierApplyHisDTO dto = new PmcFinanceSupplierApplyHisDTO();\n            BeanUtils.copyProperties(his, dto);\n            return dto;\n        }).collect(Collectors.toList());\n\n        return new PageInfo<>(dtoList);\n    }\n\n    @Override\n    public PageInfo<PmcFinanceSupplierApplyDTO> findByConditionAll(PmcFinanceSupplierApplyQO pmcFinanceSupplierApplyQO) {\n        // 判断是否分页\n        if (pmcFinanceSupplierApplyQO.getPageNum() > 0\n                && pmcFinanceSupplierApplyQO.getPageSize() > 0) {\n            PageHelper.startPage(\n                    pmcFinanceSupplierApplyQO.getPageNum(),\n                    pmcFinanceSupplierApplyQO.getPageSize()\n            );\n        }\n        List<PmcFinanceSupplierApplyDTO> list =\n                pmcFinanceSupplierApplyMapper.selectApplyListByAll(pmcFinanceSupplierApplyQO);\n        List<PmcFinanceSupplierApplyDTO> dtoList = list.stream()\n                .map(his -> {\n                    PmcFinanceSupplierApplyDTO dto = new PmcFinanceSupplierApplyDTO();\n                    BeanUtils.copyProperties(his, dto);\n                    // 设置额外字段\n                    dto.setBankName(operateByJDBC.translate(BANK, StringUtils.toString(dto.getBankCode())));\n                    dto.setStatusDesc(SupplierFinancingApplyStatus.getDescription(dto.getStatus()));\n                    dto.setCurrencyName(operateByJDBC.translate(CURRENCY, dto.getCurrency()));\n                    return dto;\n                }).collect(Collectors.toList());\n        return new PageInfo<>(dtoList);\n    }\n\n    @Override\n    public PageInfo<PmcPayChecksSupplierCodeDTO> getPayCheckList() {\n        PmcDataP2pSupplier pmcDataP2pSupplier = pmcDataP2pSupplierMapper.selectBySupplierCode(PmcPortalLogin.getSupId());\n        if (pmcDataP2pSupplier == null) {\n            throw new SecurityException(\"供应商信息不存在!\");\n        }\n        // 准备查询参数\n        List<String> statusList = Arrays.asList(PayStatus.APPROVED.name(), PayStatus.RELEASED.name());\n        Date currentDatePlus3Days = DateUtils.addDays(new Date(), 7);\n        // todo 这里暂时用供应商编码查询关联pmc_pay_checks.attribute15，后续方案调整再同步修改\n        List<PmcPayChecksSupplierCodeDTO> resultList = pmcPayChecksMapper.\n                selectBySupplierCode(pmcDataP2pSupplier.getSupplierCode(), currentDatePlus3Days, statusList);\n\n        resultList = resultList.stream()\n                .map(dto -> {\n                    // 创建新的DTO对象\n                    PmcPayChecksSupplierCodeDTO newDto = new PmcPayChecksSupplierCodeDTO();\n                    // 复制原DTO的属性\n                    BeanUtils.copyProperties(dto, newDto);\n\n                    // 设置属性\n                    newDto.setSupplierCode(pmcDataP2pSupplier.getSupplierCode());\n                    newDto.setSupplierName(pmcDataP2pSupplier.getSupplierName());\n\n                    // 计算融资天数\n                    newDto.setFinanceDays(DateUtils.daysBetween(DateUtils.getCurrentDate(), dto.getPayPlanDate()));\n                    return newDto;\n                })\n                .collect(Collectors.toList());\n\n        return new PageInfo<>(resultList);\n    }\n\n\n    @Override\n    public Map<String, Object> getFinancingApplyDetail(PmcFinanceSupplierApplyQO query) {\n        // 参数校验\n        if (query == null || StringUtils.isBlank(query.getApplyNumber())) {\n            throw new IllegalArgumentException(\"申请单号不能为空\");\n        }\n\n        // 查询申请明细\n        PmcFinanceSupplierApply apply = pmcFinanceSupplierApplyMapper.selectByApplyNumber(query.getApplyNumber());\n        if (apply == null) {\n            throw new IllegalArgumentException(\"未找到对应的融资申请单\");\n        }\n        PmcFinanceSupplierApplyDTO applyDTO = new PmcFinanceSupplierApplyDTO();\n        BeanUtils.copyProperties(apply, applyDTO);\n        applyDTO.setBankName(operateByJDBC.translate(BANK, StringUtils.toString(applyDTO.getBankCode())));\n        applyDTO.setStatusDesc(SupplierFinancingApplyStatus.getDescription(applyDTO.getStatus()));\n        applyDTO.setCurrencyName(operateByJDBC.translate(CURRENCY, applyDTO.getCurrency()));\n\n\n        // 查询单据状态历史记录\n        List<PmcFinanceSupplierApplyHis> hisList = pmcFinanceSupplierApplyHisMapper.selectByApplyNumber(query.getApplyNumber());\n        List<PmcFinanceSupplierApplyHisDTO> hisDtoList = hisList.stream().map(his -> {\n            PmcFinanceSupplierApplyHisDTO dto = new PmcFinanceSupplierApplyHisDTO();\n            BeanUtils.copyProperties(his, dto);\n            return dto;\n        }).collect(Collectors.toList());\n\n        // 查询付款单信息\n        PayChecksQO payChecksQO = new PayChecksQO();\n        payChecksQO.setPayCheckNum(query.getPayCheckNum());\n        PmcPayChecksSupplierCodeDTO payChecksSupplierCodeDTO = selectPmcPayCheckByPayCheckNum(payChecksQO);\n\n        // 构建返回结果\n        Map<String, Object> resultMap = new HashMap<>();\n        resultMap.put(\"applyDetail\", apply);\n        resultMap.put(\"historyList\", hisDtoList);\n        resultMap.put(\"payChecksSupplierCodeDTO\", payChecksSupplierCodeDTO);\n        return resultMap;\n    }\n\n    @Override\n    public Long saveOrUpdateFinancingApply(PmcFinanceSupplierApplyDTO pmcFinanceSupplierApplyDto) {\n        PmcFinanceSupplierApply pmcFinanceSupplierApply = new PmcFinanceSupplierApply();\n        BeanUtils.copyProperties(pmcFinanceSupplierApplyDto, pmcFinanceSupplierApply);\n        // 创建融资申请单\n        if (pmcFinanceSupplierApply == null) {\n            log.error(\"融资申请单参数为空\");\n            throw new IllegalArgumentException(\"融资申请单不能为空\");\n        }\n        if (pmcFinanceSupplierApply.getSupplierCode() == null) {\n            PmcDataP2pSupplier pmcDataP2pSupplier = pmcDataP2pSupplierMapper.selectBySupplierCode(PmcPortalLogin.getSupId());\n            if (pmcDataP2pSupplier == null) {\n                throw new SecurityException(\"供应商信息不存在!\");\n            }\n            pmcFinanceSupplierApply.setSupplierCode(pmcDataP2pSupplier.getSupplierCode());\n        }\n\n        if (StringUtils.isBlank(pmcFinanceSupplierApply.getApplyNumber())) {\n            throw new SecurityException(\"融资申请单号不能为空!\");\n        }\n        if (StringUtils.isBlank(pmcFinanceSupplierApply.getSourceNum())) {\n            throw new SecurityException(\"原始单据号不能为空!\");\n        }\n        if (StringUtils.isBlank(pmcFinanceSupplierApply.getPayCheckNum())) {\n            throw new SecurityException(\"付款单号不能为空!\");\n        }\n\n        if (pmcFinanceSupplierApplyMapper.selectCount(pmcFinanceSupplierApply) > 0) {\n            if (pmcFinanceSupplierApply.getLastUpdateDate() == null) {\n                pmcFinanceSupplierApply.setLastUpdateDate(new Date());\n            }\n            pmcFinanceSupplierApplyMapper.updateByPrimaryKeySelective(pmcFinanceSupplierApply);\n        } else {\n            // 设置操作人和时间\n            if (StringUtils.isBlank(pmcFinanceSupplierApply.getCreateBy())) {\n                pmcFinanceSupplierApply.setCreateBy(PmcPortalLogin.getLoginAccount());\n            }\n            pmcFinanceSupplierApply.setCreateDate(new Date());\n            pmcFinanceSupplierApply.setLastUpdateBy(pmcFinanceSupplierApply.getCreateBy());\n            pmcFinanceSupplierApply.setLastUpdateDate(new Date());\n            if (StringUtils.isBlank(pmcFinanceSupplierApply.getApplySubmit())) {\n                pmcFinanceSupplierApply.setApplySubmit(pmcFinanceSupplierApply.getCreateBy());\n            }\n            if (StringUtils.isBlank(pmcFinanceSupplierApply.getStatus())) {\n                pmcFinanceSupplierApply.setStatus(SupplierFinancingApplyStatus.SAVED.name());\n            }\n            pmcFinanceSupplierApplyMapper.insert(pmcFinanceSupplierApply);\n            log.info(\"成功创建融资申请单，申请单号: {},付款单号:{}\", pmcFinanceSupplierApply.getApplyNumber(), pmcFinanceSupplierApply.getPayCheckNum());\n        }\n\n        PmcFinanceSupplierApplyHis his = new PmcFinanceSupplierApplyHis();\n        BeanUtils.copyProperties(pmcFinanceSupplierApplyDto, his);\n        // 操作人 供应商或者银行\n        his.setCreateDate(new Date());\n        his.setLastUpdateDate(new Date());\n        // SUBMITTED:提交申请\n        // BANK_CONFIRMED:网银确认\n        // BANK_REVIEWING:银行审核\n        // BANK_FUNDED:银行放款\n        if (!StringUtils.isBlank(his.getOperationNode()) && FinancingStatus.getNextStatus(his.getOperationNode()) != null) {\n            // 设置下一个操作步骤\n            his.setAttribute1(FinancingStatus.getNextStatus(his.getOperationNode()).getDescription());\n        }\n        pmcFinanceSupplierApplyHisMapper.insert(his);\n        log.info(\"成功创建融资申请历史记录，申请单号: {} ,付款单号:{}\", his.getApplyNumber(), his.getPayCheckNum());\n\n        return pmcFinanceSupplierApply.getApplyId();\n    }\n\n    /**\n    *  根据付款单号查询对应的付款数据\n    * */\n    @Override\n    public PmcPayChecksSupplierCodeDTO selectPmcPayCheckByPayCheckNum(PayChecksQO payChecksQO) {\n        // 1. 参数校验\n        if (payChecksQO == null || StringUtils.isBlank(payChecksQO.getPayCheckNum())) {\n            throw new IllegalArgumentException(\"付款单号不能为空\");\n        }\n\n        // 2. 查询支付记录\n        Example example = new Example(PmcPayChecks.class);\n        example.createCriteria().andEqualTo(\"payCheckNum\", payChecksQO.getPayCheckNum());\n        PmcPayChecks pmcPayCheck = pmcPayChecksMapper.selectOneByExample(example);\n\n        PmcPayChecksSupplierCodeDTO dto = new PmcPayChecksSupplierCodeDTO();\n        if (pmcPayCheck == null) {\n            return dto;  // 返回空DTO\n        }\n\n        // 3. 属性拷贝\n        BeanUtils.copyProperties(pmcPayCheck, dto);\n\n        // 4. 计算日期差\n        if (dto.getPayPlanDate() != null) {\n            dto.setFinanceDays(DateUtils.daysBetween(DateUtils.getCurrentDate(), dto.getPayPlanDate()));\n        }\n\n        // 5. 补全供应商信息\n        if (StringUtils.isBlank(dto.getSupplierCode())) {\n            String supId = PmcPortalLogin.getSupId();\n            PmcDataP2pSupplier supplier = pmcDataP2pSupplierMapper.selectBySupplierCode(supId);\n            if (supplier == null) {\n                throw new ServiceException(\"供应商信息不存在: supId=\" + supId);\n            }\n            dto.setSupplierCode(supplier.getSupplierCode());\n            dto.setSupplierName(supplier.getSupplierName());\n        }\n\n        return dto;\n    }\n\n    @Override\n    public PageInfo<PmcFinanceCompQuotaSetDTO> selectQuotaSet(PmcFinanceCompQuotaSetQO query) {\n        // 判断是否分页\n        if (query.getPageNum() > 0\n                && query.getPageSize() > 0) {\n            PageHelper.startPage(\n                    query.getPageNum(),\n                    query.getPageSize()\n            );\n        }\n        return new PageInfo<>(getQuotaSetList(query));\n    }\n\n    @Override\n    public List<PmcFinanceCompQuotaSetDTO> exportQuotaSet(PmcFinanceCompQuotaSetQO query) {\n        return getQuotaSetList(query);\n    }\n\n    @Override\n    public Long saveOrUpdateCompQuotaSet(PmcFinanceCompQuotaSetDTO dto) {\n        PmcFinanceCompQuotaSet pmcFinanceCompQuotaSet = new PmcFinanceCompQuotaSet();\n        BeanUtils.copyProperties(dto, pmcFinanceCompQuotaSet);\n        // 插入数据\n        if (pmcFinanceCompQuotaSetMapper.selectCount(pmcFinanceCompQuotaSet) > 0) {\n            pmcFinanceCompQuotaSet.setLastUpdateDate(new Date());\n            pmcFinanceCompQuotaSetMapper.updateByPrimaryKey(pmcFinanceCompQuotaSet);\n            return pmcFinanceCompQuotaSet.getId();\n        } else {\n            pmcFinanceCompQuotaSet.setCreateDate(new Date());\n            pmcFinanceCompQuotaSetMapper.insert(pmcFinanceCompQuotaSet);\n        }\n        return 0L;\n    }\n\n    @Override\n    public PageInfo<PmcFinanceSupplierQuotaSet> selectSupplierQuotaSet(PmcFinanceSupplierQuotaSetQO query) {\n        // 判断是否分页\n        if (query.getPageNum() > 0 && query.getPageSize() > 0) {\n            PageHelper.startPage(query.getPageNum(), query.getPageSize());\n        }\n        return new PageInfo<>(getSupplierQuotaSetList(query));\n    }\n\n    @Override\n    public List<PmcFinanceSupplierQuotaSet> exportSupplierQuotaSet(PmcFinanceSupplierQuotaSetQO query) {\n        return getSupplierQuotaSetList(query);\n    }\n\n\n    @Override\n    public Long saveOrUpdateSupplierQuotaSet(PmcFinanceSupplierQuotaSet dto) {\n        PmcFinanceSupplierQuotaSet pmcFinanceSupplierQuotaSet = new PmcFinanceSupplierQuotaSet();\n        BeanUtils.copyProperties(dto, pmcFinanceSupplierQuotaSet);\n        // 插入数据\n        if (pmcFinanceSupplierQuotaSetMapper.selectCount(pmcFinanceSupplierQuotaSet) > 0) {\n            pmcFinanceSupplierQuotaSet.setLastUpdateDate(new Date());\n            pmcFinanceSupplierQuotaSetMapper.updateByPrimaryKey(pmcFinanceSupplierQuotaSet);\n        } else {\n            pmcFinanceSupplierQuotaSet.setCreateDate(new Date());\n            pmcFinanceSupplierQuotaSetMapper.insert(pmcFinanceSupplierQuotaSet);\n        }\n        return pmcFinanceSupplierQuotaSet.getId();\n    }\n\n\n    private List<PmcFinanceSupplierQuotaSet> getSupplierQuotaSetList(PmcFinanceSupplierQuotaSetQO query) {\n        Example example = new Example(PmcFinanceSupplierQuotaSet.class);\n        Example.Criteria criteria = example.createCriteria();\n        String supId = PmcPortalLogin.getSupId();\n        PmcDataP2pSupplier supplier = pmcDataP2pSupplierMapper.selectBySupplierCode(supId);\n        if (supplier == null) {\n            throw new ServiceException(\"供应商信息不存在: supId=\" + supId);\n        }\n        if (StringUtils.isBlank(query.getSupplierName())) {\n            query.setSupplierName(supplier.getSupplierName());\n        }\n        if (StringUtils.isBlank(query.getSupplierCode())) {\n            query.setSupplierCode(supplier.getSupplierCode());\n        }\n        criteria.andEqualTo(\"supplierName\", query.getSupplierName())\n                .andEqualTo(\"supplierCode\", query.getSupplierCode());\n\n        if (StringUtils.isNotBlank(query.getRegistrationCode())) {\n            criteria.andEqualTo(\"registrationCode\", query.getRegistrationCode());\n        }\n        if (StringUtils.isNotBlank(query.getFinanceFlag())) {\n            criteria.andEqualTo(\"financeFlag\", query.getFinanceFlag());\n        }\n        List<PmcFinanceSupplierQuotaSet> list = pmcFinanceSupplierQuotaSetMapper.selectByExample(example);\n        return list;\n    }\n\n\n    private List<PmcFinanceCompQuotaSetDTO> getQuotaSetList(PmcFinanceCompQuotaSetQO query) {\n        Example example = new Example(PmcFinanceCompQuotaSet.class);\n\n        Example.Criteria criteria = example.createCriteria();\n        if (StringUtils.isNotBlank(query.getBankCode())) {\n            criteria.andEqualTo(\"bankCode\", query.getBankCode());\n        }\n        if (StringUtils.isNotBlank(query.getCreditCompCode())) {\n            criteria.andEqualTo(\"creditCompCode\", query.getCreditCompCode());\n        }\n        if (StringUtils.isNotBlank(query.getEnableFlag())) {\n            criteria.andEqualTo(\"enableFlag\", query.getEnableFlag());\n        }\n        if (StringUtils.isNotBlank(query.getPayAccount())) {\n            criteria.andEqualTo(\"payAccount\", query.getPayAccount());\n        }\n        List<PmcFinanceCompQuotaSet> list = pmcFinanceCompQuotaSetMapper.selectByExample(example);\n\n\n        List<PmcFinanceCompQuotaSetDTO> dtoList = list.stream().map(his -> {\n            PmcFinanceCompQuotaSetDTO dto = new PmcFinanceCompQuotaSetDTO();\n            BeanUtils.copyProperties(his, dto);\n            dto.setCompanyName(operateByJDBC.translate(BD_COMPANY, StringUtils.toString(dto.getCompanyCode())));\n            dto.setCreditCompName(operateByJDBC.translate(BD_COMPANY, StringUtils.toString(dto.getCreditCompCode())));\n            dto.setBankName(operateByJDBC.translate(BANK, StringUtils.toString(dto.getBankCode())));\n            return dto;\n        }).collect(Collectors.toList());\n        setPayAccountNames(dtoList);\n        return dtoList;\n    }\n\n\n    private void setPayAccountNames(List<PmcFinanceCompQuotaSetDTO> list) {\n        if (CollectionUtils.isEmpty(list)) {\n            return;\n        }\n        // 收集所有accountNo\n        List<String> accountNos = list.stream()\n                .map(PmcFinanceCompQuotaSet::getPayAccount)\n                .filter(StringUtils::isNotBlank)\n                .distinct()\n                .collect(Collectors.toList());\n\n        if (CollectionUtils.isEmpty(accountNos)) {\n            return;\n        }\n        // 批量查询accountName\n        Map<String, String> accountNameMap = accountMapper.batchSelectAccountNames(accountNos);\n\n        // 为每条记录设置PayAccountName\n        list.forEach(dto -> {\n            if (StringUtils.isNotBlank(dto.getPayAccount())) {\n                dto.setPayAccountName(accountNameMap.get(dto.getPayAccount()));\n                String currencyName = (operateByJDBC.translate(CURRENCY, \"CNY\"));\n                dto.setPayAccountInfo(dto.getPayAccount() + \"-\"+ currencyName+ \"-\"\n                        + dto.getBankName()+ \"-\"+dto.getPayAccountName());\n            }\n        });\n    }\n    @Override\n    public Map<String, Object> getSelectInit() {\n        Map<String, Object> result = new HashMap<>();\n        // 获取所有状态及描述\n        List<Object[]> statusList = SupplierFinancingApplyStatus.getAllStatuses();\n\n        // 获取融资机构列表\n        List<CodeDesc> bankList = operateByJDBC.selectByCon(BANK_FINANCING_RATES)\n                .stream()\n                .map(info -> new CodeDesc(info.getFlexValue(), info.getDescription()))\n                .collect(Collectors.toList());\n\n        List<FndFlexValueDTO> enbleFlagList = fndFlexValueApi.selectByType(Constants.PmcLookupInfoCode.YES_NO);\n\n\n        // 获取公司列表\n        List<CodeDesc> cnmpanyList = operateByJDBC.selectByCon(BD_COMPANY)\n                .stream()\n                .map(info -> new CodeDesc(info.getFlexValue(), info.getDescription()))\n                .collect(Collectors.toList());\n\n        result.put(\"yesNo\", fndFlexValueApi.convertToCodedLabelDTO(enbleFlagList));\n        result.put(\"statusList\", statusList);\n        result.put(\"bankList\", bankList);\n        result.put(\"companyList\", cnmpanyList);\n\n        return result;\n    }\n\n    @Override\n    public List<CodeDesc> selectSuggest(SuggestParameter parameter) {\n        if (parameter == null || StringUtils.isBlank(parameter.getKeyword())) {\n            throw new IllegalArgumentException(\"查询关键字不能为空\");\n        }\n\n        Example example = new Example(PmcDataP2pSupplier.class);\n        Example.Criteria criteria = example.createCriteria();\n        \n        // 构建模糊查询条件\n        String keyword = \"%\" + parameter.getKeyword() + \"%\";\n        criteria.orLike(\"supplierName\", keyword)\n               .orLike(\"registrationCode\", keyword)\n               .orLike(\"supplierCode\", keyword);\n        \n        // 执行查询\n        List<PmcDataP2pSupplier> suppliers = pmcDataP2pSupplierMapper.selectByExample(example);\n        \n        // 转换为CodeDesc列表\n        return suppliers.stream()\n                .map(supplier -> new CodeDesc(\n                    supplier.getSupplierCode(), \n                    supplier.getSupplierName() + \"(\" + supplier.getRegistrationCode() + \")\"\n                ))\n                .collect(Collectors.toList());\n    }\n\n}"
